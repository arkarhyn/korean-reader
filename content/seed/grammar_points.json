{
  "_note": "HTSK Lessons 1-28 as grammar points (map only; no HTSK text). Reviewed by Austin 2026-10-03 (Stage 4 plan). Mirrored in docs/SYLLABUS_MAP.md. kiwi_pattern is filled for the Stage 5 batch targets and the 'new' points (warnings); the rest in Stage 8.",
  "points": [
    {"code": "G.TOPIC", "htsk_lesson": 1, "label_ko": "은/는", "ja_parallel": "は", "ja_diff_note": "Close match, incl. contrast use."},
    {"code": "G.COPULA", "htsk_lesson": 1, "label_ko": "이다", "ja_parallel": "だ／である", "ja_diff_note": "Attaches to the noun and conjugates like a verb (학생이에요)."},
    {"code": "G.SUBJ", "htsk_lesson": 2, "label_ko": "이/가", "ja_parallel": "が", "ja_diff_note": "Close match; 이/가 also marks the complement of 되다/아니다."},
    {"code": "G.ISSTA", "htsk_lesson": 2, "label_ko": "있다/없다", "ja_parallel": "ある・いる／ない", "ja_diff_note": "No animate/inanimate split; also 'to have'."},
    {"code": "G.OBJ", "htsk_lesson": 3, "label_ko": "을/를", "ja_parallel": "を", "ja_diff_note": "Used with 좋아하다 where Japanese uses が (好きだ)."},
    {"code": "G.UI", "htsk_lesson": 3, "label_ko": "의", "ja_parallel": "の", "ja_diff_note": "Often dropped in speech (엄마 친구), unlike の."},
    {"code": "G.ADN_ADJ", "htsk_lesson": 4, "label_ko": "-(으)ㄴ + 명사 (형용사)", "ja_parallel": "形容詞連体形", "ja_diff_note": "Adjectives need a modifier ending; no bare 終止形 before a noun."},
    {"code": "G.DO", "htsk_lesson": 4, "label_ko": "도", "ja_parallel": "も", "ja_diff_note": "Close match."},
    {"code": "G.PAST", "htsk_lesson": 5, "label_ko": "-았/었-", "ja_parallel": "た", "ja_diff_note": "Also used for resulting states where Japanese uses ている (결혼했어요 = 結婚している)."},
    {"code": "G.PLAIN_PRES", "htsk_lesson": 5, "label_ko": "-ㄴ/는다", "ja_parallel": "書き言葉の現在形 (である体)", "ja_diff_note": "Written/plain style; in speech it sounds like narration or exclamation."},
    {"code": "G.FUT", "htsk_lesson": 5, "label_ko": "-(으)ㄹ 것이다 / 거예요", "ja_parallel": "つもりだ／だろう", "ja_diff_note": "Covers both intention and conjecture; Japanese splits them."},
    {"code": "G.HAEYO", "htsk_lesson": 6, "label_ko": "-아/어요", "ja_parallel": "です・ます", "ja_diff_note": "Everyday polite; less formal than です・ます feels in writing."},
    {"code": "G.HAMNIDA", "htsk_lesson": 6, "label_ko": "-(스)ㅂ니다", "ja_parallel": "です・ます (改まった)", "ja_diff_note": "Formal/news/announcement register; no exact Japanese level.", "kiwi_pattern": [[{"tag": "EF", "form_re": "^(ᆸ|습)(니다|니까|시오)$"}]]},
    {"code": "G.BANMAL", "htsk_lesson": 6, "label_ko": "-아/어 (반말)", "ja_parallel": "タメ口", "ja_diff_note": "Same form serves statement, question, command, suggestion by intonation."},
    {"code": "G.HUMBLE_PRON", "htsk_lesson": 6, "label_ko": "저/제 vs 나/내", "ja_parallel": "私 vs 僕・俺", "ja_diff_note": "Choice is tied to the speech level, not gender.", "kiwi_pattern": [[{"tag": "NP", "form": ["저", "저희", "나"]}], [{"tag": "MM", "form": "내"}]]},
    {"code": "G.IRREG_B", "htsk_lesson": 7, "label_ko": "ㅂ 불규칙", "ja_parallel": null, "ja_diff_note": null},
    {"code": "G.IRREG_D_S", "htsk_lesson": 7, "label_ko": "ㄷ / ㅅ 불규칙", "ja_parallel": null, "ja_diff_note": null},
    {"code": "G.IRREG_REU_L", "htsk_lesson": 7, "label_ko": "르 불규칙 / ㄹ 탈락", "ja_parallel": null, "ja_diff_note": null},
    {"code": "G.ADV_GE", "htsk_lesson": 8, "label_ko": "-게 (부사형)", "ja_parallel": "〜く／〜に", "ja_diff_note": "Also 'so that' (Stage 8 point), unlike 〜く."},
    {"code": "G.NEG_AN", "htsk_lesson": 8, "label_ko": "안 + 용언", "ja_parallel": "〜ない", "ja_diff_note": "Pre-verbal; Japanese negates with a suffix."},
    {"code": "G.JI_ANTA", "htsk_lesson": 8, "label_ko": "-지 않다", "ja_parallel": "〜ない (長形)", "ja_diff_note": "Long negation; more neutral/written than 안."},
    {"code": "G.ANIDA", "htsk_lesson": 9, "label_ko": "아니다", "ja_parallel": "ではない", "ja_diff_note": "Takes 이/가 on the noun (학생이 아니에요)."},
    {"code": "G.COUNTERS", "htsk_lesson": 10, "label_ko": "고유어/한자어 숫자 + 단위", "ja_parallel": "数詞＋助数詞", "ja_diff_note": "Native numbers for hours/items/age, Sino for minutes/dates/money."},
    {"code": "G.DONGAN", "htsk_lesson": 11, "label_ko": "동안", "ja_parallel": "間", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "NNG", "form": "동안"}]]},
    {"code": "G.MAN", "htsk_lesson": 12, "label_ko": "만", "ja_parallel": "だけ／ばかり", "ja_diff_note": "Close match."},
    {"code": "G.ESEO", "htsk_lesson": 12, "label_ko": "에서", "ja_parallel": "で／から", "ja_diff_note": "에서 = place of action (で) and origin (から); 에 = location of existence (に)."},
    {"code": "G.BUTEO_KKAJI", "htsk_lesson": 12, "label_ko": "부터/까지", "ja_parallel": "から／まで", "ja_diff_note": "부터 is time/order; spatial 'from' is 에서."},
    {"code": "G.EURO", "htsk_lesson": 12, "label_ko": "(으)로", "ja_parallel": "で／へ／に", "ja_diff_note": "Means, direction, and change-into (으로 바뀌다)."},
    {"code": "G.WA_GWA", "htsk_lesson": 13, "label_ko": "와/과, 하고, (이)랑", "ja_parallel": "と", "ja_diff_note": "Three registers: 와/과 written, 하고 neutral, 랑 casual."},
    {"code": "G.EGE", "htsk_lesson": 13, "label_ko": "-에게", "ja_parallel": "に", "ja_diff_note": "Only for people/animals (places take 에)."},
    {"code": "G.HANTE", "htsk_lesson": 13, "label_ko": "-한테", "ja_parallel": "に", "ja_diff_note": "Spoken form of 에게."},
    {"code": "G.KKE", "htsk_lesson": 13, "label_ko": "-께", "ja_parallel": "に (尊敬)", "ja_diff_note": "Honorific 에게; no particle-level honorific in Japanese."},
    {"code": "G.WIHAE", "htsk_lesson": 13, "label_ko": "위해(서)", "ja_parallel": "ために", "ja_diff_note": "Close match (N을 위해, -기 위해).", "kiwi_pattern": [[{"tag": "VV", "form": "위하"}]]},
    {"code": "G.E_DAEHAE", "htsk_lesson": 13, "label_ko": "에 대해(서)", "ja_parallel": "について", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "JKB", "form": "에"}, {"tag": "VV", "form": "대하"}]]},
    {"code": "G.PASSIVE", "htsk_lesson": 14, "label_ko": "-이/히/리/기- (피동)", "ja_parallel": "れる／られる", "ja_diff_note": "Lexical, not productive; many verbs use -아/어지다 or 되다 instead."},
    {"code": "G.A_HADA", "htsk_lesson": 15, "label_ko": "-아/어하다", "ja_parallel": "〜がる", "ja_diff_note": "Turns a feeling adjective into a verb (좋아하다, 싫어하다)."},
    {"code": "G.JEOK", "htsk_lesson": 16, "label_ko": "-적 / -적으로 / -적이다", "ja_parallel": "的", "ja_diff_note": "Same Sino suffix; 적 takes 인 before nouns (일반적인)."},
    {"code": "G.SEUREOPDA", "htsk_lesson": 16, "label_ko": "-스럽다", "ja_parallel": "〜らしい", "ja_diff_note": "Not conjecture (らしい 推量); only 'seeming/full of'.", "kiwi_pattern": [[{"tag": "XSA", "form": "스럽"}]]},
    {"code": "G.GO", "htsk_lesson": 17, "label_ko": "-고", "ja_parallel": "〜て (並列)", "ja_diff_note": "Listing/sequence; cause-sequence uses -아/어서, not -고."},
    {"code": "G.GO_SIPDA", "htsk_lesson": 17, "label_ko": "-고 싶다", "ja_parallel": "〜たい", "ja_diff_note": "Third person uses -고 싶어하다 (〜たがる)."},
    {"code": "G.GO_ITDA", "htsk_lesson": 18, "label_ko": "-고 있다", "ja_parallel": "〜ている (進行)", "ja_diff_note": "Progressive only; resultant ている is -아/어 있다 or past."},
    {"code": "G.EOJIDA", "htsk_lesson": 18, "label_ko": "-아/어지다", "ja_parallel": "〜くなる", "ja_diff_note": "With adjectives = become; with verbs = passive (Lesson 14 territory).", "kiwi_pattern": [[{"tag": "EC", "form": ["어", "아"]}, {"tag": "VX", "form": "지"}]]},
    {"code": "G.BODA", "htsk_lesson": 19, "label_ko": "보다 / 더 / 가장", "ja_parallel": "より／もっと／一番", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "JKB", "form": "보다"}], [{"tag": "MAG", "form": ["더", "가장", "제일"]}]]},
    {"code": "G.NEG_MOT", "htsk_lesson": 20, "label_ko": "못 + 용언", "ja_parallel": "〜できない", "ja_diff_note": "Inability by negation, not a potential form."},
    {"code": "G.JI_MOTHADA", "htsk_lesson": 20, "label_ko": "-지 못하다", "ja_parallel": "〜できない (長形)", "ja_diff_note": "Long form of 못.", "kiwi_pattern": [[{"tag": "EC", "form": "지"}, {"tag": "MAG", "form": "못"}, {"form": "하"}]]},
    {"code": "G.QWORDS", "htsk_lesson": 21, "label_ko": "왜/언제/어디/누구/어떻게/뭐/어느/몇", "ja_parallel": "疑問詞", "ja_diff_note": "Same words double as indefinites (뭐 = 何か) by intonation."},
    {"code": "G.IRREG_H", "htsk_lesson": 23, "label_ko": "ㅎ 불규칙 (이렇다, 빨개요)", "ja_parallel": null, "ja_diff_note": null},
    {"code": "G.GI_JEONE", "htsk_lesson": 24, "label_ko": "-기 전에", "ja_parallel": "〜前に", "ja_diff_note": "Close match."},
    {"code": "G.EUN_HUE", "htsk_lesson": 24, "label_ko": "-(으)ㄴ 후에", "ja_parallel": "〜た後で", "ja_diff_note": "Close match; also -(으)ㄴ 다음에."},
    {"code": "G.AMU", "htsk_lesson": 25, "label_ko": "아무도/아무나, 누구나/누군가", "ja_parallel": "誰も／誰でも／誰か", "ja_diff_note": "아무도 needs a negative predicate, like 誰も."},
    {"code": "G.ADN_VERB", "htsk_lesson": 26, "label_ko": "-는 / -(으)ㄴ / -(으)ㄹ + 명사", "ja_parallel": "動詞連体形", "ja_diff_note": "Tense lives in the modifier ending (먹는/먹은/먹을)."},
    {"code": "G.NEUN_GEOT", "htsk_lesson": 26, "label_ko": "-는 것", "ja_parallel": "〜こと／〜の", "ja_diff_note": "Covers both こと and の."},
    {"code": "G.DEON", "htsk_lesson": 27, "label_ko": "-던 / -았던", "ja_parallel": "〜ていた (回想)", "ja_diff_note": "Retrospective; no single Japanese form.", "kiwi_pattern": [[{"tag": "ETM", "form": "던"}]]},
    {"code": "G.ADN_ITDA", "htsk_lesson": 28, "label_ko": "있다/없다 + -는 (맛있는)", "ja_parallel": null, "ja_diff_note": "있다/없다 adjectives take -는, not -(으)ㄴ."}
  ]
}
