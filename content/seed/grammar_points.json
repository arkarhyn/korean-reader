{
  "_note": "HTSK grammar points (map only; no HTSK text). L1-28 reviewed by Austin 2026-10-03 (Stage 4); L29-50 + priority threads drafted in Stage 8 (2026-10-05, pending Austin's review). Mirrored in docs/SYLLABUS_MAP.md. Every point has a kiwi_pattern. teach_order (optional) overrides htsk_lesson for the order lessons are taught in (priority threads).",
  "points": [
    {"code": "G.TOPIC", "htsk_lesson": 1, "label_ko": "은/는", "ja_parallel": "は", "ja_diff_note": "Close match, incl. contrast use.", "kiwi_pattern": [[{"tag": "JX", "form": ["은", "는", "ᆫ"]}]]},
    {"code": "G.COPULA", "htsk_lesson": 1, "label_ko": "이다", "ja_parallel": "だ／である", "ja_diff_note": "Attaches to the noun and conjugates like a verb (학생이에요).", "kiwi_pattern": [[{"tag": "VCP"}]]},
    {"code": "G.SUBJ", "htsk_lesson": 2, "label_ko": "이/가", "ja_parallel": "が", "ja_diff_note": "Close match; 이/가 also marks the complement of 되다/아니다.", "kiwi_pattern": [[{"tag": "JKS", "form": ["이", "가"]}]]},
    {"code": "G.ISSTA", "htsk_lesson": 2, "label_ko": "있다/없다", "ja_parallel": "ある・いる／ない", "ja_diff_note": "No animate/inanimate split; also 'to have'.", "kiwi_pattern": [[{"tag": ["VA", "VV"], "form": ["있", "없", "계시"]}]]},
    {"code": "G.OBJ", "htsk_lesson": 3, "label_ko": "을/를", "ja_parallel": "を", "ja_diff_note": "Used with 좋아하다 where Japanese uses が (好きだ).", "kiwi_pattern": [[{"tag": "JKO"}]]},
    {"code": "G.UI", "htsk_lesson": 3, "label_ko": "의", "ja_parallel": "の", "ja_diff_note": "Often dropped in speech (엄마 친구), unlike の.", "kiwi_pattern": [[{"tag": "JKG", "form": "의"}]]},
    {"code": "G.ADN_ADJ", "htsk_lesson": 4, "label_ko": "-(으)ㄴ + 명사 (형용사)", "ja_parallel": "形容詞連体形", "ja_diff_note": "Adjectives need a modifier ending; no bare 終止形 before a noun.", "kiwi_pattern": [[{"tag": ["VA", "XSA"]}, {"tag": "ETM", "form": ["ᆫ", "은"]}]]},
    {"code": "G.DO", "htsk_lesson": 4, "label_ko": "도", "ja_parallel": "も", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "JX", "form": "도"}]]},
    {"code": "G.PAST", "htsk_lesson": 5, "label_ko": "-았/었-", "ja_parallel": "た", "ja_diff_note": "Also used for resulting states where Japanese uses ている (결혼했어요 = 結婚している).", "kiwi_pattern": [[{"tag": "EP", "form": ["었", "았", "였", "ᆻ"]}]]},
    {"code": "G.PLAIN_PRES", "htsk_lesson": 5, "label_ko": "-ㄴ/는다", "ja_parallel": "書き言葉の現在形 (である体)", "ja_diff_note": "Written/plain style; in speech it sounds like narration or exclamation.", "kiwi_pattern": [[{"tag": "EF", "form": ["는다", "ᆫ다"]}]]},
    {"code": "G.FUT", "htsk_lesson": 5, "label_ko": "-(으)ㄹ 것이다 / 거예요", "ja_parallel": "つもりだ／だろう", "ja_diff_note": "Covers both intention and conjecture; Japanese splits them.", "kiwi_pattern": [[{"tag": "ETM", "form": ["ᆯ", "을"]}, {"tag": "NNB", "form": ["거", "것"]}, {"tag": "VCP"}]]},
    {"code": "G.HAEYO", "htsk_lesson": 6, "label_ko": "-아/어요", "ja_parallel": "です・ます", "ja_diff_note": "Everyday polite; less formal than です・ます feels in writing.", "kiwi_pattern": [[{"tag": "EF", "form_re": "요$"}], [{"tag": "JX", "form": "요"}]]},
    {"code": "G.HAMNIDA", "htsk_lesson": 6, "label_ko": "-(스)ㅂ니다", "ja_parallel": "です・ます (改まった)", "ja_diff_note": "Formal/news/announcement register; no exact Japanese level.", "kiwi_pattern": [[{"tag": "EF", "form_re": "^(ᆸ|습)(니다|니까|시오)$"}]]},
    {"code": "G.BANMAL", "htsk_lesson": 6, "label_ko": "-아/어 (반말)", "ja_parallel": "タメ口", "ja_diff_note": "Same form serves statement, question, command, suggestion by intonation.", "kiwi_pattern": [[{"tag": "EF", "form": ["어", "아", "여", "야", "지", "래", "ᆯ래", "을래", "ᆯ게", "을게", "자", "냐", "니", "거든", "잖아", "네", "어라", "아라", "ᆫ데", "는데", "더라"]}]]},
    {"code": "G.HUMBLE_PRON", "htsk_lesson": 6, "label_ko": "저/제 vs 나/내", "ja_parallel": "私 vs 僕・俺", "ja_diff_note": "Choice is tied to the speech level, not gender.", "kiwi_pattern": [[{"tag": "NP", "form": ["저", "저희", "나"]}], [{"tag": "MM", "form": "내"}]]},
    {"code": "G.IRREG_B", "htsk_lesson": 7, "label_ko": "ㅂ 불규칙", "ja_parallel": null, "ja_diff_note": null, "kiwi_pattern": [[{"tag": ["VV", "VA"], "irr": true, "jong": "ㅂ"}, {"form_re": "^[어아으와워었았]"}]]},
    {"code": "G.IRREG_D_S", "htsk_lesson": 7, "label_ko": "ㄷ / ㅅ 불규칙", "ja_parallel": null, "ja_diff_note": null, "kiwi_pattern": [[{"tag": ["VV", "VA"], "irr": true, "jong": ["ㄷ", "ㅅ"]}, {"form_re": "^[어아으었았]"}]]},
    {"code": "G.IRREG_REU_L", "htsk_lesson": 7, "label_ko": "르 불규칙 / ㄹ 탈락", "ja_parallel": null, "ja_diff_note": null, "kiwi_pattern": [[{"tag": ["VV", "VA"], "form_re": "르$"}, {"form_re": "^[어아]"}], [{"tag": ["VV", "VA"], "jong": "ㄹ"}, {"form_re": "^(니|ᆫ|ᆸ|ᆯ|세|시|오)"}]]},
    {"code": "G.ADV_GE", "htsk_lesson": 8, "label_ko": "-게 (부사형)", "ja_parallel": "〜く／〜に", "ja_diff_note": "Also 'so that' (Stage 8 point), unlike 〜く.", "kiwi_pattern": [[{"tag": ["VA", "XSA"]}, {"tag": "EC", "form": "게"}]]},
    {"code": "G.NEG_AN", "htsk_lesson": 8, "label_ko": "안 + 용언", "ja_parallel": "〜ない", "ja_diff_note": "Pre-verbal; Japanese negates with a suffix.", "kiwi_pattern": [[{"tag": "MAG", "form": "안"}]]},
    {"code": "G.JI_ANTA", "htsk_lesson": 8, "label_ko": "-지 않다", "ja_parallel": "〜ない (長形)", "ja_diff_note": "Long negation; more neutral/written than 안.", "kiwi_pattern": [[{"tag": "EC", "form": "지"}, {"tag": "VX", "form": "않"}]]},
    {"code": "G.ANIDA", "htsk_lesson": 9, "label_ko": "아니다", "ja_parallel": "ではない", "ja_diff_note": "Takes 이/가 on the noun (학생이 아니에요).", "kiwi_pattern": [[{"tag": "VCN"}]]},
    {"code": "G.COUNTERS", "htsk_lesson": 10, "label_ko": "고유어/한자어 숫자 + 단위", "ja_parallel": "数詞＋助数詞", "ja_diff_note": "Native numbers for hours/items/age, Sino for minutes/dates/money.", "kiwi_pattern": [[{"tag": "NR"}, {"tag": ["NNB", "NNG"]}], [{"tag": "MM", "form": ["한", "두", "세", "네", "다섯", "여섯", "일곱", "여덟", "아홉", "열", "스무", "몇"]}, {"tag": ["NNB", "NNG"]}]]},
    {"code": "G.DONGAN", "htsk_lesson": 11, "label_ko": "동안", "ja_parallel": "間", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "NNG", "form": "동안"}]]},
    {"code": "G.MAN", "htsk_lesson": 12, "label_ko": "만", "ja_parallel": "だけ／ばかり", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "JX", "form": "만"}]]},
    {"code": "G.ESEO", "htsk_lesson": 12, "label_ko": "에서", "ja_parallel": "で／から", "ja_diff_note": "에서 = place of action (で) and origin (から); 에 = location of existence (に).", "kiwi_pattern": [[{"tag": "JKB", "form": "에서"}]]},
    {"code": "G.BUTEO_KKAJI", "htsk_lesson": 12, "label_ko": "부터/까지", "ja_parallel": "から／まで", "ja_diff_note": "부터 is time/order; spatial 'from' is 에서.", "kiwi_pattern": [[{"tag": "JX", "form": ["부터", "까지"]}]]},
    {"code": "G.EURO", "htsk_lesson": 12, "label_ko": "(으)로", "ja_parallel": "で／へ／に", "ja_diff_note": "Means, direction, and change-into (으로 바뀌다).", "kiwi_pattern": [[{"tag": "JKB", "form": ["로", "으로"]}]]},
    {"code": "G.WA_GWA", "htsk_lesson": 13, "label_ko": "와/과, 하고, (이)랑", "ja_parallel": "と", "ja_diff_note": "Three registers: 와/과 written, 하고 neutral, 랑 casual.", "kiwi_pattern": [[{"tag": ["JC", "JKB"], "form": ["와", "과", "하고", "랑", "이랑"]}]]},
    {"code": "G.EGE", "htsk_lesson": 13, "label_ko": "-에게", "ja_parallel": "に", "ja_diff_note": "Only for people/animals (places take 에).", "kiwi_pattern": [[{"tag": "JKB", "form": "에게"}]]},
    {"code": "G.HANTE", "htsk_lesson": 13, "label_ko": "-한테", "ja_parallel": "に", "ja_diff_note": "Spoken form of 에게.", "kiwi_pattern": [[{"tag": "JKB", "form": "한테"}]]},
    {"code": "G.KKE", "htsk_lesson": 13, "label_ko": "-께", "ja_parallel": "に (尊敬)", "ja_diff_note": "Honorific 에게; no particle-level honorific in Japanese.", "kiwi_pattern": [[{"tag": "JKB", "form": "께"}]]},
    {"code": "G.WIHAE", "htsk_lesson": 13, "label_ko": "위해(서)", "ja_parallel": "ために", "ja_diff_note": "Close match (N을 위해, -기 위해).", "kiwi_pattern": [[{"tag": "VV", "form": "위하"}]]},
    {"code": "G.E_DAEHAE", "htsk_lesson": 13, "label_ko": "에 대해(서)", "ja_parallel": "について", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "JKB", "form": "에"}, {"tag": "VV", "form": "대하"}]]},
    {"code": "G.PASSIVE", "htsk_lesson": 14, "label_ko": "-이/히/리/기- (피동)", "ja_parallel": "れる／られる", "ja_diff_note": "Lexical, not productive; many verbs use -아/어지다 or 되다 instead.", "kiwi_pattern": [[{"tag": "VV", "form": ["열리", "닫히", "들리", "잡히", "팔리", "쓰이", "놓이", "바뀌", "풀리", "걸리", "막히", "쌓이", "읽히", "안기", "끊기", "잠기", "밟히", "물리", "먹히"]}]]},
    {"code": "G.A_HADA", "htsk_lesson": 15, "label_ko": "-아/어하다", "ja_parallel": "〜がる", "ja_diff_note": "Turns a feeling adjective into a verb (좋아하다, 싫어하다).", "kiwi_pattern": [[{"tag": "EC", "form": ["어", "아"]}, {"tag": "VX", "form": "하"}]]},
    {"code": "G.JEOK", "htsk_lesson": 16, "label_ko": "-적 / -적으로 / -적이다", "ja_parallel": "的", "ja_diff_note": "Same Sino suffix; 적 takes 인 before nouns (일반적인).", "kiwi_pattern": [[{"tag": "XSN", "form": "적"}]]},
    {"code": "G.SEUREOPDA", "htsk_lesson": 16, "label_ko": "-스럽다", "ja_parallel": "〜らしい", "ja_diff_note": "Not conjecture (らしい 推量); only 'seeming/full of'.", "kiwi_pattern": [[{"tag": "XSA", "form": "스럽"}]]},
    {"code": "G.GO", "htsk_lesson": 17, "label_ko": "-고", "ja_parallel": "〜て (並列)", "ja_diff_note": "Listing/sequence; cause-sequence uses -아/어서, not -고.", "kiwi_pattern": [[{"tag": "EC", "form": "고"}]]},
    {"code": "G.GO_SIPDA", "htsk_lesson": 17, "label_ko": "-고 싶다", "ja_parallel": "〜たい", "ja_diff_note": "Third person uses -고 싶어하다 (〜たがる).", "kiwi_pattern": [[{"tag": "EC", "form": "고"}, {"tag": "VX", "form": "싶"}]]},
    {"code": "G.GO_ITDA", "htsk_lesson": 18, "label_ko": "-고 있다", "ja_parallel": "〜ている (進行)", "ja_diff_note": "Progressive only; resultant ている is -아/어 있다 or past.", "kiwi_pattern": [[{"tag": "EC", "form": "고"}, {"tag": "VX", "form": ["있", "계시"]}]]},
    {"code": "G.EOJIDA", "htsk_lesson": 18, "label_ko": "-아/어지다", "ja_parallel": "〜くなる", "ja_diff_note": "With adjectives = become; with verbs = passive (Lesson 14 territory).", "kiwi_pattern": [[{"tag": "EC", "form": ["어", "아"]}, {"tag": "VX", "form": "지"}]]},
    {"code": "G.BODA", "htsk_lesson": 19, "label_ko": "보다 / 더 / 가장", "ja_parallel": "より／もっと／一番", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "JKB", "form": "보다"}], [{"tag": "MAG", "form": ["더", "가장", "제일"]}]]},
    {"code": "G.NEG_MOT", "htsk_lesson": 20, "label_ko": "못 + 용언", "ja_parallel": "〜できない", "ja_diff_note": "Inability by negation, not a potential form.", "kiwi_pattern": [[{"tag": "MAG", "form": "못"}]]},
    {"code": "G.JI_MOTHADA", "htsk_lesson": 20, "label_ko": "-지 못하다", "ja_parallel": "〜できない (長形)", "ja_diff_note": "Long form of 못.", "kiwi_pattern": [[{"tag": "EC", "form": "지"}, {"tag": "MAG", "form": "못"}, {"form": "하"}], [{"tag": "EC", "form": "지"}, {"tag": "VX", "form": "못하"}]]},
    {"code": "G.QWORDS", "htsk_lesson": 21, "label_ko": "왜/언제/어디/누구/어떻게/뭐/어느/몇", "ja_parallel": "疑問詞", "ja_diff_note": "Same words double as indefinites (뭐 = 何か) by intonation.", "kiwi_pattern": [[{"tag": ["MAG", "NP", "MM", "IC"], "form": ["왜", "언제", "어디", "누구", "뭐", "무엇", "어느", "몇", "무슨", "어떻게"]}], [{"tag": "VA", "form": "어떻"}]]},
    {"code": "G.IRREG_H", "htsk_lesson": 23, "label_ko": "ㅎ 불규칙 (이렇다, 빨개요)", "ja_parallel": null, "ja_diff_note": null, "kiwi_pattern": [[{"tag": "VA", "irr": true, "jong": "ㅎ"}, {"form_re": "^[어아었았ᆫᆯᆷ으]"}]]},
    {"code": "G.GI_JEONE", "htsk_lesson": 24, "label_ko": "-기 전에", "ja_parallel": "〜前に", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "ETN", "form": "기"}, {"tag": "NNG", "form": "전"}]]},
    {"code": "G.EUN_HUE", "htsk_lesson": 24, "label_ko": "-(으)ㄴ 후에", "ja_parallel": "〜た後で", "ja_diff_note": "Close match; also -(으)ㄴ 다음에.", "kiwi_pattern": [[{"tag": "ETM", "form": ["ᆫ", "은"]}, {"tag": "NNG", "form": ["후", "다음", "뒤"]}]]},
    {"code": "G.AMU", "htsk_lesson": 25, "label_ko": "아무도/아무나, 누구나/누군가", "ja_parallel": "誰も／誰でも／誰か", "ja_diff_note": "아무도 needs a negative predicate, like 誰も.", "kiwi_pattern": [[{"tag": "NP", "form": "아무"}, {"tag": "JX", "form": ["도", "나"]}], [{"tag": "NP", "form": "누구"}, {"tag": "JX", "form": ["나", "든지", "ᆫ가", "도"]}], [{"tag": "NP", "form": ["아무것", "누군가", "아무데"]}]]},
    {"code": "G.ADN_VERB", "htsk_lesson": 26, "label_ko": "-는 / -(으)ㄴ / -(으)ㄹ + 명사", "ja_parallel": "動詞連体形", "ja_diff_note": "Tense lives in the modifier ending (먹는/먹은/먹을).", "kiwi_pattern": [[{"tag": ["VV", "XSV"]}, {"tag": "ETM", "form": ["는", "ᆫ", "은", "ᆯ", "을"]}]]},
    {"code": "G.NEUN_GEOT", "htsk_lesson": 26, "label_ko": "-는 것", "ja_parallel": "〜こと／〜の", "ja_diff_note": "Covers both こと and の.", "kiwi_pattern": [[{"tag": "ETM", "form": "는"}, {"tag": "NNB", "form": ["것", "거"]}]]},
    {"code": "G.DEON", "htsk_lesson": 27, "label_ko": "-던 / -았던", "ja_parallel": "〜ていた (回想)", "ja_diff_note": "Retrospective; no single Japanese form.", "kiwi_pattern": [[{"tag": "ETM", "form": "던"}]]},
    {"code": "G.ADN_ITDA", "htsk_lesson": 28, "label_ko": "있다/없다 + -는 (맛있는)", "ja_parallel": null, "ja_diff_note": "있다/없다 adjectives take -는, not -(으)ㄴ.", "kiwi_pattern": [[{"tag": "VA", "form_re": "(있|없)$"}, {"tag": "ETM", "form": "는"}]]},
    {"code": "G.GI_NOMINAL", "htsk_lesson": 29, "label_ko": "-기 (명사형)", "ja_parallel": "〜こと／〜の (名詞化)", "ja_diff_note": "Fixed frames (-기 싫다/쉽다/좋다) where Japanese uses 〜のが嫌だ/〜やすい.", "kiwi_pattern": [[{"tag": "ETN", "form": "기"}]]},
    {"code": "G.EUM", "htsk_lesson": 29, "label_ko": "-(으)ㅁ (명사형)", "ja_parallel": "〜こと (書き言葉)", "ja_diff_note": "Written/notice style (확인함) and fixed nouns (기쁨); in speech -는 것 is used instead.", "kiwi_pattern": [[{"tag": "ETN", "form": ["ᆷ", "음"]}], [{"tag": "EF", "form": ["ᆷ", "음"]}]]},
    {"code": "G.NEUNJI", "htsk_lesson": 30, "label_ko": "-는지 / -(으)ㄴ지 (whether)", "ja_parallel": "〜か (間接疑問)", "ja_diff_note": "Embedded question ending; 〜かどうか uses -는지 안 -는지.", "kiwi_pattern": [[{"tag": "EC", "form": ["는지", "ᆫ지", "은지", "ᆯ지", "을지"]}]]},
    {"code": "G.EUN_JI", "htsk_lesson": 30, "label_ko": "-(으)ㄴ 지 (since)", "ja_parallel": "〜てから (時間)", "ja_diff_note": "Only with a time span + 되다/지나다 (온 지 1년 됐다); not a general 'since'.", "kiwi_pattern": [[{"tag": "ETM", "form": ["ᆫ", "은"]}, {"tag": "NNB", "form": "지"}]]},
    {"code": "G.NEUN_GEOSIDA", "htsk_lesson": 31, "label_ko": "-는 것이다 / -는 거예요", "ja_parallel": "〜のだ／〜んです", "ja_diff_note": "Explanatory 'it's that...'; much less frequent than んです.", "kiwi_pattern": [[{"tag": "ETM", "form": ["는", "ᆫ", "은"]}, {"tag": "NNB", "form": ["것", "거"]}, {"tag": "VCP"}]]},
    {"code": "G.NEUNDANEUN", "htsk_lesson": 31, "label_ko": "-ㄴ/는다는 것 (the fact that)", "ja_parallel": "〜ということ", "ja_diff_note": "Close match; contracted 다는 is the quoting ending + modifier.", "kiwi_pattern": [[{"tag": "ETM", "form_re": "다는$"}, {"tag": "NNB", "form": ["것", "거"]}]]},
    {"code": "G.RYEOGO", "htsk_lesson": 32, "label_ko": "-(으)려고 (하다)", "ja_parallel": "〜ようと(する)", "ja_diff_note": "Also 'in order to' with any following verb; -(으)러 only before motion verbs.", "kiwi_pattern": [[{"tag": "EC", "form": ["려고", "으려고"]}]]},
    {"code": "G.REO", "htsk_lesson": 32, "label_ko": "-(으)러 가다/오다", "ja_parallel": "〜に行く／来る", "ja_diff_note": "Close match; only with motion verbs.", "kiwi_pattern": [[{"tag": "EC", "form": ["러", "으러"]}]]},
    {"code": "G.A_BODA", "htsk_lesson": 32, "label_ko": "-아/어 보다 (try)", "ja_parallel": "〜てみる", "ja_diff_note": "Close match; past -아/어 봤다 = 'have done (experience)' like 〜たことがある.", "kiwi_pattern": [[{"tag": "EC", "form": ["어", "아"]}, {"tag": "VX", "form": "보"}]]},
    {"code": "G.JUNG", "htsk_lesson": 33, "label_ko": "중 / -는 중", "ja_parallel": "〜中／〜ている最中", "ja_diff_note": "Close match (회의 중 = 会議中); -는 중 adds 'in the middle of'.", "kiwi_pattern": [[{"tag": "NNB", "form": "중"}]]},
    {"code": "G.EUL_GEOT_GATDA", "htsk_lesson": 35, "label_ko": "-(으)ㄹ/는 것 같다", "ja_parallel": "〜そうだ／〜ようだ／〜と思う", "ja_diff_note": "One form covers guess, impression and soft opinion; tense sits in the modifier.", "kiwi_pattern": [[{"tag": "ETM", "form": ["ᆯ", "을", "는", "ᆫ", "은"]}, {"tag": "NNB", "form": ["것", "거"]}, {"tag": "VA", "form": "같"}]]},
    {"code": "G.A_BOIDA", "htsk_lesson": 36, "label_ko": "-아/어 보이다 / N같이 보이다", "ja_parallel": "〜く見える／〜そうに見える", "ja_diff_note": "Adjective + 보이다 only; for verbs use -는 것 같다.", "kiwi_pattern": [[{"tag": "EC", "form": ["어", "아"]}, {"tag": "VV", "form": "보이"}], [{"tag": "JKB", "form": "같이"}, {"tag": "VV", "form": "보이"}]]},
    {"code": "G.A_SEO", "htsk_lesson": 37, "label_ko": "-아/어서", "ja_parallel": "〜て／〜ので", "ja_diff_note": "Cause or sequence; cannot take past tense or a command/suggestion after a cause.", "kiwi_pattern": [[{"tag": "EC", "form": ["어서", "아서", "여서", "라서", "이라서"]}]]},
    {"code": "G.TTAEMUNE", "htsk_lesson": 38, "label_ko": "-기 때문에 / N 때문에", "ja_parallel": "〜ので／〜のせいで", "ja_diff_note": "More explicit/written than -아/어서; N 때문에 often negative (のせい).", "kiwi_pattern": [[{"tag": "NNB", "form": "때문"}]]},
    {"code": "G.SI_HON", "htsk_lesson": 39, "label_ko": "-(으)시- (주체 높임)", "ja_parallel": "お〜になる／尊敬語", "ja_diff_note": "Productive suffix on any predicate; used for parents/elders even in family talk.", "kiwi_pattern": [[{"tag": "EP", "form": ["시", "으시"]}], [{"tag": "EF", "form_re": "^(으)?(세요|십시오|셔요|셔)$"}], [{"tag": "VV", "form": ["주무시", "드시", "계시", "잡수시", "돌아가시"]}]]},
    {"code": "G.HON_WORDS", "htsk_lesson": 39, "label_ko": "높임 어휘 (드리다, 계시다, 께서, 댁, 진지...)", "ja_parallel": "尊敬語／謙譲語の語彙", "ja_diff_note": "Like 召し上がる/伺う: suppletive words, plus 께서 as honorific subject marker.", "kiwi_pattern": [[{"tag": "JKS", "form": "께서"}], [{"tag": "VV", "form": ["드리", "뵙", "뵈", "여쭈", "여쭙", "모시"]}], [{"tag": "NNG", "form": ["진지", "댁", "연세", "성함", "말씀", "생신", "따님", "아드님"]}]]},
    {"code": "G.SEYO", "htsk_lesson": 40, "label_ko": "-(으)세요 (polite request)", "ja_parallel": "〜てください", "ja_diff_note": "Same ending as an honorific statement/question; context decides.", "kiwi_pattern": [[{"tag": "EF", "form": ["세요", "으세요"]}]]},
    {"code": "G.A_RA", "htsk_lesson": 40, "label_ko": "-아/어라 (command)", "ja_parallel": "〜ろ／〜なさい", "ja_diff_note": "Blunt plain command; parents to children, or quoted/written.", "kiwi_pattern": [[{"tag": "EF", "form": ["어라", "아라", "여라"]}]]},
    {"code": "G.A_JUDA", "htsk_lesson": 41, "label_ko": "-아/어 주다 / 드리다", "ja_parallel": "〜てくれる／〜てあげる", "ja_diff_note": "No くれる/あげる split: direction comes from context; 드리다 for elders.", "kiwi_pattern": [[{"tag": "EC", "form": ["어", "아"]}, {"tag": "VX", "form": ["주", "드리"]}]]},
    {"code": "G.EUL_TTAE", "htsk_lesson": 42, "label_ko": "-(으)ㄹ 때", "ja_parallel": "〜とき", "ja_diff_note": "Always the -(으)ㄹ form, even for past (갔을 때 = 行ったとき).", "kiwi_pattern": [[{"tag": "ETM", "form": ["ᆯ", "을"]}, {"tag": "NNG", "form": "때"}]]},
    {"code": "G.MYEON", "htsk_lesson": 43, "label_ko": "-(으)면", "ja_parallel": "〜たら／〜ば／〜と", "ja_diff_note": "One ending for たら/ば/と.", "kiwi_pattern": [[{"tag": "EC", "form": ["면", "으면"]}]]},
    {"code": "G.NDAMYEON", "htsk_lesson": 43, "label_ko": "-ㄴ/는다면", "ja_parallel": "〜としたら／もし〜なら", "ja_diff_note": "Hypothetical/unlikely; -(으)면 is the everyday conditional.", "kiwi_pattern": [[{"tag": "EC", "form_re": "다면$"}]]},
    {"code": "G.JA", "htsk_lesson": 44, "label_ko": "-자 (let's, 반말)", "ja_parallel": "〜よう (意向形)", "ja_diff_note": "Plain 'let's' only among close equals.", "kiwi_pattern": [[{"tag": "EF", "form": "자"}]]},
    {"code": "G.EUPSIDA", "htsk_lesson": 44, "label_ko": "-(으)ㅂ시다", "ja_parallel": "〜ましょう", "ja_diff_note": "Not for elders (sounds like an order); use -(으)시죠 or -아/어요.", "kiwi_pattern": [[{"tag": "EF", "form": ["ᆸ시다", "읍시다"]}]]},
    {"code": "G.EULLAE", "htsk_lesson": 44, "label_ko": "-(으)ㄹ래(요)", "ja_parallel": "〜する？／〜しようか", "ja_diff_note": "Asks the listener's wish; also 'I want to' in statements.", "kiwi_pattern": [[{"tag": "EF", "form_re": "^(ᆯ|을)래(요)?$"}]]},
    {"code": "G.EUL_SU_ITDA", "htsk_lesson": 45, "label_ko": "-(으)ㄹ 수 있다/없다", "ja_parallel": "〜ことができる", "ja_diff_note": "Also 'might/possible' (그럴 수 있다); potential verbs don't exist.", "kiwi_pattern": [[{"tag": "ETM", "form": ["ᆯ", "을"]}, {"tag": "NNB", "form": "수"}, {"form": ["있", "없"]}], [{"tag": "ETM", "form": ["ᆯ", "을"]}, {"tag": "NNB", "form": "수"}, {"tag": "JX"}, {"form": ["있", "없"]}], [{"tag": "ETM", "form": ["ᆯ", "을"]}, {"tag": "NNB", "form": "수"}, {"tag": "JKS"}, {"form": ["있", "없"]}]]},
    {"code": "G.A_YA_HADA", "htsk_lesson": 46, "label_ko": "-아/어야 하다/되다", "ja_parallel": "〜なければならない", "ja_diff_note": "Positive frame ('only if ~ does it work'), shorter than Japanese.", "kiwi_pattern": [[{"tag": "EC", "form": ["어야", "아야", "여야"]}, {"tag": ["VX", "VV"], "form": ["하", "되"]}]]},
    {"code": "G.EUL_PILYO", "htsk_lesson": 46, "label_ko": "-(으)ㄹ 필요가 있다/없다", "ja_parallel": "〜必要がある", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "ETM", "form": ["ᆯ", "을"]}, {"tag": "NNG", "form": "필요"}]]},
    {"code": "G.JIMAN", "htsk_lesson": 47, "label_ko": "-지만", "ja_parallel": "〜けど／〜が", "ja_diff_note": "Contrast only; the softer background けど is -는데 (thread).", "kiwi_pattern": [[{"tag": ["EC", "EF"], "form": "지만"}]]},
    {"code": "G.A_DO", "htsk_lesson": 48, "label_ko": "-아/어도 (even if)", "ja_parallel": "〜ても", "ja_diff_note": "Close match; 아무리 -아/어도 = いくら〜ても.", "kiwi_pattern": [[{"tag": "EC", "form": ["어도", "아도", "여도", "라도", "이라도"]}]]},
    {"code": "G.A_DO_DOEDA", "htsk_lesson": 49, "label_ko": "-아/어도 되다", "ja_parallel": "〜てもいい", "ja_diff_note": "Close match; 안 -아/어도 되다 = 〜なくてもいい.", "kiwi_pattern": [[{"tag": "EC", "form": ["어도", "아도", "여도"]}, {"tag": ["VV", "VA"], "form": ["되", "괜찮"]}]]},
    {"code": "G.EUL_YEJEONG", "htsk_lesson": 50, "label_ko": "-(으)ㄹ 예정/계획이다", "ja_parallel": "〜予定だ／〜つもりだ", "ja_diff_note": "Close match.", "kiwi_pattern": [[{"tag": "ETM", "form": ["ᆯ", "을"]}, {"tag": "NNG", "form": ["예정", "계획"]}]]},
    {"code": "G.NEUNDE", "htsk_lesson": 76, "label_ko": "-는데 / -(으)ㄴ데", "ja_parallel": "〜けど／〜んだけど (前置き)", "ja_diff_note": "Sets background more than it contrasts; ending a sentence with -는데(요) softens it.", "kiwi_pattern": [[{"tag": ["EC", "EF"], "form_re": "^(는|ᆫ|은)데(요)?$"}]], "teach_order": 37.5},
    {"code": "G.NIKKA", "htsk_lesson": 81, "label_ko": "-(으)니까", "ja_parallel": "〜から", "ja_diff_note": "Subjective reason; fine before commands/suggestions, unlike -아/어서.", "kiwi_pattern": [[{"tag": "EC", "form": ["니까", "으니까", "니", "으니"]}]], "teach_order": 38.5},
    {"code": "G.DEONI", "htsk_lesson": null, "label_ko": "-더니", "ja_parallel": "〜たら (発見)／〜と思ったら", "ja_diff_note": "Speaker's past observation leading to a change or result; no single Japanese form.", "kiwi_pattern": [[{"tag": "EC", "form": ["더니", "었더니", "았더니"]}]], "teach_order": 50.5},
    {"code": "G.KIRO_HADA", "htsk_lesson": 87, "label_ko": "-기로 하다", "ja_parallel": "〜ことにする", "ja_diff_note": "Close match; 했다 for a decision already made.", "kiwi_pattern": [[{"tag": "ETN", "form": "기"}, {"tag": "JKB", "form": "로"}, {"tag": "VV", "form": "하"}]], "teach_order": 50.7}
  ]
}
