{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "디디와 정태웅의 한국생활 요모조모"
    } ]
  }, {
    "tStartMs": 9000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "안녕하세요 디디입니다."
    } ]
  }, {
    "tStartMs": 11000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "안녕하세요 정태웅입니다."
    } ]
  }, {
    "tStartMs": 13000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "한국생활 요모조모는 한국에서 살아가는 두 사람이 한국생활의 요모조모를 이야기하는 팟캐스트입니다."
    } ]
  }, {
    "tStartMs": 20000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "지금 벌써 몇 화죠 이게? 5화인가요? 거의 한 달 했는데 어떠세요? 할만하신가요 태웅쌤?"
    } ]
  }, {
    "tStartMs": 30000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "저는 너무 재밌어요."
    } ]
  }, {
    "tStartMs": 31000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "괜찮아요? 다행이다."
    } ]
  }, {
    "tStartMs": 33000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "저는 얘기만 해도 되는 게 너무 편해요."
    } ]
  }, {
    "tStartMs": 36000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "제가 알아서 편집까지 다 해서 올리고 있습니다."
    } ]
  }, {
    "tStartMs": 42000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그렇죠."
    } ]
  }, {
    "tStartMs": 43000,
    "dDurationMs": 11000,
    "segs": [ {
      "utf8": "그리고 첫 번째 에피소드를 올렸을 때 되게 기분 좋은 댓글이 있었어서 먼저 그거를 좀 읽고 오늘 이야기를 하고 싶어요."
    } ]
  }, {
    "tStartMs": 55000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "근데 영어로 남겨주셨는데 제가 한국어 번역을 해가지고 읽어볼게요."
    } ]
  }, {
    "tStartMs": 67000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "이 팟캐스트 협업이 너무 기대돼요."
    } ]
  }, {
    "tStartMs": 69000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "디디와 태웅쌤은 정말 잘 어울리는 컴플레멘트라고 하셨는데 서로 보완하는 조합인 것 같아요."
    } ]
  }, {
    "tStartMs": 76000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "디디의 콘텐츠는 정말 체계적이고 깔끔해서 보기에도 듣기에도 편안하고 공부하는데 아주 도움이 돼요."
    } ]
  }, {
    "tStartMs": 83000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "그리고 태웅쌤의 콘텐츠는 그분의 호감과는 친근한 성격 덕분에 재미있게 볼 수 있어요."
    } ]
  }, {
    "tStartMs": 90000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "디디는 한국 문화 전반에 대해 더 많이 이야기하는 반면에 태웅쌤은 개인적인 삶의 경험을 많이 공유하는 것 같아요."
    } ]
  }, {
    "tStartMs": 98000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "그리고 두 분 다 언어 난이도를 조절하는 능력이 뛰어나면서도 그게 부자연스럽게 느껴지지 않아서 정말 좋아요."
    } ]
  }, {
    "tStartMs": 105000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "라고 남겨주셨어요."
    } ]
  }, {
    "tStartMs": 107000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "정말 기분 좋은 댓글입니다."
    } ]
  }, {
    "tStartMs": 110000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "되게 장점을 잘 집어서 알려주셔서 기분이 좋았어요."
    } ]
  }, {
    "tStartMs": 116000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "매우 뿌듯하네요."
    } ]
  }, {
    "tStartMs": 118000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그러니까요. 이거 좀 걱정했는데 많이 들어주실까."
    } ]
  }, {
    "tStartMs": 122000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "그래도 듣기 연습할 때 많이 들어주시는 것 같아서 좋습니다."
    } ]
  }, {
    "tStartMs": 129000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "정말 감사합니다."
    } ]
  }, {
    "tStartMs": 131000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "할 맛이 납니다. 감사합니다."
    } ]
  }, {
    "tStartMs": 133000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "컴플레멘트."
    } ]
  }, {
    "tStartMs": 135000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "컴플레멘트. Each other 이라고 하셨어요."
    } ]
  }, {
    "tStartMs": 139000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "경제 용어로 보완제라고 하죠."
    } ]
  }, {
    "tStartMs": 143000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "서로를 보완하는 것. 예를 들어 삼겹살과 상추가 있습니다."
    } ]
  }, {
    "tStartMs": 149000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그리고 치킨과 맥주랄까요."
    } ]
  }, {
    "tStartMs": 152000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "찰떡 비유다."
    } ]
  }, {
    "tStartMs": 156000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "보완제의 특징은 한 가지의 가격이 오르면 보완제의 가격도 같이 오른다는 겁니다."
    } ]
  }, {
    "tStartMs": 165000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "이거 태웅쌤 올 띵스 코리안 팟캐스트 1화에서 다룬 내용 아니에요."
    } ]
  }, {
    "tStartMs": 170000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "맞아요. 옛날에 다룬 내용이에요."
    } ]
  }, {
    "tStartMs": 172000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그쵸. 그쵸."
    } ]
  }, {
    "tStartMs": 173000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "2화였나 3화였나. 아무튼 옛날에 인터뷰하기 전에."
    } ]
  }, {
    "tStartMs": 177000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "혼자 하실 때."
    } ]
  }, {
    "tStartMs": 179000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "기억나네. 상어 보완제."
    } ]
  }, {
    "tStartMs": 184000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "이렇게 열심히 보완하면서 계속 이야기 해볼게요."
    } ]
  }, {
    "tStartMs": 189000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그래서 오늘의 주제 설명해볼게요. 오늘의 주제 뭐였죠?"
    } ]
  }, {
    "tStartMs": 195000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "오늘의 주제는 청소입니다."
    } ]
  }, {
    "tStartMs": 198000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "청소. 청소는 다들 알고 계실 것 같은데."
    } ]
  }, {
    "tStartMs": 202000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "더러운 거를 깨끗하게 치우는 그런 걸 청소라고 하죠."
    } ]
  }, {
    "tStartMs": 207000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "청소 종류가 되게 여러 가지가 있을 것 같은데."
    } ]
  }, {
    "tStartMs": 212000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그렇죠."
    } ]
  }, {
    "tStartMs": 213000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "집안 청소도 있고 화장실 청소도 있고 여러 가지 있습니다만."
    } ]
  }, {
    "tStartMs": 218000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "태웅쌤은 청소를 자주 하시나요?"
    } ]
  }, {
    "tStartMs": 221000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "저는 청소를 자주 하지 않아요."
    } ]
  }, {
    "tStartMs": 225000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그게 어느 정도예요?"
    } ]
  }, {
    "tStartMs": 229000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "청소를 어디까지 청소라고 부를까에 따라 다를 것 같은데요."
    } ]
  }, {
    "tStartMs": 236000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "사실 청소하고 정리가 있잖아요."
    } ]
  }, {
    "tStartMs": 241000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그렇죠. 정리, 정돈."
    } ]
  }, {
    "tStartMs": 246000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "정리가 좀 더 간단한 청소 느낌일까요?"
    } ]
  }, {
    "tStartMs": 252000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그쵸. 뭔가 흐트러져 있는 걸 제자리에 놓는 그 정도?"
    } ]
  }, {
    "tStartMs": 257000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그렇죠. 물건을 가지런하게 두고."
    } ]
  }, {
    "tStartMs": 261000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "물건을 제자리에 두고."
    } ]
  }, {
    "tStartMs": 264000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그런 면에서 저는 정리는 항상 해요."
    } ]
  }, {
    "tStartMs": 271000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그러니까. 뭔가 인스타그램에 책상 올리고 하시는 거 보면 되게 깔끔해 보였는데."
    } ]
  }, {
    "tStartMs": 277000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "네. 정리는 항상 해요."
    } ]
  }, {
    "tStartMs": 280000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "제가 정리가 안 돼 있는 꼴을 잘 못 봐서."
    } ]
  }, {
    "tStartMs": 283000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "진짜? 그럼 뭐 책상 정리, 침대, 침구 정리 이런 거를 하시는 거예요?"
    } ]
  }, {
    "tStartMs": 292000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "항상 하죠."
    } ]
  }, {
    "tStartMs": 293000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "옷 정리?"
    } ]
  }, {
    "tStartMs": 294000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "항상 하죠."
    } ]
  }, {
    "tStartMs": 296000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "잠시만. 옷장 정리는 잘 안 하는 것 같네요."
    } ]
  }, {
    "tStartMs": 299000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "옷장 정리라고 하면 그런 건가요?"
    } ]
  }, {
    "tStartMs": 301000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "계절이 바뀔 때마다 정리하고?"
    } ]
  }, {
    "tStartMs": 305000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "네. 옷을 하나하나 다 분류해서."
    } ]
  }, {
    "tStartMs": 309000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "어느 칸에 티셔츠 넣고."
    } ]
  }, {
    "tStartMs": 312000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "어느 칸에 얇은 바지 넣고. 이런 거?"
    } ]
  }, {
    "tStartMs": 316000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그런 건 자주 안 해요."
    } ]
  }, {
    "tStartMs": 319000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "안 해요?"
    } ]
  }, {
    "tStartMs": 321000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "옷장만 그렇고."
    } ]
  }, {
    "tStartMs": 323000,
    "dDurationMs": 10000,
    "segs": [ {
      "utf8": "하지만 책상, 침대, 책장 이런 다른 곳들은 항상 정리를 합니다만."
    } ]
  }, {
    "tStartMs": 333000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "근데 보통 청소하면 진공청소기를 돌린다던가."
    } ]
  }, {
    "tStartMs": 342000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "바닥을 걸레로 닦는다던가."
    } ]
  }, {
    "tStartMs": 345000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그런 게 떠오르잖아요."
    } ]
  }, {
    "tStartMs": 347000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그렇죠. 그렇죠."
    } ]
  }, {
    "tStartMs": 348000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "근데 그런 청소는 글쎄요. 한 2주에 한 번 하는 것 같아요."
    } ]
  }, {
    "tStartMs": 355000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "근데 태용쌤은 지금 가족과 살고 있잖아요."
    } ]
  }, {
    "tStartMs": 359000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 362000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "어때요? 혼자 청소를 해요?"
    } ]
  }, {
    "tStartMs": 367000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "저는 제 공간만 제가 청소를 해요."
    } ]
  }, {
    "tStartMs": 370000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "진짜요?"
    } ]
  }, {
    "tStartMs": 371000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네. 따로따로."
    } ]
  }, {
    "tStartMs": 373000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "근데 왜 태용쌤 거실, 부엌은요? 사용하시잖아요."
    } ]
  }, {
    "tStartMs": 381000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "사용은 하죠."
    } ]
  }, {
    "tStartMs": 386000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "사용은 하는데 제가 사용하지 않는 것들이 대부분이라."
    } ]
  }, {
    "tStartMs": 392000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "사용 빈도가 적다?"
    } ]
  }, {
    "tStartMs": 394000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 395000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "제가 어떻게 정리를 해야 할지도 잘 모르겠고."
    } ]
  }, {
    "tStartMs": 401000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "주 사용자가 정리를 하도록?"
    } ]
  }, {
    "tStartMs": 403000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그렇죠."
    } ]
  }, {
    "tStartMs": 406000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "제가 잘 알지도 못하는데 제 마음대로 정리해두면"
    } ]
  }, {
    "tStartMs": 411000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "좀 다른 사람이 사용할 때 혼란스러울 수도 있지 않을까요?"
    } ]
  }, {
    "tStartMs": 416000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그래서 안 하는 거 맞죠?"
    } ]
  }, {
    "tStartMs": 418000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그럼 2주에 한 번 정도 청소하실 때는 청소기 돌리고"
    } ]
  }, {
    "tStartMs": 422000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "뭐 밀대? 밀대라고 얘기하시나요? 밀대 같은 걸로 걸레질 하시나요?"
    } ]
  }, {
    "tStartMs": 428000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "밀대는 요즘은 안 쓰고."
    } ]
  }, {
    "tStartMs": 432000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "요즘은 바닥은 청소기만 돌리고"
    } ]
  }, {
    "tStartMs": 438000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "책상은 청소기만 돌리고"
    } ]
  }, {
    "tStartMs": 443000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "바닥은 청소기만 돌리고"
    } ]
  }, {
    "tStartMs": 447000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "책상 같은 건 닦아요."
    } ]
  }, {
    "tStartMs": 452000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그런데 요즘은 그냥 물티슈로 닦습니다."
    } ]
  }, {
    "tStartMs": 457000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "근데 전체적으로 되게 깨끗할 것 같아요."
    } ]
  }, {
    "tStartMs": 461000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그런 것 같아요."
    } ]
  }, {
    "tStartMs": 462000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "정리 매일 하고 한 달에 2번? 3번 정도 청소하니까."
    } ]
  }, {
    "tStartMs": 472000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "저랑 반대네요."
    } ]
  }, {
    "tStartMs": 474000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "디디님은 어떤지 물어보려고 했습니다."
    } ]
  }, {
    "tStartMs": 477000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "저랑 반대인 것 같아요."
    } ]
  }, {
    "tStartMs": 479000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "저는 정리가 잘 돼 있는 날이 거의 없는 것 같아요."
    } ]
  }, {
    "tStartMs": 483000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그런가요?"
    } ]
  }, {
    "tStartMs": 484000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네. 어지르기 선수예요."
    } ]
  }, {
    "tStartMs": 490000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "습관을 잘못 들인 것 같아요. 어렸을 때부터."
    } ]
  }, {
    "tStartMs": 493000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "아니 근데 어질러지는 게"
    } ]
  }, {
    "tStartMs": 498000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "어질러지기가 되게 쉬워요."
    } ]
  }, {
    "tStartMs": 502000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "맞죠?"
    } ]
  }, {
    "tStartMs": 503000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그런데 정리하는 거는 시간이 많이 걸려요?"
    } ]
  }, {
    "tStartMs": 508000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그게 하나하나 정리를..."
    } ]
  }, {
    "tStartMs": 513000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그러니까 하나 어질러졌을 때 하나 정리하면"
    } ]
  }, {
    "tStartMs": 517000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "얼마 안 걸리잖아요."
    } ]
  }, {
    "tStartMs": 520000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "근데 좀 여러 가지가 어질러지면"
    } ]
  }, {
    "tStartMs": 524000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "정리하는 게 좀 오래 걸리죠."
    } ]
  }, {
    "tStartMs": 528000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "팁이 있어요."
    } ]
  }, {
    "tStartMs": 529000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "진짜 사용한 것은 그냥 그 자리에 바로 놓는다라던가"
    } ]
  }, {
    "tStartMs": 536000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "룰이 있나요?"
    } ]
  }, {
    "tStartMs": 538000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "사실 그게 전부죠."
    } ]
  }, {
    "tStartMs": 539000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그게 다예요?"
    } ]
  }, {
    "tStartMs": 540000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "왜 난 못 놓는 거야?"
    } ]
  }, {
    "tStartMs": 542000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "일단 어떤 물건이 있어야 할 원래 자리, 제 자리를"
    } ]
  }, {
    "tStartMs": 551000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "분명하게 정해놓기."
    } ]
  }, {
    "tStartMs": 555000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그게 분명하면 다른 곳에 있더라도"
    } ]
  }, {
    "tStartMs": 558000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "어디에 둬야 할지 금방금방 알잖아요."
    } ]
  }, {
    "tStartMs": 563000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그게 처음인 것 같네요."
    } ]
  }, {
    "tStartMs": 566000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그러면 모든 물건에 자리가 있겠네요?"
    } ]
  }, {
    "tStartMs": 570000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그렇죠."
    } ]
  }, {
    "tStartMs": 571000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "진짜 그냥 휴지 하나라도? 물티슈 하나라도?"
    } ]
  }, {
    "tStartMs": 574000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "네. 그게 아니면"
    } ]
  }, {
    "tStartMs": 576000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "팁이 하나 있는데 여기서"
    } ]
  }, {
    "tStartMs": 578000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "약간 쓰레기통 아닌 쓰레기통 같은"
    } ]
  }, {
    "tStartMs": 584000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "서랍의 한 칸이라든지"
    } ]
  }, {
    "tStartMs": 586000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그래서 어디에 둘지 모르는"
    } ]
  }, {
    "tStartMs": 592000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "잡동사니를 모아두는 공간을 두는 거예요."
    } ]
  }, {
    "tStartMs": 600000,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "최대한 원래 자리가 있는 것들은 원래 자리에 두고"
    } ]
  }, {
    "tStartMs": 605600,
    "dDurationMs": 9040,
    "segs": [ {
      "utf8": "근데 이건 어디에 둬야 할지 모르겠다. 그러면 그 잡동산이 공간에 그냥 그냥 그냥 쳐박아 두는 거죠."
    } ]
  }, {
    "tStartMs": 614640,
    "dDurationMs": 1999,
    "segs": [ {
      "utf8": "약간 창고 같은 느낌으로?"
    } ]
  }, {
    "tStartMs": 616639,
    "dDurationMs": 1441,
    "segs": [ {
      "utf8": "네, 맞습니다."
    } ]
  }, {
    "tStartMs": 618080,
    "dDurationMs": 8080,
    "segs": [ {
      "utf8": "그러면 이것도 궁금한데 물건이 좀 많은 편이에요?"
    } ]
  }, {
    "tStartMs": 626240,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그건 상대적인 것 같은데요?"
    } ]
  }, {
    "tStartMs": 630240,
    "dDurationMs": 7679,
    "segs": [ {
      "utf8": "지금 앉아 있는 책상 위에 보이는 게 뭐뭐 있어요?"
    } ]
  }, {
    "tStartMs": 637919,
    "dDurationMs": 6401,
    "segs": [ {
      "utf8": "일단 모니터, 그리고 책 두 권,"
    } ]
  }, {
    "tStartMs": 644320,
    "dDurationMs": 8200,
    "segs": [ {
      "utf8": "그리고 인터뷰나 유튜브 촬영할 때 쓰는 핸드폰 거치대,"
    } ]
  }, {
    "tStartMs": 652520,
    "dDurationMs": 11920,
    "segs": [ {
      "utf8": "그리고 뭐 키보드, 그리고 제가 스케줄 같은 거 기록하고 수정하는 스케줄 보드,"
    } ]
  }, {
    "tStartMs": 664440,
    "dDurationMs": 9399,
    "segs": [ {
      "utf8": "그리고 양초, 캔들 하나, 그리고 그 노트 패드라고 하죠. 그 리갈 패드라고 하는."
    } ]
  }, {
    "tStartMs": 673839,
    "dDurationMs": 8241,
    "segs": [ {
      "utf8": "이런 거 두 개, 그리고 텀블러 하나, 물컵 하나,"
    } ]
  }, {
    "tStartMs": 682080,
    "dDurationMs": 5759,
    "segs": [ {
      "utf8": "그리고 아! 저는 스피커를 큰 거를 따로 쓰거든요."
    } ]
  }, {
    "tStartMs": 687839,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "아, 네."
    } ]
  }, {
    "tStartMs": 688919,
    "dDurationMs": 12561,
    "segs": [ {
      "utf8": "근데 그 스피커를 작은 뭐 한 손바닥 두 개만한 작은 서랍을 두 개 써서"
    } ]
  }, {
    "tStartMs": 701519,
    "dDurationMs": 5841,
    "segs": [ {
      "utf8": "그 서랍 하나씩 각각 스피커 자리에 두고 그 위에 스피커를 올려둬요."
    } ]
  }, {
    "tStartMs": 707360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "그래서 그 서랍도 공간을 좀 잘 활용하는 편입니다."
    } ]
  }, {
    "tStartMs": 710160,
    "dDurationMs": 3119,
    "segs": [ {
      "utf8": "아, 뭐 펜이나 그런 거 들어있어요?"
    } ]
  }, {
    "tStartMs": 713279,
    "dDurationMs": 7161,
    "segs": [ {
      "utf8": "네네네, 그리고 뭐 케이블 같은 거, USB 드라이브 이런 것도."
    } ]
  }, {
    "tStartMs": 720440,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그래서 잘 숨겨 놓는 거죠."
    } ]
  }, {
    "tStartMs": 722080,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "아, 깔끔하네요."
    } ]
  }, {
    "tStartMs": 726760,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "전 이것저것 올라가 있어요, 지금."
    } ]
  }, {
    "tStartMs": 728919,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "어떤 게 올라가 있나요?"
    } ]
  }, {
    "tStartMs": 729960,
    "dDurationMs": 8360,
    "segs": [ {
      "utf8": "뭐 비슷한데 컴퓨터 일단 용품들 있고, 여기 왜 있는지 모르겠는 것들이 몇 개 있는데."
    } ]
  }, {
    "tStartMs": 738320,
    "dDurationMs": 719,
    "segs": [ {
      "utf8": "뭔데요?"
    } ]
  }, {
    "tStartMs": 739039,
    "dDurationMs": 7240,
    "segs": [ {
      "utf8": "일단 옷 벨트, 뭐라 해야 되지? 잠바 벨트 같은 거."
    } ]
  }, {
    "tStartMs": 746279,
    "dDurationMs": 5441,
    "segs": [ {
      "utf8": "이거는 그 따로 보관이 안 돼요."
    } ]
  }, {
    "tStartMs": 751720,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "이게 그 옷에 벨트 거리 부분이 없어가지고."
    } ]
  }, {
    "tStartMs": 756520,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "그게 이렇게 붙어있는 게 아니고 따로 이렇게 보관을 해서 걸어놨어야 됐는데 귀찮아서 여기 둔 것 같고요."
    } ]
  }, {
    "tStartMs": 762160,
    "dDurationMs": 1239,
    "segs": [ {
      "utf8": "일단 의류가 있네요."
    } ]
  }, {
    "tStartMs": 763399,
    "dDurationMs": 3561,
    "segs": [ {
      "utf8": "의류가 있고, 그리고 돌돌이."
    } ]
  }, {
    "tStartMs": 766960,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "돌돌이?"
    } ]
  }, {
    "tStartMs": 768080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "얘도 지금 자리를 못 찾았어요."
    } ]
  }, {
    "tStartMs": 770240,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "이거 알아요?"
    } ]
  }, {
    "tStartMs": 771279,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "먼지 떼는 기구죠?"
    } ]
  }, {
    "tStartMs": 773960,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "네, 이거 있고."
    } ]
  }, {
    "tStartMs": 776759,
    "dDurationMs": 4321,
    "segs": [ {
      "utf8": "화장품 팟캐스트를 찍었었거든요."
    } ]
  }, {
    "tStartMs": 781080,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "그래서 화장품, 자기 자리로 돌아가지 않았던 화장품."
    } ]
  }, {
    "tStartMs": 786960,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "약간 이런 것들."
    } ]
  }, {
    "tStartMs": 789320,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "화장품은 화장품만 따로 모아두는 공간이 있는 거죠?"
    } ]
  }, {
    "tStartMs": 793119,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "있어요, 있어요."
    } ]
  }, {
    "tStartMs": 795919,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "돌아가지 못했어요, 여기."
    } ]
  }, {
    "tStartMs": 798960,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "정리를."
    } ]
  }, {
    "tStartMs": 799880,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "대신에 저는 청소기는 매일 돌려요."
    } ]
  }, {
    "tStartMs": 802960,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "매일 돌려요?"
    } ]
  }, {
    "tStartMs": 804080,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "저는 약간 반대니까 정리는 괜찮은데 더러운 거는 싫어요."
    } ]
  }, {
    "tStartMs": 808960,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "그렇구나."
    } ]
  }, {
    "tStartMs": 809600,
    "dDurationMs": 6239,
    "segs": [ {
      "utf8": "먼지가 쌓여있고 화장실 청소 안 되어있고 그런 거."
    } ]
  }, {
    "tStartMs": 815839,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "뭔가 위생적으로 더러울 것 같은 거."
    } ]
  }, {
    "tStartMs": 818919,
    "dDurationMs": 3321,
    "segs": [ {
      "utf8": "오, 진짜 똑 반대네요."
    } ]
  }, {
    "tStartMs": 822240,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "똑 반대예요."
    } ]
  }, {
    "tStartMs": 825600,
    "dDurationMs": 8280,
    "segs": [ {
      "utf8": "그리고 청소하면 저는 저희 집 본가 청소 방식을 좀 다른 분들이랑 공유하고 싶은데"
    } ]
  }, {
    "tStartMs": 833880,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "다른 분들도 이렇게 하는지 공유를 해보고 싶은데"
    } ]
  }, {
    "tStartMs": 837440,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "저희 본가는 일단 일주일에 한 번 대청소를 해요."
    } ]
  }, {
    "tStartMs": 842240,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "완전 청소기 하고 밀대 닦고"
    } ]
  }, {
    "tStartMs": 846600,
    "dDurationMs": 5599,
    "segs": [ {
      "utf8": "거기 위에 있는 먼지 같은 것도 다 걸레로 닦고 손걸레로 닦고"
    } ]
  }, {
    "tStartMs": 852199,
    "dDurationMs": 4801,
    "segs": [ {
      "utf8": "이런 걸 일주일에 한 번씩 해서"
    } ]
  }, {
    "tStartMs": 857000,
    "dDurationMs": 4279,
    "segs": [ {
      "utf8": "그래서 청소기는 계속 돌리게 되는 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 861279,
    "dDurationMs": 4441,
    "segs": [ {
      "utf8": "근데 다들 청소라고 하면 여기 이 정도까지 하는지 궁금해요."
    } ]
  }, {
    "tStartMs": 865720,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "청소기에 물걸레질하고 화장실 청소하고 이런 거 다."
    } ]
  }, {
    "tStartMs": 872320,
    "dDurationMs": 4919,
    "segs": [ {
      "utf8": "일단 먼저 아주 훌륭한 가정교육 방법이네요."
    } ]
  }, {
    "tStartMs": 877239,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "아주 좋네."
    } ]
  }, {
    "tStartMs": 878679,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "집이 깨끗해요."
    } ]
  }, {
    "tStartMs": 882320,
    "dDurationMs": 9079,
    "segs": [ {
      "utf8": "저희 집은 그냥 바닥 정도만 싹 청소하는 것 같아요."
    } ]
  }, {
    "tStartMs": 891399,
    "dDurationMs": 6481,
    "segs": [ {
      "utf8": "청소기도 돌리고 그렇게 할 때는 바닥을 닦기도 하고"
    } ]
  }, {
    "tStartMs": 897880,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "무선 청소기 써요?"
    } ]
  }, {
    "tStartMs": 899839,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 902279,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "무선 청소기 제가 샀어요. 제가 답답해서."
    } ]
  }, {
    "tStartMs": 906799,
    "dDurationMs": 5241,
    "segs": [ {
      "utf8": "근데 그거 괜찮아요? 세기가 부족하지 않아요?"
    } ]
  }, {
    "tStartMs": 912040,
    "dDurationMs": 1359,
    "segs": [ {
      "utf8": "요새 잘 나와요."
    } ]
  }, {
    "tStartMs": 913399,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "잘 나와요? 어디 거 쓰세요?"
    } ]
  }, {
    "tStartMs": 916920,
    "dDurationMs": 2439,
    "segs": [ {
      "utf8": "저 막 대기업 제품은 아니라서"
    } ]
  }, {
    "tStartMs": 919359,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 920399,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "무슨 카카오 메이커스?"
    } ]
  }, {
    "tStartMs": 922359,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "에? 그랬구나."
    } ]
  }, {
    "tStartMs": 924239,
    "dDurationMs": 6681,
    "segs": [ {
      "utf8": "네. 그런 데서 만든 거 쓰는데 생각보다 좋아요."
    } ]
  }, {
    "tStartMs": 930920,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "진짜요? 배터리 하나로 청소 다 돼요?"
    } ]
  }, {
    "tStartMs": 934799,
    "dDurationMs": 841,
    "segs": [ {
      "utf8": "그런 것 같아요."
    } ]
  }, {
    "tStartMs": 935640,
    "dDurationMs": 3199,
    "segs": [ {
      "utf8": "오 좋다."
    } ]
  }, {
    "tStartMs": 938839,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그거 써봤어요? 로봇 청소기?"
    } ]
  }, {
    "tStartMs": 941399,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "그거는 안 써봤어요."
    } ]
  }, {
    "tStartMs": 944600,
    "dDurationMs": 4799,
    "segs": [ {
      "utf8": "그거 한때 되게 붐이었잖아요. 처음 나오고 이랬을 때."
    } ]
  }, {
    "tStartMs": 949399,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "저희 엄마도 그때 사서 돌렸는데"
    } ]
  }, {
    "tStartMs": 953959,
    "dDurationMs": 4681,
    "segs": [ {
      "utf8": "근데 걔는 매일은 될 수가 없더라고요. 써보니까."
    } ]
  }, {
    "tStartMs": 958640,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "오 왜요?"
    } ]
  }, {
    "tStartMs": 960000,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "구석구석 안 되고"
    } ]
  }, {
    "tStartMs": 964200,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "그래서 뭐 청소 일주일에 한 번 하지만"
    } ]
  }, {
    "tStartMs": 968079,
    "dDurationMs": 5361,
    "segs": [ {
      "utf8": "그래도 매일매일 먼지 같은 거 돌아다니면서 빨아들일 수 있도록"
    } ]
  }, {
    "tStartMs": 973440,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "그렇게 그냥 썼어요."
    } ]
  }, {
    "tStartMs": 977880,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "걔가 완전 요즘은 또 다를지도 모르는데 좀 바보예요."
    } ]
  }, {
    "tStartMs": 984320,
    "dDurationMs": 4519,
    "segs": [ {
      "utf8": "약간 가다가 길 잃고 아니면 뭐지?"
    } ]
  }, {
    "tStartMs": 988839,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "바닥에 아무것도 없어야 되거든요."
    } ]
  }, {
    "tStartMs": 990959,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "오 맞죠."
    } ]
  }, {
    "tStartMs": 991760,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "의자 같은 것도 다 올려놔야 되고"
    } ]
  }, {
    "tStartMs": 995559,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "그래서 아직은 아쉽더라고요. 로봇 청소기가."
    } ]
  }, {
    "tStartMs": 1000079,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "그러니까."
    } ]
  }, {
    "tStartMs": 1001880,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "그러니까 로봇 청소기를 쓰려면"
    } ]
  }, {
    "tStartMs": 1005040,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "로봇 청소기가 일할 수 있는 환경을 제가 만들어줘야 되는 거잖아요."
    } ]
  }, {
    "tStartMs": 1008720,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "만들어줘야 돼요. 어차피 정리 다 해야 돼요."
    } ]
  }, {
    "tStartMs": 1011320,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1013519,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "제가 로봇 청소기에 보조가 되는 거네요."
    } ]
  }, {
    "tStartMs": 1016959,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "맞아요. 일을 줄여주는 건지."
    } ]
  }, {
    "tStartMs": 1021399,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "아 그렇네."
    } ]
  }, {
    "tStartMs": 1024679,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "로봇 청소기."
    } ]
  }, {
    "tStartMs": 1025399,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "아 근데 제가 올해 독립을 할 계획이 있는데"
    } ]
  }, {
    "tStartMs": 1033720,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "독립을 하면 혼자서 살려고 하는데"
    } ]
  }, {
    "tStartMs": 1038640,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "이사를 가고 싶은 집도 있는데"
    } ]
  }, {
    "tStartMs": 1043160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그 집이 아직 빈집이 안 나와서"
    } ]
  }, {
    "tStartMs": 1045720,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "아 보고 있는 집이 있어요?"
    } ]
  }, {
    "tStartMs": 1047559,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "네네 있는데 만약에 그 집이 잘 나와서"
    } ]
  }, {
    "tStartMs": 1052959,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "이사를 가게 된다면"
    } ]
  }, {
    "tStartMs": 1054760,
    "dDurationMs": 4919,
    "segs": [ {
      "utf8": "로봇 청소기를 쓸 생각이 있어요 저는."
    } ]
  }, {
    "tStartMs": 1059679,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "근데 사실 저도 살 것 같긴 해요."
    } ]
  }, {
    "tStartMs": 1061679,
    "dDurationMs": 961,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 1062839,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "근데 집이 커요?"
    } ]
  }, {
    "tStartMs": 1064600,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "혼자 살기에는 작지 않아요."
    } ]
  }, {
    "tStartMs": 1067880,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "방이 있어요? 원룸이 아니에요?"
    } ]
  }, {
    "tStartMs": 1070399,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "원룸이 아니에요."
    } ]
  }, {
    "tStartMs": 1071399,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "아 그러면 좋을 것 같습니다."
    } ]
  }, {
    "tStartMs": 1073880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "그렇죠."
    } ]
  }, {
    "tStartMs": 1075920,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "그리고 제가 극한의 미니멀리스트라서"
    } ]
  }, {
    "tStartMs": 1081640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "미니멀리스트에요?"
    } ]
  }, {
    "tStartMs": 1083640,
    "dDurationMs": 919,
    "segs": [ {
      "utf8": "그런 것 같아요."
    } ]
  }, {
    "tStartMs": 1084559,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "그러면 물건이 많이 없는 편이네요."
    } ]
  }, {
    "tStartMs": 1087000,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "그렇죠."
    } ]
  }, {
    "tStartMs": 1088839,
    "dDurationMs": 4361,
    "segs": [ {
      "utf8": "그래서 저는 나중에 살 집을 상상하면"
    } ]
  }, {
    "tStartMs": 1093200,
    "dDurationMs": 3359,
    "segs": [ {
      "utf8": "집에 뭐가 많이 없는"
    } ]
  }, {
    "tStartMs": 1096559,
    "dDurationMs": 4761,
    "segs": [ {
      "utf8": "로봇 청소기가 뛰어놀기 참 좋은 환경이겠네요."
    } ]
  }, {
    "tStartMs": 1101320,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "네네."
    } ]
  }, {
    "tStartMs": 1104279,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "그래서 그런 집이라면 로봇 청소기도 괜찮지 않을까?"
    } ]
  }, {
    "tStartMs": 1107839,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "이런 생각이 들더라고요."
    } ]
  }, {
    "tStartMs": 1110239,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "만약에 로봇 청소기 사면 청소 안 할 거예요?"
    } ]
  }, {
    "tStartMs": 1115039,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "할 수밖에 없지 않을까요?"
    } ]
  }, {
    "tStartMs": 1118239,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "두 개 있어야 돼요."
    } ]
  }, {
    "tStartMs": 1120080,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "로봇 청소기도 사고 무선도 있어야 돼요."
    } ]
  }, {
    "tStartMs": 1123760,
    "dDurationMs": 2719,
    "segs": [ {
      "utf8": "그러니까 참 그래서"
    } ]
  }, {
    "tStartMs": 1126479,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "계륵이라는 말이 있잖아요."
    } ]
  }, {
    "tStartMs": 1128760,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "계륵 어떤 뜻이죠?"
    } ]
  }, {
    "tStartMs": 1130719,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "계륵."
    } ]
  }, {
    "tStartMs": 1131559,
    "dDurationMs": 721,
    "segs": [ {
      "utf8": "닭의"
    } ]
  }, {
    "tStartMs": 1132280,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "닭의 갈비살"
    } ]
  }, {
    "tStartMs": 1135239,
    "dDurationMs": 4401,
    "segs": [ {
      "utf8": "그러니까 먹기에는 양이 많지도 않고"
    } ]
  }, {
    "tStartMs": 1139640,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "안 먹기에는 아깝고"
    } ]
  }, {
    "tStartMs": 1142840,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "있어도 좀 그렇고 없어도 좀 그런"
    } ]
  }, {
    "tStartMs": 1145039,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그래도 있으면 편해."
    } ]
  }, {
    "tStartMs": 1146799,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "그러니까요."
    } ]
  }, {
    "tStartMs": 1149280,
    "dDurationMs": 4439,
    "segs": [ {
      "utf8": "살 수 있으면 사면 좋을 것 같아요."
    } ]
  }, {
    "tStartMs": 1153719,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "자취 계획이 있으시군요."
    } ]
  }, {
    "tStartMs": 1155799,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "독립"
    } ]
  }, {
    "tStartMs": 1157080,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "아 네 저는 좀 그렇게 해야"
    } ]
  }, {
    "tStartMs": 1161400,
    "dDurationMs": 4399,
    "segs": [ {
      "utf8": "오프라인 인터뷰 속도 좀"
    } ]
  }, {
    "tStartMs": 1165799,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "제가 원하는 환경에서 할 수 있을 것 같아서"
    } ]
  }, {
    "tStartMs": 1168679,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "너무 좋아요."
    } ]
  }, {
    "tStartMs": 1169960,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1172679,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "빨리 집이 나왔으면 좋겠네요."
    } ]
  }, {
    "tStartMs": 1175280,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1176200,
    "dDurationMs": 3519,
    "segs": [ {
      "utf8": "그러면 화장실 청소 같은 건 안 해요?"
    } ]
  }, {
    "tStartMs": 1179719,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "지금은?"
    } ]
  }, {
    "tStartMs": 1180599,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "지금은 안 해요."
    } ]
  }, {
    "tStartMs": 1181640,
    "dDurationMs": 1279,
    "segs": [ {
      "utf8": "아"
    } ]
  }, {
    "tStartMs": 1182919,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1183960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "아 근데 뭐 혼자 살 때는"
    } ]
  }, {
    "tStartMs": 1186760,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "자주 했어요."
    } ]
  }, {
    "tStartMs": 1188359,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "얼마나 자주 했어요?"
    } ]
  }, {
    "tStartMs": 1190200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "일주일에 두 번?"
    } ]
  }, {
    "tStartMs": 1191400,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "헤에에에에"
    } ]
  }, {
    "tStartMs": 1192559,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "완전 깔끔하다."
    } ]
  }, {
    "tStartMs": 1194559,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "어 네."
    } ]
  }, {
    "tStartMs": 1196039,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "깔끔한 편이시네요."
    } ]
  }, {
    "tStartMs": 1198239,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아 그러게요."
    } ]
  }, {
    "tStartMs": 1199239,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "왜 왜 이렇게 자주 해요?"
    } ]
  }, {
    "tStartMs": 1201000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "문제가 쉽게 더러워지는 화장실이었어요."
    } ]
  }, {
    "tStartMs": 1206000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "왜인지 모르겠는데"
    } ]
  }, {
    "tStartMs": 1209000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그런 화장실이?"
    } ]
  }, {
    "tStartMs": 1211000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네. 이상하게 바닥에 때가 잘 지고"
    } ]
  }, {
    "tStartMs": 1214000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "아 뭔가 환기가 잘 안되는 화장실이었나봐요."
    } ]
  }, {
    "tStartMs": 1218000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "네 그런가봐요."
    } ]
  }, {
    "tStartMs": 1220000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "그리고 보통 화장실에서 샤워도 하잖아요."
    } ]
  }, {
    "tStartMs": 1227000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1228000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "근데 그때는 샤워를 마치고 그 화장실 안에서 머리도 말렸는데"
    } ]
  }, {
    "tStartMs": 1234000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그러다보니까 머리카락이 많이 떨어져서"
    } ]
  }, {
    "tStartMs": 1238000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "너무 쉽게 지저분해지더라구요."
    } ]
  }, {
    "tStartMs": 1241000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 지금은 어때요?"
    } ]
  }, {
    "tStartMs": 1244000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "드라이기 할 때 화장실에서 해요? 아니면 방에서 하세요?"
    } ]
  }, {
    "tStartMs": 1248000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "이제 방에서 해요."
    } ]
  }, {
    "tStartMs": 1251000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "그래서 이제는 방을 자주 치우는 편이죠."
    } ]
  }, {
    "tStartMs": 1260000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "음 그렇구나."
    } ]
  }, {
    "tStartMs": 1263000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "한국은 마룻바닥 생활을 하잖아요."
    } ]
  }, {
    "tStartMs": 1268000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그래서 이렇게 청소기도 하고 걸레질도 하고 그러는 것 같은데"
    } ]
  }, {
    "tStartMs": 1274000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "저는 그 신발 신고 활동하는 나라? 방에서도?"
    } ]
  }, {
    "tStartMs": 1278000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "어떻게 청소하는지가 궁금해요."
    } ]
  }, {
    "tStartMs": 1281000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그러게요."
    } ]
  }, {
    "tStartMs": 1282000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그쵸?"
    } ]
  }, {
    "tStartMs": 1284000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "안하나?"
    } ]
  }, {
    "tStartMs": 1286000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "청소기만 하나?"
    } ]
  }, {
    "tStartMs": 1288000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "청소기? 왠지 청소기만 할 것 같아요."
    } ]
  }, {
    "tStartMs": 1292000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그리고 러그 같은 거 그런 것도"
    } ]
  }, {
    "tStartMs": 1297000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그거 자주 빨기는 또 엄청 귀찮잖아요."
    } ]
  }, {
    "tStartMs": 1300000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "어 힘들죠."
    } ]
  }, {
    "tStartMs": 1301000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "러그 사용해요?"
    } ]
  }, {
    "tStartMs": 1303000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "저는 안사용해요."
    } ]
  }, {
    "tStartMs": 1304000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아 진짜요?"
    } ]
  }, {
    "tStartMs": 1305000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "미래의 집에도 안 놓을 거예요?"
    } ]
  }, {
    "tStartMs": 1308000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아...둘 것 같아요."
    } ]
  }, {
    "tStartMs": 1311000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "저는 솔직히 러그 빨아본 적 없고"
    } ]
  }, {
    "tStartMs": 1315000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그냥 버려요. 한 1년? 2년 쓰고."
    } ]
  }, {
    "tStartMs": 1320000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아 그렇구나."
    } ]
  }, {
    "tStartMs": 1322000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "애초에 그렇게 좋은 러그를 사질 않아가지고."
    } ]
  }, {
    "tStartMs": 1325000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "네. 저도 러그 큰 거 사려고요."
    } ]
  }, {
    "tStartMs": 1331000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네. 거대한 호랑이가 그려져 있는."
    } ]
  }, {
    "tStartMs": 1334000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "진짜요?"
    } ]
  }, {
    "tStartMs": 1335000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1336000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "약간 그런 감성 좋아해요?"
    } ]
  }, {
    "tStartMs": 1337000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "태용쌤 뒤에 배경 보면 약간 한국적인 그런 거 있거든요?"
    } ]
  }, {
    "tStartMs": 1343000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그런 거 좋아하세요?"
    } ]
  }, {
    "tStartMs": 1344000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "좋아해요. 되게."
    } ]
  }, {
    "tStartMs": 1346000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아 진짜요?"
    } ]
  }, {
    "tStartMs": 1347000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1348000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "저는 팟캐스트 시작하고 약간 관심이 있어졌어요. 그런 거."
    } ]
  }, {
    "tStartMs": 1353000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "약간 아이덴티티를 보여주고 싶은 느낌?"
    } ]
  }, {
    "tStartMs": 1357000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "한국에 대해 이야기하는 사람입니다. 같은."
    } ]
  }, {
    "tStartMs": 1360000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "음. 좋죠."
    } ]
  }, {
    "tStartMs": 1362000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "저도 약간 그런 느낌으로 뒤에 그런 것들을 둔 것도 있어요."
    } ]
  }, {
    "tStartMs": 1368000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "지금 뒤에 뭐가 보이냐면 태권도 까만띠."
    } ]
  }, {
    "tStartMs": 1372000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네네."
    } ]
  }, {
    "tStartMs": 1373000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그거랑 곤룡포? 저거 왕들이 입는 거 맞죠?"
    } ]
  }, {
    "tStartMs": 1376000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네네."
    } ]
  }, {
    "tStartMs": 1377000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그거랑 저건 단청이라고 하나요?"
    } ]
  }, {
    "tStartMs": 1380000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "맞아요. 맞아요. 단청."
    } ]
  }, {
    "tStartMs": 1382000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "한국 전통 집에 보면 알록달록한 문양? 그런 게 보여요."
    } ]
  }, {
    "tStartMs": 1386000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1387000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "어디서 구한 거예요? 단청."
    } ]
  }, {
    "tStartMs": 1390000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "일단 저거는 저게 사실 스포츠 타올이거든요?"
    } ]
  }, {
    "tStartMs": 1395000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "어? 네."
    } ]
  }, {
    "tStartMs": 1396000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "스포츠 수건?"
    } ]
  }, {
    "tStartMs": 1397000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1398000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "근데 저런 디자인으로 팔더라고요."
    } ]
  }, {
    "tStartMs": 1402000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1403000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "저거를 제가 옛날에 한 6개월 정도 넘게 배낭여행을 간 적이 있었는데"
    } ]
  }, {
    "tStartMs": 1411000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그때 짐을 최대한 줄이려고 얇은 수건을 찾아보다가"
    } ]
  }, {
    "tStartMs": 1416000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그 스포츠 수건을 막 검색하다가 저걸 찾았어요."
    } ]
  }, {
    "tStartMs": 1420000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1421000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그래서 저거는 왠지 나 한국인이다 이러면서 여행 다닐 때도 좀 좋겠는데"
    } ]
  }, {
    "tStartMs": 1426000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "이런 생각을 가지고 샀던 건데"
    } ]
  }, {
    "tStartMs": 1429000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아."
    } ]
  }, {
    "tStartMs": 1430000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "뭐 그런 의도로 그런 목적으로 사용하지는 한 번도 못했고"
    } ]
  }, {
    "tStartMs": 1434000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네. 아무튼 수건이에요 저거."
    } ]
  }, {
    "tStartMs": 1437000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "디스플레이를 잘해놓으셨네요."
    } ]
  }, {
    "tStartMs": 1439000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "캔버스? 액자처럼 해놨어요."
    } ]
  }, {
    "tStartMs": 1441000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 그래요? 근데 저거는 원래 없었어요."
    } ]
  }, {
    "tStartMs": 1444000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그러니까요. 새로워요."
    } ]
  }, {
    "tStartMs": 1446000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아 그렇구나."
    } ]
  }, {
    "tStartMs": 1448000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "저거 최근에 건반 사가지고"
    } ]
  }, {
    "tStartMs": 1453000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아 네."
    } ]
  }, {
    "tStartMs": 1454000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 피아노다 피아노."
    } ]
  }, {
    "tStartMs": 1457000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "네네 건반 덮어두는 용도로 쓰고 있어요."
    } ]
  }, {
    "tStartMs": 1461000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "클레벌."
    } ]
  }, {
    "tStartMs": 1462000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1463000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "괜찮은데요?"
    } ]
  }, {
    "tStartMs": 1464000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그리고 저 골룡포는요?"
    } ]
  }, {
    "tStartMs": 1466000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그리고 저거는"
    } ]
  }, {
    "tStartMs": 1467000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "왕곳."
    } ]
  }, {
    "tStartMs": 1468000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아니 진짜 골룡포 옷은 아니고"
    } ]
  }, {
    "tStartMs": 1471000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "작년이 작년 외에 우리 해마다 동물이 있잖아요."
    } ]
  }, {
    "tStartMs": 1477000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1478000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "올해는 푸른 뱀의 해잖아요."
    } ]
  }, {
    "tStartMs": 1480000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "뱀이죠. 네."
    } ]
  }, {
    "tStartMs": 1481000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네. 작년은"
    } ]
  }, {
    "tStartMs": 1482000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "청사."
    } ]
  }, {
    "tStartMs": 1483000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "작년은 푸른 용의 해였을 거거든요."
    } ]
  }, {
    "tStartMs": 1485000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "맞아요. 맞아요. 청룡이었어요."
    } ]
  }, {
    "tStartMs": 1487000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "근데 제가 항상 책을 사는 사이트가 있는데"
    } ]
  }, {
    "tStartMs": 1494000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "알라딘이라는 한국의 온라인 서점이거든요."
    } ]
  }, {
    "tStartMs": 1498000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "있죠."
    } ]
  }, {
    "tStartMs": 1499000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "근데 그 서점이 예쁜 굿즈를 잘 만들어 팔기로 유명해요."
    } ]
  }, {
    "tStartMs": 1505000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "오 몰랐어요. 알라딘이?"
    } ]
  }, {
    "tStartMs": 1508000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네. 알라딘이 굿즈 예쁜 거 진짜 잘 만들어요."
    } ]
  }, {
    "tStartMs": 1511000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1512000,
    "dDurationMs": 10000,
    "segs": [ {
      "utf8": "근데 작년 초에 올해는 푸른 용의 해니까"
    } ]
  }, {
    "tStartMs": 1522000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "푸른 해랑 관련된 굿즈를 만들어서"
    } ]
  }, {
    "tStartMs": 1527000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "도서 5만원 이상 구매시 마일리지로 구매 가능이었는데"
    } ]
  }, {
    "tStartMs": 1534000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "근데 저게 담요거든요."
    } ]
  }, {
    "tStartMs": 1539000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "담요인데 저 골룡포 저 용 문양이 있는 푸른 담요예요."
    } ]
  }, {
    "tStartMs": 1546000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그래서 잘 개서 저기다 걸어놓은 거죠."
    } ]
  }, {
    "tStartMs": 1549000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "예쁘다."
    } ]
  }, {
    "tStartMs": 1550000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1551000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "예쁘다."
    } ]
  }, {
    "tStartMs": 1552000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "사실 저런 느낌의 물건을 많은 곳에서 팔지는 않잖아요."
    } ]
  }, {
    "tStartMs": 1561000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "많이는 없어요."
    } ]
  }, {
    "tStartMs": 1562000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네. 쉽게 구할 수 없으니까."
    } ]
  }, {
    "tStartMs": 1565000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "그래서 저런 굿즈로라도 보이면 저는 어떻게든 구하고 싶어요."
    } ]
  }, {
    "tStartMs": 1572000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그렇구나."
    } ]
  }, {
    "tStartMs": 1574000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "이거 듣는 분들도 예쁜 굿즈 사고 싶으면 알라딘 한번 확인해보면 좋겠네요."
    } ]
  }, {
    "tStartMs": 1581000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "좋습니다. 알라딘 굿즈 저 되게 많아요."
    } ]
  }, {
    "tStartMs": 1587000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "태용쌤 나중에 굿즈 소개 같은 거 해주세요."
    } ]
  }, {
    "tStartMs": 1590000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "뭔가 메모패드 이런 것도 스테이셔널이 있어요."
    } ]
  }, {
    "tStartMs": 1596000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그거 궁금해요."
    } ]
  }, {
    "tStartMs": 1598000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "좋습니다."
    } ]
  }, {
    "tStartMs": 1600000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "이야기가 거기로 갔는데"
    } ]
  }, {
    "tStartMs": 1602000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "청소하면 또 뭐가 있을까?"
    } ]
  }, {
    "tStartMs": 1604000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "청소?"
    } ]
  }, {
    "tStartMs": 1605000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그런 거 해본 적 있어요."
    } ]
  }, {
    "tStartMs": 1607000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "이사할 때 입주 청소 같은 거."
    } ]
  }, {
    "tStartMs": 1610000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그게 뭐예요?"
    } ]
  }, {
    "tStartMs": 1612000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "이사할 때 새 집으로 가잖아요."
    } ]
  }, {
    "tStartMs": 1616000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그런데 그 집을 괜찮으면 자기가 직접 다 청소를 해도 되는데"
    } ]
  }, {
    "tStartMs": 1622000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "그런데 에어컨 같은 거나 세탁기 이런 거는 오래 사용한 집에 가면 엄청 더럽단 말이죠."
    } ]
  }, {
    "tStartMs": 1631000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "눈에 보이지 않는 그런 곳까지 살균 소독 다 해주는 그런 시스템이 있더라고요."
    } ]
  }, {
    "tStartMs": 1638000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "저는 해본 적은 없어요."
    } ]
  }, {
    "tStartMs": 1640000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 1641000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1642000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "얘기 들어보면 되게 좋을 것 같은데요."
    } ]
  }, {
    "tStartMs": 1644000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "되게 편할 것 같긴 한데"
    } ]
  }, {
    "tStartMs": 1646000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그런데 또 사람 마음이"
    } ]
  }, {
    "tStartMs": 1648000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그런데 내가 못하는 일은 아니잖아요."
    } ]
  }, {
    "tStartMs": 1651000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그런가? 에어컨 필터 청소 이런 거 할 수 있어요?"
    } ]
  }, {
    "tStartMs": 1655000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그냥 쓰자 이렇게 돼서"
    } ]
  }, {
    "tStartMs": 1658000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "에어컨"
    } ]
  }, {
    "tStartMs": 1663000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "고민될 것 같긴 하네요."
    } ]
  }, {
    "tStartMs": 1665000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "생각보다 많이는 안 비쌌어요."
    } ]
  }, {
    "tStartMs": 1668000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "얼마나 비쌌어요?"
    } ]
  }, {
    "tStartMs": 1670000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "원룸이 한 10만 원?"
    } ]
  }, {
    "tStartMs": 1673000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "괜찮은데요?"
    } ]
  }, {
    "tStartMs": 1675000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그건 말 그대로 한 번만 하는 거니까"
    } ]
  }, {
    "tStartMs": 1678000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "그런데 에어컨 세탁기 이런 디테일한 청소는 아마 추가금이 더 붙을 거예요."
    } ]
  }, {
    "tStartMs": 1685000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "살균 소독해주고 묵은 때 같은 거 이런 거 지워주는 게 10만 원?"
    } ]
  }, {
    "tStartMs": 1694000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "저는 사실 살균 소독은 안 해도 될 것 같아요."
    } ]
  }, {
    "tStartMs": 1702000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "살균 소독까지는 필요 없을 것 같고"
    } ]
  }, {
    "tStartMs": 1705000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그런데 에어컨이나 세탁기 같은 건"
    } ]
  }, {
    "tStartMs": 1709000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "한 번 새 것처럼 깨끗하게 하면"
    } ]
  }, {
    "tStartMs": 1712000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "맞아요."
    } ]
  }, {
    "tStartMs": 1713000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "성능에도 차이가 나잖아요."
    } ]
  }, {
    "tStartMs": 1715000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그렇죠."
    } ]
  }, {
    "tStartMs": 1716000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그래서 솔깃한데요?"
    } ]
  }, {
    "tStartMs": 1718000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "이사가는 집 컨디션에 따라서"
    } ]
  }, {
    "tStartMs": 1721000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "너무 안 좋으면 그런 거 이용해도 괜찮을 것 같아요."
    } ]
  }, {
    "tStartMs": 1725000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "너무 좋을 것 같아요."
    } ]
  }, {
    "tStartMs": 1726000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "입주 청소"
    } ]
  }, {
    "tStartMs": 1728000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "청소하니까 생각난 건데"
    } ]
  }, {
    "tStartMs": 1731000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "태용쌤은 바퀴벌레 잡을 수 있어요?"
    } ]
  }, {
    "tStartMs": 1734000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "너무 싫어요."
    } ]
  }, {
    "tStartMs": 1737000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "저 세상에서 제일 싫어하는 거 중에 하나가 바퀴벌레거든요."
    } ]
  }, {
    "tStartMs": 1742000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "저도요."
    } ]
  }, {
    "tStartMs": 1743000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "본 적 있어요? 집에서?"
    } ]
  }, {
    "tStartMs": 1745000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "많이 봤죠."
    } ]
  }, {
    "tStartMs": 1746000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "집에서?"
    } ]
  }, {
    "tStartMs": 1747000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네. 저희 집이 1층이라서"
    } ]
  }, {
    "tStartMs": 1753000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그게"
    } ]
  }, {
    "tStartMs": 1755000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "얘기하기도 싫다."
    } ]
  }, {
    "tStartMs": 1758000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1759000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "그게 보통 사람들이 사는 집에서 서식하는 바퀴벌레랑"
    } ]
  }, {
    "tStartMs": 1766000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그리고 집 밖에 있는 야외에 있는 바퀴벌레랑"
    } ]
  }, {
    "tStartMs": 1771000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "좀 다르게 생겼어요."
    } ]
  }, {
    "tStartMs": 1775000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그런데"
    } ]
  }, {
    "tStartMs": 1777000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그래서 집에 있는 바퀴벌레는"
    } ]
  }, {
    "tStartMs": 1780000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "좀 붉은 빛을 띄고"
    } ]
  }, {
    "tStartMs": 1782000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "오마이갓"
    } ]
  }, {
    "tStartMs": 1783000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그리고 그렇게 크진 않아요."
    } ]
  }, {
    "tStartMs": 1786000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "오, 그래요?"
    } ]
  }, {
    "tStartMs": 1788000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "집 바퀴는?"
    } ]
  }, {
    "tStartMs": 1790000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네. 집 바퀴는."
    } ]
  }, {
    "tStartMs": 1791000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "상대적으로 작구나."
    } ]
  }, {
    "tStartMs": 1793000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "상대적으로 작아요."
    } ]
  }, {
    "tStartMs": 1795000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "물론 다 커지면"
    } ]
  }, {
    "tStartMs": 1798000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네."
    } ]
  }, {
    "tStartMs": 1800000,
    "dDurationMs": 13000,
    "segs": [ {
      "utf8": "사이즈가 크겠지만 문제는 밖에 사는 바퀴벌레가 집에 가끔씩 들어오는 경우가 있었는데"
    } ]
  }, {
    "tStartMs": 1813000,
    "dDurationMs": 10840,
    "segs": [ {
      "utf8": "근데 밖에 사는 바퀴벌레는 일단 색깔이 새까맣고 그리고 크기가 기본적으로 한 엄지손가락 많아요"
    } ]
  }, {
    "tStartMs": 1823840,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "진짜요? 그리고 최악의 경우에는 왜? 날아요"
    } ]
  }, {
    "tStartMs": 1833000,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "그놈이 나는군요 막 진짜"
    } ]
  }, {
    "tStartMs": 1838919,
    "dDurationMs": 4601,
    "segs": [ {
      "utf8": "이런 소리를 내면서 어떤 소리?"
    } ]
  }, {
    "tStartMs": 1843520,
    "dDurationMs": 7680,
    "segs": [ {
      "utf8": "이런 소리를 내면서 벌이에요? 네. 막 이러면서 날거든요"
    } ]
  }, {
    "tStartMs": 1851200,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "진짜 공포영화다. 진짜 공포스럽습니다. 진짜 무서워요"
    } ]
  }, {
    "tStartMs": 1859240,
    "dDurationMs": 7480,
    "segs": [ {
      "utf8": "아 그게 딱 구분이 되겠다 그러면. 네. 그 대처 방법도 다를 거 아니에요?"
    } ]
  }, {
    "tStartMs": 1866720,
    "dDurationMs": 9080,
    "segs": [ {
      "utf8": "대처 방법은 사실 똑같죠. 약간 그거 있잖아요. 집에서 바퀴벌레가 한번 나오면 걔는 집에서 막 사는 거다"
    } ]
  }, {
    "tStartMs": 1875800,
    "dDurationMs": 12320,
    "segs": [ {
      "utf8": "지금 이미 한 100마리 살고 있다. 해서 세스코라고 그 바퀴벌레 박멸해주는 다 집에 있는 바퀴벌레 다 잡아주는 그 서비스 신청해야 된다 이런 얘기 있는데"
    } ]
  }, {
    "tStartMs": 1888120,
    "dDurationMs": 6439,
    "segs": [ {
      "utf8": "네. 밖에서 날아온 거면은 그냥 잡아서 버리면 되잖아요. 어 맞아요"
    } ]
  }, {
    "tStartMs": 1896199,
    "dDurationMs": 8320,
    "segs": [ {
      "utf8": "1층은 그게 안 좋구나. 그렇습니다. 진짜 자주 봐요? 그렇게 자주는 아니고"
    } ]
  }, {
    "tStartMs": 1905519,
    "dDurationMs": 9201,
    "segs": [ {
      "utf8": "한 1년에 한 4번? 4번은 좀 그런가? 3번?"
    } ]
  }, {
    "tStartMs": 1914720,
    "dDurationMs": 9640,
    "segs": [ {
      "utf8": "진짜? 네. 좀 못 살 거 같아요. 1층. 그러니까요. 전 딱 한 번 나왔어요. 자취방에서"
    } ]
  }, {
    "tStartMs": 1924440,
    "dDurationMs": 14479,
    "segs": [ {
      "utf8": "아 그래요? 네. 붉은 빛을 띄었나요? 아 모르겠어요. 근데 진짜 새 집이었거든요. 완전 신도시의 새 집이었는데"
    } ]
  }, {
    "tStartMs": 1938919,
    "dDurationMs": 9920,
    "segs": [ {
      "utf8": "아마 제가 시킨 커튼에 붙어온 거 같아요. 그 택배 박스. 그렇게 많이 들어온대요. 그런 거 같아요"
    } ]
  }, {
    "tStartMs": 1948839,
    "dDurationMs": 12000,
    "segs": [ {
      "utf8": "근데 제가 자취를 시작한 지 일주일 차에 바퀴벌레가 딱 들어온 거예요. 걔를 발견한 거에요. 커튼 달다가 커튼에 딱 붙어있는 거에요. 걔가"
    } ]
  }, {
    "tStartMs": 1960839,
    "dDurationMs": 14920,
    "segs": [ {
      "utf8": "그래서 그날 밤에 잠을 못 자고. 아 근데 놓쳤어요. 걔를. 그러니까 자보려고 했는데 갑자기 안 보이는 거. 제 시야에서 벗어났어요. 걔가 안 보이기 시작해서"
    } ]
  }, {
    "tStartMs": 1975880,
    "dDurationMs": 14720,
    "segs": [ {
      "utf8": "그 뒤로 안 보이다가 한 반년 뒤에 제가 그 베란다에 타일을 깔아놨었거든요. 그 타일을 버리려고 타일을 들었는데 그 밑에 죽어 있었어요."
    } ]
  }, {
    "tStartMs": 1990600,
    "dDurationMs": 12480,
    "segs": [ {
      "utf8": "아 그래서 번지지 않았구나. 번지진 않은 거 같아요. 그날 제가 뭔가 약을 뿌리고 해서 죽었는데 그 타일 밑으로 들어가서 죽은 거 같아요. 숨어서."
    } ]
  }, {
    "tStartMs": 2003080,
    "dDurationMs": 10440,
    "segs": [ {
      "utf8": "아 진짜 다행이네요. 진짜 다행이네. 그렇게 딱 초기 진압이 잘 됐네요. 초기 진압. 그게 중요해요."
    } ]
  }, {
    "tStartMs": 2013520,
    "dDurationMs": 11000,
    "segs": [ {
      "utf8": "제가 듣기로 바퀴벌레에 진짜 좋은 게 하나 있대요. 잡는데 좋은 거. 약간 실제 경험담이었는데 한국에 올리브영 가면은 푸츠샴푸라는 걸 팔아요."
    } ]
  }, {
    "tStartMs": 2025360,
    "dDurationMs": 21520,
    "segs": [ {
      "utf8": "푸츠샴푸. 발 샴푸에요. 발 샴푸. 그 파란색으로 생겨가지고 있거든요. 칙칙 뿌리는 거. 그거를 그냥 발 씻기 귀찮을 때 이렇게 대충 뿌리고 발에 샤워기 싹 해서 씻을 수 있는 혁명템인데"
    } ]
  }, {
    "tStartMs": 2046880,
    "dDurationMs": 16199,
    "segs": [ {
      "utf8": "그게 바퀴벌레를 진짜 잘 잡는대요. 아 그래요? 걔를 한번 뿌리면 바퀴벌레가 마비된대요. 우와 대박. 그래서 항상 푸츠샴푸를 욕실에 놔둬야 돼요."
    } ]
  }, {
    "tStartMs": 2063079,
    "dDurationMs": 17600,
    "segs": [ {
      "utf8": "와 진짜 집에 무조건 구비해둬야 되겠네요. 있어야 돼요. 발 씻을 때도 좋고 혹시나 바퀴벌레 나오면 걔가 바퀴벌레가 등으로 숨을 쉰대나 아무튼 그 숨구멍을 거품이 다 막아서 기절한대요. 아 기절해요? 네."
    } ]
  }, {
    "tStartMs": 2080679,
    "dDurationMs": 19321,
    "segs": [ {
      "utf8": "아 그렇구나. 우와. 친구가 그걸로 잡았다고. 푸츠샴푸 알겠습니다. 이거 꼭 필요하네. 그 있어요. 초록색 파란색 통."
    } ]
  }, {
    "tStartMs": 2100000,
    "dDurationMs": 20239,
    "segs": [ {
      "utf8": "근데 이런 해충약 있잖아요. 해충약에 대한 저의 한가지 지론이랄까요? 그런 생각이 하나 있는데 해충약은 무조건 집에 두개를 구비해둬야 됩니다."
    } ]
  }, {
    "tStartMs": 2120239,
    "dDurationMs": 19681,
    "segs": [ {
      "utf8": "두개요? 이유는요? 두개를 구비해놓고 하나만 쓰다가 하나가 다 떨어지면 새걸 써야죠. 그러면 그때 또 하나를 사야 됩니다. 왜요? 왜냐면 해충약 바퀴벌레 약이 하나밖에 없어요."
    } ]
  }, {
    "tStartMs": 2139920,
    "dDurationMs": 14039,
    "segs": [ {
      "utf8": "만약에 근데 바퀴벌레가 나와요. 근데 뿌려서 죽여야 되잖아요. 근데 그 하나가 다 떨어지면 어떡해? 그러니까 항상 여분을 둬야 한다는 말이죠."
    } ]
  }, {
    "tStartMs": 2153959,
    "dDurationMs": 11361,
    "segs": [ {
      "utf8": "아 확실히. 왜냐면 그만큼 급하게 순간적으로 잡아야 되기 때문에. 그러니까요. 항상 대비가 되어있어야 한다."
    } ]
  }, {
    "tStartMs": 2165519,
    "dDurationMs": 8121,
    "segs": [ {
      "utf8": "그렇군요. 항시 구비. 푸츠샴푸도 두개 사두세요. 아 그러려고요. 두개. 네."
    } ]
  }, {
    "tStartMs": 2176959,
    "dDurationMs": 12840,
    "segs": [ {
      "utf8": "아 참. 진짜 그 바퀴벌레랑 관련돼서 진짜 제가 경험했던 끔찍한 경험들이 있거든요. 네. 경험들? 아 뭐 경험. 네."
    } ]
  }, {
    "tStartMs": 2190799,
    "dDurationMs": 13121,
    "segs": [ {
      "utf8": "아 근데 얘기할까요 말까요? 재밌어요? 웃음을 주실 수 있나요? 충격적이긴 할거에요. 충격적이에요? 네."
    } ]
  }, {
    "tStartMs": 2203920,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "아 근데 이건 할만한 이야기 같아요. 청소랑 많은 연관이 있어서. 들려주세요. 들려주세요."
    } ]
  }, {
    "tStartMs": 2209239,
    "dDurationMs": 8681,
    "segs": [ {
      "utf8": "아 언제 있었던 일이냐면 제가 방글라데시에 가서 있었던 일입니다. 방글라데시에서? 네."
    } ]
  }, {
    "tStartMs": 2217920,
    "dDurationMs": 14680,
    "segs": [ {
      "utf8": "제가 방글라데시에 파견이 돼서 한 2개월 정도 호텔에서 지내면서 교육기간을 거치고 교육기간이 끝나고 제 집을 제가 구해서 들어갔거든요."
    } ]
  }, {
    "tStartMs": 2233600,
    "dDurationMs": 12560,
    "segs": [ {
      "utf8": "네. 그래서 그 입주하는 집에 들어간 첫날 저녁이었어요. 그때 집에 별거 없었거든요. 침대밖에 없었고."
    } ]
  }, {
    "tStartMs": 2246160,
    "dDurationMs": 11639,
    "segs": [ {
      "utf8": "네. 그래서 차차 집주인이랑 얘기를 해서 가구를 하나씩 넣어야 했는데 아무튼 바퀴벌레가 나온거에요."
    } ]
  }, {
    "tStartMs": 2257880,
    "dDurationMs": 6880,
    "segs": [ {
      "utf8": "첫날? 네. 첫날 바퀴벌레가 나왔는데 근데 그거는 그럴 수 있다고 생각했어요."
    } ]
  }, {
    "tStartMs": 2264760,
    "dDurationMs": 10759,
    "segs": [ {
      "utf8": "그리고 제가 이미 그걸 각오하고 바퀴벌레 약도 미리 사뒀어요. 네. 2개."
    } ]
  }, {
    "tStartMs": 2275519,
    "dDurationMs": 15081,
    "segs": [ {
      "utf8": "사뒀어서 약을 직 뿌려서 잡았죠. 죽였죠. 그리고 휴지로 잘 해서 변기통에 버렸거든요."
    } ]
  }, {
    "tStartMs": 2290600,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "네. 아무튼 그랬습니다. 그게 저녁이었습니다. 근데 또 제가 사는 집이 좀 넓었어요."
    } ]
  }, {
    "tStartMs": 2300440,
    "dDurationMs": 18679,
    "segs": [ {
      "utf8": "방이 3개가 있고 화장실이 2개가 있는 집이었는데 방이 넓으니까 각 방마다 커텐도 달고 창문 단속도 하고"
    } ]
  }, {
    "tStartMs": 2319119,
    "dDurationMs": 7961,
    "segs": [ {
      "utf8": "그리고 제가 주로 쓰는 침대가 있는 방으로 들어와서 자려고 그래서 집을 막 돌아다녔거든요."
    } ]
  }, {
    "tStartMs": 2327080,
    "dDurationMs": 11039,
    "segs": [ {
      "utf8": "네. 근데 지금 방에서 저쪽 방으로 가는 길에 바퀴벌레가 있길래 또 약을 뿌려서 죽였습니다."
    } ]
  }, {
    "tStartMs": 2338719,
    "dDurationMs": 16400,
    "segs": [ {
      "utf8": "그리고 제가 볼일을 보고 또 다른 방으로 이동하는데 제가 지나온 길을 딱 등을 돌려서 뒤를 봤거든요."
    } ]
  }, {
    "tStartMs": 2355119,
    "dDurationMs": 9161,
    "segs": [ {
      "utf8": "근데 갑자기 없던 바퀴벌레가 튀어나와서 제가 뿌려놓은 약을 맞고 뒤집어서 죽어가고 있는 거예요."
    } ]
  }, {
    "tStartMs": 2365280,
    "dDurationMs": 15319,
    "segs": [ {
      "utf8": "이해가 돼요? 무슨 말인지? 그러니까 생각해보세요. 앞을 걸어가면서 앞에 바퀴벌레가 있길래 약을 뿌리고 그 바퀴벌레를 지나쳤어요."
    } ]
  }, {
    "tStartMs": 2380599,
    "dDurationMs": 14361,
    "segs": [ {
      "utf8": "뿌려놓고? 네. 뿌려놓고 앞으로 지나쳤어요. 근데 뒤를 돌아봤어요. 근데 갑자기 새로운 바퀴벌레가 나와서 또 죽어있는 거예요."
    } ]
  }, {
    "tStartMs": 2394960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "두 마리가? 네."
    } ]
  }, {
    "tStartMs": 2396960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아... 네."
    } ]
  }, {
    "tStartMs": 2400000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "근데 진짜 와 이거 이건 진짜 우글우글 거리고 있겠구나"
    } ]
  }, {
    "tStartMs": 2409000,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "근데 그게 뭐 주방도 그렇고 모든 곳에서 그랬어요 모든 곳에서"
    } ]
  }, {
    "tStartMs": 2414600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "그러니까 말 그대로 상상할 수도 없어요"
    } ]
  }, {
    "tStartMs": 2417000,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "말 그대로 뒤돌면 바퀴벌레가 있는 그런 곳이었어요"
    } ]
  }, {
    "tStartMs": 2421280,
    "dDurationMs": 11999,
    "segs": [ {
      "utf8": "그래서 제가 진짜 진짜 한 2주 동안 바퀴벌레 약을 한 5통 썼을 거에요"
    } ]
  }, {
    "tStartMs": 2433279,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "그냥 그냥 그건 이제 바퀴벌레가 안 보여도 집에 다 뿌려 놓는 거에요"
    } ]
  }, {
    "tStartMs": 2441279,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그리고 현지에 있는 마트에 가서 나프탈렌 볼 같은 걸 사서"
    } ]
  }, {
    "tStartMs": 2447279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "구석에 다 심어 놓는 거에요"
    } ]
  }, {
    "tStartMs": 2450279,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그리고 치약을 또 싫어하는 거 아세요 바퀴벌레가?"
    } ]
  }, {
    "tStartMs": 2456279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "어 들어본 적 있는 거 같아요"
    } ]
  }, {
    "tStartMs": 2458279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "네 제일 싼 치약을 한 10개 사서"
    } ]
  }, {
    "tStartMs": 2463279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "와 전쟁이네요"
    } ]
  }, {
    "tStartMs": 2465279,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "그래서 주방이랑 그리고 집에 창틀이랑 모든 창문에 창틀이랑"
    } ]
  }, {
    "tStartMs": 2473279,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "베란다 이런 큰 창틀 그리고 외부에서 들어올 수 있는 모든 틈"
    } ]
  }, {
    "tStartMs": 2480279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "어떡해"
    } ]
  }, {
    "tStartMs": 2482279,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "거기를 다 그 치약 짜서 막 슥삭슥삭 다 치약질을 다 하는 거에요"
    } ]
  }, {
    "tStartMs": 2491279,
    "dDurationMs": 10000,
    "segs": [ {
      "utf8": "치약 코팅을 모든 틈과 모든 주방 그런 모서리와 그런 곳들을"
    } ]
  }, {
    "tStartMs": 2501279,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그래서 진짜 그때 힘들었는데 퇴근하고 오면 하루종일 계속 그거 하고"
    } ]
  }, {
    "tStartMs": 2507279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "아니 다시 이사갈 순 없었던 거에요?"
    } ]
  }, {
    "tStartMs": 2511279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그럴 순 없었어요"
    } ]
  }, {
    "tStartMs": 2514279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "진짜 절망적이다"
    } ]
  }, {
    "tStartMs": 2516279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그리고 그 집도 좋은 집이었어요 사실"
    } ]
  }, {
    "tStartMs": 2520279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그래서 2주간 그렇게 전쟁을 한 끝에"
    } ]
  }, {
    "tStartMs": 2525279,
    "dDurationMs": 10000,
    "segs": [ {
      "utf8": "그 이후로 바퀴벌레나 개미나 심지어 파리나 모기조차 단 한 마리도 안 나왔어요"
    } ]
  }, {
    "tStartMs": 2535279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "근데 궁금한 게 그 2주 동안 바퀴벌레 시체들이 막 있었어요 그럼?"
    } ]
  }, {
    "tStartMs": 2540279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그럼요"
    } ]
  }, {
    "tStartMs": 2542279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 진짜 싫어요"
    } ]
  }, {
    "tStartMs": 2545279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그럼요 그럼요"
    } ]
  }, {
    "tStartMs": 2551279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "좀 강해지셨겠는데요 그때 이후로"
    } ]
  }, {
    "tStartMs": 2554279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "많이 강해졌죠 진짜 와 진짜"
    } ]
  }, {
    "tStartMs": 2559279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "웬만한 바퀴벌레는 놀라지 않겠는데?"
    } ]
  }, {
    "tStartMs": 2563279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "놀라진 않죠"
    } ]
  }, {
    "tStartMs": 2565279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "대단해요 진짜 존경스러워요"
    } ]
  }, {
    "tStartMs": 2567279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아니에요 근데 그래도 싫어요"
    } ]
  }, {
    "tStartMs": 2569279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그래도 싫어요 그래도"
    } ]
  }, {
    "tStartMs": 2571279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "바퀴벌레 왜 이렇게 싫을까요?"
    } ]
  }, {
    "tStartMs": 2573279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그러니까"
    } ]
  }, {
    "tStartMs": 2574279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "조금 신기해요"
    } ]
  }, {
    "tStartMs": 2576279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "왜 그렇게 혐오스럽지?"
    } ]
  }, {
    "tStartMs": 2578279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 2581279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "솔직히 사슴벌레랑 좀 비슷하잖아요 그냥 까맣고"
    } ]
  }, {
    "tStartMs": 2585279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "근데 그렇게 막 싫지 않아요"
    } ]
  }, {
    "tStartMs": 2587279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "이미지가 너무 안 좋아서 그런가?"
    } ]
  }, {
    "tStartMs": 2590279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "일단 제 생각에는"
    } ]
  }, {
    "tStartMs": 2592279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그 다리에 있는"
    } ]
  }, {
    "tStartMs": 2595279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그 톱니 같은"
    } ]
  }, {
    "tStartMs": 2597279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "자세히도 보셨네요 톱니가 있어요?"
    } ]
  }, {
    "tStartMs": 2601279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "전 그냥 그 형체밖에 몰라요 더듬이랑"
    } ]
  }, {
    "tStartMs": 2604279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "더 얘기 안 하겠습니다"
    } ]
  }, {
    "tStartMs": 2606279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아 생긴 게 조금"
    } ]
  }, {
    "tStartMs": 2608279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "생긴 게 혐오스러운데 근데"
    } ]
  }, {
    "tStartMs": 2611279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "근데 제가"
    } ]
  }, {
    "tStartMs": 2613279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "제가 좀"
    } ]
  }, {
    "tStartMs": 2615279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "친구들 열받게 하려고"
    } ]
  }, {
    "tStartMs": 2617279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "종종 하던 얘기가 있는데"
    } ]
  }, {
    "tStartMs": 2619279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그거 알아요? 바퀴벌레랑"
    } ]
  }, {
    "tStartMs": 2621279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 열받아요"
    } ]
  }, {
    "tStartMs": 2624279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "왜요?"
    } ]
  }, {
    "tStartMs": 2625279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "새우랑 맛이 비슷하다고요?"
    } ]
  }, {
    "tStartMs": 2627279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아니 그 종이 비슷하다고?"
    } ]
  }, {
    "tStartMs": 2629279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "종?"
    } ]
  }, {
    "tStartMs": 2630279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네 생물학적으로"
    } ]
  }, {
    "tStartMs": 2633279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "되게 비슷하대요"
    } ]
  }, {
    "tStartMs": 2636279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그래서 뭐"
    } ]
  }, {
    "tStartMs": 2638279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "제가 디디님한테도 얘기했었어요? 어떻게 알지?"
    } ]
  }, {
    "tStartMs": 2640279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 이거 너무 저도 많이 열받았었어가지고"
    } ]
  }, {
    "tStartMs": 2643279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "친구들이 꼭 있어요 새우 먹고 있으면"
    } ]
  }, {
    "tStartMs": 2646279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그거 알아? 바퀴벌레랑 새우랑 맛 똑같대 이렇게"
    } ]
  }, {
    "tStartMs": 2649279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 2650279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "저는 어떻게 얘기하냐면"
    } ]
  }, {
    "tStartMs": 2653279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "우리 초밥집 가면"
    } ]
  }, {
    "tStartMs": 2655279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그 생새우초밥 있지 않느냐?"
    } ]
  }, {
    "tStartMs": 2657279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "간장에 절인 생새우초밥"
    } ]
  }, {
    "tStartMs": 2660279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그래서 뭐"
    } ]
  }, {
    "tStartMs": 2664279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "바퀴벌레도"
    } ]
  }, {
    "tStartMs": 2667279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그렇게 생새우초밥처럼"
    } ]
  }, {
    "tStartMs": 2670279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 진짜"
    } ]
  }, {
    "tStartMs": 2673279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "왜 그래요? 바퀴벌레 하우스도 사신 분이"
    } ]
  }, {
    "tStartMs": 2679279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그 이후로는 그 얘기 안 해요"
    } ]
  }, {
    "tStartMs": 2683279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "진짜 혐오스러워요"
    } ]
  }, {
    "tStartMs": 2687279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아니에요 아니에요 아니에요"
    } ]
  }, {
    "tStartMs": 2690279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "엄연히 다른 종이고"
    } ]
  }, {
    "tStartMs": 2693279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "엄연히 다른 맛이 날 것 같아요"
    } ]
  }, {
    "tStartMs": 2696279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네 다르죠"
    } ]
  }, {
    "tStartMs": 2699279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "맞아 무슨 조상이셨다나?"
    } ]
  }, {
    "tStartMs": 2702279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 그랬던 것 같아요"
    } ]
  }, {
    "tStartMs": 2706279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "식욕이 뚝 떨어지셨을 것 같아요"
    } ]
  }, {
    "tStartMs": 2709279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "이 팟캐스트 듣고 계시는 분들"
    } ]
  }, {
    "tStartMs": 2712279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "죄송합니다 아 예전엔 뭐"
    } ]
  }, {
    "tStartMs": 2715279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "햄버거 이런 맛있는 거 얘기하던 것처럼"
    } ]
  }, {
    "tStartMs": 2718279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그러니까 이제 바퀴벌레 같은 거"
    } ]
  }, {
    "tStartMs": 2721279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "안 나오도록 청소를 잘 해야겠다"
    } ]
  }, {
    "tStartMs": 2724279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아 진짜 진짜 깨끗하게 해야 됩니다"
    } ]
  }, {
    "tStartMs": 2726279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그리고 풀샴푸 바퀴벌레 퇴치제 이런 거 항상 두 통씩 사두시고"
    } ]
  }, {
    "tStartMs": 2730279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "아 근데 아까 그래서 방글라데시 집 얘기"
    } ]
  }, {
    "tStartMs": 2734279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그 하려고 했던 그 마지막 이야기가"
    } ]
  }, {
    "tStartMs": 2738279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "마지막 이야기?"
    } ]
  }, {
    "tStartMs": 2740279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그 이후로 제가 좀 중요한 걸 깨달았거든요"
    } ]
  }, {
    "tStartMs": 2743279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그리고 이게 그 원칙이"
    } ]
  }, {
    "tStartMs": 2746279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "인생의 대부분의 아 대부분은 아니라 많은 일에서"
    } ]
  }, {
    "tStartMs": 2749279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "적용이 된다는 걸 알았는데"
    } ]
  }, {
    "tStartMs": 2752279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "제가 이름을 붙인 게 하나 있어요"
    } ]
  }, {
    "tStartMs": 2755279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "오"
    } ]
  }, {
    "tStartMs": 2757279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "숲에서 곰을 만났을 때 살아남는 방법"
    } ]
  }, {
    "tStartMs": 2762279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "류거든요 이게"
    } ]
  }, {
    "tStartMs": 2765279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "친구들이랑 같이 숲에 갔는데"
    } ]
  }, {
    "tStartMs": 2769279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그 숲에서 곰을 만났을 때 살아남으려면"
    } ]
  }, {
    "tStartMs": 2773279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "곰보다 빠른 게 아니에요"
    } ]
  }, {
    "tStartMs": 2777279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "친구보다 빠르면 돼요"
    } ]
  }, {
    "tStartMs": 2779279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "에?"
    } ]
  }, {
    "tStartMs": 2781279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2782279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "좀 이기적이죠?"
    } ]
  }, {
    "tStartMs": 2783279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "태용쌤이랑 친구하면 안 되겠다"
    } ]
  }, {
    "tStartMs": 2786279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "아니에요 친구라고 안 할게요"
    } ]
  }, {
    "tStartMs": 2788279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그 숲에 있는 다른 사람보다 빠르면 돼요"
    } ]
  }, {
    "tStartMs": 2791279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "아 네 나만 아니면 돼"
    } ]
  }, {
    "tStartMs": 2794279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "네 사람을 쫓아오는 곰에게서 살아남으려면"
    } ]
  }, {
    "tStartMs": 2798279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "곰보다 빠른 스피드가 필요한 게 아니라"
    } ]
  }, {
    "tStartMs": 2801279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "옆 사람보다 빠르면 되는 거예요"
    } ]
  }, {
    "tStartMs": 2803279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "옆 사람보다만 빠르면 된다"
    } ]
  }, {
    "tStartMs": 2805279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네 그러니까"
    } ]
  }, {
    "tStartMs": 2808279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그 아파트 그 빌라 그 건물에는"
    } ]
  }, {
    "tStartMs": 2812279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "바퀴벌레가 있을 수 있어요"
    } ]
  }, {
    "tStartMs": 2815279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2816279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "근데 내가 옆집 윗집 아랫집보다"
    } ]
  }, {
    "tStartMs": 2821279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "바퀴벌레가 좋아할 만한 게 없으면"
    } ]
  }, {
    "tStartMs": 2825279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그러면 우리 집엔 바퀴벌레가 없을 수 있습니다"
    } ]
  }, {
    "tStartMs": 2830279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "더 많이 나왔겠다 태용쌤 옆집은"
    } ]
  }, {
    "tStartMs": 2833279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "옆집으로 다 간 거네요"
    } ]
  }, {
    "tStartMs": 2835279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그렇죠 왜냐면 제 집엔 진짜 먹을 것도 없고"
    } ]
  }, {
    "tStartMs": 2839279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "숨을 것도 없고"
    } ]
  }, {
    "tStartMs": 2841279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "치약 냄새 나고"
    } ]
  }, {
    "tStartMs": 2843279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "치약 냄새 나고"
    } ]
  }, {
    "tStartMs": 2844279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "진짜 그래서 진짜 거짓말 안 치고"
    } ]
  }, {
    "tStartMs": 2847279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그 10개월 중에 2주 빼고 바퀴벌레가 단 한 번도 안 나왔거든요"
    } ]
  }, {
    "tStartMs": 2851279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "어머 네"
    } ]
  }, {
    "tStartMs": 2852279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "근데 그게 잘 생각해 보니까 이유가 그런 게 아닐까 싶은 거예요"
    } ]
  }, {
    "tStartMs": 2856279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "다른 집으로 갔다 그쵸"
    } ]
  }, {
    "tStartMs": 2858279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그거 박멸할 순 없으니까"
    } ]
  }, {
    "tStartMs": 2860279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그러니까 박멸을 안 해도"
    } ]
  }, {
    "tStartMs": 2863279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "옆집보다 깔끔하면 된다"
    } ]
  }, {
    "tStartMs": 2867279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "바퀴벌레가 안 나오도록 나올 확률을 줄이는 법은"
    } ]
  }, {
    "tStartMs": 2872279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "옆집보다 깨끗하게 유지하기"
    } ]
  }, {
    "tStartMs": 2874279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2877279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그래서 이게 비난 바퀴벌레뿐만이 아니라"
    } ]
  }, {
    "tStartMs": 2881279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "참 인생의 많은 부분에서 적용된다는 걸 제가 깨달았습니다"
    } ]
  }, {
    "tStartMs": 2887279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2889279,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그렇잖아요 지난 시간에 얘기한 소개팅 에피소드에서도"
    } ]
  }, {
    "tStartMs": 2895279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "제가 세상에서 가장 매력적인 남자여야"
    } ]
  }, {
    "tStartMs": 2899279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "꽈팅에서 성공할 수 있는 게 아니잖아요"
    } ]
  }, {
    "tStartMs": 2902279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2903279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "옆에 있는 애들보다 잘나면 성공할 수 있는 거잖아요"
    } ]
  }, {
    "tStartMs": 2907279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "옆에는 그 사람만 이기자 라는 마인드"
    } ]
  }, {
    "tStartMs": 2910279,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 2913280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "뭔지 알겠어요"
    } ]
  }, {
    "tStartMs": 2916280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "거창한 뭔가가 없어도 되고"
    } ]
  }, {
    "tStartMs": 2919280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "근처 중에 1등 하자 약간 이런 마인드"
    } ]
  }, {
    "tStartMs": 2922280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2926280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "참 교훈은 좋은데"
    } ]
  }, {
    "tStartMs": 2928280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "이해하기가 좀 그러네요"
    } ]
  }, {
    "tStartMs": 2930280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "바퀴벌레로 깨닫게 된 거구나"
    } ]
  }, {
    "tStartMs": 2932280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2934280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "이렇게 세상은 각박합니다"
    } ]
  }, {
    "tStartMs": 2936280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "호락호락하지 않아요"
    } ]
  }, {
    "tStartMs": 2938280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "조금 늦으면 바퀴벌레 하우스가 되는 거예요"
    } ]
  }, {
    "tStartMs": 2941280,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2942280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "좋은 마무리였습니다"
    } ]
  }, {
    "tStartMs": 2944280,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "진짜 바퀴벌레라는 키워드가 너무 자극적이야"
    } ]
  }, {
    "tStartMs": 2950280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "뭔 이야기만 하다가 바퀴벌레 얘기 나오잖아요"
    } ]
  }, {
    "tStartMs": 2953280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그럼 진짜 거기로 이야기가 완전히 빠져요"
    } ]
  }, {
    "tStartMs": 2957280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 2959280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "매운맛이에요 바퀴벌레"
    } ]
  }, {
    "tStartMs": 2961280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 2963280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "이제 날씨가 점점 따뜻해지면서"
    } ]
  }, {
    "tStartMs": 2966280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "바퀴벌레도 이제 나올 시기가 됐는데"
    } ]
  }, {
    "tStartMs": 2969280,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "시작됐습니다"
    } ]
  }, {
    "tStartMs": 2971280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "깨끗하게 생활을 해봅시다"
    } ]
  }, {
    "tStartMs": 2974280,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "그러면 오늘은 이렇게 청소랑 바퀴벌레 청결, 미생"
    } ]
  }, {
    "tStartMs": 2980280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "이런 거에 대해서 요모조모 이야기를 해봤는데요"
    } ]
  }, {
    "tStartMs": 2983280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "다음 주제는 또 제가 생각을 해왔습니다"
    } ]
  }, {
    "tStartMs": 2986280,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "뭐죠?"
    } ]
  }, {
    "tStartMs": 2987280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "다음 주제는 대중교통"
    } ]
  }, {
    "tStartMs": 2990280,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "대중교통?"
    } ]
  }, {
    "tStartMs": 2991280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "네 버스, 택시, 지하철, 기차 이런 거"
    } ]
  }, {
    "tStartMs": 2995280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "대중교통에 대해서 요모조모 이야기 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 3000280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "네 그러면 이번 팟캐스트는 여기서 마무리하도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 3004280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "저는 디디였습니다 감사합니다"
    } ]
  }, {
    "tStartMs": 3007280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "감사합니다 정태웅이었습니다"
    } ]
  } ]
}
