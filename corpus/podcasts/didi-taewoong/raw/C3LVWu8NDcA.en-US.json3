    "tStartMs": 2208000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That makes sense."
    } ]
  }, {
    "tStartMs": 2210000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I'm always wondering about boots, whether to buy them or not."
    } ]
  }, {
    "tStartMs": 2216000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "Actually, I don't think they'd help much, and I'm not going to trek through the jungle or anything, and anyway it's just"
    } ]
  }, {
    "tStartMs": 2224000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "passing through a few muddy spots, so I didn't think it was worth it and didn't buy them."
