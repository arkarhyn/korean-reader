  }, {
    "tStartMs": 2241000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes. It was fun."
    } ]
  }, {
    "tStartMs": 2243000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Then let's wrap up the minigame here"
