  }, {
    "tStartMs": 2247000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "and next month will be August. It looks like it'll be around the end of August"
    } ]
  }, {
    "tStartMs": 2254000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "How about a movie?"
    } ]
  }, {
    "tStartMs": 2256000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Sounds good. Sounds good."
    } ]
  }, {
    "tStartMs": 2257000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Let's talk about movies in all sorts of ways."
