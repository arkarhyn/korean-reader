  }, {
    "tStartMs": 2516770,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Did I, did I do that?"
    } ]
  }, {
    "tStartMs": 2518540,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "Oh, that's right, swimming, and a swimsuit,"
