    } ]
  }, {
    "tStartMs": 1276320,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1278140,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "But there weren't any in our class."
    } ]
  }, {
    "tStartMs": 1281660,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Is it because it's beginner level?"
    } ]
  }, {
    "tStartMs": 1283140,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1283870,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So the older women are already skilled people — right — who've been around a long time."
    } ]
  }, {
    "tStartMs": 1286990,
    "dDurationMs": 7820,
    "segs": [ {
      "utf8": "The older women who can do it well are probably people who've stayed for a long time,"
    } ]
  }, {
    "tStartMs": 1294810,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "and then they develop their own community among themselves,"
