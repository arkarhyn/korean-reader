  }, {
    "tStartMs": 1310110,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "The changing room and shower area seniority you mentioned, if I remember correctly,"
    } ]
  }, {
    "tStartMs": 1315070,
    "dDurationMs": 7230,
    "segs": [ {
      "utf8": "people criticize a lot if you don't wash your body before leaving,"
