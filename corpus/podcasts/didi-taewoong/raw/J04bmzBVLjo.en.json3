  }, {
    "tStartMs": 2575110,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "You don't know, right?"
    } ]
  }, {
    "tStartMs": 2576050,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "What is it? But what is it?"
