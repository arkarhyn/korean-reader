  }, {
    "tStartMs": 1527190,
    "dDurationMs": 6740,
    "segs": [ {
      "utf8": "That's what they say, and just from seeing so many older people doing it, it seems good,"
    } ]
  }, {
    "tStartMs": 1533930,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "it's really hard though, after about 10 minutes I actually want to stop."
