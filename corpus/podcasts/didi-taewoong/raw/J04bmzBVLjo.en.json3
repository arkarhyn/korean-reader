{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 9180,
    "segs": [ {
      "utf8": "Yomojomo of Korean Life with Didi and Jeong Tae-woong"
    } ]
  }, {
    "tStartMs": 9180,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Hello, this is Didi."
    } ]
  }, {
    "tStartMs": 11550,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "Hello, this is Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 13340,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Yomojomo of Korean Life is a podcast where two people living in Korea"
    } ]
  }, {
    "tStartMs": 16510,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "talk about the various aspects of Korean life."
    } ]
  }, {
    "tStartMs": 19710,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "This time we've come back with a new topic."
    } ]
  }, {
    "tStartMs": 22220,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "What's this week's topic?"
    } ]
  }, {
    "tStartMs": 24790,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "This week's topic is swimming."
    } ]
  }, {
    "tStartMs": 27390,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Swimming!"
    } ]
  }, {
    "tStartMs": 28190,
    "dDurationMs": 8260,
    "segs": [ {
      "utf8": "I remember Teacher Tae-woong saying he had a lot to talk about regarding swimming, so I prepared it for this episode."
    } ]
  }, {
    "tStartMs": 36450,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "The weather has gotten much hotter."
    } ]
  }, {
    "tStartMs": 38950,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh, it's so hot."
    } ]
  }, {
    "tStartMs": 39750,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Yesterday it was so hot that it was hard to fall asleep."
    } ]
  }, {
    "tStartMs": 42510,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Oh really? Don't you turn on the air conditioner these days?"
    } ]
  }, {
    "tStartMs": 45150,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "It doesn't seem like it's quite time to turn on the air conditioner yet."
    } ]
  }, {
    "tStartMs": 48480,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 49490,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "It's awkwardly hot, isn't it?"
    } ]
  }, {
    "tStartMs": 50680,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "Yeah, it feels like something bad will happen if I turn it on now."
    } ]
  }, {
    "tStartMs": 54210,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Since the real heat hasn't come yet."
    } ]
  }, {
    "tStartMs": 56930,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Exactly."
    } ]
  }, {
    "tStartMs": 57830,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 58910,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "So I'm living with a fan on."
    } ]
  }, {
    "tStartMs": 61160,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 63140,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "I was so hot in the morning that I just turn on the air conditioner during the day."
    } ]
  }, {
    "tStartMs": 67640,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "Oh, that's nice."
    } ]
  }, {
    "tStartMs": 69430,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Yes, so it seems like perfect weather for swimming."
    } ]
  }, {
    "tStartMs": 72970,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "First, before we talk seriously about swimming,"
    } ]
  }, {
    "tStartMs": 76190,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I'll tell you the answer to last week's quiz."
    } ]
  }, {
    "tStartMs": 79370,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "Last week's quiz was \"Which is not a dish that Teacher Tae-woong and Didi often cook?\""
    } ]
  }, {
    "tStartMs": 85570,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "So the answer was number 1, noodles."
    } ]
  }, {
    "tStartMs": 89130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "We don't cook noodles very often."
    } ]
  }, {
    "tStartMs": 91470,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "Congratulations to everyone who got the answer right."
    } ]
  }, {
    "tStartMs": 94580,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "So now if you listen until the very end today, there will be a quiz,"
    } ]
  }, {
    "tStartMs": 98490,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "so I'd appreciate it if everyone listens all the way through."
    } ]
  }, {
    "tStartMs": 102270,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Swimming, how is it these days?"
    } ]
  }, {
    "tStartMs": 104050,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "Teacher Tae-woong seems to be doing less of the busy stuff, or will be doing less."
    } ]
  }, {
    "tStartMs": 108260,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Are you going swimming?"
    } ]
  }, {
    "tStartMs": 111170,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "It got busy again."
    } ]
  }, {
    "tStartMs": 112390,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "Oh I see, it never stops."
    } ]
  }, {
    "tStartMs": 115620,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 117300,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "But I've been thinking about it a lot lately. I want to go swimming."
    } ]
  }, {
    "tStartMs": 121090,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Especially since the weather is so hot, it's so nice for swimming, right?"
    } ]
  }, {
    "tStartMs": 125410,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Exactly."
    } ]
  }, {
    "tStartMs": 127790,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Why, what's stopping you?"
    } ]
  }, {
    "tStartMs": 130090,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "I've started doing morning live streams lately."
    } ]
  }, {
    "tStartMs": 135600,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 136450,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "These days I'm doing live streams almost every weekday on Comprehensible Input Korean."
    } ]
  }, {
    "tStartMs": 141000,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "again."
    } ]
  }, {
    "tStartMs": 142990,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Every day?"
    } ]
  }, {
    "tStartMs": 144190,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Almost every weekday."
    } ]
  }, {
    "tStartMs": 147580,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "So it's become difficult to find time to go."
    } ]
  }, {
    "tStartMs": 152070,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "How can this be, how can this be."
    } ]
  }, {
    "tStartMs": 154300,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "So you're still taking walks, then?"
    } ]
  }, {
    "tStartMs": 157540,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I take walks in the morning and go running."
    } ]
  }, {
    "tStartMs": 160440,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "And I take walks in the evening too."
    } ]
  }, {
    "tStartMs": 161930,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "What if you replaced that with swimming?"
    } ]
  }, {
    "tStartMs": 164600,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "The swimming pool is pretty far from my house."
    } ]
  }, {
    "tStartMs": 166560,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Oh, so it takes more time."
    } ]
  }, {
    "tStartMs": 169500,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 171490,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "How far do you have to go?"
    } ]
  }, {
    "tStartMs": 174060,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "If you take the bus, it's about 20, 30 minutes?"
    } ]
  }, {
    "tStartMs": 177140,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Oh my."
    } ]
  }, {
    "tStartMs": 178370,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "That's the problem, right—there just aren't many swimming pools in the neighborhood."
    } ]
  }, {
    "tStartMs": 182910,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 184890,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "So it's hard to go. Then how often did you go back in the day?"
    } ]
  }, {
    "tStartMs": 190220,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "When I went a lot."
    } ]
  }, {
    "tStartMs": 192030,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "A lot, I didn't go for that long—just about two months—"
    } ]
  }, {
    "tStartMs": 196290,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "but back then I went four times a week."
    } ]
  }, {
    "tStartMs": 198140,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "Wow, that's serious."
    } ]
  }, {
    "tStartMs": 201210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "You were really into it."
    } ]
  }, {
    "tStartMs": 203010,
    "dDurationMs": 5750,
    "segs": [ {
      "utf8": "No, well... yes, that's right. I signed up for a beginner class,"
    } ]
  }, {
    "tStartMs": 208760,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "and I registered without knowing anything and took the classes,"
    } ]
  }, {
    "tStartMs": 214460,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "and the class was held four times a week,"
    } ]
  }, {
    "tStartMs": 218750,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "which was Tuesday, Wednesday, Thursday, Friday."
    } ]
  }, {
    "tStartMs": 221090,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So I went every day for that."
    } ]
  }, {
    "tStartMs": 223400,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Wow, they taught pretty intensively."
    } ]
  }, {
    "tStartMs": 227330,
    "dDurationMs": 6690,
    "segs": [ {
      "utf8": "But that was a swimming pool run by the Haeundae district,"
    } ]
  }, {
    "tStartMs": 234020,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "so that's pretty common."
    } ]
  }, {
    "tStartMs": 235710,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "Right, but there are multiple lanes, you know, swimming lanes."
    } ]
  }, {
    "tStartMs": 241750,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "So the three lanes on the far left were for the beginner class,"
    } ]
  }, {
    "tStartMs": 247490,
    "dDurationMs": 6580,
    "segs": [ {
      "utf8": "then three in the middle for intermediate, and three on the right for advanced."
    } ]
  }, {
    "tStartMs": 254070,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And within the beginner class there were levels 1, 2, and 3,"
    } ]
  }, {
    "tStartMs": 257310,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "and each class had about 10 or 15 students."
    } ]
  }, {
    "tStartMs": 261590,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "There was only one instructor."
    } ]
  }, {
    "tStartMs": 263130,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 266050,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "How many students per class? Per lane?"
    } ]
  }, {
    "tStartMs": 268700,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "About 10?"
    } ]
  }, {
    "tStartMs": 271740,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "Sometimes more than 10, so altogether it was about 30 people,"
    } ]
  }, {
    "tStartMs": 277080,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "and there was only one instructor, so they'd say \"Okay, freestyle is done like this,\""
    } ]
  }, {
    "tStartMs": 281020,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "\"Do a few laps,\" and then move to the next lane."
    } ]
  }, {
    "tStartMs": 284120,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Ah, that's totally cost-effective, isn't it? It feels cost-effective?"
    } ]
  }, {
    "tStartMs": 288200,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "Yes, yes."
    } ]
  }, {
    "tStartMs": 289050,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "Well, usually there's one instructor per lane,"
    } ]
  }, {
    "tStartMs": 293880,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 294550,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "I haven't seen one instructor for three lanes before."
    } ]
  }, {
    "tStartMs": 297820,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "So since there was no instructor,"
    } ]
  }, {
    "tStartMs": 301610,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "you'd just do this and stand around a bit..."
    } ]
  }, {
    "tStartMs": 304920,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "do it... and look around a bit,"
    } ]
  }, {
    "tStartMs": 309100,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "so it wasn't really that hard."
    } ]
  }, {
    "tStartMs": 311440,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "It was basically free swimming."
    } ]
  }, {
    "tStartMs": 312930,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Just like there was one lifeguard watching?"
    } ]
  }, {
    "tStartMs": 317730,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 319660,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "But when you're a beginner, you definitely learn better,"
    } ]
  }, {
    "tStartMs": 323740,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I think that's how it is."
    } ]
  }, {
    "tStartMs": 326830,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "So I didn't learn properly."
    } ]
  }, {
    "tStartMs": 329700,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "You couldn't do it at all? You couldn't swim originally?"
    } ]
  }, {
    "tStartMs": 332250,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 332990,
    "dDurationMs": 7140,
    "segs": [ {
      "utf8": "Ah, I notice that people from countries with a lot of ocean nearby"
    } ]
  }, {
    "tStartMs": 340130,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "learn swimming as a requirement."
    } ]
  }, {
    "tStartMs": 342990,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 343430,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "From elementary school—like in Japan, there are a lot of natural disasters,"
    } ]
  }, {
    "tStartMs": 347740,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "so swimming is a sport everyone learns in elementary school, but Korea isn't like that."
    } ]
  }, {
    "tStartMs": 353300,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 355030,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "So Teacher Tae-woong couldn't do it either, didn't learn it."
    } ]
  }, {
    "tStartMs": 358430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "I was born in Busan, but..."
    } ]
  }, {
    "tStartMs": 360320,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "So..."
    } ]
  }, {
    "tStartMs": 361660,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "What about Busan?"
    } ]
  }, {
    "tStartMs": 363550,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Isn't that supposed to be required?"
    } ]
  }, {
    "tStartMs": 365440,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Well, I didn't really go to elementary school in Busan."
    } ]
  }, {
    "tStartMs": 368540,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "I went in Chungcheongbuk-do, where there's no ocean."
    } ]
  }, {
    "tStartMs": 372070,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "You've moved around a lot, haven't you?"
    } ]
  }, {
    "tStartMs": 373360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 374620,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "When you see people from Busan around you, what do you think? Are there people you learned with in elementary school?"
    } ]
  }, {
    "tStartMs": 379950,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "But other than me, it seems like everyone else can just do it."
    } ]
  }, {
    "tStartMs": 385040,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "Ah..."
    } ]
  }, {
    "tStartMs": 386910,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "I learned it when I was young, going to places like centers."
    } ]
  }, {
    "tStartMs": 391510,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "I learned it and can do it."
    } ]
  }, {
    "tStartMs": 393220,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "But there are quite a lot of friends around me who can't do it."
    } ]
  }, {
    "tStartMs": 396280,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 397120,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 399400,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "I also lived for such a long time not being able to do it at all."
    } ]
  }, {
    "tStartMs": 403870,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "But after learning, it seems really good."
    } ]
  }, {
    "tStartMs": 406950,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "What was good about it? What charm did you feel in swimming?"
    } ]
  }, {
    "tStartMs": 410710,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "First of all, it's just fun."
    } ]
  }, {
    "tStartMs": 412680,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Isn't the act of swimming itself fun?"
    } ]
  }, {
    "tStartMs": 414180,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "Just floating like this in the water and moving forward, that kind of process?"
    } ]
  }, {
    "tStartMs": 420000,
    "dDurationMs": 7970,
    "segs": [ {
      "utf8": "That's because those are postures we can't do in our daily lives, right?"
    } ]
  }, {
    "tStartMs": 427970,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 430530,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Like doing it this way and like this..."
    } ]
  }, {
    "tStartMs": 432430,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Floating..."
    } ]
  }, {
    "tStartMs": 433850,
    "dDurationMs": 6290,
    "segs": [ {
      "utf8": "Yes, so your body is doing more varied movements, right?"
    } ]
  }, {
    "tStartMs": 440140,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "That itself feels like the body is enjoying it."
    } ]
  }, {
    "tStartMs": 444270,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Hmm, the movements are fun."
    } ]
  }, {
    "tStartMs": 448450,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "Isn't it?"
    } ]
  }, {
    "tStartMs": 449820,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "I didn't really feel swimming was fun."
    } ]
  }, {
    "tStartMs": 454400,
    "dDurationMs": 6110,
    "segs": [ {
      "utf8": "Because it's a bit boring for me—repetition, repetition like running."
    } ]
  }, {
    "tStartMs": 460510,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 461700,
    "dDurationMs": 6740,
    "segs": [ {
      "utf8": "It's not like climbing where you use your head in a fun way."
    } ]
  }, {
    "tStartMs": 468440,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "I like swimming because I've heard it's good for the body."
    } ]
  }, {
    "tStartMs": 472370,
    "dDurationMs": 6130,
    "segs": [ {
      "utf8": "Your muscles don't get hurt and your knees don't get hurt, they say it's really good."
    } ]
  }, {
    "tStartMs": 478500,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "That's the difference between me and you, Didi."
    } ]
  }, {
    "tStartMs": 482230,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "I think it was because I was just learning at the time."
    } ]
  }, {
    "tStartMs": 485700,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Ah, because you feel yourself improving."
    } ]
  }, {
    "tStartMs": 489920,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Right, because you're doing movements you didn't know before."
    } ]
  }, {
    "tStartMs": 492060,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Oh, that must have been fun."
    } ]
  }, {
    "tStartMs": 493590,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 495210,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "But now that I can do everything, just doing it is..."
    } ]
  }, {
    "tStartMs": 499650,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It might be different from the fun I feel."
    } ]
  }, {
    "tStartMs": 501810,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "That would make sense."
    } ]
  }, {
    "tStartMs": 503090,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "I couldn't move forward in the water before, but back then learning that must have been fun."
    } ]
  }, {
    "tStartMs": 508270,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 509950,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "When you start, you learn the kick first, right?"
    } ]
  }, {
    "tStartMs": 512820,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 514060,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "But you learned up to freestyle? In a few months?"
    } ]
  }, {
    "tStartMs": 517910,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "I learned freestyle and backstroke."
    } ]
  }, {
    "tStartMs": 519820,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Ah, oh."
    } ]
  }, {
    "tStartMs": 522910,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I'm still not very good at both."
    } ]
  }, {
    "tStartMs": 525250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "But now I can do them a little."
    } ]
  }, {
    "tStartMs": 527800,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "With just that you can survive in the ocean."
    } ]
  }, {
    "tStartMs": 530530,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 531120,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "Actually, just being able to float is enough."
    } ]
  }, {
    "tStartMs": 532990,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 534180,
    "dDurationMs": 6010,
    "segs": [ {
      "utf8": "I know four—'freestyle', 'backstroke', and butterfly is 'butterfly stroke'."
    } ]
  }, {
    "tStartMs": 540190,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And the one like a frog is 'breaststroke'."
    } ]
  }, {
    "tStartMs": 543630,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Butterfly stroke is still hard for me, I can't do it well."
    } ]
  }, {
    "tStartMs": 546910,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "They say that's the hardest posture."
    } ]
  }, {
    "tStartMs": 549080,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "That's right, that's right, just thinking about it."
    } ]
  }, {
    "tStartMs": 552680,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "It's hard even on the ground... it requires strength, right?"
    } ]
  }, {
    "tStartMs": 557900,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Lifting your body up like this and doing it."
    } ]
  }, {
    "tStartMs": 560030,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 562940,
    "dDurationMs": 8810,
    "segs": [ {
      "utf8": "So in the lane, you start with one person at a time, right?"
    } ]
  }, {
    "tStartMs": 571750,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "But when the instructor gathers a few students who have learned a bit..."
    } ]
  }, {
    "tStartMs": 578470,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "They teach them the butterfly stroke motion and all that."
    } ]
  }, {
    "tStartMs": 584270,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "\"This is how you do it, like this.\""
    } ]
  }, {
    "tStartMs": 585720,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "\"Start like this,\" and so on."
    } ]
  }, {
    "tStartMs": 589570,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "Everyone only watches that motion when they're starting off."
    } ]
  }, {
    "tStartMs": 593820,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "So when it becomes my turn last,"
    } ]
  }, {
    "tStartMs": 598290,
    "dDurationMs": 5650,
    "segs": [ {
      "utf8": "I say to the member, \"Please go do freestyle and come back,\" like that."
    } ]
  }, {
    "tStartMs": 603940,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "So then after about a month or two,"
    } ]
  }, {
    "tStartMs": 607740,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I can do freestyle a little bit now,"
    } ]
  }, {
    "tStartMs": 610590,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "So everyone suddenly starts with breaststroke, like whoosh,"
    } ]
  }, {
    "tStartMs": 613900,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "And I suddenly go whoosh like that too... I go in like that whoosh as well."
    } ]
  }, {
    "tStartMs": 618250,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "And then I come up, puh,"
    } ]
  }, {
    "tStartMs": 620960,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "And then the instructor asks, \"What are you doing?\""
    } ]
  }, {
    "tStartMs": 623640,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "You just wanted to try it, right?"
    } ]
  }, {
    "tStartMs": 625300,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Yes. [laughs]"
    } ]
  }, {
    "tStartMs": 627220,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "But anyway, it looked fun."
    } ]
  }, {
    "tStartMs": 629070,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "So you just do it."
    } ]
  }, {
    "tStartMs": 630140,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 631040,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "At first when you start, you kind of dive in and go for a while,"
    } ]
  }, {
    "tStartMs": 635000,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Then you come up like this and start, right?"
    } ]
  }, {
    "tStartMs": 637440,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Did you do something like that?"
    } ]
  }, {
    "tStartMs": 638780,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 640440,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "I realized this needs to come up."
    } ]
  }, {
    "tStartMs": 642190,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 644450,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "So I'd like to learn until I master it, since I've already started."
    } ]
  }, {
    "tStartMs": 649050,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 651550,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "But this isn't easy."
    } ]
  }, {
    "tStartMs": 654870,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "I have three YouTube channels"
    } ]
  }, {
    "tStartMs": 659410,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And classes that I'm preparing for..."
    } ]
  }, {
    "tStartMs": 663170,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "You must be really busy."
    } ]
  }, {
    "tStartMs": 664630,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "That's true."
    } ]
  }, {
    "tStartMs": 665580,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So if you have time, are you thinking of learning swimming again?"
    } ]
  }, {
    "tStartMs": 670580,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "If the conditions allow?"
    } ]
  }, {
    "tStartMs": 673270,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "You said you did it for how long?"
    } ]
  }, {
    "tStartMs": 675290,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "Two months."
    } ]
  }, {
    "tStartMs": 676020,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "Two months."
    } ]
  }, {
    "tStartMs": 677350,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "What happened during those two months?"
    } ]
  }, {
    "tStartMs": 679930,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "Like, do you remember any episodes?"
    } ]
  }, {
    "tStartMs": 682560,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "There wasn't any special episode,"
    } ]
  }, {
    "tStartMs": 684940,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Oh right, I thought it would be good if we talked about swimming pool culture,"
    } ]
  }, {
    "tStartMs": 689440,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "Because it seems like this doesn't exist in other countries."
    } ]
  }, {
    "tStartMs": 694490,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "You said there are three beginner lanes, right?"
    } ]
  }, {
    "tStartMs": 697530,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "So after you do a one-hour swimming lesson and it's time to finish,"
    } ]
  }, {
    "tStartMs": 704100,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "The people from the three beginner lanes"
    } ]
  }, {
    "tStartMs": 706880,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "Form a circle in the swimming pool water,"
    } ]
  }, {
    "tStartMs": 712440,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Everyone stands in a circle, making a circle,"
    } ]
  }, {
    "tStartMs": 715950,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "With people all around like this,"
    } ]
  }, {
    "tStartMs": 718540,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "At the end the instructor says, \"You all worked hard today, see you tomorrow,\""
    } ]
  }, {
    "tStartMs": 722950,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "Or \"See you next week,\" and then everyone says \"Fighting!\""
    } ]
  }, {
    "tStartMs": 726980,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So then... anyway, that's how it goes,"
    } ]
  }, {
    "tStartMs": 730400,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "On the first day, I thought, \"Oh, this must be the goodbye greeting.\""
    } ]
  }, {
    "tStartMs": 734460,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "I thought that on the first day,"
    } ]
  }, {
    "tStartMs": 736610,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "But there was this man next to me,"
    } ]
  }, {
    "tStartMs": 740010,
    "dDurationMs": 7320,
    "segs": [ {
      "utf8": "And he grabbed my hand under the water."
    } ]
  }, {
    "tStartMs": 747330,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "So... uh, what's this? Does he want to get close to me?"
    } ]
  }, {
    "tStartMs": 750680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "That's what I thought..."
    } ]
  }, {
    "tStartMs": 752450,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Uh, what does this mean?"
    } ]
  }, {
    "tStartMs": 754200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "D... does he want to get close to me?"
    } ]
  }, {
    "tStartMs": 756570,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "He just grabbed my hand."
    } ]
  }, {
    "tStartMs": 757750,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "Is it a handshake? Yes."
    } ]
  }, {
    "tStartMs": 759300,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 760490,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "And I was just holding it from below."
    } ]
  }, {
    "tStartMs": 764900,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "Squeeze. ❤️"
    } ]
  }, {
    "tStartMs": 765880,
    "dDurationMs": 6130,
    "segs": [ {
      "utf8": "But then suddenly other people were raising their hands like this."
    } ]
  }, {
    "tStartMs": 772010,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "But I didn't know anything about it."
    } ]
  }, {
    "tStartMs": 774210,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "So I was like, \"What is this?\""
    } ]
  }, {
    "tStartMs": 775240,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "Then the man next to me said that when we finish, we all hold hands together and do this fighting cheer."
    } ]
  }, {
    "tStartMs": 781120,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "While doing a banzai, while doing a banzai, \"Thank you for your hard work.\""
    } ]
  }, {
    "tStartMs": 784510,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "He said that's how we end it."
    } ]
  }, {
    "tStartMs": 786440,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "What kind of culture is that?"
    } ]
  }, {
    "tStartMs": 787330,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "Isn't that a Busan culture? I'm hearing about it for the first time."
    } ]
  }, {
    "tStartMs": 789920,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "I bet other swimming pools have that during class time too?"
    } ]
  }, {
    "tStartMs": 794310,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "Is that so?"
    } ]
  }, {
    "tStartMs": 796000,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I learned it when I was so young..."
    } ]
  }, {
    "tStartMs": 799090,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "I think there probably is."
    } ]
  }, {
    "tStartMs": 800410,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Huh? That's a swimming greeting culture?"
    } ]
  }, {
    "tStartMs": 803260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 806050,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Oh..."
    } ]
  }, {
    "tStartMs": 809020,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "So I was really surprised."
    } ]
  }, {
    "tStartMs": 810320,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "But on that first day, the lady on the opposite side of me"
    } ]
  }, {
    "tStartMs": 814610,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "seemed a bit embarrassed and didn't hold hands."
    } ]
  }, {
    "tStartMs": 818220,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Ah, someone who practices gender separation..."
    } ]
  }, {
    "tStartMs": 820520,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "So that's what confused me."
    } ]
  }, {
    "tStartMs": 822160,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Oh, because only one person held hands?"
    } ]
  }, {
    "tStartMs": 826880,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Oh, that's funny."
    } ]
  }, {
    "tStartMs": 828620,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 830590,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "So did that person just do the fighting cheer with the person next to her?"
    } ]
  }, {
    "tStartMs": 833300,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Well, some people might not do it? If they're a bit shy?"
    } ]
  }, {
    "tStartMs": 836150,
    "dDurationMs": 7460,
    "segs": [ {
      "utf8": "No, everyone did it, but only that person seemed a bit shy."
    } ]
  }, {
    "tStartMs": 843610,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "That's interesting. Was there nothing when you started?"
    } ]
  }, {
    "tStartMs": 846720,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "There was nothing at the start."
    } ]
  }, {
    "tStartMs": 848810,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Oh, just like, warm-up exercises."
    } ]
  }, {
    "tStartMs": 849840,
    "dDurationMs": 1800,
    "segs": [ {
