  }, {
    "tStartMs": 1397980,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "I turned it on and came back after a quick shower,"
    } ]
  }, {
    "tStartMs": 1401500,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "and the lid was just open like that, so I was like 'what's this, what's this',"
    } ]
  }, {
    "tStartMs": 1405840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "but it still didn't work even when I tried again,"
    } ]
  }, {
    "tStartMs": 1407460,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "and then there was this woman standing next to me"
    } ]
  }, {
    "tStartMs": 1409900,
    "dDurationMs": 6150,
    "segs": [ {
      "utf8": "and she very coldly just yanked the door open,"
    } ]
  }, {
    "tStartMs": 1416050,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "so I was like 'what's this, what's this', but she just kept doing this 🙂‍↔️"
    } ]
  }, {
    "tStartMs": 1420760,
    "dDurationMs": 6860,
    "segs": [ {
      "utf8": "shaking her head and leaving, like 'you don't even know this?', and she left,"
    } ]
  }, {
    "tStartMs": 1427620,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "and I was wondering what I did wrong, but it turned out"
