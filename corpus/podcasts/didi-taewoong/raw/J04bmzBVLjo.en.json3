  }, {
    "tStartMs": 2567010,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Wait a moment..."
    } ]
  }, {
    "tStartMs": 2569980,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "What was it? I can't remember either,"
