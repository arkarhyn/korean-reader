    "dDurationMs": 870,
    "segs": [ {
      "utf8": "It helps."
    } ]
  }, {
    "tStartMs": 1604220,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Yes, it's a really good exercise for dieting, actually."
