  }, {
    "tStartMs": 1340720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "That's scary."
    } ]
  }, {
    "tStartMs": 1342600,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "I go swimming occasionally these days."
    } ]
  }, {
    "tStartMs": 1345880,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "I go about once a week or once every two weeks,"
    } ]
  }, {
    "tStartMs": 1349520,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "and I had an episode like this once, though it wasn't quite seniority."
    } ]
  }, {
    "tStartMs": 1354880,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "After I finished swimming at the pool and did some free swimming,"
    } ]
  }, {
    "tStartMs": 1357900,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "I wash my body and rinse my swimsuit there inside,"
    } ]
  }, {
    "tStartMs": 1362860,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "do a simple wash and head home,"
    } ]
  }, {
    "tStartMs": 1366280,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "and there's this thing where you can squeeze the water out of the rinsed swimsuit."
    } ]
  }, {
    "tStartMs": 1371820,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "What do you call it? Is it called a 'spin dryer'?"
