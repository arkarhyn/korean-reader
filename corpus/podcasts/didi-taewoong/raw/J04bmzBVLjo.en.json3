  }, {
    "tStartMs": 2581280,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "and then..."
    } ]
  }, {
    "tStartMs": 2583250,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Was it a kickboard?"
    } ]
  }, {
    "tStartMs": 2584430,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "Oh, it's a kickboard,"
    } ]
  }, {
    "tStartMs": 2585400,
    "dDurationMs": 8270,
    "segs": [ {
      "utf8": "A kickboard! I remember Teacher Tae-woong using a kickboard when practicing kicks!"
    } ]
  }, {
    "tStartMs": 2593670,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Wow, this is so hard, my heart is pounding right now,"
    } ]
  }, {
    "tStartMs": 2598270,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Oh but we went a lot,"
    } ]
  }, {
    "tStartMs": 2599690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "We went a lot, really,"
    } ]
  }, {
    "tStartMs": 2601220,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Since it was one round, we did it with our lives on the line,"
    } ]
  }, {
    "tStartMs": 2603900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "We went a lot, it's a shame,"
    } ]
  }, {
    "tStartMs": 2605910,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "It was fun, it was fun,"
    } ]
  }, {
    "tStartMs": 2609400,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "So today we talked about swimming pools and swimming from every angle,"
    } ]
  }, {
    "tStartMs": 2614110,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And if you have any more questions about swimming or Korean swimming pools,"
    } ]
  }, {
    "tStartMs": 2618030,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "please leave them in the comments, and I'll reply to them whenever I check,"
    } ]
  }, {
    "tStartMs": 2623630,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "I've been thinking about the next topic, and the next topic is 'sleep,' how does that sound?"
    } ]
  }, {
    "tStartMs": 2627870,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "Sleep, sleeping,"
    } ]
  }, {
    "tStartMs": 2629380,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "That's what we do, sleep,"
    } ]
  }, {
    "tStartMs": 2631530,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Right, sleeping,"
    } ]
  }, {
    "tStartMs": 2633360,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "It'll be a chance for me to flex my sleep score,"
    } ]
  }, {
    "tStartMs": 2637050,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Your score must be high,"
    } ]
  }, {
    "tStartMs": 2639100,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Mine too,"
    } ]
  }, {
    "tStartMs": 2640130,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "I'm also a bit confident,"
    } ]
  }, {
    "tStartMs": 2642070,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2643100,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Want to battle?"
    } ]
  }, {
    "tStartMs": 2644120,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Oh, I like it, a sleep score battle,"
    } ]
  }, {
    "tStartMs": 2648200,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Yes, sounds good, right?"
    } ]
  }, {
    "tStartMs": 2649260,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "Sounds good, sounds good. So next week we'll have a battle about how well we sleep."
    } ]
  }, {
    "tStartMs": 2654210,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "We'll talk about sleep in all sorts of ways with Yomojomo."
    } ]
  }, {
    "tStartMs": 2657510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Well, thank you for listening today."
    } ]
