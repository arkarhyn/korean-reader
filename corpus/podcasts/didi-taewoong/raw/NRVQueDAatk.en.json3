    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You could eat there"
    } ]
  }, {
    "tStartMs": 1307900,
    "dDurationMs": 4299,
    "segs": [ {
      "utf8": "one order of spicy chicken wing fried rice"
    } ]
  }, {
    "tStartMs": 1312199,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "and then looked around a bit"
    } ]
  }, {
    "tStartMs": 1314900,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "and then we moved on."
    } ]
  }, {
    "tStartMs": 1316199,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Oh, so nothing went wrong."
    } ]
  }, {
    "tStartMs": 1318699,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "Yes. It seemed a bit"
    } ]
  }, {
    "tStartMs": 1321500,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "excessive to do it alone."
    } ]
  }, {
    "tStartMs": 1322699,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "It seemed excessive."
    } ]
  }, {
    "tStartMs": 1324300,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "Right. Someone has to take a photo for you too."
    } ]
  }, {
    "tStartMs": 1327199,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1328500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Oh and if I did it alone, it seemed like"
    } ]
  }, {
    "tStartMs": 1330300,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I would get a bit sad, you know."
    } ]
  }, {
    "tStartMs": 1331800,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "Hahaha."
    } ]
  }, {
    "tStartMs": 1334699,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "At that time, when writing wishes,"
    } ]
  }, {
    "tStartMs": 1337600,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "I wrote something like, please let me meet a man like Park Bo-gum."
    } ]
  }, {
    "tStartMs": 1339500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "I think that's what I wrote."
    } ]
  }, {
    "tStartMs": 1340600,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 1341699,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1342399,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Park Bo..."
    } ]
  }, {
    "tStartMs": 1343100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 1344300,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I really liked Park Bo-gum back then."
    } ]
  }, {
    "tStartMs": 1347100,
    "dDurationMs": 4799,
    "segs": [ {
      "utf8": "Oh, the year before that was Reply"
    } ]
  }, {
    "tStartMs": 1351899,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Oh, I guess that's why. I guess that's why."
    } ]
  }, {
    "tStartMs": 1353399,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "1994?"
    } ]
  }, {
    "tStartMs": 1355199,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "Yeah. 1988."
    } ]
  }, {
    "tStartMs": 1356800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "'88. '88."
    } ]
  }, {
    "tStartMs": 1358300,
    "dDurationMs": 3599,
    "segs": [ {
      "utf8": "Reply 1988 aired that year, so that must be why."
    } ]
  }, {
    "tStartMs": 1361899,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "Yeah. I guess that's why."
    } ]
  }, {
    "tStartMs": 1363800,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1364899,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "So we just moved on from Sponge."
    } ]
  }, {
    "tStartMs": 1367500,
    "dDurationMs": 3199,
    "segs": [ {
      "utf8": "Yes. The point is that we ate the spicy chicken wing fried rice."
    } ]
  }, {
    "tStartMs": 1370699,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1371800,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I should have really eaten two back then."
    } ]
  }, {
    "tStartMs": 1374600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I've eaten it several times."
    } ]
  }, {
    "tStartMs": 1377000,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 1377500,
    "dDurationMs": 699,
    "segs": [ {
      "utf8": "I should go home too."
    } ]
  }, {
    "tStartMs": 1378199,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1379199,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "And um..."
    } ]
  }, {
    "tStartMs": 1383899,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "S, E, S, G, N, G."
    } ]
  }, {
    "tStartMs": 1385699,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Jin."
    } ]
  }, {
    "tStartMs": 1386199,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Jin and S."
    } ]
  }, {
    "tStartMs": 1386699,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "Yes. Jin and S."
    } ]
  }, {
    "tStartMs": 1388000,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1388500,
    "dDurationMs": 5199,
    "segs": [ {
      "utf8": "Jin and S must be a village that had coal mines long ago."
    } ]
  }, {
    "tStartMs": 1393699,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh yes."
    } ]
  }, {
    "tStartMs": 1394699,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "So it's a miners' village."
    } ]
  }, {
    "tStartMs": 1397100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 1398100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Yes. That miners' village,"
    } ]
  }, {
    "tStartMs": 1400500,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "yeah."
    } ]
  }, {
    "tStartMs": 1401000,
    "dDurationMs": 3899,
    "segs": [ {
      "utf8": "There's like a miners' museum there or something."
    } ]
  }, {
    "tStartMs": 1404899,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 1405600,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "Like gold and bronze that were mined there."
    } ]
  }, {
    "tStartMs": 1409399,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 1409899,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "Things like that would be on display."
    } ]
  }, {
    "tStartMs": 1412300,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "Oh, I think I went there too. Yes."
    } ]
  }, {
    "tStartMs": 1413899,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Oh you did? You went?"
    } ]
  }, {
    "tStartMs": 1415199,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1416199,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "There's a really dramatic story here,"
    } ]
  }, {
    "tStartMs": 1421199,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Is it right here?"
    } ]
  }, {
    "tStartMs": 1422199,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "Yes. That's the place."
    } ]
  }, {
    "tStartMs": 1424300,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "That's actually why we did the Taiwan episode today."
    } ]
  }, {
    "tStartMs": 1427100,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1428699,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "I'm looking forward to it."
    } ]
  }, {
    "tStartMs": 1429300,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "What happened?"
    } ]
  }, {
    "tStartMs": 1430600,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1431399,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "Well, Jiufen and Shifen are mining towns."
    } ]
  }, {
    "tStartMs": 1434500,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 1435100,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And there's something like a mining museum."
    } ]
  }, {
    "tStartMs": 1437100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "There is a museum."
    } ]
  }, {
    "tStartMs": 1438300,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "Yes. And when you come out after seeing it,"
    } ]
  }, {
    "tStartMs": 1441399,
    "dDurationMs": 6601,
    "segs": [ {
      "utf8": "there's a restaurant where you can eat the lunch boxes that miners used to eat."
    } ]
  }, {
    "tStartMs": 1448000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I went there."
    } ]
  }, {
    "tStartMs": 1449000,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Oh, you went?"
    } ]
  }, {
    "tStartMs": 1450100,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "Yes. I ate some kind of round lunch box there."
    } ]
  }, {
    "tStartMs": 1452899,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "You could have brought that lunch box with you, you know."
    } ]
  }, {
    "tStartMs": 1454300,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh, that's right. That's right."
    } ]
  }, {
    "tStartMs": 1455300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Right, right, right."
    } ]
  }, {
    "tStartMs": 1456500,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1457399,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "But I didn't know about it, so I just went."
    } ]
  }, {
    "tStartMs": 1459600,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 1460200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So I didn't eat the lunch box."
    } ]
  }, {
    "tStartMs": 1463500,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "But when you go to eat that rice,"
    } ]
  }, {
    "tStartMs": 1468200,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "the restaurant building itself probably isn't that big."
    } ]
  }, {
    "tStartMs": 1473100,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "There was no space inside for me, so I couldn't even go in."
    } ]
  }, {
    "tStartMs": 1478600,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "Outside the restaurant it's set up like a courtyard, and it's quite spacious."
    } ]
  }, {
    "tStartMs": 1483500,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "There's a wide courtyard,"
    } ]
  }, {
    "tStartMs": 1486899,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "and there are a lot of round tables."
    } ]
  }, {
    "tStartMs": 1490399,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "That's what it seemed like."
    } ]
  }, {
    "tStartMs": 1491600,
    "dDurationMs": 5199,
    "segs": [ {
      "utf8": "Yes. So people who can't eat inside the restaurant"
    } ]
  }, {
    "tStartMs": 1496799,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "sit at the round tables in that courtyard"
    } ]
  }, {
    "tStartMs": 1500000,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "and those tables are probably for 4 or 5 people?"
    } ]
  }, {
    "tStartMs": 1505700,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "Like, seating for about 4 people,"
    } ]
  }, {
    "tStartMs": 1508799,
    "dDurationMs": 4201,
    "segs": [ {
      "utf8": "there are a lot of tables like that."
    } ]
  }, {
    "tStartMs": 1513000,
    "dDurationMs": 5299,
    "segs": [ {
      "utf8": "But since I didn't know anything, I just went and ordered rice and was eating."
    } ]
  }, {
    "tStartMs": 1518299,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Yes. Outside?"
    } ]
  }, {
    "tStartMs": 1519399,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "Yes, yes. I was sitting at an outdoor table"
    } ]
  }, {
    "tStartMs": 1522600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "eating rice by myself like that, slurp slurp."
    } ]
  }, {
    "tStartMs": 1525000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "It must have been hot. It's summer."
    } ]
  }, {
    "tStartMs": 1526500,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Oh, that's right."
    } ]
  }, {
    "tStartMs": 1527899,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "And also, summer is Taiwan's rainy season,"
    } ]
  }, {
    "tStartMs": 1533299,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "so there are frequent showers."
    } ]
  }, {
    "tStartMs": 1535899,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 1536500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Yes. Rain comes for a bit and then stops for a bit,"
    } ]
  }, {
    "tStartMs": 1539000,
    "dDurationMs": 4899,
    "segs": [ {
      "utf8": "comes and stops, and it repeats, and the humidity was pretty high too."
    } ]
  }, {
    "tStartMs": 1543899,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Yes. Anyway, so I was eating rice,"
    } ]
  }, {
    "tStartMs": 1548299,
    "dDurationMs": 7301,
    "segs": [ {
      "utf8": "and at the table across from me, there was a woman"
    } ]
  }, {
    "tStartMs": 1555600,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "who also came alone and sat at that table and started eating rice."
    } ]
  }, {
    "tStartMs": 1562000,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "What nationality did she seem to be?"
    } ]
  }, {
    "tStartMs": 1564500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "She seemed like she could be Korean or Japanese."
    } ]
  }, {
    "tStartMs": 1568500,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "At least she was East Asian?"
    } ]
  }, {
    "tStartMs": 1569700,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "Yes. She was East Asian at least."
    } ]
  }, {
    "tStartMs": 1572799,
    "dDurationMs": 4701,
    "segs": [ {
      "utf8": "Oh, but you were sitting facing each other?"
    } ]
  }, {
    "tStartMs": 1577500,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "Yes. Why are you already laughing?"
    } ]
  }, {
    "tStartMs": 1581299,
    "dDurationMs": 6301,
    "segs": [ {
      "utf8": "Oh, yes. But at the table where I was sitting,"
    } ]
  }, {
    "tStartMs": 1587600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you know how they call it a parasol?"
    } ]
  }, {
    "tStartMs": 1589600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That big umbrella?"
    } ]
  }, {
    "tStartMs": 1591100,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1591600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "There was one,"
    } ]
  }, {
    "tStartMs": 1594100,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "but I noticed that not all tables had parasols."
    } ]
  }, {
    "tStartMs": 1598700,
    "dDurationMs": 5699,
    "segs": [ {
      "utf8": "So some tables had a parasol over their heads,"
    } ]
  }, {
    "tStartMs": 1604399,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "So there's a roof"
    } ]
  }, {
    "tStartMs": 1606100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "and there's shade"
    } ]
  }, {
    "tStartMs": 1607100,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "Yes. And there's shade"
    } ]
  }, {
    "tStartMs": 1608899,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "but then some tables don't have shade"
    } ]
  }, {
    "tStartMs": 1613299,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but anyway, it seems like that person came alone too"
    } ]
  }, {
    "tStartMs": 1616299,
    "dDurationMs": 4701,
    "segs": [ {
      "utf8": "I was thinking like that while eating"
    } ]
  }, {
    "tStartMs": 1621000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "As I mentioned earlier"
    } ]
  }, {
    "tStartMs": 1623100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Taiwan was in the rainy season back then, you know."
    } ]
  }, {
    "tStartMs": 1626100,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1626899,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "I was eating when it started to rain."
    } ]
  }, {
    "tStartMs": 1629100,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1630399,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "A drop or two of rain started falling"
    } ]
  }, {
    "tStartMs": 1633899,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and it looked like more rain was coming."
    } ]
  }, {
    "tStartMs": 1636899,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "But the woman sitting at the table across from me"
    } ]
  }, {
    "tStartMs": 1640600,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "didn't have any shade"
    } ]
  }, {
    "tStartMs": 1642399,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "didn't have a parasol"
    } ]
  }, {
    "tStartMs": 1644500,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "so I could see she was really panicking."
    } ]
  }, {
    "tStartMs": 1646700,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "What do I do."
    } ]
  }, {
    "tStartMs": 1647899,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "But then our eyes met."
    } ]
  }, {
    "tStartMs": 1650100,
    "dDurationMs": 699,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1650799,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "So I gestured like this."
    } ]
  }, {
    "tStartMs": 1653000,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Like a drama. Yes."
    } ]
  }, {
    "tStartMs": 1655200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Come over here first."
    } ]
  }, {
    "tStartMs": 1656500,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "Come on, come on. Yes."
    } ]
  }, {
    "tStartMs": 1657799,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "So she quickly packed up her lunch box and belongings"
    } ]
  }, {
    "tStartMs": 1661200,
    "dDurationMs": 3199,
    "segs": [ {
      "utf8": "and came to my table."
    } ]
  }, {
    "tStartMs": 1664399,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1666600,
    "dDurationMs": 5699,
    "segs": [ {
      "utf8": "So we ended up sharing a table like that, kind of by accident."
    } ]
  }, {
    "tStartMs": 1672299,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1673000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 1674600,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "wow, it's really like the opening scene of a romance story that starts in a travel destination"
    } ]
  }, {
    "tStartMs": 1679000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "like that kind of scene."
    } ]
  }, {
    "tStartMs": 1681100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1682600,
    "dDurationMs": 4199,
    "segs": [ {
      "utf8": "So after we shared the table and I asked, she turned out to be Korean."
    } ]
  }, {
    "tStartMs": 1686799,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 1688200,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1689299,
    "dDurationMs": 5801,
    "segs": [ {
      "utf8": "So I said I'm Korean too, and when I heard her story"
    } ]
  }, {
    "tStartMs": 1695100,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "it turned out she hadn't come alone on the trip."
    } ]
  }, {
    "tStartMs": 1699000,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1699700,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "She came with a friend, the two of them"
    } ]
  }, {
    "tStartMs": 1702899,
    "dDurationMs": 6201,
    "segs": [ {
      "utf8": "and they were supposed to fly back to Korea that morning."
    } ]
  }, {
    "tStartMs": 1709100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1710000,
    "dDurationMs": 3599,
    "segs": [ {
      "utf8": "So they were supposed to go back"
    } ]
  }, {
    "tStartMs": 1713599,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "was it because of traffic?"
    } ]
  }, {
    "tStartMs": 1716799,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "They were late to the airport."
    } ]
  }, {
    "tStartMs": 1719400,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 1720000,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "They got to the airport late. Both of them."
    } ]
  }, {
    "tStartMs": 1721799,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Both of them. Yes."
    } ]
  }, {
    "tStartMs": 1722500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes. Her and her friend."
    } ]
  }, {
    "tStartMs": 1724500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1725500,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So they got to the airport late and missed their flight."
    } ]
  }, {
    "tStartMs": 1728700,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh no."
    } ]
  }, {
    "tStartMs": 1729700,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 1733400,
    "dDurationMs": 5699,
    "segs": [ {
      "utf8": "they could pay more, a larger amount"
    } ]
  }, {
    "tStartMs": 1739099,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "and go back that day"
    } ]
  }, {
    "tStartMs": 1741500,
    "dDurationMs": 2599,
    "segs": [ {
      "utf8": "or else wait another day or two"
    } ]
  }, {
    "tStartMs": 1744099,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "until a seat became available"
    } ]
  }, {
    "tStartMs": 1747099,
    "dDurationMs": 4401,
    "segs": [ {
      "utf8": "and go back for a cheaper price"
    } ]
  }, {
    "tStartMs": 1751500,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "but the friend who came with her"
    } ]
  }, {
    "tStartMs": 1754700,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "had to go to work the next day no matter what, so she had no choice"
    } ]
  }, {
    "tStartMs": 1759500,
    "dDurationMs": 4299,
    "segs": [ {
      "utf8": "I just paid more for a plane ticket and went to Korea, and ended up alone."
    } ]
  }, {
    "tStartMs": 1763799,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1764599,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "So since it turned out that way anyway"
    } ]
  }, {
    "tStartMs": 1767500,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "I thought, well, let me go to a tourist spot I haven't been to with my friend"
    } ]
  }, {
    "tStartMs": 1775500,
    "dDurationMs": 4099,
    "segs": [ {
      "utf8": "So that day I came back into the city from the airport"
    } ]
  }, {
    "tStartMs": 1779599,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "and came to this Jiufen miner village."
    } ]
  }, {
    "tStartMs": 1782400,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 1783799,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "And that's how I ended up eating with that person."
    } ]
  }, {
    "tStartMs": 1787900,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1789799,
    "dDurationMs": 6701,
    "segs": [ {
      "utf8": "So they asked me what my schedule would be like going forward"
    } ]
  }, {
    "tStartMs": 1796500,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "and as we were talking about this and that"
    } ]
  }, {
    "tStartMs": 1798599,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "I said"
    } ]
  }, {
    "tStartMs": 1800000,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "I'm going to Jiufen now, and they said they'd been there before, so they offered to be my guide."
    } ]
  }, {
    "tStartMs": 1809840,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "Really? They'd be your guide? Yes. They'd be your guide? Yes."
    } ]
  }, {
    "tStartMs": 1816240,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "So the two of us went to Jiufen together and had a really fun time sightseeing."
    } ]
  }, {
    "tStartMs": 1823559,
    "dDurationMs": 9641,
    "segs": [ {
      "utf8": "And there's this café in Jiufen that's either three or four stories tall."
    } ]
  }, {
    "tStartMs": 1833200,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "But if you go up to the floor above the café, you can see the Jiufen scenery really beautifully all at once."
    } ]
  }, {
    "tStartMs": 1843040,
    "dDurationMs": 4239,
    "segs": [ {
      "utf8": "Yes. A prime spot. Yes."
    } ]
  }, {
    "tStartMs": 1847279,
    "dDurationMs": 6801,
    "segs": [ {
      "utf8": "But when we got there, there were so many people in front of it. Yes. It was like total chaos."
    } ]
  }, {
    "tStartMs": 1854080,
    "dDurationMs": 7280,
    "segs": [ {
      "utf8": "Ugh. Apple, right. Yes. We didn't even know if there was a line or how to get in"
    } ]
  }, {
    "tStartMs": 1861360,
    "dDurationMs": 7239,
    "segs": [ {
      "utf8": "But the woman who came with me, did she not speak English very well?"
    } ]
  }, {
    "tStartMs": 1868599,
    "dDurationMs": 8600,
    "segs": [ {
      "utf8": "Anyway, I think that's why when they came with their friend last time, they couldn't communicate and couldn't get into the café."
    } ]
  }, {
    "tStartMs": 1877199,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "But I speak English, don't I? Oh. English speaker."
    } ]
  }, {
    "tStartMs": 1881639,
    "dDurationMs": 8200,
    "segs": [ {
      "utf8": "Yes. So I really impressively talked to the staff member in front, going on and on"
    } ]
  }, {
    "tStartMs": 1889839,
    "dDurationMs": 11201,
    "segs": [ {
      "utf8": "and after waiting a bit, whether it was the third floor or whatever, I was able to sit in the spot with the best view up there."
    } ]
  }, {
    "tStartMs": 1901040,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "Yes. One word of English. Because I could speak English. Yes. That's right."
    } ]
  }, {
    "tStartMs": 1906440,
    "dDurationMs": 8320,
    "segs": [ {
      "utf8": "So I really sat in the best view spot in Jiufen. Yes. We had a really good time."
    } ]
  }, {
    "tStartMs": 1914760,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And after we came out, I think we went to the night market together too."
    } ]
  }, {
    "tStartMs": 1918480,
    "dDurationMs": 6520,
    "segs": [ {
      "utf8": "Ah. You really enjoyed a full day of dating. Yes. That's right."
    } ]
  }, {
    "tStartMs": 1925000,
    "dDurationMs": 5399,
    "segs": [ {
      "utf8": "And ah. That must have been my last day. That night."
    } ]
  }, {
    "tStartMs": 1930399,
    "dDurationMs": 12240,
    "segs": [ {
      "utf8": "Yes. So after we finished sightseeing all the way to the night market, our accommodations were in different subway station neighborhoods, so we took the subway"
    } ]
  }, {
    "tStartMs": 1942639,
    "dDurationMs": 6961,
    "segs": [ {
      "utf8": "and before I got off at my stop, I think that person got off first."
    } ]
  }, {
    "tStartMs": 1949600,
    "dDurationMs": 7159,
    "segs": [ {
      "utf8": "Yes. But then that person's phone battery was running out."
    } ]
  }, {
    "tStartMs": 1957360,
    "dDurationMs": 7559,
    "segs": [ {
      "utf8": "But didn't they have a power bank? Did the power bank's battery run out too? That's what happened"
    } ]
  }, {
    "tStartMs": 1964919,
    "dDurationMs": 7161,
    "segs": [ {
      "utf8": "But true to my nature of always being well-prepared, I had two power banks."
    } ]
  }, {
    "tStartMs": 1972080,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "Wow. Were you hoping to meet someone like that?"
    } ]
  }, {
    "tStartMs": 1977520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Ah. Ah. I should lend it if I meet them. Ah. That's not it. Ah. Is that so?"
    } ]
  }, {
    "tStartMs": 1981360,
    "dDurationMs": 6679,
    "segs": [ {
      "utf8": "At the time, I had one power bank with a huge capacity that was heavy"
    } ]
  }, {
    "tStartMs": 1988039,
    "dDurationMs": 9321,
    "segs": [ {
      "utf8": "and one card-type power bank that was lighter than my phone, so I carried two like that."
    } ]
  }, {
    "tStartMs": 1997360,
    "dDurationMs": 8360,
    "segs": [ {
      "utf8": "So since I barely used the card-type battery, I thought, well, I don't need this right now"
    } ]
  }, {
    "tStartMs": 2005720,
    "dDurationMs": 14839,
    "segs": [ {
      "utf8": "so I told them to just use it and return it to me in Korea if they have business in Busan, and I gave them the power bank"
    } ]
  }, {
    "tStartMs": 2020559,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and left room to meet again"
    } ]
  }, {
    "tStartMs": 2023039,
    "dDurationMs": 11080,
    "segs": [ {
      "utf8": "Yes. So we parted like that and I came back to Korea the next day just fine."
    } ]
  }, {
    "tStartMs": 2034119,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "I see. So?"
    } ]
  }, {
    "tStartMs": 2036679,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "Yes. So that's how the Taiwan trip ended."
    } ]
  }, {
    "tStartMs": 2042279,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "Ah. That's a beautiful story."
    } ]
  }, {
    "tStartMs": 2044600,
    "dDurationMs": 10560,
    "segs": [ {
      "utf8": "Yes. The story after that happens outside of Taiwan, so in the Taiwan episode"
    } ]
  }, {
    "tStartMs": 2055160,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "we're not telling it?"
    } ]
  }, {
    "tStartMs": 2056359,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "I've decided not to tell it."
    } ]
  }, {
    "tStartMs": 2057679,
    "dDurationMs": 6321,
    "segs": [ {
      "utf8": "Wow. How would you tell us?"
    } ]
  }, {
    "tStartMs": 2064000,
    "dDurationMs": 6239,
    "segs": [ {
      "utf8": "If we pay for it now, will you tell us?"
    } ]
  }, {
    "tStartMs": 2070239,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "What episode do we need?"
    } ]
  }, {
    "tStartMs": 2074160,
    "dDurationMs": 3239,
    "segs": [ {
      "utf8": "Yes. That's"
    } ]
  }, {
    "tStartMs": 2077399,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Teacher Tae-woong says he's going to keep it buried in his heart."
    } ]
  }, {
    "tStartMs": 2081119,
    "dDurationMs": 5601,
    "segs": [ {
      "utf8": "Ah. I'll think about that depending on what our subscribers want."
    } ]
  }, {
    "tStartMs": 2086720,
    "dDurationMs": 4679,
    "segs": [ {
      "utf8": "Yes. Listeners, don't you want to hear it? I'm curious."
    } ]
  }, {
    "tStartMs": 2091440,
    "dDurationMs": 3239,
    "segs": [ {
      "utf8": "Ah. But isn't the story really fun? Don't you think?"
    } ]
  }, {
    "tStartMs": 2094679,
    "dDurationMs": 5321,
    "segs": [ {
      "utf8": "Well. It was a coincidence that we ended up sharing a table, that's true"
    } ]
  }, {
    "tStartMs": 2100000,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "but still, the two of you got along well talking"
    } ]
  }, {
    "tStartMs": 2103720,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "and spent the day together anyway, right?"
    } ]
  }, {
    "tStartMs": 2106160,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2108600,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "That's fun."
    } ]
  }, {
    "tStartMs": 2109480,
    "dDurationMs": 10240,
    "segs": [ {
      "utf8": "Yes. Oh. Right. When the rain started falling, the scenery of that drama itself, you know?"
    } ]
  }, {
    "tStartMs": 2119720,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Exactly."
    } ]
  }, {
    "tStartMs": 2121200,
    "dDurationMs": 5479,
    "segs": [ {
      "utf8": "I mean, wow. I still remember that so vividly."
    } ]
  }, {
    "tStartMs": 2126679,
    "dDurationMs": 5321,
    "segs": [ {
      "utf8": "Teacher Tae-woong, when you traveled alone, did things like that happen to you pretty often?"
    } ]
  }, {
    "tStartMs": 2132000,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "Like, meeting someone to travel with?"
    } ]
  }, {
    "tStartMs": 2137920,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Yeah, I think it happened."
    } ]
  }, {
    "tStartMs": 2142720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "By chance like that?"
    } ]
  }, {
    "tStartMs": 2144320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Oh. I think it happened a lot. For me."
    } ]
  }, {
    "tStartMs": 2146000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Oh. Really?"
    } ]
  }, {
    "tStartMs": 2147440,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2148399,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "How does that happen?"
    } ]
  }, {
    "tStartMs": 2149519,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "I didn't really have that. When I traveled alone."
    } ]
  }, {
    "tStartMs": 2153679,
    "dDurationMs": 5361,
    "segs": [ {
      "utf8": "Usually you go imagining things like that, right? Like, what if some new encounter is waiting for me?"
    } ]
  }, {
    "tStartMs": 2159040,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "Mm. That's true."
    } ]
  }, {
    "tStartMs": 2160359,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "I didn't really have it, though. Too bad."
    } ]
  }, {
    "tStartMs": 2165119,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Oh. That kind of thing is so fun."
    } ]
  }, {
    "tStartMs": 2167279,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Mm. It's fun. This kind of story."
    } ]
  }, {
    "tStartMs": 2170839,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "If you're going to Taiwan, take note."
    } ]
  }, {
    "tStartMs": 2174959,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "What was the place called again? Jingguasi?"
    } ]
  }, {
    "tStartMs": 2177959,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Jingguasi."
    } ]
  }, {
    "tStartMs": 2179079,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "Jingguasi restaurant."
    } ]
  }, {
    "tStartMs": 2181000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Yes. You have to go during the rainy season."
    } ]
  }, {
    "tStartMs": 2183640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It needs to rain."
    } ]
  }, {
    "tStartMs": 2185640,
    "dDurationMs": 919,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 2186559,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "Yes. I'm thinking of going again this summer."
    } ]
  }, {
    "tStartMs": 2190040,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Oh. Really?"
    } ]
  }, {
    "tStartMs": 2191200,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "Oh. I'm joking."
    } ]
  }, {
    "tStartMs": 2192959,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "Oh. Why?"
    } ]
  }, {
    "tStartMs": 2195320,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Drama. To experience the drama one more time."
    } ]
  }, {
    "tStartMs": 2196920,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "Are you going to film another drama?"
    } ]
  }, {
    "tStartMs": 2199679,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2202160,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "It's fun. When you travel alone, stories like this get created and that's what makes it fun, I think."
    } ]
  }, {
    "tStartMs": 2207320,
    "dDurationMs": 2639,
    "segs": [ {
      "utf8": "Oh. You can't do that if you go with a friend."
    } ]
  }, {
    "tStartMs": 2209959,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You can't. You just hang out with your friend and come back."
    } ]
  }, {
    "tStartMs": 2212119,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Yes. Of course that's fun too."
    } ]
  }, {
    "tStartMs": 2214359,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "That's right. It has a different charm."
    } ]
  }, {
    "tStartMs": 2216000,
    "dDurationMs": 7160,
    "segs": [ {
      "utf8": "Yes yes. Oh. Oh. What if that wasn't the last day?"
    } ]
  }, {
    "tStartMs": 2223160,
    "dDurationMs": 1519,
    "segs": [ {
      "utf8": "Huh? If it wasn't?"
    } ]
  }, {
    "tStartMs": 2224679,
    "dDurationMs": 5321,
    "segs": [ {
      "utf8": "Then Dan Su-hee would have gone the next day too."
    } ]
  }, {
    "tStartMs": 2230000,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Oh. Something didn't work out in Korea, I guess."
    } ]
  }, {
    "tStartMs": 2234880,
    "dDurationMs": 6079,
    "segs": [ {
      "utf8": "Oh. That's because it's something outside of Taiwan."
    } ]
  }, {
    "tStartMs": 2240959,
    "dDurationMs": 4081,
    "segs": [ {
      "utf8": "We can meet again anytime."
    } ]
  }, {
    "tStartMs": 2245040,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "But today is about Taiwan."
    } ]
  }, {
    "tStartMs": 2247760,
    "dDurationMs": 5519,
    "segs": [ {
      "utf8": "There's also this thing called the travel destination effect, so if we had traveled a bit more,"
    } ]
  }, {
    "tStartMs": 2253279,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "we might have made other good memories too,"
    } ]
  }, {
    "tStartMs": 2255839,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "or we might have created a different drama."
    } ]
  }, {
    "tStartMs": 2258359,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "Yes. That's right."
    } ]
  }, {
    "tStartMs": 2260920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Did I have anything like that?"
    } ]
  }, {
    "tStartMs": 2264200,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "Teacher Tae-woong, why do you have so many stories?"
    } ]
  }, {
    "tStartMs": 2266519,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "Uh. I wonder too."
    } ]
  }, {
    "tStartMs": 2268600,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "Last time I posted about public transportation."
    } ]
  }, {
    "tStartMs": 2270839,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "Yes yes."
    } ]
  }, {
    "tStartMs": 2271519,
    "dDurationMs": 6641,
    "segs": [ {
      "utf8": "The subscribers all said your stories are so fun and they really loved it."
    } ]
  }, {
    "tStartMs": 2278160,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "Oh. Thank you so much."
    } ]
  }, {
    "tStartMs": 2281079,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "A bundle of stories."
    } ]
  }, {
    "tStartMs": 2283880,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Oh. It feels like a dream. Going back like this."
    } ]
  }, {
    "tStartMs": 2287440,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "You should travel alone again. More."
    } ]
  }, {
    "tStartMs": 2290239,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Yes. I should."
    } ]
  }, {
    "tStartMs": 2293839,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "That's fun, isn't it?"
    } ]
  }, {
    "tStartMs": 2295119,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "But now that I think about it."
    } ]
  }, {
    "tStartMs": 2297399,
    "dDurationMs": 3801,
    "segs": [ {
      "utf8": "Oh. Should I talk about this in the Japan episode?"
    } ]
  }, {
    "tStartMs": 2301200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Talk about it in the Japan episode. Did something happen where you met someone?"
    } ]
  }, {
    "tStartMs": 2304160,
    "dDurationMs": 3239,
    "segs": [ {
      "utf8": "Yeah. It did happen. But the reason I brought up this story is"
    } ]
  }, {
    "tStartMs": 2307399,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "Even back then, I wasn't alone"
    } ]
  }, {
    "tStartMs": 2310320,
    "dDurationMs": 2359,
    "segs": [ {
      "utf8": "Oh. What do you mean."
    } ]
  }, {
    "tStartMs": 2312679,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "But this isn't something so romantic or dramatic like that"
    } ]
  }, {
    "tStartMs": 2317640,
    "dDurationMs": 6399,
    "segs": [ {
      "utf8": "But there's also another story about how I happened to meet local friends like that."
    } ]
  }, {
    "tStartMs": 2324039,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "That sounds so fun. You have to do the Japan episode."
    } ]
  }, {
    "tStartMs": 2327239,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I've also traveled to Japan quite a lot."
    } ]
  }, {
    "tStartMs": 2329239,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "Mm. That's good."
    } ]
  }, {
    "tStartMs": 2331320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Oh. Have you heard about that?"
    } ]
  }, {
    "tStartMs": 2332840,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Taiwan is giving travel support funds until May or June, I think."
    } ]
  }, {
    "tStartMs": 2337440,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "What? What do you mean by that?"
    } ]
  }, {
    "tStartMs": 2339039,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "You don't know about that?"
    } ]
  }, {
    "tStartMs": 2339840,
    "dDurationMs": 5759,
    "segs": [ {
      "utf8": "Taiwan gives travel support funds to visitors who come to Taiwan."
    } ]
  }, {
    "tStartMs": 2345599,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "They've been doing this since after COVID, until the funds run out"
    } ]
  }, {
    "tStartMs": 2349599,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "And I believe that's until May or June this year."
    } ]
  }, {
    "tStartMs": 2353280,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2354760,
    "dDurationMs": 2359,
    "segs": [ {
      "utf8": "Yes. So how it works is"
    } ]
  }, {
    "tStartMs": 2357119,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "When you go right to the airport, I'm not exactly sure where it is"
    } ]
  }, {
    "tStartMs": 2360000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Try searching for it once."
    } ]
  }, {
    "tStartMs": 2361520,
    "dDurationMs": 3839,
    "segs": [ {
      "utf8": "Some kind of game place comes up."
    } ]
  }, {
    "tStartMs": 2365359,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "At the place that gives out travel support funds."
    } ]
  }, {
    "tStartMs": 2367799,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So when you press a button"
    } ]
  }, {
    "tStartMs": 2372039,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "It spins around like brrrrr"
    } ]
  }, {
    "tStartMs": 2374080,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "And you get either a win or a blank, one of these two outcomes"
    } ]
  }, {
    "tStartMs": 2378440,
    "dDurationMs": 5119,
    "segs": [ {
      "utf8": "So if you win, they give you about 250,000 won"
    } ]
  }, {
    "tStartMs": 2383559,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "And I've heard that over 50% of people win."
    } ]
  }, {
    "tStartMs": 2387440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "That's amazing."
    } ]
  }, {
    "tStartMs": 2390640,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "That's why I wanted to go too."
    } ]
  }, {
    "tStartMs": 2393880,
    "dDurationMs": 4799,
    "segs": [ {
      "utf8": "Wow. So if three people go, that's a jackpot, right?"
    } ]
  }, {
    "tStartMs": 2398679,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "If three people go, then"
    } ]
  }, {
    "tStartMs": 2431000,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "It just happens to be rainy season."
    } ]
  }, {
    "tStartMs": 2432919,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "It just happens to be rainy season."
    } ]
  }, {
    "tStartMs": 2433799,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And there could be new meetings waiting for you too."
    } ]
  }, {
    "tStartMs": 2435959,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Wow..."
    } ]
  }, {
    "tStartMs": 2437360,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Wow, you know things like that."
    } ]
  }, {
    "tStartMs": 2439560,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Yes, I looked up other countries but there's nothing"
    } ]
  }, {
    "tStartMs": 2443040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Taiwan is the only one that has something like this right now."
    } ]
  }, {
    "tStartMs": 2445840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Wow..."
    } ]
  }, {
    "tStartMs": 2447040,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Wow, Taiwan really is a great country."
    } ]
  }, {
    "tStartMs": 2449720,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Yes, and what I see a lot as content these days is"
    } ]
  }, {
    "tStartMs": 2453480,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "How the people and residents are so kind"
    } ]
  }, {
    "tStartMs": 2458200,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "I see a lot of that kind of content."
    } ]
  }, {
    "tStartMs": 2459840,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Oh, Taiwanese people really do seem very kind."
    } ]
  }, {
    "tStartMs": 2463520,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The guesthouse staff member I met back then"
    } ]
  }, {
    "tStartMs": 2466760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Was so kind"
    } ]
  }, {
    "tStartMs": 2468760,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Oh, really?"
    } ]
  }, {
    "tStartMs": 2470160,
    "dDurationMs": 3759,
    "segs": [ {
      "utf8": "Yes, they were smiling so brightly"
    } ]
  }, {
    "tStartMs": 2473919,
    "dDurationMs": 4201,
    "segs": [ {
      "utf8": "So I went to a night market once"
    } ]
  }, {
    "tStartMs": 2478120,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "And did the thing where you shoot and get a stuffed animal as a prize"
    } ]
  }, {
    "tStartMs": 2482800,
    "dDurationMs": 3159,
    "segs": [ {
      "utf8": "And I won a pretty big stuffed animal"
    } ]
  }, {
    "tStartMs": 2485959,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "And I gave it as a gift to that guesthouse."
    } ]
  }, {
    "tStartMs": 2488440,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "That's amazing."
    } ]
  }, {
    "tStartMs": 2490239,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "You really do things like that often, Teacher Tae-woong."
    } ]
  }, {
    "tStartMs": 2492480,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Oh, is that so?"
    } ]
  }, {
    "tStartMs": 2493879,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Santa."
    } ]
  }, {
    "tStartMs": 2495239,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "But it feels good, doesn't it."
    } ]
  }, {
    "tStartMs": 2497040,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "I see. Because you care so much about people,"
    } ]
  }, {
    "tStartMs": 2499720,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "it seems like good connections keep coming your way."
    } ]
  }, {
    "tStartMs": 2501559,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "Ah..."
    } ]
  }, {
    "tStartMs": 2503480,
    "dDurationMs": 4799,
    "segs": [ {
      "utf8": "Thank you for sharing such an interesting experience."
    } ]
  }, {
    "tStartMs": 2508279,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Next time, let's talk about how you attract people."
    } ]
  }, {
    "tStartMs": 2512919,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "Tae-woong's power to attract people—"
    } ]
  }, {
    "tStartMs": 2516160,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "please give us a lecture on it."
    } ]
  }, {
    "tStartMs": 2517919,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "I'm thinking maybe we should do an episode like that."
    } ]
  }, {
    "tStartMs": 2520519,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now that I think about it, it does sound fun."
    } ]
  }, {
    "tStartMs": 2523639,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "I wonder why that is."
    } ]
  }, {
    "tStartMs": 2527559,
    "dDurationMs": 4961,
    "segs": [ {
      "utf8": "So let's wrap up the Taiwan episode here,"
    } ]
  }, {
    "tStartMs": 2532520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and going forward, I think it would be nice to"
    } ]
  }, {
    "tStartMs": 2536360,
    "dDurationMs": 2479,
    "segs": [ {
      "utf8": "occasionally share stories about places we've traveled to."
    } ]
  }, {
    "tStartMs": 2538839,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And I've been thinking about the theme for the next episode,"
    } ]
  }, {
    "tStartMs": 2542119,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "and I'd like to do a series of stories."
    } ]
  }, {
    "tStartMs": 2545080,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "What kind of series? A school series."
    } ]
  }, {
    "tStartMs": 2549800,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "Why? Why? Why are you laughing?"
    } ]
  }, {
    "tStartMs": 2551639,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Just thinking about it makes me laugh."
    } ]
  }, {
    "tStartMs": 2552919,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Oh, it makes you laugh?"
    } ]
  }, {
    "tStartMs": 2554559,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "So the first episode we'll do is elementary school."
    } ]
  }, {
    "tStartMs": 2559679,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Please look forward to the elementary, middle, and high school series going forward."
    } ]
  }, {
    "tStartMs": 2564119,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "Tae-woong says he already has lots of funny stories."
    } ]
  }, {
    "tStartMs": 2567360,
    "dDurationMs": 4839,
    "segs": [ {
      "utf8": "Oh, just thinking about my elementary school days now,"
    } ]
  }, {
    "tStartMs": 2572520,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "it's so funny."
    } ]
  }, {
    "tStartMs": 2575600,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "I'm looking forward to it too."
    } ]
  }, {
    "tStartMs": 2577240,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Yes, sounds good."
    } ]
  }, {
    "tStartMs": 2579000,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So next time, we'll talk about the elementary school episode"
    } ]
  }, {
    "tStartMs": 2581960,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "and chat about it Yomojomo style."
    } ]
  }, {
    "tStartMs": 2584279,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "This has been Didi and Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 2587559,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  } ]
}
