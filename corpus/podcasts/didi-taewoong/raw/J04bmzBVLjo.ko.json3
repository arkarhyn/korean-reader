{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 9180,
    "segs": [ {
      "utf8": "디디와 정태웅의 한국생활 요모조모"
    } ]
  }, {
    "tStartMs": 9180,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "안녕하세요 디디입니다"
    } ]
  }, {
    "tStartMs": 11550,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "안녕하세요 정태웅입니다"
    } ]
  }, {
    "tStartMs": 13340,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "한국생활 요모조모는 한국에서 살아가는 두 사람이"
    } ]
  }, {
    "tStartMs": 16510,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "한국생활의 요모조모를 이야기하는 팟캐스트입니다"
    } ]
  }, {
    "tStartMs": 19710,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "이번 또 새로운 주제로 찾아왔는데요"
    } ]
  }, {
    "tStartMs": 22220,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "이번 주 주제 어떤 건가요?"
    } ]
  }, {
    "tStartMs": 24790,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "이번 주의 주제는 수영입니다"
    } ]
  }, {
    "tStartMs": 27390,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "수영!"
    } ]
  }, {
    "tStartMs": 28190,
    "dDurationMs": 8260,
    "segs": [ {
      "utf8": "태웅쌤이 수영에 대해서 좀 이야기할 게 많다라고 하신 게 기억이 나가지고 이번에 준비해봤고요"
    } ]
  }, {
    "tStartMs": 36450,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "날씨가 많이 더워졌어요"
    } ]
  }, {
    "tStartMs": 38950,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "아 너무 더워요"
    } ]
  }, {
    "tStartMs": 39750,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "어제 너무 더워서 잠드는 게 힘들었습니다"
    } ]
  }, {
    "tStartMs": 42510,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "아 진짜요 요즘 에어컨 안 트세요?"
    } ]
  }, {
    "tStartMs": 45150,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "아직 에어컨까지 틀 정도는 아닌 것 같아서"
    } ]
  }, {
    "tStartMs": 48480,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "맞아"
    } ]
  }, {
    "tStartMs": 49490,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "애매하게 덥죠"
    } ]
  }, {
    "tStartMs": 50680,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "맞아요 뭔가 지금 틀면 큰일 날 것 같은"
    } ]
  }, {
    "tStartMs": 54210,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "아직 본격적인 더위가 안 왔으니까"
    } ]
  }, {
    "tStartMs": 56930,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 57830,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 58910,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "그래서 선풍기를 틀고 살고 있습니다"
    } ]
  }, {
    "tStartMs": 61160,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "아 그러시구나"
    } ]
  }, {
    "tStartMs": 63140,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "저도 아침에 너무 더워가지고 낮에는 저는 에어컨 그냥 틀어버려요"
    } ]
  }, {
    "tStartMs": 67640,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "아 좋죠"
    } ]
  }, {
    "tStartMs": 69430,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "네 그래서 수영하기 딱 좋은 날씨일 것 같은데"
    } ]
  }, {
    "tStartMs": 72970,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "우선은 수영에 대해서 본격적으로 이야기하기 전에"
    } ]
  }, {
    "tStartMs": 76190,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "저번주 퀴즈 정답 알려드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 79370,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "저번주 퀴즈는 '태웅쌤이랑 디디가 자주 해먹는 요리가 아닌 것은?' 이었습니다"
    } ]
  }, {
    "tStartMs": 85570,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "그래서 정답은 1번 국수였어요"
    } ]
  }, {
    "tStartMs": 89130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "국수는 잘 해먹지 않습니다"
    } ]
  }, {
    "tStartMs": 91470,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "자, 정답 맞춰주신 분들 다들 축하드리고요"
    } ]
  }, {
    "tStartMs": 94580,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "그러면 이제 오늘도 마지막까지 들어주시면 퀴즈 있으니까"
    } ]
  }, {
    "tStartMs": 98490,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "다들 끝까지 들어주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 102270,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "수영, 요즘은 어때요?"
    } ]
  }, {
    "tStartMs": 104050,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "태웅쌤 바쁜 거 좀 덜 한데, 덜 하실 것 같은데"
    } ]
  }, {
    "tStartMs": 108260,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "수영 다니시나요?"
    } ]
  }, {
    "tStartMs": 111170,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "다시 바빠져서요"
    } ]
  }, {
    "tStartMs": 112390,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "아 그렇군요 끊임없군요"
    } ]
  }, {
    "tStartMs": 115620,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 117300,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "아 근데 요즘 많이 생각나요 좀 수영하러 가고 싶어요"
    } ]
  }, {
    "tStartMs": 121090,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "날씨도 특히 더우니까 너무 좋잖아요 수영하기"
    } ]
  }, {
    "tStartMs": 125410,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 127790,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "왜, 어떻게 안 돼요?"
    } ]
  }, {
    "tStartMs": 130090,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "제가 요즘 오전 라이브를 시작해서"
    } ]
  }, {
    "tStartMs": 135600,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 136450,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "요즘에 평일에 거의 매일 \u003cComprehensible Input Korean\u003e에서"
    } ]
  }, {
    "tStartMs": 141000,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "라이브를 다시 하고 있거든요"
    } ]
  }, {
    "tStartMs": 142990,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "매일?"
    } ]
  }, {
    "tStartMs": 144190,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "거의 매일 평일에"
    } ]
  }, {
    "tStartMs": 147580,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "그래서 시간을 좀 내서 가기가 어려워졌습니다"
    } ]
  }, {
    "tStartMs": 152070,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이럴 수가 이럴 수가"
    } ]
  }, {
    "tStartMs": 154300,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "그럼 여전히 산책 정도 하고 계시나요?"
    } ]
  }, {
    "tStartMs": 157540,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "아침에 산책하고 달리기 하고"
    } ]
  }, {
    "tStartMs": 160440,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "또 저녁에 산책하죠"
    } ]
  }, {
    "tStartMs": 161930,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "그걸 수영으로 바꿔보면 어때요?"
    } ]
  }, {
    "tStartMs": 164600,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "수영장이 집에서 좀 멀어요"
    } ]
  }, {
    "tStartMs": 166560,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "아, 더 시간이 걸리는구나"
    } ]
  }, {
    "tStartMs": 169500,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 171490,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "얼마나 가야 되는데요?"
    } ]
  }, {
    "tStartMs": 174060,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "버스 타고 가면 한 2, 30분?"
    } ]
  }, {
    "tStartMs": 177140,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "어머나"
    } ]
  }, {
    "tStartMs": 178370,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "이거 문제예요 맞아 수영장이 잘 없어 동네에"
    } ]
  }, {
    "tStartMs": 182910,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 184890,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "그래서 가기가 힘들구나 그러면 옛날에는 어느 정도 다니신 거예요?"
    } ]
  }, {
    "tStartMs": 190220,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "많이 하셨을 때"
    } ]
  }, {
    "tStartMs": 192030,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "많이, 오래 다니진 않았고 한 두 달 정도 다녔는데"
    } ]
  }, {
    "tStartMs": 196290,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그때는 일주일에 4번 갔어요"
    } ]
  }, {
    "tStartMs": 198140,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "우와 장난 아니다"
    } ]
  }, {
    "tStartMs": 201210,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "완전 빠졌었네요"
    } ]
  }, {
    "tStartMs": 203010,
    "dDurationMs": 5750,
    "segs": [ {
      "utf8": "아니요 그... 어 그렇죠 기초반 수강을 신청해서"
    } ]
  }, {
    "tStartMs": 208760,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "제가 아무것도 모르는 상태에서 등록해서 수업을 들었는데"
    } ]
  }, {
    "tStartMs": 214460,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "그 수업이 있는 날이 일주일에 4번이었거든요"
    } ]
  }, {
    "tStartMs": 218750,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "그게 화수목금"
    } ]
  }, {
    "tStartMs": 221090,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "그래서 그거를 매일 갔죠"
    } ]
  }, {
    "tStartMs": 223400,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "우와, 되게 빡세게 가르쳐준다"
    } ]
  }, {
    "tStartMs": 227330,
    "dDurationMs": 6690,
    "segs": [ {
      "utf8": "그런데 거기가 해운대 구에서 하는 수영장이었거든요"
    } ]
  }, {
    "tStartMs": 234020,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그런 게 보통 많죠"
    } ]
  }, {
    "tStartMs": 235710,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "그렇죠 근데 레인이 여러 개가 있잖아요 수영하는 줄이"
    } ]
  }, {
    "tStartMs": 241750,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "그러면 제일 왼쪽에 있는 레인 3개가 기초반"
    } ]
  }, {
    "tStartMs": 247490,
    "dDurationMs": 6580,
    "segs": [ {
      "utf8": "또 중간에 3개가 중급반, 오른쪽 3개가 고급반 이랬는데"
    } ]
  }, {
    "tStartMs": 254070,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "기초반도 레벨 1, 2, 3이 있는 건데"
    } ]
  }, {
    "tStartMs": 257310,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "반마다 학생이 한 10명, 15명 됐거든요"
    } ]
  }, {
    "tStartMs": 261590,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "선생님이 한 명밖에 없어요"
    } ]
  }, {
    "tStartMs": 263130,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "에?"
    } ]
  }, {
    "tStartMs": 266050,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "한 반에 몇 명 정도인데요? 레인에?"
    } ]
  }, {
    "tStartMs": 268700,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "한 10명?"
    } ]
  }, {
    "tStartMs": 271740,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "10명보다 많을 때도 있었고 그러면 적어도 30명 정도 되는데"
    } ]
  }, {
    "tStartMs": 277080,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "선생님이 한 명이니까 \"뭐 자유형 이렇게 이렇게 하는 겁니다\""
    } ]
  }, {
    "tStartMs": 281020,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "\"몇 바퀴 도세요\" 이렇게 하고 다음 레인으로 가요"
    } ]
  }, {
    "tStartMs": 284120,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "아~ 완전 가성비 그거네요? 가성비 느낌이네요?"
    } ]
  }, {
    "tStartMs": 288200,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "네 네"
    } ]
  }, {
    "tStartMs": 289050,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "음 보통은 한 레인에 한 선생님 계시는데 한 분"
    } ]
  }, {
    "tStartMs": 293880,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 294550,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "세 레인까지는 못 본 것 같아요"
    } ]
  }, {
    "tStartMs": 297820,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "그래서 뭐 선생님이 안 계시니까"
    } ]
  }, {
    "tStartMs": 301610,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "그냥 이렇게 하다가 좀 서 있다가..."
    } ]
  }, {
    "tStartMs": 304920,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "하다가... 좀 두리번 두리번 거리다가"
    } ]
  }, {
    "tStartMs": 309100,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "그러니까 좀 그렇게 힘들지 않았죠"
    } ]
  }, {
    "tStartMs": 311440,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "거의 자유수영인데"
    } ]
  }, {
    "tStartMs": 312930,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "그냥 한 분 감독하시는 분이 한 분 계신 느낌?"
    } ]
  }, {
    "tStartMs": 317730,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 319660,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "근데 초급일 때는 확실히 배우는 게 좋은데"
    } ]
  }, {
    "tStartMs": 323740,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "그런 것 같아요"
    } ]
  }, {
    "tStartMs": 326830,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "그래서 제가 제대로 배우지 못했습니다"
    } ]
  }, {
    "tStartMs": 329700,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "아예 못하셨어요? 원래는 수영을?"
    } ]
  }, {
    "tStartMs": 332250,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 332990,
    "dDurationMs": 7140,
    "segs": [ {
      "utf8": "아~ 이게 뭔가 주변에 바다가 많은 나라에 계신 분들을 보면"
    } ]
  }, {
    "tStartMs": 340130,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "필수로 배우더라고요 수영을"
    } ]
  }, {
    "tStartMs": 342990,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 343430,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "초등학교 때부터 뭐 일본 같은 경우도 자연재해가 많으니까"
    } ]
  }, {
    "tStartMs": 347740,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "수영이 초등학교 때 꼭 배우는 스포츠라고 하는데 한국은 아니잖아요"
    } ]
  }, {
    "tStartMs": 353300,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 355030,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "그래서 태웅쌤도 못하시는구나 못하셨구나"
    } ]
  }, {
    "tStartMs": 358430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "저 부산에서 태어났는데..."
    } ]
  }, {
    "tStartMs": 360320,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그러니까..."
    } ]
  }, {
    "tStartMs": 361660,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "부산 뭐해?"
    } ]
  }, {
    "tStartMs": 363550,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그거 필수해야 되는 거 아니에요?"
    } ]
  }, {
    "tStartMs": 365440,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "아니 근데 제가 초등학교를 부산에서 거의 안 다녔어요"
    } ]
  }, {
    "tStartMs": 368540,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "바다가 없는 충청북도에서 다녔거든요"
    } ]
  }, {
    "tStartMs": 372070,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "이사 많이 다니셨죠?"
    } ]
  }, {
    "tStartMs": 373360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 374620,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "주변에 부산 분들 보면 어때요? 초등학교 때 배운 분들이 계신가요?"
    } ]
  }, {
    "tStartMs": 379950,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "근데 저 말고는 다들 그냥 할 수 있는 것 같더라고요"
    } ]
  }, {
    "tStartMs": 385040,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "아..."
    } ]
  }, {
    "tStartMs": 386910,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "저는 어렸을 때 배웠어요 그 센터 같은 데 가서"
    } ]
  }, {
    "tStartMs": 391510,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "배워서 할 수 있는데"
    } ]
  }, {
    "tStartMs": 393220,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "은근 못하는 친구들 많아요 전 주변에"
    } ]
  }, {
    "tStartMs": 396280,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 397120,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 399400,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "저도 정말 못하는 채로 그렇게 오랜 시간을 살았는데"
    } ]
  }, {
    "tStartMs": 403870,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "배우고 보니까 너무 좋은 거 같아요"
    } ]
  }, {
    "tStartMs": 406950,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "어떤 게 좋으셨어요? 수영에서 느낀 매력?"
    } ]
  }, {
    "tStartMs": 410710,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "일단 그냥 재밌어요"
    } ]
  }, {
    "tStartMs": 412680,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "수영하는 거 자체가 재밌지 않아요?"
    } ]
  }, {
    "tStartMs": 414180,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "그냥 물에 이렇게 떠 있고 내가 나아가고 이런 과정이요?"
    } ]
  }, {
    "tStartMs": 420000,
    "dDurationMs": 7970,
    "segs": [ {
      "utf8": "그게 그러니까 우리가 일상생활 하면서 할 수 없는 자세들이잖아요"
    } ]
  }, {
    "tStartMs": 427970,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 430530,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "이렇게 막 하는데 이렇게..."
    } ]
  }, {
    "tStartMs": 432430,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "떠있고..."
    } ]
  }, {
    "tStartMs": 433850,
    "dDurationMs": 6290,
    "segs": [ {
      "utf8": "네 그러니까 몸이 더 다양한 동작을 하는 거잖아요"
    } ]
  }, {
    "tStartMs": 440140,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "그거 자체가 몸이 좀 재밌어하는 것 같은 느낌이 있어요"
    } ]
  }, {
    "tStartMs": 444270,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "음~ 동작들이 재밌군요"
    } ]
  }, {
    "tStartMs": 448450,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "그렇지 않아요?"
    } ]
  }, {
    "tStartMs": 449820,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "저는 수영 막 재밌다고 느끼진 못했어요"
    } ]
  }, {
    "tStartMs": 454400,
    "dDurationMs": 6110,
    "segs": [ {
      "utf8": "왜냐하면 좀 지루한 편이에요 러닝처럼 반복, 반복이니까"
    } ]
  }, {
    "tStartMs": 460510,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그렇구나"
    } ]
  }, {
    "tStartMs": 461700,
    "dDurationMs": 6740,
    "segs": [ {
      "utf8": "클라이밍처럼 재밌게 머리를 써가면서 하는 느낌은 아니지만"
    } ]
  }, {
    "tStartMs": 468440,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "저는 수영이 몸에 좋다고 들어가지고 좋아요"
    } ]
  }, {
    "tStartMs": 472370,
    "dDurationMs": 6130,
    "segs": [ {
      "utf8": "근육도 안 다치고 무릎도 안 다치고 되게 좋다고 하잖아요"
    } ]
  }, {
    "tStartMs": 478500,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "그게 저랑 디디님의 차이가"
    } ]
  }, {
    "tStartMs": 482230,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "저는 한창 배우기만 해서 그랬던 것 같네요"
    } ]
  }, {
    "tStartMs": 485700,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "아~ 성장하는 걸 느끼니까"
    } ]
  }, {
    "tStartMs": 489920,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "그렇죠 몰랐던 동작들을 하니까"
    } ]
  }, {
    "tStartMs": 492060,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "아 재밌었겠다"
    } ]
  }, {
    "tStartMs": 493590,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 495210,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "근데 이제 다 할 줄 아는데 그걸 그냥 하기만 하는 거는"
    } ]
  }, {
    "tStartMs": 499650,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "제가 느끼는 재미랑은 또 다를 수도 있겠네요"
    } ]
  }, {
    "tStartMs": 501810,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "그랬겠네요"
    } ]
  }, {
    "tStartMs": 503090,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "물에서 앞으로 못 나갔는데 옛날에는 그걸 배우니까 재밌었겠네요"
    } ]
  }, {
    "tStartMs": 508270,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 509950,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "처음 가면 발차기부터 배우잖아요"
    } ]
  }, {
    "tStartMs": 512820,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 514060,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "그래도 자유형까지 배우신 거예요? 한 몇 달 동안?"
    } ]
  }, {
    "tStartMs": 517910,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "자유형하고 배영 배웠어요"
    } ]
  }, {
    "tStartMs": 519820,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "아~ 오~"
    } ]
  }, {
    "tStartMs": 522910,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "둘 다 아직 아주 잘하진 못하는데"
    } ]
  }, {
    "tStartMs": 525250,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "그래도 조금은 이제 하게 됐습니다"
    } ]
  }, {
    "tStartMs": 527800,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "그것만 있어도 바다에서 살아남을 수 있죠"
    } ]
  }, {
    "tStartMs": 530530,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 531120,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "사실 떠오를 수만 있어도"
    } ]
  }, {
    "tStartMs": 532990,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 534180,
    "dDurationMs": 6010,
    "segs": [ {
      "utf8": "저는 네 가지 '자유형', '배영' 그리고 버터플라이가 '접영'"
    } ]
  }, {
    "tStartMs": 540190,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "그리고 개구리같이 하는 게 '평영'인데"
    } ]
  }, {
    "tStartMs": 543630,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "접영이 아직도 힘들어요 잘 못해요"
    } ]
  }, {
    "tStartMs": 546910,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그게 제일 힘든 자세라고 하던데"
    } ]
  }, {
    "tStartMs": 549080,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "맞아요 맞아요 그냥 생각해봐도"
    } ]
  }, {
    "tStartMs": 552680,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "땅바닥에서 해도 어려운... 힘이 필요하잖아요"
    } ]
  }, {
    "tStartMs": 557900,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "몸을 이렇게 들어올리고 하는"
    } ]
  }, {
    "tStartMs": 560030,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 562940,
    "dDurationMs": 8810,
    "segs": [ {
      "utf8": "그렇게 레인에서 한 명 한 명 시작을 하잖아요"
    } ]
  }, {
    "tStartMs": 571750,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "근데 딱 선생님이 모아놓고 조금 배우신... 좀 배웠던 학생들한테는"
    } ]
  }, {
    "tStartMs": 578470,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "이제 그 접영 동작을 막 가르쳐주고"
    } ]
  }, {
    "tStartMs": 584270,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "'이렇게 이렇게 하는 겁니다'"
    } ]
  }, {
    "tStartMs": 585720,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "'이렇게 해서 출발하세요' 이렇게 하고"
    } ]
  }, {
    "tStartMs": 589570,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "다들 출발할 때만 그 동작을 봐주시거든요"
    } ]
  }, {
    "tStartMs": 593820,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "그러면 이제 저는 저는 마지막 차례가 되면"
    } ]
  }, {
    "tStartMs": 598290,
    "dDurationMs": 5650,
    "segs": [ {
      "utf8": "이제 제가 '회원님은 자유형으로 갔다 오세요' 이렇게 하고"
    } ]
  }, {
    "tStartMs": 603940,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "그럼 이제 그렇게 하는데 이제 한 두 달 정도 돼가지고"
    } ]
  }, {
    "tStartMs": 607740,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "자유형 이제 좀 할 수 있게 되니까"
    } ]
  }, {
    "tStartMs": 610590,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "이제 다들 평영으로 푹 쏴악 이렇게 시작하는데"
    } ]
  }, {
    "tStartMs": 613900,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "저도 갑자기 이렇게 쏴악... 저도 그렇게 쏴악 들어가요 그럼"
    } ]
  }, {
    "tStartMs": 618250,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "그리고 푸하 일어나서"
    } ]
  }, {
    "tStartMs": 620960,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "그럼 선생님 뭐 하냐고..."
    } ]
  }, {
    "tStartMs": 623640,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그냥 해보고 싶었던 거죠?"
    } ]
  }, {
    "tStartMs": 625300,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "네ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 627220,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "아니 근데 아무튼 재밌어 보이더라고요"
    } ]
  }, {
    "tStartMs": 629070,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "하면 되죠"
    } ]
  }, {
    "tStartMs": 630140,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 631040,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "처음에 시작할 때 약간 다이빙해서 한참 가다가"
    } ]
  }, {
    "tStartMs": 635000,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "이렇게 올라가서 시작하시잖아요"
    } ]
  }, {
    "tStartMs": 637440,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그런 거 하셨어요?"
    } ]
  }, {
    "tStartMs": 638780,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "아니요"
    } ]
  }, {
    "tStartMs": 640440,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "이게 좀 올라가야 하는구나"
    } ]
  }, {
    "tStartMs": 642190,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 644450,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "그럼 마스터할 때까지 배우면 좋겠는데요 이왕 시작한 거"
    } ]
  }, {
    "tStartMs": 649050,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 651550,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "근데 이게 호락호락하지 않습니다"
    } ]
  }, {
    "tStartMs": 654870,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "저에게는 3개의 유튜브 채널과"
    } ]
  }, {
    "tStartMs": 659410,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "준비하고 있는 수업이 있기 때문에..."
    } ]
  }, {
    "tStartMs": 663170,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "진짜 바쁘시죠"
    } ]
  }, {
    "tStartMs": 664630,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그렇네요"
    } ]
  }, {
    "tStartMs": 665580,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "그러면 시간이 나시면 바로 수영 다시 배우실 생각이에요?"
    } ]
  }, {
    "tStartMs": 670580,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "조건이 된다면?"
    } ]
  }, {
    "tStartMs": 673270,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "몇 달 하셨다고 했죠?"
    } ]
  }, {
    "tStartMs": 675290,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "두 달이요"
    } ]
  }, {
    "tStartMs": 676020,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "두 달"
    } ]
  }, {
    "tStartMs": 677350,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "두 달 동안 뭐 있었나요?"
    } ]
  }, {
    "tStartMs": 679930,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "에피소드 같은 거 기억나는 거"
    } ]
  }, {
    "tStartMs": 682560,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "특별한 에피소드는 없었고"
    } ]
  }, {
    "tStartMs": 684940,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "아 그래 수영장 문화를 우리가 얘기하면 좋을 것 같다고 생각을 했는데"
    } ]
  }, {
    "tStartMs": 689440,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "이게 다른 나라에는 없는 것 같던데"
    } ]
  }, {
    "tStartMs": 694490,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "기초반 레인이 3개가 있다고 했잖아요"
    } ]
  }, {
    "tStartMs": 697530,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "그러면 수영 레슨을 1시간 쫙 하고 나면 끝날 때가 돼서"
    } ]
  }, {
    "tStartMs": 704100,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "기초반 레인 3개의 사람들이"
    } ]
  }, {
    "tStartMs": 706880,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "삥 동그라미로 수영장 물 안에서"
    } ]
  }, {
    "tStartMs": 712440,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "동그라미로 다 서요 원을 만들어서"
    } ]
  }, {
    "tStartMs": 715950,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "옆에 사람들이 쫙 있는 거죠 이렇게"
    } ]
  }, {
    "tStartMs": 718540,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "마지막에 선생님이 '오늘도 수고 많으셨고 내일 봅시다'"
    } ]
  }, {
    "tStartMs": 722950,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "아니면 '다음 주에 봅시다' 이렇게 하면 '화이팅' 이렇게 하거든요"
    } ]
  }, {
    "tStartMs": 726980,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "그러면은... 아무튼 그렇게 하는데"
    } ]
  }, {
    "tStartMs": 730400,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "저는 '이게 끝나는 인사인가 보다' 이렇게 생각을 했어요 첫날에"
    } ]
  }, {
    "tStartMs": 734460,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "첫날에 그렇게 생각을 했는데"
    } ]
  }, {
    "tStartMs": 736610,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "옆에 어떤 남자분이 계셨는데"
    } ]
  }, {
    "tStartMs": 740010,
    "dDurationMs": 7320,
    "segs": [ {
      "utf8": "그 남자분이 물 밑에서 제 손을 잡는 거예요"
    } ]
  }, {
    "tStartMs": 747330,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "그래가지고... 어 뭐지 나랑 친해지고 싶나?"
    } ]
  }, {
    "tStartMs": 750680,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "이렇게 생각을 해서..."
    } ]
  }, {
    "tStartMs": 752450,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "어 이게 무슨 의미지?"
    } ]
  }, {
    "tStartMs": 754200,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "ㄴ...나랑 친해지고 싶나?"
    } ]
  }, {
    "tStartMs": 756570,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "손을 딱 잡았어요"
    } ]
  }, {
    "tStartMs": 757750,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "악수인가? 네"
    } ]
  }, {
    "tStartMs": 759300,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 760490,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "그리고 저는 그냥 밑에서 잡고 있었거든요(?)"
    } ]
  }, {
    "tStartMs": 764900,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "꼬옥❤️"
    } ]
  }, {
    "tStartMs": 765880,
    "dDurationMs": 6130,
    "segs": [ {
      "utf8": "근데 이제 갑자기 다른 사람들이 손을 이렇게 올리는 거예요"
    } ]
  }, {
    "tStartMs": 772010,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "근데 저는 아무것도 몰랐으니까"
    } ]
  }, {
    "tStartMs": 774210,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "그래서 '뭐지?' 이렇게 했는데"
    } ]
  }, {
    "tStartMs": 775240,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "그때 옆에 남자분이 우리 마칠 때는 다 같이 손잡고 이렇게 화이팅 하고"
    } ]
  }, {
    "tStartMs": 781120,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "만세를 하면서 만세를 하면서 '수고하셨습니다'"
    } ]
  }, {
    "tStartMs": 784510,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "이렇게 하고 끝낸다고 하더라고요"
    } ]
  }, {
    "tStartMs": 786440,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그게 무슨 문화예요?"
    } ]
  }, {
    "tStartMs": 787330,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "부산 문화 아니에요? 처음 들어요"
    } ]
  }, {
    "tStartMs": 789920,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "그거 다른 수영장들에도 수업 시간에 있을걸요?"
    } ]
  }, {
    "tStartMs": 794310,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "그랬나?"
    } ]
  }, {
    "tStartMs": 796000,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "너무 어릴 때 배운 거라..."
    } ]
  }, {
    "tStartMs": 799090,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "있을 거예요 아마"
    } ]
  }, {
    "tStartMs": 800410,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "에? 그게 수영 인사 문화라고요?"
    } ]
  }, {
    "tStartMs": 803260,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 806050,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "오호..."
    } ]
  }, {
    "tStartMs": 809020,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그러니까 진짜 놀랐어요"
    } ]
  }, {
    "tStartMs": 810320,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "근데 그 첫날에 제 반대쪽에 있던 아주머님은"
    } ]
  }, {
    "tStartMs": 814610,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "좀 부끄러우셨던지 손을 안 잡으셨어요"
    } ]
  }, {
    "tStartMs": 818220,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "아하 내외하시는..."
    } ]
  }, {
    "tStartMs": 820520,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "그래서 제가 헷갈렸던 거죠"
    } ]
  }, {
    "tStartMs": 822160,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "아, 한 명만 손을 잡으니까?"
    } ]
  }, {
    "tStartMs": 826880,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "아, 웃기다"
    } ]
  }, {
    "tStartMs": 828620,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 830590,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "그분은 그럼 옆에 분이랑 그냥 화이팅 하신 건가?"
    } ]
  }, {
    "tStartMs": 833300,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "뭐 안 하는 분도 있겠죠? 좀 창피하면?"
    } ]
  }, {
    "tStartMs": 836150,
    "dDurationMs": 7460,
    "segs": [ {
      "utf8": "아니 다 했는데 그분만 ...좀 수줍어 하셨던 것 같아요"
    } ]
  }, {
    "tStartMs": 843610,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "신기하다 시작할 때는 뭐 없었어요?"
    } ]
  }, {
    "tStartMs": 846720,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "시작할 때는 없었죠"
    } ]
  }, {
    "tStartMs": 848810,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "아 그냥 뭐 준비운동"
    } ]
  }, {
    "tStartMs": 849840,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "준비운동?"
    } ]
  }, {
    "tStartMs": 851640,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "물 안에서 해요? 물 밖에서 해요?"
    } ]
  }, {
    "tStartMs": 853820,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "그게 안에서 하는 사람도 있고 옆에 밖에서 하는 사람도 있어요"
    } ]
  }, {
    "tStartMs": 858330,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "원하는 대로 하나요?"
    } ]
  }, {
    "tStartMs": 859810,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 860930,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "준비운동하고 마무리 인사를 파이팅 있게 그렇게 하는구나"
    } ]
  }, {
    "tStartMs": 865380,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 865940,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "웃기다"
    } ]
  }, {
    "tStartMs": 867230,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 869410,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "왜 그럴까요? 약간 친해지겠다, 그래도"
    } ]
  }, {
    "tStartMs": 873090,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그런 건가 싶기도 하고"
    } ]
  }, {
    "tStartMs": 874820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 876680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "왠지는 모르겠지만 근데 되게 훈훈했어요"
    } ]
  }, {
    "tStartMs": 879560,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 881050,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "뭔가 함께하는 스포츠 느낌?"
    } ]
  }, {
    "tStartMs": 882850,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 883990,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "그런 인사 문화가 있구나"
    } ]
  }, {
    "tStartMs": 886370,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 887520,
    "dDurationMs": 7460,
    "segs": [ {
      "utf8": "어... 뭔가 남자 탈의실이 있을 거고 여자 탈의실이 있잖아요"
    } ]
  }, {
    "tStartMs": 894980,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "주의해야 될 거나 에티켓 같은 거 혹시 생각나는 거 있나요?"
    } ]
  }, {
    "tStartMs": 899470,
    "dDurationMs": 6180,
    "segs": [ {
      "utf8": "이것도 한국이 좀 강하게 지키는 문화라고 들었는데"
    } ]
  }, {
    "tStartMs": 905650,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "샤워실에 들어갔다가 수영장에 들어가잖아요"
    } ]
  }, {
    "tStartMs": 910750,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "근데 그때 샤워할 때 그 무조건 샴푸를 팍팍 쓰고"
    } ]
  }, {
    "tStartMs": 916000,
    "dDurationMs": 5390,
    "segs": [ {
      "utf8": "비누로 몸을 씻고 들어가야 한다고 얘기하는 사람들이 많은 것 같더라고요"
    } ]
  }, {
    "tStartMs": 921390,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "응 저도 맞아요"
    } ]
  }, {
    "tStartMs": 923100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "목욕탕 갈 때도 똑같은데 수영장 수업할 때도"
    } ]
  }, {
    "tStartMs": 927300,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "아니면 혼자 수영할 때도 집에서 샤워하듯이 그렇게 싹 씻고"
    } ]
  }, {
    "tStartMs": 931800,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "깨끗한 몸으로 수영복을 입고 들어가야 돼요"
    } ]
  }, {
    "tStartMs": 935670,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "그러니까요 그냥 물로만 대충 헹구고 하면 안 된다고 하더라고요?"
    } ]
  }, {
    "tStartMs": 939100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그거 얘기하시는 분도 있대요"
    } ]
  }, {
    "tStartMs": 940700,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "\"아 샤워하고 들어가셔야 돼요\" 이렇게"
    } ]
  }, {
    "tStartMs": 943470,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "아 진짜요?"
    } ]
  }, {
    "tStartMs": 944200,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "응응응"
    } ]
  }, {
    "tStartMs": 945230,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "아~"
    } ]
  }, {
    "tStartMs": 946710,
    "dDurationMs": 7630,
    "segs": [ {
      "utf8": "뭔가 다른 회원님들, 다른 수영장 이용하시는 분들이 그렇게 얘기한대요"
    } ]
  }, {
    "tStartMs": 954340,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "저는 직접 듣거나 본 적은 없는데... 근데 그렇게 하나?"
    } ]
  }, {
    "tStartMs": 960380,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "제가 다녔던 수영장은 좀 자유로웠던 것 같아요 근데"
    } ]
  }, {
    "tStartMs": 963300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "음~ 그냥 마이웨이?"
    } ]
  }, {
    "tStartMs": 966000,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 967280,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "깨끗하게 하고 가면 좋죠 관리해야 되니까"
    } ]
  }, {
    "tStartMs": 972790,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그런 것도 있고"
    } ]
  }, {
    "tStartMs": 973850,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "또 저는 특이한 게 한국 수영장은 꼭 수모 써야 되잖아요"
    } ]
  }, {
    "tStartMs": 978850,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 979950,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "수모를 꼭 써야 됩니다"
    } ]
  }, {
    "tStartMs": 981700,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "그거는 전 당연히 꼭 지켜져야 할 문화라고 생각합니다"
    } ]
  }, {
    "tStartMs": 987340,
    "dDurationMs": 5810,
    "segs": [ {
      "utf8": "저 유럽 분들이랑 얘기해보면 근데 수모 필수 아니라고 하더라고요"
    } ]
  }, {
    "tStartMs": 993150,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "아 근데 그러면 머리카락이 빠지지 않아요?"
    } ]
  }, {
    "tStartMs": 997480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "약간 생각하기 나름인 것 같아요"
    } ]
  }, {
    "tStartMs": 1000180,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "우리는 그게 익숙하니까"
    } ]
  }, {
    "tStartMs": 1002370,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1003070,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "근데 뭐 해변에 가도 그렇고"
    } ]
  }, {
    "tStartMs": 1005210,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "약간 머리 풀고 수영하는 그런 문화가 있으니까"
    } ]
  }, {
    "tStartMs": 1010590,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "다른가 봐요"
    } ]
  }, {
    "tStartMs": 1012110,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "해변이나 강은 괜찮다고 생각하거든요"
    } ]
  }, {
    "tStartMs": 1014430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "그거 맞아요"
    } ]
  }, {
    "tStartMs": 1016320,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "엄청 넓으니까"
    } ]
  }, {
    "tStartMs": 1017150,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "자연으로 보내니까"
    } ]
  }, {
    "tStartMs": 1018890,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "네 근데 수영장은 그 공간이 좁잖아요"
    } ]
  }, {
    "tStartMs": 1022420,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "한정되어 있잖아요"
    } ]
  }, {
    "tStartMs": 1023140,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "그쵸 그쵸"
    } ]
  }, {
    "tStartMs": 1024380,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "근데 여기서 막 이렇게 하고 있는데"
    } ]
  }, {
    "tStartMs": 1026270,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "머리 이렇게 막..."
    } ]
  }, {
    "tStartMs": 1028470,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "옆 사람한테 가고..."
    } ]
  }, {
    "tStartMs": 1030200,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1031140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "아, 그러게요"
    } ]
  }, {
    "tStartMs": 1033120,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "이렇게 막 (수영)하는데 이렇게 막..."
    } ]
  }, {
    "tStartMs": 1036870,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "머리카락 이렇게 딱 끼고..."
    } ]
  }, {
    "tStartMs": 1037820,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "비위생적이죠"
    } ]
  }, {
    "tStartMs": 1039170,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 1039980,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "맞아"
    } ]
  }, {
    "tStartMs": 1042510,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "수모 꼭 써야 되고"
    } ]
  }, {
    "tStartMs": 1044330,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "수영복도 비키니 입으면 안 되지 않아요?"
    } ]
  }, {
    "tStartMs": 1048900,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "안 된다고 해야 되나? 아무도 안 입어요 비키니"
    } ]
  }, {
    "tStartMs": 1052070,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "아무도 안 입죠"
    } ]
  }, {
    "tStartMs": 1053150,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "그 수영 레슨을 위한 옷이 있어요"
    } ]
  }, {
    "tStartMs": 1055940,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "남자도 그렇고 여자도 그런 것 같아요"
    } ]
  }, {
    "tStartMs": 1058080,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "그 올림픽 경기 뭐 이런 때 선수들이 입는 그런 수영복"
    } ]
  }, {
    "tStartMs": 1062230,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "맞아요 스포츠 수영복이 있어가지고"
    } ]
  }, {
    "tStartMs": 1066750,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "그래서 저는 그 수영복 입었을 때 별로 기분이 안 좋아요"
    } ]
  }, {
    "tStartMs": 1070590,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "왜요?"
    } ]
  }, {
    "tStartMs": 1071710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "약간... 마음에 안 들어요"
    } ]
  }, {
    "tStartMs": 1074230,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "머리는 이렇게 다 해가지고 이렇게 완전 못생겨지고"
    } ]
  }, {
    "tStartMs": 1078830,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "딱 이렇게 이거 들리잖아요"
    } ]
  }, {
    "tStartMs": 1080940,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "여기 들리고 여기 자국 나고"
    } ]
  }, {
    "tStartMs": 1083360,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "이거 안경도 써야 되잖아요"
    } ]
  }, {
    "tStartMs": 1085730,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1086190,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "여기도 자국 나고..."
    } ]
  }, {
    "tStartMs": 1087260,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "자국 남고"
    } ]
  }, {
    "tStartMs": 1089150,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "맞아요 옷도 막 다 뭐라고 해야 될까"
    } ]
  }, {
    "tStartMs": 1093070,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "엄청난 노출을 하고 입어야 되고 약간 불편한 느낌?"
    } ]
  }, {
    "tStartMs": 1097850,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "그렇죠 불편하죠"
    } ]
  }, {
    "tStartMs": 1098780,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "근데 아니 여자분들은 그래도 좀 가리는 부분이 많잖아요"
    } ]
  }, {
    "tStartMs": 1105500,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1106370,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "남자들은 그냥 뭐 팬티나 다름없는 짧은 그냥 수영장 바지..."
    } ]
  }, {
    "tStartMs": 1112390,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "아 그러네 그거 더 싫겠다"
    } ]
  }, {
    "tStartMs": 1114780,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "네 그래서 처음 진짜 첫날에는 진짜 민망했어요"
    } ]
  }, {
    "tStartMs": 1120360,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그렇겠다"
    } ]
  }, {
    "tStartMs": 1122090,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "이렇게 막 (가리고...)"
    } ]
  }, {
    "tStartMs": 1123180,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "절대로 아는 사람 마주치고 싶지 않아요 그래서 수영장에서는"
    } ]
  }, {
    "tStartMs": 1126510,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "네 괜히 막 이렇게 막 이러면서..."
    } ]
  }, {
    "tStartMs": 1129340,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "네 그것도 또 특이한 것 같네요"
    } ]
  }, {
    "tStartMs": 1132510,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "뭔가 몸을 보여줄 일이 많이 없으니까"
    } ]
  }, {
    "tStartMs": 1135020,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "아, 한국에선?"
    } ]
  }, {
    "tStartMs": 1136170,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "네, 한국에선"
    } ]
  }, {
    "tStartMs": 1141360,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "그리고 그런 얘기가 가장 많이 생각나는데"
    } ]
  }, {
    "tStartMs": 1144550,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "'수영장 텃세' 이런 거 들어보셨어요?"
    } ]
  }, {
    "tStartMs": 1147240,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "저도 인터넷으로는 많이 봤어요"
    } ]
  }, {
    "tStartMs": 1150500,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "어떤 거 보셨어요?"
    } ]
  }, {
    "tStartMs": 1152790,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "어떤 걸 봤냐면 자기가, 그러니까 어떤 사람이"
    } ]
  }, {
    "tStartMs": 1158430,
    "dDurationMs": 8290,
    "segs": [ {
      "utf8": "새로운 수영장에 가서 고급반 그러니까 잘하는 사람들이 레슨 듣는 반에 갔는데"
    } ]
  }, {
    "tStartMs": 1166720,
    "dDurationMs": 8050,
    "segs": [ {
      "utf8": "그 고급반에 있는 사람들이 우리는 이 수모, 수모 모자"
    } ]
  }, {
    "tStartMs": 1174770,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "수모를 똑같은 걸로 써야 한다"
    } ]
  }, {
    "tStartMs": 1179370,
    "dDurationMs": 9760,
    "segs": [ {
      "utf8": "그러면서 너도 이걸 사서 이걸 써라 이렇게 강제를 했다는 이야기를 들은 적이 있고요"
    } ]
  }, {
    "tStartMs": 1189130,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "인터넷에서 봤고요"
    } ]
  }, {
    "tStartMs": 1192500,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "그리고 샤워실 텃세? 그런 것도 있다고 하던데"
    } ]
  }, {
    "tStartMs": 1197190,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "그건 자세히는 모르겠어요"
    } ]
  }, {
    "tStartMs": 1198710,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "그러니까 텃세라는 게 설명해보면 좋을 것 같은데"
    } ]
  }, {
    "tStartMs": 1203380,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "이미 원래 거기 공간에 오래 있으신 분들이 새로 뉴비가 오면"
    } ]
  }, {
    "tStartMs": 1209410,
    "dDurationMs": 6970,
    "segs": [ {
      "utf8": "아 뭐야 쟤 약간 무시하고 우리들만의 문화가 있는데 그걸 따라와라"
    } ]
  }, {
    "tStartMs": 1216380,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "이렇게 좀 강요하는 그런 거라고 설명할 수 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 1220840,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "그런 게 특히나 수영장에 있다고 하더라고요"
    } ]
  }, {
    "tStartMs": 1225400,
    "dDurationMs": 8360,
    "segs": [ {
      "utf8": "제 생각에는 그게 좀 나이가 있는 분들이 모여있는 곳?"
    } ]
  }, {
    "tStartMs": 1233760,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "그런 데에 좀 텃세가 많이 있는 것 같아요"
    } ]
  }, {
    "tStartMs": 1236380,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "아, 좀 옛날의 어떤 문화가 남아있는 것 같아요?"
    } ]
  }, {
    "tStartMs": 1242400,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "그래서 보통 텃세, 수영장 텃세 이야기하면"
    } ]
  }, {
    "tStartMs": 1246060,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "오전 수영에 텃세가 많다고 얘기를 하더라고요"
    } ]
  }, {
    "tStartMs": 1250590,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "좋은 포인트네요"
    } ]
  }, {
    "tStartMs": 1251600,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "오전 수영 가면은 진짜 연령대가 높잖아요"
    } ]
  }, {
    "tStartMs": 1255510,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "특히 아주머니 분들이 많이 계세요 주부"
    } ]
  }, {
    "tStartMs": 1258750,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 1259980,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "오전반 가셨죠?"
    } ]
  }, {
    "tStartMs": 1261410,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1261980,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "아하 많았겠어요?"
    } ]
  }, {
    "tStartMs": 1264160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "아주머니들이 많았죠"
    } ]
  }, {
    "tStartMs": 1265600,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "진짜 많아요"
    } ]
  }, {
    "tStartMs": 1266330,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "저도 보통 가면은 좀 낮에 가는 편인데"
    } ]
  }, {
    "tStartMs": 1271230,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "'다 거기 오시는 거구나 여기 사는 아주머니 분들이' 싶을 정도로 많아요"
    } ]
  }, {
    "tStartMs": 1276320,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1278140,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "근데 저희 반에는 없었어요"
    } ]
  }, {
    "tStartMs": 1281660,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "초보라 그런가?"
    } ]
  }, {
    "tStartMs": 1283140,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1283870,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "이미 고수분들이구나 (- 그렇죠) 아주머니 분들은"
    } ]
  }, {
    "tStartMs": 1286990,
    "dDurationMs": 7820,
    "segs": [ {
      "utf8": "좀 할 수 있는, 잘하는 아주머니들은 이제 좀 오래 남아있는 사람들일 거고"
    } ]
  }, {
    "tStartMs": 1294810,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "그럼 이제 자기들끼리의 커뮤니티가 강해지고"
    } ]
  }, {
    "tStartMs": 1299520,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "텃세가 생기는 거죠"
    } ]
  }, {
    "tStartMs": 1300910,
    "dDurationMs": 6230,
    "segs": [ {
      "utf8": "재밌네 옛날에는 좀 그런 공동체 문화가 더 있었으니까"
    } ]
  }, {
    "tStartMs": 1307140,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그런 게 남아있나 봐요"
    } ]
  }, {
    "tStartMs": 1308820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "그런가 봅니다"
    } ]
  }, {
    "tStartMs": 1310110,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "얘기하신 탈의실, 샤워실 텃세는 제가 기억하기로는"
    } ]
  }, {
    "tStartMs": 1315070,
    "dDurationMs": 7230,
    "segs": [ {
      "utf8": "몸을 안 씻고 가면 그걸 많이 뭐라고 한다거나"
    } ]
  }, {
    "tStartMs": 1322300,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "수영장 매너를 정해놓고"
    } ]
  }, {
    "tStartMs": 1325060,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "그거를 이렇게 하라고 하시는 분들이 있다고 하셨어요"
    } ]
  }, {
    "tStartMs": 1329820,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "자경단이네요"
    } ]
  }, {
    "tStartMs": 1331140,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "네, 맞아요 정의감을 가지고"
    } ]
  }, {
    "tStartMs": 1335010,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "사적 제재"
    } ]
  }, {
    "tStartMs": 1336030,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "네, 사적 제재를 하시는 분들이 있네요"
    } ]
  }, {
    "tStartMs": 1340720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "무섭네요"
    } ]
  }, {
    "tStartMs": 1342600,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "저는 최근에 수영을 가끔 가거든요"
    } ]
  }, {
    "tStartMs": 1345880,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "일주일에 한 번이나 2주에 한 번 정도 가는데"
    } ]
  }, {
    "tStartMs": 1349520,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "그때 이런 에피소드가 한 번 있었어요 이게 텃세까지는 아닌데"
    } ]
  }, {
    "tStartMs": 1354880,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "수영장에서 수영을 다 하고 자유수영하고"
    } ]
  }, {
    "tStartMs": 1357900,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "이제 몸 씻고 수영복을 빨잖아요 거기 안에서"
    } ]
  }, {
    "tStartMs": 1362860,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "간단하게 세탁을 하고 집에 돌아가는데"
    } ]
  }, {
    "tStartMs": 1366280,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "그 빤 수영복을 물기를 짤 수 있는 그게 있어요"
    } ]
  }, {
    "tStartMs": 1371820,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "뭐라고 하죠? '통돌이'라고 하나요?"
    } ]
  }, {
    "tStartMs": 1374500,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "아 그런게 있어요?"
    } ]
  }, {
    "tStartMs": 1375370,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "'짤짤이'라고 하나? 그 수영복 물기 빼주는 기계 있지 않아요?"
    } ]
  }, {
    "tStartMs": 1381160,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "세탁기 같은 거"
    } ]
  }, {
    "tStartMs": 1382430,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "제 수영장엔 없었어요"
    } ]
  }, {
    "tStartMs": 1383810,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "아니면 여자 탈의실에만 있을 수도 있어요"
    } ]
  }, {
    "tStartMs": 1387290,
    "dDurationMs": 5570,
    "segs": [ {
      "utf8": "그래서 그거를 제가 혼자 갔으니까 혼자 이렇게 빨래를 넣고 하는데"
    } ]
  }, {
    "tStartMs": 1392860,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "안 돌아가는 거예요 그래서"
    } ]
  }, {
    "tStartMs": 1397980,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "그걸 돌려놓고 잠깐 샤워하고 왔는데"
    } ]
  }, {
    "tStartMs": 1401500,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "그거 막 뚜껑이 열려있고 그래서 뭐지 뭐지 했는데"
    } ]
  }, {
    "tStartMs": 1405840,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "다시 해봐도 안 되고"
    } ]
  }, {
    "tStartMs": 1407460,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "근데 그 옆에 어떤 여자분이 서 계셨는데"
    } ]
  }, {
    "tStartMs": 1409900,
    "dDurationMs": 6150,
    "segs": [ {
      "utf8": "그거를 되게 엄청나게 차갑게 문을 확 열어버리시는 거예요"
    } ]
  }, {
    "tStartMs": 1416050,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "그래서 '뭐지 뭐지' 했는데 계속 그냥 🙂‍↔️ 이렇게 하고"
    } ]
  }, {
    "tStartMs": 1420760,
    "dDurationMs": 6860,
    "segs": [ {
      "utf8": "얼굴을 도리도리하고 나가셔서 '약간 이런 것도 모르냐' 하는 식으로 나가서"
    } ]
  }, {
    "tStartMs": 1427620,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "내가 뭘 잘못했나 했는데 알고 보니까"
    } ]
  }, {
    "tStartMs": 1430460,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "다른 어떤 친절한 여자분이 오셔서 이게..."
    } ]
  }, {
    "tStartMs": 1434560,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "세탁량이 너무 적으면 안 돌아간다 고장날 수도 있다 라고 하시는 거예요"
    } ]
  }, {
    "tStartMs": 1439150,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "그래서 '제 거랑 같이 넣어요' 하시면서 그 수영복을 같이 돌렸었거든요"
    } ]
  }, {
    "tStartMs": 1444580,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "약간 그런 건가? 이건가?"
    } ]
  }, {
    "tStartMs": 1447320,
    "dDurationMs": 6900,
    "segs": [ {
      "utf8": "그 수영장 문화를 모르면 약간 바보가 된 느낌을 받는 이런 건가 싶었었어요"
    } ]
  }, {
    "tStartMs": 1454220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "와 진짜 꼬인 사람이네"
    } ]
  }, {
    "tStartMs": 1456770,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "약간 그런 것 같아 그냥 좀 불친절한 사람이었던 것 같아요"
    } ]
  }, {
    "tStartMs": 1461950,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "정말 어떤 인생을 살고 있을지 뻔하네요"
    } ]
  }, {
    "tStartMs": 1466090,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "행복해지길 바랍니다 저는 그녀가"
    } ]
  }, {
    "tStartMs": 1469240,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "아니요 저는 영영 불행했으면 좋겠어요 (- 아 그래요?)"
    } ]
  }, {
    "tStartMs": 1474150,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "뭔가 불행하니까 그렇게 나오는 거잖아요"
    } ]
  }, {
    "tStartMs": 1478340,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "아 그래요 마음씩 곱게 먹어야지"
    } ]
  }, {
    "tStartMs": 1482670,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "아 배웠네요 이렇게 또 친절하게 설명해주면 또 기분 좋게 배울 수 있구나 하는 것도 배우고"
    } ]
  }, {
    "tStartMs": 1489790,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그래야지 사람이"
    } ]
  }, {
    "tStartMs": 1491280,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1493290,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "아 맞아 연령대가 좀 높으니까"
    } ]
  }, {
    "tStartMs": 1496800,
    "dDurationMs": 5530,
    "segs": [ {
      "utf8": "약간 그런 인간관계 문제들이 나타나는 게 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 1502330,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "다음에 보면 \"화났어요?\" 이렇게 물어보세요"
    } ]
  }, {
    "tStartMs": 1507490,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "\"화났습니까?\""
    } ]
  }, {
    "tStartMs": 1508840,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1509890,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "맞아 맞아 그럴게요"
    } ]
  }, {
    "tStartMs": 1511740,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "네 아무튼 그리고 수영"
    } ]
  }, {
    "tStartMs": 1514030,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "아 그럼 디디님은 수영 자체에서 그렇게 재미를 느끼지는 못하는 편이시군요"
    } ]
  }, {
    "tStartMs": 1519190,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "아쉽게도..."
    } ]
  }, {
    "tStartMs": 1522890,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "근데 참 좋은 운동이 확실히 맞는 것 같아요"
    } ]
  }, {
    "tStartMs": 1527190,
    "dDurationMs": 6740,
    "segs": [ {
      "utf8": "그렇대요 어르신분들이 많이 하시는 것만 봐도 좋은 것 같고"
    } ]
  }, {
    "tStartMs": 1533930,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "진짜 힘들어요 한 10분 하면 사실 그만하고 싶어요"
    } ]
  }, {
    "tStartMs": 1538940,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "아 그렇구나"
    } ]
  }, {
    "tStartMs": 1542530,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "아, 그러니까 그 자세를 이제 잘 아니까"
    } ]
  }, {
    "tStartMs": 1547030,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "이제 계속 10분 동안 계속 쫙 갈 수 있는 거잖아요"
    } ]
  }, {
    "tStartMs": 1551580,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그래서 더 힘든가 보다"
    } ]
  }, {
    "tStartMs": 1553540,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "네, 유산소랑 근력운동을 같이 하는 느낌"
    } ]
  }, {
    "tStartMs": 1556990,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "발은 계속 움직이지, 힘도 줘야 되지"
    } ]
  }, {
    "tStartMs": 1561950,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 1563100,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "그리고 물에 안 빠지려면 어떻게든 계속 움직이게 되잖아요 런닝보다는 더"
    } ]
  }, {
    "tStartMs": 1568940,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "그래서 빨리 힘든 것 같고 이런 말도 있더라고요"
    } ]
  }, {
    "tStartMs": 1572980,
    "dDurationMs": 6380,
    "segs": [ {
      "utf8": "다이어트 할 때 수영이 도움되나요? 이런 글에 있는 답변을 보면"
    } ]
  }, {
    "tStartMs": 1579360,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "그게 쉽게 잘 안 빠진대요 근데 그 이유가"
    } ]
  }, {
    "tStartMs": 1582100,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "수영하고 나면 너무 배가 고파가지고 엄청 먹게 된대요"
    } ]
  }, {
    "tStartMs": 1586760,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 1589120,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "에너지 소모가 엄청 나서"
    } ]
  }, {
    "tStartMs": 1592420,
    "dDurationMs": 7850,
    "segs": [ {
      "utf8": "근데 그거는 다 핑계라고 생각해요 저는"
    } ]
  }, {
    "tStartMs": 1600270,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "그렇게 하고 안 먹으면 다이어트 되죠"
    } ]
  }, {
    "tStartMs": 1602060,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "당연하죠 당연하죠"
    } ]
  }, {
    "tStartMs": 1603350,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "도움 되죠"
    } ]
  }, {
    "tStartMs": 1604220,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "네 너무 좋은 운동이죠 다이어트에 사실"
    } ]
  }, {
    "tStartMs": 1607120,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "그럼요 그럼요"
    } ]
  }, {
    "tStartMs": 1610330,
    "dDurationMs": 5490,
    "segs": [ {
      "utf8": "근데 저는 와 이거 다른 팟캐스트에서도 한 번 얘기했었는데"
    } ]
  }, {
    "tStartMs": 1615820,
    "dDurationMs": 6370,
    "segs": [ {
      "utf8": "제가 진짜 수영을 잘 배웠다고 생각한 또 다른 이유가 하나 있었는데요"
    } ]
  }, {
    "tStartMs": 1622190,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1624180,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "그 수영장이 그래도 좀 넓잖아요"
    } ]
  }, {
    "tStartMs": 1628540,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "그리고 레인이 막 10개가 있고"
    } ]
  }, {
    "tStartMs": 1631510,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "그리고 레인마다 사람들이 막 한 10여 명이 10여 명이 있고"
    } ]
  }, {
    "tStartMs": 1636030,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "사람들이 되게 많은데 또 수영장 천장도 되게 높고"
    } ]
  }, {
    "tStartMs": 1639770,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "막 웅성웅성 하잖아요 (- 그렇죠) 붐비는 느낌도 들고"
    } ]
  }, {
    "tStartMs": 1644460,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "근데 제가 나이 서른이 넘어서"
    } ]
  }, {
    "tStartMs": 1648130,
    "dDurationMs": 7490,
    "segs": [ {
      "utf8": "수영을 아무것도 하나도 할 줄 모르는 사람이 이렇게 딱 갔는데"
    } ]
  }, {
    "tStartMs": 1655620,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "그 모든 레인 중에 모든 사람들 중에서"
    } ]
  }, {
    "tStartMs": 1660210,
    "dDurationMs": 6730,
    "segs": [ {
      "utf8": "가장 기초반에서 가장 수영을 모르는 사람이 저인 거예요"
    } ]
  }, {
    "tStartMs": 1666940,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "그러니까 뭐 어림잡아 100명 가까이 될 수 있는 사람들 중에"
    } ]
  }, {
    "tStartMs": 1672680,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "그리고 그 모든 사람들이 수영 하나를 하러 모여있는 사람들인데"
    } ]
  }, {
    "tStartMs": 1678020,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "그 중에 제가 제일 못하는 사람인 거예요"
    } ]
  }, {
    "tStartMs": 1681570,
    "dDurationMs": 7060,
    "segs": [ {
      "utf8": "근데 그 경험이 되게 짜릿했어요"
    } ]
  }, {
    "tStartMs": 1688630,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "오 그렇겠다 배우길 잘했다"
    } ]
  }, {
    "tStartMs": 1691900,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "진짜 신선한 경험이었어요"
    } ]
  }, {
    "tStartMs": 1695490,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "그러니까 이 수영장이 사각형이라고 생각하면"
    } ]
  }, {
    "tStartMs": 1700220,
    "dDurationMs": 6230,
    "segs": [ {
      "utf8": "왼쪽 레인이 기초반, 오른쪽 레인이 고수반 이렇게 생각하면"
    } ]
  }, {
    "tStartMs": 1706450,
    "dDurationMs": 6890,
    "segs": [ {
      "utf8": "왼쪽 레인이 기초반인데 또 여기서 또 이미 배운 사람들이 먼저 가잖아요"
    } ]
  }, {
    "tStartMs": 1713340,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "그리고 저는 꽁무니에 있고"
    } ]
  }, {
    "tStartMs": 1716420,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "그러니까 여기서 가장 못하는 구석에 있는 사람인 거죠"
    } ]
  }, {
    "tStartMs": 1720100,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1721360,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "그리고 발차기 이렇게 연습하고"
    } ]
  }, {
    "tStartMs": 1724990,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "그리고 또 첫날부터"
    } ]
  }, {
    "tStartMs": 1727170,
    "dDurationMs": 9520,
    "segs": [ {
      "utf8": "그 이제 물에 뜨는 연습을 해보라고 이 킥판, 이 보드 이것도 안 잡고"
    } ]
  }, {
    "tStartMs": 1736690,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "그냥 그냥 앞으로 걸어가면서 팔을 뻗어서 만세하고 '엎드려 보세요'"
    } ]
  }, {
    "tStartMs": 1742930,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "이렇게 하는 거예요"
    } ]
  }, {
    "tStartMs": 1745410,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "물에 뜨는 연습을 하려고"
    } ]
  }, {
    "tStartMs": 1747550,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "근데 저는 그것도 처음이니까"
    } ]
  }, {
    "tStartMs": 1750140,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "숨 쉬는 법도 모르고"
    } ]
  }, {
    "tStartMs": 1752380,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "너무 무서운 거예요"
    } ]
  }, {
    "tStartMs": 1753630,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "무서웠겠다"
    } ]
  }, {
    "tStartMs": 1754960,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "근데 아무도 저를 봐주지 않았어요 저는 혼자가 된 거죠"
    } ]
  }, {
    "tStartMs": 1759570,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "선생님도 옆 레인으로 떠났고"
    } ]
  }, {
    "tStartMs": 1762610,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "근데 먼저 간 사람들은 이미 벌써 돌아오고 있고"
    } ]
  }, {
    "tStartMs": 1767710,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "저는 이제 꽁무니에서"
    } ]
  }, {
    "tStartMs": 1770920,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "저의 뒤에 오는 그 상어 떼들을 피해서"
    } ]
  }, {
    "tStartMs": 1777720,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "빨리 이렇게 이렇게 이렇게 하는 연습을 해야 되는 건데"
    } ]
  }, {
    "tStartMs": 1783460,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "그때 진짜... 신선한 경험이었습니다"
    } ]
  }, {
    "tStartMs": 1789700,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "좀 성장에 도움이 됐나요?"
    } ]
  }, {
    "tStartMs": 1791710,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "네 인간적인 성장이 된 것 같아요"
    } ]
  }, {
    "tStartMs": 1795960,
    "dDurationMs": 6220,
    "segs": [ {
      "utf8": "그게 사실 우리가 학생 때를 지나면"
    } ]
  }, {
    "tStartMs": 1802180,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "성인이 되고 나면 진짜 가장 모르는 사람, 가장 못하는 사람,"
    } ]
  }, {
    "tStartMs": 1808580,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "하나도 모르는 사람, 배워야 하는 사람 이런 위치에 있을 일이 사실은 그렇게 많이 없잖아요"
    } ]
  }, {
    "tStartMs": 1814000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1815680,
    "dDurationMs": 6310,
    "segs": [ {
      "utf8": "근데 그런 경험을 하니까 되게 좋았어요"
    } ]
  }, {
    "tStartMs": 1821990,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "맞아요 성인이 되고 뭔가 배울 때 그냥 기분이 좋아요"
    } ]
  }, {
    "tStartMs": 1825790,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 1826660,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "근데 그중에서도 제일 못한다고 하면은"
    } ]
  }, {
    "tStartMs": 1830990,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "그러게 다른 사람들 보면서 빨리 배우게 될 수도 있을 것 같고"
    } ]
  }, {
    "tStartMs": 1835490,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1836480,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "두 달 하고 이제 나올 때쯤에는 어땠어요?"
    } ]
  }, {
    "tStartMs": 1840780,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "여전히 맨 마지막 사람이었나요?"
    } ]
  }, {
    "tStartMs": 1843070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "아니요"
    } ]
  }, {
    "tStartMs": 1844960,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "후배들이 들어왔군요"
    } ]
  }, {
    "tStartMs": 1846460,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "후배들 한두 명 있었는데"
    } ]
  }, {
    "tStartMs": 1848700,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "다 나오다 말다 나오다 말다 하더라고요"
    } ]
  }, {
    "tStartMs": 1852760,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "그렇습니다 그리고 마지막 날에 제가 끝나고"
    } ]
  }, {
    "tStartMs": 1857220,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "그렇게 또 인사 이렇게 수고하셨습니다 하고"
    } ]
  }, {
    "tStartMs": 1860350,
    "dDurationMs": 8070,
    "segs": [ {
      "utf8": "다들 막 뿔뿔이 흩어지는데 그때 선생님께 오늘이 마지막이라고 말씀을 드렸거든요"
    } ]
  }, {
    "tStartMs": 1868420,
    "dDurationMs": 6970,
    "segs": [ {
      "utf8": "선생님 제가 일 때문에 몇 달 못 나오게 됐다 그래서 오늘이 마지막이다"
    } ]
  }, {
    "tStartMs": 1875390,
    "dDurationMs": 6010,
    "segs": [ {
      "utf8": "그렇게 인사를 드리는데 옆 레인 아주머니 두 분께서"
    } ]
  }, {
    "tStartMs": 1881400,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "\"저 총각 되게 열심히 해서 빨리 하더만 너무 아쉽네\" 이렇게 해주시더라고요"
    } ]
  }, {
    "tStartMs": 1886300,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "그랬... 진짜 4번씩 나갔으니까"
    } ]
  }, {
    "tStartMs": 1889030,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 1891310,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "빠진 날이 하루도 없었어요 두 달 동안"
    } ]
  }, {
    "tStartMs": 1894390,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "정성실 씨"
    } ]
  }, {
    "tStartMs": 1895910,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "네 그래서 좀 더 아쉽지 않았나"
    } ]
  }, {
    "tStartMs": 1901910,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "알아봐 주시는, 약간 정이 좀 들었는데 이제 이렇게 인사하는 것도 자연스러워지고"
    } ]
  }, {
    "tStartMs": 1907550,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 1908860,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "아쉽다 아쉽다"
    } ]
  }, {
    "tStartMs": 1910990,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "그런 것 좀 얘기해 드리면 좋을 것 같은데"
    } ]
  }, {
    "tStartMs": 1913890,
    "dDurationMs": 8870,
    "segs": [ {
      "utf8": "한국 수영장 어떻게 이용하고 등록하고 가격은 어느 정도고 이런 거 얘기해 보고 싶어요"
    } ]
  }, {
    "tStartMs": 1922760,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "비교도 될 수 있을 것 같아 가지고"
    } ]
  }, {
    "tStartMs": 1926240,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "우선은 보통 태웅쌤이 가셨던 것처럼 그런 구에서 하는 거"
    } ]
  }, {
    "tStartMs": 1931020,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "시에서 하는 수영장을 많이 가고"
    } ]
  }, {
    "tStartMs": 1936230,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "개인적으로 하는 수영장은 많이 없는 것 같아요"
    } ]
  }, {
    "tStartMs": 1939360,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "있어도 아이들용?이 많아요"
    } ]
  }, {
    "tStartMs": 1942980,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "물 따뜻하고 낮고 좁고"
    } ]
  }, {
    "tStartMs": 1947870,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "그래서 큰 수영장은 그런 것 같고"
    } ]
  }, {
    "tStartMs": 1950990,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "태웅쌤은 수업을 들었잖아요?"
    } ]
  }, {
    "tStartMs": 1953540,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "그 수강신청이 그래서 경쟁률이 되게 높다고 들었거든요"
    } ]
  }, {
    "tStartMs": 1959360,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "괜찮았나요?"
    } ]
  }, {
    "tStartMs": 1960880,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "제가 가는 곳 같은 곳은 굉장히 치열하지 않아요"
    } ]
  }, {
    "tStartMs": 1963900,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "아 진짜? 왜지?"
    } ]
  }, {
    "tStartMs": 1966970,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "아니 뭐 10명이 오든 20명이 오든"
    } ]
  }, {
    "tStartMs": 1970400,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "그냥 선생님이 \"자 시작 가세요 가세요 자세 이렇게 잡고 가세요\""
    } ]
  }, {
    "tStartMs": 1974900,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "이렇게 하니까 인원 제한이 없었어요"
    } ]
  }, {
    "tStartMs": 1978270,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "아 진짜? 그냥 열려 있었군요"
    } ]
  }, {
    "tStartMs": 1981570,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1982560,
    "dDurationMs": 5730,
    "segs": [ {
      "utf8": "아 저는 그 아예 수영장 수 자체가 적으니까"
    } ]
  }, {
    "tStartMs": 1988290,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "배우고 싶어하는 사람은 많은데 수영장은 없으니까"
    } ]
  }, {
    "tStartMs": 1991510,
    "dDurationMs": 7300,
    "segs": [ {
      "utf8": "그 막 1년 기다리신 분들도 있고 제가 있는 경기도 쪽에는 그랬거든요"
    } ]
  }, {
    "tStartMs": 1998810,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "거긴 괜찮았구나"
    } ]
  }, {
    "tStartMs": 2000860,
    "dDurationMs": 8890,
    "segs": [ {
      "utf8": "그렇죠 아니 제가 다닌 수영장... 에서 말 그대로 걸어서 10분 거리에 다른 수영장이 하나 더 있었거든요"
    } ]
  }, {
    "tStartMs": 2009750,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "그것도 나라에서 하는 곳이었는데"
    } ]
  }, {
    "tStartMs": 2012900,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "근데 거기는 학생 수가 한정되어 있었나봐요"
    } ]
  }, {
    "tStartMs": 2017340,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "근데 거기는 진짜 경쟁이 박터졌었어요"
    } ]
  }, {
    "tStartMs": 2022340,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "알아보셨어요?"
    } ]
  }, {
    "tStartMs": 2023520,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "네 알아봤는데 새벽부터 와서 줄을 서야 한다고"
    } ]
  }, {
    "tStartMs": 2028120,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "맞아 맞아"
    } ]
  }, {
    "tStartMs": 2029830,
    "dDurationMs": 12540,
    "segs": [ {
      "utf8": "그렇다고 해서 그냥 포기하고 이렇게 공장식으로, 농장, 우리식 수영장에 갔습니다"
    } ]
  }, {
    "tStartMs": 2042370,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "아 그러셨구나 그래서 그런 곳들은 경쟁률이 낮을 수 있고"
    } ]
  }, {
    "tStartMs": 2047490,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "저는 자유수영이라고 그냥 정해진 시간이 있어요"
    } ]
  }, {
    "tStartMs": 2052560,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "하루에 3시간 정도 여기 때는 자유롭게 와서 수영하면 됩니다 하는 그걸 이용했는데"
    } ]
  }, {
    "tStartMs": 2058560,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "그거는 한 번 가는데 3,000원 정도예요"
    } ]
  }, {
    "tStartMs": 2062660,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그래서 굉장히 저렴합니다"
    } ]
  }, {
    "tStartMs": 2064830,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "어떤 운동보다 저렴한 것 같아요"
    } ]
  }, {
    "tStartMs": 2067490,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2068000,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "왜냐하면 가서 샤워도 다 하고"
    } ]
  }, {
    "tStartMs": 2071020,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "운동도 하고 할 수 있는데 3,000원이면 너무 좋죠? 착하죠?"
    } ]
  }, {
    "tStartMs": 2075450,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "너무 좋아"
    } ]
  }, {
    "tStartMs": 2076660,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "수강하신 거는 얼마였어요? 수강료는?"
    } ]
  }, {
    "tStartMs": 2079870,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "그것도 되게 쌌어요"
    } ]
  }, {
    "tStartMs": 2084930,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "자세하게 기억 안 나는데 한 6만 원, 7만 원?"
    } ]
  }, {
    "tStartMs": 2089850,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "한 달에?"
    } ]
  }, {
    "tStartMs": 2090760,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2091300,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "오, 맞아 그 정도더라고요?"
    } ]
  }, {
    "tStartMs": 2093690,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "네 한 달에 6, 7만 원인데"
    } ]
  }, {
    "tStartMs": 2096250,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "일주일에 4번 갈 수 있으니까"
    } ]
  }, {
    "tStartMs": 2098420,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그러네"
    } ]
  }, {
    "tStartMs": 2099610,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "진짜 싼 거죠?"
    } ]
  }, {
    "tStartMs": 2100720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "네 너무 좋다"
    } ]
  }, {
    "tStartMs": 2102940,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2104770,
    "dDurationMs": 5290,
    "segs": [ {
      "utf8": "그러니까 이렇게 경쟁률이 심한 곳들이 있을 수밖에 없을 것 같아요"
    } ]
  }, {
    "tStartMs": 2110060,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 2110620,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "저렴하고 몸에 좋고 하니까 그래서"
    } ]
  }, {
    "tStartMs": 2116130,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "그 두 개 (자유 수영 \u0026 수강) 나눠가지고 들으시면 된다"
    } ]
  }, {
    "tStartMs": 2120290,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "보통 거기 가면 프론트 카운터가 있어가지고"
    } ]
  }, {
    "tStartMs": 2125050,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "수강신청이나 일일 자유권 그런 거 살 수 있고"
    } ]
  }, {
    "tStartMs": 2128310,
    "dDurationMs": 9740,
    "segs": [ {
      "utf8": "요즘은 키오스크 있어가지고 그걸로 저도 표 뽑아가지고 찍고 샤워하고 수영하고 돌아오고 그런답니다"
    } ]
  }, {
    "tStartMs": 2138050,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "저처럼 물이 무서우신 분들이 있을 수 있는데"
    } ]
  }, {
    "tStartMs": 2142530,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "또 그런 면에서 새로 수영을 배워보는 게"
    } ]
  }, {
    "tStartMs": 2146620,
    "dDurationMs": 6870,
    "segs": [ {
      "utf8": "인생에서 자기의 두려움 하나를 극복하는 의미 있는 경험이 될 수도 있습니다"
    } ]
  }, {
    "tStartMs": 2153490,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "진짜 좋은 경험인 것 같아요"
    } ]
  }, {
    "tStartMs": 2155490,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "진짜 좋아요"
    } ]
  }, {
    "tStartMs": 2157670,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "이제는 물이 두렵지 않으세요?"
    } ]
  }, {
    "tStartMs": 2159900,
    "dDurationMs": 6310,
    "segs": [ {
      "utf8": "네 근데 극복하기가 좀 어려웠어요"
    } ]
  }, {
    "tStartMs": 2166210,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "첫날 수영장 들어갔을 때 계속 가슴이 쿵쾅쿵쾅 거려요"
    } ]
  }, {
    "tStartMs": 2171320,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "두근두근 두근두근"
    } ]
  }, {
    "tStartMs": 2175090,
    "dDurationMs": 7550,
    "segs": [ {
      "utf8": "그래서 첫 주의 마지막 날에는 그게 조금 덜어졌거든요"
    } ]
  }, {
    "tStartMs": 2182640,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "그 무서움이 그래도 조금은 적응을 해서"
    } ]
  }, {
    "tStartMs": 2187440,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "근데 근데 주말 끝나고 주말 지나고 며칠 만에 다시 가니까"
    } ]
  }, {
    "tStartMs": 2193760,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "똑같이 무섭더라고요"
    } ]
  }, {
    "tStartMs": 2195010,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "와 그랬구나"
    } ]
  }, {
    "tStartMs": 2197380,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "무서울만 해요 그거"
    } ]
  }, {
    "tStartMs": 2198940,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "그러니까요 근데 그게 자유형 연습하면서 처음에"
    } ]
  }, {
    "tStartMs": 2204460,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "어느 정도 좀 많이 극복이 되고"
    } ]
  }, {
    "tStartMs": 2207170,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "그러다가 갑자기 어느 날 선생님이 \"회원님 이제 배영해봅시다\" 이렇게 하면"
    } ]
  }, {
    "tStartMs": 2212360,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "그럼 이제 누워서 해야 되잖아요 다시 무서워져요"
    } ]
  }, {
    "tStartMs": 2217200,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "배영 무섭죠 물 엄청 먹잖아요"
    } ]
  }, {
    "tStartMs": 2219740,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "배영 처음 할 때 진짜 무서웠어요"
    } ]
  }, {
    "tStartMs": 2221840,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "덜 덜 덜 덜 덜 그렇겠다"
    } ]
  }, {
    "tStartMs": 2226620,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "그냥 선생님이 \"누워보세요 누워보세요\" 이렇게 하는데"
    } ]
  }, {
    "tStartMs": 2231140,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "근데 이제는 배영이 제일 편한 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 2234770,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "배영~ 속도가 전 좀 느린 것 같았는데 배영이"
    } ]
  }, {
    "tStartMs": 2239230,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "그 레일 돌 때 사람들이 이렇게 줄줄이 가잖아요"
    } ]
  }, {
    "tStartMs": 2242800,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "특히 배영을 하면 자꾸 내 발에 다른 사람 손이 걸려요"
    } ]
  }, {
    "tStartMs": 2247030,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "내가 느린 거예요 배영할 때"
    } ]
  }, {
    "tStartMs": 2249810,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "맞습니다 그리고 방향이 다르게 틀어질 때도 있고요"
    } ]
  }, {
    "tStartMs": 2255090,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "안 보고 가니까"
    } ]
  }, {
    "tStartMs": 2256230,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2257700,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "그런 에티켓도 있네요 생각해보니까"
    } ]
  }, {
    "tStartMs": 2262000,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "다른 사람이 이렇게 출발하려고 하고 있으면"
    } ]
  }, {
    "tStartMs": 2265800,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "좀 기다렸다가 출발해주고 하는 거? 다른 나라에도 당연히 있을런가?"
    } ]
  }, {
    "tStartMs": 2269590,
    "dDurationMs": 5830,
    "segs": [ {
      "utf8": "아, 그렇죠 좀 거리가 멀어지면 하는 거죠"
    } ]
  }, {
    "tStartMs": 2275420,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "맞아 거리 멀어지면 하고"
    } ]
  }, {
    "tStartMs": 2277540,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "앞지르면 안 되고"
    } ]
  }, {
    "tStartMs": 2279360,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "앞지르기는 안 되죠"
    } ]
  }, {
    "tStartMs": 2280830,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "네, 앞지르면 안 되고"
    } ]
  }, {
    "tStartMs": 2282750,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "요즘은 그런 레인도 있더라고요 그냥 걸어다니는 레인"
    } ]
  }, {
    "tStartMs": 2286760,
    "dDurationMs": 6650,
    "segs": [ {
      "utf8": "그래서 저는 수영하다가 지겹거나 힘들면 잠깐 그 옆에 레인,"
    } ]
  }, {
    "tStartMs": 2293410,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "사람 없을 때 잘 보고 옆에 넘어가서 걸어다니고"
    } ]
  }, {
    "tStartMs": 2297560,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "좋네요"
    } ]
  }, {
    "tStartMs": 2298290,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "네, 그런 것도 있었어요"
    } ]
  }, {
    "tStartMs": 2301590,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "물 공포증 그래도 극복하셔서 다행입니다"
    } ]
  }, {
    "tStartMs": 2306230,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "진짜..."
    } ]
  }, {
    "tStartMs": 2308610,
    "dDurationMs": 7910,
    "segs": [ {
      "utf8": "이전 수업시간 끝나면 10분 쉬는 비는 시간 텀에"
    } ]
  }, {
    "tStartMs": 2316520,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "제일 먼저 샤워하고 제일 먼저 가서 계속 담그는 거예요 얼굴을"
    } ]
  }, {
    "tStartMs": 2322590,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "노력파..."
    } ]
  }, {
    "tStartMs": 2323910,
    "dDurationMs": 7100,
    "segs": [ {
      "utf8": "계속 이렇게 편해지려고 그러면서 좋아졌습니다"
    } ]
  }, {
    "tStartMs": 2331010,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "다 할 수 있습니다"
    } ]
  }, {
    "tStartMs": 2333500,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "가능합니다"
    } ]
  }, {
    "tStartMs": 2334100,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "극복할 수 있습니다"
    } ]
  }, {
    "tStartMs": 2335550,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "화이팅!"
    } ]
  }, {
    "tStartMs": 2336540,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "화이팅 화이팅 태웅쌤도 시간 좀 여유로워지시면"
    } ]
  }, {
    "tStartMs": 2340660,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "아니면 시간 좀 내셔가지고"
    } ]
  }, {
    "tStartMs": 2343040,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "계속해서 접영까지 마스터할 수 있었으면 좋겠네요"
    } ]
  }, {
    "tStartMs": 2346290,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 2347500,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "그러면 이번 주 퀴즈 드리도록 할게요"
    } ]
  }, {
    "tStartMs": 2350510,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "이번 주 퀴즈는요"
    } ]
  }, {
    "tStartMs": 2352250,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "태웅쌤이 할 수 없는 수영법으로 해봅시다"
    } ]
  }, {
    "tStartMs": 2356980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 2359200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "1번 자유형"
    } ]
  }, {
    "tStartMs": 2361900,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "2번 평영"
    } ]
  }, {
    "tStartMs": 2364850,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "3번 배영!"
    } ]
  }, {
    "tStartMs": 2367450,
    "dDurationMs": 6420,
    "segs": [ {
      "utf8": "세 가지 수영법 중에서 태웅쌤이 하지 못하시는 수영법 골라서"
    } ]
  }, {
    "tStartMs": 2373870,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "투표하시거나 댓글로 남겨주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 2378020,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "그러면 저희 이제 다음 미니게임 시간으로 가보겠습니다"
    } ]
  }, {
    "tStartMs": 2384620,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "말로 하는 미니게임!"
    } ]
  }, {
    "tStartMs": 2392450,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "네 오늘도 말로 하는 미니게임 시간이 돌아왔고요"
    } ]
  }, {
    "tStartMs": 2395530,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "이번 미니게임은 저번에 했을 때 반응이 좋았던"
    } ]
  }, {
    "tStartMs": 2399680,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "'시장에 가면'의 시리즈로서 한번 해보도록 하고요"
    } ]
  }, {
    "tStartMs": 2405580,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "'수영장에 가면' 게임으로 해보겠습니다"
    } ]
  }, {
    "tStartMs": 2408220,
    "dDurationMs": 9380,
    "segs": [ {
      "utf8": "수영장에 가면 있는 물건들을 차례차례 이야기하는데 앞사람이 했던 것까지 같이 얘기하는 거예요"
    } ]
  }, {
    "tStartMs": 2417600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "일단 들어보시면 압니다"
    } ]
  }, {
    "tStartMs": 2419760,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "근데 무조건 물건일 필요는 없죠"
    } ]
  }, {
    "tStartMs": 2422130,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "아 그쵸 뭐든지 있는거"
    } ]
  }, {
    "tStartMs": 2425160,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 2426570,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "긴장되는데요"
    } ]
  }, {
    "tStartMs": 2430080,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "시작할까요?"
    } ]
  }, {
    "tStartMs": 2431410,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "시작해봅시다"
    } ]
  }, {
    "tStartMs": 2432630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "디디님부터 하시죠"
    } ]
  }, {
    "tStartMs": 2434880,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "한 판으로 끝냅시다"
    } ]
  }, {
    "tStartMs": 2436540,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2439060,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "수영장에 가면"
    } ]
  }, {
    "tStartMs": 2440570,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "선생님도 있고"
    } ]
  }, {
    "tStartMs": 2442380,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고 물도 있고"
    } ]
  }, {
    "tStartMs": 2446910,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고, 물도 있고, 킥판도 있고"
    } ]
  }, {
    "tStartMs": 2452750,
    "dDurationMs": 7650,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고, 물도 있고, 킥판도 있고, 줄도 있고"
    } ]
  }, {
    "tStartMs": 2460400,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고, 물도 있고, 킥판도 있고, 줄도 있고,"
    } ]
  }, {
    "tStartMs": 2466960,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "학생도 있고"
    } ]
  }, {
    "tStartMs": 2468630,
    "dDurationMs": 5870,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고, 물도 있고, 킥판도 있고,"
    } ]
  }, {
    "tStartMs": 2474500,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "줄도 있고, 학생도 있고, 시계도 있고"
    } ]
  }, {
    "tStartMs": 2478590,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고"
    } ]
  }, {
    "tStartMs": 2481250,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "물도 있고, 킥판도 있고, 줄도 있고,"
    } ]
  }, {
    "tStartMs": 2485980,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "학생도 있고,"
    } ]
  }, {
    "tStartMs": 2488580,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "시계도 있고"
    } ]
  }, {
    "tStartMs": 2490690,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "그리고~~~ 어어...."
    } ]
  }, {
    "tStartMs": 2495250,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "수영복도 있고"
    } ]
  }, {
    "tStartMs": 2499880,
    "dDurationMs": 6460,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고 줄... 물도 있고,"
    } ]
  }, {
    "tStartMs": 2506340,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "킥판도 있고, 줄도 있고, 학생도 있고,"
    } ]
  }, {
    "tStartMs": 2511230,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "시계도 있고..."
    } ]
  }, {
    "tStartMs": 2514800,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "어? 맞나 이거?"
    } ]
  }, {
    "tStartMs": 2516770,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "제가, 제가 근데 했나요?"
    } ]
  }, {
    "tStartMs": 2518540,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "아, 맞아요 수영, 수영복도 있고,"
    } ]
  }, {
    "tStartMs": 2521790,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "수영복도 있고,"
    } ]
  }, {
    "tStartMs": 2525250,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "오리발도 있고,"
    } ]
  }, {
    "tStartMs": 2529150,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고, 물도 있고,"
    } ]
  }, {
    "tStartMs": 2533570,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "킥판도 있고, 줄도 있고,"
    } ]
  }, {
    "tStartMs": 2538640,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "학생도 있고, 시계도 있고,"
    } ]
  }, {
    "tStartMs": 2542590,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "수영복도 있고..."
    } ]
  }, {
    "tStartMs": 2545630,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "아악! 오리발도 있고!"
    } ]
  }, {
    "tStartMs": 2548990,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "샴푸도 있고"
    } ]
  }, {
    "tStartMs": 2552820,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고"
    } ]
  }, {
    "tStartMs": 2556060,
    "dDurationMs": 7840,
    "segs": [ {
      "utf8": "물도 있고...."
    } ]
  }, {
    "tStartMs": 2563900,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "어?"
    } ]
  }, {
    "tStartMs": 2567010,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "잠시만..."
    } ]
  }, {
    "tStartMs": 2569980,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "뭐였지? 나도 기억이 안 난다"
    } ]
  }, {
    "tStartMs": 2574670,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "졌습니다..."
    } ]
  }, {
    "tStartMs": 2575110,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "모르겠죠?"
    } ]
  }, {
    "tStartMs": 2576050,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "뭐지? 근데 뭐예요?"
    } ]
  }, {
    "tStartMs": 2577450,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "수영장에 가면 선생님도 있고, 물도 있고"
    } ]
  }, {
    "tStartMs": 2581280,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그런 다음에..."
    } ]
  }, {
    "tStartMs": 2583250,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "킥판이었나?"
    } ]
  }, {
    "tStartMs": 2584430,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "아, 킥판이다"
    } ]
  }, {
    "tStartMs": 2585400,
    "dDurationMs": 8270,
    "segs": [ {
      "utf8": "킥판! 태웅쌤이 떠오르기, 발차기 연습하실 때 쓰셨던 킥판이 있었습니다!"
    } ]
  }, {
    "tStartMs": 2593670,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "와 너무 어렵다 지금 심장이 쿵쾅거려요"
    } ]
  }, {
    "tStartMs": 2598270,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "아 근데 많이 갔네요"
    } ]
  }, {
    "tStartMs": 2599690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "많이 갔어요 진짜"
    } ]
  }, {
    "tStartMs": 2601220,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "한 판이여가지고 목숨 걸고 했습니다"
    } ]
  }, {
    "tStartMs": 2603900,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "많이 갔다 아쉽다"
    } ]
  }, {
    "tStartMs": 2605910,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "재밌었다 재밌었다"
    } ]
  }, {
    "tStartMs": 2609400,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "오늘 이렇게 수영장에 대해서 수영에 대해서 요모조모 얘기해봤고요"
    } ]
  }, {
    "tStartMs": 2614110,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "또 추가로 수영에 대해서 한국 수영장에 대해서 궁금하신 거 있으면"
    } ]
  }, {
    "tStartMs": 2618030,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "댓글로 남겨주시고 확인할 때마다 답글 달아드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 2623630,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "다음 주제를 생각해봤는데 다음 주제는 '잠' 어떠신가요?"
    } ]
  }, {
    "tStartMs": 2627870,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "잠, 수면"
    } ]
  }, {
    "tStartMs": 2629380,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "이렇게 자는 거죠"
    } ]
  }, {
    "tStartMs": 2631530,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그렇죠 자는 거"
    } ]
  }, {
    "tStartMs": 2633360,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "저의 수면 점수를 플렉스할 기회가 되겠습니다"
    } ]
  }, {
    "tStartMs": 2637050,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "점수 높나 봐요"
    } ]
  }, {
    "tStartMs": 2639100,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "나도인데"
    } ]
  }, {
    "tStartMs": 2640130,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "저도 약간 자신 있는데"
    } ]
  }, {
    "tStartMs": 2642070,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 2643100,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "배틀할래요?"
    } ]
  }, {
    "tStartMs": 2644120,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "오 좋아요 잠점수 배틀"
    } ]
  }, {
    "tStartMs": 2648200,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "네 좋죠?"
    } ]
  }, {
    "tStartMs": 2649260,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "좋아요 좋아요 그럼 다음주에는 저희 얼마나 잘 자는지 배틀하는 시간"
    } ]
  }, {
    "tStartMs": 2654210,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "잠으로 요모조모 이야기 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 2657510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그러면 오늘도 들어주셔서 감사하고요"
    } ]
  }, {
    "tStartMs": 2659790,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "여기까지 디디와 정태웅이었습니다 감사합니다!"
    } ]
  } ]
}
