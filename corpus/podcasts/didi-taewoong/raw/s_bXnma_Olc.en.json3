  }, {
    "tStartMs": 2505279,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2507040,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And if you dry your hair with the gym towel,"
