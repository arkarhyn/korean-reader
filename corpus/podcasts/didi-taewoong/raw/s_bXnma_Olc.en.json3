  }, {
    "tStartMs": 2519800,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Inconsiderate, you say?"
    } ]
  }, {
    "tStartMs": 2524400,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "Oh, so you do that course at the gym, Teacher Tae-woong?"
    } ]
  }, {
    "tStartMs": 2528199,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2530600,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "So even if you put essence on your hair and do the styling,"
    } ]
  }, {
    "tStartMs": 2535720,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "you're going to go to the gym and sweat and wash it all away anyway, so there's no need to do it."
    } ]
  }, {
    "tStartMs": 2542160,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "That's how I did it."
    } ]
  }, {
    "tStartMs": 2543880,
    "dDurationMs": 4159,
    "segs": [ {
      "utf8": "Oh, no. But I have something to defend myself with."
    } ]
  }, {
    "tStartMs": 2548039,
    "dDurationMs": 4921,
    "segs": [ {
      "utf8": "The gym I go to is combined with a bathhouse,"
    } ]
  }, {
    "tStartMs": 2552960,
    "dDurationMs": 7640,
    "segs": [ {
      "utf8": "and bathhouses originally have barbershops in them."
