  }, {
    "tStartMs": 2437439,
    "dDurationMs": 3601,
    "segs": [ {
      "utf8": "I tell people not to do it."
    } ]
  }, {
    "tStartMs": 2441040,
    "dDurationMs": 599,
    "segs": [ {
      "utf8": "The styling?"
    } ]
  }, {
    "tStartMs": 2441639,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yes, yes."
    } ]
  }, {
    "tStartMs": 2442439,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "I'm just going home anyway, so just do it roughly for me, like that?"
    } ]
  }, {
    "tStartMs": 2445680,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Um... yes. That's..."
    } ]
  }, {
    "tStartMs": 2448520,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "I don't go to the gym now,"
    } ]
  }, {
    "tStartMs": 2451360,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "but I used to go to the gym all the time back then."
    } ]
  }, {
    "tStartMs": 2453840,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Huh?"
    } ]
  }, {
    "tStartMs": 2455560,
    "dDurationMs": 6039,
    "segs": [ {
      "utf8": "When you cut men's hair, with clippers and stuff?"
    } ]
  }, {
    "tStartMs": 2461599,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "They shave the hair with those kinds of tools,"
