  "events": [ {
    "tStartMs": 1000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yomojomo of Didi and Jeong Tae-woong's Life in Korea"
    } ]
  }, {
    "tStartMs": 9000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Hello, this is Didi."
    } ]
  }, {
    "tStartMs": 11000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Hello, this is Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 13000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yomojomo of life in Korea is a podcast where two people living in Korea"
    } ]
  }, {
    "tStartMs": 16000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "talk about the various aspects of life in Korea."
    } ]
  }, {
    "tStartMs": 19000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So what was today's topic?"
    } ]
  }, {
    "tStartMs": 21000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Today's topic was hair salons."
    } ]
  }, {
    "tStartMs": 26000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Hair salons do perms, dyeing, cuts, makeup"
    } ]
  }, {
    "tStartMs": 30000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and other beauty treatments to create hairstyles and"
    } ]
  }, {
    "tStartMs": 34000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "are shops that specialize in grooming one's appearance."
    } ]
  }, {
    "tStartMs": 38000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That explanation is a bit too difficult, isn't it?"
    } ]
  }, {
    "tStartMs": 41000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So it's basically a place where you go to get your hair done, right?"
    } ]
  }, {
    "tStartMs": 44000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Right. A place where you cut your hair or"
    } ]
  }, {
    "tStartMs": 47000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "make it look pretty?"
    } ]
  }, {
    "tStartMs": 49000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "Yes. Teacher Tae-woong, when you go to a hair salon, what do you usually do most often?"
    } ]
  }, {
    "tStartMs": 57000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "There's nothing I do most often. Because I only do one thing"
    } ]
  }, {
    "tStartMs": 62000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Always?"
    } ]
  }, {
    "tStartMs": 63000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I only go to get my hair cut"
    } ]
  }, {
    "tStartMs": 65000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "You only do cuts?"
    } ]
  }, {
    "tStartMs": 66000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 67000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What about perms?"
    } ]
  }, {
    "tStartMs": 68000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "My hair is naturally frizzy, so"
    } ]
  }, {
    "tStartMs": 71000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I don't need it?"
    } ]
  }, {
    "tStartMs": 73000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Right. It's not completely frizzy, it's like semi-frizzy?"
    } ]
  }, {
    "tStartMs": 77000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Semi-frizzy?"
    } ]
  }, {
    "tStartMs": 78000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Hair that has a bit of a frizzy texture?"
    } ]
  }, {
    "tStartMs": 81000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So there's no need for me to do it."
    } ]
  }, {
    "tStartMs": 84000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Really? You're blessed."
    } ]
  }, {
    "tStartMs": 86000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's what people always say."
    } ]
  }, {
    "tStartMs": 88000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "But from what I know, a lot of men do things like straight perms"
    } ]
  }, {
    "tStartMs": 94000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What about you, Teacher Tae-woong?"
    } ]
  }, {
    "tStartMs": 96000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I still don't even know what that is."
    } ]
  }, {
    "tStartMs": 99000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "A straight perm?"
    } ]
  }, {
    "tStartMs": 100000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 101000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But a lot of people around you don't do it?"
    } ]
  }, {
    "tStartMs": 103000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Maybe I'm just not very knowledgeable about that kind of beauty stuff"
    } ]
  }, {
    "tStartMs": 108000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I've heard people talk about it a few times"
    } ]
  }, {
    "tStartMs": 111000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But I couldn't figure it out"
    } ]
  }, {
    "tStartMs": 116000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Even when I see someone who's had a straight perm?"
    } ]
  }, {
    "tStartMs": 119000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 121000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Maybe because my hair is semi-frizzy and has a lot of volume"
    } ]
  }, {
    "tStartMs": 126000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I don't need it? What about you, Teacher Tae-woong?"
    } ]
  }, {
    "tStartMs": 129000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 132000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Maybe a straight perm?"
    } ]
  }, {
    "tStartMs": 137000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "If I got a straight perm, my hair might look prettier too"
    } ]
  }, {
    "tStartMs": 141000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Or maybe I just don't know about it"
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 145000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 146000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "But I don't really pay much attention to that kind of thing anyway"
    } ]
  }, {
    "tStartMs": 152000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Like with your hair?"
    } ]
  }, {
    "tStartMs": 153000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I wear training clothes every day"
    } ]
  }, {
    "tStartMs": 157000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm not really interested in styling or grooming myself?"
    } ]
  }, {
    "tStartMs": 160000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 162000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Is that so?"
    } ]
  }, {
    "tStartMs": 163000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 165000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So do you always go to the same hair salon?"
    } ]
  }, {
    "tStartMs": 169000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 171000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You've settled on one? A hair salon?"
    } ]
  }, {
    "tStartMs": 175000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "To be precise, it's not so much that I've settled on a hair salon"
    } ]
  }, {
    "tStartMs": 180000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I tend to stick with the same hairdresser."
    } ]
  }, {
    "tStartMs": 184000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "Because if I just go to a salon"
    } ]
  }, {
    "tStartMs": 192000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "and ask any available stylist to cut my hair,"
    } ]
  }, {
    "tStartMs": 199000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "even though it's the same salon,"
    } ]
  }, {
    "tStartMs": 201000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "some stylists might cut it well"
    } ]
  }, {
    "tStartMs": 205000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and some might not do a good job, you know?"
    } ]
  }, {
    "tStartMs": 207000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's true."
    } ]
  }, {
    "tStartMs": 208000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But when that happens and I end up with someone who can't cut well,"
    } ]
  }, {
    "tStartMs": 213000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "the stress I experience is really big,"
    } ]
  }, {
    "tStartMs": 217000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and even though I said I don't care about appearance,"
    } ]
  }, {
    "tStartMs": 222000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but it's still awkward if it turns out weird, right?"
    } ]
  }, {
    "tStartMs": 225000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's right. You're paying for it."
    } ]
  }, {
    "tStartMs": 227000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 228000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But I wasn't always like this."
    } ]
  }, {
    "tStartMs": 232000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes. What do you mean?"
    } ]
  }, {
    "tStartMs": 235000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This thing about sticking with the same hairdresser—"
    } ]
  }, {
    "tStartMs": 239000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "because back then, no matter where I went,"
    } ]
  }, {
    "tStartMs": 244000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "so whatever stylists I saw,"
    } ]
  }, {
    "tStartMs": 248000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "it was generally fine."
    } ]
  }, {
    "tStartMs": 251000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I was generally happy with my hair."
    } ]
  }, {
    "tStartMs": 254000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But then after I moved, was it?"
    } ]
  }, {
    "tStartMs": 258000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I found a new salon near my house,"
    } ]
  }, {
    "tStartMs": 262000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and it was a pretty big place."
    } ]
  }, {
    "tStartMs": 264000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "There seemed to be about 5 or 6 stylists there."
    } ]
  }, {
    "tStartMs": 269000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 270000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "But the first time I went, they cut it pretty well."
    } ]
  }, {
    "tStartMs": 276000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 277000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It seemed okay, so I went again next time,"
    } ]
  }, {
    "tStartMs": 280000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but the stylist was either off or had another appointment,"
    } ]
  }, {
    "tStartMs": 284000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so a different stylist cut my hair."
    } ]
  }, {
    "tStartMs": 287000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But I really didn't like it."
    } ]
  }, {
    "tStartMs": 289000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "They cut it kind of stupidly."
    } ]
  }, {
    "tStartMs": 293000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So it's 1 to 1, you know? The score."
    } ]
  }, {
    "tStartMs": 297000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So one time they cut it well and one time they didn't at that salon."
    } ]
  }, {
    "tStartMs": 302000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So once I had success,"
    } ]
  }, {
    "tStartMs": 305000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I kept going with some hope,"
    } ]
  }, {
    "tStartMs": 309000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but every time I went, I really didn't like it."
    } ]
  }, {
    "tStartMs": 311000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 312000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "So I kept getting stressed,"
    } ]
  }, {
    "tStartMs": 318000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and then one time a stylist I'd never seen before at that salon"
    } ]
  }, {
    "tStartMs": 322000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "cut my hair and I really liked it."
    } ]
  }, {
    "tStartMs": 326000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I felt so at ease."
    } ]
  }, {
    "tStartMs": 329000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "But that stylist cut it once"
    } ]
  }, {
    "tStartMs": 336000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and then quit? Or cut it twice and then quit?"
    } ]
  }, {
    "tStartMs": 341000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 342000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So I switched to a different salon."
    } ]
  }, {
    "tStartMs": 344000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You switched pretty quickly."
    } ]
  }, {
    "tStartMs": 346000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I think the problem was that salon itself."
    } ]
  }, {
    "tStartMs": 350000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "They couldn't even cut hair well."
    } ]
  }, {
    "tStartMs": 352000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So there was a reason. There was a reason for it."
    } ]
  }, {
    "tStartMs": 356000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "So I really didn't want to go back to those stressful old days,"
    } ]
  }, {
    "tStartMs": 364000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "so I asked if they could tell me where that stylist went."
    } ]
  }, {
    "tStartMs": 369000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I followed that stylist to where they were."
    } ]
  }, {
    "tStartMs": 373000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That must have felt so good. That stylist."
    } ]
  }, {
    "tStartMs": 376000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Wouldn't you have felt so proud?"
    } ]
  }, {
    "tStartMs": 377000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Exactly."
    } ]
  }, {
    "tStartMs": 378000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So the salon you go to now is there too?"
    } ]
  }, {
    "tStartMs": 381000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 382000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Why did the relationship with that stylist end?"
    } ]
  }, {
    "tStartMs": 388000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Actually, it's too far from my house."
    } ]
  }, {
    "tStartMs": 393000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's important too."
    } ]
  }, {
    "tStartMs": 394000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes. It's difficult to go there every time."
    } ]
  }, {
    "tStartMs": 397000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "So after that, I tried a couple of hair salons near my house"
    } ]
  }, {
    "tStartMs": 406000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and ended up finding a place I really like."
    } ]
  }, {
    "tStartMs": 410000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Happy ending."
    } ]
  }, {
    "tStartMs": 412000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes. It's a happy ending."
    } ]
  }, {
    "tStartMs": 414000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You just get cuts, right?"
    } ]
  }, {
    "tStartMs": 416000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes. That's what I do."
    } ]
  }, {
    "tStartMs": 417000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "A good cut is really hard to find."
    } ]
  }, {
    "tStartMs": 423000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "What about you, Didi? What do you prefer?"
    } ]
  }, {
    "tStartMs": 426000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "What do I do? I usually go when I'm getting my hair dyed or permed."
    } ]
  }, {
    "tStartMs": 433000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "For cuts, I always have the same pattern—I cut my hair really short"
    } ]
  }, {
    "tStartMs": 439000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and then just let it grow for about 2 or 3 years."
    } ]
  }, {
    "tStartMs": 442000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Wow. 2 or 3 years?"
    } ]
  }, {
    "tStartMs": 443000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Yes. So I don't really have a reason to go to the salon."
    } ]
  }, {
    "tStartMs": 447000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Just occasionally for dyeing or perming."
    } ]
  }, {
    "tStartMs": 452000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "But even when you're growing your hair out, do you thin it?"
    } ]
  }, {
    "tStartMs": 459000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Or do you trim around the ears?"
    } ]
  }, {
    "tStartMs": 463000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "There's some maintenance like that, right?"
    } ]
  }, {
    "tStartMs": 466000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I don't do any of that."
    } ]
  }, {
    "tStartMs": 468000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 469000,
