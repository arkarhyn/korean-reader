  }, {
    "tStartMs": 1377000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1379000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I've tried it once or twice."
    } ]
  }, {
    "tStartMs": 1383000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Choppy bangs. A hairstyle called choppy bangs."
