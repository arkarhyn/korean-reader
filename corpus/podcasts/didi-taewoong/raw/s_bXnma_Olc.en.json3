  }, {
    "tStartMs": 2465080,
    "dDurationMs": 8119,
    "segs": [ {
      "utf8": "so really short little hairs stay on your clothes like dust"
    } ]
  }, {
    "tStartMs": 2473199,
    "dDurationMs": 3801,
    "segs": [ {
      "utf8": "and there's a lot left on your chin and places like that."
    } ]
  }, {
    "tStartMs": 2477000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So no matter how much styling they do,"
    } ]
  }, {
    "tStartMs": 2480440,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "you have to take a full shower that day"
    } ]
  }, {
    "tStartMs": 2484239,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "to wash away all those tiny short hairs stuck on your neck."
    } ]
  }, {
    "tStartMs": 2489919,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2492160,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "But if you wash it at the gym,"
    } ]
  }, {
    "tStartMs": 2497040,
    "dDurationMs": 6919,
    "segs": [ {
      "utf8": "the high-pressure gym shower washes it all away,"
    } ]
  }, {
    "tStartMs": 2503959,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "it's almost like a car wash."
