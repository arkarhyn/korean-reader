  }, {
    "tStartMs": 2430240,
    "dDurationMs": 1879,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2432119,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Well, since you said you're going to meet friends right after."
