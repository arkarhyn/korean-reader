  }, {
    "tStartMs": 2515000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2518000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "That's inconsiderate."
