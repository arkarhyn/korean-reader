    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I just want to watch and go home, you know?"
    } ]
  }, {
    "tStartMs": 1890199,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So, so that turns into too much of a thing."
    } ]
  }, {
    "tStartMs": 1893199,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "It becomes too much of a thing."
    } ]
  }, {
    "tStartMs": 1895500,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "Actually, you know they won't watch even if they say they'll subscribe and watch right in front of you."
    } ]
  }, {
    "tStartMs": 1901400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "You know they won't watch."
    } ]
  }, {
    "tStartMs": 1903000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Especially since I deal with a foreign audience."
    } ]
  }, {
    "tStartMs": 1905400,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "Right, me too, me too."
    } ]
  }, {
    "tStartMs": 1907599,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1908400,
    "dDurationMs": 3199,
    "segs": [ {
      "utf8": "I actually tell people not to subscribe."
    } ]
  }, {
    "tStartMs": 1911599,
    "dDurationMs": 5401,
    "segs": [ {
      "utf8": "Don't subscribe, I'm saying it's more helpful not to."
    } ]
  }, {
    "tStartMs": 1917000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But anyway, you're not really one for small talk?"
    } ]
  }, {
    "tStartMs": 1919000,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "No, I'm not, I'm not."
    } ]
  }, {
    "tStartMs": 1923500,
    "dDurationMs": 6199,
    "segs": [ {
      "utf8": "Well, I do it, but small talk is kind of like"
    } ]
  }, {
    "tStartMs": 1929699,
    "dDurationMs": 4901,
    "segs": [ {
      "utf8": "places where I've talked about myself, like a hair salon or a nail shop or places like that"
    } ]
  }, {
    "tStartMs": 1934600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I end up not going back a second time."
    } ]
  }, {
    "tStartMs": 1938600,
    "dDurationMs": 6599,
    "segs": [ {
      "utf8": "It's not that the conversation was uncomfortable or anything, or that it wasn't fun or anything like that"
    } ]
  }, {
    "tStartMs": 1945199,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "it's just that I go and start with \"How have you been doing?\""
    } ]
  }, {
    "tStartMs": 1949100,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "and then asking what happened with that thing from back then"
    } ]
  }, {
    "tStartMs": 1952899,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "talking about stuff like that, for some reason feels like a burden to me."
    } ]
  }, {
    "tStartMs": 1956600,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "So I'd rather just go somewhere where nobody knows me"
    } ]
  }, {
    "tStartMs": 1961500,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "and be able to relax."
    } ]
  }, {
    "tStartMs": 1965000,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "So recently I've been thinking"
    } ]
  }, {
    "tStartMs": 1967399,
    "dDurationMs": 6701,
    "segs": [ {
      "utf8": "that when I go to a hair salon or places like that"
    } ]
  }, {
    "tStartMs": 1974100,
    "dDurationMs": 4799,
    "segs": [ {
      "utf8": "I wish there was a PC so I could confidently watch"
    } ]
  }, {
    "tStartMs": 1978899,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "something like Netflix."
    } ]
  }, {
    "tStartMs": 1980899,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Just watch it openly."
    } ]
  }, {
    "tStartMs": 1983199,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "Oh, that's actually an idea though?"
    } ]
  }, {
    "tStartMs": 1985100,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Isn't it good?"
    } ]
  }, {
    "tStartMs": 1985800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Oh, it's not bad actually?"
    } ]
  }, {
    "tStartMs": 1987300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "So later on, even at nail shops"
    } ]
  }, {
    "tStartMs": 1989000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "right now it's completely face-to-face person to person"
    } ]
  }, {
    "tStartMs": 1993000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "there would be a screen like this."
    } ]
  }, {
    "tStartMs": 1994500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And I'd just put my hand in there."
    } ]
  }, {
    "tStartMs": 1997000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "In the hole."
    } ]
  }, {
    "tStartMs": 1998800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "So you wouldn't be facing each other"
    } ]
  }, {
    "tStartMs": 2001100,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2002199,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I want to watch Netflix."
    } ]
  }, {
    "tStartMs": 2003399,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "I just want to watch movies for like two hours straight."
    } ]
  }, {
    "tStartMs": 2007699,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Oh, you'd think a place like that would exist, but it doesn't?"
    } ]
  }, {
    "tStartMs": 2009899,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It doesn't, it doesn't."
    } ]
  }, {
    "tStartMs": 2011899,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "There's nowhere that openly has a screen like that."
    } ]
  }, {
    "tStartMs": 2014300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "I wonder why?"
    } ]
  }, {
    "tStartMs": 2016000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "That's an idea."
    } ]
  }, {
    "tStartMs": 2017300,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Yeah, if anyone's preparing to start a business"
    } ]
  }, {
    "tStartMs": 2022600,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "there are customers with this kind of need."
    } ]
  }, {
    "tStartMs": 2025899,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 2028600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But the people working there might"
    } ]
  }, {
    "tStartMs": 2030600,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "feel a bit itchy to talk, you know?"
    } ]
  }, {
    "tStartMs": 2035100,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Hmm, I'm curious about that too."
    } ]
  }, {
    "tStartMs": 2036800,
    "dDurationMs": 2599,
    "segs": [ {
      "utf8": "So that's what I want to ask."
    } ]
  }, {
    "tStartMs": 2039399,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "When a customer comes in like this"
    } ]
  }, {
    "tStartMs": 2041399,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "is it better to have a conversation"
    } ]
  }, {
    "tStartMs": 2043500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "or is a quiet customer better"
    } ]
  }, {
    "tStartMs": 2045500,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "I'm curious about that too."
    } ]
  }, {
    "tStartMs": 2047699,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It probably varies from person to person"
    } ]
  }, {
    "tStartMs": 2050699,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "Hmm"
    } ]
  }, {
    "tStartMs": 2053100,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "when a talkative customer comes, is that easier"
    } ]
  }, {
    "tStartMs": 2055600,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "or when a shy, quiet customer comes"
    } ]
  }, {
    "tStartMs": 2059000,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "is that easier instead"
    } ]
  }, {
    "tStartMs": 2061399,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Oh, that's probably something that really varies from person to person"
    } ]
  }, {
    "tStartMs": 2064799,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "It probably does vary"
    } ]
  }, {
    "tStartMs": 2067000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "but still"
    } ]
  }, {
    "tStartMs": 2070600,
    "dDurationMs": 5699,
    "segs": [ {
      "utf8": "even if it's a stylist who likes things a bit quiet"
    } ]
  }, {
    "tStartMs": 2076299,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "wouldn't it be a bit strange not to talk to anyone at all?"
    } ]
  }, {
    "tStartMs": 2080100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "All day long?"
    } ]
  }, {
    "tStartMs": 2081100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2082000,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 2086600,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "I think that could be possible."
    } ]
  }, {
    "tStartMs": 2088899,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2090700,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "Oh, well, there are things like that too, you know."
    } ]
  }, {
    "tStartMs": 2092799,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "There are a lot of people who become really close."
    } ]
  }, {
    "tStartMs": 2095100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2096100,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Like, I become really close with the salon teacher"
    } ]
  }, {
    "tStartMs": 2099200,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "and every time we go, we buy things for each other"
    } ]
  }, {
    "tStartMs": 2102299,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and when I see that, it looks nice, you know."
    } ]
  }, {
    "tStartMs": 2105299,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "When working, if there are customers like that,"
    } ]
  }, {
    "tStartMs": 2108200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "it seems like it would be enjoyable."
    } ]
  }, {
    "tStartMs": 2109500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Oh, right."
    } ]
  }, {
    "tStartMs": 2110600,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 2111899,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "That's right, that's right."
    } ]
  }, {
    "tStartMs": 2112700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I like things like that too."
    } ]
  }, {
    "tStartMs": 2114700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I do like it,"
    } ]
  }, {
    "tStartMs": 2116200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "but I wish I had something like that too,"
    } ]
  }, {
    "tStartMs": 2119000,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "but it doesn't work out that way for me."
    } ]
  }, {
    "tStartMs": 2120399,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 2122899,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "If I had a close teacher,"
    } ]
  }, {
    "tStartMs": 2125500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "it would be fun every time I went."
    } ]
  }, {
    "tStartMs": 2127600,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So I'd rather wish I had a friend who's a hairdresser."
    } ]
  }, {
    "tStartMs": 2131500,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Oh, that makes sense."
    } ]
  }, {
    "tStartMs": 2132899,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "Like, you become close with someone outside, and then it turns out they're a hairdresser"
    } ]
  }, {
    "tStartMs": 2136100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2138000,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "and you end up going there"
    } ]
  }, {
    "tStartMs": 2140399,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "or something like that."
    } ]
  }, {
    "tStartMs": 2141799,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Maybe something like that will happen someday."
    } ]
  }, {
    "tStartMs": 2143799,
    "dDurationMs": 5201,
    "segs": [ {
      "utf8": "Isn't it just that you haven't met a hairdresser you really like?"
    } ]
  }, {
    "tStartMs": 2149000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Sigh."
    } ]
  }, {
    "tStartMs": 2150000,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Well, that could be it."
    } ]
  }, {
    "tStartMs": 2151399,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2151799,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "I'm planning to keep going to different salons."
    } ]
  }, {
    "tStartMs": 2154100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 2155700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So Tae-woong, in a foreign country,"
    } ]
  }, {
    "tStartMs": 2158100,
    "dDurationMs": 199,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2158299,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "have you been to a salon?"
    } ]
  }, {
    "tStartMs": 2160799,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "Um."
    } ]
  }, {
    "tStartMs": 2162000,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "Oh, well, when I was in Bangladesh for a year,"
    } ]
  }, {
    "tStartMs": 2164299,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2164899,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "I went regularly,"
    } ]
  }, {
    "tStartMs": 2166100,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Mm-hmm-hmm."
    } ]
  }, {
    "tStartMs": 2166700,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "and while traveling too,"
    } ]
  }, {
    "tStartMs": 2169600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I went once in Thailand."
    } ]
  }, {
    "tStartMs": 2172600,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "In Chiang Mai."
    } ]
  }, {
    "tStartMs": 2173799,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2174799,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "How was the experience when you did it in places like that?"
    } ]
  }, {
    "tStartMs": 2178500,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "Like, why is it that in Korea, when you get your hair cut,"
    } ]
  }, {
    "tStartMs": 2181399,
    "dDurationMs": 301,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2181700,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "they cover everything below your neck and wrap it around,"
    } ]
  }, {
    "tStartMs": 2184799,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2185299,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2186000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and cut it neatly,"
    } ]
  }, {
    "tStartMs": 2187500,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Hehe."
    } ]
  }, {
    "tStartMs": 2188100,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "and after cutting,"
    } ]
  }, {
    "tStartMs": 2190399,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "you go to the hair-washing area and wash your hair,"
    } ]
  }, {
    "tStartMs": 2192700,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2193100,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "and then you come back and they blow-dry it again"
    } ]
  }, {
    "tStartMs": 2196799,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and make it really neat, you know."
    } ]
  }, {
    "tStartMs": 2198799,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "Right, they make it so you can go straight to your next appointment."
    } ]
  }, {
    "tStartMs": 2201700,
    "dDurationMs": 699,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2202399,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Mm-hmm, mm-hmm."
    } ]
  }, {
    "tStartMs": 2203100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "But there were places that weren't like that either."
    } ]
  }, {
    "tStartMs": 2205000,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 2206399,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "Yeah, well, there were places like that too."
    } ]
  }, {
    "tStartMs": 2209200,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Um, the place I went to in Bangladesh—"
    } ]
  }, {
    "tStartMs": 2214000,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "It's a characteristic of Bangladesh as a country."
    } ]
  }, {
    "tStartMs": 2215899,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2217500,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "I'm curious."
    } ]
  }, {
    "tStartMs": 2218299,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Uh, men and women—"
    } ]
  }, {
    "tStartMs": 2220799,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2221700,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "They really avoid physical contact with each other."
    } ]
  }, {
    "tStartMs": 2226500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 2227600,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "So men's barbershops only have male barbers."
    } ]
  }, {
    "tStartMs": 2230899,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "Ah, yes, it's kind of strict."
    } ]
  }, {
    "tStartMs": 2233500,
    "dDurationMs": 2299,
    "segs": [ {
