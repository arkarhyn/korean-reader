  }, {
    "tStartMs": 1176960,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1178359,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "Even during break time I'd keep my head down."
