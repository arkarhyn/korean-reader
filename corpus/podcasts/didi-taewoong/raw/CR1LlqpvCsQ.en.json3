  }, {
    "tStartMs": 1526799,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "or otherwise just \"it was delicious\" kind of thing—"
    } ]
  }, {
    "tStartMs": 1528959,
    "dDurationMs": 4801,
    "segs": [ {
      "utf8": "if there's no praise about the taste, then it's a review event"
