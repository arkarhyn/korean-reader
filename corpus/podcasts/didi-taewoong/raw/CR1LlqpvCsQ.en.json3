  }, {
    "tStartMs": 1563000,
    "dDurationMs": 4359,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1567359,
    "dDurationMs": 521,
    "segs": [ {
      "utf8": "So if you excluded just those reviews"
