  }, {
    "tStartMs": 3062400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Huh? Yes, what is it?"
    } ]
  }, {
    "tStartMs": 3064400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Do you know which place has the most delicious fried chicken?"
    } ]
  }, {
    "tStartMs": 3066400,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Let me try to guess."
    } ]
  }, {
    "tStartMs": 3067199,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The place with the most delicious fried chicken."
    } ]
  }, {
    "tStartMs": 3070080,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "The closest one?"
    } ]
  }, {
    "tStartMs": 3071000,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Uh, that's right."
    } ]
  }, {
    "tStartMs": 3072080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "[laughs]"
    } ]
  }, {
    "tStartMs": 3075959,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "Fried chicken has to be fried fresh right away."
    } ]
  }, {
    "tStartMs": 3078160,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Exactly."
    } ]
  }, {
    "tStartMs": 3079160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 3080480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It has to arrive as quickly as possible."
    } ]
  }, {
    "tStartMs": 3082480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Ah, so that's the key."
    } ]
  }, {
    "tStartMs": 3084760,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3085760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Wow, that's a great tip."
    } ]
  }, {
    "tStartMs": 3088120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 3089120,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So I should look at the minimum order, by closest distance then?"
    } ]
  }, {
    "tStartMs": 3094120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes, yes, yes."
    } ]
  }, {
    "tStartMs": 3095120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "By closest distance."
    } ]
  }, {
    "tStartMs": 3097120,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "If you want to eat fried chicken by ordering from the closest distance?"
    } ]
  }, {
    "tStartMs": 3101120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes, yes."
    } ]
  }, {
    "tStartMs": 3103120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 3104120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "There's no failure?"
    } ]
  }, {
    "tStartMs": 3106120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "There was no failure."
    } ]
  }, {
    "tStartMs": 3107120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 3108120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 3109480,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And these days, most chicken restaurants are franchises."
    } ]
  }, {
    "tStartMs": 3114480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 3115480,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So there's not really a risk of failure in taste, you know?"
    } ]
  }, {
    "tStartMs": 3119480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3120480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Most of them do the basics."
    } ]
  }, {
    "tStartMs": 3122480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 3123480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "So then?"
    } ]
  }, {
    "tStartMs": 3124480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 3126480,
    "dDurationMs": 1999,
    "segs": [ {
      "utf8": "The one that maintains the freshness the most,"
    } ]
  }, {
    "tStartMs": 3128479,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 3129479,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The one where you can eat it fresh from the fryer,"
    } ]
  }, {
    "tStartMs": 3131479,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 3132479,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The chicken restaurant closest by distance is the answer."
    } ]
  }, {
    "tStartMs": 3135479,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 3136479,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That makes sense."
    } ]
  }, {
    "tStartMs": 3137839,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "When it comes to delivery, it's chicken, right?"
    } ]
  }, {
    "tStartMs": 3139839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 3140839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 3141839,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So you don't really have a favorite franchise?"
    } ]
  }, {
    "tStartMs": 3144839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Not anymore."
    } ]
  }, {
    "tStartMs": 3145839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 3146839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 3147839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3148839,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Besides fried, what's your second favorite type of chicken?"
    } ]
  }, {
    "tStartMs": 3152839,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Well."
    } ]
  }, {
    "tStartMs": 3154839,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Not half and half, just fried chicken?"
    } ]
  }, {
    "tStartMs": 3157839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 3158839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 3159839,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yeah, a lot. Almost always."
    } ]
  }, {
    "tStartMs": 3161839,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Wow, you really do love fried chicken."
    } ]
  }, {
    "tStartMs": 3163839,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3165199,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But there are special menu items, you know."
    } ]
  }, {
    "tStartMs": 3168199,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Like Bburing Kle or Gochubbasak and things like that."
    } ]
  }, {
    "tStartMs": 3171199,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3172199,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I don't really have a favorite among those."
    } ]
  }, {
    "tStartMs": 3174199,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh, is that so?"
    } ]
  }, {
    "tStartMs": 3175199,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3176199,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You don't like Bburing Kle?"
    } ]
  }, {
    "tStartMs": 3178199,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "For me, after eating about three pieces of Bburing Kle, I get tired of it."
    } ]
  }, {
    "tStartMs": 3181199,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But aren't those three pieces really delicious?"
    } ]
  }, {
    "tStartMs": 3184199,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "No, just the first bite is really delicious."
    } ]
  }, {
    "tStartMs": 3187199,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's that explosive kind of deliciousness, you know?"
    } ]
  }, {
    "tStartMs": 3189199,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Well, that's true."
    } ]
  }, {
    "tStartMs": 3191199,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 3192559,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "When I go and eat Bburing Kle, it stays delicious the whole time."
    } ]
  }, {
    "tStartMs": 3195559,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yeah. Because it's stimulating."
    } ]
  }, {
    "tStartMs": 3198559,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Yes. Right when it's freshly fried,"
    } ]
  }, {
    "tStartMs": 3203559,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "when that explosive quality is still there,"
    } ]
  }, {
    "tStartMs": 3206559,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "once you finish eating it all, it's done."
    } ]
  }, {
    "tStartMs": 3211559,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "It's done."
    } ]
  }, {
    "tStartMs": 3212559,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3213559,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Fried chicken."
    } ]
  }, {
    "tStartMs": 3215559,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What about old-style whole chicken?"
    } ]
  }, {
    "tStartMs": 3217559,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Old-style whole chicken?"
    } ]
  }, {
    "tStartMs": 3220919,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I like old-style whole chicken. I do."
    } ]
  }, {
    "tStartMs": 3222919,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "You do?"
    } ]
  }, {
    "tStartMs": 3223919,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Um... I do like it."
    } ]
  }, {
    "tStartMs": 3228919,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Old-style whole chicken has several varieties these days, you know."
    } ]
  }, {
    "tStartMs": 3232919,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Is that so?"
    } ]
  }, {
    "tStartMs": 3233919,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Or maybe not? I like the electric rotisserie style old-style whole chicken."
    } ]
  }, {
    "tStartMs": 3240919,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The kind without flour coating?"
    } ]
  }, {
    "tStartMs": 3242919,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3243919,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Ah..."
    } ]
  }, {
    "tStartMs": 3244919,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "That feeling of the electric rotisserie whole chicken they used to sell from trucks."
    } ]
  }, {
    "tStartMs": 3250279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 3252279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I like that too."
    } ]
  }, {
    "tStartMs": 3253279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's called Gimjonggu-style Mastkicken."
    } ]
  }, {
    "tStartMs": 3255279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes. Mr. Gimjonggu's."
    } ]
  }, {
    "tStartMs": 3258279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Gimjonggu-style Mastkicken."
    } ]
  }, {
    "tStartMs": 3261279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mastkicken?"
    } ]
  }, {
    "tStartMs": 3262279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 3263279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mastkicken."
    } ]
  }, {
    "tStartMs": 3264279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "You don't have it in Seoul?"
    } ]
  }, {
    "tStartMs": 3265279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I've never heard of it."
    } ]
  }, {
    "tStartMs": 3266279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Is it only in Busan?"
    } ]
  }, {
    "tStartMs": 3268279,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Gimjonggu... oh, it's not Gimjonggu, it's Gimjonggu's Mastkicken."
    } ]
  }, {
    "tStartMs": 3274279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Gimjonggu-style Mastkicken."
    } ]
  }, {
    "tStartMs": 3276279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ah. It does exist, but I've never heard of it."
    } ]
  }, {
    "tStartMs": 3279640,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "They sell electric rotisserie style, but they also sell regular fried chicken."
    } ]
  }, {
    "tStartMs": 3283640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Wow. That sounds delicious."
    } ]
  }, {
    "tStartMs": 3285640,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "It is delicious."
    } ]
  }, {
    "tStartMs": 3287640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I like the oven-roasted kind."
    } ]
  }, {
    "tStartMs": 3290640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Something like Gochubbasak. I think you'd definitely like it."
    } ]
  }, {
    "tStartMs": 3293640,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Oven-roasted. Then it would definitely be delicious."
    } ]
  }, {
    "tStartMs": 3297640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I should order delivery today."
    } ]
  }, {
    "tStartMs": 3300640,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "Good idea. I mistakenly thought I had caught COVID there and ordered an extra sauce."
    } ]
  }, {
    "tStartMs": 3308000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm taking this opportunity to say."
    } ]
  }, {
    "tStartMs": 3311000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Well. But at least there's something to say about that."
    } ]
  }, {
    "tStartMs": 3316000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I've never eaten at that restaurant in person, but I order delivery from there quite often."
    } ]
  }, {
    "tStartMs": 3319000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Oh really? That works then."
    } ]
  }, {
    "tStartMs": 3321000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "My mother likes it, so that's why."
    } ]
  }, {
    "tStartMs": 3325000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I'll try it sometime too."
    } ]
  }, {
    "tStartMs": 3327000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes. I recommend it."
    } ]
  }, {
    "tStartMs": 3329000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Then let's wrap up our conversation here for today."
    } ]
  }, {
    "tStartMs": 3334359,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Today we talked about delivery from all angles,"
    } ]
  }, {
    "tStartMs": 3337359,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "so what should we cover next time?"
    } ]
  }, {
    "tStartMs": 3341359,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Like I mentioned earlier,"
    } ]
  }, {
    "tStartMs": 3344359,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "that homemade burger place in Busan and"
    } ]
  }, {
    "tStartMs": 3349359,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "should we talk about hamburgers in general?"
    } ]
  }, {
    "tStartMs": 3352359,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ah. That sounds good. It seems like you have a lot to say about it."
    } ]
  }, {
    "tStartMs": 3355359,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "About that burger restaurant."
    } ]
  }, {
    "tStartMs": 3357359,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Other than that, just about hamburgers as a food in general."
    } ]
  }, {
    "tStartMs": 3362720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Hamburgers are pretty good, right?"
    } ]
  }, {
    "tStartMs": 3364720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I like them too."
    } ]
  }, {
    "tStartMs": 3366720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Then next week we'll talk about hamburgers"
    } ]
  }, {
    "tStartMs": 3368720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "from all angles."
    } ]
  }, {
    "tStartMs": 3370720,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And if there are any topics you'd like us to discuss in the future,"
    } ]
  }, {
    "tStartMs": 3375720,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "please let us know through Spotify or YouTube comments, and we'd appreciate it."
    } ]
  }, {
    "tStartMs": 3380720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes. Thank you for your hard work today."
    } ]
  }, {
    "tStartMs": 3383720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 3392359,
    "dDurationMs": 8361,
    "segs": [ {
      "utf8": "Please like and subscribe."
    } ]
  } ]
