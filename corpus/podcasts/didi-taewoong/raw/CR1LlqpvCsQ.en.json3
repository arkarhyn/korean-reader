    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "Jeong Tae-woong's YouTube channels are Comprehensible Input Korean and All Things Korean."
    } ]
  }, {
    "tStartMs": 3030000,
    "dDurationMs": 14240,
    "segs": [ {
      "utf8": "In the past, I used to spend about 15 to 20 minutes every day wondering which chicken restaurant to order from, which chicken brand to have delivered."
    } ]
  }, {
    "tStartMs": 3044240,
    "dDurationMs": 14160,
    "segs": [ {
      "utf8": "But now, no matter where I am, no matter where I order from, no matter where I live, whether I go to a friend's place or a relative's place, I have one clear criterion for choosing."
    } ]
  }, {
    "tStartMs": 3058599,
    "dDurationMs": 1241,
    "segs": [ {
      "utf8": "Hmm, what is it?"
    } ]
  }, {
    "tStartMs": 3059840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The place where I can get the most delicious chicken."
