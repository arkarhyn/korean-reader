  }, {
    "tStartMs": 1533760,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 1534799,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "in most cases."
    } ]
  }, {
    "tStartMs": 1537119,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "I've been learning programming lately, you know."
    } ]
  }, {
    "tStartMs": 1540679,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Yes, programming, what—"
    } ]
  }, {
    "tStartMs": 1542399,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So as I do that,"
    } ]
  }, {
    "tStartMs": 1544799,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "I keep constantly thinking about what kind of service I could make using this programming."
    } ]
  }, {
    "tStartMs": 1548399,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "Yes."
