  }, {
    "tStartMs": 1830719,
    "dDurationMs": 5441,
    "segs": [ {
      "utf8": "Now that I think about it, it seems like Yogiyo was the first to start that pass."
    } ]
  }, {
    "tStartMs": 1836160,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "The subscription service."
    } ]
  }, {
    "tStartMs": 1838959,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "So since I'm a Yogipass subscriber."
    } ]
  }, {
    "tStartMs": 1843480,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "The restaurants that qualify for Yogipass."
    } ]
  }, {
    "tStartMs": 1847840,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "Just have free delivery."
    } ]
  }, {
    "tStartMs": 1850599,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "If you only pay 2,900 won per month?"
    } ]
  }, {
    "tStartMs": 1852279,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1853759,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "That's so good though?"
    } ]
  }, {
    "tStartMs": 1855160,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "Right, even if you order just once a month, it's a win, right?"
    } ]
  }, {
    "tStartMs": 1857919,
    "dDurationMs": 4441,
    "segs": [ {
      "utf8": "Exactly, when you order usually it's about 2,000 to 3,000 won."
    } ]
  }, {
    "tStartMs": 1862360,
    "dDurationMs": 2599,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1864959,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "It's the best, the best."
    } ]
  }, {
    "tStartMs": 1866040,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "Ah, I'm not sure what I think about that kind of event."
    } ]
  }, {
    "tStartMs": 1868919,
    "dDurationMs": 521,
    "segs": [ {
      "utf8": "So that's the thing."
    } ]
  }, {
    "tStartMs": 1869440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It seems really clever."
    } ]
  }, {
    "tStartMs": 1870760,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "But I'm curious whether it actually sustains itself if you do that."
    } ]
  }, {
    "tStartMs": 1874639,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Ah, is there any profit left over?"
    } ]
  }, {
    "tStartMs": 1875839,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1877519,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Right?"
    } ]
  }, {
    "tStartMs": 1882199,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Baemin also originally didn't have a pass like that."
    } ]
  }, {
    "tStartMs": 1886959,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "I think it came out last year or something."
    } ]
  }, {
    "tStartMs": 1889680,
    "dDurationMs": 1239,
    "segs": [ {
      "utf8": "Ah, last year."
    } ]
  }, {
    "tStartMs": 1890919,
    "dDurationMs": 3841,
    "segs": [ {
      "utf8": "Yes, I also got it because of an event back then."
    } ]
  }, {
    "tStartMs": 1894760,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "Like six months free?"
    } ]
  }, {
    "tStartMs": 1896959,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "You can cancel anytime."
    } ]
  }, {
    "tStartMs": 1898440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I did that."
    } ]
  }, {
    "tStartMs": 1901080,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "After six months I got so used to it."
    } ]
  }, {
    "tStartMs": 1903440,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "It was just so convenient."
    } ]
  }, {
    "tStartMs": 1906680,
    "dDurationMs": 3559,
    "segs": [ {
      "utf8": "So I'm still paying for it now."
    } ]
  }, {
    "tStartMs": 1910239,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "How much is Baemin per month?"
    } ]
  }, {
    "tStartMs": 1912519,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "I don't remember."
    } ]
  }, {
    "tStartMs": 1913800,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "But it's not that expensive."
    } ]
  }, {
    "tStartMs": 1915839,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "I think it was similar."
    } ]
  }, {
    "tStartMs": 1918360,
    "dDurationMs": 4279,
    "segs": [ {
      "utf8": "This is the kind of economic structure that Freemium does, right?"
    } ]
  }, {
    "tStartMs": 1922639,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "How so?"
    } ]
  }, {
    "tStartMs": 1923639,
    "dDurationMs": 8441,
    "segs": [ {
      "utf8": "So if 100 people all sign up for Yogipass."
    } ]
  }, {
    "tStartMs": 1932080,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "If those 100 people all spend more than 2,900 won a month on delivery fees."
    } ]
  }, {
    "tStartMs": 1941320,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "So they all use free delivery."
    } ]
  }, {
    "tStartMs": 1944119,
    "dDurationMs": 481,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1944600,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Then obviously Yogiyo would be losing money, right?"
    } ]
  }, {
    "tStartMs": 1947240,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1948080,
    "dDurationMs": 11000,
    "segs": [ {
      "utf8": "But what if out of 100 people, like 90 people bought Yogipass."
    } ]
  }, {
    "tStartMs": 1959080,
    "dDurationMs": 5399,
    "segs": [ {
      "utf8": "But what if they don't use delivery and don't order delivery."
    } ]
  }, {
    "tStartMs": 1964479,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Then Yogiyo would make money, right?"
    } ]
  }, {
    "tStartMs": 1967440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1969000,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "So there are people like that, right?"
    } ]
  }, {
    "tStartMs": 1970839,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1972119,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Donors."
    } ]
  }, {
    "tStartMs": 1974119,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1976080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They just donate and forget about it."
    } ]
  }, {
    "tStartMs": 1977880,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1979600,
    "dDurationMs": 2679,
    "segs": [ {
      "utf8": "There are quite a few people like that."
    } ]
  }, {
    "tStartMs": 1982279,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Anyway, we're really going back and forth about delivery here."
    } ]
  }, {
    "tStartMs": 1986639,
    "dDurationMs": 3161,
    "segs": [ {
      "utf8": "Yeah, how long have we been talking?"
    } ]
  }, {
    "tStartMs": 1989800,
    "dDurationMs": 3599,
    "segs": [ {
      "utf8": "So do you order delivery pretty often?"
    } ]
  }, {
    "tStartMs": 1993399,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "I think I order delivery about once a week."
    } ]
  }, {
    "tStartMs": 1999039,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "That's not that much, right?"
    } ]
  }, {
    "tStartMs": 2001720,
    "dDurationMs": 4839,
    "segs": [ {
      "utf8": "Right, I go back and forth to my parents' place a lot."
    } ]
  }, {
    "tStartMs": 2006559,
    "dDurationMs": 6601,
    "segs": [ {
      "utf8": "When I go to my parents' I either cook or eat what my parents make."
    } ]
  }, {
    "tStartMs": 2013160,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "When I'm alone I order sometimes."
    } ]
  }, {
    "tStartMs": 2017520,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "Do you usually order lunch? Or dinner?"
    } ]
  }, {
    "tStartMs": 2020399,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I usually order lunch."
    } ]
  }, {
    "tStartMs": 2023279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Lunch?"
    } ]
  }, {
    "tStartMs": 2024279,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2025399,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "Hmm."
    } ]
  }, {
    "tStartMs": 2027360,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Do you eat breakfast, lunch, and dinner all together?"
    } ]
  }, {
    "tStartMs": 2029240,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "I eat all three meals."
    } ]
  }, {
    "tStartMs": 2033880,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "I eat three meals a day, so ordering once a week seems pretty reasonable."
    } ]
  }, {
    "tStartMs": 2039240,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2041039,
    "dDurationMs": 6880,
    "segs": [ {
      "utf8": "Delivery, we're really going back and forth about delivery like this."
    } ]
  }, {
    "tStartMs": 2047919,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "I'm going to tell you the whole story of yongho-jonghо."
    } ]
  }, {
    "tStartMs": 2051559,
    "dDurationMs": 521,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2052080,
    "dDurationMs": 3039,
    "segs": [ {
      "utf8": "So there was an episode that happened."
    } ]
  }, {
    "tStartMs": 2055119,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It came about while using a delivery app."
    } ]
  }, {
    "tStartMs": 2060000,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "You know that hamburger restaurant I mentioned at the beginning?"
    } ]
  }, {
    "tStartMs": 2064640,
    "dDurationMs": 6680,
    "segs": [ {
      "utf8": "I used to always go there and eat,"
    } ]
  }, {
    "tStartMs": 2071320,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "but after I caught COVID for the first time in my life last July,"
    } ]
  }, {
    "tStartMs": 2077760,
    "dDurationMs": 6479,
    "segs": [ {
      "utf8": "I placed a delivery order from that hamburger restaurant for the first time."
    } ]
  }, {
    "tStartMs": 2084279,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "But at that restaurant,"
    } ]
  }, {
    "tStartMs": 2090279,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "I couldn't say \"This is Jeong Tae-woong,\""
    } ]
  }, {
    "tStartMs": 2092959,
    "dDurationMs": 521,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2093480,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "My name—"
    } ]
  }, {
    "tStartMs": 2094279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Do they know your name?"
    } ]
  }, {
    "tStartMs": 2095279,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "They don't know my name either."
    } ]
  }, {
    "tStartMs": 2097920,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "But anyway, I used to always go there and eat,"
    } ]
  }, {
    "tStartMs": 2103720,
    "dDurationMs": 4239,
    "segs": [ {
      "utf8": "and since I had COVID, I placed a delivery order."
    } ]
  }, {
    "tStartMs": 2108000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I hope you sell a lot today."
    } ]
  }, {
    "tStartMs": 2109200,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "I wrote a request message like that."
    } ]
  }, {
    "tStartMs": 2114920,
    "dDurationMs": 4159,
    "segs": [ {
      "utf8": "Even though you're a man, you always leave warm messages."
    } ]
  }, {
    "tStartMs": 2119079,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "There's no reason a man can't be warm."
    } ]
  }, {
    "tStartMs": 2123000,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "I don't leave reviews, though."
    } ]
  }, {
    "tStartMs": 2124720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "But that's a different matter."
    } ]
  }, {
    "tStartMs": 2128000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That's nice—when you give little words like that,"
    } ]
  }, {
    "tStartMs": 2131000,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Yeah, but"
    } ]
  }, {
    "tStartMs": 2134640,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "that was Baemin at the time."
    } ]
  }, {
    "tStartMs": 2138880,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "At that time, that restaurant wasn't on Yogiyo,"
    } ]
  }, {
    "tStartMs": 2141880,
    "dDurationMs": 1359,
    "segs": [ {
      "utf8": "Or was it free delivery?"
    } ]
  }, {
    "tStartMs": 2143239,
    "dDurationMs": 4241,
    "segs": [ {
      "utf8": "Because free delivery was only available on Baemin,"
    } ]
  }, {
    "tStartMs": 2147480,
    "dDurationMs": 7520,
    "segs": [ {
      "utf8": "Anyway, I sent that message and received and ate the food,"
    } ]
  }, {
    "tStartMs": 2155000,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "and even then they included something like a Vita 500 bottle and all that,"
    } ]
  }, {
    "tStartMs": 2159720,
    "dDurationMs": 6239,
    "segs": [ {
      "utf8": "but after COVID cleared up,"
    } ]
  }, {
    "tStartMs": 2165959,
    "dDurationMs": 8081,
    "segs": [ {
      "utf8": "I tried to order different food with my mom."
    } ]
  }, {
    "tStartMs": 2174040,
    "dDurationMs": 5919,
    "segs": [ {
      "utf8": "But that restaurant also wasn't on the Yogiyo app, so I used Baemin,"
    } ]
  }, {
    "tStartMs": 2179959,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "and I just ordered without thinking."
    } ]
  }, {
    "tStartMs": 2183000,
    "dDurationMs": 5839,
    "segs": [ {
      "utf8": "But I had ordered chicken,"
    } ]
  }, {
    "tStartMs": 2188839,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "and suddenly some kind of chicken gizzard or something"
    } ]
  }, {
    "tStartMs": 2191320,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "came as a service."
    } ]
  }, {
    "tStartMs": 2193279,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "Yeah, it's a different restaurant from that hamburger place."
    } ]
  }, {
    "tStartMs": 2195720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It's a different restaurant, a different one."
    } ]
  }, {
    "tStartMs": 2197880,
    "dDurationMs": 3239,
    "segs": [ {
      "utf8": "But I don't know why they gave me a service,"
    } ]
  }, {
    "tStartMs": 2201119,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "but there was a Post-it note on it"
    } ]
  }, {
    "tStartMs": 2202959,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "that said \"Eat deliciously and get better soon.\""
    } ]
  }, {
    "tStartMs": 2206440,
    "dDurationMs": 7679,
    "segs": [ {
      "utf8": "That was the request message I had written for the hamburger restaurant, and it was still saved there."
    } ]
  }, {
    "tStartMs": 2214119,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "Baemin saves it like that."
    } ]
  }, {
    "tStartMs": 2217359,
    "dDurationMs": 4641,
    "segs": [ {
      "utf8": "So it's a restaurant I've never been to even once,"
    } ]
  }, {
    "tStartMs": 2222000,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "and they actually wrote it by hand on a real Post-it note with a smiling face too."
    } ]
  }, {
    "tStartMs": 2226440,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "You liar."
    } ]
  }, {
    "tStartMs": 2228399,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So I felt so sorry."
    } ]
  }, {
    "tStartMs": 2231519,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "So the next time,"
    } ]
  }, {
    "tStartMs": 2235559,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "I used Yogiyo for a while again,"
    } ]
  }, {
    "tStartMs": 2238480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and then I made that mistake one more time?"
    } ]
  }, {
    "tStartMs": 2240480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Anyway, and then"
    } ]
  }, {
    "tStartMs": 2242760,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "this one was intentional."
    } ]
  }, {
    "tStartMs": 2243920,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "The second time was intentional."
    } ]
  }, {
    "tStartMs": 2245359,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "No, no, so"
    } ]
  }, {
    "tStartMs": 2247880,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "so it was last week or the week before last,"
    } ]
  }, {
    "tStartMs": 2250320,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "it was relatively recent,"
    } ]
  }, {
    "tStartMs": 2253720,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and then I had to use Baemin again,"
    } ]
  }, {
    "tStartMs": 2257200,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "so I used Baemin once,"
    } ]
  }, {
    "tStartMs": 2260720,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "but that time I didn't forget and checked to make sure—"
    } ]
  }, {
    "tStartMs": 2264920,
    "dDurationMs": 4199,
    "segs": [ {
      "utf8": "As expected, that request was written in there too."
    } ]
  }, {
    "tStartMs": 2269119,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "It was automatically saved,"
    } ]
  }, {
    "tStartMs": 2271959,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "so I deleted that"
    } ]
  }, {
    "tStartMs": 2275239,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and you can leave out the pickled radish."
    } ]
  }, {
    "tStartMs": 2276839,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "That's all I wrote."
    } ]
  }, {
    "tStartMs": 2277959,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2279079,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "But"
    } ]
  }, {
    "tStartMs": 2281920,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "But"
    } ]
  }, {
    "tStartMs": 2284119,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "But when I changed the food, a service came again."
    } ]
  }, {
    "tStartMs": 2287000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "A chicken place?"
    } ]
  }, {
