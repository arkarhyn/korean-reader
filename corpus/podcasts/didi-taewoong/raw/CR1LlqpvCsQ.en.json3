  }, {
    "tStartMs": 1515920,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "You can tell the difference."
    } ]
  }, {
    "tStartMs": 1518799,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "Those people who just upload photos,"
    } ]
  }, {
    "tStartMs": 1520720,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "people who give good scores and just upload photos,"
    } ]
  }, {
    "tStartMs": 1522920,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "those people are likely to be event participants,"
