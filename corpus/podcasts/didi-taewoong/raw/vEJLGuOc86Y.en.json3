  }, {
    "tStartMs": 1618700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the good teachers stay in your memory more."
    } ]
  }, {
    "tStartMs": 1621200,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's true."
    } ]
  }, {
    "tStartMs": 1622700,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Yes. After I talk about this and try to wrap up, I realize"
    } ]
  }, {
    "tStartMs": 1626420,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "this thought just flashed through my mind,"
