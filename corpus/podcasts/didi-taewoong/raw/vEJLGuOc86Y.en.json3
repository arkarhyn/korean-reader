  }, {
    "tStartMs": 1607200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and the distant future comes,"
    } ]
  }, {
    "tStartMs": 1609700,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "you'll probably remember the teachers you disliked more, right?"
    } ]
  }, {
    "tStartMs": 1615200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But as time goes on,"
