  }, {
    "tStartMs": 1633420,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "it's better for you to get rid of it as early as possible."
    } ]
  }, {
    "tStartMs": 1638420,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "for yourself,"
