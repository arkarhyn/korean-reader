  }, {
    "tStartMs": 2902279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2903279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "If I'm better than the people next to me, I can succeed, right?"
    } ]
  }, {
    "tStartMs": 2907279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The mindset is just to beat the person next to you."
    } ]
  }, {
    "tStartMs": 2910279,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2913280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I get what you mean."
