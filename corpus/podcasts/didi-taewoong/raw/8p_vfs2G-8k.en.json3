  }, {
    "tStartMs": 2926280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The lesson is good,"
    } ]
  }, {
    "tStartMs": 2928280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but it's a bit hard to accept."
    } ]
  }, {
    "tStartMs": 2930280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You learned this from cockroaches."
