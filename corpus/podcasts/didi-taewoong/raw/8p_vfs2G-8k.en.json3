  }, {
    "tStartMs": 2916280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You don't need anything grand,"
    } ]
  }, {
    "tStartMs": 2919280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "just be number one among those nearby, kind of that mindset."
