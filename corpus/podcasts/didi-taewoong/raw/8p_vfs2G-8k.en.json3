  }, {
    "tStartMs": 2615279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "To annoy my friends."
    } ]
  }, {
    "tStartMs": 2617279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "There's something I used to say often."
    } ]
  }, {
    "tStartMs": 2619279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Do you know? About cockroaches."
