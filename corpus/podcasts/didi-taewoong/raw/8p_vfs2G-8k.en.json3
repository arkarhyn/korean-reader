  }, {
    "tStartMs": 2726279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and you should always keep two bottles of full shampoo cockroach repellent and stuff like that on hand"
    } ]
  }, {
    "tStartMs": 2730279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Oh but anyway, so about that Bangladesh house story"
    } ]
  }, {
    "tStartMs": 2734279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "that last story I was trying to tell"
    } ]
  }, {
    "tStartMs": 2738279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Last story?"
    } ]
  }, {
    "tStartMs": 2740279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "After that, I realized something important"
    } ]
  }, {
    "tStartMs": 2743279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and this principle"
    } ]
  }, {
    "tStartMs": 2746279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "applies to many things in life, not most things but many"
    } ]
  }, {
    "tStartMs": 2749279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and I realized that"
    } ]
  }, {
    "tStartMs": 2752279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I came up with a name for it"
