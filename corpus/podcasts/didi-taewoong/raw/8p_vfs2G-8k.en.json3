    "segs": [ {
      "utf8": "Oh"
    } ]
  }, {
    "tStartMs": 2757279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "how to survive when you meet a bear in the forest"
    } ]
  }, {
    "tStartMs": 2762279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that's the rule"
    } ]
  }, {
    "tStartMs": 2765279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I went to the forest with friends"
    } ]
  }, {
    "tStartMs": 2769279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and when you meet a bear in that forest to survive"
    } ]
  }, {
    "tStartMs": 2773279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "you don't need to be faster than the bear"
    } ]
  }, {
    "tStartMs": 2777279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you just need to be faster than your friend"
    } ]
  }, {
    "tStartMs": 2779279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Huh?"
    } ]
  }, {
    "tStartMs": 2781279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2782279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's pretty selfish, right?"
    } ]
  }, {
    "tStartMs": 2783279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I shouldn't be friends with Teacher Tae-woong"
    } ]
  }, {
    "tStartMs": 2786279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "No, I won't call them a friend"
    } ]
  }, {
    "tStartMs": 2788279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you just need to be faster than the other people in that forest"
    } ]
  }, {
    "tStartMs": 2791279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Oh, so as long as it's not me"
    } ]
  }, {
    "tStartMs": 2794279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Yes, to survive from a bear chasing people"
    } ]
  }, {
    "tStartMs": 2798279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you don't need a speed faster than the bear"
    } ]
  }, {
    "tStartMs": 2801279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you just need to be faster than the person next to you"
    } ]
  }, {
    "tStartMs": 2803279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you just need to be faster than the person next to you"
    } ]
  }, {
    "tStartMs": 2805279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes, so that's the thing."
    } ]
  }, {
    "tStartMs": 2808279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "In that apartment, that villa, that building,"
    } ]
  }, {
    "tStartMs": 2812279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "there could be cockroaches."
    } ]
  }, {
    "tStartMs": 2815279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2816279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But if my place doesn't have anything that cockroaches would like"
    } ]
  }, {
    "tStartMs": 2821279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "compared to the neighbors' places above and below,"
    } ]
  }, {
    "tStartMs": 2825279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "then there might not be cockroaches in my home."
    } ]
  }, {
    "tStartMs": 2830279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "There would have been way more in the next-door unit, Teacher Tae-woong."
    } ]
  }, {
    "tStartMs": 2833279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "They all went to the next-door place."
    } ]
  }, {
    "tStartMs": 2835279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Right, because there's really nothing to eat in my place,"
    } ]
  }, {
    "tStartMs": 2839279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and nothing to hide in,"
    } ]
  }, {
    "tStartMs": 2841279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and it smells like toothpaste,"
    } ]
  }, {
    "tStartMs": 2843279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "and it smells like toothpaste,"
    } ]
  }, {
    "tStartMs": 2844279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and honestly, no lie,"
    } ]
  }, {
    "tStartMs": 2847279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "out of those 10 months, except for 2 weeks, cockroaches didn't appear even once."
    } ]
  }, {
    "tStartMs": 2851279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh my, yes."
    } ]
  }, {
    "tStartMs": 2852279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But when I think about it carefully, I wonder if that's the reason."
    } ]
  }, {
    "tStartMs": 2856279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "They went to a different place, right?"
    } ]
  }, {
    "tStartMs": 2858279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You can't eradicate them completely,"
    } ]
  }, {
    "tStartMs": 2860279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so even if you don't eradicate them,"
    } ]
  }, {
    "tStartMs": 2863279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "as long as you're cleaner than the next place, that's enough."
    } ]
  }, {
    "tStartMs": 2867279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The way to reduce the probability of cockroaches appearing is"
    } ]
  }, {
    "tStartMs": 2872279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to keep your place cleaner than the neighbors'."
    } ]
  }, {
    "tStartMs": 2874279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2877279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So this isn't just about cockroaches,"
    } ]
  }, {
    "tStartMs": 2881279,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "but I realized it applies to many parts of life."
    } ]
  }, {
    "tStartMs": 2887279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2889279,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Like in the blind date episode we talked about last time,"
    } ]
  }, {
    "tStartMs": 2895279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I don't have to be the most attractive man in the world"
    } ]
  }, {
    "tStartMs": 2899279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to succeed at dating, right?"
