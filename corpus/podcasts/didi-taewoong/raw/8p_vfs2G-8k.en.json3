  }, {
    "tStartMs": 2932280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2934280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's how harsh the world is."
    } ]
  }, {
    "tStartMs": 2936280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's not easy."
    } ]
  }, {
    "tStartMs": 2938280,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "If you slack off a little, your place becomes a cockroach house."
