  }, {
    "tStartMs": 2621279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ugh, that annoys me."
    } ]
  }, {
    "tStartMs": 2624279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 2625279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That they taste similar to shrimp?"
    } ]
  }, {
    "tStartMs": 2627279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Or that the species is similar?"
    } ]
  }, {
    "tStartMs": 2629279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Species?"
    } ]
  }, {
    "tStartMs": 2630279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes, biologically"
    } ]
  }, {
    "tStartMs": 2633279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "they're very similar, apparently"
    } ]
  }, {
    "tStartMs": 2636279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So anyway"
    } ]
  }, {
    "tStartMs": 2638279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I think I mentioned this to you before, Didi? How did you know?"
    } ]
  }, {
    "tStartMs": 2640279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Oh, this really frustrated me a lot"
    } ]
  }, {
    "tStartMs": 2643279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I have friends who always do this when I'm eating shrimp"
    } ]
  }, {
    "tStartMs": 2646279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You know that? They say shrimp and cockroaches taste exactly the same"
    } ]
  }, {
    "tStartMs": 2649279,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 2650279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The way I explain it"
    } ]
  }, {
    "tStartMs": 2653279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is when we go to a sushi restaurant"
    } ]
  }, {
    "tStartMs": 2655279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you know that raw shrimp sushi they have?"
    } ]
  }, {
    "tStartMs": 2657279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "raw shrimp sushi marinated in soy sauce"
    } ]
  }, {
    "tStartMs": 2660279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so anyway"
    } ]
  }, {
    "tStartMs": 2664279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "cockroaches too"
    } ]
  }, {
    "tStartMs": 2667279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "would taste like raw shrimp sushi that way"
    } ]
  }, {
    "tStartMs": 2670279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Oh my gosh"
    } ]
  }, {
    "tStartMs": 2673279,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Why are you like that? You're the one who even bought a cockroach house"
    } ]
  }, {
    "tStartMs": 2679279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "After that, I don't bring it up anymore"
    } ]
  }, {
    "tStartMs": 2683279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It's really disgusting"
    } ]
  }, {
    "tStartMs": 2687279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "No, no, no"
    } ]
  }, {
    "tStartMs": 2690279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "They're clearly different species"
    } ]
  }, {
    "tStartMs": 2693279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and I'm pretty sure they'd taste completely different"
    } ]
  }, {
    "tStartMs": 2696279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes, they're different"
    } ]
  }, {
    "tStartMs": 2699279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Right, what was their ancestor or something?"
    } ]
  }, {
    "tStartMs": 2702279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Oh, I think that was it"
    } ]
  }, {
    "tStartMs": 2706279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I bet their appetite dropped completely"
    } ]
  }, {
    "tStartMs": 2709279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "For those listening to this podcast"
    } ]
  }, {
    "tStartMs": 2712279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm sorry, oh back then we used to"
    } ]
  }, {
    "tStartMs": 2715279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "talk about delicious things like hamburgers"
    } ]
  }, {
    "tStartMs": 2718279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so now with cockroaches and stuff like that"
    } ]
  }, {
    "tStartMs": 2721279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I need to make sure to clean well so they don't show up"
    } ]
  }, {
    "tStartMs": 2724279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Oh, you really have to keep it really clean"
