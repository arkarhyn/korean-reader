  }, {
    "tStartMs": 2608279,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The appearance is disgusting, but."
    } ]
  }, {
    "tStartMs": 2611279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But I."
    } ]
  }, {
    "tStartMs": 2613279,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I kind of."
