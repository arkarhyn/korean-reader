{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "\u003cDidi와 정태웅의 한국생활 요모조모\u003e"
    } ]
  }, {
    "tStartMs": 9470,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "안녕하세요, Didi입니다!"
    } ]
  }, {
    "tStartMs": 11290,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "안녕하세요, 정태웅입니다"
    } ]
  }, {
    "tStartMs": 13760,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "\u003c한국생활 요모조모\u003e는 한국에서 살아가는 두 사람이"
    } ]
  }, {
    "tStartMs": 17650,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "한국생활의 요모조모를 이야기하는 팟캐스트입니다"
    } ]
  }, {
    "tStartMs": 21310,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "잘 지내셨나요 태웅쌤?"
    } ]
  }, {
    "tStartMs": 22850,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "네 오랜만입니다 한 달 만이네요"
    } ]
  }, {
    "tStartMs": 24940,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "한 달 만이네요"
    } ]
  }, {
    "tStartMs": 26080,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "요즘 \u003cAll Things Korean (태웅쌤 채널)\u003e도 볼 수 없기 때문에"
    } ]
  }, {
    "tStartMs": 30400,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "보고 싶어 하시는 분들 많았을 것 같아요 태웅쌤을"
    } ]
  }, {
    "tStartMs": 33480,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 34530,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그래서 영상으로 돌아왔습니다"
    } ]
  }, {
    "tStartMs": 36850,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "그러니까요 얼굴 보여드리려고 영상으로 또 하고 있으니까"
    } ]
  }, {
    "tStartMs": 41390,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "영상으로 보고 싶으신 분들은 같이 확인해 주시고요"
    } ]
  }, {
    "tStartMs": 46640,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "오늘 이야기할 주제를 이야기하기 전에"
    } ]
  }, {
    "tStartMs": 49630,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "저번 에피소드에서 퀴즈를 냈었어요"
    } ]
  }, {
    "tStartMs": 52740,
    "dDurationMs": 6520,
    "segs": [ {
      "utf8": "그런데 정답을 맞춰주신 분들이 계셨어서 발표를 하도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 59260,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "저번주에 퀴즈 맞춰주신 분은"
    } ]
  }, {
    "tStartMs": 61730,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "다이앤님,"
    } ]
  }, {
    "tStartMs": 62780,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "광미애님,"
    } ]
  }, {
    "tStartMs": 63930,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "알리님,"
    } ]
  }, {
    "tStartMs": 65120,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "자야님,"
    } ]
  }, {
    "tStartMs": 66040,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "그리고 메르베님이셨어요"
    } ]
  }, {
    "tStartMs": 68450,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "정답이 2번이었어요 2번"
    } ]
  }, {
    "tStartMs": 71100,
    "dDurationMs": 5940,
    "segs": [ {
      "utf8": "한국의 공식적인 장마철은 15일이다 였나요?"
    } ]
  }, {
    "tStartMs": 77040,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "30일이다 였는데"
    } ]
  }, {
    "tStartMs": 79500,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "30일로 정할 수가 없었어요"
    } ]
  }, {
    "tStartMs": 82430,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "그래서 퀴즈 틀린 답이 2번이었고 맞춰주신 분들이 계셨고요"
    } ]
  }, {
    "tStartMs": 87780,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "오늘도 퀴즈가 있으니까 퀴즈 정답 아시는 분은"
    } ]
  }, {
    "tStartMs": 91760,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "댓글로 남겨주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 94250,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "그러면 오늘의 주제 소개해 주실 수 있을까요?"
    } ]
  }, {
    "tStartMs": 97360,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "오늘의 주제는 바로바로 영화관입니다"
    } ]
  }, {
    "tStartMs": 101600,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "영화관"
    } ]
  }, {
    "tStartMs": 103890,
    "dDurationMs": 6190,
    "segs": [ {
      "utf8": "그래서 여러분들은 영화를 영화관에서 많이 보시는지 어떤지 모르겠지만"
    } ]
  }, {
    "tStartMs": 110080,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "한국 영화관은 어떤 특징이 있는지"
    } ]
  }, {
    "tStartMs": 112740,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "그런 것들 한번 이야기해 보려고 하고요"
    } ]
  }, {
    "tStartMs": 116260,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "시작 전 퀴즈입니다"
    } ]
  }, {
    "tStartMs": 119230,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "오늘도 세 가지 문장을 말씀드릴 거고요"
    } ]
  }, {
    "tStartMs": 122740,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "틀린 답 하나 찾아주시면 됩니다"
    } ]
  }, {
    "tStartMs": 126260,
    "dDurationMs": 8860,
    "segs": [ {
      "utf8": "첫 번째는 영화 시작 전에 광고와 예고편이 15분에서 20분 정도 나온다"
    } ]
  }, {
    "tStartMs": 135120,
    "dDurationMs": 5850,
    "segs": [ {
      "utf8": "두 번째는 매주 수요일은 영화 티켓이 저렴하다"
    } ]
  }, {
    "tStartMs": 140970,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "세 번째는 한국영화관에서는 떡볶이를 먹을 수 있다"
    } ]
  }, {
    "tStartMs": 147170,
    "dDurationMs": 6250,
    "segs": [ {
      "utf8": "네 정답을 아시는 분은 아래 댓글로 남겨주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 153420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "태웅쌤은 영화관은 자주 가시나요?"
    } ]
  }, {
    "tStartMs": 156030,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "저는 자주 가지는 않아요 요즘은"
    } ]
  }, {
    "tStartMs": 159550,
    "dDurationMs": 6470,
    "segs": [ {
      "utf8": "그래도 이번 에피소드를 위해 며칠 전에 영화관 가서 영화 보고 왔습니다"
    } ]
  }, {
    "tStartMs": 166020,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "우와 무슨 영화 보셨어요?"
    } ]
  }, {
    "tStartMs": 168190,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "저는 'F1'"
    } ]
  }, {
    "tStartMs": 170750,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "와! 저도!"
    } ]
  }, {
    "tStartMs": 173010,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "저도 봤어요 어땠어요?"
    } ]
  }, {
    "tStartMs": 176050,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "재밌더라고요"
    } ]
  }, {
    "tStartMs": 177160,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "저 4D로 봤거든요"
    } ]
  }, {
    "tStartMs": 178690,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "4D요?"
    } ]
  }, {
    "tStartMs": 179820,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "네 4D는 의자가 막 움직여요"
    } ]
  }, {
    "tStartMs": 184960,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "옛날부터 항상 4D로 자주 보네요"
    } ]
  }, {
    "tStartMs": 187900,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "4D는 그런 액션이 많은 영화를 볼 때 재밌더라고요"
    } ]
  }, {
    "tStartMs": 193270,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "와, 그거 4D로 보면 재밌겠다"
    } ]
  }, {
    "tStartMs": 196940,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "아니, 저도 몰랐는데"
    } ]
  }, {
    "tStartMs": 198530,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "4D 딱 그 영화 예매할 수 있는 게 있더라고요"
    } ]
  }, {
    "tStartMs": 203050,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "근데 매진인 거예요, 다"
    } ]
  }, {
    "tStartMs": 205490,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "그래서 '아, 이거는 4D인가 보다!"
    } ]
  }, {
    "tStartMs": 207780,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "사람들이 많이 보는 데는 이유가 있다.' 하고 봤는데 진짜 재밌었어요"
    } ]
  }, {
    "tStartMs": 212620,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "음 그게 그러면 가장 최근에 본 영화예요?"
    } ]
  }, {
    "tStartMs": 216520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 217960,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "아 아직 그 '귀멸의 칼날'이 개봉을 안 했구나"
    } ]
  }, {
    "tStartMs": 221910,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "개봉을 했는데 아직 못 봤어요"
    } ]
  }, {
    "tStartMs": 224430,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 225380,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "네, 볼 거예요 이번 주에"
    } ]
  }, {
    "tStartMs": 227100,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "그거 엄청 기대하고 계시잖아요"
    } ]
  }, {
    "tStartMs": 229410,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "지금도 엄청 기대 중이에요"
    } ]
  }, {
    "tStartMs": 230950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "아, 보실 거예요? 태웅쌤은?"
    } ]
  }, {
    "tStartMs": 232660,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "저는 안 볼 것 같은데..."
    } ]
  }, {
    "tStartMs": 235440,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "왜요?"
    } ]
  }, {
    "tStartMs": 236990,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "저는 한 2년 뒤에 넷플릭스에 올라오면"
    } ]
  }, {
    "tStartMs": 240100,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "보지 않을까 싶은데, 네\n- 진짜로요?"
    } ]
  }, {
    "tStartMs": 242820,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "아이맥스로 보라고 하던데"
    } ]
  }, {
    "tStartMs": 245410,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 246610,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 247810,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "그 그림이 진짜 정성으로 그렸대요"
    } ]
  }, {
    "tStartMs": 252800,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "아, 그렇구나"
    } ]
  }, {
    "tStartMs": 253890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "심심하시면 한번 고려해보세요"
    } ]
  }, {
    "tStartMs": 255990,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "네, 일단 알겠습니다"
    } ]
  }, {
    "tStartMs": 258500,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "그러면 어느 영화관으로 가셨어요? 이번에 F1은?"
    } ]
  }, {
    "tStartMs": 262120,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "제가 이번에 본 곳은 롯데시네마였어요"
    } ]
  }, {
    "tStartMs": 266650,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "롯데시네마"
    } ]
  }, {
    "tStartMs": 268270,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "한국에 좀 메인 영화관이 3개가 있잖아요"
    } ]
  }, {
    "tStartMs": 272730,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "롯데시네마랑"
    } ]
  }, {
    "tStartMs": 273810,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "CGV,"
    } ]
  }, {
    "tStartMs": 274650,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "메가박스 이렇게인데"
    } ]
  }, {
    "tStartMs": 276830,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "원래 롯데시네마를 좀 자주 가세요?"
    } ]
  }, {
    "tStartMs": 280130,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "집 근처에 있는 게 롯데시네마고"
    } ]
  }, {
    "tStartMs": 285150,
    "dDurationMs": 8160,
    "segs": [ {
      "utf8": "그리고 저희... 제 이모의 남편인 이모부께서"
    } ]
  }, {
    "tStartMs": 293310,
    "dDurationMs": 7490,
    "segs": [ {
      "utf8": "롯데 회사에 좀 오래 다니셔서 높은 자리에 계신 분이세요\n-그런 인연이?"
    } ]
  }, {
    "tStartMs": 300800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "그래서 아주 가끔씩 제 생일이나 이럴 때"
    } ]
  }, {
    "tStartMs": 303380,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "이모께서 영화 티켓을 가끔 주십니다"
    } ]
  }, {
    "tStartMs": 307560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "아 그렇구나"
    } ]
  }, {
    "tStartMs": 309240,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "그래서 가기 좀 좋아요"
    } ]
  }, {
    "tStartMs": 311140,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그러면 자주 가게 되겠네요"
    } ]
  }, {
    "tStartMs": 312900,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 315730,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "제 집 주변에는 거의 다 있는데, CGV 그래도 많이 가는 것 같아요"
    } ]
  }, {
    "tStartMs": 320640,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "혹시 따로 거기를 자주 가는 이유가 있어요?"
    } ]
  }, {
    "tStartMs": 325380,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "일단 4D가 CGV에 있고,"
    } ]
  }, {
    "tStartMs": 328380,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "아이맥스나 그런 곳도 CGV가 유명한 것 같아요"
    } ]
  }, {
    "tStartMs": 333150,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "그렇구나"
    } ]
  }, {
    "tStartMs": 335300,
    "dDurationMs": 6170,
    "segs": [ {
      "utf8": "다양한 상영관, 특별 상영관 이런 게 많은 것 같아요"
    } ]
  }, {
    "tStartMs": 341470,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "근데 메가박스도 많이 가는데 메가박스는 특징이 있어요"
    } ]
  }, {
    "tStartMs": 346100,
    "dDurationMs": 7910,
    "segs": [ {
      "utf8": "거기는 대부분 자리가 리클라이너석이에요 아시나요? 되게 편안한 자리"
    } ]
  }, {
    "tStartMs": 354010,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "네, 리클라이너라고"
    } ]
  }, {
    "tStartMs": 355810,
    "dDurationMs": 7520,
    "segs": [ {
      "utf8": "버튼을 누르면 지잉- 하고 등받이가 뒤로 젖혀지는,"
    } ]
  }, {
    "tStartMs": 363330,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "이 다리 받침대가 올라와서"
    } ]
  }, {
    "tStartMs": 366070,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "맞아요 거의 누워서 볼 수 있어요"
    } ]
  }, {
    "tStartMs": 368450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "네 무슨 썬베드처럼"
    } ]
  }, {
    "tStartMs": 370430,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 371480,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "네 그런 의자죠\n- 거기도 좋아요"
    } ]
  }, {
    "tStartMs": 373770,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "좀 편안하게 보고 싶다 하면은 메가박스도 종종 갑니다"
    } ]
  }, {
    "tStartMs": 379970,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "제가 가는 곳도 전좌석이 다 리클라이너라서"
    } ]
  }, {
    "tStartMs": 385180,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "아 롯데시네마?"
    } ]
  }, {
    "tStartMs": 386180,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 387300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "요즘 많이 바뀌나봐요 다들"
    } ]
  }, {
    "tStartMs": 389500,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "그런가봐요"
    } ]
  }, {
    "tStartMs": 390700,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "음 그렇죠"
    } ]
  }, {
    "tStartMs": 392430,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "그런 메리트가... 요즘 넷플릭스가 워낙 잘 되어 있으니까"
    } ]
  }, {
    "tStartMs": 397830,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "영화관을 안 가시는 분들이 많은데"
    } ]
  }, {
    "tStartMs": 400450,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 400930,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "계속 오게 하려고 그런 이벤트나"
    } ]
  }, {
    "tStartMs": 404820,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "자리를 좀 더 편하게 한다거나 하는 게 있는 것 같아요"
    } ]
  }, {
    "tStartMs": 408840,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "맞아요 넷플릭스가 영향이 아주 크죠"
    } ]
  }, {
    "tStartMs": 411980,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "그렇죠 저도 뭐..."
    } ]
  }, {
    "tStartMs": 414930,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "그래도 저는 그래도 아직은 가는 것 같아요 영화관"
    } ]
  }, {
    "tStartMs": 418820,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "그렇죠 아 근데 리클라이너석이면..."
    } ]
  }, {
    "tStartMs": 422020,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "의자가 되게 편하고 되게 넓잖아요"
    } ]
  }, {
    "tStartMs": 424540,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 425570,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "그러다 보니까 예를 들어 썸을 타는 사람이랑 영화관에 같이 가면"
    } ]
  }, {
    "tStartMs": 431650,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "리클라이너 아닌 옛날 좌석은"
    } ]
  }, {
    "tStartMs": 434940,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "팔꿈치도 좀 부딪히고 그런 게 있는데"
    } ]
  }, {
    "tStartMs": 439050,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "손등도 삭삭 (스치는)하는 그런 낭만이 있었는데 이제는\n- 그쵸 낭만이 있었는데"
    } ]
  }, {
    "tStartMs": 443320,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "이제는 없어요\n- 그냥 편안하게ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 447440,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "뭔가 어색할 것 같기도 하네요 썸 타는 시기에 클라이너 영화"
    } ]
  }, {
    "tStartMs": 452240,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "그러니까요 너무 거리가 생겨버렸어요"
    } ]
  }, {
    "tStartMs": 455140,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "그러면 4D 추천합니다 저는"
    } ]
  }, {
    "tStartMs": 457200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "아 4D는 아니에요?"
    } ]
  }, {
    "tStartMs": 460000,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "4D는 이렇게 누워서 보지 않고 딱 앉아서 보는데"
    } ]
  }, {
    "tStartMs": 463710,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "뭔가 더 재밌잖아요 같이"
    } ]
  }, {
    "tStartMs": 465570,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "오 도 좋겠다 그러면"
    } ]
  }, {
    "tStartMs": 467220,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그쵸 추천"
    } ]
  }, {
    "tStartMs": 468640,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "오 알겠습니다"
    } ]
  }, {
    "tStartMs": 470180,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "영화관에서 음식은 팔긴 팔잖아요 뭐 팝콘이나 그런 거 파는데"
    } ]
  }, {
    "tStartMs": 475920,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "네 태웅쌤은 안 드실 것 같은데 어때요? 드시나요?\n- 오 그래요?"
    } ]
  }, {
    "tStartMs": 480160,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "네 오 맞습니다 안 먹어요 잘"
    } ]
  }, {
    "tStartMs": 482460,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "왜냐면 저번에 대중교통 이야기할 때"
    } ]
  }, {
    "tStartMs": 485310,
    "dDurationMs": 5570,
    "segs": [ {
      "utf8": "뭔가 그런 사람들 많은 곳에서 음식을 먹는 게"
    } ]
  }, {
    "tStartMs": 490880,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "좀 주변에 피해가 갈 수도 있지 않나"
    } ]
  }, {
    "tStartMs": 493110,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "라고 얘기를 하셨던 적이 있었어가지고"
    } ]
  }, {
    "tStartMs": 496860,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그런 이유는 아니에요?"
    } ]
  }, {
    "tStartMs": 497860,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "그런 이유는 아니에요"
    } ]
  }, {
    "tStartMs": 501180,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "아 맞죠 영화관은 먹을 수 있게 정해져 있잖아요"
    } ]
  }, {
    "tStartMs": 504280,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "네 맞아요"
    } ]
  }, {
    "tStartMs": 505630,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "그런 남들을 위한 이타적인 이유는 아니고요"
    } ]
  }, {
    "tStartMs": 510940,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "팝콘 많이 먹잖아요"
    } ]
  }, {
    "tStartMs": 513200,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "아니면 나초칩이나 아니면"
    } ]
  }, {
    "tStartMs": 515940,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "심지어 오징어 버터구이 이런 것도 먹고"
    } ]
  }, {
    "tStartMs": 518850,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "맞아요 핫도그 이런 것도 있어요"
    } ]
  }, {
    "tStartMs": 520570,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "네 근데 대부분 손으로 먹잖아요"
    } ]
  }, {
    "tStartMs": 524820,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 526350,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "근데 그걸 먹는 건 잠깐이잖아요"
    } ]
  }, {
    "tStartMs": 529100,
    "dDurationMs": 8340,
    "segs": [ {
      "utf8": "잠깐 먹으면 다 끝나는데 영화 보는 내내 손이 좀 찝찝해요"
    } ]
  }, {
    "tStartMs": 537440,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "좀 찝찝해요"
    } ]
  }, {
    "tStartMs": 538900,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "네 그래서 저는 먹으러 간 게 아니라\n- 그건 그래요"
    } ]
  }, {
    "tStartMs": 543560,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "영화 보러 간 거니까 그냥... 개운한 마음,"
    } ]
  }, {
    "tStartMs": 547930,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "깔끔한 느낌으로 계속 영화를 보고 싶어서"
    } ]
  }, {
    "tStartMs": 552170,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "그러면 보통 혼자 영화관 가는 편이세요?"
    } ]
  }, {
    "tStartMs": 557080,
    "dDurationMs": 6820,
    "segs": [ {
      "utf8": "예전에 영화관 갈 때는, 자주 갈 때는 혼자 대부분 갔는데"
    } ]
  }, {
    "tStartMs": 563900,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "이제는 아무래도 그럴 일이 많이 없어서"
    } ]
  }, {
    "tStartMs": 567210,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "가끔 가족끼리 간다던가"
    } ]
  }, {
    "tStartMs": 569840,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "그럴 때만 가다 보니 다 다른 사람들이랑 가요"
    } ]
  }, {
    "tStartMs": 574360,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "가족 분들이나 다른 분들도 음식을 안 드시던가요?"
    } ]
  }, {
    "tStartMs": 579170,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "안 먹어요"
    } ]
  }, {
    "tStartMs": 581400,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "저는 꼭 먹는 편인 것 같아요"
    } ]
  }, {
    "tStartMs": 585470,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "어떤 걸 자주 드십니까?"
    } ]
  }, {
    "tStartMs": 588510,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "팝콘도 자주 먹고 음료수는 꼭 먹는 것 같고"
    } ]
  }, {
    "tStartMs": 593780,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "뭔가 영화관까지 왔는데"
    } ]
  }, {
    "tStartMs": 597790,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "그 영화관에서만 먹을 수 있는"
    } ]
  }, {
    "tStartMs": 602140,
    "dDurationMs": 6660,
    "segs": [ {
      "utf8": "분위기 속에서 먹는 그런 걸 좋아해서 먹어요"
    } ]
  }, {
    "tStartMs": 608800,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "물티슈 하나 챙겨가면 되죠? 이렇게 닦아서"
    } ]
  }, {
    "tStartMs": 611770,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "아 근데 그래도 물티슈로 닦으면 뭔가 구리구리하다 할까요?"
    } ]
  }, {
    "tStartMs": 618250,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "굉장히 청결하시네요"
    } ]
  }, {
    "tStartMs": 621670,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "2시간인데"
    } ]
  }, {
    "tStartMs": 623030,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "네 2시간이니까! 너무 길어요\n- 길다?"
    } ]
  }, {
    "tStartMs": 627740,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "그리고 저는 팝콘이 또 여러 맛이 있잖아요"
    } ]
  }, {
    "tStartMs": 631710,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "네 한국 팝콘이 특히 많아요"
    } ]
  }, {
    "tStartMs": 634360,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "맛이 그냥 팝콘이랑 옛날에는 카라멜 팝콘만 있었잖아요"
    } ]
  }, {
    "tStartMs": 639870,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 641360,
    "dDurationMs": 6510,
    "segs": [ {
      "utf8": "캐러멜라이징이 된 달달한 팝콘 원래 그거밖에 없었는데\n- 카라멜 팝콘"
    } ]
  }, {
    "tStartMs": 647870,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "시간이 지나면서 어니언 팝콘"
    } ]
  }, {
    "tStartMs": 650910,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "등장했고"
    } ]
  }, {
    "tStartMs": 651630,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "그리고 심지어 치토스 팝콘"
    } ]
  }, {
    "tStartMs": 655390,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "치토스, 치즈 팝콘도 있고"
    } ]
  }, {
    "tStartMs": 658650,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "김치도 있는 것 같아요"
    } ]
  }, {
    "tStartMs": 661030,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "그런 것까지 있어요?"
    } ]
  }, {
    "tStartMs": 661980,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "CGV에서 본 것 같아요 김치 시즈닝"
    } ]
  }, {
    "tStartMs": 666700,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "아무튼 저는 어니언 팝콘이 맛있더라고요"
    } ]
  }, {
    "tStartMs": 670330,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "맛있어요, 그거"
    } ]
  }, {
    "tStartMs": 671260,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "근데 그게 특히 가루가 심하게 묻어요, 손에"
    } ]
  }, {
    "tStartMs": 675980,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "맞아요 다 묻을 것 같아요 입이랑 손이랑 다"
    } ]
  }, {
    "tStartMs": 679900,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "그러다가 만약에 툭 떨어뜨려서"
    } ]
  }, {
    "tStartMs": 682560,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "티셔츠에 가루가 다 묻는다? 그럼 영화보는 내내... 찝찝해요"
    } ]
  }, {
    "tStartMs": 687470,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "이거가 신경 쓰여요?"
    } ]
  }, {
    "tStartMs": 689090,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 690860,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "깔끔하시네요"
    } ]
  }, {
    "tStartMs": 692790,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 694960,
    "dDurationMs": 6910,
    "segs": [ {
      "utf8": "그래도 만약에 영화관에서 뭔가 하나를 시켜야 된다 하면 뭘 시키시겠어요?"
    } ]
  }, {
    "tStartMs": 701870,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "썸녀가 배고프대요 뭔가 먹고 싶대요"
    } ]
  }, {
    "tStartMs": 704910,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "그러면 썸녀가 먹고 싶은 거 먹어야죠"
    } ]
  }, {
    "tStartMs": 708160,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "골라달래요"
    } ]
  }, {
    "tStartMs": 709160,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "골라달래요?"
    } ]
  }, {
    "tStartMs": 710040,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 710780,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "좀 썸이 식을 것 같긴 한데 그러면..."
    } ]
  }, {
    "tStartMs": 714240,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "뭐 먹지? 뭐 먹지?"
    } ]
  }, {
    "tStartMs": 716360,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "\"뭐 먹지을지 모르겠어~\""
    } ]
  }, {
    "tStartMs": 719440,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "그러면 맛도 있으면서 가루도 없는"
    } ]
  }, {
    "tStartMs": 724710,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "카라멜 팝콘?"
    } ]
  }, {
    "tStartMs": 726020,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "음! 괜찮은 선택인 것 같습니다"
    } ]
  }, {
    "tStartMs": 730110,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "콜라랑 카라멜 팝콘 너무 좋을 것 같네요"
    } ]
  }, {
    "tStartMs": 734400,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 735740,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "영화관 자리 잡을 때 있잖아요?"
    } ]
  }, {
    "tStartMs": 739490,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "보통은 이제 다들 매표소, 티켓 박스에서 구매를 하기보다는"
    } ]
  }, {
    "tStartMs": 745560,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "어플로 구매를 많이 하고 미리 예약을 해서 가는데"
    } ]
  }, {
    "tStartMs": 749990,
    "dDurationMs": 5990,
    "segs": [ {
      "utf8": "태웅쌤은 자리를 고를 때 선호하는 자리가 있으신가요?"
    } ]
  }, {
    "tStartMs": 755980,
    "dDurationMs": 8810,
    "segs": [ {
      "utf8": "저는... 보통 가운데냐 구석자리냐 이렇게 나뉘잖아요"
    } ]
  }, {
    "tStartMs": 764790,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "아니면 앞이냐 뒤냐 중간이냐도 있어요"
    } ]
  }, {
    "tStartMs": 767210,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그렇죠 그렇죠"
    } ]
  }, {
    "tStartMs": 768740,
    "dDurationMs": 6330,
    "segs": [ {
      "utf8": "저는 근데 가운데 뒤쪽이 가능하면 좋은 것 같아요"
    } ]
  }, {
    "tStartMs": 775070,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "맞아요 거기가 제일 좋은 것 같아요"
    } ]
  }, {
    "tStartMs": 777540,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "제일 좋죠 제일"
    } ]
  }, {
    "tStartMs": 779020,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "근데 뭐 거기에 이미 사람들이 너무 많다"
    } ]
  }, {
    "tStartMs": 783330,
    "dDurationMs": 7830,
    "segs": [ {
      "utf8": "그러면 그냥 뭐 사람들 없는 구석에 앉아서 그냥 편하게 보고 네"
    } ]
  }, {
    "tStartMs": 791160,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "그것도 좋죠"
    } ]
  }, {
    "tStartMs": 793090,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "자리가 얼마 안 남았을 때 있잖아요"
    } ]
  }, {
    "tStartMs": 795700,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "5자리 이렇게 남았을 때"
    } ]
  }, {
    "tStartMs": 799010,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "절대 여기는 못 앉는다 하는 곳은 없나요?"
    } ]
  }, {
    "tStartMs": 802850,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "그런 거는 한 번도 생각해 본 적이 없는데"
    } ]
  }, {
    "tStartMs": 804920,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그런 적 없었어요?"
    } ]
  }, {
    "tStartMs": 806410,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "저는 맨 앞은 절대 안 앉아요"
    } ]
  }, {
    "tStartMs": 810040,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "와 근데 그렇게 5자리밖에 안 남았는데"
    } ]
  }, {
    "tStartMs": 813730,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "꼭 그때 봐야 할 영화면 진짜 보고 싶은 영화인가 보네요?"
    } ]
  }, {
    "tStartMs": 818850,
    "dDurationMs": 4970,
    "segs": [ {
      "utf8": "제가 P라서 그런지 보통 한 1시간 전에..."
    } ]
  }, {
    "tStartMs": 823820,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "뭐 보지? 이렇게 예약을 해서"
    } ]
  }, {
    "tStartMs": 830890,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "트랜스포머 아시죠?"
    } ]
  }, {
    "tStartMs": 833690,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "변신 자동차 로봇?"
    } ]
  }, {
    "tStartMs": 835150,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "네 안 봤어요?"
    } ]
  }, {
    "tStartMs": 836510,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "봤어요"
    } ]
  }, {
    "tStartMs": 837790,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "시리즈 처음 것들만 봤어요"
    } ]
  }, {
    "tStartMs": 840430,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "전 시리즈 앞에 거 하나도 안 보고"
    } ]
  }, {
    "tStartMs": 842910,
    "dDurationMs": 7100,
    "segs": [ {
      "utf8": "트랜스포머 3인가? 그게 좀 인기가 많았어요 제 기억으론"
    } ]
  }, {
    "tStartMs": 850010,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "그래서 막 친구들이 보자고 해서 예매를 했는데 맨 앞줄이었거든요"
    } ]
  }, {
    "tStartMs": 854920,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "근데 진짜 목이 부러지는 줄 알았어요"
    } ]
  }, {
    "tStartMs": 857820,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "그게 액션도 엄청 많고 어지럽잖아요"
    } ]
  }, {
    "tStartMs": 862320,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그래서 맨 앞은 안 되겠더라고요"
    } ]
  }, {
    "tStartMs": 864680,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "음~ 맞아요"
    } ]
  }, {
    "tStartMs": 866860,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "구석은 괜찮은데"
    } ]
  }, {
    "tStartMs": 868920,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "저는 옛날에 어벤져스 1 나왔을 때"
    } ]
  }, {
    "tStartMs": 872940,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "그때 그렇게 제일 앞줄에서 봤거든요"
    } ]
  }, {
    "tStartMs": 876770,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "난이도 높은 영화예요 그런 것들"
    } ]
  }, {
    "tStartMs": 880440,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "고개 이렇게 들고..."
    } ]
  }, {
    "tStartMs": 882770,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "목 아프더라고요"
    } ]
  }, {
    "tStartMs": 884080,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "오벤져스 좋아하세요? 그런 히어로"
    } ]
  }, {
    "tStartMs": 887330,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "히어로..."
    } ]
  }, {
    "tStartMs": 888410,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "음... 모르겠네"
    } ]
  }, {
    "tStartMs": 891210,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "요새 어벤져스는 어벤져스가 아니라서"
    } ]
  }, {
    "tStartMs": 893680,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "끝났다고 볼 수 있죠"
    } ]
  }, {
    "tStartMs": 895550,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "근데 되게 좋아했어요"
    } ]
  }, {
    "tStartMs": 898320,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "저도 저도"
    } ]
  }, {
    "tStartMs": 900310,
    "dDurationMs": 5870,
    "segs": [ {
      "utf8": "한국에 영화를 보러 오실 분들도 있을 수도 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 906180,
    "dDurationMs": 7910,
    "segs": [ {
      "utf8": "저는 로망 중에 하나가 외국에서 영화관 가보기인데 아직 못 가봤거든요"
    } ]
  }, {
    "tStartMs": 914090,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "가보신 적 있으세요?"
    } ]
  }, {
    "tStartMs": 915790,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "네, 저는 세 군데 있습니다"
    } ]
  }, {
    "tStartMs": 918250,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "나라가 달라요?"
    } ]
  }, {
    "tStartMs": 919710,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "네, 방글라데시하고 당연히"
    } ]
  }, {
    "tStartMs": 922960,
    "dDurationMs": 6470,
    "segs": [ {
      "utf8": "그리고... 태국 치앙마이에서 한 번 가봤던 것 같고요"
    } ]
  }, {
    "tStartMs": 929430,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "그리고 필리핀 마닐라에서 한 번 가봤어요"
    } ]
  }, {
    "tStartMs": 932610,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "그 세 가지 경험들이 어땠어요? 다 다르던가요?"
    } ]
  }, {
    "tStartMs": 939180,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "한국이랑 많이 달라요?"
    } ]
  }, {
    "tStartMs": 942100,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "정확하게 필리핀이었는지 태국인지 기억이 안 나는데"
    } ]
  }, {
    "tStartMs": 946680,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "아니면 둘 다 그랬던 것 같기도 한데"
    } ]
  }, {
    "tStartMs": 950850,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "영화 시작하기 전에"
    } ]
  }, {
    "tStartMs": 954980,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "노래 같은 게 나오면서 사람들이 자리에 일어나서"
    } ]
  }, {
    "tStartMs": 959420,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "자리에서 일어나서"
    } ]
  }, {
    "tStartMs": 962060,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "우리 국기에 대한 경례하고 애국가 부르는 것처럼"
    } ]
  }, {
    "tStartMs": 966720,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그런 시간이 있었어요"
    } ]
  }, {
    "tStartMs": 968700,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "영화관에서?"
    } ]
  }, {
    "tStartMs": 969910,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "태국이었나? 네"
    } ]
  }, {
    "tStartMs": 972490,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "아직 왕이 있는 나라라 그런가?"
    } ]
  }, {
    "tStartMs": 977230,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "우와 신기하다"
    } ]
  }, {
    "tStartMs": 979200,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "네 그런 게 있었는데 처음 경험해봤고 저도"
    } ]
  }, {
    "tStartMs": 982440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "되게 신기했었어요"
    } ]
  }, {
    "tStartMs": 983760,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "같이 하셨나요?"
    } ]
  }, {
    "tStartMs": 985470,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "저는 그냥 옆... 일어나라해서 그냥 일어나서 멀뚱멀뚱..."
    } ]
  }, {
    "tStartMs": 989810,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "이렇게 두리번거리다가 다시 앉았어요"
    } ]
  }, {
    "tStartMs": 993760,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "나라마다 다르네요 그런 문화가"
    } ]
  }, {
    "tStartMs": 997070,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "한국은 그런 거 있잖아요 영화 시작하기 전에"
    } ]
  }, {
    "tStartMs": 1000190,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "보통 영화가 12시 시작이면"
    } ]
  }, {
    "tStartMs": 1003070,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "12시 10분에 들어가는 사람들도 있잖아요"
    } ]
  }, {
    "tStartMs": 1006050,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "어 그렇죠"
    } ]
  }, {
    "tStartMs": 1007360,
    "dDurationMs": 8200,
    "segs": [ {
      "utf8": "그게 앞에서 광고 타임이 한 10분? 15분? 정도 있어가지고"
    } ]
  }, {
    "tStartMs": 1015560,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "네 다른 나라는 어떤지 모르겠네요 이렇게"
    } ]
  }, {
    "tStartMs": 1019350,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "다른 나라, 제가 경험한 나라들의 영화관들도"
    } ]
  }, {
    "tStartMs": 1023130,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "그렇게 광고 시간이 있었어요"
    } ]
  }, {
    "tStartMs": 1024960,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "있었어요? 보통은 그렇구나"
    } ]
  }, {
    "tStartMs": 1027810,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "네 그리고 한국 경우는 아까 말했듯이"
    } ]
  }, {
    "tStartMs": 1031930,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "영화관 종류가 세 개라고 했잖아요"
    } ]
  }, {
    "tStartMs": 1034670,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "근데 제가 최근에 간 곳들이 다 롯데시네마밖에 없는데"
    } ]
  }, {
    "tStartMs": 1039400,
    "dDurationMs": 6520,
    "segs": [ {
      "utf8": "롯데시네마 경우는 영화 시작 시간 전에,"
    } ]
  }, {
    "tStartMs": 1045920,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "10분간 광고를 하고 그리고 그 티켓에 써져 있는 영화 시간부터"
    } ]
  }, {
    "tStartMs": 1051710,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "또 10분간 광고 시간이 있습니다 20분이죠"
    } ]
  }, {
    "tStartMs": 1055000,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "아 네네네"
    } ]
  }, {
    "tStartMs": 1056450,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "그렇게 전으로 10분 후로 10분 해서 20분간 광고하고 영화가 나와요"
    } ]
  }, {
    "tStartMs": 1062070,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "아 그럼 보통 맞네요 15분 20분 정도 하는구나"
    } ]
  }, {
    "tStartMs": 1065620,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "네 그렇습니다"
    } ]
  }, {
    "tStartMs": 1066890,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "음식 같은 거는 다 팝콘만 있었나요?"
    } ]
  }, {
    "tStartMs": 1070220,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "핫도그 같은 것도 있었던 것 같아요"
    } ]
  }, {
    "tStartMs": 1072930,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "음식이 궁금해요 다른 나라 영화관에서 뭘 먹지?"
    } ]
  }, {
    "tStartMs": 1078070,
    "dDurationMs": 5590,
    "segs": [ {
      "utf8": "근데 뭐 그렇게 특별한 건 없었던 것 같은데"
    } ]
  }, {
    "tStartMs": 1083660,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "아무리 해도 치토스 팝콘 이런 게 있겠어요"
    } ]
  }, {
    "tStartMs": 1086990,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "치토스 팝콘도 있고 보통... 왜 그렇게 됐는지 모르겠는데"
    } ]
  }, {
    "tStartMs": 1092200,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "한국 넷플릭스 보는 사람들이 배달음식 시켜서 먹고"
    } ]
  }, {
    "tStartMs": 1097360,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "그런 문화가 있어서 그런지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1100450,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "CGV도 가면 '씨네밀'이라고 해서"
    } ]
  }, {
    "tStartMs": 1104860,
    "dDurationMs": 6450,
    "segs": [ {
      "utf8": "엄청... 김치볶음밥, 볶음밥, 떡볶이 이런 것도 먹을 수가 있더라고요"
    } ]
  }, {
    "tStartMs": 1111310,
    "dDurationMs": 7550,
    "segs": [ {
      "utf8": "와 근데 집중 안 될 것 같은데 영화 볼 때..."
    } ]
  }, {
    "tStartMs": 1118860,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "드셔보셨어요?"
    } ]
  }, {
    "tStartMs": 1119950,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "아니요 아니요"
    } ]
  }, {
    "tStartMs": 1120990,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "진짜 배고픈 사람들만 먹어야 될 것 같아요 그건"
    } ]
  }, {
    "tStartMs": 1125170,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "시간이 안 맞아서 저녁을 못 먹었다거나 그런 사람?"
    } ]
  }, {
    "tStartMs": 1131730,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그럴 때가 가끔 있을 수 있어요"
    } ]
  }, {
    "tStartMs": 1134050,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1134740,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "밥때를 놓친..."
    } ]
  }, {
    "tStartMs": 1136350,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "와 엄청 인생이 고달플 것 같네요"
    } ]
  }, {
    "tStartMs": 1140600,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "얼마나 바쁘면..."
    } ]
  }, {
    "tStartMs": 1144720,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "영화 보면서 밥을..."
    } ]
  }, {
    "tStartMs": 1147410,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "굉장히 생산적으로 사는 거예요"
    } ]
  }, {
    "tStartMs": 1150750,
    "dDurationMs": 5230,
    "segs": [ {
      "utf8": "근데 그거 들고 4D관도 갈 수 있고 그렇대요"
    } ]
  }, {
    "tStartMs": 1155980,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "아 4D관도요?"
    } ]
  }, {
    "tStartMs": 1156700,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1158160,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "그러면 막 F1 보다가 막 이렇게 하면"
    } ]
  }, {
    "tStartMs": 1161080,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "사수하면서 잘 먹어야 돼요"
    } ]
  }, {
    "tStartMs": 1162830,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "와 밥알 막 튀고 그런 거 아니야?"
    } ]
  }, {
    "tStartMs": 1165590,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "그래서 논란이 좀 있었어요 더러워진다"
    } ]
  }, {
    "tStartMs": 1170210,
    "dDurationMs": 5530,
    "segs": [ {
      "utf8": "그래도 뭐 원하는 사람은 먹을 수 있도록 있는 것 같아요"
    } ]
  }, {
    "tStartMs": 1175740,
    "dDurationMs": 5670,
    "segs": [ {
      "utf8": "그래서 한국에 영화 보러 오실 분들을 위해서 팁을 한 가지 드리자면"
    } ]
  }, {
    "tStartMs": 1181410,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "한국에는 문화의 날이라는 게 있습니다"
    } ]
  }, {
    "tStartMs": 1184770,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "이용해보셨나요? 문화의 날?"
    } ]
  }, {
    "tStartMs": 1186940,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "당연히 이용해봤습니다"
    } ]
  }, {
    "tStartMs": 1188740,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "뭐죠? 문화의 날이?"
    } ]
  }, {
    "tStartMs": 1190110,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "너무 좋은 제도예요"
    } ]
  }, {
    "tStartMs": 1191450,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "진짜"
    } ]
  }, {
    "tStartMs": 1193030,
    "dDurationMs": 5910,
    "segs": [ {
      "utf8": "매달 마지막 주 수요일에 누가 오든 뭐..."
    } ]
  }, {
    "tStartMs": 1198940,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "남녀노소, 군인이든 공무원이든 상관없이"
    } ]
  }, {
    "tStartMs": 1203480,
    "dDurationMs": 7750,
    "segs": [ {
      "utf8": "모든 사람이 영화를 굉장히 할인된 가격으로 볼 수 있습니다"
    } ]
  }, {
    "tStartMs": 1211230,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1212430,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "보통 영화가 요즘 얼마 정도죠? 만원... 만사천원?"
    } ]
  }, {
    "tStartMs": 1217470,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "네 만오천원 하지 않나요?"
    } ]
  }, {
    "tStartMs": 1219620,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "그 정도 하는데 거의 반값으로 볼 수 있을 거예요"
    } ]
  }, {
    "tStartMs": 1223910,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "칠천원이었던 것 같은데?"
    } ]
  }, {
    "tStartMs": 1225440,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "요즘은 칠천원?"
    } ]
  }, {
    "tStartMs": 1226990,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1227680,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "제가 마지막으로 봤던 게 6,000원이었거든요"
    } ]
  }, {
    "tStartMs": 1230880,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "몇 년 전이긴 한데"
    } ]
  }, {
    "tStartMs": 1233080,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "7,000원인 것 같아요 확인해보니까"
    } ]
  }, {
    "tStartMs": 1236300,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "그래도 그냥 원래 요금보다 엄청 싸죠"
    } ]
  }, {
    "tStartMs": 1240450,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "맞아요 영화뿐만 아니라"
    } ]
  }, {
    "tStartMs": 1242680,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "문화 생활할 수 있는 다른 연극, 뮤지컬"
    } ]
  }, {
    "tStartMs": 1247260,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "이런 것도 할인되는 걸로 알고 있어요"
    } ]
  }, {
    "tStartMs": 1249910,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "그거 진짜 좋은 정책 같습니다"
    } ]
  }, {
    "tStartMs": 1253090,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "그래서 여행 기간이 딱 마지막 주"
    } ]
  }, {
    "tStartMs": 1257410,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "수요일에 있다면 가보시는 것도 좋을 것 같아요"
    } ]
  }, {
    "tStartMs": 1261720,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1263140,
    "dDurationMs": 5930,
    "segs": [ {
      "utf8": "그리고 할인해서 볼 수 있는 방법이 조조영화도 있거든요"
    } ]
  }, {
    "tStartMs": 1269070,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "조조영화는 아침 일찍 보는 영화예요"
    } ]
  }, {
    "tStartMs": 1272920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "거의 상영 처음 영화?"
    } ]
  }, {
    "tStartMs": 1274960,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그날의 첫 영화?"
    } ]
  }, {
    "tStartMs": 1276380,
    "dDurationMs": 6170,
    "segs": [ {
      "utf8": "그래도 한 9시, 10시까지는 조조영화로 보는 것 같아서"
    } ]
  }, {
    "tStartMs": 1282550,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "보실 수가 있고"
    } ]
  }, {
    "tStartMs": 1283690,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "심야영화라고 완전 밤 마지막에 볼 수 있는 영화도 있어요"
    } ]
  }, {
    "tStartMs": 1288570,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "근데 그거는 할인 안 될 거예요 아마"
    } ]
  }, {
    "tStartMs": 1290750,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "어? 안 돼요?"
    } ]
  }, {
    "tStartMs": 1292770,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "아니면 조금 되는 것도 있는 거 같은데 뭐 그래도 챙길 수 있는 거는"
    } ]
  }, {
    "tStartMs": 1297580,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "문화의 날이랑 조조 있습니다"
    } ]
  }, {
    "tStartMs": 1301890,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "그러면 태웅쌤이 보신 한국 영화들도 있을 거고"
    } ]
  }, {
    "tStartMs": 1306370,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "외국 영화들도 있을 텐데"
    } ]
  }, {
    "tStartMs": 1308520,
    "dDurationMs": 7220,
    "segs": [ {
      "utf8": "한국 영화만의 특징에 대해서 좀 얘기해 보면 좋을 거 같아요"
    } ]
  }, {
    "tStartMs": 1315740,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "뭐 디디님은 생각나는 거 있습니까?"
    } ]
  }, {
    "tStartMs": 1318590,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "저는 한국 영화들이 보통"
    } ]
  }, {
    "tStartMs": 1322380,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "저의 표현인데 '착한 영화'들이 많다고 생각해요 착한 영화"
    } ]
  }, {
    "tStartMs": 1326730,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "착한 영화?"
    } ]
  }, {
    "tStartMs": 1327810,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "네 제가 이야기하는 착한 영화는"
    } ]
  }, {
    "tStartMs": 1331270,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "대부분 뭔가 문제가 일어나고"
    } ]
  }, {
    "tStartMs": 1334140,
    "dDurationMs": 7520,
    "segs": [ {
      "utf8": "문제를 해결하고 해피엔딩 이렇게 끝났습니다 하는 영화들이 많아요"
    } ]
  }, {
    "tStartMs": 1341660,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "맞아요 또 교훈이 있죠"
    } ]
  }, {
    "tStartMs": 1343870,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "어 맞아요"
    } ]
  }, {
    "tStartMs": 1345480,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "착하게 살아야 된다거나"
    } ]
  }, {
    "tStartMs": 1348010,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "도둑질을 하면 안 돼, 남의 물건을 훔치면 안 된다거나"
    } ]
  }, {
    "tStartMs": 1351300,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "그런 교훈이 있어요"
    } ]
  }, {
    "tStartMs": 1353440,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "맞아요 그리고 제 생각에는 자주 좀"
    } ]
  }, {
    "tStartMs": 1358500,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "억지 감동?"
    } ]
  }, {
    "tStartMs": 1360570,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "좀 억지스럽게 슬픔을 느끼게 하는 있어요"
    } ]
  }, {
    "tStartMs": 1365490,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "좀 그런 게 있는 것 같습니다"
    } ]
  }, {
    "tStartMs": 1367470,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "억지인지 뭐 어쩔 수 없는 건지 모르겠지만"
    } ]
  }, {
    "tStartMs": 1372420,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "\"지금이야! 우는 타이밍!\" 이런 씬들이 있어요"
    } ]
  }, {
    "tStartMs": 1377340,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "네 그거를 한국어 표현으로 '신파'라고 많이들 얘기합니다"
    } ]
  }, {
    "tStartMs": 1383410,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "맞아요 신파가 있다"
    } ]
  }, {
    "tStartMs": 1387840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "아 그리고 이것도 있어요"
    } ]
  }, {
    "tStartMs": 1390000,
    "dDurationMs": 6290,
    "segs": [ {
      "utf8": "제목이 대부분 두 글자? 세 글자 제목이 많아서"
    } ]
  }, {
    "tStartMs": 1396290,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "너무 헷갈리는 것들이 있어요"
    } ]
  }, {
    "tStartMs": 1398620,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "오 그런가요?"
    } ]
  }, {
    "tStartMs": 1400420,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "약간 막 \u003c명량\u003e"
    } ]
  }, {
    "tStartMs": 1402300,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "\u003c명량\u003e 오 맞네"
    } ]
  }, {
    "tStartMs": 1404290,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "그런 제목들? 뭔가 한자어 두 가지로..."
    } ]
  }, {
    "tStartMs": 1407200,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "\u003c명량\u003e, \u003c파묘\u003e"
    } ]
  }, {
    "tStartMs": 1409490,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "맞아요 그런 거"
    } ]
  }, {
    "tStartMs": 1410980,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "영어 단어 이름도 많잖아요"
    } ]
  }, {
    "tStartMs": 1413200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "네 근데 보통 짧게"
    } ]
  }, {
    "tStartMs": 1415360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "\u003c엑시트\u003e 맞아요"
    } ]
  }, {
    "tStartMs": 1418160,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "\u003c파일럿\u003e"
    } ]
  }, {
    "tStartMs": 1419180,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "응 아 \u003c괴물\u003e 이런 것도 있네"
    } ]
  }, {
    "tStartMs": 1421810,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "\u003c괴물\u003e도 있네"
    } ]
  }, {
    "tStartMs": 1423040,
    "dDurationMs": 5470,
    "segs": [ {
      "utf8": "뭔가 \u003c도둑\u003e, \u003c암살\u003e 이런 식으로"
    } ]
  }, {
    "tStartMs": 1428510,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "뭔가 '그 영화 뭐였지?' \u003c관상\u003e 이렇게 다 헷갈려요"
    } ]
  }, {
    "tStartMs": 1433870,
    "dDurationMs": 6510,
    "segs": [ {
      "utf8": "그렇네요 한 번도 생각 안 해본 건데 진짜 그렇네요"
    } ]
  }, {
    "tStartMs": 1440380,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "한국어 공부하시는 분들도 많이 얘기하는 건데"
    } ]
  }, {
    "tStartMs": 1444690,
    "dDurationMs": 7600,
    "segs": [ {
      "utf8": "한국 영화나 드라마들이 발음이 잘 안 들린다? 는 게 저희도 느껴요"
    } ]
  }, {
    "tStartMs": 1452290,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "한국인들도"
    } ]
  }, {
    "tStartMs": 1453760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "맞아요 맞아요 똑같습니다"
    } ]
  }, {
    "tStartMs": 1456960,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "왜일까요?"
    } ]
  }, {
    "tStartMs": 1457920,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "네 그래서 가끔 저는 넷플릭스 볼 때"
    } ]
  }, {
    "tStartMs": 1461760,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "한국 콘텐츠 볼 때도 자막을 자주 켜고 봅니다"
    } ]
  }, {
    "tStartMs": 1466960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "저희 부모님도 그러시더라고요"
    } ]
  }, {
    "tStartMs": 1468960,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1469580,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "며칠 전에 \u003c검사외전\u003e 다시 보는데"
    } ]
  }, {
    "tStartMs": 1472540,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "아빠가 뭐라고 하는지 안 들린대요 소리가"
    } ]
  }, {
    "tStartMs": 1476400,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "그래서 저는 볼륨을 높여드리지 않고 자막을 켜드렸어요"
    } ]
  }, {
    "tStartMs": 1480240,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "그러니까 이제 잘 들린다고 했어요"
    } ]
  }, {
    "tStartMs": 1485550,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "그러게요 왜 그런지는 모르겠는데"
    } ]
  }, {
    "tStartMs": 1489170,
    "dDurationMs": 7340,
    "segs": [ {
      "utf8": "근데 또 우리가 외국 영화 볼 때는 자막을 당연히 보잖아요"
    } ]
  }, {
    "tStartMs": 1496510,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1497250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그래서 비교를 안 해본 걸 수도 있어요"
    } ]
  }, {
    "tStartMs": 1499620,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "아 그쵸? 다들 그런가요?"
    } ]
  }, {
    "tStartMs": 1503200,
    "dDurationMs": 6380,
    "segs": [ {
      "utf8": "근데 뭐 미국인들은 \"미국 영화는 자막 없으면 못 알아듣겠어\" 이럴 수도 있고"
    } ]
  }, {
    "tStartMs": 1509580,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "네 이어폰을 꽂으면 또 잘 들릴 수도 있거든요"
    } ]
  }, {
    "tStartMs": 1514820,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "뭔가 그 사운드의 문제일 수도 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 1518000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그럴 수도 있어요 맞아요"
    } ]
  }, {
    "tStartMs": 1519600,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "그러면 개인적인 에피소드로"
    } ]
  }, {
    "tStartMs": 1522950,
    "dDurationMs": 6710,
    "segs": [ {
      "utf8": "태웅쌤은 최근에 봤던 영화 중에 제일 재밌었던 영화 뭐예요?"
    } ]
  }, {
    "tStartMs": 1529660,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "최근이라고 하기엔 많이 없는데 아직 기억에 남아있는 선에서"
    } ]
  }, {
    "tStartMs": 1539140,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "저는 최근에 극장에서 극장에서 영화관에서"
    } ]
  }, {
    "tStartMs": 1543770,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "좋아요 극장에서 본 거"
    } ]
  }, {
    "tStartMs": 1545350,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "네 영화관에서 본 거 중에"
    } ]
  }, {
    "tStartMs": 1548340,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "저는 \u003c탑건\u003e이 근래 몇 년 중에 제일 재밌었습니다"
    } ]
  }, {
    "tStartMs": 1552420,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "매버릭"
    } ]
  }, {
    "tStartMs": 1553100,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "탑건 네 \u003c탑건 매버릭\u003e"
    } ]
  }, {
    "tStartMs": 1554840,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "재밌죠 그거 저도 두 번 봤어요"
    } ]
  }, {
    "tStartMs": 1557680,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "아 두 번 봤어요?"
    } ]
  }, {
    "tStartMs": 1558620,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "영화관에서 두 번 봤어요"
    } ]
  }, {
    "tStartMs": 1560450,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그건 4D로 안 봤어요?"
    } ]
  }, {
    "tStartMs": 1561880,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "안 봤어요"
    } ]
  }, {
    "tStartMs": 1563550,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "왜 두 번 봤지?"
    } ]
  }, {
    "tStartMs": 1564770,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "탑건을 뽑은 이유는"
    } ]
  }, {
    "tStartMs": 1568790,
    "dDurationMs": 5450,
    "segs": [ {
      "utf8": "영화관에서 봤기 때문에 그 재미가 극대화된 것 같아요"
    } ]
  }, {
    "tStartMs": 1574240,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "사운드나 액션 같은 게요?"
    } ]
  }, {
    "tStartMs": 1578340,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "네 그리고 이 넓은 화면을 보니까"
    } ]
  }, {
    "tStartMs": 1582820,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "사실 작은 화면으로 보는 거랑 그리고 막 눈에 다 들어오는"
    } ]
  }, {
    "tStartMs": 1588160,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "큰 화면에서 보는 거랑 차이가 아무래도 나잖아요?"
    } ]
  }, {
    "tStartMs": 1592310,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "맞는 것 같아요"
    } ]
  }, {
    "tStartMs": 1593520,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "네 막 진짜 전투기 조종사 시점에서"
    } ]
  }, {
    "tStartMs": 1597060,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "이 창문 닫히고 막 가는 게 다 보이는데"
    } ]
  }, {
    "tStartMs": 1602240,
    "dDurationMs": 6760,
    "segs": [ {
      "utf8": "그 실제 전투기 사이즈처럼 느껴지는 거예요"
    } ]
  }, {
    "tStartMs": 1609000,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "그래서 와 이거 진짜 체험하는 것 같다 이런 느낌이 들더라고요"
    } ]
  }, {
    "tStartMs": 1613750,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "영화관에서 볼만했다"
    } ]
  }, {
    "tStartMs": 1617220,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "가끔 그렇게 이런 영화는 꼭 영화관에서 봐야 해"
    } ]
  }, {
    "tStartMs": 1621380,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "라는 것처럼 만든 영화들이 있는 것 같아요"
    } ]
  }, {
    "tStartMs": 1625410,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "맞아요 맞아요"
    } ]
  }, {
    "tStartMs": 1627110,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "그래서 최근에 본 F1도 그런 것 같았는데"
    } ]
  }, {
    "tStartMs": 1632100,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "감독이 같은 사람이더라고요"
    } ]
  }, {
    "tStartMs": 1634570,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "비슷하지 않아요? 두 영화가 좀?"
    } ]
  }, {
    "tStartMs": 1636670,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "진짜 비슷했어요"
    } ]
  }, {
    "tStartMs": 1638060,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "진짜 비슷해요"
    } ]
  }, {
    "tStartMs": 1639330,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "그냥 비행기 버전, 차 버전 이런 느낌이에요"
    } ]
  }, {
    "tStartMs": 1643330,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "그래서 감독이 진짜 자기가 말하고 싶은 게 있구나"
    } ]
  }, {
    "tStartMs": 1649400,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "맞아요 맞아요 재밌었어요"
    } ]
  }, {
    "tStartMs": 1651620,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1652900,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "저는 영화관에서 본 것 중에는 듣다 보니까 생각나는데"
    } ]
  }, {
    "tStartMs": 1657200,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "\u003c미키17\u003e?"
    } ]
  }, {
    "tStartMs": 1659300,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "그거 영화관에서 보길 잘한 것 같아요"
    } ]
  }, {
    "tStartMs": 1662620,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 1665500,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "왜요? 왜요?"
    } ]
  }, {
    "tStartMs": 1666610,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "영화관이 아니었으면 몰입이 안 됐을 것 같아요"
    } ]
  }, {
    "tStartMs": 1670950,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "전체적인 스토리가?"
    } ]
  }, {
    "tStartMs": 1672990,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "무슨 말인지 이해는 돼요"
    } ]
  }, {
    "tStartMs": 1675230,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "이렇게 날 딱 잡아놓고 \"봐\" 이렇게 해서"
    } ]
  }, {
    "tStartMs": 1679800,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "집중하고 봤더니 재밌었던 영화였던 것 같습니다"
    } ]
  }, {
    "tStartMs": 1684410,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "저도 그거 극장에서 봤어요"
    } ]
  }, {
    "tStartMs": 1687610,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "괜찮았다고 했었던 것 같아요"
    } ]
  }, {
    "tStartMs": 1690490,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "한국 영화는요? 혹시 있나요?"
    } ]
  }, {
    "tStartMs": 1692510,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "한국 영화는 극장에서 마지막으로 본 게"
    } ]
  }, {
    "tStartMs": 1696510,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "파일럿이라는 영화입니다"
    } ]
  }, {
    "tStartMs": 1698870,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "알아요 조정석"
    } ]
  }, {
    "tStartMs": 1700090,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "맞아요 조정석이라는 배우가 주연으로 나오는 영화인데"
    } ]
  }, {
    "tStartMs": 1705440,
    "dDurationMs": 5030,
    "segs": [ {
      "utf8": "그것도 제 생각에는 딱 착한 영화일 것 같은데 어땠어요?"
    } ]
  }, {
    "tStartMs": 1710470,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "맞아요 그렇죠"
    } ]
  }, {
    "tStartMs": 1712060,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "교훈을 주는 영화죠"
    } ]
  }, {
    "tStartMs": 1714580,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "그리고 뭐 해피엔딩으로 잘 끝나고"
    } ]
  }, {
    "tStartMs": 1716800,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "약간의 코미디?"
    } ]
  }, {
    "tStartMs": 1718180,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "네 사실은 그런 영화 극장에서 잘 안 보는데"
    } ]
  }, {
    "tStartMs": 1722850,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "가족 행사로 갔습니다 가족 행사로"
    } ]
  }, {
    "tStartMs": 1725950,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그랬구나"
    } ]
  }, {
    "tStartMs": 1726910,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그것도 왜 갔냐면"
    } ]
  }, {
    "tStartMs": 1729120,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "사실은 제 친척 사촌이"
    } ]
  }, {
    "tStartMs": 1732970,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1733760,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "그 영화에 나와요"
    } ]
  }, {
    "tStartMs": 1737540,
    "dDurationMs": 7610,
    "segs": [ {
      "utf8": "그러니까 제 엄마 쪽 삼촌의 딸내미가"
    } ]
  }, {
    "tStartMs": 1745150,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "거기 조연으로 나온 배우입니다"
    } ]
  }, {
    "tStartMs": 1749380,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "이주명이라는 배우거든요"
    } ]
  }, {
    "tStartMs": 1752770,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "! 네"
    } ]
  }, {
    "tStartMs": 1753820,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "그래서 엄마랑 누나가"
    } ]
  }, {
    "tStartMs": 1757510,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "'주명이 나오니까 보러 가야 된다' 이렇게 해서"
    } ]
  }, {
    "tStartMs": 1761150,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "그래서 다 같이 보러 갔었습니다"
    } ]
  }, {
    "tStartMs": 1763120,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "오, 그렇구나 우와 우와 친해요?"
    } ]
  }, {
    "tStartMs": 1767920,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "아니요, 안 친합니다"
    } ]
  }, {
    "tStartMs": 1770680,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "왜요?"
    } ]
  }, {
    "tStartMs": 1772320,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "먼 친척인가, 그렇게 되면?"
    } ]
  }, {
    "tStartMs": 1774500,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "아니요, 사실 가까운 친척이에요, 사실"
    } ]
  }, {
    "tStartMs": 1776840,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "아, 자주 못 봤구나"
    } ]
  }, {
    "tStartMs": 1778730,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "네, 성인 되고 나서는 거의 못 봤습니다"
    } ]
  }, {
    "tStartMs": 1781410,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "아, 아쉽네 사인 받으려 했는데"
    } ]
  }, {
    "tStartMs": 1783960,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "어릴 때는 자주 놀았는데"
    } ]
  }, {
    "tStartMs": 1786940,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "성인이 되고 나서 이제 뭐 네 그렇죠"
    } ]
  }, {
    "tStartMs": 1790700,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "사실 그런 가족 영화도 가족끼리 보기 좋은 것 같아요"
    } ]
  }, {
    "tStartMs": 1795900,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "네 또 그런 특히 그런 영화들이"
    } ]
  }, {
    "tStartMs": 1799530,
    "dDurationMs": 7450,
    "segs": [ {
      "utf8": "막 추석 시즌 이런 명절에 또 특히 좀 큼직큼직한 히트작들이 나와요"
    } ]
  }, {
    "tStartMs": 1806980,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "아 맞네요 가족끼리 보기 좋은"
    } ]
  }, {
    "tStartMs": 1810920,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "그리고 또 몇 년 지나면 TV에서도 나와요"
    } ]
  }, {
    "tStartMs": 1813960,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "그 영화들이 추석 특집 영화 이러면서"
    } ]
  }, {
    "tStartMs": 1817440,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 1818790,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그러네"
    } ]
  }, {
    "tStartMs": 1820390,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "디디님은 극장에서 본 한국 영화..."
    } ]
  }, {
    "tStartMs": 1824970,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "제일 마지막으로 본 게 기억이 안 나는데"
    } ]
  }, {
    "tStartMs": 1828700,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "그것도 이름이 비슷해서 또 기억이 안 나네요"
    } ]
  }, {
    "tStartMs": 1833120,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "그 바둑 두는 영화 뭐죠?"
    } ]
  }, {
    "tStartMs": 1836730,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "승부였나? 승부?"
    } ]
  }, {
    "tStartMs": 1838370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "맞아요 \u003c승부\u003e"
    } ]
  }, {
    "tStartMs": 1840080,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "승부예요?"
    } ]
  }, {
    "tStartMs": 1841220,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "네 아 이거 봐봐요 이름이 너무 헷갈려요"
    } ]
  }, {
    "tStartMs": 1844290,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "아 그러니까요"
    } ]
  }, {
    "tStartMs": 1845540,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "승부도 봤었고"
    } ]
  }, {
    "tStartMs": 1847350,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "아 이재훈이랑"
    } ]
  }, {
    "tStartMs": 1849470,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "\u003c탈주\u003e!!!"
    } ]
  }, {
    "tStartMs": 1850740,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "\u003c탈주\u003e"
    } ]
  }, {
    "tStartMs": 1852320,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "아 재밌게 봤습니다"
    } ]
  }, {
    "tStartMs": 1853780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "탈주 이렇게 두 개"
    } ]
  }, {
    "tStartMs": 1855460,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1856080,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "전 탈주 재밌게 본 것 같아요"
    } ]
  }, {
    "tStartMs": 1857910,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "아 저도 탈주 진짜 재밌게 봤어요"
    } ]
  }, {
    "tStartMs": 1860060,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "그쵸? 그거 괜찮았어요 기대 안 하고 봤는데"
    } ]
  }, {
    "tStartMs": 1864860,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "아 네 진짜 영화가 막 쉴 틈 없이 막 몰아치잖아요"
    } ]
  }, {
    "tStartMs": 1869060,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "마지막까지"
    } ]
  }, {
    "tStartMs": 1870210,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1871440,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "진짜 재밌게 봤습니다"
    } ]
  }, {
    "tStartMs": 1872830,
    "dDurationMs": 6620,
    "segs": [ {
      "utf8": "탈주에 나오는 구교환 배우님을 엄청 좋아하거든요"
    } ]
  }, {
    "tStartMs": 1879450,
    "dDurationMs": 7020,
    "segs": [ {
      "utf8": "그래서 그런 작품이 나오면 꼭 챙겨보는 편인데 너무 재밌게 봤습니다"
    } ]
  }, {
    "tStartMs": 1886470,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "구교환 배우 연기를 너무 잘해요"
    } ]
  }, {
    "tStartMs": 1890380,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "아 그러니까요"
    } ]
  }, {
    "tStartMs": 1891180,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "생활연기"
    } ]
  }, {
    "tStartMs": 1892990,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1893820,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "'연기 아니에요' 하는 그런 연기"
    } ]
  }, {
    "tStartMs": 1896860,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "저는 배우는 그렇게 해야 된다 생각해요"
    } ]
  }, {
    "tStartMs": 1900580,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "그쵸 그쵸 몰입이 되니까"
    } ]
  }, {
    "tStartMs": 1903610,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "배우라면 연기를 잘해야 되고"
    } ]
  }, {
    "tStartMs": 1906430,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "음악가라면 음악을 잘해야 되고"
    } ]
  }, {
    "tStartMs": 1908600,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "특히나 배우는 연기를 하고 있는 게 안 느껴지는 게"
    } ]
  }, {
    "tStartMs": 1912840,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "진짜 잘한다 하고 느껴지는 것 같아요"
    } ]
  }, {
    "tStartMs": 1915260,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 1916680,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "또 보고 싶은 영화는 없으세요? 마지막으로"
    } ]
  }, {
    "tStartMs": 1920210,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "기대하고 있는 영화나"
    } ]
  }, {
    "tStartMs": 1921660,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "아 지금은 없거든요"
    } ]
  }, {
    "tStartMs": 1925300,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "근데 최근에 보고싶었던 영화가 있어요"
    } ]
  }, {
    "tStartMs": 1930420,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "근데 영화관에서 내려갔어요"
    } ]
  }, {
    "tStartMs": 1932770,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "아이고 바빠서 못봤어요? 뭐였는데요?"
    } ]
  }, {
    "tStartMs": 1935480,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "네 바빠서 못봤는데"
    } ]
  }, {
    "tStartMs": 1936650,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "미션 임파서블 마지막편이었습니다"
    } ]
  }, {
    "tStartMs": 1941380,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "저 그 시리즈 진짜 좋아하는데"
    } ]
  }, {
    "tStartMs": 1946080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "근데 지나가버렸어요 정신 차리니까 끝났더라고요"
    } ]
  }, {
    "tStartMs": 1948810,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "어떡해"
    } ]
  }, {
    "tStartMs": 1949640,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "그 김치볶음밥이라도 먹으면서 보셨어야죠"
    } ]
  }, {
    "tStartMs": 1953290,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "시간을 쪼개서"
    } ]
  }, {
    "tStartMs": 1954520,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "그런 거구나! 그거였구나!"
    } ]
  }, {
    "tStartMs": 1958660,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "그렇게 바쁘다면 밥 먹을 시간에"
    } ]
  }, {
    "tStartMs": 1961500,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "그렇게 할걸!"
    } ]
  }, {
    "tStartMs": 1962930,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "그러니까요 아쉽다"
    } ]
  }, {
    "tStartMs": 1964130,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "그것도 영화관에서 봐야 재밌을 것 같은데"
    } ]
  }, {
    "tStartMs": 1966480,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "당연하죠"
    } ]
  }, {
    "tStartMs": 1967510,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "내가 그런 삶을 사는 사람이었구나"
    } ]
  }, {
    "tStartMs": 1971710,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "이런..."
    } ]
  }, {
    "tStartMs": 1972840,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "그러니까... 슬픈데?"
    } ]
  }, {
    "tStartMs": 1975940,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "스스로를 돌아보게 되네요"
    } ]
  }, {
    "tStartMs": 1977760,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "넷플릭스 나오면 다시 보세요"
    } ]
  }, {
    "tStartMs": 1979750,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "한 내년쯤 나오지 않을까요?"
    } ]
  }, {
    "tStartMs": 1982060,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "내년? 내년에도 안 나올 것 같은데?"
    } ]
  }, {
    "tStartMs": 1984350,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "그런가? 내후년?"
    } ]
  }, {
    "tStartMs": 1986780,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "워낙 대형 작품이라"
    } ]
  }, {
    "tStartMs": 1989470,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "저는 귀멸의 칼날만 볼 날을 기다리겠습니다"
    } ]
  }, {
    "tStartMs": 1994130,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "귀멸의 칼날 아 글쎄요"
    } ]
  }, {
    "tStartMs": 1996050,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "귀멸의 칼날도 제가 극장에서 한 번이라도 봤다면"
    } ]
  }, {
    "tStartMs": 2000220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "지금 생각이 달랐을까요?"
    } ]
  }, {
    "tStartMs": 2002500,
    "dDurationMs": 8090,
    "segs": [ {
      "utf8": "그러니까 4D로 봤으면 또 새로운 문명을 알았을 수도 있어요"
    } ]
  }, {
    "tStartMs": 2010590,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "여러분들 지금 듣고 계시는 분들도 최근에 재밌게 보신 영화 있으면"
    } ]
  }, {
    "tStartMs": 2015170,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "또 댓글로 남겨주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 2017950,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "저는 여러분들이 추천해주면"
    } ]
  }, {
    "tStartMs": 2020310,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "웬만하면 다 봅니다"
    } ]
  }, {
    "tStartMs": 2022040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "아 맞네요"
    } ]
  }, {
    "tStartMs": 2023800,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "저는 디디님이 추천해준 것도 거의 다 봤어요 실제로"
    } ]
  }, {
    "tStartMs": 2027680,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "그러니까 이번에도 추천 많이 해주십시오"
    } ]
  }, {
    "tStartMs": 2030040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "아 영화 추천 진짜"
    } ]
  }, {
    "tStartMs": 2032380,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "최근에 봤는데 재밌다 하는 거 업데이트된 게 있으면"
    } ]
  }, {
    "tStartMs": 2035620,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "또 알려주세요"
    } ]
  }, {
    "tStartMs": 2038090,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "감사합니다 그러면 다음 코너로 넘어가 보겠습니다"
    } ]
  }, {
    "tStartMs": 2043900,
    "dDurationMs": 8480,
    "segs": [ {
      "utf8": "\u003c말로 하는 미니게임\u003e"
    } ]
  }, {
    "tStartMs": 2052380,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "이번 코너는 말로 하는 미니게임 코너고요"
    } ]
  }, {
    "tStartMs": 2056080,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "오늘도 새로운 게임을 가져와 봤습니다"
    } ]
  }, {
    "tStartMs": 2058460,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "이번 미니게임은 좀 스피드하게 갈 거예요"
    } ]
  }, {
    "tStartMs": 2062300,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "오랫동안 이야기하지 않고 짧게 지나갈 거고요"
    } ]
  }, {
    "tStartMs": 2066560,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "뭐라고 할까..."
    } ]
  }, {
    "tStartMs": 2067600,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "\"누가 누가 빨리 말하나 게임\"으로 하겠습니다"
    } ]
  }, {
    "tStartMs": 2071030,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "저희가 오늘 영화에 대해 이야기했잖아요"
    } ]
  }, {
    "tStartMs": 2073700,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "그래서 영화 제목을 누가 누가 더 빨리 말하는지 인데"
    } ]
  }, {
    "tStartMs": 2079300,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "서로 제시어를 줄 거예요"
    } ]
  }, {
    "tStartMs": 2081860,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "예를 들면 뭐 공포영화, 한국 공포영화 다섯 가지"
    } ]
  }, {
    "tStartMs": 2085890,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "이렇게 해서 그 다섯 가지를 이야기하는데"
    } ]
  }, {
    "tStartMs": 2088640,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "얼마 정도 시간이 걸리는지를 재서 더 빠른 사람이 이기는 게임입니다"
    } ]
  }, {
    "tStartMs": 2094880,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "테마를 근데 어떻게 정해야 되지?"
    } ]
  }, {
    "tStartMs": 2098660,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "아니면 검색하지 말고"
    } ]
  }, {
    "tStartMs": 2101590,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "검색하면 안 돼요 이렇게 하고 해야 돼요"
    } ]
  }, {
    "tStartMs": 2103990,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "번갈아 가면서 대답 못할 때까지 하기?"
    } ]
  }, {
    "tStartMs": 2107550,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "아, 아예 장르를 하나 정하고요?"
    } ]
  }, {
    "tStartMs": 2110140,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2110910,
    "dDurationMs": 5550,
    "segs": [ {
      "utf8": "왜냐하면 서로 테마 난이도가 좀 안 맞을 수도 있잖아요"
    } ]
  }, {
    "tStartMs": 2116460,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "아 그래요? 그럼 그걸로 합시다"
    } ]
  }, {
    "tStartMs": 2118950,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "네 그렇게"
    } ]
  }, {
    "tStartMs": 2119980,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "이름은 \"누가 누가 더 많이 말하냐\" 게임으로 합시다"
    } ]
  }, {
    "tStartMs": 2123400,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "누가 누가 더 많이 말하냐"
    } ]
  }, {
    "tStartMs": 2124560,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "대신 시간 제한은 두죠?"
    } ]
  }, {
    "tStartMs": 2126980,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "어떻게요?"
    } ]
  }, {
    "tStartMs": 2127940,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "몇 초 안에..."
    } ]
  }, {
    "tStartMs": 2129340,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "이해가 안 돼요"
    } ]
  }, {
    "tStartMs": 2130220,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "그러니까 제가 하나 말하고 나면"
    } ]
  }, {
    "tStartMs": 2132440,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "디디님은 5초 안에 얘기해야 되고"
    } ]
  }, {
    "tStartMs": 2135030,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "아 오케이 그런 식으로요? 알겠습니다"
    } ]
  }, {
    "tStartMs": 2138880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "몇 초로 할까요?"
    } ]
  }, {
    "tStartMs": 2140320,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "5초 합시다"
    } ]
  }, {
    "tStartMs": 2142090,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "5초 넘어가면 안 되는 거고\n- 검색하기 없기"
    } ]
  }, {
    "tStartMs": 2145850,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "검색하면 안 되고"
    } ]
  }, {
    "tStartMs": 2148200,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "한국 영화, 외국 영화 상관없습니다"
    } ]
  }, {
    "tStartMs": 2151220,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그러면 3라운드 할까요?"
    } ]
  }, {
    "tStartMs": 2152410,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "장르 3개씩? 테마 3개씩?"
    } ]
  }, {
    "tStartMs": 2154910,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "네, 좋아요\n- 오케이 오케이"
    } ]
  }, {
    "tStartMs": 2156850,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "테마 저부터 갈까요?"
    } ]
  }, {
    "tStartMs": 2158310,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2158940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "쉬운 거부터 할게요"
    } ]
  }, {
    "tStartMs": 2161070,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "'판타지 영화'"
    } ]
  }, {
    "tStartMs": 2163260,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "숫자는 상대방이 세주세요"
    } ]
  }, {
    "tStartMs": 2165150,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "그리고 시즌 1, 2, 3 안 됩니다"
    } ]
  }, {
    "tStartMs": 2167940,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "압니다 압니다 압니다"
    } ]
  }, {
    "tStartMs": 2169090,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "시작!"
    } ]
  }, {
    "tStartMs": 2169860,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "해리포터\n- 해리ㅍ... 아 잠깐만요"
    } ]
  }, {
    "tStartMs": 2173890,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "아 디디 님 먼저, 디디 님 먼저? 오케이 오케이"
    } ]
  }, {
    "tStartMs": 2175880,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "아 해리포터 뺏겼다..."
    } ]
  }, {
    "tStartMs": 2178300,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "아니 먼저 하세요, 해리포터로"
    } ]
  }, {
    "tStartMs": 2179890,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "아 괜찮아요, 먼저 하세요, 먼저 하세요"
    } ]
  }, {
    "tStartMs": 2181830,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "괜찮아요? \u003c해리포터\u003e"
    } ]
  }, {
    "tStartMs": 2183710,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "오케이"
    } ]
  }, {
    "tStartMs": 2185060,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "\u003c반지의 제왕\u003e"
    } ]
  }, {
    "tStartMs": 2191940,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "\u003c신비한 동물 사전\u003e 아 잠깐만요"
    } ]
  }, {
    "tStartMs": 2194250,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "아니 그거 해리포터잖아요, 그거"
    } ]
  }, {
    "tStartMs": 2195970,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "아니에요!"
    } ]
  }, {
    "tStartMs": 2197040,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "아 아닌가?"
    } ]
  }, {
    "tStartMs": 2198180,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "네 아예 다른 영화예요 5초 지났어요?"
    } ]
  }, {
    "tStartMs": 2200520,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "딱 5초에 걸렸어요"
    } ]
  }, {
    "tStartMs": 2202170,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "아 신비한 동물사전"
    } ]
  }, {
    "tStartMs": 2204810,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "판타지? 아이씨 그러면 나는 \u003c호빗\u003e"
    } ]
  }, {
    "tStartMs": 2208200,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "해도 괜찮아요"
    } ]
  }, {
    "tStartMs": 2208820,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "어 그렇네 그렇네"
    } ]
  }, {
    "tStartMs": 2209750,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "잠깐만 처음에 반지의 제왕이라 하셨어요?"
    } ]
  }, {
    "tStartMs": 2212160,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "네 다른 영화입니다"
    } ]
  }, {
    "tStartMs": 2214360,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2215840,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "\u003c트와일라잇\u003e"
    } ]
  }, {
    "tStartMs": 2217090,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "아 트와일라잇 오케이"
    } ]
  }, {
    "tStartMs": 2219650,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "제 차례죠?"
    } ]
  }, {
    "tStartMs": 2221890,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "\u003c언더월드\u003e"
    } ]
  }, {
    "tStartMs": 2227490,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "\u003c웡카\u003e 판타지에요?"
    } ]
  }, {
    "tStartMs": 2230560,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "판타지죠"
    } ]
  }, {
    "tStartMs": 2231780,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "아 오케이 오케이"
    } ]
  }, {
    "tStartMs": 2234240,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "아이 그러면..."
    } ]
  }, {
    "tStartMs": 2239610,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "반헬싱"
    } ]
  }, {
    "tStartMs": 2243150,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "예?"
    } ]
  }, {
    "tStartMs": 2245140,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "반헬싱?"
    } ]
  }, {
    "tStartMs": 2245820,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "그거 판타지에요 드라큘라 나오는 판타지에요"
    } ]
  }, {
    "tStartMs": 2247670,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 2248550,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2250670,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "5 4 3 2"
    } ]
  }, {
    "tStartMs": 2254980,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "골룸"
    } ]
  }, {
    "tStartMs": 2256310,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "예?"
    } ]
  }, {
    "tStartMs": 2257430,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "골룸 영화 있지 않아요?"
    } ]
  }, {
    "tStartMs": 2258820,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "영화가 있어요 그거?"
    } ]
  }, {
    "tStartMs": 2260580,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "있을걸요?"
    } ]
  }, {
    "tStartMs": 2261400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "진짜 있어요? 그거 어?"
    } ]
  }, {
    "tStartMs": 2262920,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "골룸이 태어나서 어떻게 골룸이 됐는지..."
    } ]
  }, {
    "tStartMs": 2265920,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "아 없네요"
    } ]
  }, {
    "tStartMs": 2270770,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "자 1승 1승입니다 1승"
    } ]
  }, {
    "tStartMs": 2271960,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "아 판타지 어렵다 왜 생각이 안 나지 갑자기?"
    } ]
  }, {
    "tStartMs": 2275180,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "진짜 진짜 어려운데?"
    } ]
  }, {
    "tStartMs": 2276600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "또 뭐가 있을까요 판타지?"
    } ]
  }, {
    "tStartMs": 2278480,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "아 뭐 \u003c오즈의 마법사\u003e 이런 것도 있었을 텐데"
    } ]
  }, {
    "tStartMs": 2281250,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "그것도 영화가 있나?"
    } ]
  }, {
    "tStartMs": 2285040,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "제가 졌고요"
    } ]
  }, {
    "tStartMs": 2287330,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "2라운드"
    } ]
  }, {
    "tStartMs": 2288440,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "2라운드입니다 테마는 제가 정하는 거고요"
    } ]
  }, {
    "tStartMs": 2291930,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "정하고 태웅쌤이 먼저"
    } ]
  }, {
    "tStartMs": 2293890,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "아 네네네"
    } ]
  }, {
    "tStartMs": 2297090,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "테마는?"
    } ]
  }, {
    "tStartMs": 2298110,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "테마는,"
    } ]
  }, {
    "tStartMs": 2299510,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "한국 외국 상관없이 제목이 다섯 글자 이상인 영화"
    } ]
  }, {
    "tStartMs": 2304500,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "다섯 글자 이상인 영화 다섯 글자도 되는 거예요"
    } ]
  }, {
    "tStartMs": 2308840,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2312000,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "\u003c골든슬럼버\u003e"
    } ]
  }, {
    "tStartMs": 2315940,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "\u003c트와일라잇\u003e"
    } ]
  }, {
    "tStartMs": 2320830,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "\u003c반지의 제왕\u003e"
    } ]
  }, {
    "tStartMs": 2324480,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "\u003c벤자민 버튼의 시간은 거꾸로 간다\u003e"
    } ]
  }, {
    "tStartMs": 2335840,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "잠시만!"
    } ]
  }, {
    "tStartMs": 2337060,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "저기요"
    } ]
  }, {
    "tStartMs": 2337970,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "아니 왜 이렇게 생각이 안 나지?"
    } ]
  }, {
    "tStartMs": 2340800,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "\u003c포레스트 검프\u003e!\n- 아 \u003c포레스트 검프\u003e도 있고..."
    } ]
  }, {
    "tStartMs": 2343280,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "\u003c귀멸의 칼날\u003e"
    } ]
  }, {
    "tStartMs": 2344170,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "\u003c귀멸의 칼날\u003e도 있고"
    } ]
  }, {
    "tStartMs": 2348830,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "어렵다 머리가 안 굴러가네 오늘"
    } ]
  }, {
    "tStartMs": 2351760,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "아니 영화를 너무 요새 안 봐서...\n- 너무 빨리 끝나겠네"
    } ]
  }, {
    "tStartMs": 2355420,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "와 순식간에 두 라운드가 끝났네요\n- 그러니까요"
    } ]
  }, {
    "tStartMs": 2358370,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "1대1이고요"
    } ]
  }, {
    "tStartMs": 2360050,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "다음 건 좀 많이 이야기할 수 있는 걸로 해볼게요"
    } ]
  }, {
    "tStartMs": 2362530,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2363570,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "아...! 아니다"
    } ]
  }, {
    "tStartMs": 2365440,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "왜요?"
    } ]
  }, {
    "tStartMs": 2366300,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "애니메이션 영화라고 하려고 했어요"
    } ]
  }, {
    "tStartMs": 2368830,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "그거는 꽤 괜찮을 것 같은데"
    } ]
  }, {
    "tStartMs": 2370690,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "괜찮아요?"
    } ]
  }, {
    "tStartMs": 2371130,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "오래 갈 수 있지 않을까요?"
    } ]
  }, {
    "tStartMs": 2372670,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "네, 좋아요 그러면 애니메이션 영화 이야기하기"
    } ]
  }, {
    "tStartMs": 2375790,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2377300,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "저부터"
    } ]
  }, {
    "tStartMs": 2379230,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "몬스터 주식회사"
    } ]
  }, {
    "tStartMs": 2382500,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "인크레더블"
    } ]
  }, {
    "tStartMs": 2384820,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "미니언즈"
    } ]
  }, {
    "tStartMs": 2386310,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "미니언즈?"
    } ]
  }, {
    "tStartMs": 2387290,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "바람계곡의 나우시카"
    } ]
  }, {
    "tStartMs": 2389940,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "라따뚜이"
    } ]
  }, {
    "tStartMs": 2391360,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "라따뚜이?"
    } ]
  }, {
    "tStartMs": 2393650,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "어..."
    } ]
  }, {
    "tStartMs": 2394720,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "하늘에서 음식이 떨어진다(?)"
    } ]
  }, {
    "tStartMs": 2395970,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "오, 그거 재밌는데"
    } ]
  }, {
    "tStartMs": 2399240,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "5. 4."
    } ]
  }, {
    "tStartMs": 2401150,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "엘리멘탈"
    } ]
  }, {
    "tStartMs": 2401900,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "어, 엘리멘탈 오케이"
    } ]
  }, {
    "tStartMs": 2404640,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "그럼 인사이드 아웃"
    } ]
  }, {
    "tStartMs": 2406690,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "너무 쉬운 디즈니로 가시나요?"
    } ]
  }, {
    "tStartMs": 2409060,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "겨울왕국"
    } ]
  }, {
    "tStartMs": 2410190,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "겨울왕국? 오케이"
    } ]
  }, {
    "tStartMs": 2412460,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "붉은 돼지"
    } ]
  }, {
    "tStartMs": 2414400,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "지브리 좋아하시네"
    } ]
  }, {
    "tStartMs": 2416780,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "포뇨"
    } ]
  }, {
    "tStartMs": 2419210,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "벼랑 끝에 포뇨(?)"
    } ]
  }, {
    "tStartMs": 2420560,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "어, 인정합니다"
    } ]
  }, {
    "tStartMs": 2424010,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "주먹왕 랄프"
    } ]
  }, {
    "tStartMs": 2427810,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "좋은 영화죠"
    } ]
  }, {
    "tStartMs": 2429440,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "4 3 2..."
    } ]
  }, {
    "tStartMs": 2433410,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "인사이드 아웃"
    } ]
  }, {
    "tStartMs": 2434510,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "제가 안 했나요? 아까 그거?"
    } ]
  }, {
    "tStartMs": 2435800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "했어요?"
    } ]
  }, {
    "tStartMs": 2437000,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "제가 한 것 같은데?"
    } ]
  }, {
    "tStartMs": 2438180,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "진짜요?"
    } ]
  }, {
    "tStartMs": 2438890,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "엘리멘탈 다음에 인사이드 아웃 제가 하지 않았어요?\n- 바로 했어요?"
    } ]
  }, {
    "tStartMs": 2445170,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "아직 말하지 못한 애니메이션이 많은데..."
    } ]
  }, {
    "tStartMs": 2448300,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "한번 물러드릴까요?"
    } ]
  }, {
    "tStartMs": 2451840,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "\u003c인사이드 아웃\u003e이 아니고..."
    } ]
  }, {
    "tStartMs": 2457500,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "\u003c월E\u003e\n- 내가 했나? 내가 했나?"
    } ]
  }, {
    "tStartMs": 2461560,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "안 했어요! \u003c월E\u003e"
    } ]
  }, {
    "tStartMs": 2463820,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "\u003c월E\u003e? \u003c월E\u003e? 오케이"
    } ]
  }, {
    "tStartMs": 2467550,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "\u003c센과 치히로의 행방불명\u003e"
    } ]
  }, {
    "tStartMs": 2469380,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "준비되어 있네"
    } ]
  }, {
    "tStartMs": 2471740,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "\u003c그대들은 어떻게 살 것인가\u003e"
    } ]
  }, {
    "tStartMs": 2474110,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "지브리입니다"
    } ]
  }, {
    "tStartMs": 2477500,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "5 4 3 2"
    } ]
  }, {
    "tStartMs": 2480700,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "\u003c스폰지밥 밥 더 무비\u003e"
    } ]
  }, {
    "tStartMs": 2484390,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "인정 인정 그거 재밌는데"
    } ]
  }, {
    "tStartMs": 2488190,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "\u003c마루밑 아리에티\u003e? 맞나?"
    } ]
  }, {
    "tStartMs": 2491960,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "맞아요 맞아요"
    } ]
  }, {
    "tStartMs": 2494340,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "\u003c너의 이름은\u003e"
    } ]
  }, {
    "tStartMs": 2497180,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "애니 좋아하시네요"
    } ]
  }, {
    "tStartMs": 2502210,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "\u003c날씨의 아이\u003e"
    } ]
  }, {
    "tStartMs": 2505680,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "\u003c스즈메의 문단속\u003e"
    } ]
  }, {
    "tStartMs": 2507490,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "예?"
    } ]
  }, {
    "tStartMs": 2508480,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "\u003c스즈메의 문단속\u003e"
    } ]
  }, {
    "tStartMs": 2509640,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 2512570,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "\u003c시간을 달리는 소녀\u003e"
    } ]
  }, {
    "tStartMs": 2517330,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "\u003c초속 5CM\u003e"
    } ]
  }, {
    "tStartMs": 2518700,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "아 진짜... 천재들의 대결이다"
    } ]
  }, {
    "tStartMs": 2523870,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "\u003c고양이의 보은\u003e"
    } ]
  }, {
    "tStartMs": 2528610,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "\u003c귀멸의 칼날\u003e"
    } ]
  }, {
    "tStartMs": 2530370,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "안했어요?"
    } ]
  }, {
    "tStartMs": 2533040,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "\u003c하울의 움직이는 성\u003e"
    } ]
  }, {
    "tStartMs": 2537700,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "\u003c공각기동대\u003e"
    } ]
  }, {
    "tStartMs": 2539330,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "에? 그런게 있어요?"
    } ]
  }, {
    "tStartMs": 2541030,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "있어요 명작입니다"
    } ]
  }, {
    "tStartMs": 2543620,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "영화로만 있는거에요?"
    } ]
  }, {
    "tStartMs": 2544930,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "네네"
    } ]
  }, {
    "tStartMs": 2546480,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "보겠습니다"
    } ]
  }, {
    "tStartMs": 2547690,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "명작이에요 명작 아무튼"
    } ]
  }, {
    "tStartMs": 2550600,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "어 잠깐만요..."
    } ]
  }, {
    "tStartMs": 2553730,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "\u003c슈렉\u003e"
    } ]
  }, {
    "tStartMs": 2555710,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "슈렉? 오 오케이"
    } ]
  }, {
    "tStartMs": 2557580,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "\u003c장화신은 고양이\u003e"
    } ]
  }, {
    "tStartMs": 2561700,
    "dDurationMs": 5650,
    "segs": [ {
      "utf8": "5, 4, 3, 2..."
    } ]
  }, {
    "tStartMs": 2567350,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "스머프?"
    } ]
  }, {
    "tStartMs": 2569860,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "\u003c스머프\u003e예요? 스머프 그냥?"
    } ]
  }, {
    "tStartMs": 2571460,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "스머프"
    } ]
  }, {
    "tStartMs": 2572380,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "그냥 스머프?"
    } ]
  }, {
    "tStartMs": 2573500,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "네 그런 영화 있지 않을까요?"
    } ]
  }, {
    "tStartMs": 2576070,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "스머프!"
    } ]
  }, {
    "tStartMs": 2576640,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "딱 스머프입니까?"
    } ]
  }, {
    "tStartMs": 2578590,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2579140,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "'더 무비' 이런 거 없고 그냥 스머프입니까?"
    } ]
  }, {
    "tStartMs": 2581550,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "Smurf~!"
    } ]
  }, {
    "tStartMs": 2584060,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "한번 확인해봅니다"
    } ]
  }, {
    "tStartMs": 2586930,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "\u003c스머프\u003e 있다! 2025년"
    } ]
  }, {
    "tStartMs": 2589120,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "바로 이번 달에 나왔습니다"
    } ]
  }, {
    "tStartMs": 2591390,
    "dDurationMs": 6090,
    "segs": [ {
      "utf8": "와 뭐야"
    } ]
  }, {
    "tStartMs": 2597480,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "\u003c킹 오브 킹스\u003e"
    } ]
  }, {
    "tStartMs": 2600160,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그런 게 있어요?"
    } ]
  }, {
    "tStartMs": 2601210,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "그것도 최근에 나온 영화입니다"
    } ]
  }, {
    "tStartMs": 2603330,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "오케이"
    } ]
  }, {
    "tStartMs": 2605380,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "5 4"
    } ]
  }, {
    "tStartMs": 2606550,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "트롤!"
    } ]
  }, {
    "tStartMs": 2608290,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "트롤? 오"
    } ]
  }, {
    "tStartMs": 2609900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "재밌어요 트롤 좋아하는 애니메이션입니다"
    } ]
  }, {
    "tStartMs": 2612600,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "오케이"
    } ]
  }, {
    "tStartMs": 2613940,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "5 4 3 2..."
    } ]
  }, {
    "tStartMs": 2617860,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "잠깐만! 잠깐만!"
    } ]
  }, {
    "tStartMs": 2619910,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "너무 빨랐나?"
    } ]
  }, {
    "tStartMs": 2622080,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "2..."
    } ]
  }, {
    "tStartMs": 2625250,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "1..."
    } ]
  }, {
    "tStartMs": 2629870,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "순식간에 머리가 새하얘지네"
    } ]
  }, {
    "tStartMs": 2632520,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "그쵸 한 번 정지되면 움직이지 않아요"
    } ]
  }, {
    "tStartMs": 2637320,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "오늘 승자는 저입니다"
    } ]
  }, {
    "tStartMs": 2643350,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "아쉽다 애니메이션 좀 더 봐야 되겠다"
    } ]
  }, {
    "tStartMs": 2647280,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "근데 되게 매니악한 애니메이션 이름들이 많이 나왔어요"
    } ]
  }, {
    "tStartMs": 2651330,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "그렇네요"
    } ]
  }, {
    "tStartMs": 2652830,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "\u003c나우시카\u003e 이런 거"
    } ]
  }, {
    "tStartMs": 2655550,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "오늘도 요런 미니게임까지 해봤는데 여러분들도 심심할 때"
    } ]
  }, {
    "tStartMs": 2658820,
    "dDurationMs": 6710,
    "segs": [ {
      "utf8": "친구들이랑 한번 해보세요 은근 재밌습니다"
    } ]
  }, {
    "tStartMs": 2665530,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "그래서 이제 다음 주제 이야기 해볼까 하는데요"
    } ]
  }, {
    "tStartMs": 2669130,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "다음 주제는 어떤 게 좋을까요?"
    } ]
  }, {
    "tStartMs": 2671810,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "다음 주제는 지난번에 오프라인으로 녹화를 할 때 했었던"
    } ]
  }, {
    "tStartMs": 2678250,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "플레이리스트가 많은 사랑을 받은 것 같아서"
    } ]
  }, {
    "tStartMs": 2683110,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "이번에 또 한번 해보고자 합니다"
    } ]
  }, {
    "tStartMs": 2685370,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "플레이리스트"
    } ]
  }, {
    "tStartMs": 2686000,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "근데 저번에는 한국 여행 오면 좋을 때?"
    } ]
  }, {
    "tStartMs": 2689930,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "'한국 여행 올 때 들으면 좋을 노래 다섯 가지'였는데"
    } ]
  }, {
    "tStartMs": 2694580,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "이번에는 어떤 걸로 할까요?"
    } ]
  }, {
    "tStartMs": 2696730,
    "dDurationMs": 5750,
    "segs": [ {
      "utf8": "이번에는 여러분들이 한국어 공부하다가 쉬면서"
    } ]
  }, {
    "tStartMs": 2702480,
    "dDurationMs": 5940,
    "segs": [ {
      "utf8": "산책할 때 듣기 좋은 노래들 플레이리스트로 하기로 하겠습니다"
    } ]
  }, {
    "tStartMs": 2708420,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "외국 노래, 한국 노래 다 상관없이 해볼까요?"
    } ]
  }, {
    "tStartMs": 2711970,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "네네 좋아요"
    } ]
  }, {
    "tStartMs": 2712620,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "떠오르는 노래로"
    } ]
  }, {
    "tStartMs": 2714260,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "다섯 곡씩 한 번... 아닌가?"
    } ]
  }, {
    "tStartMs": 2716630,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "세 곡씩 준비해서 와봅시다"
    } ]
  }, {
    "tStartMs": 2720220,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "네 좋습니다"
    } ]
  }, {
    "tStartMs": 2721800,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "오늘은 영화에 대해서 요모조모 이야기 해봤고요"
    } ]
  }, {
    "tStartMs": 2724390,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "다음 주는 노래 세 가지 뽑아서"
    } ]
  }, {
    "tStartMs": 2728070,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "요모조모 이야기 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 2730560,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "여기까지 디디와 정태웅이었습니다"
    } ]
  }, {
    "tStartMs": 2733650,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "감사합니다"
    } ]
  } ]
}
