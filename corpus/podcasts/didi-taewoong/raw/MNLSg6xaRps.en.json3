  }, {
    "tStartMs": 2585200,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2587620,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "If it's men, it's definitely gaming"
