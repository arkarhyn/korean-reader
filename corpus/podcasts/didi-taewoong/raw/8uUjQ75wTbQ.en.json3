  }, {
    "tStartMs": 2601900,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "It's also a food made by fermenting beans."
    } ]
  }, {
    "tStartMs": 2605410,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2607040,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "And it has that deep, savory flavor."
    } ]
  }, {
    "tStartMs": 2609480,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "That deep, savory taste."
    } ]
  }, {
    "tStartMs": 2611610,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2612820,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "I'll explain the difference next time."
    } ]
  }, {
    "tStartMs": 2614930,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "There's a difference between gosohada and gusuohada."
    } ]
  }, {
    "tStartMs": 2616660,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "It's that deep, savory flavor, right?"
