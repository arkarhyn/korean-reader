  }, {
    "tStartMs": 2242710,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "This segment is a word-based mini game time,"
    } ]
  }, {
    "tStartMs": 2247090,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "and I've brought a new game for you"
    } ]
  }, {
    "tStartMs": 2250710,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "We've talked a lot about taste expressions today, right?"
    } ]
  }, {
    "tStartMs": 2253200,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So you all and food"
    } ]
  }, {
    "tStartMs": 2256290,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "to help make some connection with this taste"
    } ]
  }, {
    "tStartMs": 2260230,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "is a game I've prepared."
    } ]
  }, {
    "tStartMs": 2261280,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "The game is called the 'Taste Expression Relay Game'."
    } ]
  }, {
    "tStartMs": 2265270,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "'Taste Expression Relay Game'"
    } ]
  }, {
    "tStartMs": 2267020,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "What kind of game is it?"
    } ]
  }, {
    "tStartMs": 2269400,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Now one person talks about a taste first."
    } ]
  }, {
    "tStartMs": 2272940,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "For example, 'spicy'."
    } ]
  }, {
    "tStartMs": 2275320,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Then the next person"
    } ]
  }, {
    "tStartMs": 2277150,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "talks about one spicy food."
    } ]
  }, {
    "tStartMs": 2280730,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Then the next person..."
    } ]
  }, {
    "tStartMs": 2283520,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "For example, what could there be? A spicy food is tteokbokki."
    } ]
  }, {
    "tStartMs": 2286900,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "Then the next person talks about another taste that comes from tteokbokki."
    } ]
  }, {
    "tStartMs": 2292520,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "There could be a sweet taste, right?"
    } ]
  }, {
    "tStartMs": 2294930,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Continuing like that is"
    } ]
  }, {
    "tStartMs": 2296820,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "the Taste Expression Relay Game."
    } ]
  }, {
    "tStartMs": 2299290,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "Good, so when two people play, you talk about food and"
    } ]
  }, {
    "tStartMs": 2302640,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "then you just talk about the taste, right?"
    } ]
  }, {
    "tStartMs": 2304660,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Tteokbokki - spicy, shall we do it like that?"
    } ]
  }, {
    "tStartMs": 2307320,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "One person talks about both the taste and the food,"
    } ]
  }, {
    "tStartMs": 2311090,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "and the next person talks about the taste and the food..."
