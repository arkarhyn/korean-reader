  }, {
    "tStartMs": 2165090,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "that tasting it directly is probably"
    } ]
  }, {
    "tStartMs": 2168980,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "coming here and tasting it yourself would be the fastest way to understand, I think"
    } ]
  }, {
    "tStartMs": 2174080,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "Come and try something like gukbap and feel 'oh, so this is what siwonhada feels like'"
