  }, {
    "tStartMs": 2639580,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Numbing and tingling."
    } ]
  }, {
    "tStartMs": 2641240,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Okay, numbing and tingling."
    } ]
  }, {
    "tStartMs": 2644510,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "Let's go back and forth on this game just three times and then wrap it up."
    } ]
  }, {
    "tStartMs": 2647860,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "This one seems like it could go on forever."
    } ]
  }, {
    "tStartMs": 2649950,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "You're right, you're right."
    } ]
  }, {
    "tStartMs": 2651400,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Numbing and tingling?"
    } ]
  }, {
    "tStartMs": 2652540,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "Tiba two-piece chicken, garlic and red pepper chicken."
    } ]
  }, {
    "tStartMs": 2658440,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Nobody can relate to that."
    } ]
  }, {
    "tStartMs": 2660640,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "That one is numbing and tingling, that one!"
    } ]
  }, {
    "tStartMs": 2662600,
    "dDurationMs": 5170,
    "segs": [ {
      "utf8": "No, nobody's tried it, you listeners."
    } ]
  }, {
    "tStartMs": 2667770,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "What's Tiba two-piece?"
    } ]
  }, {
    "tStartMs": 2670100,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Tiba two-piece chicken is."
    } ]
  }, {
    "tStartMs": 2673730,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Red pepper and garlic chicken."
    } ]
  }, {
    "tStartMs": 2674960,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Red pepper and garlic chicken."
    } ]
  }, {
    "tStartMs": 2676340,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "It does seem like it would be quite numbing and tingling with red pepper and garlic."
    } ]
  }, {
    "tStartMs": 2680190,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Yes, it's red pepper and garlic chicken."
    } ]
  }, {
    "tStartMs": 2681650,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "If you do half fried and half red pepper and garlic, it's really the best."
    } ]
  }, {
    "tStartMs": 2687290,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Even a chicken recommendation."
    } ]
  }, {
    "tStartMs": 2688890,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Yes, anyway and."
    } ]
  }, {
    "tStartMs": 2691030,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Salty."
    } ]
  }, {
    "tStartMs": 2691930,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "Salty."
    } ]
  }, {
    "tStartMs": 2693420,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "It's salty."
    } ]
  }, {
    "tStartMs": 2694100,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "I see, it is salty."
    } ]
  }, {
    "tStartMs": 2695520,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "The salty ones—for me it's Japanese ramen."
    } ]
  }, {
    "tStartMs": 2699790,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "It's really salty."
    } ]
  }, {
    "tStartMs": 2701530,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "But because of the pork fat..."
    } ]
  }, {
    "tStartMs": 2704600,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "But now that I think about it, ramen doesn't really have a refreshing taste."
    } ]
  }, {
    "tStartMs": 2709520,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Ramen comes in many different types, you know."
    } ]
  }, {
    "tStartMs": 2712740,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "There's tonkotsu ramen, and there's shio ramen too."
    } ]
  }, {
    "tStartMs": 2715710,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And there's abura as well."
    } ]
  }, {
    "tStartMs": 2718210,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And shoyu ramen too, isn't there?"
    } ]
  }, {
    "tStartMs": 2720050,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2721110,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "But I think tonkotsu ramen has a refreshing taste."
    } ]
  }, {
    "tStartMs": 2723340,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "You think it has a refreshing taste?"
    } ]
  }, {
    "tStartMs": 2725530,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Because it's pork broth."
    } ]
  }, {
    "tStartMs": 2726870,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "For me, when something is too rich and heavy,"
    } ]
  }, {
    "tStartMs": 2730840,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "it doesn't give off that refreshing feeling."
    } ]
  }, {
    "tStartMs": 2733270,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Because there's oil in it."
    } ]
  }, {
    "tStartMs": 2736050,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "I would say it's nutty."
    } ]
  }, {
    "tStartMs": 2737800,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "That oily flavor."
    } ]
  }, {
    "tStartMs": 2739540,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Nutty?"
    } ]
  }, {
    "tStartMs": 2741060,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "Then peanut butter sandwich—"
    } ]
  }, {
    "tStartMs": 2743450,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "I really like it."
    } ]
  }, {
    "tStartMs": 2745200,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "It's sweet."
    } ]
  }, {
    "tStartMs": 2746220,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "And peanuts seem to have a bit of a bitter taste to them."
    } ]
  }, {
    "tStartMs": 2750410,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2751190,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Or not?"
    } ]
  }, {
    "tStartMs": 2752120,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "If it's an organic product, it could be like that."
    } ]
  }, {
    "tStartMs": 2755320,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "If it's 100% peanut, there can be a slightly bitter taste to it."
    } ]
  }, {
    "tStartMs": 2760690,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "So we've done this relay game like this."
    } ]
  }, {
    "tStartMs": 2763860,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Since we've done it, I hope it's been helpful for you all to now"
    } ]
  }, {
    "tStartMs": 2767280,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "connect Korean taste expressions with food."
    } ]
  }, {
    "tStartMs": 2771870,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So then, the next topic is—"
    } ]
  }, {
    "tStartMs": 2773790,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "What would be a good next topic?"
    } ]
  }, {
    "tStartMs": 2776600,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "The next topic is actually"
    } ]
  }, {
    "tStartMs": 2778650,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "hobbies."
    } ]
  }, {
    "tStartMs": 2780760,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "It seems like we haven't really talked about hobbies as a proper topic until now,"
    } ]
  }, {
    "tStartMs": 2786110,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "so whether it's hobbies you have these days or hobbies you want to have,"
    } ]
  }, {
    "tStartMs": 2789720,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "I think it would be good to talk about those kinds of things broadly."
    } ]
  }, {
    "tStartMs": 2793070,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Well, that's all from Didi and Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 2795830,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  } ]
