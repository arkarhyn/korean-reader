  }, {
    "tStartMs": 2632260,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Sharp and pungent."
    } ]
  }, {
    "tStartMs": 2633280,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "Spicy fish stew."
    } ]
  }, {
    "tStartMs": 2634710,
