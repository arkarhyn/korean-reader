  }, {
    "tStartMs": 2636030,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Spicy means."
    } ]
  }, {
    "tStartMs": 2637790,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "Buldak bokkeummyeon."
