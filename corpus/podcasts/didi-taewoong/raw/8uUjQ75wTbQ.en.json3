  }, {
    "tStartMs": 2114650,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "the ingredients are fresh"
    } ]
  }, {
    "tStartMs": 2117430,
    "dDurationMs": 3970,
    "segs": [ {
