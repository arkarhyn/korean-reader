  }, {
    "tStartMs": 2220900,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Number 2: rice noodle soup"
    } ]
  }, {
    "tStartMs": 2223390,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "Number 3: pork gukbap"
    } ]
  }, {
    "tStartMs": 2225360,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So if you know the answer here,"
    } ]
  }, {
    "tStartMs": 2227550,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "please leave lots of comments,"
    } ]
  }, {
    "tStartMs": 2229690,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and we'll move on to our next segment"
