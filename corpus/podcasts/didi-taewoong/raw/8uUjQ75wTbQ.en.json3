  }, {
    "tStartMs": 2619770,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "I can only think of soybean paste dishes."
    } ]
  }, {
    "tStartMs": 2623110,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "For that deep, savory taste."
    } ]
  }, {
    "tStartMs": 2625550,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Doenjang jjigae."
    } ]
  }, {
    "tStartMs": 2628050,
