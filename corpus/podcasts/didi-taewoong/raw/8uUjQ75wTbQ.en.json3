  }, {
    "tStartMs": 2201930,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Perfect"
    } ]
  }, {
    "tStartMs": 2203250,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "So now let me tell you this week's quiz too"
