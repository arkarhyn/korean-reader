    "segs": [ {
      "utf8": "Right, mint, salad"
    } ]
  }, {
    "tStartMs": 2145950,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "I think it would be good to express it that way"
    } ]
  }, {
    "tStartMs": 2149910,
    "dDurationMs": 5410,
    "segs": [ {
      "utf8": "So we've done our best to explain Korean taste expressions now,"
