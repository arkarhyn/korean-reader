  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 9470,
    "segs": [ {
      "utf8": "\u003cYomojomo of Korean Life with Didi and Jeong Tae-woong\u003e"
    } ]
  }, {
    "tStartMs": 9470,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Hello, this is Didi."
    } ]
  }, {
    "tStartMs": 11900,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "Hello, this is Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 13590,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Yomojomo of Korean Life is a podcast where two people living in Korea"
    } ]
  }, {
    "tStartMs": 16970,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "talk about the various aspects of Korean life."
    } ]
  }, {
    "tStartMs": 20660,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So what was the keyword you chose today?"
    } ]
  }, {
    "tStartMs": 24110,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The keyword we chose today is 'airport'."
    } ]
  }, {
    "tStartMs": 27150,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "Before we talk about the airport..."
    } ]
  }, {
    "tStartMs": 31220,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "how have you been doing?"
    } ]
  }, {
    "tStartMs": 33900,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "I've been really busy with a lot of things lately."
    } ]
  }, {
    "tStartMs": 38210,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "The New Year's goals that I mentioned on my channel before,"
    } ]
  }, {
    "tStartMs": 41840,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "I'm in the process of realizing them one by one."
    } ]
  }, {
    "tStartMs": 45080,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "You've completed a few of them?"
    } ]
  }, {
    "tStartMs": 47690,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "I've completed one,"
    } ]
  }, {
    "tStartMs": 52790,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "which was the secret to becoming rich that I talked about,"
    } ]
  }, {
    "tStartMs": 57660,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "and I finally finished the website."
    } ]
  }, {
    "tStartMs": 62340,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "And then there's another goal that I haven't completed yet,"
    } ]
  }, {
    "tStartMs": 67410,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but song making..."
    } ]
  }, {
    "tStartMs": 69360,
    "dDurationMs": 6770,
    "segs": [ {
      "utf8": "One of my subscribers has been helping me write the lyrics really well,"
    } ]
  }, {
    "tStartMs": 76130,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "and I'm making the beat,"
    } ]
  }, {
    "tStartMs": 78550,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "and a really proper, polished song is being completed."
    } ]
  }, {
    "tStartMs": 83010,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "A polished song? Is it K-pop? What is it?"
    } ]
  }, {
    "tStartMs": 87170,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "It's not K-pop,"
    } ]
  }, {
    "tStartMs": 89310,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "more like R\u0026B hip-hop?"
    } ]
  }, {
    "tStartMs": 91630,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "So who's singing the song?"
    } ]
  }, {
    "tStartMs": 94110,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "There's a singer for it too."
    } ]
  }, {
    "tStartMs": 97330,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Wow, so you're opening a website"
    } ]
  }, {
    "tStartMs": 100970,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "and making a polished song right now?"
    } ]
  }, {
    "tStartMs": 104560,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 105410,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "What kind of website is it? Can you share it with us now?"
    } ]
  }, {
    "tStartMs": 108720,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "I can share it,"
    } ]
  }, {
    "tStartMs": 109640,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "but actually... it's specialized for Korean people..."
    } ]
  }, {
    "tStartMs": 114210,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "What is it?"
    } ]
  }, {
    "tStartMs": 116450,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "To explain it simply,"
    } ]
  }, {
    "tStartMs": 119820,
    "dDurationMs": 6140,
    "segs": [ {
      "utf8": "it's like the IMDb site that foreigners and Western people would be familiar with,"
    } ]
  }, {
    "tStartMs": 125960,
    "dDurationMs": 8770,
    "segs": [ {
      "utf8": "where IMDb gives ratings and scores to movies, and you can write one-line reviews"
    } ]
  }, {
    "tStartMs": 134730,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "and comments,"
    } ]
  }, {
    "tStartMs": 137570,
    "dDurationMs": 6110,
    "segs": [ {
      "utf8": "and I made a site where you can do that for Korean snacks."
    } ]
  }, {
    "tStartMs": 143680,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "So it's like a Korean snack version of IMDb."
    } ]
  }, {
    "tStartMs": 147900,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 149150,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "So you give ratings to snacks and leave reviews..."
    } ]
  }, {
    "tStartMs": 153110,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "It really seems like the kind of fun site"
    } ]
  }, {
    "tStartMs": 155440,
    "dDurationMs": 7160,
    "segs": [ {
      "utf8": "that Teacher Tae-woong, who loves snacks and has snack-eating as a hobby, would make."
    } ]
  }, {
    "tStartMs": 162600,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "So after you opened it, how is it? After opening it,"
    } ]
  }, {
    "tStartMs": 166720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "I haven't done any separate promotion yet,"
    } ]
  }, {
    "tStartMs": 170080,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "and even after opening, there were a lot of things to update."
    } ]
  }, {
    "tStartMs": 174640,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "So I keep fixing small things that need to be corrected,"
    } ]
  }, {
    "tStartMs": 179940,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "and I thought, well, I should do some promotion,"
    } ]
  }, {
    "tStartMs": 183760,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "so there's a personal website run by a YouTuber I've mentioned before"
    } ]
  }, {
    "tStartMs": 188270,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "that I really love, Chim-chak-man,"
    } ]
  }, {
    "tStartMs": 194340,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "and on that site, subscribers ask Chim-chak-man"
    } ]
  }, {
    "tStartMs": 198300,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "'Chim-chak-man, can you do this?'"
    } ]
  }, {
    "tStartMs": 199770,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "'Can you play this game?'"
    } ]
  }, {
    "tStartMs": 201240,
    "dDurationMs": 5170,
    "segs": [ {
      "utf8": "'Can you talk about this?' and there's a request board."
    } ]
  }, {
    "tStartMs": 206410,
    "dDurationMs": 6910,
    "segs": [ {
      "utf8": "So I wrote about my website there and made a request."
    } ]
  }, {
    "tStartMs": 213320,
    "dDurationMs": 8800,
    "segs": [ {
      "utf8": "And besides rating and evaluating snacks like I mentioned earlier,"
    } ]
  }, {
    "tStartMs": 222120,
    "dDurationMs": 7450,
    "segs": [ {
      "utf8": "there's also a game where you guess the snack name just by looking at the contents,"
    } ]
  }, {
    "tStartMs": 229570,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "and a game where you guess the character names drawn on the snacks."
    } ]
  }, {
    "tStartMs": 232600,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "There are things like that too."
    } ]
  }, {
    "tStartMs": 235330,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "So I wrote a request asking them to make that into content."
    } ]
  }, {
    "tStartMs": 239160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "I used it today."
    } ]
  }, {
    "tStartMs": 241500,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "But we're recording on a Sunday right now, you know?"
    } ]
  }, {
    "tStartMs": 245880,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "So you might be able to see that post on a weekday, right?"
    } ]
  }, {
    "tStartMs": 249610,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I hope people find it interesting."
    } ]
  }, {
    "tStartMs": 252510,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "But I posted it without much expectation."
    } ]
  }, {
    "tStartMs": 257350,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And then other members"
    } ]
  }, {
    "tStartMs": 259630,
    "dDurationMs": 5930,
    "segs": [ {
      "utf8": "other subscribers left comments saying \"this looks fun.\""
    } ]
  }, {
    "tStartMs": 265560,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 266120,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "It seems to be getting some attention?"
    } ]
  }, {
    "tStartMs": 269310,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "There are a lot of other request posts,"
    } ]
  }, {
    "tStartMs": 271460,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "but it seems like mine got a lot of recommendations among them."
    } ]
  }, {
    "tStartMs": 274080,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "That's amazing."
    } ]
  }, {
    "tStartMs": 275160,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "You're not going on Chimchakman's show, are you? For real?"
    } ]
  }, {
    "tStartMs": 277980,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "I really hope that happens."
    } ]
  }, {
    "tStartMs": 280390,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Then that would really feel rewarding."
    } ]
  }, {
    "tStartMs": 282720,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 283540,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "That game looked fun to me."
    } ]
  }, {
    "tStartMs": 285750,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "Looking at the snack shape inside the snack wrapper, the actual snack shape inside the packaging,"
    } ]
  }, {
    "tStartMs": 290200,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "and guessing what kind of snack it is."
    } ]
  }, {
    "tStartMs": 292250,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "When we did it together last time,"
    } ]
  }, {
    "tStartMs": 293850,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "I only got 3 out of about 10 correct, so it's pretty difficult."
    } ]
  }, {
    "tStartMs": 298000,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "So it's ridiculous, ridiculous and fun game it was,"
    } ]
  }, {
    "tStartMs": 302650,
    "dDurationMs": 6730,
    "segs": [ {
      "utf8": "but when I showed it to you, Didi, there were only 10 problems."
    } ]
  }, {
    "tStartMs": 309380,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "But my friends said 10 was too few,"
    } ]
  }, {
    "tStartMs": 313190,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "so I bought quite a lot of snacks,"
    } ]
  }, {
    "tStartMs": 316330,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "I bought about 60 snacks..."
    } ]
  }, {
    "tStartMs": 320690,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Actually, I bought about 50."
    } ]
  }, {
    "tStartMs": 322730,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "So combined with the original 10, it came to about 60,"
    } ]
  }, {
    "tStartMs": 326800,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "so the problems came to about 60."
    } ]
  }, {
    "tStartMs": 330530,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "So you opened all 60 packages and took photos."
    } ]
  }, {
    "tStartMs": 334170,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 335360,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "That's blood, sweat, and tears."
    } ]
  }, {
    "tStartMs": 337300,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "So these days I'm still eating those snacks often."
    } ]
  }, {
    "tStartMs": 341730,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "Really, there must have been a variety of snacks, ones you hadn't eaten before?"
    } ]
  }, {
    "tStartMs": 346340,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 346930,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Right?"
    } ]
  }, {
    "tStartMs": 347950,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 348670,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "There were some that surprised me when I ate them."
    } ]
  }, {
    "tStartMs": 350870,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Is there anything memorable?"
    } ]
  }, {
    "tStartMs": 352350,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "Some that I wanted to give surprisingly high ratings to..."
    } ]
  }, {
    "tStartMs": 356240,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "Churros?"
    } ]
  }, {
    "tStartMs": 357220,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Churro snacks?"
    } ]
  }, {
    "tStartMs": 358720,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 358980,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Are those tasty?"
    } ]
  }, {
    "tStartMs": 360280,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "They were really delicious."
    } ]
  }, {
    "tStartMs": 361220,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Really? Those were popular, you know, with foreigners."
    } ]
  }, {
    "tStartMs": 364140,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "Oh, is that so?"
    } ]
  }, {
    "tStartMs": 364720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Yes, I saw a lot of foreigners buying them,"
    } ]
  }, {
    "tStartMs": 367760,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "it seems like a lot of Japanese people buy them."
    } ]
  }, {
    "tStartMs": 370780,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 371480,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "They were famous."
    } ]
  }, {
    "tStartMs": 373090,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Churro snacks are famous too, and there's cinnamon-flavored Kkobukki."
    } ]
  }, {
    "tStartMs": 377510,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "It seemed like a lot of people eat those, so I was curious, but it's tasty."
    } ]
  }, {
    "tStartMs": 383300,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "I was really surprised when I tried it."
    } ]
  }, {
    "tStartMs": 384990,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "You have good taste in snacks."
    } ]
  }, {
    "tStartMs": 386270,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Is the texture tasty?"
    } ]
  }, {
    "tStartMs": 387650,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "The aroma and flavor are really deep."
    } ]
  }, {
    "tStartMs": 392470,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "I should try it."
    } ]
  }, {
    "tStartMs": 393890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Yes, I mean, the texture is definitely a snack,"
    } ]
  }, {
    "tStartMs": 396830,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "but it has the aroma and taste of real churros you buy?"
    } ]
  }, {
    "tStartMs": 401110,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 402850,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "They say the churro snacks are delicious, so if you happen to find them in Korea, please try them and"
    } ]
  }, {
    "tStartMs": 407910,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "You don't leave ratings directly yourself? On their website?"
    } ]
  }, {
    "tStartMs": 412160,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I leave a lot of them, haha."
    } ]
  }, {
    "tStartMs": 414950,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "So you're leaving them as the first participant."
    } ]
  }, {
    "tStartMs": 417970,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "That's right, that's right."
    } ]
  }, {
    "tStartMs": 419520,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "And my friends left some too."
    } ]
  }, {
    "tStartMs": 422200,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "That's fun, it's a fun website, and congratulations."
    } ]
  }, {
    "tStartMs": 426430,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "And when are you releasing a song?"
    } ]
  }, {
    "tStartMs": 430080,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "There's no contract for that yet."
    } ]
  }, {
    "tStartMs": 432040,
    "dDurationMs": 5690,
    "segs": [ {
      "utf8": "Oh really? Are you just trying to make various things?"
    } ]
  }, {
    "tStartMs": 437730,
    "dDurationMs": 6520,
    "segs": [ {
      "utf8": "Right now I'm focusing on just one thing... and doing it properly."
    } ]
  }, {
    "tStartMs": 444250,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "If I make more beats, then I'll make more."
    } ]
  }, {
    "tStartMs": 446780,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "So what's your final goal? With that song?"
    } ]
  }, {
    "tStartMs": 449670,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Actually, my final goal is"
    } ]
  }, {
    "tStartMs": 452000,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to have fun doing it."
    } ]
  }, {
    "tStartMs": 454580,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "I just want to do it enjoyably."
    } ]
  }, {
    "tStartMs": 457940,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "So you're doing it as a hobby?"
    } ]
  }, {
    "tStartMs": 459900,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 461950,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Let me know when you release it."
    } ]
  }, {
    "tStartMs": 463310,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "So when I put it out on the internet,"
    } ]
  }, {
    "tStartMs": 466980,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "Of course."
    } ]
  }, {
    "tStartMs": 467500,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "You're doing really well."
    } ]
  }, {
    "tStartMs": 471820,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "I had a great time with a workcation in Busan."
    } ]
  }, {
    "tStartMs": 475460,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Tae-woong, you were... - we didn't get to see you, haha."
    } ]
  }, {
    "tStartMs": 478060,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Right, we couldn't see you because of scheduling."
    } ]
  }, {
    "tStartMs": 481150,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Next time we'll film Yomojomo offline again."
    } ]
  }, {
    "tStartMs": 484390,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Oh let's do that, we'll see when the time comes."
    } ]
  }, {
    "tStartMs": 486770,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Yes, but I went to a lot of the restaurants you recommended."
    } ]
  }, {
    "tStartMs": 491490,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "They were really recommendations I could trust and go to."
    } ]
  }, {
    "tStartMs": 495370,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "That makes me happy."
    } ]
  }, {
    "tStartMs": 495790,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "It's really good, really good."
    } ]
  }, {
    "tStartMs": 498080,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "So now we're going to talk about the airport we planned to discuss today,"
    } ]
  }, {
    "tStartMs": 503420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and we want to look at Yomojomo,"
    } ]
  }, {
    "tStartMs": 505160,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "but we should talk about last time's quiz answer, right?"
    } ]
  }, {
    "tStartMs": 508140,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Last time's quiz might have been a bit confusing for you."
    } ]
  }, {
    "tStartMs": 511580,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "The quiz was this:"
    } ]
  }, {
    "tStartMs": 512890,
    "dDurationMs": 5530,
    "segs": [ {
      "utf8": "\"Which one is not food that Didi and Tae-woong often buy at convenience stores?\" and"
    } ]
  }, {
    "tStartMs": 518420,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The answer was kimbap, number 1 kimbap."
    } ]
  }, {
    "tStartMs": 521460,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "We eat triangular kimbap a lot, but we don't usually buy regular kimbap."
    } ]
  }, {
    "tStartMs": 525980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "When they say kimbap in Korea,"
    } ]
  }, {
    "tStartMs": 527700,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "people usually think of long kimbap, so that was the answer."
    } ]
  }, {
    "tStartMs": 532300,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "It was a quiz that could have been a bit difficult,"
    } ]
  }, {
    "tStartMs": 535680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and I congratulate and thank everyone who got it right."
    } ]
  }, {
    "tStartMs": 538680,
    "dDurationMs": 6290,
    "segs": [ {
      "utf8": "Today as well, if you listen until the end there will be a quiz, so I'd appreciate it if you participate a lot."
    } ]
  }, {
    "tStartMs": 544970,
    "dDurationMs": 5810,
    "segs": [ {
      "utf8": "So, Tae-woong, when did you last use the airport?"
    } ]
  }, {
    "tStartMs": 550780,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I think it's been about a year."
    } ]
  }, {
    "tStartMs": 553180,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "About a year, was that when you went to Thailand last time?"
    } ]
  }, {
    "tStartMs": 556080,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Or was it Laos?"
    } ]
  }, {
    "tStartMs": 557440,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "No, I went to Bangkok, Thailand."
    } ]
  }, {
    "tStartMs": 561590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Did you depart from Busan Airport then?"
    } ]
  }, {
    "tStartMs": 564590,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 566920,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "Do you usually go from Busan Airport?"
    } ]
  }, {
    "tStartMs": 570830,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 571820,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "In the past, there weren't that many diverse or numerous countries you could go to from Busan,"
    } ]
  }, {
    "tStartMs": 580220,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "so if needed I would go up to Seoul and take a plane,"
    } ]
  }, {
    "tStartMs": 584970,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "but these days it seems like there are more places you can go to from Busan."
    } ]
  }, {
    "tStartMs": 589000,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 590420,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "So now I usually take planes from Busan when I can."
    } ]
  }, {
    "tStartMs": 594360,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "How is it when you compare prices? Are they similar?"
    } ]
  }, {
    "tStartMs": 598870,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "I haven't really thought about that."
    } ]
  }, {
    "tStartMs": 600960,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Really? Have you always just looked for flights departing from Busan?"
    } ]
  }, {
    "tStartMs": 605020,
    "dDurationMs": 8370,
    "segs": [ {
      "utf8": "Yes, because getting from Busan to Seoul is kind of a hassle, you know?"
    } ]
  }, {
    "tStartMs": 613390,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "That's right, and on top of that you have to go all the way to Incheon, and Gimpo is far too, so..."
    } ]
  }, {
    "tStartMs": 619090,
    "dDurationMs": 8210,
    "segs": [ {
      "utf8": "Just getting to the station from our house to go to Seoul is already such a trek."
    } ]
  }, {
    "tStartMs": 627300,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "And then once you arrive in Seoul, getting to the airport is also such a trek."
    } ]
  }, {
    "tStartMs": 630810,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "It takes all day."
    } ]
  }, {
    "tStartMs": 632190,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "Exactly, so that's... it's like traveling."
    } ]
  }, {
    "tStartMs": 636580,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The trip starts right from then."
    } ]
  }, {
    "tStartMs": 638590,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Yeah, haha."
    } ]
  }, {
    "tStartMs": 640070,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "If you go from Busan you can save so much time, so going from there would be"
    } ]
  }, {
    "tStartMs": 643760,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "just so much better."
    } ]
  }, {
    "tStartMs": 645340,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 646710,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "I've never actually used Busan Airport before."
    } ]
  }, {
    "tStartMs": 651440,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "How big is it?"
    } ]
  }, {
    "tStartMs": 654300,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Compared to Incheon Airport, it's quite small."
    } ]
  }, {
    "tStartMs": 657940,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "Incheon Airport is pretty big, you know."
    } ]
  }, {
    "tStartMs": 661070,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 661710,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "It's big and a really cutting-edge airport."
    } ]
  }, {
    "tStartMs": 665730,
    "dDurationMs": 5850,
    "segs": [ {
      "utf8": "I've seen a lot of promotional stuff like that."
    } ]
  }, {
    "tStartMs": 671580,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "It's on the Incheon International Airport homepage."
    } ]
  }, {
    "tStartMs": 676860,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "They have this."
    } ]
  }, {
    "tStartMs": 677700,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "World Airport Service Evaluation."
    } ]
  }, {
    "tStartMs": 680210,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "It's an airport service quality evaluation that Airports Council International releases every year."
    } ]
  }, {
    "tStartMs": 684190,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "There's an airport service quality evaluation."
    } ]
  }, {
    "tStartMs": 687530,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "Incheon Airport has ranked first for 12 consecutive years, apparently."
    } ]
  }, {
    "tStartMs": 692840,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "It seems they've received really good evaluations for their service."
    } ]
  }, {
    "tStartMs": 697730,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "And it was built in 2001."
    } ]
  }, {
    "tStartMs": 702670,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So there's also the point that it's relatively recent."
    } ]
  }, {
    "tStartMs": 706110,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "And I've also seen that there are various cultural experience spaces."
    } ]
  }, {
    "tStartMs": 710620,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "Like there are places where you can do crafts and things."
    } ]
  }, {
    "tStartMs": 713570,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And they sometimes have pop-ups."
    } ]
  }, {
    "tStartMs": 715650,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 716400,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "Yes, I've seen pop-ups where you can play games and things."
    } ]
  }, {
    "tStartMs": 720430,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "And there are also places where you can make Korean crafts and things like that."
    } ]
  }, {
    "tStartMs": 726790,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "It seems like they're getting good evaluations for all these various reasons."
    } ]
  }, {
    "tStartMs": 734710,
    "dDurationMs": 6830,
    "segs": [ {
      "utf8": "It definitely seems like the main airport is probably pretty well set up."
    } ]
  }, {
    "tStartMs": 741540,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "I guess so."
    } ]
  }, {
    "tStartMs": 742510,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "But even though they say there are all these various services, when you actually go to the airport,"
    } ]
  }, {
    "tStartMs": 747280,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "which services do you mainly use?"
    } ]
  }, {
    "tStartMs": 752160,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Services..."
    } ]
  }, {
    "tStartMs": 754020,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "I only eat and go to the convenience store."
    } ]
  }, {
    "tStartMs": 761060,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "I don't think I've really used anything else."
    } ]
  }, {
    "tStartMs": 766170,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "You don't do things like currency exchange or getting a SIM card or anything like that?"
    } ]
  }, {
    "tStartMs": 773130,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "Oh, at foreign airports?"
    } ]
  }, {
    "tStartMs": 775100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "In Korea."
    } ]
  }, {
    "tStartMs": 776000,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "Oh, I've never done that in Korea."
    } ]
  }, {
    "tStartMs": 778530,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 780020,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "I do all that when I go abroad..."
    } ]
  }, {
    "tStartMs": 782780,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 783400,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "So you do it in that country."
    } ]
  }, {
    "tStartMs": 786530,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Even the SIM card and things like that?"
    } ]
  }, {
    "tStartMs": 788310,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "Everything."
    } ]
  }, {
    "tStartMs": 789230,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Oh really? Wow, how do you do it?"
    } ]
  }, {
    "tStartMs": 791990,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "You buy it at the airport?"
    } ]
  }, {
    "tStartMs": 793720,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 794300,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 796470,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "I'm a bit anxious about it, like I worry what if I can't do it when I'm in a foreign country..."
    } ]
  }, {
    "tStartMs": 802090,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "Is it cheaper? Is it cheaper to do it locally?"
    } ]
  }, {
    "tStartMs": 805380,
    "dDurationMs": 5590,
    "segs": [ {
      "utf8": "Oh, I think from my experience back then it was really"
    } ]
  }, {
    "tStartMs": 810970,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "You mentioned you've done backpacking for several months for a long time, right?"
    } ]
  }, {
    "tStartMs": 815780,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "Back then, it wasn't like going back and forth between Korea and different countries,"
    } ]
  }, {
    "tStartMs": 821380,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "but constantly moving from one country to another,"
    } ]
  }, {
    "tStartMs": 825470,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "so it was just natural to do whatever that country does."
    } ]
  }, {
    "tStartMs": 829150,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "But I learned that as something natural,"
    } ]
  }, {
    "tStartMs": 837250,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "and now even after coming back to Korea,"
    } ]
  }, {
    "tStartMs": 839100,
    "dDurationMs": 6950,
    "segs": [ {
      "utf8": "whenever I go somewhere, I just go and do things the way I used to."
    } ]
  }, {
    "tStartMs": 846050,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "It's like this—I went to Japan, then crossed over to China from Japan,"
    } ]
  }, {
    "tStartMs": 850900,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "and from China I'd fly somewhere else, and doing it this way..."
    } ]
  }, {
    "tStartMs": 854540,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "I see, I've never experienced that."
    } ]
  }, {
    "tStartMs": 859100,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "I always prepare from Korea,"
    } ]
  }, {
    "tStartMs": 861640,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "and before going to the airport, among the things I need to prepare, there's always a SIM card,"
    } ]
  }, {
    "tStartMs": 866370,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "currency exchange—these days it's just done with a card,"
    } ]
  }, {
    "tStartMs": 870660,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "so I don't really get cash, but I prepared everything in advance before going."
    } ]
  }, {
    "tStartMs": 875290,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "So you do those things in that country."
    } ]
  }, {
    "tStartMs": 878460,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "Yes, I'm not sure if it was on my channel or your channel,"
    } ]
  }, {
    "tStartMs": 883570,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "but it's something I talked about somewhere."
    } ]
  }, {
    "tStartMs": 886240,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "There's something I always do first when I go abroad."
    } ]
  }, {
    "tStartMs": 889350,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "What is it?"
    } ]
  }, {
    "tStartMs": 890530,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "I can exchange currency or usually buy a SIM chip,"
    } ]
  }, {
    "tStartMs": 897890,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "and when I go to the airport, I talk"
    } ]
  }, {
    "tStartMs": 900780,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "to a person from that country for the first time."
    } ]
  }, {
    "tStartMs": 902330,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 903490,
    "dDurationMs": 6590,
    "segs": [ {
      "utf8": "So I actually feel like it's part of the fun of traveling, so I do it that way,"
    } ]
  }, {
    "tStartMs": 910080,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and when I finish my business at the airport,"
    } ]
  }, {
    "tStartMs": 913920,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "then once I do this task, I can go outside,"
    } ]
  }, {
    "tStartMs": 918970,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "so after that's all done, I ask that staff member"
    } ]
  }, {
    "tStartMs": 924290,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "what \"thank you\" is in this country's language."
    } ]
  }, {
    "tStartMs": 929050,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Oh, at the airport? To that person?"
    } ]
  }, {
    "tStartMs": 931140,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Yes, I ask in English."
    } ]
  }, {
    "tStartMs": 933440,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "What is \"thank you\" in this country's language?"
    } ]
  }, {
    "tStartMs": 936930,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "When I ask like that,"
    } ]
  }, {
    "tStartMs": 937750,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "like if I use Vietnam as an example, they'd say \"cảm ơn,\" right?"
    } ]
  }, {
    "tStartMs": 942400,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "Then I just say \"cảm ơn\" to that person and leave."
    } ]
  }, {
    "tStartMs": 946890,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "It's like a repertoire, and it signals the start of the trip, that's it."
    } ]
  }, {
    "tStartMs": 952320,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 952960,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Oh, and you use that one phrase throughout the whole trip, right? \"Cảm ơn\"?"
    } ]
  }, {
    "tStartMs": 957180,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "I end up using it more than I expected."
    } ]
  }, {
    "tStartMs": 958420,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Oh, that's nice."
    } ]
  }, {
    "tStartMs": 960130,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Does English work for everything?"
    } ]
  }, {
    "tStartMs": 962620,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "For the people at the airport..."
    } ]
  }, {
    "tStartMs": 964460,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Really? Even when you go to Japan or other Asian countries?"
    } ]
  }, {
    "tStartMs": 968390,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "In my case, it was always like that."
    } ]
  }, {
    "tStartMs": 970150,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "Oh, so English is all you need."
    } ]
  }, {
    "tStartMs": 975530,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "English works, so it seems to be fine."
    } ]
  }, {
    "tStartMs": 977760,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Oh, but well..."
    } ]
  }, {
    "tStartMs": 981270,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "I mean, \"how to say in Vietnamese\" is easy, right?"
    } ]
  }, {
    "tStartMs": 984710,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "That's pretty advanced English—or is it? People who don't know find it difficult."
    } ]
  }, {
    "tStartMs": 989850,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "That could be."
    } ]
  }, {
    "tStartMs": 991610,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "That's nice, that's nice—that routine is fun."
    } ]
  }, {
    "tStartMs": 994680,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "That moment has real character, you know?"
    } ]
  }, {
    "tStartMs": 997790,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "So it feels like you become the main character of the trip."
    } ]
  }, {
    "tStartMs": 1002540,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "That's funny."
    } ]
  }, {
    "tStartMs": 1003650,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "Haven't you tried using something like that?"
    } ]
  }, {
    "tStartMs": 1006300,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "A lounge—like an airport lounge?"
    } ]
  }, {
    "tStartMs": 1009490,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "I thought airport lounges are something"
    } ]
  }, {
    "tStartMs": 1014750,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "only premium members can use, right?"
    } ]
  }, {
    "tStartMs": 1017250,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Either that or you pay to get in,"
    } ]
  }, {
    "tStartMs": 1021410,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "but I've never used one,"
    } ]
  }, {
    "tStartMs": 1026240,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "and honestly, I've never really felt like I wanted to use one."
    } ]
  }, {
    "tStartMs": 1030770,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "I see, I got mine recently, the card."
    } ]
  }, {
    "tStartMs": 1036510,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "A card that allows lounge access... I got it issued."
    } ]
  }, {
    "tStartMs": 1041570,
    "dDurationMs": 5750,
    "segs": [ {
      "utf8": "There's a condition like this — if you spend 500,000 won or more on this card in the previous month,"
    } ]
  }, {
    "tStartMs": 1047320,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "there's a mileage card that lets you use airport lounges."
    } ]
  }, {
    "tStartMs": 1051460,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "I like traveling too, and I was really curious about what lounges are like."
    } ]
  }, {
    "tStartMs": 1056350,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "So I'm planning to try it out this year."
    } ]
  }, {
    "tStartMs": 1058940,
    "dDurationMs": 6990,
    "segs": [ {
      "utf8": "But coincidentally, I saw some news from a few years ago recently..."
    } ]
  }, {
    "tStartMs": 1065930,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "Yeah, what was it?"
    } ]
  }, {
    "tStartMs": 1067900,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "There was a Korean civil servant who, whenever he went abroad,"
    } ]
  }, {
    "tStartMs": 1073700,
    "dDurationMs": 7760,
    "segs": [ {
      "utf8": "his flight wasn't first class, it was just economy class,"
    } ]
  }, {
    "tStartMs": 1081460,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "he had his economy ticket and would go in,"
    } ]
  }, {
    "tStartMs": 1085440,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "buy a first-class ticket separately,"
    } ]
  }, {
    "tStartMs": 1088600,
    "dDurationMs": 5980,
    "segs": [ {
      "utf8": "enter the lounge that only first-class passengers can use, eat free food,"
    } ]
  }, {
    "tStartMs": 1094580,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "drink free alcohol, and then before boarding the plane,"
    } ]
  }, {
    "tStartMs": 1098670,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "he would cancel that first-class ticket."
    } ]
  }, {
    "tStartMs": 1103070,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "That's allowed?"
    } ]
  }, {
    "tStartMs": 1104040,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "Apparently he did it a lot."
    } ]
  }, {
    "tStartMs": 1105530,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "Huh? So it gets refunded?"
    } ]
  }, {
    "tStartMs": 1108040,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It seems it did."
    } ]
  }, {
    "tStartMs": 1110140,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "But the airline or airport side noticed this person was suspicious and caught him,"
    } ]
  }, {
    "tStartMs": 1119740,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and that person became a criminal, they say."
    } ]
  }, {
    "tStartMs": 1123640,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "That's a crime, right?"
    } ]
  }, {
    "tStartMs": 1124990,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "That's a crime."
    } ]
  }, {
    "tStartMs": 1126370,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "So when you mentioned lounges, that came to mind."
    } ]
  }, {
    "tStartMs": 1130730,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Wow, that's not me."
    } ]
  }, {
    "tStartMs": 1132130,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "I'm not going to do that, I'm going to do it properly with the card,"
    } ]
  }, {
    "tStartMs": 1137120,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "so there are people like that — really bad people."
    } ]
  }, {
    "tStartMs": 1140100,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1140650,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "A scammer, a real scammer."
    } ]
  }, {
    "tStartMs": 1143190,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1144450,
    "dDurationMs": 6670,
    "segs": [ {
      "utf8": "Lounges are awkward to use for people taking early morning flights, you know?"
    } ]
  }, {
    "tStartMs": 1151120,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "If it's a 6 a.m. flight, it's hard to use the lounge."
    } ]
  }, {
    "tStartMs": 1155130,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "If you're going to use a lounge, it should be a flight departing later in the afternoon... at least around 2 p.m.?"
    } ]
  }, {
    "tStartMs": 1160330,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "That way you can use it leisurely, that's what I thought."
    } ]
  }, {
    "tStartMs": 1164470,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Usually, what time do you take flights?"
    } ]
  }, {
    "tStartMs": 1168190,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "Do you prefer early morning flights?"
    } ]
  }, {
    "tStartMs": 1171020,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "The airport is quite far from my home,"
    } ]
  }, {
    "tStartMs": 1175640,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "it takes about 2 hours just to get there."
    } ]
  }, {
    "tStartMs": 1179140,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "So... (- by bus?) both subway and bus."
    } ]
  }, {
    "tStartMs": 1183470,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "That's far."
    } ]
  }, {
    "tStartMs": 1184890,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "Yeah, so I really can't take early morning flights."
    } ]
  }, {
    "tStartMs": 1190550,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "So you just take afternoon flights?"
    } ]
  }, {
    "tStartMs": 1192460,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Any time in the afternoon?"
    } ]
  }, {
    "tStartMs": 1194730,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "Yeah, any time in the afternoon."
    } ]
  }, {
    "tStartMs": 1195880,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 1197890,
    "dDurationMs": 6260,
    "segs": [ {
      "utf8": "So if it's a 2 p.m. flight, how many hours before do you plan to go?"
    } ]
  }, {
    "tStartMs": 1204150,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "Well, in the case of going abroad..."
    } ]
  }, {
    "tStartMs": 1207140,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "International flights?"
    } ]
  }, {
    "tStartMs": 1208770,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Yes, international flights."
    } ]
  }, {
    "tStartMs": 1210820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "In the case of international flights,"
    } ]
  }, {
    "tStartMs": 1212680,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "you have to arrive much earlier than the departure time, right?"
    } ]
  }, {
    "tStartMs": 1218560,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "I know the minimum is 2 hours."
    } ]
  }, {
    "tStartMs": 1222020,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "That's right, minimum 2 hours,"
    } ]
  }, {
    "tStartMs": 1224060,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and depending on the airline, sometimes it's 3 or 4 hours."
    } ]
  }, {
    "tStartMs": 1227540,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1228970,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "So taking that into account, I usually go very early."
    } ]
  }, {
    "tStartMs": 1232510,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "You do?"
    } ]
  }, {
    "tStartMs": 1233350,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "So if the minimum is 2 hours, you go about 3 or 4 hours before?"
    } ]
  }, {
    "tStartMs": 1237410,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1239140,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "You go with plenty of time."
    } ]
  }, {
    "tStartMs": 1241170,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "Yes, if I went but there were so many people at the airport"
    } ]
  }, {
    "tStartMs": 1247050,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "and the line took too long, then there could be problems, right?"
    } ]
  }, {
    "tStartMs": 1250920,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "Yes, that's right."
    } ]
  }, {
    "tStartMs": 1252530,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Going really early is just good."
    } ]
  }, {
    "tStartMs": 1255270,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "That's right. How about you, Didi?"
    } ]
  }, {
    "tStartMs": 1257800,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "If they tell me to come 2 hours before,"
    } ]
  }, {
    "tStartMs": 1262780,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "I try to go about 2 and a half hours before."
    } ]
  }, {
    "tStartMs": 1266240,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "I tend to go a bit earlier."
    } ]
  }, {
    "tStartMs": 1268930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Earlier than the time I'm supposed to arrive."
    } ]
  }, {
    "tStartMs": 1270640,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "But so far there haven't been any major problems, so it's been fine."
    } ]
  }, {
    "tStartMs": 1275720,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "The reason I started thinking I should go even earlier was"
    } ]
  }, {
    "tStartMs": 1279680,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "I went on a trip to Australia with my mom last time."
    } ]
  }, {
    "tStartMs": 1281940,
    "dDurationMs": 6660,
    "segs": [ {
      "utf8": "So that wasn't an international flight, it was a domestic flight within Australia, going back and forth."
    } ]
  }, {
    "tStartMs": 1288600,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "It was a flight from Brisbane to Sydney."
    } ]
  }, {
    "tStartMs": 1293950,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "And it said to come 1 hour before."
    } ]
  }, {
    "tStartMs": 1297180,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "So I thought I could go 1 hour and a half before."
    } ]
  }, {
    "tStartMs": 1302100,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "Because that airport was only about 20 minutes from where I was staying."
    } ]
  }, {
    "tStartMs": 1307150,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "I just had to take one subway line."
    } ]
  }, {
    "tStartMs": 1309440,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "I thought I'd go leisurely, but"
    } ]
  }, {
    "tStartMs": 1312190,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "I didn't know that unexpected things can happen in a foreign country."
    } ]
  }, {
    "tStartMs": 1319270,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The subway wasn't running that day."
    } ]
  }, {
    "tStartMs": 1323550,
    "dDurationMs": 7650,
    "segs": [ {
      "utf8": "So what should have taken 20 minutes ended up taking about an hour and a half going all the way around,"
    } ]
  }, {
    "tStartMs": 1331200,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "and I missed that flight I was supposed to take."
    } ]
  }, {
    "tStartMs": 1335110,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "So I realized that unexpected things like this can happen,"
    } ]
  }, {
    "tStartMs": 1339360,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and I thought, oh, I have to go early, I absolutely have to go early."
    } ]
  }, {
    "tStartMs": 1342840,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "That's how I learned that lesson."
    } ]
  }, {
    "tStartMs": 1346160,
    "dDurationMs": 7240,
    "segs": [ {
      "utf8": "That's right, but at least it happened on a domestic flight, so that was fortunate."
    } ]
  }, {
    "tStartMs": 1353400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Right, it wasn't an extremely expensive flight."
    } ]
  }, {
    "tStartMs": 1356040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And fortunately they changed it for me."
    } ]
  }, {
    "tStartMs": 1358980,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "That's fortunate."
    } ]
  }, {
    "tStartMs": 1359590,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "They changed it to a later one."
    } ]
  }, {
    "tStartMs": 1363870,
    "dDurationMs": 13150,
    "segs": [ {
      "utf8": "But there was an English online lecture I took in high school, and the instructor"
    } ]
  }, {
    "tStartMs": 1377020,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "talked about things like this with flights."
    } ]
  }, {
    "tStartMs": 1381520,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "If you check in right before the plane takes off,"
    } ]
  }, {
    "tStartMs": 1386980,
    "dDurationMs": 7970,
    "segs": [ {
      "utf8": "they upgrade you to first class if there are empty seats, that's what I heard."
    } ]
  }, {
    "tStartMs": 1394950,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Have you heard of that?"
    } ]
  }, {
    "tStartMs": 1396010,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "If you check in right before, they upgrade you?"
    } ]
  }, {
    "tStartMs": 1397970,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Oh, so if there are seats left in first class, they just say 'go here'?"
    } ]
  }, {
    "tStartMs": 1402530,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Can that really happen?"
    } ]
  }, {
    "tStartMs": 1404900,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "But I've heard stories of people experiencing that."
    } ]
  }, {
    "tStartMs": 1410780,
    "dDurationMs": 8420,
    "segs": [ {
      "utf8": "So I always have this vague fantasy about going late,"
    } ]
  }, {
    "tStartMs": 1419200,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "but I've never actually tried it."
    } ]
  }, {
    "tStartMs": 1421050,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "Hmm, I wonder if there are people who have experienced that."
    } ]
  }, {
    "tStartMs": 1425660,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "But you shouldn't do that, right?"
    } ]
  }, {
    "tStartMs": 1427390,
    "dDurationMs": 6670,
    "segs": [ {
      "utf8": "Right, because that's something from a long time ago."
    } ]
  }, {
    "tStartMs": 1434060,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "These days it probably doesn't happen."
    } ]
  }, {
    "tStartMs": 1436290,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "They just leave them empty."
    } ]
  }, {
    "tStartMs": 1439660,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "I'd like to try first class at least once."
    } ]
  }, {
    "tStartMs": 1443840,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Me too."
    } ]
  }, {
    "tStartMs": 1444710,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "But I don't want to pay for it myself, kind of..."
    } ]
  }, {
    "tStartMs": 1447900,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "If the company sends me on a business trip, the company pays for it, right?"
    } ]
  }, {
    "tStartMs": 1450450,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "I'd like to experience it that way."
    } ]
  }, {
    "tStartMs": 1452900,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Right, or maybe if I got invited."
    } ]
  }, {
    "tStartMs": 1454920,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "Yeah, yeah, with a free ticket."
    } ]
  }, {
    "tStartMs": 1458270,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Because it's more than double the price, right?"
    } ]
  }, {
    "tStartMs": 1461780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Exactly."
    } ]
  }, {
    "tStartMs": 1463760,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "I wish someone would invite me."
    } ]
  }, {
    "tStartMs": 1464970,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "Right, and for a long flight too,"
    } ]
  }, {
    "tStartMs": 1469100,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "so I could eat a course meal once or twice,"
    } ]
  }, {
    "tStartMs": 1472750,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "I hope I could get invited at least once before I die."
    } ]
  }, {
    "tStartMs": 1476510,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "Yes, let's work hard, let's work hard."
    } ]
  }, {
    "tStartMs": 1479460,
    "dDurationMs": 6110,
    "segs": [ {
      "utf8": "So do you have a preferred airline? Any airline you like?"
    } ]
  }, {
    "tStartMs": 1485570,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "That East Asia? No, no, no."
    } ]
  }, {
    "tStartMs": 1489090,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Asiana, that's right, that's right, yes, Asiana."
    } ]
  }, {
    "tStartMs": 1492690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Asiana, Asiana."
    } ]
  }, {
    "tStartMs": 1495000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Yes, it's Asiana."
    } ]
  }, {
    "tStartMs": 1496920,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "Oh, Asiana."
    } ]
  }, {
    "tStartMs": 1498050,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Yes, it's Asiana."
    } ]
  }, {
    "tStartMs": 1501250,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "Actually, there's no particular big reason."
    } ]
  }, {
    "tStartMs": 1506370,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "It's because the flight attendants' uniforms there are pretty..."
    } ]
  }, {
    "tStartMs": 1510190,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "What are they like? What color?"
    } ]
  }, {
    "tStartMs": 1512160,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "White and red combination."
    } ]
  }, {
    "tStartMs": 1516520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "But it's just pretty."
    } ]
  }, {
    "tStartMs": 1520360,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "So you're saying you fly Asiana just to see the flight attendants?"
    } ]
  }, {
    "tStartMs": 1526080,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "No, but I don't necessarily try to fly Asiana specifically."
    } ]
  }, {
    "tStartMs": 1530250,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Really? I just liked it here."
    } ]
  }, {
    "tStartMs": 1533290,
    "dDurationMs": 7420,
    "segs": [ {
      "utf8": "But when I fly, whether it's the male or female staff, their clothes are really stylish."
    } ]
  }, {
    "tStartMs": 1540710,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Really? I didn't know that."
    } ]
  }, {
    "tStartMs": 1543430,
    "dDurationMs": 6180,
    "segs": [ {
      "utf8": "There's like a red stripe around the chest area."
    } ]
  }, {
    "tStartMs": 1549610,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "It's distinctive as an accent point."
    } ]
  }, {
    "tStartMs": 1552700,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "I thought it was pretty."
    } ]
  }, {
    "tStartMs": 1554210,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Right, the uniforms are different for each airline, you know."
    } ]
  }, {
    "tStartMs": 1557900,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The logo and the clothes are similar, right?"
    } ]
  }, {
    "tStartMs": 1560460,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It's fun to look at those kinds of things."
    } ]
  }, {
    "tStartMs": 1562780,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "Jeju Air's accent point is an orange scarf."
    } ]
  }, {
    "tStartMs": 1567450,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Asiana is... Asiana is also really pretty, right?"
    } ]
  }, {
    "tStartMs": 1570790,
    "dDurationMs": 6670,
    "segs": [ {
      "utf8": "Asiana is white and a dark color?"
    } ]
  }, {
    "tStartMs": 1577460,
    "dDurationMs": 5770,
    "segs": [ {
      "utf8": "Oh, there's an arrow that's the mascot, or what is it? A symbol, a logo..."
    } ]
  }, {
    "tStartMs": 1583230,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "They're wearing a scarf with a bit of red mixed in."
    } ]
  }, {
    "tStartMs": 1588360,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1589060,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "So I guess the one I thought was pretty is Korean Air."
    } ]
  }, {
    "tStartMs": 1592530,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1593360,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Oh, sky blue, wow, it's pretty, it looks like an airplane."
    } ]
  }, {
    "tStartMs": 1597480,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Mm, yes."
    } ]
  }, {
    "tStartMs": 1598580,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "It's the airplane's color."
    } ]
  }, {
    "tStartMs": 1600960,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Anyway, my style is Asiana..."
    } ]
  }, {
    "tStartMs": 1605480,
    "dDurationMs": 5830,
    "segs": [ {
      "utf8": "I always think the flight attendants are really kind and cool when I see them."
    } ]
  }, {
    "tStartMs": 1611310,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Oh, yes."
    } ]
  }, {
    "tStartMs": 1612150,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "The pilots too, and when you go to the airport, they line up like this and go in a row, right?"
    } ]
  }, {
    "tStartMs": 1617570,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "That's cool."
    } ]
  }, {
    "tStartMs": 1619200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Right, right."
    } ]
  }, {
    "tStartMs": 1621000,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Do you have any episodes? With flight attendants?"
    } ]
  }, {
    "tStartMs": 1624900,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Not at all."
    } ]
  }, {
    "tStartMs": 1625740,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Really? I have one!"
    } ]
  }, {
    "tStartMs": 1627970,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 1628610,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "My first flight story."
    } ]
  }, {
    "tStartMs": 1631890,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "It's a story about being a really troublesome customer."
    } ]
  }, {
    "tStartMs": 1636350,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "You, Didi?"
    } ]
  }, {
    "tStartMs": 1639510,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Yes, it was when I was in middle school."
    } ]
  }, {
    "tStartMs": 1642000,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "It was my first overseas trip with my family."
    } ]
  }, {
    "tStartMs": 1645470,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "Thailand, it was a flight to Bangkok back then."
    } ]
  }, {
    "tStartMs": 1648780,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Since it was a trip with my family,"
    } ]
  }, {
    "tStartMs": 1651510,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "I think it was Asiana back then."
    } ]
  }, {
    "tStartMs": 1655610,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "I was getting braces at the time."
    } ]
  }, {
    "tStartMs": 1658300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "And there's something called a retainer."
    } ]
  }, {
    "tStartMs": 1661080,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "I had this retainer that I would take out and put back in every time I ate."
    } ]
  }, {
    "tStartMs": 1666500,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "But it was my first time eating airline food,"
    } ]
  }, {
    "tStartMs": 1670460,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "And I thought, oh, this is delicious, and I returned everything."
    } ]
  }, {
    "tStartMs": 1673830,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "And my braces device disappeared, that retainer..."
    } ]
  }, {
    "tStartMs": 1677500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "No way..."
    } ]
  }, {
    "tStartMs": 1678500,
    "dDurationMs": 6270,
    "segs": [ {
      "utf8": "You just left it on that plate and took it with you."
    } ]
  }, {
    "tStartMs": 1684770,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "I also just left it carelessly, so I didn't know about it—I had forgotten about it."
    } ]
  }, {
    "tStartMs": 1689110,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "But that's really expensive, you know, the retainer."
    } ]
  }, {
    "tStartMs": 1691840,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "So I had to find it, right?"
    } ]
  }, {
    "tStartMs": 1694350,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "So I just mentioned it just in case."
    } ]
  }, {
    "tStartMs": 1696050,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "I had just eaten and you took the plate with you."
    } ]
  }, {
    "tStartMs": 1699610,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "I thought my retainer might have been on that plate."
    } ]
  }, {
    "tStartMs": 1703240,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "But they had already cleaned everything up."
    } ]
  }, {
    "tStartMs": 1706020,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "So they had to go through all the passengers' plates to find it..."
    } ]
  }, {
    "tStartMs": 1712820,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "But they found it for me, one by one, piece by piece."
    } ]
  }, {
    "tStartMs": 1716520,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "Very kindly. (- That's really amazing, truly amazing.)"
    } ]
  }, {
    "tStartMs": 1720070,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "It really was amazing, but how annoyed they must have been."
    } ]
  }, {
    "tStartMs": 1723570,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "They were already busy, and then having to search like that..."
    } ]
  }, {
    "tStartMs": 1729410,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "The flight attendants really do work so hard..."
    } ]
  }, {
    "tStartMs": 1733180,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "They really do."
    } ]
  }, {
    "tStartMs": 1736570,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Take this opportunity to apologize."
    } ]
  }, {
    "tStartMs": 1741390,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "I should have kept my mind straight back then."
    } ]
  }, {
    "tStartMs": 1744950,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I'm sorry for causing you so much trouble."
    } ]
  }, {
    "tStartMs": 1747830,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "And now I'm being careful to make sure something like that doesn't happen again."
    } ]
  }, {
    "tStartMs": 1753010,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "And whenever I see the flight attendants, I try to greet them with a very kind expression."
    } ]
  }, {
    "tStartMs": 1758340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I'm still making an effort to do that."
    } ]
  }, {
    "tStartMs": 1761310,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "Thanks to them, I haven't forgotten to be grateful, and even now."
    } ]
  }, {
    "tStartMs": 1765620,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "You all work so hard."
    } ]
  }, {
    "tStartMs": 1768690,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "You check luggage at the airport, right?"
    } ]
  }, {
    "tStartMs": 1771700,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "But when you use a budget airline, you can go without checked luggage."
    } ]
  }, {
    "tStartMs": 1775130,
    "dDurationMs": 5830,
    "segs": [ {
      "utf8": "Many people just take what they can carry on as cabin baggage."
    } ]
  }, {
    "tStartMs": 1780960,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Do you often add luggage?"
    } ]
  }, {
    "tStartMs": 1784360,
    "dDurationMs": 9300,
    "segs": [ {
      "utf8": "I try to minimize my luggage as much as possible, so I don't need to add any."
    } ]
  }, {
    "tStartMs": 1793660,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "Sometimes I don't even use the basic checked baggage that's provided."
    } ]
  }, {
    "tStartMs": 1799100,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "I mean, the baggage you check. (- Really?)"
    } ]
  }, {
    "tStartMs": 1802890,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "I just take one bag and go on my trip."
    } ]
  }, {
    "tStartMs": 1805660,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "So you travel as a minimalist."
    } ]
  }, {
    "tStartMs": 1807840,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1810040,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "Do you not buy a lot of gifts or do much shopping?"
    } ]
  }, {
    "tStartMs": 1815410,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "I don't think I've done that."
    } ]
  }, {
    "tStartMs": 1820100,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "Really? When you go to duty-free shops and think, \"I'm definitely buying this.\""
    } ]
  }, {
    "tStartMs": 1824790,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "You don't have anything like that?"
    } ]
  }, {
    "tStartMs": 1826360,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "No, I don't."
    } ]
  }, {
    "tStartMs": 1828490,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "What people buy a lot of is alcohol."
    } ]
  }, {
    "tStartMs": 1832320,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "They buy a lot of snacks and cigarettes and do that."
    } ]
  }, {
    "tStartMs": 1837210,
    "dDurationMs": 6190,
    "segs": [ {
      "utf8": "I don't smoke cigarettes originally, and I only buy alcohol sometimes."
    } ]
  }, {
    "tStartMs": 1843400,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "But even with alcohol, you can only buy one bottle per person, right?"
    } ]
  }, {
    "tStartMs": 1847430,
    "dDurationMs": 5630,
    "segs": [ {
      "utf8": "So my luggage doesn't really increase that much."
    } ]
  }, {
    "tStartMs": 1853060,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "Me, I'm always... I really come back heavy."
    } ]
  }, {
    "tStartMs": 1859030,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "I buy lots of different things."
    } ]
  }, {
    "tStartMs": 1860740,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "Isn't that enjoying your trip more fully?"
    } ]
  }, {
    "tStartMs": 1865760,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "When you travel, there's something you have to be careful about."
    } ]
  }, {
    "tStartMs": 1869570,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "You lose all sense of money."
    } ]
  }, {
    "tStartMs": 1873550,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "Because the exchange rate is different, you end up spending a lot."
    } ]
  }, {
    "tStartMs": 1877680,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "You don't save well."
    } ]
  }, {
    "tStartMs": 1880380,
    "dDurationMs": 8360,
    "segs": [ {
      "utf8": "But is it cheaper at the airport duty-free, or more expensive?"
    } ]
  }, {
    "tStartMs": 1888740,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Hmm... there are a lot of cheap things, lots of cheap items."
    } ]
  }, {
    "tStartMs": 1893060,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "But if you try to buy right when you arrive at the airport, there's almost no stock."
    } ]
  }, {
    "tStartMs": 1897920,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "Especially cosmetics—people buy a lot of those."
    } ]
  }, {
    "tStartMs": 1901810,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "If there are 20 types of lipstick,"
    } ]
  }, {
    "tStartMs": 1905090,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "There are only one or two in that store."
    } ]
  }, {
    "tStartMs": 1907580,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "So if you order online in advance"
    } ]
  }, {
    "tStartMs": 1910490,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "And pick it up that way, it's definitely cheaper."
    } ]
  }, {
    "tStartMs": 1914440,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 1915200,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "Yes, the duty-free chance."
    } ]
  }, {
    "tStartMs": 1917730,
    "dDurationMs": 9020,
    "segs": [ {
      "utf8": "But if you're buying things that way, there's no point in buying them while traveling, right?"
    } ]
  }, {
    "tStartMs": 1926750,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "Right, when you use duty-free shops, it's for things"
    } ]
  }, {
    "tStartMs": 1929940,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "you wanted to have anyway, and you're buying them cheaply"
    } ]
  }, {
    "tStartMs": 1933090,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "I see"
    } ]
  }, {
    "tStartMs": 1934820,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "But also, there might be things that are only sold at duty-free shops in certain countries"
    } ]
  }, {
    "tStartMs": 1940160,
    "dDurationMs": 6580,
    "segs": [ {
      "utf8": "So when you buy those kinds of things, it seems like you also buy them as gifts"
    } ]
  }, {
    "tStartMs": 1946740,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "That's good"
    } ]
  }, {
    "tStartMs": 1947650,
    "dDurationMs": 5150,
    "segs": [ {
      "utf8": "You said you don't have travel plans this year, right?"
    } ]
  }, {
    "tStartMs": 1952800,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "I don't have any this year"
    } ]
  }, {
    "tStartMs": 1953840,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "I think it might be like that for a long time"
    } ]
  }, {
    "tStartMs": 1958210,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "For a long time"
    } ]
  }, {
    "tStartMs": 1960420,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Why is that?"
    } ]
  }, {
    "tStartMs": 1962590,
    "dDurationMs": 7710,
    "segs": [ {
      "utf8": "Like I mentioned earlier, I'm kind of"
    } ]
  }, {
    "tStartMs": 1970300,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "entering hustle mode now"
    } ]
  }, {
    "tStartMs": 1973580,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and from now on, unless I'm invited"
    } ]
  }, {
    "tStartMs": 1977340,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "I won't go abroad"
    } ]
  }, {
    "tStartMs": 1980100,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 1981060,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "Have you traveled enough?"
    } ]
  }, {
    "tStartMs": 1983650,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "It seems like I've done a lot..."
    } ]
  }, {
    "tStartMs": 1987450,
    "dDurationMs": 8010,
    "segs": [ {
      "utf8": "Well, not really, but now for me, travel is less"
    } ]
  }, {
    "tStartMs": 1995460,
    "dDurationMs": 8280,
    "segs": [ {
      "utf8": "interesting than music and work"
    } ]
  }, {
    "tStartMs": 2003740,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "I'm trying to have that kind of mindset"
    } ]
  }, {
    "tStartMs": 2007240,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "It's nice to see you living so hard"
    } ]
  }, {
    "tStartMs": 2009710,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "But that's not what I mean"
    } ]
  }, {
    "tStartMs": 2011780,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "Why, why does it seem that way then"
    } ]
  }, {
    "tStartMs": 2014970,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I'm just pretending"
    } ]
  }, {
    "tStartMs": 2017790,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "Is it self-hypnosis?"
    } ]
  }, {
    "tStartMs": 2019100,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "Yeah"
    } ]
  }, {
    "tStartMs": 2019920,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "Actually, I really wanted to go"
    } ]
  }, {
    "tStartMs": 2022270,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Actually, I really want to go"
    } ]
  }, {
    "tStartMs": 2024940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Actually, I really want to go"
    } ]
  }, {
    "tStartMs": 2026560,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Yeah, I kind of want to go to a resort"
    } ]
  }, {
    "tStartMs": 2030250,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Ah, so you keep telling yourself that work is fun"
    } ]
  }, {
    "tStartMs": 2034230,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "That's right"
    } ]
  }, {
    "tStartMs": 2036010,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "Is there an airport that left a strong impression on you? You've been to several countries"
    } ]
  }, {
    "tStartMs": 2041730,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "It's hard to pick just one"
    } ]
  }, {
    "tStartMs": 2046650,
    "dDurationMs": 7850,
    "segs": [ {
      "utf8": "I remember Singapore Airport being really smart"
    } ]
  }, {
    "tStartMs": 2054500,
    "dDurationMs": 7060,
    "segs": [ {
      "utf8": "Like, even the baggage tagging was all contactless and organized so neatly"
    } ]
  }, {
    "tStartMs": 2061560,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "It was really clean, the airport was clean too"
    } ]
  }, {
    "tStartMs": 2065310,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "Like those lines and processes, tagging luggage and browsing duty-free and all that"
    } ]
  }, {
    "tStartMs": 2071910,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "the whole process was neat and clean"
    } ]
  }, {
    "tStartMs": 2076700,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "Singapore Airport is the one with the water falling..."
    } ]
  }, {
    "tStartMs": 2081330,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "That seemed to be it"
    } ]
  }, {
    "tStartMs": 2082820,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Ah, right"
    } ]
  }, {
    "tStartMs": 2083700,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "I think that's famous too, Singapore Airport"
    } ]
  }, {
    "tStartMs": 2086560,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "Yeah, that was really pretty"
    } ]
  }, {
    "tStartMs": 2091770,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Well, if I had to think of one"
    } ]
  }, {
    "tStartMs": 2095640,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "Dubai Airport?"
    } ]
  }, {
    "tStartMs": 2097310,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "What was it like? Have you been to Dubai too?"
    } ]
  }, {
    "tStartMs": 2099670,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "No, I was just transiting..."
    } ]
  }, {
    "tStartMs": 2102560,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "You passed through"
    } ]
  }, {
    "tStartMs": 2103950,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Yeah, I was just passing through"
    } ]
  }, {
    "tStartMs": 2105870,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "It was just so huge"
    } ]
  }, {
    "tStartMs": 2111010,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "It was so huge that the plane I arrived on and the plane I had to take next"
    } ]
  }, {
    "tStartMs": 2120010,
    "dDurationMs": 5630,
    "segs": [ {
      "utf8": "even though I had quite a bit of time, even though I had time"
    } ]
  }, {
    "tStartMs": 2125640,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "the walk to get to the next gate was so long"
    } ]
  }, {
    "tStartMs": 2129730,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "I remember feeling a bit rushed"
    } ]
  }, {
    "tStartMs": 2131690,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "The airport is so big... it's really huge"
    } ]
  }, {
    "tStartMs": 2136540,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Did you ever have any difficulties with things like immigration checks?"
    } ]
  }, {
    "tStartMs": 2140800,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "No, I've never had that happen even once"
    } ]
  }, {
    "tStartMs": 2145080,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2145550,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2148040,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "I went once, to America."
    } ]
  }, {
    "tStartMs": 2150210,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Ah, America is a bit tricky."
    } ]
  }, {
    "tStartMs": 2152070,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2152900,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "How was it?"
    } ]
  }, {
    "tStartMs": 2153890,
    "dDurationMs": 6230,
    "segs": [ {
      "utf8": "Well... if I had gone alone, it might have been fine."
    } ]
  }, {
    "tStartMs": 2160120,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "But I went through a school program."
    } ]
  }, {
    "tStartMs": 2162940,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "And the school did it in a somewhat roundabout way."
    } ]
  }, {
    "tStartMs": 2166440,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm not sure exactly how it worked."
    } ]
  }, {
    "tStartMs": 2169440,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "The school said it was okay, so I went."
    } ]
  }, {
    "tStartMs": 2174660,
    "dDurationMs": 5470,
    "segs": [ {
      "utf8": "So if about 20 people went,"
    } ]
  }, {
    "tStartMs": 2180130,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "they told us to stand separately like this."
    } ]
  }, {
    "tStartMs": 2182880,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Whether it was a roundabout method or they were suspicious,"
    } ]
  }, {
    "tStartMs": 2185620,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "I believe that's why they did it that way."
    } ]
  }, {
    "tStartMs": 2190210,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "So three of us did this, and I was last in line."
    } ]
  }, {
    "tStartMs": 2194650,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "The two people ahead of me passed, and now I came from Korea,"
    } ]
  }, {
    "tStartMs": 2197970,
    "dDurationMs": 6230,
    "segs": [ {
      "utf8": "and I'd be staying for the same period, so they told me to go to that room over there."
    } ]
  }, {
    "tStartMs": 2204200,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "They sent me to a separate interrogation room."
    } ]
  }, {
    "tStartMs": 2208910,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "And there they kept asking me things like,"
    } ]
  }, {
    "tStartMs": 2212970,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Do you have a boyfriend here?"
    } ]
  }, {
    "tStartMs": 2215200,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "Are you going to stay at his place? Things like that."
    } ]
  }, {
    "tStartMs": 2220660,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "So I said it wasn't like that, that I came to travel,"
    } ]
  }, {
    "tStartMs": 2224640,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "that I'd be staying at such and such hotel, and told them various things like that."
    } ]
  }, {
    "tStartMs": 2228580,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And they eventually let me through, but it was pretty scary."
    } ]
  }, {
    "tStartMs": 2232720,
    "dDurationMs": 7470,
    "segs": [ {
      "utf8": "Because several scary foreign people were asking questions."
    } ]
  }, {
    "tStartMs": 2240190,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "And... you have to go in alone there, right?"
    } ]
  }, {
    "tStartMs": 2242780,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Without a guardian. (- Yes, that's right, I had to go alone.)"
    } ]
  }, {
    "tStartMs": 2246640,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Wow... that must have been scary."
    } ]
  }, {
    "tStartMs": 2248420,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "But every time something like that happens, what I really feel is that if you have the language,"
    } ]
  }, {
    "tStartMs": 2252800,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "many things get resolved."
    } ]
  }, {
    "tStartMs": 2254850,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "Yes, I've never had that happen."
    } ]
  }, {
    "tStartMs": 2258760,
    "dDurationMs": 7580,
    "segs": [ {
      "utf8": "I heard that if you go to America wearing a Hawaiian shirt, immigration is easier."
    } ]
  }, {
    "tStartMs": 2266340,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "Oh really? Like, \"I came to have fun\" kind of vibe?"
    } ]
  }, {
    "tStartMs": 2273780,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "That could be the case."
    } ]
  }, {
    "tStartMs": 2275330,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2276220,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2278060,
    "dDurationMs": 9170,
    "segs": [ {
      "utf8": "When I went, if an Asian man and woman came together, it was a bit harder?"
    } ]
  }, {
    "tStartMs": 2287230,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "They look at you more carefully? They examine you thoroughly?"
    } ]
  }, {
    "tStartMs": 2289760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "There was that kind of thing too."
    } ]
  }, {
    "tStartMs": 2291840,
    "dDurationMs": 5630,
    "segs": [ {
      "utf8": "I see, that's true. As for me..."
    } ]
  }, {
    "tStartMs": 2297470,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "For having gone abroad several times,"
    } ]
  }, {
    "tStartMs": 2302800,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "I've never been stopped at the airport like that,"
    } ]
  }, {
    "tStartMs": 2307860,
    "dDurationMs": 6490,
    "segs": [ {
      "utf8": "and honestly, on the street or at restaurants,"
    } ]
  }, {
    "tStartMs": 2314350,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "I've never experienced discrimination or being made fun of."
    } ]
  }, {
    "tStartMs": 2319540,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2321790,
    "dDurationMs": 6130,
    "segs": [ {
      "utf8": "Yes, maybe I haven't traveled much yet."
    } ]
  }, {
    "tStartMs": 2327920,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "I haven't traveled much either, but it's not like it hasn't happened."
    } ]
  }, {
    "tStartMs": 2331840,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "There have been people who said things to me on the street."
    } ]
  }, {
    "tStartMs": 2337450,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "But if you stay too long, unless you look suspicious to anyone,"
    } ]
  }, {
    "tStartMs": 2341510,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "it seems like they don't usually stop you."
    } ]
  }, {
    "tStartMs": 2344750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "If you clearly state your purpose,"
    } ]
  }, {
    "tStartMs": 2346880,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "there doesn't seem to be a big problem."
    } ]
  }, {
    "tStartMs": 2351290,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2352540,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So then, lastly, I mainly use duty-free shops at the airport,"
    } ]
  }, {
    "tStartMs": 2355980,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "and you said you use restaurants often. What do you eat at restaurants and convenience stores?"
    } ]
  }, {
    "tStartMs": 2362480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Is there a food you crave and eat often before leaving the country?"
    } ]
  }, {
    "tStartMs": 2365180,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "It depends on the time for me."
    } ]
  }, {
    "tStartMs": 2370370,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "If time is tight, I just eat something simple like a sandwich."
    } ]
  }, {
    "tStartMs": 2374190,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "시간이 촉박하다 그러면 그냥 간단하게 샌드위치 같은 거 먹는 편이고요"
    } ]
  }, {
    "tStartMs": 2379650,
    "dDurationMs": 8700,
    "segs": [ {
      "utf8": "But if you have to go abroad for a few days and come back"
    } ]
  }, {
    "tStartMs": 2388350,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "Then is it always a menu related to kimchi?"
    } ]
  }, {
    "tStartMs": 2393910,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "I do crave Korean food, but especially the ones with kimchi in them?"
    } ]
  }, {
    "tStartMs": 2398140,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Kimchi fried rice?"
    } ]
  }, {
    "tStartMs": 2399550,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "Kimchi stew?"
    } ]
  }, {
    "tStartMs": 2400740,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Kimchi stew."
    } ]
  }, {
    "tStartMs": 2401950,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "Yeah, I understand that feeling too."
    } ]
  }, {
    "tStartMs": 2405240,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Yes, or there's yukgaejang, which doesn't have kimchi in it."
    } ]
  }, {
    "tStartMs": 2409440,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "The spicy kind?"
    } ]
  }, {
    "tStartMs": 2410910,
    "dDurationMs": 430,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2411340,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "Right, right, if you have to be away for a while"
    } ]
  }, {
    "tStartMs": 2416450,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "You should eat something like that."
    } ]
  }, {
    "tStartMs": 2418370,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2420870,
    "dDurationMs": 7410,
    "segs": [ {
      "utf8": "I think there's probably a pretty famous yukgaejang kalguksu restaurant at Incheon Airport?"
    } ]
  }, {
    "tStartMs": 2428280,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2429490,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Yes, yes."
    } ]
  }, {
    "tStartMs": 2430910,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Where is it? I didn't know about it."
    } ]
  }, {
    "tStartMs": 2433180,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "So my older sister taught me about it."
    } ]
  }, {
    "tStartMs": 2436270,
    "dDurationMs": 5890,
    "segs": [ {
      "utf8": "She said when you go to the airport, you absolutely have to eat yuk-kal before you leave."
    } ]
  }, {
    "tStartMs": 2442160,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "But it was really delicious."
    } ]
  }, {
    "tStartMs": 2443470,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "There's 'Hwangsaengga Kalguksu'."
    } ]
  }, {
    "tStartMs": 2447420,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "From what I know, I think it's just a famous restaurant."
    } ]
  }, {
    "tStartMs": 2451500,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "It's a Michelin kalguksu place, and apparently it exists at Terminal 2."
    } ]
  }, {
    "tStartMs": 2457860,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "Oh, when I ate there before, I don't think it had the Michelin rating back then."
    } ]
  }, {
    "tStartMs": 2464340,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "Really? You've eaten there before?"
    } ]
  }, {
    "tStartMs": 2466450,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2470460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "This is pretty good."
    } ]
  }, {
    "tStartMs": 2472350,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Yes, the taste of Korea."
    } ]
  }, {
    "tStartMs": 2474830,
    "dDurationMs": 6110,
    "segs": [ {
      "utf8": "I think it would be good to eat this when you're leaving Korea too, since you won't be able to eat it for a while."
    } ]
  }, {
    "tStartMs": 2480940,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2482270,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I see, I also eat a lot of Korean food."
    } ]
  }, {
    "tStartMs": 2484370,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "Or for me, there's Lotteria at Incheon Airport."
    } ]
  }, {
    "tStartMs": 2490570,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "I think that's the place I've gone to the most."
    } ]
  }, {
    "tStartMs": 2493530,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "It's a bit convenient and you can eat quickly."
    } ]
  }, {
    "tStartMs": 2496630,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "That's nice."
    } ]
  }, {
    "tStartMs": 2498740,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "I recommend the Korean beef bulgogi burger."
    } ]
  }, {
    "tStartMs": 2501270,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "This has a somewhat Korean taste at that Lotteria."
    } ]
  }, {
    "tStartMs": 2505920,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "So I think foreigners would find it worth trying too."
    } ]
  }, {
    "tStartMs": 2509410,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "I eat that often too."
    } ]
  }, {
    "tStartMs": 2510860,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "You like that?"
    } ]
  }, {
    "tStartMs": 2512270,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2513280,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "It's delicious, right?"
    } ]
  }, {
    "tStartMs": 2515250,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "I add bacon to the Korean beef bulgogi burger."
    } ]
  }, {
    "tStartMs": 2521220,
    "dDurationMs": 6530,
    "segs": [ {
      "utf8": "Add bacon and then change the fries to a large size."
    } ]
  }, {
    "tStartMs": 2527750,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "And add seasoned potatoes, soup, and chili."
    } ]
  }, {
    "tStartMs": 2530580,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Someone who knows."
    } ]
  }, {
    "tStartMs": 2532980,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "Seasoned potatoes are a must, right?"
    } ]
  }, {
    "tStartMs": 2534950,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "Absolutely, that's how I eat it."
    } ]
  }, {
    "tStartMs": 2539080,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "You're eating quite luxuriously."
    } ]
  }, {
    "tStartMs": 2541410,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Isn't that already a bit expensive? The Korean beef bulgogi?"
    } ]
  }, {
    "tStartMs": 2544950,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "That way when I order for delivery, the cancellation fee amount matches up."
    } ]
  }, {
    "tStartMs": 2550090,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2551490,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "Ah, so that's Tae-woong's combo too."
    } ]
  }, {
    "tStartMs": 2556560,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "After eating the Korean beef bulgogi and adding bacon, for people who eat a lot"
    } ]
  }, {
    "tStartMs": 2560860,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "It's good to change the fries to a large size and switch to seasoned potatoes anyway."
    } ]
  }, {
    "tStartMs": 2566300,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "I like cheese, but if I want something spicy, I often eat chili too."
    } ]
  }, {
    "tStartMs": 2571390,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "I only eat it with chili."
    } ]
  }, {
    "tStartMs": 2574840,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "You all should take note and I recommend it."
    } ]
  }, {
    "tStartMs": 2578130,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2579100,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Great, so now I'd like to give you a quiz and wrap up."
    } ]
  }, {
    "tStartMs": 2582280,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This week's quiz is"
    } ]
  }, {
    "tStartMs": 2583780,
    "dDurationMs": 6430,
    "segs": [ {
      "utf8": "You just need to pick the facility that Didi and Teacher Tae-woong don't use often at the airport."
    } ]
  }, {
    "tStartMs": 2590210,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Number 1 is a restaurant."
    } ]
  }, {
    "tStartMs": 2593450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Number 2 is a duty-free shop."
    } ]
  }, {
    "tStartMs": 2596330,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Number 3 is a pharmacy."
    } ]
  }, {
    "tStartMs": 2599550,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "Among the restaurant, duty-free shop, and pharmacy, the facility that we don't use often—"
    } ]
  }, {
    "tStartMs": 2604540,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "You can write it in the comments"
    } ]
  }, {
    "tStartMs": 2605640,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "or check it using the voting feature on YouTube, and we'd appreciate it."
    } ]
  }, {
    "tStartMs": 2610280,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Then we'll move on to our next game segment."
    } ]
  }, {
    "tStartMs": 2614300,
    "dDurationMs": 10560,
    "segs": [ {
      "utf8": "\u003cA mini-game done verbally\u003e"
    } ]
  }, {
    "tStartMs": 2624860,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "Yes, today's game we're going to try to finish in one quick round,"
    } ]
  }, {
    "tStartMs": 2629800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and it's a famous game in Korea."
    } ]
  }, {
    "tStartMs": 2631640,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Originally it's called the \"Going to the Market\" game,"
    } ]
  }, {
    "tStartMs": 2635280,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "where you keep listing items that are at the market one after another."
    } ]
  }, {
    "tStartMs": 2639200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Should we do a practice round?"
    } ]
  }, {
    "tStartMs": 2641680,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "If you go to the market, there are carrots~"
    } ]
  }, {
    "tStartMs": 2644510,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "If you go to the market... you have to keep talking about this, right?"
    } ]
  }, {
    "tStartMs": 2646940,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "You have to continue—carrots are there, and what else is there, like that."
    } ]
  }, {
    "tStartMs": 2650770,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "You have to do \"If you go to the market~~\", right?"
    } ]
  }, {
    "tStartMs": 2652220,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "Yes, you have to."
    } ]
  }, {
    "tStartMs": 2653790,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "I see, good."
    } ]
  }, {
    "tStartMs": 2655000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "If you go to the market, there are carrots~"
    } ]
  }, {
    "tStartMs": 2657800,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and onions~"
    } ]
  }, {
    "tStartMs": 2659150,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "If you go to the market, there are carrots~ and onions~"
    } ]
  }, {
    "tStartMs": 2662450,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "+ and green onions~"
    } ]
  }, {
    "tStartMs": 2663650,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "If you go to the market, there are carrots~ and onions~ and green onions~"
    } ]
  }, {
    "tStartMs": 2668650,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "+ and flounder~"
    } ]
  }, {
    "tStartMs": 2670650,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "If you go to the market, there are carrots~ and onions~ and green onions~ and flounder~"
    } ]
  }, {
    "tStartMs": 2676310,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "+ and ajummas~"
    } ]
  }, {
    "tStartMs": 2677650,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "If you go to the market, there are carrots~ and onions~ and green onions~"
    } ]
  }, {
    "tStartMs": 2682250,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and flounder~ and ajummas~"
    } ]
  }, {
    "tStartMs": 2684740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "+ and ajusshis~"
    } ]
  }, {
    "tStartMs": 2686240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "If you go to the market, there are carrots"
    } ]
  }, {
    "tStartMs": 2688080,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and onions and green onions and flounder and ajummas"
    } ]
  }, {
    "tStartMs": 2691240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and ajusshis..."
    } ]
  }, {
    "tStartMs": 2692680,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "and cups..."
    } ]
  }, {
    "tStartMs": 2694490,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "Cups?"
    } ]
  }, {
    "tStartMs": 2695300,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2697540,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Cups?"
    } ]
  }, {
    "tStartMs": 2698240,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "They do sell cups at the market."
    } ]
  }, {
    "tStartMs": 2699300,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "No, well, just say there's water too."
    } ]
  }, {
    "tStartMs": 2704150,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "There's water and flies and everything, right, everything."
    } ]
  }, {
    "tStartMs": 2707660,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Anyway, now!"
    } ]
  }, {
    "tStartMs": 2708720,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "This way you keep going—it's a memory game, you're continuing the list."
    } ]
  }, {
    "tStartMs": 2713180,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2714780,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "I think the maximum is about 10 items (-it's not easy...)"
    } ]
  }, {
    "tStartMs": 2719680,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "It's difficult, this kind of thing."
    } ]
  }, {
    "tStartMs": 2720950,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "One round."
    } ]
  }, {
    "tStartMs": 2722800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Who should go first?"
    } ]
  }, {
    "tStartMs": 2724420,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Please start, Didi."
    } ]
  }, {
    "tStartMs": 2726220,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Understood, I'll begin."
    } ]
  }, {
    "tStartMs": 2729700,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "If you go to the airport, there are flight attendants,"
    } ]
  }, {
    "tStartMs": 2732720,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "If you go to the airport, there are flight attendants,"
    } ]
  }, {
    "tStartMs": 2736740,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "and pilots,"
    } ]
  }, {
    "tStartMs": 2738530,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "If you go to the airport, there are flight attendants, and pilots,"
    } ]
  }, {
    "tStartMs": 2741780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and in-flight meals,"
    } ]
  }, {
    "tStartMs": 2743460,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "If you go to the airport..."
    } ]
  }, {
    "tStartMs": 2745120,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Wait a moment."
    } ]
  }, {
    "tStartMs": 2747060,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Can you really say in-flight meals are at the airport?"
    } ]
  }, {
    "tStartMs": 2750160,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "In-flight meals are put on the airplane at the airport now."
    } ]
  }, {
    "tStartMs": 2753710,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Are you sure it's at the airport?"
    } ]
  }, {
    "tStartMs": 2755650,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Yes, at the airport."
    } ]
  }, {
    "tStartMs": 2756990,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Isn't there an airplane at the airport?"
    } ]
  }, {
    "tStartMs": 2760380,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "So then, where should this food be in order to load it onto the airplane?"
    } ]
  }, {
    "tStartMs": 2765230,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Ah, I understand."
    } ]
  }, {
    "tStartMs": 2768250,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "When you go to the airport, there are flight attendants, pilots, in-flight meals,"
    } ]
  }, {
    "tStartMs": 2773510,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "convenience stores too,"
    } ]
  }, {
    "tStartMs": 2774780,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "When you go to the airport, there are flight attendants, pilots, in-flight meals,"
    } ]
  }, {
    "tStartMs": 2779370,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "convenience stores and restaurants too,"
    } ]
  }, {
    "tStartMs": 2782550,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "When you go to the airport, there are flight attendants, pilots,"
    } ]
  }, {
    "tStartMs": 2786630,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "in-flight meals, convenience stores,"
    } ]
  }, {
    "tStartMs": 2790170,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "restaurants too,"
    } ]
  }, {
    "tStartMs": 2794110,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "telecom companies too,"
    } ]
  }, {
    "tStartMs": 2795720,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "When you go to the airport, there are flight attendants, pilots,"
    } ]
  }, {
    "tStartMs": 2800500,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "in-flight meals, convenience stores,"
    } ]
  }, {
    "tStartMs": 2802460,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "restaurants, telecom companies too,"
    } ]
  }, {
    "tStartMs": 2806250,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "rest stops too,"
    } ]
  }, {
    "tStartMs": 2808190,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Rest stops?"
    } ]
  }, {
    "tStartMs": 2811100,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Ugh!"
    } ]
  }, {
    "tStartMs": 2812160,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "Where do people rest then?"
    } ]
  }, {
    "tStartMs": 2815710,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Rest stops... rest stops?"
    } ]
  }, {
    "tStartMs": 2817980,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "Lounges!"
    } ]
  }, {
    "tStartMs": 2819550,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "Lounges?"
    } ]
  }, {
    "tStartMs": 2822960,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Lounges, a place to rest."
    } ]
  }, {
    "tStartMs": 2825630,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Did you say lounges?"
    } ]
  }, {
    "tStartMs": 2828420,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "Can't it be rest stops?"
    } ]
  }, {
    "tStartMs": 2830750,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Rest stops are what you find on highways, aren't they?"
    } ]
  }, {
    "tStartMs": 2834430,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "\"Let's go to a rest stop\"... is that right? Doesn't that work?"
    } ]
  }, {
    "tStartMs": 2839050,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "I understand, anyway."
    } ]
  }, {
    "tStartMs": 2840200,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "I'm not even sure if there are lounges. Are there? Lounges?"
    } ]
  }, {
    "tStartMs": 2844510,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "No, aren't all of those lounges?"
    } ]
  }, {
    "tStartMs": 2845930,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "Well, that's true, there aren't really lounges specifically."
    } ]
  }, {
    "tStartMs": 2848760,
