  "events": [ {
    "tStartMs": 9884,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "Hello, this is Didi."
    } ]
  }, {
    "tStartMs": 11720,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Hello, this is Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 13388,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Yomojomo is a podcast where two people living in Korea"
    } ]
  }, {
    "tStartMs": 16808,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "talk about the ins and outs of life in Korea."
    } ]
  }, {
    "tStartMs": 20186,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "Teacher Tae-woong is back after a month, welcome!"
    } ]
  }, {
    "tStartMs": 24649,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Yes, thank you for inviting me again."
    } ]
  }, {
    "tStartMs": 27944,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "How have you been? Over the past month?"
    } ]
  }, {
    "tStartMs": 30030,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "Yes, I'm getting by one way or another."
    } ]
  }, {
    "tStartMs": 32240,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Yes, it's already September."
    } ]
  }, {
    "tStartMs": 34701,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Time flies, but it doesn't feel like September."
    } ]
  }, {
    "tStartMs": 37954,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "In what way?"
    } ]
  }, {
    "tStartMs": 39998,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "It feels like August even though it's September."
    } ]
  }, {
    "tStartMs": 42083,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "Because it's hot?"
    } ]
  }, {
    "tStartMs": 42792,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Yes... [laughs]"
    } ]
  }, {
    "tStartMs": 43668,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "Oh, is that so?"
    } ]
  }, {
    "tStartMs": 44252,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "It's cooled down a bit here."
    } ]
  }, {
    "tStartMs": 46004,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "Is that so?"
    } ]
  }, {
    "tStartMs": 46921,
    "dDurationMs": 501,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 47422,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Oh, I'm envious."
    } ]
  }, {
    "tStartMs": 49090,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "Busan is still pretty hot."
    } ]
  }, {
    "tStartMs": 51051,
    "dDurationMs": 4963,
    "segs": [ {
      "utf8": "Yes, I can't survive without turning on the air conditioner."
    } ]
  }, {
    "tStartMs": 56014,
    "dDurationMs": 5464,
    "segs": [ {
      "utf8": "I'm running the air conditioner now too, but it'll cool down soon."
    } ]
  }, {
    "tStartMs": 61478,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "Have you heard that saying?"
    } ]
  }, {
    "tStartMs": 63229,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "One autumn rain and then one set of..."
    } ]
  }, {
    "tStartMs": 67817,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "One set of long underwear! [laughs] (One autumn rain, one set of long underwear)"
    } ]
  }, {
    "tStartMs": 70153,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "Have you heard of it?"
    } ]
  }, {
    "tStartMs": 71404,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "No, this is the first time I've heard it."
    } ]
  }, {
    "tStartMs": 73073,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Really? When it rains in autumn,"
    } ]
  }, {
    "tStartMs": 75492,
    "dDurationMs": 5964,
    "segs": [ {
      "utf8": "there's a saying like that because it gets cold quickly."
    } ]
  }, {
    "tStartMs": 81456,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "I hope it happens that way."
    } ]
  }, {
    "tStartMs": 83083,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Yes, it'll cool down."
    } ]
  }, {
    "tStartMs": 85335,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Last time we filmed together with a video,"
    } ]
  }, {
    "tStartMs": 89005,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "so many people participated in the quiz"
    } ]
  }, {
    "tStartMs": 91633,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "and left comments."
    } ]
  }, {
    "tStartMs": 94677,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "I'm so very grateful."
    } ]
  }, {
    "tStartMs": 95929,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Let me announce the answer to last week's quiz right away."
    } ]
  }, {
    "tStartMs": 99808,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "The answer to last week's quiz was"
    } ]
  }, {
    "tStartMs": 102060,
    "dDurationMs": 5255,
    "segs": [ {
      "utf8": "that option 2, \"Movie tickets are cheap every Wednesday,\" was incorrect."
    } ]
  }, {
    "tStartMs": 107315,
    "dDurationMs": 4797,
    "segs": [ {
      "utf8": "So it's not every Wednesday, but the last Wednesday of every month"
    } ]
  }, {
    "tStartMs": 112112,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "when movie tickets are cheap. No wait,"
    } ]
  }, {
    "tStartMs": 132882,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Why are there so many?"
    } ]
  }, {
    "tStartMs": 134884,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "There were so many!"
    } ]
  }, {
    "tStartMs": 137053,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "It seems everyone listened all the way to the end."
    } ]
  }, {
    "tStartMs": 140723,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Yes, it was a problem you had to listen to the very end to solve,"
    } ]
  }, {
    "tStartMs": 144435,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "that's right."
    } ]
  }, {
    "tStartMs": 146396,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "I'm thinking maybe it's okay to make the problems a bit harder."
    } ]
  }, {
    "tStartMs": 149524,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "I see, I brought something easier today,"
    } ]
  }, {
    "tStartMs": 152318,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "so let's see how it goes today"
    } ]
  }, {
    "tStartMs": 154070,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "and I'll use it as reference for next week's quiz."
    } ]
  }, {
    "tStartMs": 156739,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "Sounds good."
    } ]
  }, {
    "tStartMs": 157657,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "What topic were you planning to talk about today?"
    } ]
  }, {
    "tStartMs": 161703,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "This week's topic is..."
    } ]
  }, {
    "tStartMs": 163413,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "While taking a break from studying Korean,"
    } ]
  }, {
    "tStartMs": 166499,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "music that's nice to listen to while taking a walk—"
    } ]
  }, {
    "tStartMs": 170003,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "recommending 3 songs each?"
    } ]
  }, {
    "tStartMs": 172213,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 173715,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "You remembered well."
    } ]
  }, {
    "tStartMs": 175008,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "A playlist for listening while taking a walk,"
    } ]
  }, {
    "tStartMs": 176968,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "I'll be recommending a total of 6 songs."
    } ]
  }, {
    "tStartMs": 179804,
    "dDurationMs": 5964,
    "segs": [ {
      "utf8": "So today's quiz is from the 6 songs I'll be recommending today."
    } ]
  }, {
    "tStartMs": 185768,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "You just need to guess one singer we haven't mentioned."
    } ]
  }, {
    "tStartMs": 190148,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "So the first one is"
    } ]
  }, {
    "tStartMs": 192525,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Singer number 1 is right away"
    } ]
  }, {
    "tStartMs": 195528,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "BTS, Bangtan Sonyeondan."
    } ]
  }, {
    "tStartMs": 198781,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Singer number 2 is a singer named Baek Yerin,"
    } ]
  }, {
    "tStartMs": 202785,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "and singer number 3 is"
    } ]
  }, {
    "tStartMs": 205163,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "IU."
    } ]
  }, {
    "tStartMs": 207123,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Yes, among these three singers,"
    } ]
  }, {
    "tStartMs": 208791,
    "dDurationMs": 5881,
    "segs": [ {
      "utf8": "you just need to guess one singer we haven't mentioned today,"
    } ]
  }, {
    "tStartMs": 214672,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "and if you leave your answer in the comments below, I'd appreciate it."
    } ]
  }, {
    "tStartMs": 217717,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "It's a playlist I listen to when I take walks."
    } ]
  }, {
    "tStartMs": 220011,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 220762,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "Did Teacher Tae-woong bring songs you actually listen to when you take walks?"
    } ]
  }, {
    "tStartMs": 225767,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "Some of them are,"
    } ]
  }, {
    "tStartMs": 227977,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "and actually, I don't study Korean, you know,"
    } ]
  }, {
    "tStartMs": 231731,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "Oh, that's right."
    } ]
  }, {
    "tStartMs": 232857,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "so I also included some songs"
    } ]
  }, {
    "tStartMs": 235985,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "specifically for people who are studying Korean."
    } ]
  }, {
    "tStartMs": 238821,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Ah, I see."
    } ]
  }, {
    "tStartMs": 240740,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Do you take walks often these days?"
    } ]
  }, {
    "tStartMs": 243618,
    "dDurationMs": 5255,
    "segs": [ {
      "utf8": "It's been raining a lot lately, so I haven't been able to do it often."
    } ]
  }, {
    "tStartMs": 248873,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Ah, there's been a lot of rain."
    } ]
  }, {
    "tStartMs": 251334,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 252043,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "When it's not raining?"
    } ]
  }, {
    "tStartMs": 253419,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "When it's not, I do it often."
    } ]
  }, {
    "tStartMs": 255004,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Usually when do you take walks?"
    } ]
  }, {
    "tStartMs": 257423,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "I don't really take walks much."
    } ]
  }, {
    "tStartMs": 261010,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "If I don't run in the morning, I sometimes just take a walk instead,"
    } ]
  }, {
    "tStartMs": 265181,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Hmm, on days when there's no running?"
    } ]
  }, {
    "tStartMs": 267767,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Yes, these days I can't take walks during the day."
    } ]
  }, {
    "tStartMs": 270812,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "It's too hot, right?"
    } ]
  }, {
    "tStartMs": 272397,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Yes, the sun is too strong."
    } ]
  }, {
    "tStartMs": 274983,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "Yes, that's right."
    } ]
  }, {
    "tStartMs": 275692,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "So on the path where I take walks,"
    } ]
  }, {
    "tStartMs": 279529,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "there's a mountain on the right side,"
    } ]
  }, {
    "tStartMs": 282615,
    "dDurationMs": 5422,
    "segs": [ {
      "utf8": "but as soon as the sun sets just past that mountain,"
    } ]
  }, {
    "tStartMs": 288037,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "the mountain creates shade."
    } ]
  }, {
    "tStartMs": 290581,
    "dDurationMs": 543,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 291124,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So I go out right from that time."
    } ]
  }, {
    "tStartMs": 293584,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "Ah, when some shade starts to appear?"
    } ]
  }, {
    "tStartMs": 295795,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "Yes, yes."
    } ]
  }, {
    "tStartMs": 296713,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "What time is that around?"
    } ]
  }, {
    "tStartMs": 299132,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Around 7 o'clock?"
    } ]
  }, {
    "tStartMs": 300717,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Ah, at night?"
    } ]
  }, {
    "tStartMs": 302844,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Yes, yes, that's right."
    } ]
  }, {
    "tStartMs": 305013,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Ah, evening walks at night are nice, summer evening walks."
    } ]
  }, {
    "tStartMs": 308266,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Ah, yes, it's nice."
    } ]
  }, {
    "tStartMs": 310393,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "So do you go to a park? A park near your house?"
    } ]
  }, {
    "tStartMs": 313563,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "No, there's no park near our house,"
    } ]
  }, {
    "tStartMs": 317066,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "but there's a beach,"
    } ]
  }, {
    "tStartMs": 319402,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "Busan!"
    } ]
  }, {
    "tStartMs": 320445,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "- Yes, yes, the beach... - As expected..."
    } ]
  }, {
    "tStartMs": 322989,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "and since we live in a neighborhood with a very beautiful walking path,"
    } ]
  }, {
    "tStartMs": 327744,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "as I mentioned earlier, when you walk on the path,"
    } ]
  }, {
    "tStartMs": 330747,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "there's a mountain on the right side,"
    } ]
  }, {
    "tStartMs": 333374,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "and the sea on the left side."
    } ]
  }, {
    "tStartMs": 335376,
    "dDurationMs": 5214,
    "segs": [ {
      "utf8": "And on that path, there are very pretty red, green,"
    } ]
  }, {
    "tStartMs": 340590,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "and blue beach trains that pass by."
    } ]
  }, {
    "tStartMs": 343676,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "Wow..."
    } ]
  }, {
    "tStartMs": 345720,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "So it's a really nice neighborhood for taking walks."
    } ]
  }, {
    "tStartMs": 348306,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "It would be nice to go for a walk."
    } ]
  }, {
    "tStartMs": 350058,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "If I lived there, I think I'd go for walks too."
    } ]
  }, {
    "tStartMs": 352894,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "Absolutely, absolutely."
    } ]
  }, {
    "tStartMs": 353978,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "So shall we start recommending songs now? One by one?"
    } ]
  }, {
    "tStartMs": 357315,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "Sounds good."
    } ]
  }, {
    "tStartMs": 358024,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Teacher Tae-woong, please recommend the first song first."
    } ]
  }, {
    "tStartMs": 361319,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 362487,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "The first song I picked is"
    } ]
  }, {
    "tStartMs": 365073,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "by a singer named Jocelyn Brown,"
    } ]
  }, {
    "tStartMs": 369452,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and it's a song called \"Somebody Else's Guy.\""
    } ]
  }, {
    "tStartMs": 374332,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "As I mentioned in the last episode, I didn't bring only Korean songs."
    } ]
  }, {
    "tStartMs": 378503,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "That's right, me too."
    } ]
  }, {
    "tStartMs": 380129,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "Yes, the song is quite long."
    } ]
  }, {
    "tStartMs": 381881,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "It's 6 minutes and 30 seconds."
    } ]
  }, {
    "tStartMs": 385093,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Old songs often had long tracks like this."
    } ]
  }, {
    "tStartMs": 388388,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "I'm seeing this for the first time."
    } ]
  }, {
    "tStartMs": 390723,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "Is there a reason you picked this song?"
    } ]
  }, {
    "tStartMs": 392934,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "There is, there is."
    } ]
  }, {
    "tStartMs": 395019,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Well... let's think about it."
    } ]
