{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 9551,
    "segs": [ {
      "utf8": "디디와 정태웅의 한국생활 요모조모"
    } ]
  }, {
    "tStartMs": 9551,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "안녕하세요 디디입니다"
    } ]
  }, {
    "tStartMs": 11720,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "안녕하세요 정태웅입니다"
    } ]
  }, {
    "tStartMs": 13388,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "[한국생활 요모조모]는 한국에서 살아가는 두 사람이"
    } ]
  }, {
    "tStartMs": 16391,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "한국생활의 요모조모를 이야기하는 팟캐스트 입니다"
    } ]
  }, {
    "tStartMs": 20103,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "이번 주제 '추석'으로 돌아왔는데요"
    } ]
  }, {
    "tStartMs": 22522,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "이 팟캐스트가 올라갈 때쯤이면"
    } ]
  }, {
    "tStartMs": 25984,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "이제 추석 연휴 하루 전일 것 같아요"
    } ]
  }, {
    "tStartMs": 28820,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "그래서 명절, 한국 대명절이죠"
    } ]
  }, {
    "tStartMs": 31614,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "추석 에 대해서 이야기해 보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 36619,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "'요모조모'는..."
    } ]
  }, {
    "tStartMs": 37871,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "아 그 전에 잘 지내셨나요? 태웅쌤?"
    } ]
  }, {
    "tStartMs": 40457,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "아 저는 잘 지내고 있습니다"
    } ]
  }, {
    "tStartMs": 43293,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "제가 지난 '요모조모' 에피소드를 사실 봤는데요"
    } ]
  }, {
    "tStartMs": 47464,
    "dDurationMs": 625,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 48089,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "제가 진짜 기운이 없더라고요..."
    } ]
  }, {
    "tStartMs": 51551,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "더위먹은 태웅쌤"
    } ]
  }, {
    "tStartMs": 53470,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "아 그래서 너무 죄송하더라고요"
    } ]
  }, {
    "tStartMs": 57599,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "재밌었어요 근데 그 편"
    } ]
  }, {
    "tStartMs": 59142,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "아 그랬나요? 다행이네요"
    } ]
  }, {
    "tStartMs": 60810,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "네, 얘기들 다 재밌었고..."
    } ]
  }, {
    "tStartMs": 62854,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "다행입니다"
    } ]
  }, {
    "tStartMs": 64105,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "날씨가 요즘은 어때요?"
    } ]
  }, {
    "tStartMs": 65857,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "아 너무 선선해졌어요"
    } ]
  }, {
    "tStartMs": 68735,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "아 정말 좋습니다"
    } ]
  }, {
    "tStartMs": 70278,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "살아나셨네요 축하드립니다"
    } ]
  }, {
    "tStartMs": 72614,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "감사합니다"
    } ]
  }, {
    "tStartMs": 73865,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "근데 모기가 좀 많아지지 않아요? 요즘?"
    } ]
  }, {
    "tStartMs": 77660,
    "dDurationMs": 1419,
    "segs": [ {
      "utf8": "아 그런거 같아요"
    } ]
  }, {
    "tStartMs": 79079,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 80288,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "한여름에도 사실 모기가 저희 집에는 많지 않았거든요"
    } ]
  }, {
    "tStartMs": 84834,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "어 근데 갑자기 시원해지고 나니까"
    } ]
  }, {
    "tStartMs": 87921,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "뭐 한두 마리 보이기 시작하더라구요"
    } ]
  }, {
    "tStartMs": 90256,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "저도! 여름 다 끝나고 모기 엄청 물렸어요"
    } ]
  }, {
    "tStartMs": 94344,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "전 최근에 캠핑 또 갔다 왔거든요"
    } ]
  }, {
    "tStartMs": 97639,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "거기서도 많이 물렸습니다"
    } ]
  }, {
    "tStartMs": 99766,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "다 더워하다가 살아났나 봐요"
    } ]
  }, {
    "tStartMs": 102852,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "아 그렇구나"
    } ]
  }, {
    "tStartMs": 105105,
    "dDurationMs": 5171,
    "segs": [ {
      "utf8": "제가 지난 에피소드 때 얘기했던 '벽력일섬 전기파리채'"
    } ]
  }, {
    "tStartMs": 110276,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "그거 누가 좋다고 얘기 안 했나요? 아이디어?"
    } ]
  }, {
    "tStartMs": 113738,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "단 한 개의 코멘트도 없었던 것 같아요, 아쉽게도"
    } ]
  }, {
    "tStartMs": 118284,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "아 그렇구나"
    } ]
  }, {
    "tStartMs": 119702,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "네 그거 말고 댓글 읽기 좀 해볼까요? 저..."
    } ]
  }, {
    "tStartMs": 123456,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "태웅쌤 채널에서도 하고 있는데"
    } ]
  }, {
    "tStartMs": 127085,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "뭐 다양하게 있거든요"
    } ]
  }, {
    "tStartMs": 128920,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "'유튜브에서 제일 기대되는 게 이 시리즈에요 감사합니다'"
    } ]
  }, {
    "tStartMs": 132590,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "라고 하시는 분도 있고"
    } ]
  }, {
    "tStartMs": 134509,
    "dDurationMs": 5505,
    "segs": [ {
      "utf8": "'여름에 대한 마음이 태웅쌤이랑 정확히 똑같다'고..."
    } ]
  }, {
    "tStartMs": 140014,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "많다니까요 이런 사람들"
    } ]
  }, {
    "tStartMs": 141599,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "진짜 싫어 하시나봐요 더위를 많이 타시는 분들"
    } ]
  }, {
    "tStartMs": 145979,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "그거 그거 '과일을 안 먹는다고요?!' 이런 댓글도 있던데"
    } ]
  }, {
    "tStartMs": 149440,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "그냥 물음표만 댓글 댓글에..."
    } ]
  }, {
    "tStartMs": 151609,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "아!!"
    } ]
  }, {
    "tStartMs": 153444,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "'과일 안 먹는다'라는 부분에 물음표"
    } ]
  }, {
    "tStartMs": 156614,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 157907,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "그러게 과일을 안 드시네요?"
    } ]
  }, {
    "tStartMs": 160451,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "안 먹어도 됩니다"
    } ]
  }, {
    "tStartMs": 163371,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "비슷한 댓글 있어요"
    } ]
  }, {
    "tStartMs": 164372,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "'저도 과일 절대 안 먹어요' 있고,"
    } ]
  }, {
    "tStartMs": 167250,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "'토마토는 과일이다'라는 의견도 있고"
    } ]
  }, {
    "tStartMs": 170211,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "그거 제가 헷갈린 것 같아요"
    } ]
  }, {
    "tStartMs": 171713,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "근데 다시 검색해봤는데,"
    } ]
  }, {
    "tStartMs": 176176,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "뭐 이런저런 의견이 있던데요?"
    } ]
  }, {
    "tStartMs": 178678,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 179637,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "확실하지 않아요"
    } ]
  }, {
    "tStartMs": 180346,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "아채? 채소?"
    } ]
  }, {
    "tStartMs": 183516,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "예, 아무튼 어, 이런 것도 있었어요"
    } ]
  }, {
    "tStartMs": 186269,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "'저는 선크림도 안 바르고 화장도 안 하는데"
    } ]
  }, {
    "tStartMs": 189314,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "다들 제 피부가 너무 곱다고 합니다'"
    } ]
  }, {
    "tStartMs": 191858,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "괄호 열고 60대 괄호 닫고 있습니다"
    } ]
  }, {
    "tStartMs": 195278,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "이야, 그건 진짜 타고나야 하는 게 아닐까"
    } ]
  }, {
    "tStartMs": 198323,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "피부는 좀 유전이 확실히 있죠"
    } ]
  }, {
    "tStartMs": 201784,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "부럽습니다"
    } ]
  }, {
    "tStartMs": 202911,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "유전적인 게 있는데"
    } ]
  }, {
    "tStartMs": 205622,
    "dDurationMs": 5297,
    "segs": [ {
      "utf8": "근데 선크림 바르면 그냥 좋다고 전 많이 들었어가지고"
    } ]
  }, {
    "tStartMs": 210919,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "잘 바르고 있습니다"
    } ]
  }, {
    "tStartMs": 212754,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "제가 지난 시간에 모자 보여줬나요?"
    } ]
  }, {
    "tStartMs": 215757,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "모자? 아니요"
    } ]
  }, {
    "tStartMs": 217133,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "모자 안 보여줬어요? 제가 모자?"
    } ]
  }, {
    "tStartMs": 219052,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "네ㅋㅋ 모자 안 보여줬어요"
    } ]
  }, {
    "tStartMs": 221846,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "아 안 보여줬구나"
    } ]
  }, {
    "tStartMs": 223890,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "아 지금 잠깐 보여드릴까요?"
    } ]
  }, {
    "tStartMs": 225058,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "제가 왜 그 얘기를.. (- 아 근처에 있어요?)"
    } ]
  }, {
    "tStartMs": 228019,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "제가 너무 기운이 없어서 그거를 소개하는 걸 깜빡했나 봐요"
    } ]
  }, {
    "tStartMs": 231773,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 232523,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "제가 진짜 기가 막힌 모자가 있거든요?"
    } ]
  }, {
    "tStartMs": 235735,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "잠시만요"
    } ]
  }, {
    "tStartMs": 239072,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "가방 아니에요?"
    } ]
  }, {
    "tStartMs": 240698,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "자 돌아왔습니다"
    } ]
  }, {
    "tStartMs": 242951,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "그 이렇게 생긴 모자 인데요"
    } ]
  }, {
    "tStartMs": 247163,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "얼핏 보면 평범하게 생긴 모자 같죠"
    } ]
  }, {
    "tStartMs": 250166,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "아니 평범해 보이지 않는데요"
    } ]
  }, {
    "tStartMs": 252460,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "에 이게요?!"
    } ]
  }, {
    "tStartMs": 253878,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "뭔가 ..."
    } ]
  }, {
    "tStartMs": 255964,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "챙이 있고 햇(hat) 같은 거고"
    } ]
  }, {
    "tStartMs": 258299,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "그리고 가림막 이렇게 있네요"
    } ]
  }, {
    "tStartMs": 260718,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "이런 모자 원래 좀 많잖아요"
    } ]
  }, {
    "tStartMs": 262553,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "약간 아웃도어 스타일?"
    } ]
  }, {
    "tStartMs": 264222,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "맞습니다 맞습니다"
    } ]
  }, {
    "tStartMs": 265306,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "이게 이게 제가 그 방글라데시 에서"
    } ]
  }, {
    "tStartMs": 268643,
    "dDurationMs": 5756,
    "segs": [ {
      "utf8": "한국국제협력개발단 코이카 봉사활동할 때"
    } ]
  }, {
    "tStartMs": 274399,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "굿즈로 받은 건데"
    } ]
  }, {
    "tStartMs": 276359,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "그냥 원래는 이렇게 쓰는 거거든요"
    } ]
  }, {
    "tStartMs": 278820,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "그럼 이제 이 위에서는"
    } ]
  }, {
    "tStartMs": 280655,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "이 챙이 막 가려주고"
    } ]
  }, {
    "tStartMs": 283616,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "목은 이 천이 가려주는 거란 말이에요"
    } ]
  }, {
    "tStartMs": 288329,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "그리고 뭐 목에 끈도 있고"
    } ]
  }, {
    "tStartMs": 292542,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "근데요,"
    } ]
  }, {
    "tStartMs": 293501,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "저는 아침에 달리기를 자주 하지 않습니까?"
    } ]
  }, {
    "tStartMs": 296170,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 297046,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "근데 그때 문제가 그 해가 낮게 떠요"
    } ]
  }, {
    "tStartMs": 301384,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "우와"
    } ]
  }, {
    "tStartMs": 302635,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "저는 알지 못하는 해의 높이네요"
    } ]
  }, {
    "tStartMs": 305221,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "아, 그래요?"
    } ]
  }, {
    "tStartMs": 306264,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "아니, 해질녘에도 해가 낮잖아요"
    } ]
  }, {
    "tStartMs": 308766,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "아, 그쵸, 그쵸"
    } ]
  }, {
    "tStartMs": 309809,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "아, 해가 뜰 때도 해가 낮구나"
    } ]
  }, {
    "tStartMs": 311811,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "아, 그렇죠"
    } ]
  }, {
    "tStartMs": 313271,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "그러면은 더 세게 느껴져요? 자외선이?"
    } ]
  }, {
    "tStartMs": 316774,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "그러면은, 아니, 해가 방향이 앞에서 오니까"
    } ]
  }, {
    "tStartMs": 320194,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "아~!"
    } ]
  }, {
    "tStartMs": 321946,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "이게.. 이게.. 상관없는 거예요"
    } ]
  }, {
    "tStartMs": 325158,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "아, 그쵸? 안면을 그냥.."
    } ]
  }, {
    "tStartMs": 328244,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "그래서 제가 어떤 생각을 하게 됐냐"
    } ]
  }, {
    "tStartMs": 331497,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "요거를요 요거를요"
    } ]
  }, {
    "tStartMs": 334959,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "이렇게 거꾸로 쓰는 거예요"
    } ]
  }, {
    "tStartMs": 337086,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "어? 대박!"
    } ]
  }, {
    "tStartMs": 338254,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "거꾸로"
    } ]
  }, {
    "tStartMs": 340423,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "이렇게"
    } ]
  }, {
    "tStartMs": 343885,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "아, 보여요?"
    } ]
  }, {
    "tStartMs": 345011,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "네, 보여요 여기 틈이 있어요"
    } ]
  }, {
    "tStartMs": 347013,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "근데 그렇게 쓰는 거 맞는 거 같아 보이는데요?"
    } ]
  }, {
    "tStartMs": 350099,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "아니에요"
    } ]
  }, {
    "tStartMs": 350808,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "근데 왜 코 구멍도 있는데요?"
    } ]
  }, {
    "tStartMs": 352685,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "제가 가위로 잘랐어요"
    } ]
  }, {
    "tStartMs": 353811,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 357273,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "와..."
    } ]
  }, {
    "tStartMs": 358566,
    "dDurationMs": 6173,
    "segs": [ {
      "utf8": "그래서 아침에 그 한창 여름에 이렇게 모자를 쓰고 뛰었어요"
    } ]
  }, {
    "tStartMs": 364739,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "와..."
    } ]
  }, {
    "tStartMs": 367075,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "근데 문제는..."
    } ]
  }, {
    "tStartMs": 367950,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "선크림을 안 바르겠다는 의지"
    } ]
  }, {
    "tStartMs": 369160,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "네, 선크림을 바르기 싫어서"
    } ]
  }, {
    "tStartMs": 371662,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "그게 더 답답하지 않아요?"
    } ]
  }, {
    "tStartMs": 373623,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "더 답답하죠"
    } ]
  }, {
    "tStartMs": 376876,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "문제는 달릴 때 입으로 숨을 못 쉬어요"
    } ]
  }, {
    "tStartMs": 379670,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "아, 코로만 숨을 쉬어야 돼요?"
    } ]
  }, {
    "tStartMs": 381631,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "네네, 입에는 구멍이 없잖아요"
    } ]
  }, {
    "tStartMs": 383966,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "아, 너무 힘들겠는데요? 운동이 2배"
    } ]
  }, {
    "tStartMs": 387011,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "그래서 더 강한 훈련을 할 수 있는 거죠"
    } ]
  }, {
    "tStartMs": 391057,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "와 고생하셨네요 여름동안"
    } ]
  }, {
    "tStartMs": 393559,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "네, 아 근데 저는.. (- 커스텀을 하다니)"
    } ]
  }, {
    "tStartMs": 396646,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "네, 다 진짜 제가 선크림을 안 바르기 위해"
    } ]
  }, {
    "tStartMs": 400149,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "노력을 많이 했습니다"
    } ]
  }, {
    "tStartMs": 401734,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "좋습니다 이제 그래도 여름 지났어요"
    } ]
  }, {
    "tStartMs": 404904,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "가을이고 선선하고 이 추석 때쯤 되면은"
    } ]
  }, {
    "tStartMs": 408449,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "진짜 확실히 선선한 것 같아요"
    } ]
  }, {
    "tStartMs": 411035,
    "dDurationMs": 5631,
    "segs": [ {
      "utf8": "그 뭐랄까 약간은 쓸쓸한 향기? 공기? 그런 거 있어요"
    } ]
  }, {
    "tStartMs": 416666,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "아 그렇죠"
    } ]
  }, {
    "tStartMs": 418334,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "가을의 공기"
    } ]
  }, {
    "tStartMs": 420128,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "전 좋습니다 그런게 너무"
    } ]
  }, {
    "tStartMs": 422672,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "그런데 어... 우선은"
    } ]
  }, {
    "tStartMs": 425425,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "본격적으로 추석에 대해서 이야기하기 전에"
    } ]
  }, {
    "tStartMs": 428386,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "저번주 퀴즈 정답 부터 알려드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 431848,
    "dDurationMs": 5505,
    "segs": [ {
      "utf8": "저번주 퀴즈는 '태웅쌤과 디디가 언급한 여름 음식이 아닌 것은?' 이었구요"
    } ]
  }, {
    "tStartMs": 437353,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "정답은 1번 라면 이었습니다"
    } ]
  }, {
    "tStartMs": 440314,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "나머지 밀면은 부산의 밀면"
    } ]
  }, {
    "tStartMs": 442900,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "냉면은 제가 좋아하는 여름 음식으로 얘기를 했었죠?"
    } ]
  }, {
    "tStartMs": 446696,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "이번주 퀴즈도 끝쪽에 있으니까 끝까지 들어주시고요"
    } ]
  }, {
    "tStartMs": 450533,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "이번에는 좀 다르게 순서를 바꿔서"
    } ]
  }, {
    "tStartMs": 453286,
    "dDurationMs": 4754,
    "segs": [ {
      "utf8": "[말로 하는 미니게임]을 먼저 하고 시작해 보려고 해요"
    } ]
  }, {
    "tStartMs": 458040,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "어떤 게임이길래?"
    } ]
  }, {
    "tStartMs": 459834,
    "dDurationMs": 5547,
    "segs": [ {
      "utf8": "이번 게임은 이심전심 게임입니다 '이심전심'"
    } ]
  }, {
    "tStartMs": 465381,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "그게 뭐예요?"
    } ]
  }, {
    "tStartMs": 466507,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "그 마음이 같은지 맞춰보는 거고"
    } ]
  }, {
    "tStartMs": 469802,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "약간 이구동성 게임? 그런거랑 비슷한 것 같은데"
    } ]
  }, {
    "tStartMs": 472805,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "뭐 예를 들면"
    } ]
  }, {
    "tStartMs": 474265,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "어... '유튜브에서 제일 재밌는 채널'"
    } ]
  }, {
    "tStartMs": 476642,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "하나, 둘, 셋!"
    } ]
  }, {
    "tStartMs": 478102,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "침착맨!"
    } ]
  }, {
    "tStartMs": 479437,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "아 맞아요 그런식으로"
    } ]
  }, {
    "tStartMs": 480980,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "그렇게 아.."
    } ]
  }, {
    "tStartMs": 482273,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "침착맨이 제일 재밌군요ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 483816,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "아 바로 시작한 줄 알았어요"
    } ]
  }, {
    "tStartMs": 486569,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "동시에 얘기하는 게 얼마나 맞는지 확인해 보는 거고"
    } ]
  }, {
    "tStartMs": 491240,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "추석에 관련해서 이야기를 할 거기 때문에"
    } ]
  }, {
    "tStartMs": 494035,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "얘기해서 거기에서 얘기가 나온 것들로"
    } ]
  }, {
    "tStartMs": 496954,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "토크도 해보면 좋을 것 같아요"
    } ]
  }, {
    "tStartMs": 499457,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 500333,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "자, 그러면 태웅쌤과 저의 마음은 얼마나 통하는지"
    } ]
  }, {
    "tStartMs": 505046,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 507507,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "첫 번째,"
    } ]
  }, {
    "tStartMs": 509675,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "추석하면 가장 먼저 떠오르는 음식"
    } ]
  }, {
    "tStartMs": 512595,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "음식x3, 음식이요?"
    } ]
  }, {
    "tStartMs": 513763,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "음식"
    } ]
  }, {
    "tStartMs": 516390,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "하나..."
    } ]
  }, {
    "tStartMs": 517600,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "그거죠? 아무래도 그거.."
    } ]
  }, {
    "tStartMs": 519727,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "네? 네 ..."
    } ]
  }, {
    "tStartMs": 521646,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "아니 맞춰보는 거예요 맞는지, 우리의 생각이"
    } ]
  }, {
    "tStartMs": 525566,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "그거잖아요"
    } ]
  }, {
    "tStartMs": 527902,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "하나, 둘, 셋,"
    } ]
  }, {
    "tStartMs": 530655,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "송편!"
    } ]
  }, {
    "tStartMs": 532073,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "오 맞았다"
    } ]
  }, {
    "tStartMs": 534700,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "그쵸 송편 빼놓을 수 없죠"
    } ]
  }, {
    "tStartMs": 537161,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "송편에 대해서도 얘기해 볼 거고"
    } ]
  }, {
    "tStartMs": 538829,
    "dDurationMs": 5715,
    "segs": [ {
      "utf8": "두 번째 가장 흔한 추석선물"
    } ]
  }, {
    "tStartMs": 544544,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "가장 흔한 추석 선물"
    } ]
  }, {
    "tStartMs": 546796,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "오케이"
    } ]
  }, {
    "tStartMs": 547964,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "네, 생각하셨나요?"
    } ]
  }, {
    "tStartMs": 550007,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "하나, 둘, 셋"
    } ]
  }, {
    "tStartMs": 553386,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "스팸! / 한우 세트!"
    } ]
  }, {
    "tStartMs": 554762,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "ㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 558015,
    "dDurationMs": 4964,
    "segs": [ {
      "utf8": "아~! 둘 다 근데 진짜 추석 선물이긴 해요"
    } ]
  }, {
    "tStartMs": 562979,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 563980,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "이것도 그럼 얘기해보고"
    } ]
  }, {
    "tStartMs": 565815,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "자, 세 번째!"
    } ]
  }, {
    "tStartMs": 568109,
    "dDurationMs": 5922,
    "segs": [ {
      "utf8": "외국인이 가장 신기해 할 것 같은 추석 문화?"
    } ]
  }, {
    "tStartMs": 574031,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "잠시만요, 잠시만요"
    } ]
  }, {
    "tStartMs": 575449,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "외국인 분들이 보시기에"
    } ]
  }, {
    "tStartMs": 577285,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "'어? 추석에 이런 걸 하네?'"
    } ]
  }, {
    "tStartMs": 579328,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "하고 가장 신기해할 것 같은 문화"
    } ]
  }, {
    "tStartMs": 582582,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "음... 네"
    } ]
  }, {
    "tStartMs": 584208,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "생각하셨나요?"
    } ]
  }, {
    "tStartMs": 586627,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "아... 어려운데?"
    } ]
  }, {
    "tStartMs": 588462,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "어렵긴해요"
    } ]
  }, {
    "tStartMs": 590089,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "어..."
    } ]
  }, {
    "tStartMs": 591007,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "다양하게 있는데..."
    } ]
  }, {
    "tStartMs": 593718,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "알겠습니다"
    } ]
  }, {
    "tStartMs": 595052,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "생각하셨어요?"
    } ]
  }, {
    "tStartMs": 596304,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 597763,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "하나, 둘, 셋!"
    } ]
  }, {
    "tStartMs": 600016,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "차례 / 쥐불놀이"
    } ]
  }, {
    "tStartMs": 601309,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "(쥐불놀이 = 전통 놀이)"
    } ]
  }, {
    "tStartMs": 604020,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "쥐불놀이ㅋㅋㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 606147,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "아니 쥐불놀이..."
    } ]
  }, {
    "tStartMs": 607898,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "(어릴때) 하셨어요?"
    } ]
  }, {
    "tStartMs": 609525,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "아니요(?)"
    } ]
  }, {
    "tStartMs": 610276,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "ㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 613571,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "신기하긴 해 쥐불놀이"
    } ]
  }, {
    "tStartMs": 615698,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "저도 신기해서..."
    } ]
  }, {
    "tStartMs": 616824,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "그쵸 그쵸 안 해봐서"
    } ]
  }, {
    "tStartMs": 618743,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "오케이 좋습니다"
    } ]
  }, {
    "tStartMs": 620244,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "아... 네 이렇게 마음이 음식만 통하고"
    } ]
  }, {
    "tStartMs": 624123,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "나머지는 안통했는데"
    } ]
  }, {
    "tStartMs": 625916,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "자 차근차근 얘기해보죠"
    } ]
  }, {
    "tStartMs": 628502,
    "dDurationMs": 5339,
    "segs": [ {
      "utf8": "우선 추석하면은 가장 대표적으로 떠오르는 키워드일 것 같아요"
    } ]
  }, {
    "tStartMs": 633841,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "송편"
    } ]
  }, {
    "tStartMs": 635426,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "...인데요 어떤 음식인가요 송편이?"
    } ]
  }, {
    "tStartMs": 637928,
    "dDurationMs": 5548,
    "segs": [ {
      "utf8": "송편은 여러 가지 색깔을 가진"
    } ]
  }, {
    "tStartMs": 643476,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "요만한… "
    } ]
  }, {
    "tStartMs": 645436,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "동그라미 500원짜리 동전만한?"
    } ]
  }, {
    "tStartMs": 648481,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "네네 동전만한..."
    } ]
  }, {
    "tStartMs": 650650,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "울퉁불퉁한 떡인데요"
    } ]
  }, {
    "tStartMs": 654612,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "그 떡 안에는"
    } ]
  }, {
    "tStartMs": 656739,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "달달한 꿀...인가요?"
    } ]
  }, {
    "tStartMs": 660159,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "꿀, 뭐 깨 이런 거 들어가죠"
    } ]
  }, {
    "tStartMs": 663287,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "네 여러가지 재료가 들어가있는 떡입니다"
    } ]
  }, {
    "tStartMs": 667208,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "네, 그런데 이름에서 볼 수 있듯이 좀 특이한 거라고 하면"
    } ]
  }, {
    "tStartMs": 671420,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "소나무 잎이 있어요"
    } ]
  }, {
    "tStartMs": 674799,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "소나무는 1년 내내 푸른 나무고"
    } ]
  }, {
    "tStartMs": 678386,
    "dDurationMs": 5088,
    "segs": [ {
      "utf8": "이쑤시개 같이 얇은 잎사귀가 있고"
    } ]
  }, {
    "tStartMs": 683474,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "거기 위에 떡을 올려놓고 스팀을 줍니다"
    } ]
  }, {
    "tStartMs": 687520,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "그렇게 만드는게 ‘송’편"
    } ]
  }, {
    "tStartMs": 690898,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "소나무 ‘송’자를 써서 송편이라고 불러요"
    } ]
  }, {
    "tStartMs": 694068,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "아... 처음 알았어요"
    } ]
  }, {
    "tStartMs": 695778,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "아 진짜요?"
    } ]
  }, {
    "tStartMs": 697488,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "태웅쌤 송편 만들어 보신 적 있어요??"
    } ]
  }, {
    "tStartMs": 699782,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "저는 빚어본 것만 했어요"
    } ]
  }, {
    "tStartMs": 702868,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "아~ 빚기"
    } ]
  }, {
    "tStartMs": 704829,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "만두 만들듯이!"
    } ]
  }, {
    "tStartMs": 707998,
    "dDurationMs": 5131,
    "segs": [ {
      "utf8": "네 떡을 손으로 펴서, 모양을 펼쳐서"
    } ]
  }, {
    "tStartMs": 713129,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "거기다가 아까 얘기한 꿀이나 깨 같은 거를 위에 올리고"
    } ]
  }, {
    "tStartMs": 717800,
    "dDurationMs": 5422,
    "segs": [ {
      "utf8": "그리고 그걸 싸는, 송편을 ‘빚는’ 거"
    } ]
  }, {
    "tStartMs": 723222,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "그것만 어릴 때 많이 해봤습니다"
    } ]
  }, {
    "tStartMs": 725474,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "맞아 어릴 때 그거 되게 재밌게 했던 기억이 나요"
    } ]
  }, {
    "tStartMs": 728978,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "뭔가 놀이 하는 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 730438,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "그리고 이런 거 만들다 보면 (어른들이) 그런 얘기 하시잖아요"
    } ]
  }, {
    "tStartMs": 734442,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "‘예쁘게 만들어야 나중에 예쁜 딸 낳는다’"
    } ]
  }, {
    "tStartMs": 738696,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "‘예쁜 아들 낳는다’"
    } ]
  }, {
    "tStartMs": 741073,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "그래서 ‘얼마나 예쁘게 만들었나~’"
    } ]
  }, {
    "tStartMs": 742867,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "막 어른들이 보고 했던 기억이 나요"
    } ]
  }, {
    "tStartMs": 745661,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 746787,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "네, (그런 적) 없어요?"
    } ]
  }, {
    "tStartMs": 748706,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "아니, 기억이 안 나서..."
    } ]
  }, {
    "tStartMs": 751917,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "옛날이여..."
    } ]
  }, {
    "tStartMs": 753085,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "너무 어릴 때라..."
    } ]
  }, {
    "tStartMs": 754211,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "네 그랬던, 저는 그런 기억이 있네요"
    } ]
  }, {
    "tStartMs": 758048,
    "dDurationMs": 5506,
    "segs": [ {
      "utf8": "좋아하셨어요? 빚고 이제 만들어주신 거 나와서 먹으면?"
    } ]
  }, {
    "tStartMs": 763554,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "저는 만드는 건 좋아했던 거 같아요"
    } ]
  }, {
    "tStartMs": 767057,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "먹어봤을 땐 어땠어요?"
    } ]
  }, {
    "tStartMs": 769226,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "그냥 그랬어요"
    } ]
  }, {
    "tStartMs": 770144,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "그쵸? 저도"
    } ]
  }, {
    "tStartMs": 774440,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "이게 만드는 파트는 재밌는데,"
    } ]
  }, {
    "tStartMs": 776776,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "사실 먹어보면, 그냥 그래"
    } ]
  }, {
    "tStartMs": 779528,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "뭐 막 그렇게 막 엄청 맛있는 음식은 아니니까"
    } ]
  }, {
    "tStartMs": 783157,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "맞아 맞아 맞아요"
    } ]
  }, {
    "tStartMs": 785201,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "아 그리고 그게 애들 입맛에 안 맞을 수 있어요"
    } ]
  }, {
    "tStartMs": 788287,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "아 맞아"
    } ]
  }, {
    "tStartMs": 788913,
    "dDurationMs": 4796,
    "segs": [ {
      "utf8": "어르신들이 꼭 거기 콩을 넣었어요 저희 집은"
    } ]
  }, {
    "tStartMs": 793709,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "저도 그래서 그냥 그랬던 것 같아요"
    } ]
  }, {
    "tStartMs": 795586,
    "dDurationMs": 7382,
    "segs": [ {
      "utf8": "그쵸 '제발 설탕을 넣게 해달라'  했던 기억이 나요"
    } ]
  }, {
    "tStartMs": 802968,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "근데 어르신들도 먹어야 되고,"
    } ]
  }, {
    "tStartMs": 804762,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "그게 나중에 차례상에 올리잖아요?"
    } ]
  }, {
    "tStartMs": 807556,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 808265,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "그래서 또 어른 입맛에 맞춰서 만드는 건데,"
    } ]
  }, {
    "tStartMs": 812478,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "어..."
    } ]
  }, {
    "tStartMs": 813229,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "그래서 저는 꿀떡이라는 떡을 더 좋아해요"
    } ]
  }, {
    "tStartMs": 816065,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "아, 좋죠"
    } ]
  }, {
    "tStartMs": 816941,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "꿀떡이 좋죠"
    } ]
  }, {
    "tStartMs": 818484,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "맛있죠?"
    } ]
  }, {
    "tStartMs": 819443,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "꿀이 맛있잖아요"
    } ]
  }, {
    "tStartMs": 821070,
    "dDurationMs": 5213,
    "segs": [ {
      "utf8": "네, 그리고 그게 훨씬 더 쫀득쫀득한 느낌이에요, 꿀떡이"
    } ]
  }, {
    "tStartMs": 826283,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "아, 그렇구나"
    } ]
  }, {
    "tStartMs": 828035,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "그래서 혹시나 여기 추석 시즌에 오시는 분들은"
    } ]
  }, {
    "tStartMs": 831997,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "송편도 한번 먹어볼만하고"
    } ]
  }, {
    "tStartMs": 833999,
    "dDurationMs": 5256,
    "segs": [ {
      "utf8": "꿀떡도 진짜 맛있는거 먹어보고 싶으면 전 추천드립니다"
    } ]
  }, {
    "tStartMs": 839255,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "어 그리고 들은건데"
    } ]
  }, {
    "tStartMs": 840506,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "그렇게 소나무 잎, 솔잎 위에 올려서 찌는 이유가"
    } ]
  }, {
    "tStartMs": 845344,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "그거래요 덜 상하게 해준대요 음식이"
    } ]
  }, {
    "tStartMs": 848848,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "뭔가 피톤치드가 나온다나? 스팀 할 때?"
    } ]
  }, {
    "tStartMs": 851976,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "그렇구나~!"
    } ]
  }, {
    "tStartMs": 853435,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "그래서 소나무 잎을 사용한다고 하더라구요"
    } ]
  }, {
    "tStartMs": 857106,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "음~!"
    } ]
  }, {
    "tStartMs": 858899,
    "dDurationMs": 7466,
    "segs": [ {
      "utf8": "그렇게 덜 상하게 하는 이유가 왜일까요?"
    } ]
  }, {
    "tStartMs": 866365,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "우선 떡이 냉장고에 들어가면 맛없거든요?"
    } ]
  }, {
    "tStartMs": 869577,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "아 그렇죠"
    } ]
  }, {
    "tStartMs": 870744,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "그래서 상온에서 보관하려고 그런 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 874123,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "태웅쌤은요?"
    } ]
  }, {
    "tStartMs": 874957,
    "dDurationMs": 5213,
    "segs": [ {
      "utf8": "거기에 숨은 뜻이랄까요? 제 생각에는"
    } ]
  }, {
    "tStartMs": 880170,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "그냥 해서 바로 먹으면"
    } ]
  }, {
    "tStartMs": 882756,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "빨리 상하든 늦게 상하든 상관없지 않습니까?"
    } ]
  }, {
    "tStartMs": 885384,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 886719,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "그 말은 한번 다 한걸 한번에 못 먹는단 말이에요"
    } ]
  }, {
    "tStartMs": 889972,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "아 너무 많아요 그거"
    } ]
  }, {
    "tStartMs": 891348,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "그래서 꼭 추석 끝나고 집에 돌아갈 때"
    } ]
  }, {
    "tStartMs": 895102,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "송편을 챙기고 와요"
    } ]
  }, {
    "tStartMs": 896645,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "맞아"
    } ]
  }, {
    "tStartMs": 897646,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "그 집에 가서 근데 다 버려 안먹어가지고"
    } ]
  }, {
    "tStartMs": 899899,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "그러니까요!"
    } ]
  }, {
    "tStartMs": 902318,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "냉동실 어딘가에 있는데 안먹고"
    } ]
  }, {
    "tStartMs": 904737,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 905863,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 906697,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "이게 진짜 하이퍼 리얼리즘..."
    } ]
  }, {
    "tStartMs": 908866,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "이게 진짜 하이퍼 리얼리즘 추석이에요"
    } ]
  }, {
    "tStartMs": 911160,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "한국문화 팟캐스트입니다"
    } ]
  }, {
    "tStartMs": 913829,
    "dDurationMs": 5339,
    "segs": [ {
      "utf8": "다른 한국 문화 팟캐스트에서는 안 알려줄걸요? (- 못들어요)"
    } ]
  }, {
    "tStartMs": 919168,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "그래서 이제 추석 문화도 많이 바뀌잖아요"
    } ]
  }, {
    "tStartMs": 922588,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "아, 그렇죠"
    } ]
  }, {
    "tStartMs": 923088,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "좀 항상 이렇게 남는 것도 보고"
    } ]
  }, {
    "tStartMs": 925716,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "요즘 사람들이 입맛에 안 맞는 것도 보고 하면서"
    } ]
  }, {
    "tStartMs": 929136,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "요즘은 송편 그냥 조금만 사서 한다거나"
    } ]
  }, {
    "tStartMs": 933474,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "그냥 다른 떡 사서 먹거나"
    } ]
  }, {
    "tStartMs": 935643,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "저희 집은 그렇게 하고 있어요"
    } ]
  }, {
    "tStartMs": 938562,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "저희 집은 아예 안 먹어요"
    } ]
  }, {
    "tStartMs": 940356,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "아, 진짜요?"
    } ]
  }, {
    "tStartMs": 941732,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "저희는 뭐 치킨 시켜 먹어요"
    } ]
  }, {
    "tStartMs": 943651,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "와 ,좋은 집!"
    } ]
  }, {
    "tStartMs": 946236,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "최고"
    } ]
  }, {
    "tStartMs": 947446,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "진짜 좋은 집이다"
    } ]
  }, {
    "tStartMs": 950240,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "올해 추석 계획은 어떻게 되세요?"
    } ]
  }, {
    "tStartMs": 953035,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "올해 추석 계획은 특별한 건 없고"
    } ]
  }, {
    "tStartMs": 957122,
    "dDurationMs": 6465,
    "segs": [ {
      "utf8": "또 누나가 연휴를 맞아 부산에 있는 집으로 와서"
    } ]
  }, {
    "tStartMs": 963587,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "그렇게 그 정도 가족만 모이고"
    } ]
  }, {
    "tStartMs": 966382,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "또 서울에 있는 삼촌 가족이랑"
    } ]
  }, {
    "tStartMs": 970928,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "식사 한 번쯤 할 것 같아요"
    } ]
  }, {
    "tStartMs": 973013,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "음 좋네요"
    } ]
  }, {
    "tStartMs": 975182,
    "dDurationMs": 4963,
    "segs": [ {
      "utf8": "맞아, 그렇게 가족들이 그래도 명절에 한 번씩 얼굴 보죠"
    } ]
  }, {
    "tStartMs": 980145,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 980896,
    "dDurationMs": 5339,
    "segs": [ {
      "utf8": "밥도 먹고 저도 가족들이랑 식사할 것 같아요, 이번 추석에는"
    } ]
  }, {
    "tStartMs": 986235,
    "dDurationMs": 5338,
    "segs": [ {
      "utf8": "아 디디님 가족, 아니 그 추석은"
    } ]
  }, {
    "tStartMs": 991573,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "그러면 사촌, 친척들 안 본 지 좀 됐어요?"
    } ]
  }, {
    "tStartMs": 995661,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "아, 저희는 원래 매년 봤는데"
    } ]
  }, {
    "tStartMs": 999456,
    "dDurationMs": 5548,
    "segs": [ {
      "utf8": "매년 보다가 이제 점점 그런 행사를 줄이게 돼가지고"
    } ]
  }, {
    "tStartMs": 1005004,
    "dDurationMs": 5922,
    "segs": [ {
      "utf8": "설날에는 다같이 모이고 추석에는 좀 각자 휴가도 즐기고 하자"
    } ]
  }, {
    "tStartMs": 1010926,
    "dDurationMs": 7716,
    "segs": [ {
      "utf8": "이렇게 얘기가 돼서 이번에는 그냥 가족끼리 있을 것 같습니다"
    } ]
  }, {
    "tStartMs": 1018642,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "아 그렇죠"
    } ]
  }, {
    "tStartMs": 1020686,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "그거 오디세우스 영화 봤다고 했죠?"
    } ]
  }, {
    "tStartMs": 1023647,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "봤어요"
    } ]
  }, {
    "tStartMs": 1025065,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "스포일러 잠깐 하겠습니다"
    } ]
  }, {
    "tStartMs": 1027526,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "스포일러, 스포일러 주의"
    } ]
  }, {
    "tStartMs": 1029028,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "네, 잠깐 건너뛰기 해주세요 한 30초?"
    } ]
  }, {
    "tStartMs": 1032072,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "그렇게 중요한 건 아닌데"
    } ]
  }, {
    "tStartMs": 1033365,
    "dDurationMs": 5464,
    "segs": [ {
      "utf8": "마지막에 오디세우스가 아내한테 이야기를 하면서"
    } ]
  }, {
    "tStartMs": 1038829,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "이렇게 얘기를 하거든요"
    } ]
  }, {
    "tStartMs": 1041081,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "'우리가 거짓말을 해서"
    } ]
  }, {
    "tStartMs": 1044376,
    "dDurationMs": 4505,
    "segs": [ {
      "utf8": "구리의 시대가 끝나고 철의 시대가 왔다'"
    } ]
  }, {
    "tStartMs": 1048881,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "이렇게 얘기를 하거든요"
    } ]
  }, {
    "tStartMs": 1050883,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "이제 한국도 막 친척들 다 모이고 한복 입고"
    } ]
  }, {
    "tStartMs": 1056263,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "그러는 전통의 시대가 끝나가는 거죠"
    } ]
  }, {
    "tStartMs": 1060476,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "확실히"
    } ]
  }, {
    "tStartMs": 1062811,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "차례 지내고 그런 거"
    } ]
  }, {
    "tStartMs": 1065230,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "그런 거 이제 없어지고 있잖아요"
    } ]
  }, {
    "tStartMs": 1066815,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "맞아요 오히려 이제 좀 자유롭게 휴가도 쓸 수 있으니까"
    } ]
  }, {
    "tStartMs": 1071528,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "추석 전에 뭐 얼굴 보는 가족들도 있고"
    } ]
  }, {
    "tStartMs": 1074448,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "딱 그 추석 시즌에는 여행 가는 가족들도 있고 하죠"
    } ]
  }, {
    "tStartMs": 1078202,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 1079036,
    "dDurationMs": 5589,
    "segs": [ {
      "utf8": "음 그래도 저희 집은 아직 차례 같은 것들을"
    } ]
  }, {
    "tStartMs": 1084625,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "설날에는 지내거든요"
    } ]
  }, {
    "tStartMs": 1085876,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "이거 얘기해 보면 재밌을 거 같은데"
    } ]
  }, {
    "tStartMs": 1088128,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "추석이랑 설날의 가장 큰 차이?"
    } ]
  }, {
    "tStartMs": 1091507,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "뭐라고 생각하세요?"
    } ]
  }, {
    "tStartMs": 1093634,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "사실 저는 잘 모르겠거든요?"
    } ]
  }, {
    "tStartMs": 1097596,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "제가 어릴 때, 초등학생?"
    } ]
  }, {
    "tStartMs": 1101183,
    "dDurationMs": 5505,
    "segs": [ {
      "utf8": "초등학생 때까지는 사촌들이 다 모이고"
    } ]
  }, {
    "tStartMs": 1106688,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "그런 명절 행사를 다 했어요"
    } ]
  }, {
    "tStartMs": 1109983,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "근데 추석 때랑 설때 하는 게"
    } ]
  }, {
    "tStartMs": 1113612,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "딱히 차이가 없었어요"
    } ]
  }, {
    "tStartMs": 1115531,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "아 어떤거 하셨나요"
    } ]
  }, {
    "tStartMs": 1118617,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "일단 한복 입고"
    } ]
  }, {
    "tStartMs": 1121328,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "그리고 제사 하고"
    } ]
  }, {
    "tStartMs": 1125374,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "그리고 추석 때도 똑같이 어른들한테 절 하고"
    } ]
  }, {
    "tStartMs": 1130045,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "용돈 받고"
    } ]
  }, {
    "tStartMs": 1132047,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "그리고 윷놀이 하고?"
    } ]
  }, {
    "tStartMs": 1134049,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "음!"
    } ]
  }, {
    "tStartMs": 1135634,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "그 정도가 다였던 것 같아요"
    } ]
  }, {
    "tStartMs": 1137886,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "맞아 그게 그냥 메인으로 하는 거고"
    } ]
  }, {
    "tStartMs": 1140597,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "조금 생각해보면"
    } ]
  }, {
    "tStartMs": 1142724,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "추석 때는 그 먹는 음식이 좀 다르죠"
    } ]
  }, {
    "tStartMs": 1145727,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "송편 먹고 설날엔 떡국 먹고"
    } ]
  }, {
    "tStartMs": 1148605,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "아 그 정도 다르네요"
    } ]
  }, {
    "tStartMs": 1150649,
    "dDurationMs": 5339,
    "segs": [ {
      "utf8": "다르고 추석에 그 날씨도 달라서 약간 기분? 느낌?"
    } ]
  }, {
    "tStartMs": 1155988,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "이런 게 좀 다른 것 같아요"
    } ]
  }, {
    "tStartMs": 1157739,
    "dDurationMs": 4547,
    "segs": [ {
      "utf8": "설날은 엄청 추워서 막 추워했던 기억이 나고"
    } ]
  }, {
    "tStartMs": 1162286,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "추석은 딱 선선할 때 날씨 좋을 때 했어서"
    } ]
  }, {
    "tStartMs": 1167166,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "좀 더 과일을 많이 먹어요 추석 때는"
    } ]
  }, {
    "tStartMs": 1170127,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "그렇구나"
    } ]
  }, {
    "tStartMs": 1171336,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "네 가을 과일들 맛있는 거 많으니까"
    } ]
  }, {
    "tStartMs": 1174339,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "배나 사과나 감이나 이런 것들"
    } ]
  }, {
    "tStartMs": 1178260,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "대추 이런 거 많이 먹을 수 있고..."
    } ]
  }, {
    "tStartMs": 1181638,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "제가 최근에 밋업 행사를 했는데"
    } ]
  }, {
    "tStartMs": 1185058,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "그때 테마가 추석이었어요"
    } ]
  }, {
    "tStartMs": 1187436,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "그래서 추석 때 하는 다양한 것들 소개해 드리면서"
    } ]
  }, {
    "tStartMs": 1191899,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "또 했던 게 달 보면서 소원 빌기?"
    } ]
  }, {
    "tStartMs": 1195402,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "어우 귀여운 행사네요"
    } ]
  }, {
    "tStartMs": 1197279,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "네 근데 진짜 달이 그땐 없어가지고"
    } ]
  }, {
    "tStartMs": 1200115,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "뭐 판넬 뽑아가지고 소원 적어서 붙이고 이런 거 했는데"
    } ]
  }, {
    "tStartMs": 1205495,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "추석에는 그것도 있어요"
    } ]
  }, {
    "tStartMs": 1206997,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "보름달이 뜨기 때문에 달 보면서"
    } ]
  }, {
    "tStartMs": 1208999,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "소원 비는 그런 활동"
    } ]
  }, {
    "tStartMs": 1212794,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "과거에는 '강강수월래'와 '쥐불놀이'를 했습니다"
    } ]
  }, {
    "tStartMs": 1217090,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "여기서 나오네요"
    } ]
  }, {
    "tStartMs": 1218300,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "'외국인이 가장 신기해할 것 같은 추석문화'"
    } ]
  }, {
    "tStartMs": 1220719,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "'쥐불놀이'ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 1222763,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "뭔데요 쥐불놀이가?"
    } ]
  }, {
    "tStartMs": 1224473,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "쥐불놀이가 사실 왜 하는지 모르겠거든요 저는?"
    } ]
  }, {
    "tStartMs": 1228644,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "저도 잘 모르겠어요"
    } ]
  }, {
    "tStartMs": 1230562,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "노는 거 아니니까 불장난 아니에요 그냥?"
    } ]
  }, {
    "tStartMs": 1233398,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "그쵸 그쵸 불장난인데"
    } ]
  }, {
    "tStartMs": 1235734,
    "dDurationMs": 6381,
    "segs": [ {
      "utf8": "깡통 같은 거를 구해서 거기에 불타는 걸 넣습니다"
    } ]
  }, {
    "tStartMs": 1242115,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "불이 막 타게 해요"
    } ]
  }, {
    "tStartMs": 1244451,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "그리고 그 깡통에 줄 같은 걸 연결해서"
    } ]
  }, {
    "tStartMs": 1248497,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "그거를 막 휙휙휙 막 돌려요"
    } ]
  }, {
    "tStartMs": 1251166,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "막 이렇게 동그라미로"
    } ]
  }, {
    "tStartMs": 1252334,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "네 동그라미"
    } ]
  }, {
    "tStartMs": 1253335,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "그게 원이 막 이렇게 돌잖아요"
    } ]
  }, {
    "tStartMs": 1255754,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "그러면 그 원심력 때문에"
    } ]
  }, {
    "tStartMs": 1258090,
    "dDurationMs": 6173,
    "segs": [ {
      "utf8": "깡통이 이렇게 도는데도 안에서 불타고 있는 게 안 떨어져요"
    } ]
  }, {
    "tStartMs": 1264263,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "그러면서 불씨만 화르륵 화르륵 날리거든요"
    } ]
  }, {
    "tStartMs": 1267266,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "그러면은 무슨, 그 마블영화 닥터스트레인지에서"
    } ]
  }, {
    "tStartMs": 1271937,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "막 이렇게 하잖아요"
    } ]
  }, {
    "tStartMs": 1273605,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "그거 쥐불놀이예요!"
    } ]
  }, {
    "tStartMs": 1277150,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "아 거기서 영감을?"
    } ]
  }, {
    "tStartMs": 1278402,
    "dDurationMs": 5755,
    "segs": [ {
      "utf8": "영화는 이렇게 하는데 이제 한국은 이렇게 막 돌리는거죠"
    } ]
  }, {
    "tStartMs": 1284157,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "그거 나중에 투포환처럼 던지나요?"
    } ]
  }, {
    "tStartMs": 1287160,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "그러진 않을걸요"
    } ]
  }, {
    "tStartMs": 1288453,
    "dDurationMs": 793,
    "segs": [ {
      "utf8": "아닌가?"
    } ]
  }, {
    "tStartMs": 1289246,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "아 그러기도 하나? 모르겠다"
    } ]
  }, {
    "tStartMs": 1292082,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "그러면 안 되겠죠? 불 나니까?"
    } ]
  }, {
    "tStartMs": 1293917,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "큰일 날 거 같은데요?"
    } ]
  }, {
    "tStartMs": 1295043,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "조용히 이제 멈춰서"
    } ]
  }, {
    "tStartMs": 1297087,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "이제 태우고..."
    } ]
  }, {
    "tStartMs": 1300090,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "불놀이네"
    } ]
  }, {
    "tStartMs": 1301425,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 1303385,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "좀 이해해보려고 찾아봤더니"
    } ]
  }, {
    "tStartMs": 1305846,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "이제 농사를 짓고 나서 이제 가을이 되면"
    } ]
  }, {
    "tStartMs": 1308890,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "그런 풀들이 마르잖아요"
    } ]
  }, {
    "tStartMs": 1311977,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "그러면 그 안에 있는 해충,"
    } ]
  }, {
    "tStartMs": 1316064,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "좀 곡식을 갉아먹는 그 곤충들의 알 이런 것들이 있을 수 있는데"
    } ]
  }, {
    "tStartMs": 1320819,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "그런거를 태우기 위해서"
    } ]
  }, {
    "tStartMs": 1323613,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "뭔가 쥐 같은 것도 있을 수 있는데"
    } ]
  }, {
    "tStartMs": 1325824,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "그런것도 다 태우기 위해서 했고"
    } ]
  }, {
    "tStartMs": 1329369,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "그리고 액운을 막아주는, 태워버린다"
    } ]
  }, {
    "tStartMs": 1333373,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "나쁜 기운 같은 걸 태워버린다 하는"
    } ]
  }, {
    "tStartMs": 1336376,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "그런 의미도 있다고는 하는데"
    } ]
  }, {
    "tStartMs": 1338128,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "저도 한 적 없는 것 같아요"
    } ]
  }, {
    "tStartMs": 1340756,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "아~"
    } ]
  }, {
    "tStartMs": 1342132,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "쉬@#$#@ 활ㄹ띾!@#$"
    } ]
  }, {
    "tStartMs": 1346678,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "불놀이가 많네"
    } ]
  }, {
    "tStartMs": 1348680,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "아무래도 농사랑 연관이 많아서"
    } ]
  }, {
    "tStartMs": 1351975,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "그러네요"
    } ]
  }, {
    "tStartMs": 1353226,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "그런가 봐요"
    } ]
  }, {
    "tStartMs": 1354102,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "재밌는 행사이긴 하다 확실히 신기해야 할 문화네요"
    } ]
  }, {
    "tStartMs": 1358148,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "네 맞습니다"
    } ]
  }, {
    "tStartMs": 1359941,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "그리고 또 아까 얘기하셨던 강강수월래는"
    } ]
  }, {
    "tStartMs": 1363528,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "그냥 이렇게 손잡고 동그라미를 만든 다음에"
    } ]
  }, {
    "tStartMs": 1366823,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "한 4~5명? 아니면 더 많으면 더 큰 가족들끼리"
    } ]
  }, {
    "tStartMs": 1371119,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "손 동그랗게 잡고 빙글빙글 도는 거죠 노래 부르면서"
    } ]
  }, {
    "tStartMs": 1376041,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 1377125,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "아 근데 재밌을 것 같아요"
    } ]
  }, {
    "tStartMs": 1381797,
    "dDurationMs": 7799,
    "segs": [ {
      "utf8": "제가 인스타그램 쇼츠... 인스타그램 릴스"
    } ]
  }, {
    "tStartMs": 1389596,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "그거에 좀 특이하고 이상한 게 많이 뜨거든요"
    } ]
  }, {
    "tStartMs": 1394267,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "제 알고리즘에"
    } ]
  }, {
    "tStartMs": 1396103,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "근데 딱 인도네시아인가?"
    } ]
  }, {
    "tStartMs": 1399314,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "인도네시아였나 말레이시아였나 아무튼 인도네시아였을 거에요"
    } ]
  }, {
    "tStartMs": 1402901,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "거기서 그렇게 젊은 사람들이"
    } ]
  }, {
    "tStartMs": 1407781,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "젊은 사람들이 강강수월래 하듯이"
    } ]
  }, {
    "tStartMs": 1410951,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "무슨 수련회 같은데 모여가지고 막 동그라미로 이렇게 모여서"
    } ]
  }, {
    "tStartMs": 1416081,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "그 손을 이렇게 잡고"
    } ]
  }, {
    "tStartMs": 1418834,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "막 무슨 막 일렉트로닉 음악 막 디제이가 막 틀고"
    } ]
  }, {
    "tStartMs": 1422879,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "그거 좋다"
    } ]
  }, {
    "tStartMs": 1423839,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "막 진짜 막 이렇게 무슨 모션을 하면서"
    } ]
  }, {
    "tStartMs": 1428510,
    "dDurationMs": 5255,
    "segs": [ {
      "utf8": "그거를 근데 그 모든 사람들이"
    } ]
  }, {
    "tStartMs": 1433765,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "딱 같은 동작을 막 맞춰서 하는 거예요"
    } ]
  }, {
    "tStartMs": 1437144,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "막 이렇게 맞춰서"
    } ]
  }, {
    "tStartMs": 1440730,
    "dDurationMs": 5631,
    "segs": [ {
      "utf8": "근데 저는 거기 들어가 보고 싶더라고요"
    } ]
  }, {
    "tStartMs": 1446361,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "그 무리의 일원이 되고 싶었구나"
    } ]
  }, {
    "tStartMs": 1448905,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1450240,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "'와 강강수월래 하는 사람들이 이런 기분이었을까?'"
    } ]
  }, {
    "tStartMs": 1454911,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "이렇게..."
    } ]
  }, {
    "tStartMs": 1455829,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "저는 제가 최근에 본 릴스에는 그런 거 있었어요"
    } ]
  }, {
    "tStartMs": 1459124,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "어떤 사람이 버스킹 같은 거 하고 있고"
    } ]
  }, {
    "tStartMs": 1462085,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "그중에서 한 명이 이제 춤을 추기 시작해요, 신나가지고"
    } ]
  }, {
    "tStartMs": 1466173,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "그러니까 한 명이 추기 시작하니까"
    } ]
  }, {
    "tStartMs": 1467799,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "이제 너도 나도 나와가지고 춤추고"
    } ]
  }, {
    "tStartMs": 1470802,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "막 그 완전 축제 분위기 되고 하는 그 릴스를 봤는데"
    } ]
  }, {
    "tStartMs": 1475474,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "뭔가 다 같이 그냥 이렇게 방방 뛰면 더 신나잖아요"
    } ]
  }, {
    "tStartMs": 1479644,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 1480896,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "그런 맥락에서 하는 거 같아요"
    } ]
  }, {
    "tStartMs": 1484149,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "음 아무튼 이제 좀 이해가 되시죠?"
    } ]
  }, {
    "tStartMs": 1486902,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "네 나중에 추석 행사하면 꼭 합시다"
    } ]
  }, {
    "tStartMs": 1489446,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "강강수월래"
    } ]
  }, {
    "tStartMs": 1490489,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "강강수월래 오 좋습니다"
    } ]
  }, {
    "tStartMs": 1492365,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "어 그렇게 쥐불 놀이랑 강강수월래 있었고"
    } ]
  }, {
    "tStartMs": 1494951,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "제가 좀 신기해할 것 같다 한 거가 차례였거든요"
    } ]
  }, {
    "tStartMs": 1499789,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "차례"
    } ]
  }, {
    "tStartMs": 1501124,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "차례 지내는 거"
    } ]
  }, {
    "tStartMs": 1502792,
    "dDurationMs": 6298,
    "segs": [ {
      "utf8": "이거는 뭐 한국 문화 관련된 영상 좀 많이 보신 분들은"
    } ]
  }, {
    "tStartMs": 1509090,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "한번쯤 본적 있을 것 같은데"
    } ]
  }, {
    "tStartMs": 1512135,
    "dDurationMs": 5214,
    "segs": [ {
      "utf8": "이렇게 뭔가 식탁, 낮은 식탁 같은데 다양한 음식 올려놓고"
    } ]
  }, {
    "tStartMs": 1517349,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "그리고 뒤에는 뭐 글자 적혀있는 그런 판 같은거 이렇게 세워 놓고"
    } ]
  }, {
    "tStartMs": 1521603,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "사람들이 거기 보면서 촛불 같은 것도 해 놓고"
    } ]
  }, {
    "tStartMs": 1525440,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "이렇게 절하는 의식이 있어요"
    } ]
  }, {
    "tStartMs": 1530195,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "네, 세레모니가 있습니다"
    } ]
  }, {
    "tStartMs": 1532906,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "네 뭐, 서양의 위자보드 같은 거라고나 할까요?"
    } ]
  }, {
    "tStartMs": 1538036,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "샤머니즘 같은 거"
    } ]
  }, {
    "tStartMs": 1539829,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "샤머니즘이죠 강령술이죠 강령술"
    } ]
  }, {
    "tStartMs": 1543416,
    "dDurationMs": 668,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1544084,
    "dDurationMs": 5297,
    "segs": [ {
      "utf8": "돌아가신 조상님들에게 저희를 잘 봐주세요 하고"
    } ]
  }, {
    "tStartMs": 1549381,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "인사드리는 그런 행사입니다"
    } ]
  }, {
    "tStartMs": 1551508,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 1554928,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "그게 좀 서구권에서는"
    } ]
  }, {
    "tStartMs": 1558431,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "신기하게 보일 수도 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 1560308,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "맞아, 맞아"
    } ]
  }, {
    "tStartMs": 1561017,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "일단 거기 올라간 음식들도 다 이색적이고,"
    } ]
  }, {
    "tStartMs": 1564729,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "그냥 이렇게 절을 한다는 거?"
    } ]
  }, {
    "tStartMs": 1567983,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "이게 저는 어떤 게 특이하다고 생각하냐면"
    } ]
  }, {
    "tStartMs": 1571194,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "좀 시대가 많이 바뀌었잖아요 갑자기"
    } ]
  }, {
    "tStartMs": 1574406,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "근데 이렇게 막 도시에서 스타벅스에서 아메리카노 마시던 사람들이"
    } ]
  }, {
    "tStartMs": 1579244,
    "dDurationMs": 5756,
    "segs": [ {
      "utf8": "갑자기 그날 딱 모여 가지고 전통적인 뭔가를 하는 게"
    } ]
  }, {
    "tStartMs": 1585000,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "좀 신기한 것 같아요"
    } ]
  }, {
    "tStartMs": 1588044,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "그렇긴 하네요 참 문화라는 게 신기합니다"
    } ]
  }, {
    "tStartMs": 1592966,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "맞아"
    } ]
  }, {
    "tStartMs": 1593550,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "그래서 추석 음식이 송편도 있는데"
    } ]
  }, {
    "tStartMs": 1596344,
    "dDurationMs": 5172,
    "segs": [ {
      "utf8": "그리고 또 빼놓을 수 없는 게 전이 있어요 전"
    } ]
  }, {
    "tStartMs": 1601516,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "전을 부쳐먹고"
    } ]
  }, {
    "tStartMs": 1603310,
    "dDurationMs": 7007,
    "segs": [ {
      "utf8": "막 전 부치는 소리 들리고 하는 게 좀 추석 명절의 분위기인데"
    } ]
  }, {
    "tStartMs": 1610317,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "전 좋아하시나요?"
    } ]
  }, {
    "tStartMs": 1612569,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "안 좋아해요"
    } ]
  }, {
    "tStartMs": 1614070,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "단 하나도?"
    } ]
  }, {
    "tStartMs": 1615488,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "단 하나도"
    } ]
  }, {
    "tStartMs": 1619743,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "치킨 좋아하세요?"
    } ]
  }, {
    "tStartMs": 1620827,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1623538,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "아, 근데 전 종류 많잖아요"
    } ]
  }, {
    "tStartMs": 1626374,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "그나마 좀 이거는 있으면 먹겠다"
    } ]
  }, {
    "tStartMs": 1629919,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "아니 전이..."
    } ]
  }, {
    "tStartMs": 1632380,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "오징어전"
    } ]
  }, {
    "tStartMs": 1634674,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "추석 때 먹는 거 오징어전, 생선전 있어요"
    } ]
  }, {
    "tStartMs": 1638470,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "에? 저거 한 번도 못 봤는데"
    } ]
  }, {
    "tStartMs": 1640513,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "아 진짜?"
    } ]
  }, {
    "tStartMs": 1641765,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "왜? 맛있어요?"
    } ]
  }, {
    "tStartMs": 1642682,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "생선전 어 괜찮아요"
    } ]
  }, {
    "tStartMs": 1644934,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "그게 명태인가? 그런 걸로 알고 있고요"
    } ]
  }, {
    "tStartMs": 1649689,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "생태인가 모르겠네 아무튼 그거고"
    } ]
  }, {
    "tStartMs": 1653360,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "어 육전 전 육전 좋아해요"
    } ]
  }, {
    "tStartMs": 1656363,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "아 육전?"
    } ]
  }, {
    "tStartMs": 1657113,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "아 육전 제 스타일은 아니에요"
    } ]
  }, {
    "tStartMs": 1659491,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "동그랑땡 같은거"
    } ]
  }, {
    "tStartMs": 1661284,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "네 맞아요"
    } ]
  }, {
    "tStartMs": 1664537,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "고추전"
    } ]
  }, {
    "tStartMs": 1665413,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "뭐 호박전"
    } ]
  }, {
    "tStartMs": 1667957,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "김치전!"
    } ]
  }, {
    "tStartMs": 1669125,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "김치전?"
    } ]
  }, {
    "tStartMs": 1670585,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "김치전은 그나마 먹을만하다?"
    } ]
  }, {
    "tStartMs": 1673088,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "괜찮은거 같아요?"
    } ]
  }, {
    "tStartMs": 1674589,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1676132,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "그것도, 그것도 바싹! 구워야"
    } ]
  }, {
    "tStartMs": 1679010,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "바싹 기름에 튀기는 것처럼 만든 김치전이요?"
    } ]
  }, {
    "tStartMs": 1683682,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1685892,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "김치전 맛있죠"
    } ]
  }, {
    "tStartMs": 1687435,
    "dDurationMs": 5422,
    "segs": [ {
      "utf8": "저는 김치를 별로 안 좋아해가지고 그렇게 좋아하는 음식은 아닌데"
    } ]
  }, {
    "tStartMs": 1692857,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "어 추석에도 김치전은 안 먹어요 잘 그쵸?"
    } ]
  }, {
    "tStartMs": 1697570,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "맞아요 맞아요 좀 담백한 전을 먹지 않나?"
    } ]
  }, {
    "tStartMs": 1702242,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1703034,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "'전'은 간단하게 얘기하면"
    } ]
  }, {
    "tStartMs": 1705704,
    "dDurationMs": 5547,
    "segs": [ {
      "utf8": "밀가루랑 ...밀가루를 묻힌 다음에 계란에 담가서"
    } ]
  }, {
    "tStartMs": 1711251,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "기름에 굽는 거에요"
    } ]
  }, {
    "tStartMs": 1713253,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "그래서 아까 얘기했던 뭐 생선전 이라고 하면"
    } ]
  }, {
    "tStartMs": 1717132,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "생선 살을 밀가루 묻히고"
    } ]
  }, {
    "tStartMs": 1720510,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "계란 물 넣은 다음에 구워요"
    } ]
  }, {
    "tStartMs": 1723972,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "그게 생선전이에요"
    } ]
  }, {
    "tStartMs": 1726975,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "이렇게 이해해주시면 될 것 같습니다"
    } ]
  }, {
    "tStartMs": 1729018,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "안 좋아하시는군요"
    } ]
  }, {
    "tStartMs": 1730186,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "저도 딱히 안 좋아해요"
    } ]
  }, {
    "tStartMs": 1731980,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "한두 개 먹어요 이런 거 하면"
    } ]
  }, {
    "tStartMs": 1735024,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "그렇습니다 그러면 이제 마지막으로"
    } ]
  }, {
    "tStartMs": 1737569,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "추석선물 이야기 해보면 좋을 것 같은데"
    } ]
  }, {
    "tStartMs": 1741990,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "태웅쌤은 한우 세트라고 하셨고,"
    } ]
  }, {
    "tStartMs": 1745160,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "저는 스팸을 얘기했습니다"
    } ]
  }, {
    "tStartMs": 1747954,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "이게 추석 선물이 보통 회사 다니시는 분들이 많이 받죠?"
    } ]
  }, {
    "tStartMs": 1752876,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1754586,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "그래서 받을 일이 없죠, 저희는?"
    } ]
  }, {
    "tStartMs": 1757297,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "저희는 뭐, 없죠"
    } ]
  }, {
    "tStartMs": 1759299,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "잘 없죠?"
    } ]
  }, {
    "tStartMs": 1760550,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1762135,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "어떤 거 받는 거 같아요, 주변에 봤을 때는?"
    } ]
  }, {
    "tStartMs": 1764804,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "주변에 봤을 때…"
    } ]
  }, {
    "tStartMs": 1767432,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "그렇게 스팸이랑 참치 캔 섞여있는 선물세트"
    } ]
  }, {
    "tStartMs": 1772812,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "캔 세트?"
    } ]
  }, {
    "tStartMs": 1774355,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "네 아니면은 제가 얘기한 고기 세트"
    } ]
  }, {
    "tStartMs": 1778818,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "그거 말고는 딱히 없는 것 같은데 아니면은"
    } ]
  }, {
    "tStartMs": 1782489,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "옛날에는 저는 추석 때"
    } ]
  }, {
    "tStartMs": 1785825,
    "dDurationMs": 6840,
    "segs": [ {
      "utf8": "그 다니던 뭐 알바? 알바인데 회사처럼 챙겨주는 곳이 있었어요"
    } ]
  }, {
    "tStartMs": 1792665,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "거기서는"
    } ]
  }, {
    "tStartMs": 1795919,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "막 샴푸랑 치약 뭐 이런 생활용품 세트를 받은 적이 있어요"
    } ]
  }, {
    "tStartMs": 1800298,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "맞아요 그런 세트 주기도 하죠"
    } ]
  }, {
    "tStartMs": 1803051,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "네네"
    } ]
  }, {
    "tStartMs": 1803968,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "어, 이것도 줘요 기름 세트?"
    } ]
  }, {
    "tStartMs": 1806346,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "아, 맞아요 맞아요"
    } ]
  }, {
    "tStartMs": 1807597,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "그쵸 뭐 올리브유, 식용유,"
    } ]
  }, {
    "tStartMs": 1809724,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "종류별로 해바라기씨유, 포도씨유,"
    } ]
  }, {
    "tStartMs": 1812393,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "막 이런 기름 들어있는 거"
    } ]
  }, {
    "tStartMs": 1814187,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "그것도 옛날에는 이렇게 전 부쳐 먹으니까"
    } ]
  }, {
    "tStartMs": 1817774,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "그때 쓰라고 이렇게 주는 거고"
    } ]
  }, {
    "tStartMs": 1821486,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "과일 바구니? 같은 거 주는 곳도 있더라고요?"
    } ]
  }, {
    "tStartMs": 1824656,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "그런 것도 있네요 맞네요"
    } ]
  }, {
    "tStartMs": 1826032,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "네 또 가을이 그거잖아요"
    } ]
  }, {
    "tStartMs": 1829285,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "농작물을 수확하는 시기니까"
    } ]
  }, {
    "tStartMs": 1832664,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "아까 얘기했던 사과, 배, 감 이런 과일들?"
    } ]
  }, {
    "tStartMs": 1837126,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "그렇게 추석 선물을 받더라~"
    } ]
  }, {
    "tStartMs": 1840255,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "다들 회사 다니는 친구들은~"
    } ]
  }, {
    "tStartMs": 1843466,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "뭐, 우리도 기분 내게"
    } ]
  }, {
    "tStartMs": 1845009,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "서로 스팸 한 세트 챙겨줄까요? / - 아 그럴까요?"
    } ]
  }, {
    "tStartMs": 1849931,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그럴까요?"
    } ]
  }, {
    "tStartMs": 1852141,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "맞네 그렇게도 주죠"
    } ]
  }, {
    "tStartMs": 1854394,
    "dDurationMs": 4337,
    "segs": [ {
      "utf8": "주변에 좀 좋은 사람들한테 보내주기도 해요"
    } ]
  }, {
    "tStartMs": 1858731,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "그러기도 합니다 딱 이럴 때"
    } ]
  }, {
    "tStartMs": 1860942,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "이런 추석이나 설에"
    } ]
  }, {
    "tStartMs": 1865113,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "애들은"
    } ]
  }, {
    "tStartMs": 1867907,
    "dDurationMs": 5756,
    "segs": [ {
      "utf8": "집안 어르신들한테 한 명씩 한 명씩 이렇게 딱 절을 합니다"
    } ]
  }, {
    "tStartMs": 1873663,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1874455,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "'복 많이 받으세요 삼촌' 이렇게"
    } ]
  }, {
    "tStartMs": 1877083,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "'할머니 할아버지' 이렇게 그렇게 하면..."
    } ]
  }, {
    "tStartMs": 1878960,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "'오래 사세요'"
    } ]
  }, {
    "tStartMs": 1879961,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "네 그렇게 하면 딱 준비된 봉투를 꺼내서 딱 주십니다"
    } ]
  }, {
    "tStartMs": 1883923,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1885300,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "거기에는 용돈이 들어있죠"
    } ]
  }, {
    "tStartMs": 1887093,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "그쵸 그쵸 그쵸"
    } ]
  }, {
    "tStartMs": 1889387,
    "dDurationMs": 5422,
    "segs": [ {
      "utf8": "그게... 참 좋았어요 저는"
    } ]
  }, {
    "tStartMs": 1894809,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "그쵸 추석 완전히 파티였죠"
    } ]
  }, {
    "tStartMs": 1897687,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "너무 좋았죠"
    } ]
  }, {
    "tStartMs": 1898771,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "네 학교도 안 가지, 돈도 받지..."
    } ]
  }, {
    "tStartMs": 1902942,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "근데 이제는 약간 드리는 나이가 됐잖아요 용돈을"
    } ]
  }, {
    "tStartMs": 1907530,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "드리는? 누구한테요?"
    } ]
  }, {
    "tStartMs": 1910241,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "뭔가 부모님이나 뭐 할머니 계시면 할머니나"
    } ]
  }, {
    "tStartMs": 1914370,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "아니면 전 지금 없지만 나중에 뭐 조카나"
    } ]
  }, {
    "tStartMs": 1918416,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "좀 어린 친구들이 생기면 줘야 되고"
    } ]
  }, {
    "tStartMs": 1921044,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "맞아요 맞아요"
    } ]
  }, {
    "tStartMs": 1923546,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "그래서 저는.."
    } ]
  }, {
    "tStartMs": 1927175,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "제가 어릴 때는 그렇게 막 다 모든 친척들이 모였었는데"
    } ]
  }, {
    "tStartMs": 1931137,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "지금은 안 모이잖아요"
    } ]
  }, {
    "tStartMs": 1933306,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "나쁘지 않다 생각해요"
    } ]
  }, {
    "tStartMs": 1936809,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "아, 태웅쌤한테만 좋은 일 됐네요?"
    } ]
  }, {
    "tStartMs": 1940188,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1941606,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "나는 받고 이제 여기서 끝*^^*"
    } ]
  }, {
    "tStartMs": 1943942,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "네 네"
    } ]
  }, {
    "tStartMs": 1945443,
    "dDurationMs": 5464,
    "segs": [ {
      "utf8": "저는 그래도 이제 부모님 용돈 드려야지 하는 생각이.."
    } ]
  }, {
    "tStartMs": 1950907,
    "dDurationMs": 5422,
    "segs": [ {
      "utf8": "어? 근데 저 아직도 부모님이 주시는 것 같아요 주시네!"
    } ]
  }, {
    "tStartMs": 1956329,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "그러니까 서로 좀 줘요, 이제는"
    } ]
  }, {
    "tStartMs": 1960500,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "음 그냥 뭐 명절이니까"
    } ]
  }, {
    "tStartMs": 1963503,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "기분 좋게 주시는 것 같습니다"
    } ]
  }, {
    "tStartMs": 1966839,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "이게 또 외국에서 보면 신기한 문화일 수도 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 1971094,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "돈을 주고 받고 / - 그렇네요"
    } ]
  }, {
    "tStartMs": 1972845,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "돈 주고 하고..."
    } ]
  }, {
    "tStartMs": 1975056,
    "dDurationMs": 6506,
    "segs": [ {
      "utf8": "부모님들 선물로 홍삼 이런 것도 많이 주는 것 같아요"
    } ]
  }, {
    "tStartMs": 1981562,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "맞습니다 몸에 좋은 거"
    } ]
  }, {
    "tStartMs": 1984524,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "건강 음식, 건강식품?"
    } ]
  }, {
    "tStartMs": 1986818,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "음..."
    } ]
  }, {
    "tStartMs": 1988319,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "근데 뭐 지금 디디님은 부모님이랑 좀 떨어져 살아서"
    } ]
  }, {
    "tStartMs": 1993032,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "뭐 그럴 수도 있고..."
    } ]
  }, {
    "tStartMs": 1995660,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "근데 저는 같이 살아서"
    } ]
  }, {
    "tStartMs": 1997412,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "음..."
    } ]
  }, {
    "tStartMs": 1998830,
    "dDurationMs": 5297,
    "segs": [ {
      "utf8": "뭐.. 고기 한 상자, 홍삼 한 상자보다"
    } ]
  }, {
    "tStartMs": 2004127,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "말벗이 되어주는 것"
    } ]
  }, {
    "tStartMs": 2006087,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "그것이 진정한 선물이 아닐까 생각합니다"
    } ]
  }, {
    "tStartMs": 2009340,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "ㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 2010591,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "어? 어머니 의견도 여쭤보고 싶은데요?"
    } ]
  }, {
    "tStartMs": 2015179,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "그건 모르고요 그거는"
    } ]
  }, {
    "tStartMs": 2018474,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "어 그렇다고 합니다"
    } ]
  }, {
    "tStartMs": 2020977,
    "dDurationMs": 5047,
    "segs": [ {
      "utf8": "그게 저도 진정한 효라고 생각해요"
    } ]
  }, {
    "tStartMs": 2026024,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "같이 서로 이렇게 얘기도 하고 하는 거"
    } ]
  }, {
    "tStartMs": 2029527,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "그걸 많이 해둬야 나중에 후회 안 해요"
    } ]
  }, {
    "tStartMs": 2031988,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "시간을 많이 보내는 게 좀 좋죠"
    } ]
  }, {
    "tStartMs": 2034782,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "저는 그게 사실 제일이라고 생각합니다"
    } ]
  }, {
    "tStartMs": 2038786,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "그치만 이제 선물까지 플러스 되면은"
    } ]
  }, {
    "tStartMs": 2042206,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "너무 좋아하시죠"
    } ]
  }, {
    "tStartMs": 2043499,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "아 그렇죠"
    } ]
  }, {
    "tStartMs": 2044125,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "그럼 또 그런거 받으시면 / - 너무 좋죠"
    } ]
  }, {
    "tStartMs": 2046419,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "\"아 이런걸 샀어~\" 하면서"
    } ]
  }, {
    "tStartMs": 2048588,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "이제 다른 모임가서 얘기한다고요"
    } ]
  }, {
    "tStartMs": 2051716,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "\"아 이런거를 주더라고~\""
    } ]
  }, {
    "tStartMs": 2055178,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 2056596,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "아무튼 이거 듣고 계시는 구독자 분들도"
    } ]
  }, {
    "tStartMs": 2060099,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "그냥 한국에서 듣고 계시는 분들은"
    } ]
  }, {
    "tStartMs": 2062268,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "또 가족이 멀리 떨어져 있는 상황에서"
    } ]
  }, {
    "tStartMs": 2065438,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "좀 쓸쓸한 추석이 될 수도 있을 것 같고"
    } ]
  }, {
    "tStartMs": 2068316,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "왜냐면 그때 가게들 다 문 닫고 쉬는 곳들도 많거든요"
    } ]
  }, {
    "tStartMs": 2072737,
    "dDurationMs": 4629,
    "segs": [ {
      "utf8": "그런데 그냥 이제 달 보면서 소원도 빌어보고"
    } ]
  }, {
    "tStartMs": 2077366,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "그리고 태웅쌤도 치킨 드신다고 하니까"
    } ]
  }, {
    "tStartMs": 2079786,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "맛있는 음식 그냥 시켜가지고"
    } ]
  }, {
    "tStartMs": 2083081,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "잘... 풍성한 한가위 보내셨으면 좋겠습니다"
    } ]
  }, {
    "tStartMs": 2088461,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "그리고 또 얼마 전에"
    } ]
  }, {
    "tStartMs": 2090922,
    "dDurationMs": 9259,
    "segs": [ {
      "utf8": "무슨 한국을 좋아하는 무슨 외국인 코미디언이 올린"
    } ]
  }, {
    "tStartMs": 2100181,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "인스타그램 릴스 이런 걸 봤는데,"
    } ]
  }, {
    "tStartMs": 2103017,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "그런 용어가 있더라고요"
    } ]
  }, {
    "tStartMs": 2104268,
    "dDurationMs": 3838,
    "segs": [ {
      "utf8": "Korean Dad, 한국 아빠"
    } ]
  }, {
    "tStartMs": 2108106,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "아, 근데 제 친한 외국인 애들도"
    } ]
  }, {
    "tStartMs": 2111776,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "가끔 그런 말을 할 때가 있거든요"
    } ]
  }, {
    "tStartMs": 2113736,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "한국 이모, 이렇게"
    } ]
  }, {
    "tStartMs": 2116531,
    "dDurationMs": 6339,
    "segs": [ {
      "utf8": "그러니까 한국에 와서 살면서 엄마나 이모처럼 대하는 존재"
    } ]
  }, {
    "tStartMs": 2122870,
    "dDurationMs": 6090,
    "segs": [ {
      "utf8": "도움을 받으면서 한국 아버지 같은 존재, 이렇게"
    } ]
  }, {
    "tStartMs": 2128960,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "그래서 혹시 그런 분들이 있다면,"
    } ]
  }, {
    "tStartMs": 2133131,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "뭐 제가 얘기 안 해도"
    } ]
  }, {
    "tStartMs": 2134674,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "이렇게 추석 맞이로 또 인사하고"
    } ]
  }, {
    "tStartMs": 2137593,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "또 뜻깊은 시간 가질 수 있을 것 같고요"
    } ]
  }, {
    "tStartMs": 2141514,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "맞아"
    } ]
  }, {
    "tStartMs": 2142390,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "네, 만약에 그런 연고가 없는 분들은"
    } ]
  }, {
    "tStartMs": 2145393,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "제가 나이가 서른 넷이거든요"
    } ]
  }, {
    "tStartMs": 2148354,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "저를 한국 아빠라고 생각하고,"
    } ]
  }, {
    "tStartMs": 2150857,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "와~!"
    } ]
  }, {
    "tStartMs": 2152108,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "뭐 홍삼 세트나 소고기 세트(?)"
    } ]
  }, {
    "tStartMs": 2154986,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "이런 거 좀 보내도 되니까요"
    } ]
  }, {
    "tStartMs": 2156654,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "ㅋㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 2157738,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "아니, 말벗이 되어주는 게 최고라면서요?"
    } ]
  }, {
    "tStartMs": 2162368,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "바로 홍삼세트 얘기해버리네?"
    } ]
  }, {
    "tStartMs": 2166831,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "둘다 둘다 좋죠 둘다"
    } ]
  }, {
    "tStartMs": 2168124,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "말벗이 되는 것도 좋고"
    } ]
  }, {
    "tStartMs": 2169667,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "네네네 진짜"
    } ]
  }, {
    "tStartMs": 2171586,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "농담입니다 농담"
    } ]
  }, {
    "tStartMs": 2172628,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "네 아 무슨 말씀이신지 알겠어요"
    } ]
  }, {
    "tStartMs": 2175840,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "맞아 주변에 이럴 때 저희 한국에서는 좀 감사한 분들한테"
    } ]
  }, {
    "tStartMs": 2180344,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "인사를 전하기도 하니까"
    } ]
  }, {
    "tStartMs": 2182263,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "그렇게 보내보셔도 좋을 것 같아요"
    } ]
  }, {
    "tStartMs": 2185600,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "안 그래도 제가 며칠 전에 라이브 하는데 그런 얘기를 했었어요"
    } ]
  }, {
    "tStartMs": 2190188,
    "dDurationMs": 6006,
    "segs": [ {
      "utf8": "저한테는 일본어 아버지 일본어 어머니가 있다 이런 얘기를 했었거든요"
    } ]
  }, {
    "tStartMs": 2196194,
    "dDurationMs": 5922,
    "segs": [ {
      "utf8": "왜냐면 제가 항상 그 여자분 한 분 남자분 한 분 컨텐츠를 보면서"
    } ]
  }, {
    "tStartMs": 2202116,
    "dDurationMs": 6632,
    "segs": [ {
      "utf8": "어... 언어를 배우다 보니까 저한테는 그분들이 어머니 아버지 인거예요"
    } ]
  }, {
    "tStartMs": 2208748,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "물론 두 분은 아무 관계가 아니지만"
    } ]
  }, {
    "tStartMs": 2211417,
    "dDurationMs": 4505,
    "segs": [ {
      "utf8": "여러분들도 어머니 아버지가 있다는거"
    } ]
  }, {
    "tStartMs": 2215922,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "알아두셨으면 좋겠습니다"
    } ]
  }, {
    "tStartMs": 2218883,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "저는 고기 좋아합니다 참고로"
    } ]
  }, {
    "tStartMs": 2221260,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "소고기 소고기?"
    } ]
  }, {
    "tStartMs": 2222678,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "아 뭐 뭐든"
    } ]
  }, {
    "tStartMs": 2224305,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "아, 뭐든 모든 고기?"
    } ]
  }, {
    "tStartMs": 2225723,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "과일도 좋아하고요"
    } ]
  }, {
    "tStartMs": 2227141,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "저는 돈이 제일 좋아요"
    } ]
  }, {
    "tStartMs": 2228267,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "ㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 2230311,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "어?"
    } ]
  }, {
    "tStartMs": 2231103,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "사실 나도..."
    } ]
  }, {
    "tStartMs": 2234065,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "다 장난입니다"
    } ]
  }, {
    "tStartMs": 2234857,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "장난이에요 맞아요"
    } ]
  }, {
    "tStartMs": 2237443,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "농담~"
    } ]
  }, {
    "tStartMs": 2238486,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "네네 농담입니다 농담"
    } ]
  }, {
    "tStartMs": 2240196,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "네 그러면 이제 마무리해봅시다"
    } ]
  }, {
    "tStartMs": 2242281,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "어? 퀴즈! 이번에도 내보면"
    } ]
  }, {
    "tStartMs": 2245826,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "이걸로 해보겠습니다"
    } ]
  }, {
    "tStartMs": 2247411,
    "dDurationMs": 6298,
    "segs": [ {
      "utf8": "한국의 추석 때 하거나 했던 놀이가 아닌 것은? 입니다"
    } ]
  }, {
    "tStartMs": 2253709,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "1번, 쥐불 놀이"
    } ]
  }, {
    "tStartMs": 2256045,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "2번, 윷놀이"
    } ]
  }, {
    "tStartMs": 2258297,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "3번 소꿉놀이입니다"
    } ]
  }, {
    "tStartMs": 2261175,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "정답을 아시는 분은 투표 아니면 댓글로 남겨주시고"
    } ]
  }, {
    "tStartMs": 2266305,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "저번에 댓글도 많이 남겨주신 거 읽어봤으니까"
    } ]
  }, {
    "tStartMs": 2270268,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "이번에도 좀 재밌었던 포인트나"
    } ]
  }, {
    "tStartMs": 2272687,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "얘기하고 싶은 포인트 있으면 남겨주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 2277191,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "자 다음 주제 또 정해봐야 되는데요"
    } ]
  }, {
    "tStartMs": 2280486,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "다음은 10월이고요"
    } ]
  }, {
    "tStartMs": 2282196,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "어떤 게 좋을까요?"
    } ]
  }, {
    "tStartMs": 2284240,
    "dDurationMs": 5255,
    "segs": [ {
      "utf8": "10월... 10월은 제 생일이 있는 달이죠"
    } ]
  }, {
    "tStartMs": 2289495,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "생일 갈까요?"
    } ]
  }, {
    "tStartMs": 2290955,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "생일 그럴까요?"
    } ]
  }, {
    "tStartMs": 2292206,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2293457,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "아 이거 엎드려 절 받기 좀 그런데"
    } ]
  }, {
    "tStartMs": 2296127,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "\"와~! 태웅쌤의 생일이에요\" 하면서 시작해야 되겠다"
    } ]
  }, {
    "tStartMs": 2299297,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "어떤 아 며칠이에요? 10월..."
    } ]
  }, {
    "tStartMs": 2301799,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "저 10월 14일이에요"
    } ]
  }, {
    "tStartMs": 2303968,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "아 좋습니다 좋습니다"
    } ]
  }, {
    "tStartMs": 2306846,
    "dDurationMs": 4796,
    "segs": [ {
      "utf8": "그러면 다음 달에는 태웅쌤 생일도 있으니까"
    } ]
  }, {
    "tStartMs": 2311642,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "생일에 대해서 요모조모 이야기해 보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 2315813,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "그 좀 얘기가 철학적이고 깊어질 수도 있어요"
    } ]
  }, {
    "tStartMs": 2319150,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "아 뭐 얘기하고 싶은 게 생각이 나시나요?"
    } ]
  }, {
    "tStartMs": 2322028,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "아 제가 항상 생일에 대해 가지고 있는 생각이 있기 때문에"
    } ]
  }, {
    "tStartMs": 2325239,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "오 좋아요"
    } ]
  }, {
    "tStartMs": 2326907,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "그 생각 까먹지 마시고 들고 와 주세요"
    } ]
  }, {
    "tStartMs": 2330286,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "알겠습니다"
    } ]
  }, {
    "tStartMs": 2331245,
    "dDurationMs": 6507,
    "segs": [ {
      "utf8": "네 그러면 저희는 다음 달에 또 요모조모 재밌는 이야기해 보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 2337752,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "여기까지 디디와"
    } ]
  }, {
    "tStartMs": 2339503,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "정태웅이었습니다 감사합니다"
    } ]
  }, {
    "tStartMs": 2341130,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "감사합니다"
    } ]
  } ]
}
