{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 9470,
    "segs": [ {
      "utf8": "\u003c디디와 정태웅의 한국생활 요모조모\u003e"
    } ]
  }, {
    "tStartMs": 9470,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "안녕하세요 디디입니다"
    } ]
  }, {
    "tStartMs": 11900,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "안녕하세요 정태웅입니다"
    } ]
  }, {
    "tStartMs": 13590,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "한국생활 요모조모는 한국에서 살아가는 두 사람이"
    } ]
  }, {
    "tStartMs": 16970,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "한국생활의 요모조모를 이야기하는 팟캐스트입니다"
    } ]
  }, {
    "tStartMs": 20660,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "오늘 선택한 키워드는요 어떤 거였죠?"
    } ]
  }, {
    "tStartMs": 24110,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "오늘 선택한 키워드는 '공항'입니다"
    } ]
  }, {
    "tStartMs": 27150,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "공항...에 대해서 이야기하기 전에"
    } ]
  }, {
    "tStartMs": 31220,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "그동안 어떻게 지내셨나요?"
    } ]
  }, {
    "tStartMs": 33900,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "그동안 저는 굉장히 많은 일이 있었는데요"
    } ]
  }, {
    "tStartMs": 38210,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "새해 목표, 지난번에 제 채널에서 얘기했던"
    } ]
  }, {
    "tStartMs": 41840,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "새해 목표들을 하나씩 하나씩 실현하고 있는 중입니다"
    } ]
  }, {
    "tStartMs": 45080,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "몇 가지 완료했죠?"
    } ]
  }, {
    "tStartMs": 47690,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "완료를 한 건 하나인데요"
    } ]
  }, {
    "tStartMs": 52790,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "제가 부자가 되기 위한 비밀이었던,"
    } ]
  }, {
    "tStartMs": 57660,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "웹사이트를 드디어 완성을 했고요"
    } ]
  }, {
    "tStartMs": 62340,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "그리고 또 완성은 아직 못한 목표지만"
    } ]
  }, {
    "tStartMs": 67410,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "노래 만들기를..."
    } ]
  }, {
    "tStartMs": 69360,
    "dDurationMs": 6770,
    "segs": [ {
      "utf8": "제 구독자분 중에 한 분이 가사를 쓰는 걸 굉장히 잘 도와주고 계셔서"
    } ]
  }, {
    "tStartMs": 76130,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "비트는 제가 만들고"
    } ]
  }, {
    "tStartMs": 78550,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "진짜 제대로 된 번듯한 노래가 하나 완성되고 있습니다"
    } ]
  }, {
    "tStartMs": 83010,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "번듯한 노래가? KPOP인가요? 뭔가요?"
    } ]
  }, {
    "tStartMs": 87170,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "KPOP은 아니고요"
    } ]
  }, {
    "tStartMs": 89310,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "R\u0026B 힙합이랄까요?"
    } ]
  }, {
    "tStartMs": 91630,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "그러면 노래는 누가 하죠?"
    } ]
  }, {
    "tStartMs": 94110,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "노래는 또 있습니다"
    } ]
  }, {
    "tStartMs": 97330,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "와~ 그러면 웹사이트 하나 오픈하시고"
    } ]
  }, {
    "tStartMs": 100970,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "번듯한 노래까지 지금 만들고 계시는 거예요?"
    } ]
  }, {
    "tStartMs": 104560,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "그렇지요"
    } ]
  }, {
    "tStartMs": 105410,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "웹사이트는 어떤 거예요? 지금 공개해 주실 수 있나요?"
    } ]
  }, {
    "tStartMs": 108720,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "공개할 수 있는데"
    } ]
  }, {
    "tStartMs": 109640,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "사실... 이게 한국분들한테 특화되는 거라..."
    } ]
  }, {
    "tStartMs": 114210,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "어떤 건데요?"
    } ]
  }, {
    "tStartMs": 116450,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "간단하게 설명을 해드리자면"
    } ]
  }, {
    "tStartMs": 119820,
    "dDurationMs": 6140,
    "segs": [ {
      "utf8": "외국 분들, 서양 분들한테 익숙하실 imdb 같은 사이트인데요"
    } ]
  }, {
    "tStartMs": 125960,
    "dDurationMs": 8770,
    "segs": [ {
      "utf8": "그 imdb가 영화들의 별점, 평점을 매기고 그리고 한 줄 평,"
    } ]
  }, {
    "tStartMs": 134730,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "코멘트를 쓸 수 있는데요"
    } ]
  }, {
    "tStartMs": 137570,
    "dDurationMs": 6110,
    "segs": [ {
      "utf8": "저는 그걸 한국 과자들에 할 수 있도록 사이트를 만들었어요"
    } ]
  }, {
    "tStartMs": 143680,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "한국 과자 버전 imdb 느낌이네요"
    } ]
  }, {
    "tStartMs": 147900,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 149150,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "그러면 과자들의 평점을 주고 리뷰를 남기고..."
    } ]
  }, {
    "tStartMs": 153110,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "과연 과자를 좋아하시는,"
    } ]
  }, {
    "tStartMs": 155440,
    "dDurationMs": 7160,
    "segs": [ {
      "utf8": "과자 먹기가 취미인 태웅쌤이 만들 것 같은 재밌는 사이트인 것 같은데"
    } ]
  }, {
    "tStartMs": 162600,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "오픈하고 어떤가요? 오픈하고 나니까"
    } ]
  }, {
    "tStartMs": 166720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "아직은 홍보를 따로 안 했거든요"
    } ]
  }, {
    "tStartMs": 170080,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "그리고 오픈을 해도 업데이트 할 것들이 많더라고요"
    } ]
  }, {
    "tStartMs": 174640,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "그래서 자잘한 고쳐야 할 것들을 계속 고치다가"
    } ]
  }, {
    "tStartMs": 179940,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "글쎄요 홍보를 하기는 해야겠다 싶어서"
    } ]
  }, {
    "tStartMs": 183760,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "제가 종종 언급했던 제가 엄청 좋아하는 유튜버인"
    } ]
  }, {
    "tStartMs": 188270,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "침착맨 님이 하시는 개인 웹사이트가 있는데"
    } ]
  }, {
    "tStartMs": 194340,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "거기에 구독자들이 침착맨 님께"
    } ]
  }, {
    "tStartMs": 198300,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "'침착맨님, 이거 해주세요'"
    } ]
  }, {
    "tStartMs": 199770,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "'이 게임 해주세요'"
    } ]
  }, {
    "tStartMs": 201240,
    "dDurationMs": 5170,
    "segs": [ {
      "utf8": "'이 이야기 해주세요' 하는 요청 게시판이 있어요"
    } ]
  }, {
    "tStartMs": 206410,
    "dDurationMs": 6910,
    "segs": [ {
      "utf8": "그래서 거기에 제 웹사이트를 좀 써서 요청을 해봤거든요"
    } ]
  }, {
    "tStartMs": 213320,
    "dDurationMs": 8800,
    "segs": [ {
      "utf8": "그리고 제가 아까 얘기한 과자에 평점을 매기고 평가를 하는 거 외에도"
    } ]
  }, {
    "tStartMs": 222120,
    "dDurationMs": 7450,
    "segs": [ {
      "utf8": "과자 내용물만 보고 이게 무슨 과자인지 이름 맞추는 게임,"
    } ]
  }, {
    "tStartMs": 229570,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "과자에 그려져 있는 캐릭터 이름 맞추기 게임"
    } ]
  }, {
    "tStartMs": 232600,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "이런 것도 있어요"
    } ]
  }, {
    "tStartMs": 235330,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "그래서 그거 콘텐츠로 해달라고 요청 글을 썼는데"
    } ]
  }, {
    "tStartMs": 239160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "오늘 썼거든요"
    } ]
  }, {
    "tStartMs": 241500,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "근데 지금 우리가 일요일에 녹화하고 있잖아요"
    } ]
  }, {
    "tStartMs": 245880,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "그래서 평일에 그 글을 볼 수도 있겠죠?"
    } ]
  }, {
    "tStartMs": 249610,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "기대된다 봐줬으면"
    } ]
  }, {
    "tStartMs": 252510,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "근데 저는 별 기대 안 하고 올렸는데"
    } ]
  }, {
    "tStartMs": 257350,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그 글에 다른 회원들이"
    } ]
  }, {
    "tStartMs": 259630,
    "dDurationMs": 5930,
    "segs": [ {
      "utf8": "다른 구독자분들이 \"이거 재밌겠네요\" 댓글을 달아주시더라고요"
    } ]
  }, {
    "tStartMs": 265560,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "진짜요?"
    } ]
  }, {
    "tStartMs": 266120,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "좀 주목이 끌리고 있는 것 같아요?"
    } ]
  }, {
    "tStartMs": 269310,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "다른 요청글들이 많은데"
    } ]
  }, {
    "tStartMs": 271460,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "그중에 추천을 많이 받은 것 같아요"
    } ]
  }, {
    "tStartMs": 274080,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "대박"
    } ]
  }, {
    "tStartMs": 275160,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "침착맨님 방송에 나가는 거 아니에요? 진짜로?"
    } ]
  }, {
    "tStartMs": 277980,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "진짜 그러면 좋겠네요"
    } ]
  }, {
    "tStartMs": 280390,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "그럼 진짜 뿌듯하겠다"
    } ]
  }, {
    "tStartMs": 282720,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 283540,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그게 재밌어 보이더라고요 게임이"
    } ]
  }, {
    "tStartMs": 285750,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "과자 안에 있는, 진짜 과자 포장지 안에 있는 과자 모양을 보고"
    } ]
  }, {
    "tStartMs": 290200,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "이게 어떤 과자인지 맞추는 건데"
    } ]
  }, {
    "tStartMs": 292250,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "저번에 저희 같이 했을 때"
    } ]
  }, {
    "tStartMs": 293850,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "저 한 10개 중에 3개 겨우 맞췄었단 말이에요 좀 어려워요"
    } ]
  }, {
    "tStartMs": 298000,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "그래서 어이없어요 어이없고 재밌는 게임이었는데"
    } ]
  }, {
    "tStartMs": 302650,
    "dDurationMs": 6730,
    "segs": [ {
      "utf8": "그때 디디님한테 보여드렸을 때는 그 문제가 10개밖에 없었잖아요"
    } ]
  }, {
    "tStartMs": 309380,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "근데 친구들이 10개는 너무 적다고 해서"
    } ]
  }, {
    "tStartMs": 313190,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "제가 과자를 좀 많이 사서"
    } ]
  }, {
    "tStartMs": 316330,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "과자를 한 60개 정도 사서..."
    } ]
  }, {
    "tStartMs": 320690,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "아니다 한 50개 정도 샀네요"
    } ]
  }, {
    "tStartMs": 322730,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "그래서 원래 있던 10개랑 합쳐서 한 60개 정도가 돼서"
    } ]
  }, {
    "tStartMs": 326800,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "문제가 한 60개 정도가 됐습니다"
    } ]
  }, {
    "tStartMs": 330530,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "그 60봉지를 다 뜯으셔서 사진을 찍었구나"
    } ]
  }, {
    "tStartMs": 334170,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 335360,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "엄청난 피 땀 눈물이네요"
    } ]
  }, {
    "tStartMs": 337300,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "그래서 요즘 그 과자들 아직 자주 먹고 있습니다"
    } ]
  }, {
    "tStartMs": 341730,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "진짜 다양한 과자, 안 먹어본 과자들도 있었을 것 같은데요?"
    } ]
  }, {
    "tStartMs": 346340,
    "dDurationMs": 590,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 346930,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "그렇죠?"
    } ]
  }, {
    "tStartMs": 347950,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 348670,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "먹어보고 놀란 것들도 좀 있었어요"
    } ]
  }, {
    "tStartMs": 350870,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "뭐 기억에 남는 거 있어요?"
    } ]
  }, {
    "tStartMs": 352350,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "의외로 별점 좀 크게 주고 싶었던..."
    } ]
  }, {
    "tStartMs": 356240,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "츄러스?"
    } ]
  }, {
    "tStartMs": 357220,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "츄러스 과자?"
    } ]
  }, {
    "tStartMs": 358720,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 358980,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "그거 맛있어요?"
    } ]
  }, {
    "tStartMs": 360280,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "진짜 맛있더라고요"
    } ]
  }, {
    "tStartMs": 361220,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "진짜요? 그거 유행했잖아요, 외국 분들한테"
    } ]
  }, {
    "tStartMs": 364140,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "아, 그래요?"
    } ]
  }, {
    "tStartMs": 364720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "네, 저도 외국인들이 많이 사가길래"
    } ]
  }, {
    "tStartMs": 367760,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "일본분들이 많이 사가는 것 같아요"
    } ]
  }, {
    "tStartMs": 370780,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "그렇구나"
    } ]
  }, {
    "tStartMs": 371480,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "유명하더라고요"
    } ]
  }, {
    "tStartMs": 373090,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "추로스 과자도 유명하고 시나몬맛 꼬북칩 있죠"
    } ]
  }, {
    "tStartMs": 377510,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "그것도 많이 드시는 것 같아서 궁금했는데 맛있구나 그거"
    } ]
  }, {
    "tStartMs": 383300,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "저 깜짝 놀랐어요 먹어보고"
    } ]
  }, {
    "tStartMs": 384990,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "맛잘알들이시네요"
    } ]
  }, {
    "tStartMs": 386270,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그 식감이 맛있어요?"
    } ]
  }, {
    "tStartMs": 387650,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "그 향이랑 맛이 되게 깊어요"
    } ]
  }, {
    "tStartMs": 392470,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "먹어봐야겠다"
    } ]
  }, {
    "tStartMs": 393890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "네 아니 그러니까 식감은 분명히 과잔데"
    } ]
  }, {
    "tStartMs": 396830,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "이거 진짜 사 먹는 츄러스 향이랑 맛이 나는데?"
    } ]
  }, {
    "tStartMs": 401110,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "진짜요?"
    } ]
  }, {
    "tStartMs": 402850,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "츄러스 과자 맛있다고 합니다 혹시나 한국에서 발견하면 사보시고"
    } ]
  }, {
    "tStartMs": 407910,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "직접 별점을 남기고 계시진 않아요? 거기 웹사이트에서?"
    } ]
  }, {
    "tStartMs": 412160,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "저 많이 남기죠ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 414950,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "첫 번째 참여자로 남기고 있구나"
    } ]
  }, {
    "tStartMs": 417970,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그렇죠 그렇죠"
    } ]
  }, {
    "tStartMs": 419520,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "그리고 제 친구들도 좀 남겼습니다"
    } ]
  }, {
    "tStartMs": 422200,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "재밌다 재밌는 웹사이트 축하드리고요"
    } ]
  }, {
    "tStartMs": 426430,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "그리고는 노래 발매는 언젠가요?"
    } ]
  }, {
    "tStartMs": 430080,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "그거는 아직은 계약이 없어요"
    } ]
  }, {
    "tStartMs": 432040,
    "dDurationMs": 5690,
    "segs": [ {
      "utf8": "아 그래요? 그냥 여러 가지 만들어 보는 거예요?"
    } ]
  }, {
    "tStartMs": 437730,
    "dDurationMs": 6520,
    "segs": [ {
      "utf8": "지금은 딱 한 가지를 잡고... 제대로 하고 있는데"
    } ]
  }, {
    "tStartMs": 444250,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "제가 비트를 더 만들면 더 만드는 거죠"
    } ]
  }, {
    "tStartMs": 446780,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "그러면 최종 목표는 뭐예요? 그 노래로?"
    } ]
  }, {
    "tStartMs": 449670,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "사실 최종 목표는요"
    } ]
  }, {
    "tStartMs": 452000,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "재밌게 하는 겁니다"
    } ]
  }, {
    "tStartMs": 454580,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "그냥 뭐 즐겁게 하고 싶다"
    } ]
  }, {
    "tStartMs": 457940,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "취미로서 하시는 거네요?"
    } ]
  }, {
    "tStartMs": 459900,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 461950,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "발매하면 알려주세요"
    } ]
  }, {
    "tStartMs": 463310,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "그러니까 인터넷에 내놓게 되면은"
    } ]
  }, {
    "tStartMs": 466980,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "물론입니다"
    } ]
  }, {
    "tStartMs": 467500,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "아주 잘 지내고 계시는군요"
    } ]
  }, {
    "tStartMs": 471820,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "저는 부산에서 워케이션 잘 다녀왔습니다"
    } ]
  }, {
    "tStartMs": 475460,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "태웅쌤 계시는... \n- 우리는 못 보고ㅋㅋ"
    } ]
  }, {
    "tStartMs": 478060,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "그니까요 우리는 시간 관계상 못 보고"
    } ]
  }, {
    "tStartMs": 481150,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "다음에 요모조모 또 오프라인으로 찍어요"
    } ]
  }, {
    "tStartMs": 484390,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "아 그럽시다 때가 되면 보겠죠 뭐"
    } ]
  }, {
    "tStartMs": 486770,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "네 그래도 태웅쌤이 추천해 주신 가게들 되게 많이 갔고"
    } ]
  }, {
    "tStartMs": 491490,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "정말 믿고 가도 좋은 그런 추천들이었습니다"
    } ]
  }, {
    "tStartMs": 495370,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "뿌듯합니다"
    } ]
  }, {
    "tStartMs": 495790,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "역시나 역시나 좋아요"
    } ]
  }, {
    "tStartMs": 498080,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "그러면 이제 저희 오늘 이야기하기로 한 공항에 대해서"
    } ]
  }, {
    "tStartMs": 503420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "요모조모 살펴보려고 하는데"
    } ]
  }, {
    "tStartMs": 505160,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "저번 퀴즈 정답 이야기해야겠죠?"
    } ]
  }, {
    "tStartMs": 508140,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "저번 퀴즈가 좀 헷갈리셨을 수도 있을 것 같은데"
    } ]
  }, {
    "tStartMs": 511580,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "퀴즈는 이거였어요"
    } ]
  }, {
    "tStartMs": 512890,
    "dDurationMs": 5530,
    "segs": [ {
      "utf8": "'디디와 태웅이 편의점에서 자주 사는 음식으로 고르지 않은 것은?' 이었고요"
    } ]
  }, {
    "tStartMs": 518420,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "정답은 김밥, 1번 김밥이었습니다"
    } ]
  }, {
    "tStartMs": 521460,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "삼각김밥은 많이 먹는데 김밥은 잘 사 먹지 않고"
    } ]
  }, {
    "tStartMs": 525980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "한국에서 김밥이라고 하면"
    } ]
  }, {
    "tStartMs": 527700,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "보통 길다란 김밥을 생각하기 때문에 이게 정답이었어요"
    } ]
  }, {
    "tStartMs": 532300,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "조금 어려울 수도 있었던 퀴즈였는데"
    } ]
  }, {
    "tStartMs": 535680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "맞추신 분들 모두 축하드리고 감사합니다"
    } ]
  }, {
    "tStartMs": 538680,
    "dDurationMs": 6290,
    "segs": [ {
      "utf8": "오늘도 끝까지 들어주시면 퀴즈가 있으니까 많이 참여해주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 544970,
    "dDurationMs": 5810,
    "segs": [ {
      "utf8": "그러면 공항, 태웅쌤은 언제 마지막으로 이용하셨나요?"
    } ]
  }, {
    "tStartMs": 550780,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "저는 거의 1년 정도 된 것 같아요"
    } ]
  }, {
    "tStartMs": 553180,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "1년 정도, 저번에 거기 태국 가셨을 때였나요?"
    } ]
  }, {
    "tStartMs": 556080,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "라오스였나요?"
    } ]
  }, {
    "tStartMs": 557440,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "아니요 방콕 갔습니다 태국"
    } ]
  }, {
    "tStartMs": 561590,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그때 부산 공항에서 출발하셨어요?"
    } ]
  }, {
    "tStartMs": 564590,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 566920,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "보통 부산 공항에서 가시나요?"
    } ]
  }, {
    "tStartMs": 570830,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 571820,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "예전에는 부산에서 갈 수 있는 나라들이 그렇게 다양하거나 많지는 않아서"
    } ]
  }, {
    "tStartMs": 580220,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "필요하면 서울로 올라가서 비행기를 타고는 했는데"
    } ]
  }, {
    "tStartMs": 584970,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "요즘은 부산에서도 많이 갈 수 있는 곳이 생긴 것 같아요"
    } ]
  }, {
    "tStartMs": 589000,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그렇구나"
    } ]
  }, {
    "tStartMs": 590420,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "그래서 이제는 웬만하면 부산에서 비행기를 탑니다"
    } ]
  }, {
    "tStartMs": 594360,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "가격 비교를 해보면 어때요? 비슷한가요?"
    } ]
  }, {
    "tStartMs": 598870,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "그 생각은 안 해봤네요"
    } ]
  }, {
    "tStartMs": 600960,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "그래요? 항상 그냥 부산 출발로 찾아보셨어요?"
    } ]
  }, {
    "tStartMs": 605020,
    "dDurationMs": 8370,
    "segs": [ {
      "utf8": "네 왜냐면 부산에서 서울까지 가는 게 좀 귀찮잖아요"
    } ]
  }, {
    "tStartMs": 613390,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "맞아요 심지어 인천까지 또 넘어가야 되고 김포도 멀고 그러니까요"
    } ]
  }, {
    "tStartMs": 619090,
    "dDurationMs": 8210,
    "segs": [ {
      "utf8": "그게 저희 집에서 서울에 가기 위한 역을 가는 것도 한 세월인데"
    } ]
  }, {
    "tStartMs": 627300,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "또 서울에 도착해서 공항까지 가는 것도 한 세월이죠"
    } ]
  }, {
    "tStartMs": 630810,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "하루 다 가요"
    } ]
  }, {
    "tStartMs": 632190,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "그러니까요 그게... 여행이죠"
    } ]
  }, {
    "tStartMs": 636580,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그때부터 여행 시작이죠"
    } ]
  }, {
    "tStartMs": 638590,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "네ㅋㅋ"
    } ]
  }, {
    "tStartMs": 640070,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "부산에서 가면 훨씬 시간 절약할 수 있으니까 거기서 가는 게"
    } ]
  }, {
    "tStartMs": 643760,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "그냥 더 좋겠네요"
    } ]
  }, {
    "tStartMs": 645340,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 646710,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "전 부산공항은 한 번도 안 이용해봤는데"
    } ]
  }, {
    "tStartMs": 651440,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "좀 크기가 어때요?"
    } ]
  }, {
    "tStartMs": 654300,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "인천공항이랑 비교하면 굉장히 작은 편이에요"
    } ]
  }, {
    "tStartMs": 657940,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "인천공항이 근데 큰 편이잖아요 되게"
    } ]
  }, {
    "tStartMs": 661070,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 661710,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "크고 엄청 최첨단 공항이다"
    } ]
  }, {
    "tStartMs": 665730,
    "dDurationMs": 5850,
    "segs": [ {
      "utf8": "이런 홍보하는 걸 많이 봤는데"
    } ]
  }, {
    "tStartMs": 671580,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "인천공항, 인천국제공항 홈페이지에 있는 내용인데요"
    } ]
  }, {
    "tStartMs": 676860,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "이런 게 있대요"
    } ]
  }, {
    "tStartMs": 677700,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "세계공항서비스평가"
    } ]
  }, {
    "tStartMs": 680210,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "에어포츠 컨실러 인터내셔널이 매년 발표하는"
    } ]
  }, {
    "tStartMs": 684190,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "에어포츠 서비스 퀄리티 평가가 있는데"
    } ]
  }, {
    "tStartMs": 687530,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "인천공항이 12년 연속으로 1위를 했대요"
    } ]
  }, {
    "tStartMs": 692840,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "서비스가 되게 좋다는 평가를 받았나 봐요"
    } ]
  }, {
    "tStartMs": 697730,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "그리고 만들어진 것도 2001년에 만들어져 가지고"
    } ]
  }, {
    "tStartMs": 702670,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "비교적 최근이다 라는 말도 있고"
    } ]
  }, {
    "tStartMs": 706110,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "또 다양한 문화 체험 공간 이런 것도 있는 거 봤어요"
    } ]
  }, {
    "tStartMs": 710620,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "뭐 만들기 같은 거 할 수 있는 데도 있고"
    } ]
  }, {
    "tStartMs": 713570,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "팝업도 가끔 열거든요"
    } ]
  }, {
    "tStartMs": 715650,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "아 진짜요?"
    } ]
  }, {
    "tStartMs": 716400,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "네 게임 같은 거 할 수 있는 팝업 하는 것도 봤고"
    } ]
  }, {
    "tStartMs": 720430,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "한국 공예 이런 거 만들기 같은 거 할 수 있는 장소도 있고"
    } ]
  }, {
    "tStartMs": 726790,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "그런 여러 가지 이유들로 좋은 평가를 받고 있는 것 같아요"
    } ]
  }, {
    "tStartMs": 734710,
    "dDurationMs": 6830,
    "segs": [ {
      "utf8": "확실히 그런 건 아무래도 대표 공항이 좀 잘 돼 있나봐요"
    } ]
  }, {
    "tStartMs": 741540,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "그런가 봐요"
    } ]
  }, {
    "tStartMs": 742510,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "근데 이런 다양한 서비스가 있다고는 하는데 공항에 막상 가서"
    } ]
  }, {
    "tStartMs": 747280,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "어떤 서비스들을 주로 이용하세요?"
    } ]
  }, {
    "tStartMs": 752160,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "서비스..."
    } ]
  }, {
    "tStartMs": 754020,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "저는 밥 먹고 편의점 가는 거 외에는"
    } ]
  }, {
    "tStartMs": 761060,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "딱히 써본 기억이 없는 것 같은데요"
    } ]
  }, {
    "tStartMs": 766170,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "이런 환전이나 아니면 유심 수령하는 거나 이런 거는 안 해요?"
    } ]
  }, {
    "tStartMs": 773130,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "아, 외국 공항에서요?"
    } ]
  }, {
    "tStartMs": 775100,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "한국에서요"
    } ]
  }, {
    "tStartMs": 776000,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "아, 저 한국에서는 한 번도 안 해봤어요"
    } ]
  }, {
    "tStartMs": 778530,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "아, 그래요?"
    } ]
  }, {
    "tStartMs": 780020,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "저는 다 외국 가서..."
    } ]
  }, {
    "tStartMs": 782780,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "아, 진짜요?"
    } ]
  }, {
    "tStartMs": 783400,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "그 나라에서 하는구나"
    } ]
  }, {
    "tStartMs": 786530,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "유심이랑 이런 것도요?"
    } ]
  }, {
    "tStartMs": 788310,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "그것도 다요"
    } ]
  }, {
    "tStartMs": 789230,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "아, 진짜요? 헐, 어떻게 해요?"
    } ]
  }, {
    "tStartMs": 791990,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "공항에서 사는 거예요?"
    } ]
  }, {
    "tStartMs": 793720,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 794300,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "아, 진짜요?"
    } ]
  }, {
    "tStartMs": 796470,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "저는 좀 불안하니까 왠지 외국에 가서 내가 못하면 어떡하지 하는 생각에..."
    } ]
  }, {
    "tStartMs": 802090,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "뭐 그게 더 싼가? 현지에서 하면 더 싼가요?"
    } ]
  }, {
    "tStartMs": 805380,
    "dDurationMs": 5590,
    "segs": [ {
      "utf8": "아 그게 제 생각에는 제가 옛날에 되게"
    } ]
  }, {
    "tStartMs": 810970,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "오랫동안 몇 개월 동안 배낭여행을 다닌 적이 있다 했잖아요"
    } ]
  }, {
    "tStartMs": 815780,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "그때는 한국에서 이 나라 저 나라 왔다 갔다 하는 게 아니라"
    } ]
  }, {
    "tStartMs": 821380,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "계속 다른 나라에서 다른 나라로 이동하니까"
    } ]
  }, {
    "tStartMs": 825470,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "다 그 나라에서 그냥 하는 게 당연했거든요"
    } ]
  }, {
    "tStartMs": 829150,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "근데 저는 그게 당연한 거라고 학습이 돼서"
    } ]
  }, {
    "tStartMs": 837250,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "이제 한국 돌아와서도"
    } ]
  }, {
    "tStartMs": 839100,
    "dDurationMs": 6950,
    "segs": [ {
      "utf8": "어디를 갈 때나 그냥 가서 그렇게 하던 대로 하는 거죠"
    } ]
  }, {
    "tStartMs": 846050,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "이런 거잖아요 일본 갔다가 일본에서 중국 넘어갔다가"
    } ]
  }, {
    "tStartMs": 850900,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "중국에서 또 어디 날아가고 이런 식으로 하다 보니까..."
    } ]
  }, {
    "tStartMs": 854540,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "그랬구나 저는 그래 본 적이 없었어요"
    } ]
  }, {
    "tStartMs": 859100,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "항상 한국에서 준비하고"
    } ]
  }, {
    "tStartMs": 861640,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "공항 가기 전에 준비해야 될 거 리스트 중에 항상 유심"
    } ]
  }, {
    "tStartMs": 866370,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "환전 요즘은 그냥 카드로 하는 거라서"
    } ]
  }, {
    "tStartMs": 870660,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "딱히 돈을 받지는 않는데 다 미리 준비해서 갔거든요"
    } ]
  }, {
    "tStartMs": 875290,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "거기 나라에서 하시는구나"
    } ]
  }, {
    "tStartMs": 878460,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "네 제가 제 채널인지 디디님 채널인지 잘 모르겠는데"
    } ]
  }, {
    "tStartMs": 883570,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "어디서 한 번 했던 얘기인데요"
    } ]
  }, {
    "tStartMs": 886240,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "제가 항상 외국 나가서 처음에 하는 게 있거든요"
    } ]
  }, {
    "tStartMs": 889350,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "뭔데요?"
    } ]
  }, {
    "tStartMs": 890530,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "가서 환전을 할 수도 있고 보통 유심칩을 살 때도 있는데"
    } ]
  }, {
    "tStartMs": 897890,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "공항에 가서 그러면 그 나라 사람이랑"
    } ]
  }, {
    "tStartMs": 900780,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "처음 얘기를 하는 거잖아요"
    } ]
  }, {
    "tStartMs": 902330,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 903490,
    "dDurationMs": 6590,
    "segs": [ {
      "utf8": "그럼 그렇게 해서 사실 그것도 저는 여행의 재미로 좀 느껴서 그렇게 하는데"
    } ]
  }, {
    "tStartMs": 910080,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "볼일을 이제 공항에서 다 볼 때"
    } ]
  }, {
    "tStartMs": 913920,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "그럼 이제 이 작업만 하면 밖으로 나가는 건데"
    } ]
  }, {
    "tStartMs": 918970,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "그러면 그게 다 끝나고 그 직원분한테"
    } ]
  }, {
    "tStartMs": 924290,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "이 나라 말로 '감사합니다'가 뭐예요? 이렇게 물어봐요"
    } ]
  }, {
    "tStartMs": 929050,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "아, 거기서요? 그분한테?"
    } ]
  }, {
    "tStartMs": 931140,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "네 영어로 물어보는 거죠"
    } ]
  }, {
    "tStartMs": 933440,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "이 나라 말로 '감사합니다'가 뭐예요?"
    } ]
  }, {
    "tStartMs": 936930,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "그렇게 물어보면"
    } ]
  }, {
    "tStartMs": 937750,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "뭐 베트남을 예로 들면 '깜언' 이렇게 하겠죠?"
    } ]
  }, {
    "tStartMs": 942400,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "그러면 그걸 그대로 그분한테 '깜언' 이렇게 하고 나가요"
    } ]
  }, {
    "tStartMs": 946890,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "레파토리네 그러고 딱 여행의 출발을 알려준다, 그게"
    } ]
  }, {
    "tStartMs": 952320,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 952960,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "아, 그리고 한 번 배운 거를 여행 내내 쓰겠네요? '깜언'은?"
    } ]
  }, {
    "tStartMs": 957180,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "더 많이 쓰게 되더라고요"
    } ]
  }, {
    "tStartMs": 958420,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "오, 좋다"
    } ]
  }, {
    "tStartMs": 960130,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "영어로 다 소통이 되나요?"
    } ]
  }, {
    "tStartMs": 962620,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "공항에 계신 분들은..."
    } ]
  }, {
    "tStartMs": 964460,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "진짜요? 일본이나 아시아 국가에 가도?"
    } ]
  }, {
    "tStartMs": 968390,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "제 경우에는 다 그랬어요"
    } ]
  }, {
    "tStartMs": 970150,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "아, 영어만 하면 되는구나"
    } ]
  }, {
    "tStartMs": 975530,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "영어가 돼서 괜찮나 봐요"
    } ]
  }, {
    "tStartMs": 977760,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "아, 근데 뭐…"
    } ]
  }, {
    "tStartMs": 981270,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "뭐 how to say in Vietnamese 이런 거 쉽잖아요"
    } ]
  }, {
    "tStartMs": 984710,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "너무 고급 영어예요 아니에요 모르는 사람은 어렵죠"
    } ]
  }, {
    "tStartMs": 989850,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "그럴 수 있죠"
    } ]
  }, {
    "tStartMs": 991610,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "좋다 좋다 그런 루틴 재밌네요"
    } ]
  }, {
    "tStartMs": 994680,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "그 모먼트가 되게 캐릭터 있잖아요"
    } ]
  }, {
    "tStartMs": 997790,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "그래서 뭔가 여행의 주인공이 되는 느낌"
    } ]
  }, {
    "tStartMs": 1002540,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "웃기다"
    } ]
  }, {
    "tStartMs": 1003650,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "뭐 그런 거는 이용 안 해보셨어요?"
    } ]
  }, {
    "tStartMs": 1006300,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "라운지 이런 거 공항 라운지"
    } ]
  }, {
    "tStartMs": 1009490,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "저는 그 공항 라운지가 좀 프리미엄 회원"
    } ]
  }, {
    "tStartMs": 1014750,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "이런 사람들만 쓸 수 있는 거 아니에요?"
    } ]
  }, {
    "tStartMs": 1017250,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "그렇거나 아니면 돈을 내고 들어가거나"
    } ]
  }, {
    "tStartMs": 1021410,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "근데 저는 한 번도 이용을 안 해봤고"
    } ]
  }, {
    "tStartMs": 1026240,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "사실 딱히 막 쓰고 싶다는 생각이 들어본 적은 없어요"
    } ]
  }, {
    "tStartMs": 1030770,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "그렇구나 저는 최근에 발급받았거든요 카드를"
    } ]
  }, {
    "tStartMs": 1036510,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "그 라운지 이용이 가능한 카드를... 발급받아서"
    } ]
  }, {
    "tStartMs": 1041570,
    "dDurationMs": 5750,
    "segs": [ {
      "utf8": "그런 조건이 있어요 전월에 50만원 이상 이 카드로 쓰면"
    } ]
  }, {
    "tStartMs": 1047320,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "공항 라운지를 쓸 수 있는 마일리지 카드가 있는데"
    } ]
  }, {
    "tStartMs": 1051460,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "제가 여행 다니는 것도 좋아하고 너무 궁금한 거예요 라운지 어떤 건지"
    } ]
  }, {
    "tStartMs": 1056350,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "그래서 이용해보려고요 올해는"
    } ]
  }, {
    "tStartMs": 1058940,
    "dDurationMs": 6990,
    "segs": [ {
      "utf8": "근데 공교롭게도 제가 최근에 몇 년 전 뉴스를 봤는데..."
    } ]
  }, {
    "tStartMs": 1065930,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "네 뭔데요?"
    } ]
  }, {
    "tStartMs": 1067900,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "어떤 공무원이 한국인 공무원이 외국으로 나갈 때마다"
    } ]
  }, {
    "tStartMs": 1073700,
    "dDurationMs": 7760,
    "segs": [ {
      "utf8": "자기가 타는 비행기는 퍼스트 클래스, 1등석이 아닌 그냥 이코노미 클래스인데"
    } ]
  }, {
    "tStartMs": 1081460,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "자기 이코노미 티켓은 있고 들어가서"
    } ]
  }, {
    "tStartMs": 1085440,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "퍼스트 클래스 티켓을 하나 따로 사서"
    } ]
  }, {
    "tStartMs": 1088600,
    "dDurationMs": 5980,
    "segs": [ {
      "utf8": "퍼스트 클래스 사용자만 쓸 수 있는 라운지에 들어가서 공짜 밥도 먹고"
    } ]
  }, {
    "tStartMs": 1094580,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "공짜 술도 마시고 그리고 비행기를 타기 전에"
    } ]
  }, {
    "tStartMs": 1098670,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "그 퍼스트 클래스 비행기 티켓을 취소했대요"
    } ]
  }, {
    "tStartMs": 1103070,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "그래도 돼요?"
    } ]
  }, {
    "tStartMs": 1104040,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그걸 되게 많이 했대요"
    } ]
  }, {
    "tStartMs": 1105530,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "어? 그게 환불이 되나 보네요?"
    } ]
  }, {
    "tStartMs": 1108040,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "됐나 봐요"
    } ]
  }, {
    "tStartMs": 1110140,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "근데 그거를 항공사 측인지 공항 측에서 이 사람 이상하다 해서 잡아내서"
    } ]
  }, {
    "tStartMs": 1119740,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "그 사람은 범죄자가 됐다고 합니다"
    } ]
  }, {
    "tStartMs": 1123640,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "그건 범죄죠?"
    } ]
  }, {
    "tStartMs": 1124990,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "그건 범죄죠"
    } ]
  }, {
    "tStartMs": 1126370,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "그래서 라운지 하니까 그게 생각이 났어요"
    } ]
  }, {
    "tStartMs": 1130730,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "헐 저는 아니에요"
    } ]
  }, {
    "tStartMs": 1132130,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "저는 그렇게 할 거 아니고 정정당당하게 카드로 하려고 하는데"
    } ]
  }, {
    "tStartMs": 1137120,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "그런 분들도 있군요 아주 나쁜 사람이네"
    } ]
  }, {
    "tStartMs": 1140100,
    "dDurationMs": 550,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 1140650,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "사기꾼이네 사기꾼"
    } ]
  }, {
    "tStartMs": 1143190,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1144450,
    "dDurationMs": 6670,
    "segs": [ {
      "utf8": "라운지 같은 게 아침 비행기 타시는 분들은 이용을 하기도 애매하잖아요"
    } ]
  }, {
    "tStartMs": 1151120,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "6시 비행기인데 라운지 이용하기 어려워서"
    } ]
  }, {
    "tStartMs": 1155130,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "라운지를 이용할 거면 그래도 좀 오후 늦게 출발하는... 적어도 2시 정도?"
    } ]
  }, {
    "tStartMs": 1160330,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "해야지 느긋하게 이용할 수 있는 거 같다는 생각이 들었거든요"
    } ]
  }, {
    "tStartMs": 1164470,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "보통 비행기 타면은 몇 시 정도에 가요?"
    } ]
  }, {
    "tStartMs": 1168190,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "아침 비행기를 선호하세요?"
    } ]
  }, {
    "tStartMs": 1171020,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "저는 집에서 공항이 거리가 꽤 있어서"
    } ]
  }, {
    "tStartMs": 1175640,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "가는 데만 한 2시간쯤 걸리거든요"
    } ]
  }, {
    "tStartMs": 1179140,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "그러다 보니까... (- 버스로?) 지하철하고 버스 둘 다요"
    } ]
  }, {
    "tStartMs": 1183470,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "멀구나"
    } ]
  }, {
    "tStartMs": 1184890,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "네 그래서 이른 아침 비행기는 진짜 못 타고"
    } ]
  }, {
    "tStartMs": 1190550,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "그래서 그냥 오후 비행기?"
    } ]
  }, {
    "tStartMs": 1192460,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "오후 언제든?"
    } ]
  }, {
    "tStartMs": 1194730,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "네 오후 언제든"
    } ]
  }, {
    "tStartMs": 1195880,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "아 그렇구나"
    } ]
  }, {
    "tStartMs": 1197890,
    "dDurationMs": 6260,
    "segs": [ {
      "utf8": "그러면 뭐 2시 비행기다라고 하면 몇 시간 전쯤에 가려고 하세요?"
    } ]
  }, {
    "tStartMs": 1204150,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "그게 외국 나가는 경우에는..."
    } ]
  }, {
    "tStartMs": 1207140,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "국제선?"
    } ]
  }, {
    "tStartMs": 1208770,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "네, 국제선이죠"
    } ]
  }, {
    "tStartMs": 1210820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "국제선인 경우에는"
    } ]
  }, {
    "tStartMs": 1212680,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "비행기가 출발하는 시간보다 훨씬 전에 도착해야 되잖아요"
    } ]
  }, {
    "tStartMs": 1218560,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "최소 2시간으로 알고 있어요"
    } ]
  }, {
    "tStartMs": 1222020,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "맞아요 최소 2시간이고"
    } ]
  }, {
    "tStartMs": 1224060,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "또 항공사에 따라서 3시간, 4시간인 경우도 있더라고요"
    } ]
  }, {
    "tStartMs": 1227540,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1228970,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "그래서 그거 감안해서 저는 아주 일찍 가는 편입니다"
    } ]
  }, {
    "tStartMs": 1232510,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "그러세요?"
    } ]
  }, {
    "tStartMs": 1233350,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "그러면 최소 2시간이면 뭐 한 3, 4시간 전에 가나요?"
    } ]
  }, {
    "tStartMs": 1237410,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1239140,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "널널하게 가는구나"
    } ]
  }, {
    "tStartMs": 1241170,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "네 만약에 갔는데 사람들이 공항에 너무 많아서"
    } ]
  }, {
    "tStartMs": 1247050,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "줄 서는 시간이 너무 오래 걸린다 그러면 또 문제가 생길 수도 있잖아요"
    } ]
  }, {
    "tStartMs": 1250920,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "네 그게 맞아요"
    } ]
  }, {
    "tStartMs": 1252530,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "엄청 일찍 가는 게 그냥 좋아요"
    } ]
  }, {
    "tStartMs": 1255270,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "맞습니다 디디님은 어떠신가요?"
    } ]
  }, {
    "tStartMs": 1257800,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "저는... 2시간 전까지 오라고 하면"
    } ]
  }, {
    "tStartMs": 1262780,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "한 2시간 반 전까지 가려고 하는 것 같은데"
    } ]
  }, {
    "tStartMs": 1266240,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "조금 더 일찍 가는 편이에요"
    } ]
  }, {
    "tStartMs": 1268930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "원래 도착해야 되는 시간보다"
    } ]
  }, {
    "tStartMs": 1270640,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "근데 지금까지는 별 문제가 없어가지고 괜찮았는데"
    } ]
  }, {
    "tStartMs": 1275720,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "좀 더 일찍 가야겠다 라고 생각하게 된 계기가"
    } ]
  }, {
    "tStartMs": 1279680,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "저번에 호주 여행을 엄마랑 갔었거든요"
    } ]
  }, {
    "tStartMs": 1281940,
    "dDurationMs": 6660,
    "segs": [ {
      "utf8": "그래서 그건 국제선이 아니라 국내선 호주 안에서 왔다갔다 하는 비행기였어요"
    } ]
  }, {
    "tStartMs": 1288600,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "그 뭐지 브리즈번에서 시드니 가는 비행기 였는데"
    } ]
  }, {
    "tStartMs": 1293950,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "뭐 1시간 전까지 오라고 되어 있더라고요"
    } ]
  }, {
    "tStartMs": 1297180,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "그래서 저는 1시간 반 전까지 가면 된다라고 생각을 했어요"
    } ]
  }, {
    "tStartMs": 1302100,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "왜냐하면 그 공항이 숙소에서 한 20분밖에 안 걸리더라고요"
    } ]
  }, {
    "tStartMs": 1307150,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "지하철 하나만 타면 되는 거라서"
    } ]
  }, {
    "tStartMs": 1309440,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "느긋하게 나가야지 하고 갔는데"
    } ]
  }, {
    "tStartMs": 1312190,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "외국에서는 내가 상상하지 못하는 일이 일어날 수 있다는 걸 몰랐어요"
    } ]
  }, {
    "tStartMs": 1319270,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "지하철이 그날 운행을 안 하는 거예요"
    } ]
  }, {
    "tStartMs": 1323550,
    "dDurationMs": 7650,
    "segs": [ {
      "utf8": "그래서 20분 걸릴 게 한 시간 반 동안 이렇게 삥 둘러서 가야 된다고 해가지고"
    } ]
  }, {
    "tStartMs": 1331200,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "그때 비행기를 한번 놓쳤었거든요 타야 되는 거를"
    } ]
  }, {
    "tStartMs": 1335110,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "그래서 이렇게 예상치 못하는 일이 생기는구나 해서"
    } ]
  }, {
    "tStartMs": 1339360,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "아 일찍 가야겠다 무조건 일찍 가야겠다"
    } ]
  }, {
    "tStartMs": 1342840,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "배우게 된 계기가 있었습니다"
    } ]
  }, {
    "tStartMs": 1346160,
    "dDurationMs": 7240,
    "segs": [ {
      "utf8": "그렇습니다 그래도 뭐 국내선 때 그런 일이 있던 게 그나마 다행이네요"
    } ]
  }, {
    "tStartMs": 1353400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "그렇죠 엄청 비싼 비행기는 아니었고"
    } ]
  }, {
    "tStartMs": 1356040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "그리고 다행히 바꿔주셨어요"
    } ]
  }, {
    "tStartMs": 1358980,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "다행이네요"
    } ]
  }, {
    "tStartMs": 1359590,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "뒤에 걸로 바꿔주셨어요"
    } ]
  }, {
    "tStartMs": 1363870,
    "dDurationMs": 13150,
    "segs": [ {
      "utf8": "근데 제가 예전에 고등학교 때 들었던 영어 인강, 인터넷 강의 강사님이"
    } ]
  }, {
    "tStartMs": 1377020,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "비행기 그런 얘기를 해주는 게 있었는데"
    } ]
  }, {
    "tStartMs": 1381520,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "비행기가 뜨기 직전에 체크인을 하면"
    } ]
  }, {
    "tStartMs": 1386980,
    "dDurationMs": 7970,
    "segs": [ {
      "utf8": "남는 퍼스트 클래스에 그냥 업그레이드를 해준다는 얘기를 들은 적이 있거든요"
    } ]
  }, {
    "tStartMs": 1394950,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "들어보셨어요?"
    } ]
  }, {
    "tStartMs": 1396010,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "직전에 하면 업그레이드를 해준다?"
    } ]
  }, {
    "tStartMs": 1397970,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "아 뭐 퍼스트 클래스에 자리 남았으니까 '여기로 가세요'라고?"
    } ]
  }, {
    "tStartMs": 1402530,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "그럴 수가 있을까요?"
    } ]
  }, {
    "tStartMs": 1404900,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "근데 그런 경험 이야기를 들었었어요"
    } ]
  }, {
    "tStartMs": 1410780,
    "dDurationMs": 8420,
    "segs": [ {
      "utf8": "그래서 뭔가 항상 저는 막연한 환상이 있는데 늦게 가는 거에"
    } ]
  }, {
    "tStartMs": 1419200,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "한 번도 해보진 못했고"
    } ]
  }, {
    "tStartMs": 1421050,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "오... 경험하신 분들이 있을지 궁금하네요"
    } ]
  }, {
    "tStartMs": 1425660,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "근데 그러면 안 되잖아요"
    } ]
  }, {
    "tStartMs": 1427390,
    "dDurationMs": 6670,
    "segs": [ {
      "utf8": "안 되죠 이제는 그게 엄청 옛날 일이라"
    } ]
  }, {
    "tStartMs": 1434060,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "요즘은 안 될 수도 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 1436290,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "비워놓죠 그냥"
    } ]
  }, {
    "tStartMs": 1439660,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "퍼스트 클래스 한 번쯤은 타보고 싶네요"
    } ]
  }, {
    "tStartMs": 1443840,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "저도요"
    } ]
  }, {
    "tStartMs": 1444710,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "근데 제 돈으로 타고 싶진 않고 약간..."
    } ]
  }, {
    "tStartMs": 1447900,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "회사 출장으로 가면 회사가 내주잖아요"
    } ]
  }, {
    "tStartMs": 1450450,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "그런 느낌으로 한번 가보고 싶어요"
    } ]
  }, {
    "tStartMs": 1452900,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그렇죠 아니면 뭐 초청 받거나"
    } ]
  }, {
    "tStartMs": 1454920,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "맞아요 맞아요 공짜표로"
    } ]
  }, {
    "tStartMs": 1458270,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "왜냐하면 두 배 이상이잖아요 그게"
    } ]
  }, {
    "tStartMs": 1461780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 1463760,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "누가 초청해주면 좋겠다"
    } ]
  }, {
    "tStartMs": 1464970,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "그러니까요 그것도 장시간으로 해가지고"
    } ]
  }, {
    "tStartMs": 1469100,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "코스요리 한 두 번 정도 먹을 수 있게 해서"
    } ]
  }, {
    "tStartMs": 1472750,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "죽기 전에 한 번쯤은 초청 받을 수 있었으면 좋겠네요"
    } ]
  }, {
    "tStartMs": 1476510,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "네 열심히 열심히 삽시다"
    } ]
  }, {
    "tStartMs": 1479460,
    "dDurationMs": 6110,
    "segs": [ {
      "utf8": "그러면 좀 선호하는 에어라인 있어요? 항공사 있어요?"
    } ]
  }, {
    "tStartMs": 1485570,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "그 이스트아시아? 아니다 아니다"
    } ]
  }, {
    "tStartMs": 1489090,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "이스타항공 맞아 맞아 맞아 이스타항공입니다"
    } ]
  }, {
    "tStartMs": 1492690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "이스타항공 이스타항공"
    } ]
  }, {
    "tStartMs": 1495000,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "네 이스타항공인데요"
    } ]
  }, {
    "tStartMs": 1496920,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "아 이스타"
    } ]
  }, {
    "tStartMs": 1498050,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "네 이스타항공인데"
    } ]
  }, {
    "tStartMs": 1501250,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "사실 그 딱히 큰 이유는 아니고요"
    } ]
  }, {
    "tStartMs": 1506370,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "거기 승무원분들 유니폼이 예뻐서..."
    } ]
  }, {
    "tStartMs": 1510190,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "어떤데요? 무슨 색이에요?"
    } ]
  }, {
    "tStartMs": 1512160,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "흰색, 빨간색 조합이에요"
    } ]
  }, {
    "tStartMs": 1516520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "근데 뭔가 예뻐요"
    } ]
  }, {
    "tStartMs": 1520360,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "거기 승무원분들 보러 이스타항공 타신다는 말씀이신 거죠?"
    } ]
  }, {
    "tStartMs": 1526080,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "아니 근데 꼭 굳이 이스타항공을 타려고 하진 않아요"
    } ]
  }, {
    "tStartMs": 1530250,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "그래요? 그냥 여기가 좋더라"
    } ]
  }, {
    "tStartMs": 1533290,
    "dDurationMs": 7420,
    "segs": [ {
      "utf8": "근데 그냥 탈 때 남자분들이나 여자분들이나 옷이 되게 스타일리시하다"
    } ]
  }, {
    "tStartMs": 1540710,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "그래요? 전 몰랐네요"
    } ]
  }, {
    "tStartMs": 1543430,
    "dDurationMs": 6180,
    "segs": [ {
      "utf8": "뭔가 배 쪽에 빨간색 띠처럼 있거든요"
    } ]
  }, {
    "tStartMs": 1549610,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "포인트로 특이하다"
    } ]
  }, {
    "tStartMs": 1552700,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "예쁘더라고요"
    } ]
  }, {
    "tStartMs": 1554210,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "맞아 이게 항공사별로 다르잖아요 유니폼이"
    } ]
  }, {
    "tStartMs": 1557900,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "로고랑 비슷하잖아요 옷이"
    } ]
  }, {
    "tStartMs": 1560460,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "그런 거 보는 것도 재밌어요"
    } ]
  }, {
    "tStartMs": 1562780,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "제주항공은 포인트가 주황색 스카프"
    } ]
  }, {
    "tStartMs": 1567450,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "아시아나는... 아시아나도 되게 예쁜데?"
    } ]
  }, {
    "tStartMs": 1570790,
    "dDurationMs": 6670,
    "segs": [ {
      "utf8": "아시아나는 하얀색이랑 어두운 색이었나?"
    } ]
  }, {
    "tStartMs": 1577460,
    "dDurationMs": 5770,
    "segs": [ {
      "utf8": "아 화살표가 마스코트인데 아니 뭐지? 심볼인데 로고인데"
    } ]
  }, {
    "tStartMs": 1583230,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "살짝 빨간색이 섞인 스카프를 하고 있네요"
    } ]
  }, {
    "tStartMs": 1588360,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1589060,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "그러면 내가 예쁘다고 생각한 게 대한항공인가 봐요"
    } ]
  }, {
    "tStartMs": 1592530,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 1593360,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "아 하늘색 어머 예쁘다 비행기 같아요"
    } ]
  }, {
    "tStartMs": 1597480,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "음 그렇죠"
    } ]
  }, {
    "tStartMs": 1598580,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "비행기 색깔이구나"
    } ]
  }, {
    "tStartMs": 1600960,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "어쨌든 제 스타일은 이스타항공..."
    } ]
  }, {
    "tStartMs": 1605480,
    "dDurationMs": 5830,
    "segs": [ {
      "utf8": "승무원분들 정말 친절하고 항상 멋있다고 생각해요 보면"
    } ]
  }, {
    "tStartMs": 1611310,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "아 그렇죠"
    } ]
  }, {
    "tStartMs": 1612150,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "기장분들도 그렇고 공항 가면 이렇게 막 줄지어서 쫙 가잖아요"
    } ]
  }, {
    "tStartMs": 1617570,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "그럴 때 멋있어요"
    } ]
  }, {
    "tStartMs": 1619200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그렇죠 그렇죠"
    } ]
  }, {
    "tStartMs": 1621000,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "뭔가 에피소드 있어요? 승무원분들과?"
    } ]
  }, {
    "tStartMs": 1624900,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "전혀 없어요"
    } ]
  }, {
    "tStartMs": 1625740,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "진짜요? 전 있는데!"
    } ]
  }, {
    "tStartMs": 1627970,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 1628610,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "저의 첫 비행 스토리"
    } ]
  }, {
    "tStartMs": 1631890,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "되게 민폐 고객이었던 썰이에요"
    } ]
  }, {
    "tStartMs": 1636350,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "디디님이요?"
    } ]
  }, {
    "tStartMs": 1639510,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "네 제가 중학생 때였고"
    } ]
  }, {
    "tStartMs": 1642000,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "처음 가족들이랑 해외여행을 가는 거였어요"
    } ]
  }, {
    "tStartMs": 1645470,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "태국 그때 방콕으로 가는 비행기였는데"
    } ]
  }, {
    "tStartMs": 1648780,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "가족들이랑 가는 여행이다 보니까"
    } ]
  }, {
    "tStartMs": 1651510,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "그때가 아시아나였던 것 같아요"
    } ]
  }, {
    "tStartMs": 1655610,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "제가 그때 교정을 하고 있었거든요"
    } ]
  }, {
    "tStartMs": 1658300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "교정을 하고 유지장치라는 게 있어가지고"
    } ]
  }, {
    "tStartMs": 1661080,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "이게 밥 먹을 때마다 뺐다가 꼈다가 하는 그 유지장치가 있었어요"
    } ]
  }, {
    "tStartMs": 1666500,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "근데 기내식이라는 걸 제가 처음 먹어보고,"
    } ]
  }, {
    "tStartMs": 1670460,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "어 맛있다 하고 다 반납을 했는데"
    } ]
  }, {
    "tStartMs": 1673830,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "제 교정 장치가 없어진 거예요 그 유지 장치가..."
    } ]
  }, {
    "tStartMs": 1677500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "설마..."
    } ]
  }, {
    "tStartMs": 1678500,
    "dDurationMs": 6270,
    "segs": [ {
      "utf8": "거기 그 판에다가 놓고 그냥 가져가신 거예요"
    } ]
  }, {
    "tStartMs": 1684770,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "저도 이렇게 대충 놔둬서 몰랐던 거죠 그게 까먹은 거죠"
    } ]
  }, {
    "tStartMs": 1689110,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "근데 그거 엄청 비싸거든요 교정기가"
    } ]
  }, {
    "tStartMs": 1691840,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "이거 그래서 찾아야 되잖아요"
    } ]
  }, {
    "tStartMs": 1694350,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "그래서 혹시나 말씀을 드렸어요"
    } ]
  }, {
    "tStartMs": 1696050,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "방금 이거 그 먹었는데 가져가셨는데"
    } ]
  }, {
    "tStartMs": 1699610,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "거기에 제 교정장치가 있었던 것 같다 하니까"
    } ]
  }, {
    "tStartMs": 1703240,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "거기 이미 다 정리를 해가지고"
    } ]
  }, {
    "tStartMs": 1706020,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "모든 승객들의 접시를 다 뒤져야 되는 거예요 그거를 찾으려면..."
    } ]
  }, {
    "tStartMs": 1712820,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "근데 찾아주셨어요 그걸 하나하나 하나하나"
    } ]
  }, {
    "tStartMs": 1716520,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "굉장히 친절하게 (- 진짜 대단하시네 진짜 대단하시다)"
    } ]
  }, {
    "tStartMs": 1720070,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "진짜 대단하신데 얼마나 싫었겠어요"
    } ]
  }, {
    "tStartMs": 1723570,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "안 그래도 바쁜데 다시 막 이렇게 찾고 하는 게..."
    } ]
  }, {
    "tStartMs": 1729410,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "승무원분들이 정말 고생을 많이 하시는구나..."
    } ]
  }, {
    "tStartMs": 1733180,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "그렇겠네요"
    } ]
  }, {
    "tStartMs": 1736570,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "이 기회에 한번 사과 인사하세요"
    } ]
  }, {
    "tStartMs": 1741390,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "제가 정신을 똑바로 차려야 되는데 그때"
    } ]
  }, {
    "tStartMs": 1744950,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "너무 번거롭게 해드려서 죄송하고"
    } ]
  }, {
    "tStartMs": 1747830,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "이제 다시는 그런 일이 없도록 신경을 쓰고 있고"
    } ]
  }, {
    "tStartMs": 1753010,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "그리고 승무원님들 만나면 굉장히 친절한 얼굴로"
    } ]
  }, {
    "tStartMs": 1758340,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "인사를 하려고 아직도 노력을 하고 있습니다"
    } ]
  }, {
    "tStartMs": 1761310,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "그분들 덕분에 감사함을 잊지 않고 아직까지"
    } ]
  }, {
    "tStartMs": 1765620,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "늘 고생이 많으십니다"
    } ]
  }, {
    "tStartMs": 1768690,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "수하물 같은 것도 공항에 맡기잖아요"
    } ]
  }, {
    "tStartMs": 1771700,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "근데 저가항공 이용하면 수하물 없이"
    } ]
  }, {
    "tStartMs": 1775130,
    "dDurationMs": 5830,
    "segs": [ {
      "utf8": "기내 수하,물 들고 들어갈 수 있는 것만 해서 가져가는 경우도 많은데"
    } ]
  }, {
    "tStartMs": 1780960,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "수하물은 자주 추가하세요?"
    } ]
  }, {
    "tStartMs": 1784360,
    "dDurationMs": 9300,
    "segs": [ {
      "utf8": "저는 최대한 짐을 줄이는 편이라서 수하물 추가는 할 일이 없고"
    } ]
  }, {
    "tStartMs": 1793660,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "가끔 기본으로 제공되는 위탁 그러니까 맡기는 수하물"
    } ]
  }, {
    "tStartMs": 1799100,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "그것도 아예 안 쓸 때도 있어요 (- 진짜요?)"
    } ]
  }, {
    "tStartMs": 1802890,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "그냥 가방 하나만 들고 가는 거죠 여행을"
    } ]
  }, {
    "tStartMs": 1805660,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "미니멀리스트로 가시는구나"
    } ]
  }, {
    "tStartMs": 1807840,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1810040,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "뭐 선물이나 아니면 쇼핑 같은 거 많이 안 하는 편이에요?"
    } ]
  }, {
    "tStartMs": 1815410,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "그런 게 없었네요 생각해보니까"
    } ]
  }, {
    "tStartMs": 1820100,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "그래요? 면세점 같은데 가서 꼭 이걸 산다"
    } ]
  }, {
    "tStartMs": 1824790,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "이런 거는 딱히 없어요?"
    } ]
  }, {
    "tStartMs": 1826360,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "없어요 그런 거"
    } ]
  }, {
    "tStartMs": 1828490,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "많이 사는 게 술,"
    } ]
  }, {
    "tStartMs": 1832320,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "과자도 많이 사고 담배도 많이 사고 그렇게 하는데"
    } ]
  }, {
    "tStartMs": 1837210,
    "dDurationMs": 6190,
    "segs": [ {
      "utf8": "담배는 제가 원래 안 피고 술은 가끔 살 때가 있는데"
    } ]
  }, {
    "tStartMs": 1843400,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "술이라고 해도 한 사람당 한 병밖에 못 사잖아요"
    } ]
  }, {
    "tStartMs": 1847430,
    "dDurationMs": 5630,
    "segs": [ {
      "utf8": "그래서 그냥 짐이 그렇게 늘어나지는 않더라고요"
    } ]
  }, {
    "tStartMs": 1853060,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "저는 뭐 한다고 맨날... 진짜 무겁게 돌아와요"
    } ]
  }, {
    "tStartMs": 1859030,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "이것저것 많이 사요"
    } ]
  }, {
    "tStartMs": 1860740,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "그게 더 충분히 여행을 즐기는 거 아니겠습니까?"
    } ]
  }, {
    "tStartMs": 1865760,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "여행 가면 좀 조심해야 되는 게"
    } ]
  }, {
    "tStartMs": 1869570,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "너무 돈을 개념이 없어져가지고"
    } ]
  }, {
    "tStartMs": 1873550,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "환율이 다르니까 돈을 막 쓰게 돼요"
    } ]
  }, {
    "tStartMs": 1877680,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "잘 안 아끼고"
    } ]
  }, {
    "tStartMs": 1880380,
    "dDurationMs": 8360,
    "segs": [ {
      "utf8": "근데 공항 면세점에서 사면 더 싼 편이에요? 비싼 편이에요?"
    } ]
  }, {
    "tStartMs": 1888740,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "음... 싼 것들이 많아요 싼 것들이 많고"
    } ]
  }, {
    "tStartMs": 1893060,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "근데 공항에 딱 도착해서 사려고 하면 재고가 거의 없거든요"
    } ]
  }, {
    "tStartMs": 1897920,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "특히나 화장품 같은 것도 많이 사는데"
    } ]
  }, {
    "tStartMs": 1901810,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "립스틱도 종류가 20개씩 있으면"
    } ]
  }, {
    "tStartMs": 1905090,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "한두 개밖에 없어요 그 매장에는"
    } ]
  }, {
    "tStartMs": 1907580,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "그래서 온라인으로 미리 주문해서"
    } ]
  }, {
    "tStartMs": 1910490,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "픽업하는 걸로 하면 확실히 싸요"
    } ]
  }, {
    "tStartMs": 1914440,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 1915200,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "네 면세 찬스"
    } ]
  }, {
    "tStartMs": 1917730,
    "dDurationMs": 9020,
    "segs": [ {
      "utf8": "근데 그렇게 구매하는 거면 여행 가서 사는 의미는 없네요?"
    } ]
  }, {
    "tStartMs": 1926750,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "그쵸 면세점 이용하는 거는 평소에 갖고 싶었던 걸"
    } ]
  }, {
    "tStartMs": 1929940,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "싸게 사려고 가는 거죠"
    } ]
  }, {
    "tStartMs": 1933090,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "그렇구나"
    } ]
  }, {
    "tStartMs": 1934820,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "근데 또 어떤 나라 면세점에만 파는 것도 있을 수도 있으니까"
    } ]
  }, {
    "tStartMs": 1940160,
    "dDurationMs": 6580,
    "segs": [ {
      "utf8": "그런 거 사면은 선물할 때는 그런 거 사기도 하는 거 같아요"
    } ]
  }, {
    "tStartMs": 1946740,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 1947650,
    "dDurationMs": 5150,
    "segs": [ {
      "utf8": "올해는 여행 계획 없다고 하셨죠?"
    } ]
  }, {
    "tStartMs": 1952800,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "올해는 없어요"
    } ]
  }, {
    "tStartMs": 1953840,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "아마 오래오래 없지 않을까 싶습니다"
    } ]
  }, {
    "tStartMs": 1958210,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "오랫동안"
    } ]
  }, {
    "tStartMs": 1960420,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그거는 왜요?"
    } ]
  }, {
    "tStartMs": 1962590,
    "dDurationMs": 7710,
    "segs": [ {
      "utf8": "저는 이제 좀 초반에 말씀드린 것처럼"
    } ]
  }, {
    "tStartMs": 1970300,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "좀 허슬 모드에 들어가서"
    } ]
  }, {
    "tStartMs": 1973580,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "이제 나는 초청을 받지 않는 이상"
    } ]
  }, {
    "tStartMs": 1977340,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "외국으로 가지 않겠다"
    } ]
  }, {
    "tStartMs": 1980100,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "진짜?"
    } ]
  }, {
    "tStartMs": 1981060,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "여행 충분히 하셨어요?"
    } ]
  }, {
    "tStartMs": 1983650,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "많이 한 것 같아요..."
    } ]
  }, {
    "tStartMs": 1987450,
    "dDurationMs": 8010,
    "segs": [ {
      "utf8": "아니 그렇진 않지만 이제 지금 나는 여행보다"
    } ]
  }, {
    "tStartMs": 1995460,
    "dDurationMs": 8280,
    "segs": [ {
      "utf8": "더.. 음악과 일이 더 재밌다"
    } ]
  }, {
    "tStartMs": 2003740,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "이런 마음을 가지고자 하고 있습니다"
    } ]
  }, {
    "tStartMs": 2007240,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "열심히 사는 모습 보기 좋습니다"
    } ]
  }, {
    "tStartMs": 2009710,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "근데 그렇다는 건 아니에요"
    } ]
  }, {
    "tStartMs": 2011780,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "왜요 왜요 그래 보이는데요"
    } ]
  }, {
    "tStartMs": 2014970,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "그런 척 하는 거예요"
    } ]
  }, {
    "tStartMs": 2017790,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "자기 최면인가"
    } ]
  }, {
    "tStartMs": 2019100,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2019920,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "사실 정말 가고 싶었어요"
    } ]
  }, {
    "tStartMs": 2022270,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "사실 너무 가고 싶어요"
    } ]
  }, {
    "tStartMs": 2024940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "사실 너무 가고 싶어요"
    } ]
  }, {
    "tStartMs": 2026560,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "네, 좀 휴양지에 가고 싶어요"
    } ]
  }, {
    "tStartMs": 2030250,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "아, '일이 재밌다' 계속 생각하고 있는 거구나"
    } ]
  }, {
    "tStartMs": 2034230,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2036010,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "좀 인상 깊었던 공항은 없어요? 여러 나라 가보셨는데"
    } ]
  }, {
    "tStartMs": 2041730,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "하나 딱 고르기는 어려운 것 같은데요"
    } ]
  }, {
    "tStartMs": 2046650,
    "dDurationMs": 7850,
    "segs": [ {
      "utf8": "저는 싱가포르 공항이 정말 스마트했던 걸로 기억이 나요"
    } ]
  }, {
    "tStartMs": 2054500,
    "dDurationMs": 7060,
    "segs": [ {
      "utf8": "뭔가 수하물 붙이는 것도 다 비대면으로 이렇게 깔끔하게 되어 있고"
    } ]
  }, {
    "tStartMs": 2061560,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "진짜 깔끔했어요 공항도 깨끗하고"
    } ]
  }, {
    "tStartMs": 2065310,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "뭐 이런 그 줄 서는 거나 과정들, 짐 붙이고 뭐 면세점 구경하고 하는"
    } ]
  }, {
    "tStartMs": 2071910,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "그 모든 과정이 깔끔하고 깨끗했어요"
    } ]
  }, {
    "tStartMs": 2076700,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "싱가포르 공항이 그 물 떨어지는..."
    } ]
  }, {
    "tStartMs": 2081330,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그랬던 것 같아요"
    } ]
  }, {
    "tStartMs": 2082820,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "아, 맞죠"
    } ]
  }, {
    "tStartMs": 2083700,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "여기도 유명한 걸로 알고 있어요 싱가폴 공항도"
    } ]
  }, {
    "tStartMs": 2086560,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "그렇죠 그거 되게 예쁘던데"
    } ]
  }, {
    "tStartMs": 2091770,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "저는 글쎄요 굳이 하나 생각해보자면"
    } ]
  }, {
    "tStartMs": 2095640,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "두바이 공항?"
    } ]
  }, {
    "tStartMs": 2097310,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "어땠는데요? 두바이도 가보셨어요?"
    } ]
  }, {
    "tStartMs": 2099670,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "아니요 경유하느라..."
    } ]
  }, {
    "tStartMs": 2102560,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "지나가셨구나"
    } ]
  }, {
    "tStartMs": 2103950,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "네 그냥 지나가는 거였는데"
    } ]
  }, {
    "tStartMs": 2105870,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "그냥 너무 넓어서"
    } ]
  }, {
    "tStartMs": 2111010,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "너무 넓어서 도착한 비행기랑 거기서 다음에 타야 할 비행기가"
    } ]
  }, {
    "tStartMs": 2120010,
    "dDurationMs": 5630,
    "segs": [ {
      "utf8": "시간이 꽤 여유로웠는 편인데도 불구하고, 여유로웠는데도"
    } ]
  }, {
    "tStartMs": 2125640,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "그 다음 비행기 타러 가야 하는 길이 너무 길어서"
    } ]
  }, {
    "tStartMs": 2129730,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "좀 마음이 급했던 기억이 있네요"
    } ]
  }, {
    "tStartMs": 2131690,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "공항이 워낙 커서... 엄청 크구나"
    } ]
  }, {
    "tStartMs": 2136540,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "막 입국 심사 이런 거 할 때 어려웠던 적은 없었어요?"
    } ]
  }, {
    "tStartMs": 2140800,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "아니 그게 저는 한 번도 없었어요"
    } ]
  }, {
    "tStartMs": 2145080,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "진짜요?"
    } ]
  }, {
    "tStartMs": 2145550,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2148040,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "전 한 번 있었는데 미국"
    } ]
  }, {
    "tStartMs": 2150210,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "아 미국은 좀 까다롭죠"
    } ]
  }, {
    "tStartMs": 2152070,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2152900,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "어땠어요?"
    } ]
  }, {
    "tStartMs": 2153890,
    "dDurationMs": 6230,
    "segs": [ {
      "utf8": "그게... 그러니까 제가 혼자 갔다면 문제 없었을 수도 있는데"
    } ]
  }, {
    "tStartMs": 2160120,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "학교 프로그램으로 갔던 거거든요"
    } ]
  }, {
    "tStartMs": 2162940,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "근데 그게 학교에서 약간 편법으로"
    } ]
  }, {
    "tStartMs": 2166440,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "뭔가 이렇게 가는 거였나 봐요 전 모르겠어요"
    } ]
  }, {
    "tStartMs": 2169440,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "학교에서 괜찮다고 했으니까 간 건데"
    } ]
  }, {
    "tStartMs": 2174660,
    "dDurationMs": 5470,
    "segs": [ {
      "utf8": "그러니까 한 좀 20명 정도가 갔다고 하면"
    } ]
  }, {
    "tStartMs": 2180130,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "이렇게 따로 서라라고 하더라고요"
    } ]
  }, {
    "tStartMs": 2182880,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "편법인지 아니면 의심스럽게 봐서"
    } ]
  }, {
    "tStartMs": 2185620,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "그렇게 한 건지 그런 거였을 거라고 믿어요"
    } ]
  }, {
    "tStartMs": 2190210,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "그래서 한 3명이서 이렇게 했는데 제가 마지막 순서였는데"
    } ]
  }, {
    "tStartMs": 2194650,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "앞에 2명은 통과했는데 이제 저까지 한국에서 왔고"
    } ]
  }, {
    "tStartMs": 2197970,
    "dDurationMs": 6230,
    "segs": [ {
      "utf8": "뭐 똑같은 기간 동안 머물 거고 하니까 너 저기 방으로 가라 해가지고"
    } ]
  }, {
    "tStartMs": 2204200,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "그 따로 심사를 받아야 되는 방으로 절 보냈어요"
    } ]
  }, {
    "tStartMs": 2208910,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "그래서 거기서 막 물어보는 게"
    } ]
  }, {
    "tStartMs": 2212970,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "너 여기 뭐 남자친구 있어?"
    } ]
  }, {
    "tStartMs": 2215200,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "뭐 걔네 집에서 머물 거야? 뭐 이런 것들을 물어봤어요"
    } ]
  }, {
    "tStartMs": 2220660,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "그래서 뭐 그런 거 아니고 뭐 여행으로 왔다"
    } ]
  }, {
    "tStartMs": 2224640,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "그냥 어디 어디 호텔에서 머물 거다 뭐 이런저런 얘기하고"
    } ]
  }, {
    "tStartMs": 2228580,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "그냥 보내주긴 했는데 좀 무서웠어요"
    } ]
  }, {
    "tStartMs": 2232720,
    "dDurationMs": 7470,
    "segs": [ {
      "utf8": "그때 여러 명 무서운 외국 사람들이 질문하니까"
    } ]
  }, {
    "tStartMs": 2240190,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "음... 또 거긴 혼자 가야 되잖아요"
    } ]
  }, {
    "tStartMs": 2242780,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "보호자 없이 (- 네 맞아요 혼자 가야 됐어요)"
    } ]
  }, {
    "tStartMs": 2246640,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "와... 무서웠겠네요"
    } ]
  }, {
    "tStartMs": 2248420,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "근데 그럴 때마다 정말 느끼는 건 언어가 되면"
    } ]
  }, {
    "tStartMs": 2252800,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "많은 것들이 해결된다"
    } ]
  }, {
    "tStartMs": 2254850,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "네 저는 단 한 번도 없었고"
    } ]
  }, {
    "tStartMs": 2258760,
    "dDurationMs": 7580,
    "segs": [ {
      "utf8": "미국에는 하와이안 셔츠를 입고 가면 입국 심사가 편하다고 들었는데"
    } ]
  }, {
    "tStartMs": 2266340,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "아 진짜요? 저 놀러왔어요 이런 느낌이니까?"
    } ]
  }, {
    "tStartMs": 2273780,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "그럴 수도 있겠다"
    } ]
  }, {
    "tStartMs": 2275330,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2276220,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2278060,
    "dDurationMs": 9170,
    "segs": [ {
      "utf8": "제가 갔을 때는 아시아인 남녀가 같이 오거나 그러면 좀 어렵다?"
    } ]
  }, {
    "tStartMs": 2287230,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "까다롭게 본다? 꼼꼼하게 본다?"
    } ]
  }, {
    "tStartMs": 2289760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "뭐 이런 것도 있었어요"
    } ]
  }, {
    "tStartMs": 2291840,
    "dDurationMs": 5630,
    "segs": [ {
      "utf8": "그렇군요 그러게요 저는..."
    } ]
  }, {
    "tStartMs": 2297470,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "외국에 여러 번 나가본 것 치고는"
    } ]
  }, {
    "tStartMs": 2302800,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "그렇게 공항에서 잡혔다던가"
    } ]
  }, {
    "tStartMs": 2307860,
    "dDurationMs": 6490,
    "segs": [ {
      "utf8": "그런 적도 한 번도 없고 사실 길거리나 식당에서"
    } ]
  }, {
    "tStartMs": 2314350,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "차별을 받거나 놀림을 받거나 그런 적도 사실은 한 번도 없어요"
    } ]
  }, {
    "tStartMs": 2319540,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "음 진짜요?"
    } ]
  }, {
    "tStartMs": 2321790,
    "dDurationMs": 6130,
    "segs": [ {
      "utf8": "네 아직 내가 많이 안 다녀본 건지"
    } ]
  }, {
    "tStartMs": 2327920,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "저도 많진 않은데 없진 않았거든요"
    } ]
  }, {
    "tStartMs": 2331840,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "길에서 뭐라 얘기하시는 분들도 있긴 했는데"
    } ]
  }, {
    "tStartMs": 2337450,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "근데 뭐 너무 오래 머무르니까 누가 봐도 의심스럽지 않으면"
    } ]
  }, {
    "tStartMs": 2341510,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "웬만하면 잘 잡는 것 같진 않아요"
    } ]
  }, {
    "tStartMs": 2344750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "딱 목적을 확실히 얘기하면"
    } ]
  }, {
    "tStartMs": 2346880,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "큰 문제는 없어 보였어요"
    } ]
  }, {
    "tStartMs": 2351290,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 2352540,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "그러면 마지막으로 저는 공항에서"
    } ]
  }, {
    "tStartMs": 2355980,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "면세점을 주로 이용을 한다고 했고 태웅쌤은 식당 자주 이용하신다 했는데"
    } ]
  }, {
    "tStartMs": 2362480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "식당이랑 편의점 어떤 거 드세요?"
    } ]
  }, {
    "tStartMs": 2365180,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "출국 전에 좀 땡기는 자주 먹는 음식이 있을까요?"
    } ]
  }, {
    "tStartMs": 2370370,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "저는 때에 따라 다른데"
    } ]
  }, {
    "tStartMs": 2374190,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "시간이 촉박하다 그러면 그냥 간단하게 샌드위치 같은 거 먹는 편이고요"
    } ]
  }, {
    "tStartMs": 2379650,
    "dDurationMs": 8700,
    "segs": [ {
      "utf8": "근데 만약에 한 며칠 오랫동안 외국에 갔다 와야 한다"
    } ]
  }, {
    "tStartMs": 2388350,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "그러면 꼭 김치와 관련된 메뉴?"
    } ]
  }, {
    "tStartMs": 2393910,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "한식 좀 땡기긴 하는데 그중에서도 김치 들어간 거?"
    } ]
  }, {
    "tStartMs": 2398140,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "김치볶음밥?"
    } ]
  }, {
    "tStartMs": 2399550,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "김치찌개?"
    } ]
  }, {
    "tStartMs": 2400740,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "김치찌개"
    } ]
  }, {
    "tStartMs": 2401950,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "음, 알아요 저도 그 마음을 알아요"
    } ]
  }, {
    "tStartMs": 2405240,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "네, 아니면 김치는 안 들어갔지만 육개장"
    } ]
  }, {
    "tStartMs": 2409440,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "얼큰한 거?"
    } ]
  }, {
    "tStartMs": 2410910,
    "dDurationMs": 430,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2411340,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "그렇죠, 그렇죠 좀 오래 있어야 되면"
    } ]
  }, {
    "tStartMs": 2416450,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "그런 거 먹어줘야죠"
    } ]
  }, {
    "tStartMs": 2418370,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2420870,
    "dDurationMs": 7410,
    "segs": [ {
      "utf8": "그 인천공항에 아마 좀 유명한 육개장 칼국수 식당이 있을걸요?"
    } ]
  }, {
    "tStartMs": 2428280,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "진짜요?"
    } ]
  }, {
    "tStartMs": 2429490,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "네 네"
    } ]
  }, {
    "tStartMs": 2430910,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "어딘데요? 몰랐어요"
    } ]
  }, {
    "tStartMs": 2433180,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "그래서 제 누나가 가르쳐줬었는데"
    } ]
  }, {
    "tStartMs": 2436270,
    "dDurationMs": 5890,
    "segs": [ {
      "utf8": "그 공항 가면 무조건 육(개장)칼(국수) 먹고 가야 된다"
    } ]
  }, {
    "tStartMs": 2442160,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "근데 맛있더라고요"
    } ]
  }, {
    "tStartMs": 2443470,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "'황생가 칼국수'가 있는데"
    } ]
  }, {
    "tStartMs": 2447420,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "제가 알기로는 여기 그냥 유명한 식당인 걸로 알고 있거든요"
    } ]
  }, {
    "tStartMs": 2451500,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "미슐랭 칼국수집인데 그게 있나 보네요 2 터미널에 있대요"
    } ]
  }, {
    "tStartMs": 2457860,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "오 (- 좋다) 제가 전에 먹었을 때는 미슐랭은 아니었던 것 같은데"
    } ]
  }, {
    "tStartMs": 2464340,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "그래요? 먹긴 먹었었어요?"
    } ]
  }, {
    "tStartMs": 2466450,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2470460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "이거 괜찮다"
    } ]
  }, {
    "tStartMs": 2472350,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "네 한국의 맛"
    } ]
  }, {
    "tStartMs": 2474830,
    "dDurationMs": 6110,
    "segs": [ {
      "utf8": "한국에서 돌아가실 때도 이거 먹어도 좋을 것 같아요 당분간 못 먹으니까"
    } ]
  }, {
    "tStartMs": 2480940,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 2482270,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "그렇구나 저도 한식 많이 먹고"
    } ]
  }, {
    "tStartMs": 2484370,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "아니면 저는 롯데리아가 인천공항에 있거든요"
    } ]
  }, {
    "tStartMs": 2490570,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "거기를 진짜 제일 많이 간 거 같아요"
    } ]
  }, {
    "tStartMs": 2493530,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "좀 편하고 빨리 먹을 수 있으니까"
    } ]
  }, {
    "tStartMs": 2496630,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "좋죠"
    } ]
  }, {
    "tStartMs": 2498740,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "저는 한우 불고기 버거를 추천해요"
    } ]
  }, {
    "tStartMs": 2501270,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "그 롯데리아에서 이게 약간 한국적인 맛이거든요"
    } ]
  }, {
    "tStartMs": 2505920,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "그래서 외국분들도 먹어볼 만 할 거 같아요"
    } ]
  }, {
    "tStartMs": 2509410,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "저도 그거 잘 먹습니다"
    } ]
  }, {
    "tStartMs": 2510860,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그거 좋아하세요?"
    } ]
  }, {
    "tStartMs": 2512270,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2513280,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "맛있죠?"
    } ]
  }, {
    "tStartMs": 2515250,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "저는 한우불고기버거에 베이컨 추가하고"
    } ]
  }, {
    "tStartMs": 2521220,
    "dDurationMs": 6530,
    "segs": [ {
      "utf8": "베이컨 추가하고 그리고 감자는 라지 사이즈로 바꿔서"
    } ]
  }, {
    "tStartMs": 2527750,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "양념감자 스프 칠리 추가하고"
    } ]
  }, {
    "tStartMs": 2530580,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "아는 사람"
    } ]
  }, {
    "tStartMs": 2532980,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "양념감자 무조건이죠?"
    } ]
  }, {
    "tStartMs": 2534950,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "무조건이죠 그렇게 해서 먹습니다"
    } ]
  }, {
    "tStartMs": 2539080,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "되게 호화롭게 드시네요"
    } ]
  }, {
    "tStartMs": 2541410,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "그거 안 그래도 좀 비싼데? 한우불고기"
    } ]
  }, {
    "tStartMs": 2544950,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "그렇게 해야 시켜 먹을 때 배달 취소 금액이 맞춰져서"
    } ]
  }, {
    "tStartMs": 2550090,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "진짜요?"
    } ]
  }, {
    "tStartMs": 2551490,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "아 그래서~ 태웅쌤 콤보네 이것도"
    } ]
  }, {
    "tStartMs": 2556560,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "한우불고기 먹고 베이컨 추가한 다음에 양 많으신 분들은"
    } ]
  }, {
    "tStartMs": 2560860,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "감자튀김 큰 거에다가 아무튼 양념감자로 변경하시는 게 좋고"
    } ]
  }, {
    "tStartMs": 2566300,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "저는 치즈 좋아하는데 매콤한 거 먹고 싶으면 칠리도 자주 먹어요"
    } ]
  }, {
    "tStartMs": 2571390,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "저는 무조건 칠리로만 먹습니다"
    } ]
  }, {
    "tStartMs": 2574840,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "여러분들도 참고해주시고 추천입니다"
    } ]
  }, {
    "tStartMs": 2578130,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2579100,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "좋아요 이제 그러면 퀴즈 드리고 마무리해보려고 하는데요"
    } ]
  }, {
    "tStartMs": 2582280,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "이번 주 퀴즈는"
    } ]
  }, {
    "tStartMs": 2583780,
    "dDurationMs": 6430,
    "segs": [ {
      "utf8": "저 디디랑 태웅쌤이 공항에서 자주 이용하지 않는 시설 골라주시면 됩니다"
    } ]
  }, {
    "tStartMs": 2590210,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "1번은 식당이고요"
    } ]
  }, {
    "tStartMs": 2593450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "2번은 면세점"
    } ]
  }, {
    "tStartMs": 2596330,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "3번은 약국입니다"
    } ]
  }, {
    "tStartMs": 2599550,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "식당, 면세점, 약국 중에서 저희가 자주 이용하지 않는 시설"
    } ]
  }, {
    "tStartMs": 2604540,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "댓글에 써주시거나"
    } ]
  }, {
    "tStartMs": 2605640,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "유튜브에 있는 투표 기능으로 체크해 주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 2610280,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "그러면 저희는 다음 게임 코너로 넘어가 보겠습니다"
    } ]
  }, {
    "tStartMs": 2614300,
    "dDurationMs": 10560,
    "segs": [ {
      "utf8": "\u003c말로 하는 미니게임\u003e"
    } ]
  }, {
    "tStartMs": 2624860,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "네, 오늘 게임은 스피디하게 한 판으로 끝내보려고 하고요"
    } ]
  }, {
    "tStartMs": 2629800,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "한국에서 유명한 게임이에요"
    } ]
  }, {
    "tStartMs": 2631640,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "원래는 '시장에 가면' 이라는 게임이라고 해서"
    } ]
  }, {
    "tStartMs": 2635280,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "시장에 있는 물건들을 계속 이어서 말하는 거예요"
    } ]
  }, {
    "tStartMs": 2639200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "한번 연습 게임 해볼까요?"
    } ]
  }, {
    "tStartMs": 2641680,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "시장에 가면 당근도 있고~"
    } ]
  }, {
    "tStartMs": 2644510,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "시장에 가면... 이거 계속 얘기해야 되는 거죠?"
    } ]
  }, {
    "tStartMs": 2646940,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "이어가야 돼요 당근도 있고 뭐도 있고 이렇게"
    } ]
  }, {
    "tStartMs": 2650770,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "'시장에 가면~~' 이걸 해야 되죠?"
    } ]
  }, {
    "tStartMs": 2652220,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "네 해야 돼요"
    } ]
  }, {
    "tStartMs": 2653790,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "그렇구나 좋습니다"
    } ]
  }, {
    "tStartMs": 2655000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "시장에 가면 당근도 있고~"
    } ]
  }, {
    "tStartMs": 2657800,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "양파도 있고~"
    } ]
  }, {
    "tStartMs": 2659150,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "시장에 가면 당근도 있고~ 양파도 있고~"
    } ]
  }, {
    "tStartMs": 2662450,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "+ 파도 있고~"
    } ]
  }, {
    "tStartMs": 2663650,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "시장에 가면 당근도 있고~ 양파도 있고~ 파도 있고~"
    } ]
  }, {
    "tStartMs": 2668650,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "+ 넙치도 있고~"
    } ]
  }, {
    "tStartMs": 2670650,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "시장에 가면 당근도 있고~ 양파도 있고~ 파도 있고~ 넙치도 있고~"
    } ]
  }, {
    "tStartMs": 2676310,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "+ 아줌마도 있고~"
    } ]
  }, {
    "tStartMs": 2677650,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "시장에 가면 당근도 있고~ 양파도 있고~ 파도 있고~"
    } ]
  }, {
    "tStartMs": 2682250,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "넙치도 있고~ 아줌마도 있고~"
    } ]
  }, {
    "tStartMs": 2684740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "+ 아저씨도 있고~"
    } ]
  }, {
    "tStartMs": 2686240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "시장에 가면 당근도 있고"
    } ]
  }, {
    "tStartMs": 2688080,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "양파도 있고 파도 있고 넙치도 있고 아줌마도 있고"
    } ]
  }, {
    "tStartMs": 2691240,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "아저씨도 있고..."
    } ]
  }, {
    "tStartMs": 2692680,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "컵도 있고..."
    } ]
  }, {
    "tStartMs": 2694490,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "컵이요?"
    } ]
  }, {
    "tStartMs": 2695300,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2697540,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "컵이요?"
    } ]
  }, {
    "tStartMs": 2698240,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "시장에 컵 팔죠"
    } ]
  }, {
    "tStartMs": 2699300,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "아니 뭐 그냥 물도 있다고 하죠"
    } ]
  }, {
    "tStartMs": 2704150,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "물도 있고 파리도 있고 다 있죠 다 있죠"
    } ]
  }, {
    "tStartMs": 2707660,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "아무튼 이제!"
    } ]
  }, {
    "tStartMs": 2708720,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "이런 식으로 계속 메모리 게임이죠 이어가는 겁니다"
    } ]
  }, {
    "tStartMs": 2713180,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 2714780,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "한 10개가 최대지 않을까 생각하는데 (-쉽지 않은데...)"
    } ]
  }, {
    "tStartMs": 2719680,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "약한데 이런거"
    } ]
  }, {
    "tStartMs": 2720950,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "한 판입니다"
    } ]
  }, {
    "tStartMs": 2722800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "누가 먼저 할까요?"
    } ]
  }, {
    "tStartMs": 2724420,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "디디님부터 하세요"
    } ]
  }, {
    "tStartMs": 2726220,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "알겠습니다 시작하겠습니다"
    } ]
  }, {
    "tStartMs": 2729700,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "공항에 가면 승무원도 있고"
    } ]
  }, {
    "tStartMs": 2732720,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "공항에 가면 승무원도 있고"
    } ]
  }, {
    "tStartMs": 2736740,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "파일럿도 있고"
    } ]
  }, {
    "tStartMs": 2738530,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "공항에 가면 승무원도 있고, 파일럿도 있고,"
    } ]
  }, {
    "tStartMs": 2741780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "기내식도 있고"
    } ]
  }, {
    "tStartMs": 2743460,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "공항에..."
    } ]
  }, {
    "tStartMs": 2745120,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "잠시만요"
    } ]
  }, {
    "tStartMs": 2747060,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "기내식은 공항에 있다고는 할 수 없지 않나요?"
    } ]
  }, {
    "tStartMs": 2750160,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "기내식이 공항에서 이제 비행기로 넣어주죠"
    } ]
  }, {
    "tStartMs": 2753710,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "공항에 있는 거 확실한가요?"
    } ]
  }, {
    "tStartMs": 2755650,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "공항에서 그럼요"
    } ]
  }, {
    "tStartMs": 2756990,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "공항에 비행기가 있지 않습니까?"
    } ]
  }, {
    "tStartMs": 2760380,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "그러니까 비행기에게 실으려면 이 음식이 어디 있어야 할까요?"
    } ]
  }, {
    "tStartMs": 2765230,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "아 알겠습니다"
    } ]
  }, {
    "tStartMs": 2768250,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "공항에 가면 승무원도 있고 파일럿도 있고 기내식도 있고"
    } ]
  }, {
    "tStartMs": 2773510,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "편의점도 있고"
    } ]
  }, {
    "tStartMs": 2774780,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "공항에 가면 승무원도 있고 파일럿도 있고 기내식도 있고"
    } ]
  }, {
    "tStartMs": 2779370,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "편의점도 있고 식당도 있고"
    } ]
  }, {
    "tStartMs": 2782550,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "공항에 가면 승무원도 있고 파일럿도 있고"
    } ]
  }, {
    "tStartMs": 2786630,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "기내식도 있고 편의점도 있고"
    } ]
  }, {
    "tStartMs": 2790170,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "식당도 있고"
    } ]
  }, {
    "tStartMs": 2794110,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "통신사도 있고"
    } ]
  }, {
    "tStartMs": 2795720,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "공항에 가면 승무원도 있고 파일럿도 있고"
    } ]
  }, {
    "tStartMs": 2800500,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "기내식도 있고 편의점도 있고"
    } ]
  }, {
    "tStartMs": 2802460,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "식당도 있고 통신사도 있고"
    } ]
  }, {
    "tStartMs": 2806250,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "휴게소도 있고"
    } ]
  }, {
    "tStartMs": 2808190,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "휴게소요?"
    } ]
  }, {
    "tStartMs": 2811100,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "아이!"
    } ]
  }, {
    "tStartMs": 2812160,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "사람들 어디서 쉬어요 그러면?"
    } ]
  }, {
    "tStartMs": 2815710,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "휴게소... 휴게소라고요?"
    } ]
  }, {
    "tStartMs": 2817980,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "휴게실!"
    } ]
  }, {
    "tStartMs": 2819550,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "휴게실?"
    } ]
  }, {
    "tStartMs": 2822960,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "휴게실 휴게하는 장소"
    } ]
  }, {
    "tStartMs": 2825630,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "휴게실이라고 했나요?"
    } ]
  }, {
    "tStartMs": 2828420,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "휴게소 안 되나요?"
    } ]
  }, {
    "tStartMs": 2830750,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "휴게소 고속도로에 있는 게 휴게소 아니에요?"
    } ]
  }, {
    "tStartMs": 2834430,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "'휴게소 가자'... 그런가? 안 되나?"
    } ]
  }, {
    "tStartMs": 2839050,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "알겠습니다 일단"
    } ]
  }, {
    "tStartMs": 2840200,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "심지어 휴게실이 있는지도 모르겠어요 있나요? 휴게실"
    } ]
  }, {
    "tStartMs": 2844510,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "아니 그거 다 휴게실 아니에요?"
    } ]
  }, {
    "tStartMs": 2845930,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "그건 그래요 딱히 휴게실이 있진 않아"
    } ]
  }, {
    "tStartMs": 2848760,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "아, 그쵸"
    } ]
  }, {
    "tStartMs": 2849990,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "아, 한 번만 넘어가요 한 번만"
    } ]
  }, {
    "tStartMs": 2852440,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "뭐 있는지 재밌으니까"
    } ]
  }, {
    "tStartMs": 2853660,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "오케이, 오케이, 오케이 그럼 뭘로 할 겁니까?"
    } ]
  }, {
    "tStartMs": 2856790,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "어, 어, 어, 카페도 있고"
    } ]
  }, {
    "tStartMs": 2860490,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "하... 공항에 가면 승무원도 있고,"
    } ]
  }, {
    "tStartMs": 2864080,
    "dDurationMs": 8910,
    "segs": [ {
      "utf8": "파일럿도 있고, 기내식도 있고, 편의점도 있고,"
    } ]
  }, {
    "tStartMs": 2872990,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "편의점도 있고... 잠시만요"
    } ]
  }, {
    "tStartMs": 2877870,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "식당도 있고"
    } ]
  }, {
    "tStartMs": 2880340,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "좋아요"
    } ]
  }, {
    "tStartMs": 2881580,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "카페도 있고"
    } ]
  }, {
    "tStartMs": 2883460,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "아니야 통신사!"
    } ]
  }, {
    "tStartMs": 2887390,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "어차피 한계였네요"
    } ]
  }, {
    "tStartMs": 2889490,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "근데 제가 진 게 맞아요 휴게소 없었어요"
    } ]
  }, {
    "tStartMs": 2893110,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "힘들다 이런 류의 게임 너무 힘듭니다"
    } ]
  }, {
    "tStartMs": 2894970,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "이런 류의 게임인데 재밌죠?"
    } ]
  }, {
    "tStartMs": 2897340,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "손에 땀이 줄줄 났네요"
    } ]
  }, {
    "tStartMs": 2901600,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "머리를 잘 돌려야 돼요 이거 잘 기억해야 되고"
    } ]
  }, {
    "tStartMs": 2904750,
    "dDurationMs": 4970,
    "segs": [ {
      "utf8": "뭐 있는지도 생각하면서 기억도 해야 되니까 머리 많이 쓰는 게임"
    } ]
  }, {
    "tStartMs": 2909720,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "코르티졸 수치가 올라갔었습니다"
    } ]
  }, {
    "tStartMs": 2911470,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "재밌었어요 감사합니다"
    } ]
  }, {
    "tStartMs": 2914560,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "오늘도 이렇게 공항에 대해서 요모조모 이야기를 해봤고요"
    } ]
  }, {
    "tStartMs": 2917750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "이제 다음 주제 한번 생각해 보겠습니다"
    } ]
  }, {
    "tStartMs": 2920000,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "다음 주제는요"
    } ]
  }, {
    "tStartMs": 2921880,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "친구 이런 걸로 해볼까?"
    } ]
  }, {
    "tStartMs": 2924150,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "친구?"
    } ]
  }, {
    "tStartMs": 2925970,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "친구 괜찮죠?"
    } ]
  }, {
    "tStartMs": 2927100,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "친구로 해볼까요?"
    } ]
  }, {
    "tStartMs": 2928190,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "그걸로 해요 좋다 좋다"
    } ]
  }, {
    "tStartMs": 2930460,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "다음 주제는 어떤 걸로 하면 좋을까요 태웅쌤?"
    } ]
  }, {
    "tStartMs": 2934020,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "다음 주제는 바로바로 친구입니다"
    } ]
  }, {
    "tStartMs": 2937250,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "친구! 아 이게 살다 보니까"
    } ]
  }, {
    "tStartMs": 2941430,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "이제 점점 친구가 없어지는 것 같다 이런 고민도 하게 되고"
    } ]
  }, {
    "tStartMs": 2944990,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "뭐 진정한 친구란 뭘까 뭐 이런저런 생각을 하게 되는데"
    } ]
  }, {
    "tStartMs": 2948740,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "다음 에피소드에서는 친구에 대해서"
    } ]
  }, {
    "tStartMs": 2951470,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "진득하게 한번 이야기를 해볼 수 있었으면 좋겠습니다"
    } ]
  }, {
    "tStartMs": 2956130,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "깊은 대화를 할 수 있겠네요"
    } ]
  }, {
    "tStartMs": 2958070,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "깊은 대화를 또 오랜만에 해보아요"
    } ]
  }, {
    "tStartMs": 2960450,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 2961250,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "네, 그러면 이제 저희는 다음 달에 친구에 대해서"
    } ]
  }, {
    "tStartMs": 2966580,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "또 요모조모 이야기 해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 2969280,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "여기까지 디디와"
    } ]
  }, {
    "tStartMs": 2971560,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "정태웅이었습니다"
    } ]
  }, {
    "tStartMs": 2972450,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "감사합니다"
    } ]
  } ]
}
