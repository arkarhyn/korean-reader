    "tStartMs": 2150000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "so she couldn't bring herself to join group 2 because her pride was hurt."
    } ]
  }, {
    "tStartMs": 2154000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yeah, that could happen."
    } ]
  }, {
    "tStartMs": 2156000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So I thought of her as someone caught in the middle,"
    } ]
  }, {
    "tStartMs": 2160000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but when those girls were categorizing people,"
    } ]
  }, {
    "tStartMs": 2164000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "they put that friend into group 1."
    } ]
  }, {
    "tStartMs": 2169000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So she was really taken aback,"
    } ]
  }, {
    "tStartMs": 2172000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but the only person she"
    } ]
  }, {
    "tStartMs": 2174000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "described as that in-between person"
    } ]
  }, {
    "tStartMs": 2178000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "was me."
    } ]
  }, {
    "tStartMs": 2180000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yeah, jealousy."
    } ]
  }, {
    "tStartMs": 2182000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That must have been it."
    } ]
  }, {
    "tStartMs": 2186000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 2188000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Anyway, it seems like groups divide between boys and girls like that."
    } ]
  }, {
    "tStartMs": 2194000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "As I was listening, I remembered something—"
    } ]
  }, {
    "tStartMs": 2197000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "at my school, the boys had a soccer group"
    } ]
  }, {
    "tStartMs": 2203000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and a basketball group,"
    } ]
  }, {
    "tStartMs": 2205000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "there were the boys who played soccer,"
    } ]
  }, {
    "tStartMs": 2207000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and there were the boys who played basketball,"
    } ]
  }, {
    "tStartMs": 2209000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and then there were the others."
    } ]
  }, {
    "tStartMs": 2213000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Was it because there were so many students?"
    } ]
  }, {
    "tStartMs": 2215000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Maybe that's why?"
    } ]
  }, {
    "tStartMs": 2218000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It's hard to categorize groups,"
    } ]
  }, {
    "tStartMs": 2221000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but the kids who played soccer and basketball"
    } ]
  }, {
    "tStartMs": 2223000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "were always visible at lunchtime, you know?"
    } ]
  }, {
    "tStartMs": 2226000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "They really stood out."
    } ]
  }, {
    "tStartMs": 2228000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So I thought, \"Those guys, those guys,\""
    } ]
  }, {
    "tStartMs": 2230000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and then the rest, like that."
    } ]
  }, {
    "tStartMs": 2236000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But we were divided into separate classes."
    } ]
  }, {
    "tStartMs": 2239000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So between them,"
    } ]
  }, {
    "tStartMs": 2242000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "there might have been invisible"
    } ]
  }, {
    "tStartMs": 2244000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "group structures that we didn't even know about."
    } ]
  }, {
    "tStartMs": 2249000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That must have been it."
    } ]
  }, {
    "tStartMs": 2251000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yeah, probably."
    } ]
  }, {
    "tStartMs": 2253000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I don't think I was that interested in science either,"
    } ]
  }, {
    "tStartMs": 2260000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and I'll talk about this in the next episode,"
    } ]
  }, {
    "tStartMs": 2263000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but I really liked hanging out with teachers and stuff like that."
    } ]
  }, {
    "tStartMs": 2266000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "In high school."
    } ]
  }, {
    "tStartMs": 2268000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "In high school?"
    } ]
  }, {
    "tStartMs": 2269000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Like, during breaks I'd go to the staff room and talk with friends"
    } ]
  }, {
    "tStartMs": 2275000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and had experiences like that."
    } ]
  }, {
    "tStartMs": 2278000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That sounds really nice."
    } ]
  }, {
    "tStartMs": 2281000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'll go into more detail about it in the next episode."
    } ]
  }, {
    "tStartMs": 2284000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Sounds good."
    } ]
  }, {
    "tStartMs": 2286000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So how was the college entrance exam for you? Did you take it, Tae-woong?"
    } ]
  }, {
    "tStartMs": 2289000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Did you take the exam?"
    } ]
  }, {
    "tStartMs": 2291000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I bombed the college entrance exam."
    } ]
  }, {
    "tStartMs": 2295000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "To tell you the conclusion first—"
    } ]
  }, {
    "tStartMs": 2297000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yeah, I completely messed up the exam."
    } ]
  }, {
    "tStartMs": 2300000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You really wanted to do well but ended up bombing it?"
    } ]
  }, {
    "tStartMs": 2303000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2306000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I really wanted to do well but completely messed it up,"
    } ]
  }, {
    "tStartMs": 2310000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and after that—"
    } ]
  }, {
    "tStartMs": 2312000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "after that—"
    } ]
  }, {
    "tStartMs": 2314000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I found myself again, you could say."
    } ]
  }, {
    "tStartMs": 2318000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It turned out to be a great opportunity."
    } ]
  }, {
    "tStartMs": 2320000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Absolutely. Absolutely."
    } ]
  }, {
    "tStartMs": 2322000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But I still don't understand why people"
    } ]
  }, {
    "tStartMs": 2326000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "stake their lives on university like that."
    } ]
  }, {
    "tStartMs": 2329000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I didn't understand it back then either,"
    } ]
  }, {
    "tStartMs": 2331000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and I still don't quite get it."
    } ]
  }, {
    "tStartMs": 2335000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2336000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "South Korea"
    } ]
  }, {
    "tStartMs": 2338000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is intense."
    } ]
  }, {
    "tStartMs": 2341000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's an interesting country."
    } ]
  }, {
    "tStartMs": 2345000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It seems like an unforgettable memory."
    } ]
  }, {
    "tStartMs": 2349000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "How about that? Should we"
    } ]
  }, {
    "tStartMs": 2351000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "wrap up high school here? End the school series?"
    } ]
  }, {
    "tStartMs": 2354000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes. It feels like"
    } ]
  }, {
    "tStartMs": 2356000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "it's ending on a rather bitter note."
    } ]
  }, {
    "tStartMs": 2360000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And to finish things a bit more cheerfully,"
    } ]
  }, {
    "tStartMs": 2365000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "after high school ended and I took the college entrance exam like that,"
    } ]
  }, {
    "tStartMs": 2369000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and went to university,"
    } ]
  }, {
    "tStartMs": 2372000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I was really happy."
    } ]
  }, {
    "tStartMs": 2374000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Not having to study anymore"
    } ]
  }, {
    "tStartMs": 2377000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "felt so good,"
    } ]
  }, {
    "tStartMs": 2379000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and after that, I could really do whatever I wanted—"
    } ]
  }, {
    "tStartMs": 2382000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "travel around,"
    } ]
  }, {
    "tStartMs": 2384000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "hang out with friends whenever I felt like it,"
    } ]
  }, {
    "tStartMs": 2387000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and that was great."
    } ]
  }, {
    "tStartMs": 2389000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "So just in case,"
    } ]
  }, {
    "tStartMs": 2390000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Right. There are probably people in other countries right now"
    } ]
  }, {
    "tStartMs": 2393000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "studying hard for university,"
    } ]
  }, {
    "tStartMs": 2399000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "and when it ends,"
    } ]
  }, {
    "tStartMs": 2401000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "Yes, so let's wrap up here for today,"
    } ]
  }, {
    "tStartMs": 2410000,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "and next week's topic is something we've been thinking about,"
    } ]
  }, {
    "tStartMs": 2414800,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "and as a continuation, I'd like to talk about teachers."
    } ]
  }, {
    "tStartMs": 2420000,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Because this episode and the next episode will be released,"
    } ]
  }, {
    "tStartMs": 2423400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and the next day is Teachers' Day,"
    } ]
  }, {
    "tStartMs": 2425600,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "so we'll talk about teachers from various angles."
    } ]
  }, {
    "tStartMs": 2429000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "Yes, so this has been Didi and Jeong Tae-woong. Thank you."
    } ]
  } ]
}
