  }, {
    "tStartMs": 2148440,
    "dDurationMs": 4519,
    "segs": [ {
      "utf8": "I, um."
    } ]
  }, {
    "tStartMs": 2152959,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "I don't have any particular memories of it."
