  }, {
    "tStartMs": 2155880,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 2156640,
    "dDurationMs": 5759,
    "segs": [ {
      "utf8": "But I think I got hit a lot."
    } ]
  }, {
    "tStartMs": 2162399,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "For various things."
    } ]
  }, {
    "tStartMs": 2163600,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 2164519,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Hit with hands too."
    } ]
  }, {
    "tStartMs": 2165920,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Oh, I don't think I got hit with hands."
