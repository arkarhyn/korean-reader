  }, {
    "tStartMs": 2226040,
    "dDurationMs": 919,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2226959,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Ah, thinking about it now, it doesn't even seem like we did anything that wrong."
