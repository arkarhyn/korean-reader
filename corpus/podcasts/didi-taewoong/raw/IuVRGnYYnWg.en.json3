  }, {
    "tStartMs": 2186559,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "Yeah, because we were noisy, that's right."
    } ]
  }, {
    "tStartMs": 2189000,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "When I was in sixth grade of elementary school,"
