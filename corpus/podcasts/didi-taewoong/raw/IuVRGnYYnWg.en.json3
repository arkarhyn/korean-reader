  }, {
    "tStartMs": 2065359,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "My memory is a bit fuzzy."
    } ]
  }, {
    "tStartMs": 2067720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "How did I even manage it?"
    } ]
  }, {
    "tStartMs": 2069600,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Right?"
    } ]
  }, {
    "tStartMs": 2070640,
    "dDurationMs": 1879,
    "segs": [ {
      "utf8": "The parents must have been happy."
    } ]
  }, {
    "tStartMs": 2072519,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2074200,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "Since school was on weekends, the kids..."
    } ]
  }, {
    "tStartMs": 2076959,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 2078760,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 2080359,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "Now it feels like such an old story."
    } ]
  }, {
    "tStartMs": 2082000,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "I think I have memories of certain parts of it."
    } ]
  }, {
    "tStartMs": 2085160,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Good memories."
    } ]
  }, {
    "tStartMs": 2085959,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2087079,
    "dDurationMs": 5521,
    "segs": [ {
      "utf8": "Didi, did you do your summer homework well?"
    } ]
  }, {
    "tStartMs": 2092600,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Um."
    } ]
  }, {
    "tStartMs": 2093640,
    "dDurationMs": 3039,
    "segs": [ {
      "utf8": "I did the things I liked."
    } ]
  }, {
    "tStartMs": 2096679,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I didn't really struggle because of summer homework or anything like that."
    } ]
  }, {
    "tStartMs": 2100519,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 2103040,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "You know how there's summer homework where you write a diary?"
    } ]
  }, {
    "tStartMs": 2105760,
    "dDurationMs": 519,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 2106279,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "Did you write all of it?"
    } ]
  }, {
    "tStartMs": 2108040,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "I think I did write it all."
    } ]
  }, {
    "tStartMs": 2109239,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "Every day?"
    } ]
  }, {
    "tStartMs": 2110720,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Well, there were days when I crammed and wrote a bunch at once."
    } ]
  }, {
    "tStartMs": 2113880,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "But I really hated getting scolded."
