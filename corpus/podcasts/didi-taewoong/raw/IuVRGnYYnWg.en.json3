  }, {
    "tStartMs": 2124959,
    "dDurationMs": 761,
    "segs": [ {
      "utf8": "Definitely?"
    } ]
  }, {
    "tStartMs": 2125720,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2127000,
    "dDurationMs": 3279,
    "segs": [ {
      "utf8": "Oh, that must have been tough?"
    } ]
  }, {
    "tStartMs": 2130279,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "The day before school started, really."
    } ]
  }, {
    "tStartMs": 2132160,
    "dDurationMs": 1519,
    "segs": [ {
      "utf8": "Right, my hand was throbbing."
    } ]
  }, {
    "tStartMs": 2133679,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It must have been chaos?"
    } ]
  }, {
    "tStartMs": 2136519,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "I remember my hand throbbing."
    } ]
  }, {
    "tStartMs": 2138959,
    "dDurationMs": 4641,
    "segs": [ {
      "utf8": "Oh, and Korea used to allow corporal punishment back then, right?"
    } ]
  }, {
    "tStartMs": 2143600,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Oh, that's right."
    } ]
  }, {
    "tStartMs": 2145720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Do you remember getting hit in elementary school?"
