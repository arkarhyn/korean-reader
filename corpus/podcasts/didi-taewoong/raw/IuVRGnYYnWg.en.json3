  }, {
    "tStartMs": 2254880,
    "dDurationMs": 3239,
    "segs": [ {
      "utf8": "Ah, well, I didn't get hit that much in high school,"
    } ]
  }, {
    "tStartMs": 2258119,
    "dDurationMs": 921,
    "segs": [ {
      "utf8": "mm."
    } ]
  }, {
    "tStartMs": 2259040,
    "dDurationMs": 3919,
    "segs": [ {
      "utf8": "but I still had to live in fear."
    } ]
  }, {
    "tStartMs": 2262959,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2263519,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "These kinds of physical punishments and rules,"
    } ]
  }, {
    "tStartMs": 2266119,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "they got worse as you went up in grades,"
    } ]
  }, {
    "tStartMs": 2269200,
    "dDurationMs": 3079,
    "segs": [ {
      "utf8": "so I think we can tell the story more interestingly"
    } ]
  }, {
    "tStartMs": 2272279,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "with middle school episodes."
    } ]
  }, {
    "tStartMs": 2273600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2275200,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 2276359,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "There was also that thing in elementary school, you know?"
    } ]
  }, {
    "tStartMs": 2279480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "That RCY, Girl Scouts."
    } ]
  }, {
    "tStartMs": 2282200,
    "dDurationMs": 879,
    "segs": [ {
      "utf8": "Huh?"
    } ]
  }, {
    "tStartMs": 2283079,
    "dDurationMs": 681,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 2283760,
    "dDurationMs": 1639,
    "segs": [ {
      "utf8": "You didn't have Boy Scouts?"
    } ]
  }, {
    "tStartMs": 2285399,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Ah, I did that."
    } ]
  }, {
    "tStartMs": 2286959,
    "dDurationMs": 761,
    "segs": [ {
      "utf8": "What did you do?"
    } ]
  }, {
    "tStartMs": 2287720,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Boy Scouts."
    } ]
  }, {
    "tStartMs": 2288880,
    "dDurationMs": 1239,
    "segs": [ {
      "utf8": "Ahahaha."
    } ]
  }, {
    "tStartMs": 2290119,
    "dDurationMs": 921,
    "segs": [ {
      "utf8": "You did Boy Scouts?"
    } ]
  }, {
    "tStartMs": 2291040,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "Yes, I did, I did."
    } ]
  }, {
    "tStartMs": 2292239,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "Isn't that uniform really cute?"
    } ]
  }, {
    "tStartMs": 2293720,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "It is."
    } ]
  }, {
    "tStartMs": 2294799,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "Like, you'd tie a ribbon around your neck,"
    } ]
  }, {
    "tStartMs": 2298320,
    "dDurationMs": 3479,
    "segs": [ {
      "utf8": "but what was that for? Why did we do it?"
    } ]
  }, {
    "tStartMs": 2301799,
    "dDurationMs": 921,
    "segs": [ {
      "utf8": "I'm not sure either."
    } ]
  }, {
    "tStartMs": 2302720,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "That thing—"
    } ]
  }, {
    "tStartMs": 2303200,
    "dDurationMs": 2359,
    "segs": [ {
      "utf8": "Was it like an after-school activity?"
    } ]
  }, {
    "tStartMs": 2305559,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "I think I just went to a camp once."
    } ]
  }, {
    "tStartMs": 2308839,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Well, but you have to buy all the clothes."
    } ]
  }, {
    "tStartMs": 2310519,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Oh, that's right."
    } ]
  }, {
    "tStartMs": 2312719,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "I was in RCY."
    } ]
  }, {
    "tStartMs": 2314320,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "What's that?"
    } ]
  }, {
    "tStartMs": 2315640,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Red Cross."
    } ]
  }, {
    "tStartMs": 2317039,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "It's something the Red Cross does—"
    } ]
  }, {
    "tStartMs": 2319559,
    "dDurationMs": 3321,
    "segs": [ {
      "utf8": "Boy Scouts and Girl Scouts have this really"
    } ]
  }, {
    "tStartMs": 2322880,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "cute image where they wear cute uniforms and go camping,"
    } ]
  }, {
    "tStartMs": 2324960,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "that kind of thing."
    } ]
  }, {
    "tStartMs": 2326559,
    "dDurationMs": 3961,
    "segs": [ {
      "utf8": "But RCY is about volunteering and"
    } ]
  }, {
    "tStartMs": 2330520,
    "dDurationMs": 4719,
    "segs": [ {
      "utf8": "doing more socially meaningful work,"
    } ]
  }, {
    "tStartMs": 2335320,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "that kind of thing."
    } ]
  }, {
    "tStartMs": 2336119,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "That sounds more meaningful."
    } ]
  }, {
    "tStartMs": 2338440,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Boy Scouts—"
    } ]
  }, {
    "tStartMs": 2339320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Oh, I remember that well."
    } ]
  }, {
    "tStartMs": 2341000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So I don't know why, but"
    } ]
  }, {
    "tStartMs": 2343640,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "suddenly they said I had to go to camp,"
    } ]
  }, {
    "tStartMs": 2345000,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "so I put on the uniform"
    } ]
  }, {
    "tStartMs": 2347520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and went,"
    } ]
  }, {
    "tStartMs": 2349320,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "and with the people in my group—"
    } ]
  }, {
    "tStartMs": 2351760,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "so one teacher"
    } ]
  }, {
    "tStartMs": 2354159,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and the other kids who came with me—"
    } ]
  }, {
    "tStartMs": 2358479,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "we went for a walk on some mountain."
    } ]
  }, {
    "tStartMs": 2362119,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "And we picked up some branches from the mountain,"
    } ]
  }, {
    "tStartMs": 2366000,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "and we carved them"
    } ]
  }, {
    "tStartMs": 2367080,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to make wooden chopsticks,"
    } ]
  }, {
    "tStartMs": 2369840,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and we boiled ramen with them,"
    } ]
  }, {
    "tStartMs": 2371880,
    "dDurationMs": 2479,
    "segs": [ {
      "utf8": "and we ate the ramen with those chopsticks."
    } ]
  }, {
    "tStartMs": 2374359,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 2376799,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "That sounds fun."
    } ]
  }, {
    "tStartMs": 2377960,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "That's totally a camp experience."
    } ]
  }, {
    "tStartMs": 2378840,
    "dDurationMs": 1519,
    "segs": [ {
      "utf8": "Yeah, I remember that."
    } ]
  }, {
    "tStartMs": 2380359,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And you always do that thing—"
    } ]
  }, {
    "tStartMs": 2382039,
    "dDurationMs": 961,
    "segs": [ {
      "utf8": "candlelight."
    } ]
  }, {
    "tStartMs": 2383000,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Oh, candlelight."
    } ]
  }, {
    "tStartMs": 2384280,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "I don't think we did that at Boy Scouts."
    } ]
  }, {
    "tStartMs": 2386239,
    "dDurationMs": 841,
    "segs": [ {
      "utf8": "You didn't?"
    } ]
  }, {
    "tStartMs": 2387080,
    "dDurationMs": 719,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 2387799,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "At the training retreat."
    } ]
  }, {
    "tStartMs": 2388719,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "We went to the training retreat and did it there."
    } ]
  }, {
    "tStartMs": 2389799,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 2391119,
    "dDurationMs": 641,
    "segs": [ {
      "utf8": "Oh, that's right."
    } ]
  }, {
    "tStartMs": 2391760,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "We did it at the training retreat too."
    } ]
  }, {
    "tStartMs": 2392799,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2394280,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "Separated from my mother now—"
    } ]
  }, {
    "tStartMs": 2395719,
    "dDurationMs": 2121,
    "segs": [ {
      "utf8": "separated from my parents—"
    } ]
  }, {
    "tStartMs": 2397840,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2399239,
    "dDurationMs": 761,
    "segs": [ {
      "utf8": "That one night—"
    } ]
  }, {
    "tStartMs": 2400000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "Before bed, the teacher would always hold a candle and tell such touching stories that the kids would cry."
    } ]
  }, {
    "tStartMs": 2409000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Right? I was enduring it back then too."
    } ]
  }, {
    "tStartMs": 2414640,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Why did you endure it like that?"
    } ]
  }, {
    "tStartMs": 2416400,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Oh, I just wanted to get back to the dorm quickly, but the teacher kept talking."
    } ]
  }, {
    "tStartMs": 2421120,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "And it wasn't even sad."
    } ]
  }, {
    "tStartMs": 2423000,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The story didn't really reach your ears, did it?"
    } ]
  }, {
    "tStartMs": 2427280,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Really."
    } ]
  }, {
    "tStartMs": 2428320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And with the fire burning like that,"
    } ]
  }, {
    "tStartMs": 2431200,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "you end up just staring blankly at it, you know?"
    } ]
  }, {
    "tStartMs": 2435320,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "Yeah, like a cat."
    } ]
  }, {
    "tStartMs": 2437279,
    "dDurationMs": 4881,
    "segs": [ {
      "utf8": "So while the teacher's story goes in one ear and out the other,"
    } ]
  }, {
    "tStartMs": 2442160,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I'd just stare blankly at the flickering flame,"
    } ]
  }, {
    "tStartMs": 2446160,
    "dDurationMs": 759,
    "segs": [ {
      "utf8": "wondering when it would end."
    } ]
  }, {
    "tStartMs": 2446919,
    "dDurationMs": 641,
    "segs": [ {
      "utf8": "Fire gazing."
    } ]
  }, {
    "tStartMs": 2447560,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "Yeah, doing that fire gazing so intensely,"
    } ]
  }, {
    "tStartMs": 2453480,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and then when the kid next to me starts sniffling,"
    } ]
  }, {
    "tStartMs": 2456160,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "oh, I'd just do this."
    } ]
  }, {
    "tStartMs": 2457840,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "Oh really? I think it was quite touching for me."
    } ]
  }, {
    "tStartMs": 2460759,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I didn't cry, though."
    } ]
  }, {
    "tStartMs": 2462919,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "I have a memory of trying not to cry."
    } ]
  }, {
    "tStartMs": 2465639,
    "dDurationMs": 5441,
    "segs": [ {
      "utf8": "Oh, I was thinking about the candle I was holding in my hand,"
    } ]
  }, {
    "tStartMs": 2471080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and the flame was so strong,"
    } ]
  }, {
    "tStartMs": 2474080,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "if the candle melted completely,"
    } ]
  }, {
    "tStartMs": 2476000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "wouldn't that fire burn my hand?"
    } ]
  }, {
    "tStartMs": 2479120,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "I think I was having those kinds of thoughts."
    } ]
  }, {
    "tStartMs": 2482760,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Oh, that's funny."
    } ]
  }, {
    "tStartMs": 2483480,
    "dDurationMs": 2079,
    "segs": [ {
      "utf8": "Is this complete? Like this?"
    } ]
  }, {
    "tStartMs": 2485559,
    "dDurationMs": 6481,
    "segs": [ {
      "utf8": "No, the teacher was telling a really touching story in front of us,"
    } ]
  }, {
    "tStartMs": 2492040,
    "dDurationMs": 919,
    "segs": [ {
      "utf8": "and that's what they said."
    } ]
  }, {
    "tStartMs": 2492959,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "Talking about parental love and things like that,"
    } ]
  }, {
    "tStartMs": 2495040,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "I've never really listened properly even once."
    } ]
  }, {
    "tStartMs": 2498720,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Teacher Tae-woong, were you okay being separated from your parents and sleeping away?"
    } ]
  }, {
    "tStartMs": 2502160,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "You know, sleeping away."
    } ]
  }, {
    "tStartMs": 2503480,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "This is also outside elementary school,"
    } ]
  }, {
    "tStartMs": 2505239,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "When do you think you started sleeping separately?"
    } ]
  }, {
    "tStartMs": 2509199,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "Oh, from when I was young,"
    } ]
  }, {
    "tStartMs": 2513720,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "I used to go to my aunt's house often during school breaks and play."
    } ]
  }, {
    "tStartMs": 2518400,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "But there were times I'd spend the entire break at my aunt's place."
    } ]
  }, {
    "tStartMs": 2524360,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "My aunt had three kids,"
    } ]
  }, {
    "tStartMs": 2528160,
    "dDurationMs": 2679,
    "segs": [ {
      "utf8": "and they were mostly around my age,"
    } ]
  }, {
    "tStartMs": 2530839,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "so we were really close."
    } ]
  }, {
    "tStartMs": 2533399,
    "dDurationMs": 5481,
    "segs": [ {
      "utf8": "So at that young age, I just naturally"
    } ]
  }, {
    "tStartMs": 2538880,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "took the express bus from Jechon all the way to Seosan, Chungcheongnam-do,"
    } ]
  }, {
    "tStartMs": 2544800,
    "dDurationMs": 1879,
    "segs": [ {
      "utf8": "I was independent."
    } ]
  }, {
    "tStartMs": 2546679,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 2548000,
    "dDurationMs": 5399,
    "segs": [ {
      "utf8": "Yeah, so even when I went to places like Sureung, I slept well."
    } ]
  }, {
    "tStartMs": 2553399,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "Wow, so that's how it was."
    } ]
  }, {
    "tStartMs": 2555960,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "Didi, wasn't it like that for you?"
    } ]
  }, {
    "tStartMs": 2557559,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "I actually slept with my mom and dad until they literally kicked me out of the room."
    } ]
  }, {
    "tStartMs": 2562080,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 2563240,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Yeah, I'd beg them, please let me sleep with you."
    } ]
  }, {
    "tStartMs": 2567720,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "I was really scared of the darkness and things like that."
    } ]
  }, {
    "tStartMs": 2571520,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So with my mom and dad, until early elementary school,"
    } ]
  }, {
    "tStartMs": 2575240,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "I slept together with mom, dad, and my older brother,"
    } ]
  }, {
    "tStartMs": 2578600,
    "dDurationMs": 8239,
    "segs": [ {
      "utf8": "and then around fourth grade, my older brother and I moved out separately and stayed together,"
    } ]
  }, {
    "tStartMs": 2586839,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and from fifth and sixth grade of elementary school, I think I started sleeping alone."
    } ]
  }, {
    "tStartMs": 2591039,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 2592360,
    "dDurationMs": 5199,
    "segs": [ {
      "utf8": "Yeah, and it hasn't been that long since the darkness stopped scaring me."
    } ]
  }, {
    "tStartMs": 2597559,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "Was it after you became an adult?"
    } ]
  }, {
    "tStartMs": 2599080,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "I guess so."
    } ]
  }, {
    "tStartMs": 2601520,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "Oh, that's interesting."
    } ]
  }, {
    "tStartMs": 2602919,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "I don't think I was very independent."
    } ]
  }, {
    "tStartMs": 2605639,
    "dDurationMs": 3801,
    "segs": [ {
      "utf8": "I never really had the chance to be apart, you know."
    } ]
  }, {
    "tStartMs": 2609440,
    "dDurationMs": 4679,
    "segs": [ {
      "utf8": "I think it's because I was separated from my parents often since I was young."
    } ]
