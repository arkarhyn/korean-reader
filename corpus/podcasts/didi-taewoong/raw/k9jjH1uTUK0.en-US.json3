  }, {
    "tStartMs": 925480,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Yes. I was daydreaming by myself."
    } ]
  }, {
    "tStartMs": 930480,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And I listened to a lot of music too."
    } ]
  }, {
    "tStartMs": 935480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Was there a singer you liked back then? Any songs or artists?"
    } ]
  }, {
    "tStartMs": 938480,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I got into hip-hop back then, in middle school."
    } ]
  }, {
    "tStartMs": 942480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Eminem?"
    } ]
  }, {
    "tStartMs": 943480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Was it 6th grade or 1st year of middle school?"
    } ]
  }, {
    "tStartMs": 944480,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "No. I listened to Dynamic Duo's first album."
    } ]
  }, {
    "tStartMs": 948480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Korean hip-hop?"
