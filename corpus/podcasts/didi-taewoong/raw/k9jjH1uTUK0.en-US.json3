  }, {
    "tStartMs": 1987000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1988000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "If you mess up, they laugh."
    } ]
  }, {
    "tStartMs": 1990000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But I don't think I was funny."
