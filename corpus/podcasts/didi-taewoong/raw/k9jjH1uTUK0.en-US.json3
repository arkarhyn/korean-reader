  }, {
    "tStartMs": 1970000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The sunrise of Ilchulbong."
    } ]
  }, {
    "tStartMs": 1972000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "All the kids in the class are listening to it, but I have to go up front and sing it, right?"
