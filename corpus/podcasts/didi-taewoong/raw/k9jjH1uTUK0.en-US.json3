  }, {
    "tStartMs": 1982000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1983000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1984000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What is that."
    } ]
  }, {
    "tStartMs": 1985000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And the kids laugh when you can't do it."
