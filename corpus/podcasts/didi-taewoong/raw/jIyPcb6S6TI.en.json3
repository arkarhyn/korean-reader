    "tStartMs": 2172899,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Two or three people like one person"
    } ]
  }, {
    "tStartMs": 2176199,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "Then what do you do?"
    } ]
  }, {
    "tStartMs": 2178300,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Oh"
    } ]
  }, {
    "tStartMs": 2179600,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Then the person who likes it will decide"
    } ]
  }, {
    "tStartMs": 2183000,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "Oh"
    } ]
  }, {
    "tStartMs": 2184199,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "But don't you think that would hurt your pride too much?"
    } ]
  }, {
    "tStartMs": 2186399,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "I know"
    } ]
  }, {
    "tStartMs": 2188300,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "I don't think I would like it"
    } ]
  }, {
    "tStartMs": 2190399,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Oh"
    } ]
  }, {
    "tStartMs": 2192699,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I have a similar experience"
    } ]
  }, {
    "tStartMs": 2195199,
    "dDurationMs": 3601,
    "segs": [ {
      "utf8": "I have an older sister who I was close to in college"
    } ]
  }, {
    "tStartMs": 2198800,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "She was my closest sister"
    } ]
  }, {
    "tStartMs": 2199899,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "She is very pretty"
    } ]
  }, {
    "tStartMs": 2203300,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 2204399,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "Always"
    } ]
  }, {
    "tStartMs": 2206000,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "What is it?"
    } ]
  }, {
    "tStartMs": 2206500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "If I go to a college festival"
    } ]
  }, {
    "tStartMs": 2207800,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "I asked for a number"
    } ]
  }, {
    "tStartMs": 2208899,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Men came"
    } ]
  }, {
    "tStartMs": 2209899,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I was that kind of person"
    } ]
  }, {
    "tStartMs": 2212899,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "But I have a lot of experience like that"
    } ]
  }, {
    "tStartMs": 2214199,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "So when I go with her"
    } ]
  }, {
    "tStartMs": 2216399,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "Some men came to me"
    } ]
  }, {
    "tStartMs": 2218300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Can you give me that person's number?"
    } ]
  }, {
    "tStartMs": 2220300,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I asked like this"
    } ]
  }, {
    "tStartMs": 2221800,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "Why did you ask that to someone else?"
    } ]
  }, {
    "tStartMs": 2224899,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "Because I don't have the courage to ask"
    } ]
  }, {
    "tStartMs": 2226100,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Because I don't have the courage to ask directly"
    } ]
  }, {
    "tStartMs": 2227800,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "I want to get along with him"
    } ]
  }, {
    "tStartMs": 2229399,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "Please help me"
    } ]
  }, {
    "tStartMs": 2230300,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "Like this"
    } ]
  }, {
    "tStartMs": 2231199,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "Cowards"
    } ]
  }, {
    "tStartMs": 2233800,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "So that's how much"
    } ]
  }, {
    "tStartMs": 2239300,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "I know it's a place where I lose my self-esteem"
    } ]
  }, {
    "tStartMs": 2248300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It's a war"
    } ]
  }, {
    "tStartMs": 2250500,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "My attitude towards blind dates"
    } ]
  }, {
    "tStartMs": 2255300,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "I remember when it started"
    } ]
  }, {
    "tStartMs": 2258699,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2260600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "In my early 20s"
    } ]
  }, {
    "tStartMs": 2262800,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "Someone"
    } ]
  }, {
    "tStartMs": 2264899,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "He was a little older"
    } ]
  }, {
    "tStartMs": 2266899,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2267600,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "He"
    } ]
  }, {
    "tStartMs": 2269699,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "My sister was an elementary school teacher"
    } ]
  }, {
    "tStartMs": 2272600,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "Was it the first year? Was it the second year?"
    } ]
  }, {
    "tStartMs": 2274899,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2276699,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "So my sister's friends are teachers"
    } ]
  }, {
    "tStartMs": 2280800,
    "dDurationMs": 399,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2281199,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "So that man"
    } ]
  }, {
    "tStartMs": 2283399,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "Please introduce your sister's friends"
    } ]
  }, {
    "tStartMs": 2286800,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "I'm just doing that"
    } ]
  }, {
    "tStartMs": 2288399,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2289100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But at that time I didn't know anything"
    } ]
  }, {
    "tStartMs": 2291500,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "I asked my sister like that"
    } ]
  }, {
    "tStartMs": 2293899,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "Sister, this person I know"
    } ]
  }, {
    "tStartMs": 2296000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I'm asking you to do this"
    } ]
  }, {
    "tStartMs": 2297800,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "Can you do this?"
    } ]
  }, {
    "tStartMs": 2299399,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "Did my sister send a message at that time?"
    } ]
  }, {
    "tStartMs": 2303600,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "You have to do it yourself"
    } ]
  }, {
    "tStartMs": 2305699,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "Like this"
    } ]
  }, {
    "tStartMs": 2307600,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2309199,
    "dDurationMs": 3301,
    "segs": [ {
      "utf8": "So I usually talk about my sister"
    } ]
  }, {
    "tStartMs": 2312500,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "It's almost just"
    } ]
  }, {
    "tStartMs": 2314699,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "Because it's just the truth"
    } ]
  }, {
    "tStartMs": 2317300,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2318000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 2319800,
    "dDurationMs": 3599,
    "segs": [ {
      "utf8": "Oh, you have to do it yourself"
    } ]
  }, {
    "tStartMs": 2323399,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "You have to find your girlfriend"
    } ]
  }, {
    "tStartMs": 2327899,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "I think it's been like that since then"
    } ]
  }, {
    "tStartMs": 2332199,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "But that doesn't mean"
    } ]
  }, {
    "tStartMs": 2334600,
    "dDurationMs": 4799,
    "segs": [ {
      "utf8": "I don't think bad about people on blind dates"
    } ]
  }, {
    "tStartMs": 2339399,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "I think it's because I've been thinking like that since then"
    } ]
  }, {
    "tStartMs": 2341600,
    "dDurationMs": 4299,
    "segs": [ {
      "utf8": "I think I'm where I am now"
    } ]
  }, {
    "tStartMs": 2345899,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It's a different story"
    } ]
  }, {
    "tStartMs": 2347699,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I don't get married a lot these days"
    } ]
  }, {
    "tStartMs": 2350399,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "There are also stories that the birth rate is falling"
    } ]
  }, {
    "tStartMs": 2353500,
    "dDurationMs": 3199,
    "segs": [ {
      "utf8": "Don't you think there are fewer and fewer opportunities to meet?"
    } ]
  }, {
    "tStartMs": 2356699,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "I think so"
    } ]
  }, {
    "tStartMs": 2358500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "My parents were shocked recently"
    } ]
  }, {
    "tStartMs": 2362100,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "My brother's friend got married"
    } ]
  }, {
    "tStartMs": 2366000,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "So I was invited to a housewarming party"
    } ]
  }, {
    "tStartMs": 2368600,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "The wife is out"
    } ]
  }, {
    "tStartMs": 2373800,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "Because my husband's friends are coming"
    } ]
  }, {
    "tStartMs": 2376899,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "The wife empties the house"
    } ]
  }, {
    "tStartMs": 2380300,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "So that only my husband's friends can play"
    } ]
  }, {
    "tStartMs": 2385000,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "I saw that way"
    } ]
  }, {
    "tStartMs": 2386399,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "My parents were shocked"
    } ]
  }, {
    "tStartMs": 2390399,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "That's right"
    } ]
  }, {
    "tStartMs": 2392600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Is that so?"
    } ]
  }, {
    "tStartMs": 2393600,
    "dDurationMs": 2599,
    "segs": [ {
      "utf8": "Is that common these days?"
    } ]
  }, {
    "tStartMs": 2396199,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I'm not surprised"
    } ]
  }, {
    "tStartMs": 2398699,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I thought I could play comfortably"
    } ]
  }, {
    "tStartMs": 2403699,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "According to my parents"
    } ]
  }, {
    "tStartMs": 2405399,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "In the past, I met people in such a place"
    } ]
  }, {
    "tStartMs": 2408699,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "I called my bride's friends and my husband's friends"
    } ]
  }, {
    "tStartMs": 2412600,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "While playing like this"
    } ]
  }, {
    "tStartMs": 2415500,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "There was always one couple in it"
    } ]
  }, {
    "tStartMs": 2420399,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "These days, even between couples"
    } ]
  }, {
    "tStartMs": 2423600,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "I'm trying not to get in the way of each other"
    } ]
  }, {
    "tStartMs": 2427300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I see"
    } ]
  }, {
    "tStartMs": 2428500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "I think there are people like that"
    } ]
  }, {
    "tStartMs": 2432100,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "It could be"
    } ]
  }, {
    "tStartMs": 2433899,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Of course, there are times when we work together"
    } ]
  }, {
    "tStartMs": 2438199,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The form of such a relationship"
    } ]
  }, {
    "tStartMs": 2441199,
    "dDurationMs": 4901,
    "segs": [ {
      "utf8": "As time goes by, it changes little by little"
    } ]
  }, {
    "tStartMs": 2446199,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But a couple is a whole"
    } ]
  }, {
    "tStartMs": 2450199,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "A couple is one"
    } ]
  }, {
    "tStartMs": 2453100,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "That's it for the blind date story"
    } ]
  }, {
    "tStartMs": 2456399,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "I'm going to talk about the theme of next week"
    } ]
  }, {
    "tStartMs": 2459600,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "From now on, I think it would be good to change the topic one by one every week"
    } ]
  }, {
    "tStartMs": 2465800,
    "dDurationMs": 3899,
    "segs": [ {
      "utf8": "So I chose the theme of next week"
    } ]
  }, {
    "tStartMs": 2469699,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "What is it?"
    } ]
  }, {
    "tStartMs": 2470899,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "The theme of next week is going to be a beauty salon"
    } ]
  }, {
    "tStartMs": 2473500,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "A beauty salon?"
    } ]
  }, {
    "tStartMs": 2474899,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2476100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's a good theme"
    } ]
  }, {
    "tStartMs": 2477600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's a place where you get your hair done"
    } ]
  }, {
    "tStartMs": 2480000,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "From reservation"
    } ]
  }, {
    "tStartMs": 2481899,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I think I can talk about the regulars"
    } ]
  }, {
    "tStartMs": 2485199,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Good"
    } ]
  }, {
    "tStartMs": 2485899,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Then next week"
    } ]
  }, {
    "tStartMs": 2487300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Let's talk about beauty salons"
    } ]
  }, {
    "tStartMs": 2490800,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "I'll stop here today"
    } ]
  }, {
    "tStartMs": 2493000,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "Thank you"
    } ]
  }, {
    "tStartMs": 2493899,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "It was Jung Tae-woong"
    } ]
  }, {
    "tStartMs": 2495100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It was DDU-DU"
    } ]
  } ]
}
