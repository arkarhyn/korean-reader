  }, {
    "tStartMs": 1945720,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "If you ask like this"
    } ]
  }, {
    "tStartMs": 1947520,
    "dDurationMs": 3599,
    "segs": [ {
      "utf8": "Uh, what kind of heart does that person have right now to be like that"
