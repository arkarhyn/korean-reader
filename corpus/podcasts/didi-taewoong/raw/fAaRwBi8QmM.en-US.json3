{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Didi and Jeong Tae-woong's Yomojomo of Korean Life"
    } ]
  }, {
    "tStartMs": 9000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Hello, this is Didi."
    } ]
  }, {
    "tStartMs": 11000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Hello, this is Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 13000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Yomojomo of Korean Life is a podcast where two people living in Korea talk about the various aspects of Korean life."
    } ]
  }, {
    "tStartMs": 19000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So we're filming Yomojomo again after a long time, three weeks later."
    } ]
  }, {
    "tStartMs": 23000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What was this week's topic?"
    } ]
  }, {
    "tStartMs": 25000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This week's topic came up last time while we were playing a game."
    } ]
  }, {
    "tStartMs": 29000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's cafes."
    } ]
  }, {
    "tStartMs": 31000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Cafes. Cafes are spaces where you can drink coffee and chat and such,"
    } ]
  }, {
    "tStartMs": 36000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and since there are especially many of them in Korea, I wanted to talk about it once."
    } ]
  }, {
    "tStartMs": 40000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But you played a game last time, right?"
    } ]
  }, {
    "tStartMs": 44000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 45000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Didn't it sound fun when you heard it? In its own way?"
    } ]
  }, {
    "tStartMs": 49000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Uh, yes it did."
    } ]
  }, {
    "tStartMs": 50000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "You didn't listen to it?"
    } ]
  }, {
    "tStartMs": 51000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Uh, I'm caught."
    } ]
  }, {
    "tStartMs": 54000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Please listen to it just once."
    } ]
  }, {
    "tStartMs": 57000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It was surprisingly fun."
    } ]
  }, {
    "tStartMs": 60000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I'm sorry. I only listened up until the game part."
    } ]
  }, {
    "tStartMs": 62000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Oh, really?"
    } ]
  }, {
    "tStartMs": 64000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Now there's a game segment in the latter part, so"
    } ]
  }, {
    "tStartMs": 68000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I'd appreciate it if you all listened to the end."
    } ]
  }, {
    "tStartMs": 72000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I'm asking for your support."
    } ]
  }, {
    "tStartMs": 73000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Yes. So we're going to talk about cafes,"
    } ]
  }, {
    "tStartMs": 78000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Do you go to cafes often? Tae-woong?"
    } ]
  }, {
    "tStartMs": 80000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I wouldn't say I go often."
    } ]
  }, {
    "tStartMs": 84000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Because I don't go alone."
    } ]
  }, {
    "tStartMs": 87000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Huh? You don't get takeout?"
    } ]
  }, {
    "tStartMs": 89000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I don't get takeout either."
    } ]
  }, {
    "tStartMs": 91000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I see. So you only go when you have plans?"
    } ]
  }, {
    "tStartMs": 96000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes. When I meet friends."
    } ]
  }, {
    "tStartMs": 100000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You don't drink coffee much?"
    } ]
  }, {
    "tStartMs": 102000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "When I drink coffee, my heart starts pounding,"
    } ]
  }, {
    "tStartMs": 108000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Really?"
    } ]
  }, {
    "tStartMs": 110000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 111000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Is that so?"
    } ]
  }, {
    "tStartMs": 112000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "They say I'm sensitive to caffeine."
    } ]
  }, {
    "tStartMs": 114000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Hmm. Then I won't drink it."
    } ]
  }, {
    "tStartMs": 116000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 118000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I'm drinking it right now. An iced Americano."
    } ]
  }, {
    "tStartMs": 122000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "But even someone like me, if I keep drinking coffee out of habit,"
    } ]
  }, {
    "tStartMs": 128000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I hear you get used to it a bit."
    } ]
  }, {
    "tStartMs": 131000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "But I don't feel the need to adapt to coffee that much,"
    } ]
  }, {
    "tStartMs": 139000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 141000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You don't drink energy drinks either?"
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I can't. Isn't that even stronger?"
    } ]
  }, {
    "tStartMs": 146000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ah. So you really do react to caffeine."
    } ]
  }, {
    "tStartMs": 149000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 150000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Then during exam periods or back in the day when you had to stay up all night,"
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "when you were really tired, how did you get through it?"
    } ]
  }, {
    "tStartMs": 158000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That was when I was too young."
    } ]
  }, {
    "tStartMs": 161000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "With stamina?"
    } ]
  }, {
    "tStartMs": 162000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "No. Back then I did drink it occasionally."
    } ]
  }, {
    "tStartMs": 165000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ah. Your heart."
    } ]
  }, {
    "tStartMs": 167000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Then it worked properly."
    } ]
  }, {
    "tStartMs": 170000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "When I was working at a company, I really couldn't live without coffee."
    } ]
  }, {
    "tStartMs": 174000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 175000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I was so tired."
    } ]
  }, {
    "tStartMs": 177000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm weak in the mornings, you see."
    } ]
  }, {
    "tStartMs": 180000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Ah. Did you go to bed late back then too?"
    } ]
  }, {
    "tStartMs": 184000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "I think I went to bed pretty late, around 1 or 2 a.m."
    } ]
  }, {
    "tStartMs": 190000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Yeah. And then I woke up at 7,"
    } ]
  }, {
    "tStartMs": 196000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "so I only got about 6 or 5 hours of sleep, and I was really tired."
    } ]
  }, {
    "tStartMs": 200000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ah, that makes sense."
    } ]
  }, {
    "tStartMs": 202000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "You can live without it."
    } ]
  }, {
    "tStartMs": 203000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But you're right, these days I'm sleeping enough,"
    } ]
  }, {
    "tStartMs": 206000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "so it seems like I'm okay without the caffeine."
    } ]
  }, {
    "tStartMs": 208000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 209000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So now it's more like drinking it for the taste?"
    } ]
  }, {
    "tStartMs": 211000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Because it's refreshing."
    } ]
  }, {
    "tStartMs": 212000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Is it tasty?"
    } ]
  }, {
    "tStartMs": 214000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "It's really delicious, right?"
    } ]
  }, {
    "tStartMs": 215000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's bitter, though."
    } ]
  }, {
    "tStartMs": 217000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Like an Americano?"
    } ]
  }, {
    "tStartMs": 219000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Right. The bitter taste."
    } ]
  }, {
    "tStartMs": 222000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The taste? The aroma? The aroma is good, you know. Coffee has that."
    } ]
  }, {
    "tStartMs": 225000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The aroma is good, right?"
    } ]
  }, {
    "tStartMs": 227000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yeah. I think I drink it for that feeling."
    } ]
  }, {
    "tStartMs": 230000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 231000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "A warm Americano is like a warm tea, and the aroma is really good,"
    } ]
  }, {
    "tStartMs": 236000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and I think of it that way,"
    } ]
  }, {
    "tStartMs": 238000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and an iced Americano has a really good aroma,"
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but I drink it like a really refreshing beverage,"
    } ]
  }, {
    "tStartMs": 243000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "so that's what it's like."
    } ]
  }, {
    "tStartMs": 245000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "For me, because it's bitter."
    } ]
  }, {
    "tStartMs": 247000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "You don't like it because it's bitter?"
    } ]
  }, {
    "tStartMs": 248000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 249000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What about alcohol?"
    } ]
  }, {
    "tStartMs": 251000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I don't like alcohol either."
    } ]
  }, {
    "tStartMs": 253000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ah. So you don't drink it for the taste?"
    } ]
  }, {
    "tStartMs": 255000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 256000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Is that so?"
    } ]
  }, {
    "tStartMs": 258000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Highballs and things like that are tasty,"
    } ]
  }, {
    "tStartMs": 261000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "right."
    } ]
  }, {
    "tStartMs": 262000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But things other than that, just ones with a bitter taste?"
    } ]
  }, {
    "tStartMs": 264000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Well, there are other tasty coffees besides Americano, you know."
    } ]
  }, {
    "tStartMs": 268000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Do you like those better?"
    } ]
  }, {
    "tStartMs": 270000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 271000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Café mocha, cappuccino, latte, vanilla latte."
    } ]
  }, {
    "tStartMs": 277000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I think those taste bitter too."
    } ]
  }, {
    "tStartMs": 279000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Mm. Is that so?"
    } ]
  }, {
    "tStartMs": 281000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yeah. So I think there's a bitter taste to them."
    } ]
  }, {
    "tStartMs": 284000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "There is a bitter taste."
    } ]
  }, {
    "tStartMs": 285000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But they make it harmonize with sweetness like this."
    } ]
  }, {
    "tStartMs": 289000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Just sweet, just sweet."
    } ]
  }, {
    "tStartMs": 291000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But something like an Oreo milkshake is just sweet, you know."
    } ]
  }, {
    "tStartMs": 295000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Do you like that better?"
    } ]
  }, {
    "tStartMs": 297000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I like that kind of taste better than coffee taste."
    } ]
  }, {
    "tStartMs": 299000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ah. Is that so?"
    } ]
  }, {
    "tStartMs": 301000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 302000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I bought a coffee machine last year, actually."
    } ]
  }, {
    "tStartMs": 307000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That capsule coffee machine."
    } ]
  }, {
    "tStartMs": 309000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 310000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Do you have one at your place, by any chance?"
    } ]
  }, {
    "tStartMs": 312000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "At my place, I don't drink coffee,"
    } ]
  }, {
    "tStartMs": 317000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "but my mother likes coffee,"
    } ]
  }, {
    "tStartMs": 320000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so we don't have a capsule machine or anything like that,"
    } ]
  }, {
    "tStartMs": 323000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but we have that machine that grinds the beans?"
    } ]
  }, {
    "tStartMs": 327000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "We have something like that."
    } ]
  }, {
    "tStartMs": 328000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "So with those beans, I brew coffee directly and drink it."
    } ]
  }, {
    "tStartMs": 334000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "There are tools like that."
    } ]
  }, {
    "tStartMs": 337000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It really seems like it."
    } ]
  }, {
    "tStartMs": 340000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "How do I put it."
    } ]
  }, {
    "tStartMs": 342000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It seems like a real activity of enjoying coffee."
    } ]
  }, {
    "tStartMs": 345000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That seems to be the case."
    } ]
  }, {
    "tStartMs": 347000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Capsules are just convenient to consume"
    } ]
  }, {
    "tStartMs": 350000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "My mom really loves coffee, and so do I."
    } ]
  }, {
    "tStartMs": 354000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So I saw what my mother uses"
    } ]
  }, {
    "tStartMs": 358000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And I bought one following her example"
    } ]
  }, {
    "tStartMs": 362000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But I keep buying them even though I have some at home."
    } ]
  }, {
    "tStartMs": 366000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I think I made a mistake buying it."
    } ]
  }, {
    "tStartMs": 369000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Is there a big difference in taste?"
    } ]
  }, {
    "tStartMs": 371000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "There's some difference in taste too"
    } ]
  }, {
    "tStartMs": 373000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 375000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And especially with iced drinks like this"
    } ]
  }, {
    "tStartMs": 378000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You have to prepare ice as well, right?"
    } ]
  }, {
    "tStartMs": 380000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 381000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So it seems like a hassle, this too."
    } ]
  }, {
    "tStartMs": 384000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I see. But the ice thing is a bit of a hassle, isn't it?"
    } ]
  }, {
    "tStartMs": 387000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And in Korea there are a lot of cafes where Americanos are really cheap."
    } ]
  }, {
    "tStartMs": 391000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 392000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Like 1,500 won?"
    } ]
  }, {
    "tStartMs": 395000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So it seems like you just end up buying it."
    } ]
  }, {
    "tStartMs": 400000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So you drink it almost every day?"
    } ]
  }, {
    "tStartMs": 404000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Not really."
    } ]
  }, {
    "tStartMs": 405000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "These days I sleep a lot"
    } ]
  }, {
    "tStartMs": 408000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Two or three times a week? When I want to?"
    } ]
  }, {
    "tStartMs": 412000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I drink it."
    } ]
  }, {
    "tStartMs": 415000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So you mainly do takeout a lot, then."
    } ]
  }, {
    "tStartMs": 419000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "When I'm alone, yes"
    } ]
  }, {
    "tStartMs": 421000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And when I have plans with friends, I always seem to go to a cafe."
    } ]
  }, {
    "tStartMs": 425000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Is there perhaps something like, this kind of cafe is good?"
    } ]
  }, {
    "tStartMs": 431000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "There is something like that."
    } ]
  }, {
    "tStartMs": 434000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "When I talk with friends at a cafe"
    } ]
  }, {
    "tStartMs": 439000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I like cafes where the desserts are delicious."
    } ]
  }, {
    "tStartMs": 442000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Oh, that's important."
    } ]
  }, {
    "tStartMs": 444000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "A cafe with somewhat unique or delicious desserts."
    } ]
  }, {
    "tStartMs": 450000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So when I talk with friends"
    } ]
  }, {
    "tStartMs": 453000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Not just talking, but this is delicious, taking photos"
    } ]
  }, {
    "tStartMs": 457000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I like a cafe where we can do all these things together"
    } ]
  }, {
    "tStartMs": 461000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Do you have something like that, Tae-woong?"
    } ]
  }, {
    "tStartMs": 463000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Well, since I don't drink coffee myself"
    } ]
  }, {
    "tStartMs": 467000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Instead, since I'm already here, let's eat something delicious"
    } ]
  }, {
    "tStartMs": 470000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I always have this kind of thought"
    } ]
  }, {
    "tStartMs": 473000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So if the dessert is delicious, it's really nice"
    } ]
  }, {
    "tStartMs": 476000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "And if the chairs are comfortable, wouldn't that be good?"
    } ]
  }, {
    "tStartMs": 482000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Comfortable chairs"
    } ]
  }, {
    "tStartMs": 484000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "If you're going to sit for a long time and talk"
    } ]
  }, {
    "tStartMs": 486000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 487000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Right, right"
    } ]
  }, {
    "tStartMs": 489000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Do you have a favorite cafe dessert?"
    } ]
  }, {
    "tStartMs": 491000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I like Earl Grey cake."
    } ]
  }, {
    "tStartMs": 494000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You like the Earl Grey flavor?"
    } ]
  }, {
    "tStartMs": 496000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes, I really like it."
    } ]
  }, {
    "tStartMs": 499000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "How about you, Didi?"
    } ]
  }, {
    "tStartMs": 501000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I just like cheesecake?"
    } ]
  }, {
    "tStartMs": 504000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Like the dense, crumbly brownie cheesecake kind."
    } ]
  }, {
    "tStartMs": 510000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That would go well with an Americano."
    } ]
  }, {
    "tStartMs": 512000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 515000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I had my birthday a few days ago"
    } ]
  }, {
    "tStartMs": 517000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Oh, really?"
    } ]
  }, {
    "tStartMs": 519000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "My birthday was last week."
    } ]
  }, {
    "tStartMs": 522000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Happy birthday."
    } ]
  }, {
    "tStartMs": 524000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 526000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Don't you receive a lot of café gift certificates?"
    } ]
  }, {
    "tStartMs": 531000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 533000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Even when I use them, they seem to keep piling up."
    } ]
  }, {
    "tStartMs": 536000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh, you use them?"
    } ]
  }, {
    "tStartMs": 537000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 541000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Oh, I'd prefer it if people didn't give me those kinds of things."
    } ]
  }, {
    "tStartMs": 544000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What kind? Café emoticons?"
    } ]
  }, {
    "tStartMs": 546000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 547000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh, café gift certificates?"
    } ]
  }, {
    "tStartMs": 548000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Gift certificates, yes."
    } ]
  }, {
    "tStartMs": 549000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Oh, gift certificates themselves?"
    } ]
  }, {
    "tStartMs": 551000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes, café gift certificates."
    } ]
  }, {
    "tStartMs": 552000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Café gift certificates."
    } ]
  }, {
    "tStartMs": 555000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Why, why?"
    } ]
  }, {
    "tStartMs": 556000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Because you don't eat them?"
    } ]
  }, {
    "tStartMs": 557000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Because I don't eat them."
    } ]
  }, {
    "tStartMs": 558000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Oh, that makes sense."
    } ]
  }, {
    "tStartMs": 560000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I think it would be good to explain briefly for the subscribers."
    } ]
  }, {
    "tStartMs": 565000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "In Korea, there's something called gift certificates,"
    } ]
  }, {
    "tStartMs": 570000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Is that a compound word of \"gift\" and \"emoticon\"?"
    } ]
  }, {
    "tStartMs": 573000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It probably is."
    } ]
  }, {
    "tStartMs": 575000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The term \"gift emoticon\" is used a lot."
    } ]
  }, {
    "tStartMs": 580000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "You know how people send emoticons a lot on KakaoTalk."
    } ]
  }, {
    "tStartMs": 584000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Well, it's like sending gift coupons the same way."
    } ]
  }, {
    "tStartMs": 589000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So the most common ones sent are"
    } ]
  }, {
    "tStartMs": 592000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Starbucks Americano and soft, fluffy cake."
    } ]
  }, {
    "tStartMs": 597000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "You know castella, right?"
    } ]
  }, {
    "tStartMs": 598000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Soft, fluffy castella."
    } ]
  }, {
    "tStartMs": 600000,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "The whipped cream castella set is sent a lot, and then the person who receives the gift certificate"
    } ]
  }, {
    "tStartMs": 608400,
    "dDurationMs": 7720,
    "segs": [ {
      "utf8": "can go to Starbucks and show the coupon to get it. That's right."
    } ]
  }, {
    "tStartMs": 616120,
    "dDurationMs": 10720,
    "segs": [ {
      "utf8": "It seems like a safe gift and one you don't have to think too hard about. That's right. The price is reasonable and"
    } ]
  }, {
    "tStartMs": 626840,
    "dDurationMs": 11279,
    "segs": [ {
      "utf8": "it's the most comfortable way to just pick this and give it as a gift, and the gift is done. And also, most people drink coffee anyway,"
    } ]
  }, {
    "tStartMs": 638119,
    "dDurationMs": 9281,
    "segs": [ {
      "utf8": "That's right. So people send it. Even if they don't use cosmetics, they'll drink coffee, so they send it."
    } ]
  }, {
    "tStartMs": 647400,
    "dDurationMs": 11239,
    "segs": [ {
      "utf8": "Yeah, that's true. I sent one to Teacher Tae-woong once too. Oh, before? Yes. When I first appeared on Didi's channel. Right, right."
    } ]
  }, {
    "tStartMs": 658639,
    "dDurationMs": 8441,
    "segs": [ {
      "utf8": "I had that thought back then. It felt awkward to send a gift, and it felt awkward to send money."
    } ]
  }, {
    "tStartMs": 667080,
    "dDurationMs": 6759,
    "segs": [ {
      "utf8": "So it's only for cafés. You don't have to send those kinds of things. Really, that was the point."
    } ]
  }, {
    "tStartMs": 673839,
    "dDurationMs": 16481,
    "segs": [ {
      "utf8": "Right. I really didn't need to send it. Oh, unnecessary. So sometimes when family or friends gather, I have this gift certificate, so let's go together. I'll pay."
    } ]
  }, {
    "tStartMs": 690320,
    "dDurationMs": 12480,
    "segs": [ {
      "utf8": "Isn't it okay to use it that way? Well, that's the thing. Actually, I don't have to pay there. I don't even need to spend my own money."
    } ]
  }, {
    "tStartMs": 702800,
    "dDurationMs": 11560,
    "segs": [ {
      "utf8": "I have a gift certificate, so I'll use it. That's exactly the same as saying I have 20,000 won in my wallet, so I'll use it. But also, when someone gives you something with a gift certificate, doesn't it not feel as grateful?"
    } ]
  }, {
    "tStartMs": 714360,
    "dDurationMs": 6479,
    "segs": [ {
      "utf8": "That's right. So it's like, oh, I slept well. Yes! Like that. Oh, it's not that great."
    } ]
  }, {
    "tStartMs": 720839,
    "dDurationMs": 7521,
    "segs": [ {
      "utf8": "Yeah, it's not even a gift they received. There's room for improvement."
    } ]
  }, {
    "tStartMs": 728360,
    "dDurationMs": 8160,
    "segs": [ {
      "utf8": "But still, when someone gives you a gift, the heart behind it is what matters. You're grateful, right. That's true."
    } ]
  }, {
    "tStartMs": 736520,
    "dDurationMs": 9200,
    "segs": [ {
      "utf8": "So do you have a favorite franchise? A café you don't like the coffee at but go to often?"
    } ]
  }, {
    "tStartMs": 745720,
    "dDurationMs": 11160,
    "segs": [ {
      "utf8": "Oh, I think I did. I can't remember well these days. A few years ago, there's a franchise called Hasam-dong Coffee that really took off."
    } ]
  }, {
    "tStartMs": 756880,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "I've never heard of it. Oh, and is it only in Busan? It might be. It's a franchise that started in Busan."
    } ]
  }, {
    "tStartMs": 763600,
    "dDurationMs": 11280,
    "segs": [ {
      "utf8": "Oh, Hasam-dong Coffee. Yes. I really liked the dalgona latte at Hasam-dong Coffee. Back then."
    } ]
  }, {
    "tStartMs": 774880,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "Did you try that? Yes, but it probably didn't have coffee in it. Huh, really?"
    } ]
  }, {
    "tStartMs": 781960,
    "dDurationMs": 10640,
    "segs": [ {
      "utf8": "Yes, there are menu items with coffee and menu items without coffee, so I just had the dalgona drink without the coffee."
    } ]
  }, {
    "tStartMs": 792600,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "It must have been the peak of sweetness. It really felt like my mind was getting strange."
    } ]
  }, {
    "tStartMs": 799080,
    "dDurationMs": 8640,
    "segs": [ {
      "utf8": "Dalgona coffee. That TikTok thing where you stir it 3,000 times, that was dalgona, right? Yeah, it probably was."
    } ]
  }, {
    "tStartMs": 807720,
    "dDurationMs": 9520,
    "segs": [ {
      "utf8": "Like stirring it and eating it on top? When it was trending back then. Yeah, that's when it came out."
    } ]
  }, {
    "tStartMs": 817360,
    "dDurationMs": 12000,
    "segs": [ {
      "utf8": "So really, dalgona, that dalgona from Squid Game episode 1, that sugar candy, so on top of the dalgona latte, you break up pieces of the dalgona itself."
    } ]
  }, {
    "tStartMs": 829360,
    "dDurationMs": 10199,
    "segs": [ {
      "utf8": "and sprinkle it on top. That's right. Yes, you sprinkle it and put it on. Dalgona latte is something you can see fairly often at different cafés,"
    } ]
  }, {
    "tStartMs": 839559,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "and if you come from abroad, it seems like something worth trying once. Yeah, that's true. It has that flavor. That unique taste."
    } ]
  }, {
    "tStartMs": 847479,
    "dDurationMs": 7961,
    "segs": [ {
      "utf8": "That's right. It tastes a bit like burnt sugar, like crème brûlée. Oh, that's right, that's right. It's delicious."
    } ]
  }, {
    "tStartMs": 855440,
    "dDurationMs": 12040,
    "segs": [ {
      "utf8": "Oh, you go there often. Yes. Didi, what about you? Oh, I hadn't been to Ediya in a while, but I went again recently."
    } ]
  }, {
    "tStartMs": 867480,
    "dDurationMs": 9359,
    "segs": [ {
      "utf8": "Idiaa Coffee. It's a blue coffee shop, and it's actually pretty tasty. There's a menu item I'd like to recommend there."
    } ]
  }, {
    "tStartMs": 876839,
    "dDurationMs": 11881,
    "segs": [ {
      "utf8": "Is it White Chocolate Mocha? Yes. That's really delicious. Idiaa. White Chocolate Mocha? Yeah, that's right, that's right. White Chocolate Mocha."
    } ]
  }, {
    "tStartMs": 888760,
    "dDurationMs": 9440,
    "segs": [ {
      "utf8": "It's delicious. Idiaa is delicious. Right. Yes. White Chocolate Mocha. So that does have coffee in it then."
    } ]
  }, {
    "tStartMs": 898200,
    "dDurationMs": 8240,
    "segs": [ {
      "utf8": "It has coffee in it. Then I should drink it in the morning. Either in the morning or maybe they have decaf too."
    } ]
  }, {
    "tStartMs": 906440,
    "dDurationMs": 10880,
    "segs": [ {
      "utf8": "It's nice to drink something warm in winter. There's whipped cream on top. Yes. And it's also delicious as you melt it and eat it."
    } ]
  }, {
    "tStartMs": 917320,
    "dDurationMs": 10600,
    "segs": [ {
      "utf8": "Iced is also fine. Do try it. Understood. And what's another franchise you like?"
    } ]
  }, {
    "tStartMs": 927920,
    "dDurationMs": 11840,
    "segs": [ {
      "utf8": "There's Hollys. When people mention Hollys, foreign subscribers might not be able to find it when they come to Korea."
    } ]
  }, {
    "tStartMs": 939760,
    "dDurationMs": 11240,
    "segs": [ {
      "utf8": "What is it? Hollis? Hollys. The \"holly\" in \"holly-molly.\" Yes. At Hollys Coffee. It's spelled h-o-l-l-y-s. That's right."
    } ]
  }, {
    "tStartMs": 951000,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "There, it's not a coffee menu, but I like their kombucha. Oh, that sour one? Yes."
    } ]
  }, {
    "tStartMs": 960880,
    "dDurationMs": 8959,
    "segs": [ {
      "utf8": "I've tried it. Strawberry flavor and Shine Muscat. That's right. Shine Muscat flavor is good, isn't it?"
    } ]
  }, {
    "tStartMs": 969839,
    "dDurationMs": 13560,
    "segs": [ {
      "utf8": "You order it and receive a cup with ice, and then you pour the drink from the bottle into that cup and drink it."
    } ]
  }, {
    "tStartMs": 983399,
    "dDurationMs": 12761,
    "segs": [ {
      "utf8": "Without using a straw, just like drinking beer, you gulp it down refreshingly. The thirst just disappears. Oh, it's really refreshing."
    } ]
  }, {
    "tStartMs": 996760,
    "dDurationMs": 5479,
    "segs": [ {
      "utf8": "Oh, for those who like kombucha, Hollys. Yes. I recommend it. I think it'd be good to go once."
    } ]
  }, {
    "tStartMs": 1002239,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "Especially in summer like this. So Teacher Tae-woong, you use a laptop, right?"
    } ]
  }, {
    "tStartMs": 1007679,
    "dDurationMs": 8321,
    "segs": [ {
      "utf8": "I use it a lot. Do you often go to cafes with your laptop and work? Not really that often."
    } ]
  }, {
    "tStartMs": 1016000,
    "dDurationMs": 12480,
    "segs": [ {
      "utf8": "Not that often, but when I really can't work at home, that's when I go as a special measure. Does it work better then?"
    } ]
  }, {
    "tStartMs": 1028480,
    "dDurationMs": 16680,
    "segs": [ {
      "utf8": "Well, since I came here to do this. Right. It seems like that. And there's that kind of effect, you know. There's probably the feeling of people watching, and you've paid money too."
    } ]
  }, {
    "tStartMs": 1045160,
    "dDurationMs": 8519,
    "segs": [ {
      "utf8": "Right. It seems better to be surrounded by people than to be alone in your room. Do you do it a lot, Didi?"
    } ]
  }, {
    "tStartMs": 1053679,
    "dDurationMs": 12761,
    "segs": [ {
      "utf8": "I'm not that good at it either, and I just like working in my room, so whether it's work or studying, I do it in my room, but sometimes I just feel like going out when the weather's nice or something, but I don't really have any plans."
    } ]
  }, {
    "tStartMs": 1066440,
    "dDurationMs": 8919,
    "segs": [ {
      "utf8": "So I just grab my stuff and go for a walk, go to a cafe and work, things like that."
    } ]
  }, {
    "tStartMs": 1076359,
    "dDurationMs": 9521,
    "segs": [ {
      "utf8": "People call those people \"study-cafe tribe\" a lot, don't they? Yes. The species that studies in cafes."
    } ]
  }, {
    "tStartMs": 1085880,
    "dDurationMs": 11199,
    "segs": [ {
      "utf8": "When that started coming up, there were discussions about whether it was a problem or not. That's right."
    } ]
  }, {
    "tStartMs": 1097079,
    "dDurationMs": 9081,
    "segs": [ {
      "utf8": "Can you stay for hours? Do you have to order several drinks? Things like that. Yes. What do you think, Teacher Tae-woong? Study-cafe tribe."
    } ]
  }, {
    "tStartMs": 1106160,
    "dDurationMs": 13920,
    "segs": [ {
      "utf8": "Oh, that seems difficult. Nowadays that culture has become pretty natural, hasn't it? It has."
    } ]
  }, {
    "tStartMs": 1120159,
    "dDurationMs": 9520,
    "segs": [ {
      "utf8": "But I'm not really sure. I actually made an episode about the study-cafe tribe once."
    } ]
  }, {
    "tStartMs": 1129679,
    "dDurationMs": 8521,
    "segs": [ {
      "utf8": "What I thought back then was about those large franchises. The cafes are really big and have lots of seating."
    } ]
  }, {
    "tStartMs": 1138200,
    "dDurationMs": 12320,
    "segs": [ {
      "utf8": "In those places, even if you sit for maybe 2 hours, or at most 3 hours, I don't think it really interferes with business at that level."
    } ]
  }, {
    "tStartMs": 1150520,
    "dDurationMs": 7639,
    "segs": [ {
      "utf8": "So people who study in cafes seem to go there, and they seem to go to those large franchises a lot."
    } ]
  }, {
    "tStartMs": 1158159,
    "dDurationMs": 10721,
    "segs": [ {
      "utf8": "But in small cafes, there needs to be quick turnover. That's right. You need to serve customers, but if they keep sitting, it's tough."
    } ]
  }, {
    "tStartMs": 1168880,
    "dDurationMs": 12760,
    "segs": [ {
      "utf8": "Considering that kind of thing. Yes. That's a reasonable explanation. If you feel like you've been sitting too long, you order something else. Right."
    } ]
  }, {
    "tStartMs": 1182640,
    "dDurationMs": 8800,
    "segs": [ {
      "utf8": "But I'm someone who thinks from the start, why would I study in a cafe anyway?"
    } ]
  }, {
    "tStartMs": 1191440,
    "dDurationMs": 10320,
    "segs": [ {
      "utf8": "Yes. There are people like that. It's noisy, music's playing, lots of people."
    } ]
  }, {
    "tStartMs": 1201000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It's not a place for studying."
    } ]
  }, {
    "tStartMs": 1204000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Mm, right."
    } ]
  }, {
    "tStartMs": 1207000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And another problem that came up was this."
    } ]
  }, {
    "tStartMs": 1209000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "While studying in a cafe, going up to a table next to you that's chatting."
    } ]
  }, {
    "tStartMs": 1213000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Surely not..."
    } ]
  }, {
    "tStartMs": 1215000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 1216000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It's too loud, could you please be quieter? Doing something like that."
    } ]
  }, {
    "tStartMs": 1219000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's..."
    } ]
  }, {
    "tStartMs": 1221000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "When people say there are people like that, posts go up about it."
    } ]
  }, {
    "tStartMs": 1225000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That really seems like wrong behavior."
    } ]
  }, {
    "tStartMs": 1228000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Right. So what exactly is a cafe?"
    } ]
  }, {
    "tStartMs": 1232000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "A cafe is a place to drink coffee."
    } ]
  }, {
    "tStartMs": 1236000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And meet people and talk?"
    } ]
  }, {
    "tStartMs": 1240000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Isn't it?"
    } ]
  }, {
    "tStartMs": 1241000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Right. Nowadays there are study cafes too."
    } ]
  }, {
    "tStartMs": 1244000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Cafes where you can study."
    } ]
  }, {
    "tStartMs": 1245000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1246000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I think it'd be good to use those too."
    } ]
  }, {
    "tStartMs": 1250000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "Yes. There are libraries, reading rooms, study cafes."
    } ]
  }, {
    "tStartMs": 1257000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Lots of options."
    } ]
  }, {
    "tStartMs": 1259000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Because there can be many different opinions."
    } ]
  }, {
    "tStartMs": 1262000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That's right. What do you all think about cafes?"
    } ]
  }, {
    "tStartMs": 1265000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I'd appreciate it if you'd leave your thoughts."
    } ]
  }, {
    "tStartMs": 1267000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Then should we move on to the next segment?"
    } ]
  }, {
    "tStartMs": 1270000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes. Should we move on?"
    } ]
  }, {
    "tStartMs": 1271000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Let's move on to the next segment."
    } ]
  }, {
    "tStartMs": 1276000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "A word-based mini game."
    } ]
  }, {
    "tStartMs": 1280000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This word-based mini game segment is."
    } ]
  }, {
    "tStartMs": 1284000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So what game are we going to play?"
    } ]
  }, {
    "tStartMs": 1286000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Last time we played a game called Twenty Questions, remember?"
    } ]
  }, {
    "tStartMs": 1290000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This time we're going to play another game that's very popular in Korea,"
    } ]
  }, {
    "tStartMs": 1294000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "which is called Word Chain."
    } ]
  }, {
    "tStartMs": 1296000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1297000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Could you explain what Word Chain is, by any chance?"
    } ]
  }, {
    "tStartMs": 1300000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Word Chain is a game where you take turns saying words,"
    } ]
  }, {
    "tStartMs": 1305000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and the first letter of that word"
    } ]
  }, {
    "tStartMs": 1309000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "must be the last letter of the word the previous person said."
    } ]
  }, {
    "tStartMs": 1314000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1316000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "For example, if I said \"apple,\""
    } ]
  }, {
    "tStartMs": 1319000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "it ends with the letter for \"gwa.\" So"
    } ]
  }, {
    "tStartMs": 1321000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the next person starting with that letter would say \"candy\" like this,"
    } ]
  }, {
    "tStartMs": 1324000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and that's how the game works,"
    } ]
  }, {
    "tStartMs": 1326000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and that's why it's called Word Chain—"
    } ]
  }, {
    "tStartMs": 1328000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "it means continuing on like that."
    } ]
  }, {
    "tStartMs": 1330000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But since we're Korean language experts,"
    } ]
  }, {
    "tStartMs": 1333000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "if we just play regular Word Chain, it'll be too easy."
    } ]
  }, {
    "tStartMs": 1337000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We could do it all day long, so"
    } ]
  }, {
    "tStartMs": 1339000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "we're going to do an upgraded version"
    } ]
  }, {
    "tStartMs": 1341000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "called Explanation Word Chain."
    } ]
  }, {
    "tStartMs": 1343000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I came up with this."
    } ]
  }, {
    "tStartMs": 1345000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Here's what it is:"
    } ]
  }, {
    "tStartMs": 1347000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the word that I say,"
    } ]
  }, {
    "tStartMs": 1349000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you listeners who are listening right now"
    } ]
  }, {
    "tStartMs": 1351000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "have to explain it too."
    } ]
  }, {
    "tStartMs": 1353000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Explanation Word Chain—"
    } ]
  }, {
    "tStartMs": 1355000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Explanation Word Chain—"
    } ]
  }, {
    "tStartMs": 1357000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you listeners who are listening right now"
    } ]
  }, {
    "tStartMs": 1359000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "have to explain it too."
    } ]
  }, {
    "tStartMs": 1361000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "For example, it was apple earlier, right?"
    } ]
  }, {
    "tStartMs": 1363000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So you'd say \"apple,\""
    } ]
  }, {
    "tStartMs": 1366000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and then explain \"it's a fruit and it's red,"
    } ]
  }, {
    "tStartMs": 1369000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that fruit,"
    } ]
  }, {
    "tStartMs": 1371000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you know the iPhone, right?"
    } ]
  }, {
    "tStartMs": 1373000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "it's that fruit drawn on the back of it.\""
    } ]
  }, {
    "tStartMs": 1375000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You have to explain it like this"
    } ]
  }, {
    "tStartMs": 1377000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "in order to move on,"
    } ]
  }, {
    "tStartMs": 1379000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Is that even possible?"
    } ]
  }, {
    "tStartMs": 1381000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I don't know."
    } ]
  }, {
    "tStartMs": 1383000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I thought about it,"
    } ]
  }, {
    "tStartMs": 1385000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and it seems really difficult,"
    } ]
  }, {
    "tStartMs": 1387000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but let's try it."
    } ]
  }, {
    "tStartMs": 1389000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "If it takes too long,"
    } ]
  }, {
    "tStartMs": 1393000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "we'll count it as being eliminated."
    } ]
  }, {
    "tStartMs": 1399000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It seems really difficult,"
    } ]
  }, {
    "tStartMs": 1401000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but let's give it a try."
    } ]
  }, {
    "tStartMs": 1403000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Should I go first?"
    } ]
  }, {
    "tStartMs": 1405000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Microphone."
    } ]
  }, {
    "tStartMs": 1409000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "A microphone is something that can"
    } ]
  }, {
    "tStartMs": 1411000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "record what a person is saying,"
    } ]
  }, {
    "tStartMs": 1413000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and when you're singing, you hold it in your hand"
    } ]
  }, {
    "tStartMs": 1415000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and use it to sing."
    } ]
  }, {
    "tStartMs": 1419000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Good."
    } ]
  }, {
    "tStartMs": 1421000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Starting with something big, huh?"
    } ]
  }, {
    "tStartMs": 1423000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 1425000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "starting with English, English—"
    } ]
  }, {
    "tStartMs": 1429000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "let me try."
    } ]
  }, {
    "tStartMs": 1431000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Crayon."
    } ]
  }, {
    "tStartMs": 1433000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "A crayon is"
    } ]
  }, {
    "tStartMs": 1435000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's a tool that can color,"
    } ]
  }, {
    "tStartMs": 1437000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "not a pencil,"
    } ]
  }, {
    "tStartMs": 1439000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "something like colored pencils."
    } ]
  }, {
    "tStartMs": 1441000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's a tool."
    } ]
  }, {
    "tStartMs": 1443000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ski resort."
    } ]
  }, {
    "tStartMs": 1445000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "A ski resort is"
    } ]
  }, {
    "tStartMs": 1447000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you know, winter sports skiing."
    } ]
  }, {
    "tStartMs": 1449000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Like going down a slide in a snowy place,"
    } ]
  }, {
    "tStartMs": 1451000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "a place where you can do that kind of activity."
    } ]
  }, {
    "tStartMs": 1453000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's a ski resort."
    } ]
  }, {
    "tStartMs": 1455000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "A ski resort is just"
    } ]
  }, {
    "tStartMs": 1457000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "a place where you ski, right?"
    } ]
  }, {
    "tStartMs": 1459000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Can you say it that way?"
    } ]
  }, {
    "tStartMs": 1461000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes, you can."
    } ]
  }, {
    "tStartMs": 1463000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's a place where you ski."
    } ]
  }, {
    "tStartMs": 1465000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "For me,"
    } ]
  }, {
    "tStartMs": 1467000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "rainy season."
    } ]
  }, {
    "tStartMs": 1469000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Usually in summer,"
    } ]
  }, {
    "tStartMs": 1473000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "for a long period of time,"
    } ]
  }, {
    "tStartMs": 1475000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the period when it rains a lot,"
    } ]
  }, {
    "tStartMs": 1477000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "we call that the rainy season."
    } ]
  }, {
    "tStartMs": 1479000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You did well."
    } ]
  }, {
    "tStartMs": 1481000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ra—"
    } ]
  }, {
    "tStartMs": 1483000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The microphone isn't working."
    } ]
  }, {
    "tStartMs": 1485000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Wizard."
    } ]
  }, {
    "tStartMs": 1487000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "A wizard is a person who uses magic."
    } ]
  }, {
    "tStartMs": 1491000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "No,"
    } ]
  }, {
    "tStartMs": 1493000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that works as a word."
    } ]
  }, {
    "tStartMs": 1495000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "For example, a typical one is"
    } ]
  }, {
    "tStartMs": 1499000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Harry Potter? He's a wizard."
    } ]
  }, {
    "tStartMs": 1501000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So that's how it will come out."
    } ]
  }, {
    "tStartMs": 1503000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ski resort wizard."
    } ]
  }, {
    "tStartMs": 1507000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We ended with the letter \"sa.\""
    } ]
  }, {
    "tStartMs": 1509000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Then for me,"
    } ]
  }, {
    "tStartMs": 1511000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I'll go with the letter \"sa.\""
    } ]
  }, {
    "tStartMs": 1513000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Sa\" is"
    } ]
  }, {
    "tStartMs": 1517000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "a difficult word for beginners,"
    } ]
  }, {
    "tStartMs": 1519000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is it a Chinese character?"
    } ]
  }, {
    "tStartMs": 1521000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "When a person dies,"
    } ]
  }, {
    "tStartMs": 1523000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "then the reason that person"
    } ]
  }, {
    "tStartMs": 1525000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "died"
    } ]
  }, {
    "tStartMs": 1527000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is called the cause of death."
    } ]
  }, {
    "tStartMs": 1529000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 1531000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the cause of death is"
    } ]
  }, {
    "tStartMs": 1533000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "starved to death because of hunger."
    } ]
  }, {
    "tStartMs": 1535000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Or drowned in water."
    } ]
  }, {
    "tStartMs": 1537000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We call it the cause of death like this."
    } ]
  }, {
    "tStartMs": 1539000,
    "dDurationMs": 2000,
