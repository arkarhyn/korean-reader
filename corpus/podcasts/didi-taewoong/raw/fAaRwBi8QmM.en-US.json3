  }, {
    "tStartMs": 1978520,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Right, right"
    } ]
  }, {
    "tStartMs": 1979320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Yes yes yes"
