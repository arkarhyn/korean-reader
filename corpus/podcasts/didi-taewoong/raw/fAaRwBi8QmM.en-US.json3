  }, {
    "tStartMs": 1980960,
    "dDurationMs": 679,
    "segs": [ {
      "utf8": "That's it"
    } ]
  }, {
    "tStartMs": 1981639,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "So I was originally Korean"
    } ]
  }, {
    "tStartMs": 1984600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And like, I came to the United States, I went to the United States"
    } ]
  }, {
    "tStartMs": 1987160,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "You can say it like this"
    } ]
  }, {
    "tStartMs": 1988960,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Yes, good"
    } ]
  }, {
    "tStartMs": 1990800,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "I will go with civilian"
    } ]
  }, {
    "tStartMs": 1993759,
    "dDurationMs": 761,
    "segs": [ {
      "utf8": "Oh"
    } ]
  }, {
    "tStartMs": 1994520,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "Civilian might be a slightly difficult word"
    } ]
  }, {
    "tStartMs": 1996559,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Civilian"
    } ]
  }, {
    "tStartMs": 1997279,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Yes, it's mainly a word used in the military"
    } ]
  }, {
    "tStartMs": 2000240,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2001199,
    "dDurationMs": 5881,
    "segs": [ {
      "utf8": "A soldier has a special status as a soldier, right"
    } ]
  }, {
    "tStartMs": 2007080,
    "dDurationMs": 479,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2007559,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But from that perspective"
