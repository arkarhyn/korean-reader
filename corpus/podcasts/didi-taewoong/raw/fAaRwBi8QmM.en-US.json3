  }, {
    "tStartMs": 1936360,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "Psychology"
    } ]
  }, {
    "tStartMs": 1937919,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Yes, psychology is the human mind"
