  }, {
    "tStartMs": 1928839,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "That's a very good explanation"
    } ]
  }, {
    "tStartMs": 1931919,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "Yes, if it's patience, then I"
