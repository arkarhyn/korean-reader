  }, {
    "tStartMs": 2009479,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "A person who is not a soldier"
    } ]
  }, {
    "tStartMs": 2010919,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "A regular person outside the military"
    } ]
  }, {
    "tStartMs": 2013839,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "We call those people civilians"
    } ]
  }, {
    "tStartMs": 2016320,
    "dDurationMs": 879,
    "segs": [ {
      "utf8": "Mm"
    } ]
  }, {
    "tStartMs": 2017199,
    "dDurationMs": 5241,
    "segs": [ {
      "utf8": "So like, at some military facility, civilians are not allowed"
    } ]
  }, {
    "tStartMs": 2022440,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "Like, civilians cannot enter"
    } ]
  }, {
    "tStartMs": 2024399,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Like this"
    } ]
  }, {
    "tStartMs": 2025639,
    "dDurationMs": 361,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2026000,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "When we say the word civilian"
    } ]
  }, {
    "tStartMs": 2027960,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "It's a person who has nothing to do with the military"
    } ]
  }, {
    "tStartMs": 2030119,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They say it's a civilian."
    } ]
  }, {
    "tStartMs": 2031919,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "There's \"in\" again."
    } ]
  }, {
    "tStartMs": 2033039,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "\"In.\""
    } ]
  }, {
    "tStartMs": 2035800,
    "dDurationMs": 3759,
    "segs": [ {
      "utf8": "\"In\"—why does it seem like there are so many of these?"
    } ]
  }, {
    "tStartMs": 2039559,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "\"Inji.\""
    } ]
  }, {
    "tStartMs": 2041520,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "I'll use \"inji.\""
    } ]
  }, {
    "tStartMs": 2042559,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "\"Inji.\""
    } ]
  }, {
    "tStartMs": 2043160,
    "dDurationMs": 2119,
    "segs": [ {
      "utf8": "\"Inji\"—there are a lot of difficult words coming up."
    } ]
  }, {
    "tStartMs": 2045279,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "For example,"
    } ]
  }, {
    "tStartMs": 2046559,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I am right now"
    } ]
  }, {
    "tStartMs": 2048479,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "aware of what's happening in my body,"
    } ]
  }, {
    "tStartMs": 2050839,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "I'm cognizing it."
    } ]
  }, {
    "tStartMs": 2052320,
    "dDurationMs": 4039,
    "segs": [ {
      "utf8": "You can use it like this,"
    } ]
  }, {
    "tStartMs": 2056359,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It means to recognize and be aware of something."
    } ]
  }, {
    "tStartMs": 2059359,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "To understand something with my mind,"
    } ]
  }, {
    "tStartMs": 2062399,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "When you use it like this, you say \"inji.\""
    } ]
  }, {
    "tStartMs": 2065600,
    "dDurationMs": 2079,
    "segs": [ {
      "utf8": "Does that make sense?"
    } ]
  }, {
    "tStartMs": 2067679,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "\"Inji\"—wouldn't that be okay?"
    } ]
  }, {
    "tStartMs": 2069640,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Right?"
    } ]
  }, {
    "tStartMs": 2070040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So when you say something like \"inji ability has declined,\""
    } ]
  }, {
    "tStartMs": 2073160,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "it means"
    } ]
  }, {
    "tStartMs": 2074880,
    "dDurationMs": 2679,
    "segs": [ {
      "utf8": "when something happens,"
    } ]
  }, {
    "tStartMs": 2077559,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "what this is,"
    } ]
  }, {
    "tStartMs": 2079480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "the ability to grasp"
    } ]
  }, {
    "tStartMs": 2081320,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the ability to understand those kinds of things has declined."
    } ]
  }, {
    "tStartMs": 2085160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 2087880,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "\"Inji.\""
    } ]
  }, {
    "tStartMs": 2090399,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "\"Jigu.\""
    } ]
  }, {
    "tStartMs": 2092359,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "\"Jigu\" is the planet we live on right now."
    } ]
  }, {
    "tStartMs": 2097679,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Oh, yes."
    } ]
  }, {
    "tStartMs": 2101679,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "\"Gudu.\""
    } ]
  }, {
    "tStartMs": 2102519,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "How should I explain this?"
    } ]
  }, {
    "tStartMs": 2104799,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "\"Gudu\" isn't that shoe, that dress shoe,"
    } ]
  }, {
    "tStartMs": 2108559,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "I'll use \"gudu.\""
    } ]
  }, {
    "tStartMs": 2109799,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "You know how there's this kind of thing?"
    } ]
  }, {
    "tStartMs": 2111000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2114320,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "\"Gu\" is a Chinese character that means \"mouth.\""
    } ]
  }, {
    "tStartMs": 2118640,
    "dDurationMs": 879,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2119519,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So I'll say it in words."
    } ]
  }, {
    "tStartMs": 2121279,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "When you write an expression like this on paper"
    } ]
  }, {
    "tStartMs": 2124320,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "instead of doing it like this in writing,"
    } ]
  }, {
    "tStartMs": 2125920,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "I'll convey it in words."
    } ]
  }, {
    "tStartMs": 2127239,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "When you want to talk like this,"
    } ]
  }, {
    "tStartMs": 2129279,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "you say \"gudu.\""
    } ]
  }, {
    "tStartMs": 2132760,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So when you say \"gudu contract,\""
    } ]
  }, {
    "tStartMs": 2135880,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "usually you don't sign documents"
    } ]
  }, {
    "tStartMs": 2138880,
    "dDurationMs": 639,
    "segs": [ {
      "utf8": "or anything like that,"
    } ]
  }, {
    "tStartMs": 2139519,
    "dDurationMs": 1241,
    "segs": [ {
      "utf8": "you just do it by mouth."
    } ]
  }, {
    "tStartMs": 2140760,
    "dDurationMs": 479,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2141239,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "By word."
    } ]
  }, {
    "tStartMs": 2142720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Like this, like this, we'll do it this way."
    } ]
  }, {
    "tStartMs": 2144480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "When you do it like this, it's called a gudu contract."
    } ]
  }, {
    "tStartMs": 2146760,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 2147480,
    "dDurationMs": 1879,
    "segs": [ {
      "utf8": "Such a detailed explanation."
    } ]
  }, {
    "tStartMs": 2149359,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "So \"du.\""
    } ]
  }, {
    "tStartMs": 2151320,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "I'll use \"dusang.\""
    } ]
  }, {
    "tStartMs": 2152200,
    "dDurationMs": 879,
    "segs": [ {
      "utf8": "\"Dusang.\""
    } ]
  }, {
    "tStartMs": 2153079,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "\"Dusang.\""
    } ]
  }, {
    "tStartMs": 2154679,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "The word \"dusang\" means"
    } ]
  }, {
    "tStartMs": 2156640,
    "dDurationMs": 1639,
    "segs": [ {
      "utf8": "our head, you know?"
    } ]
  }, {
    "tStartMs": 2158279,
    "dDurationMs": 721,
    "segs": [ {
      "utf8": "Head"
    } ]
  }, {
    "tStartMs": 2159000,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2159920,
    "dDurationMs": 3639,
    "segs": [ {
      "utf8": "It's about the shape of this head."
    } ]
  }, {
    "tStartMs": 2163559,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So when someone has a pretty head shape"
    } ]
  }, {
    "tStartMs": 2165799,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "like that"
    } ]
  }, {
    "tStartMs": 2167079,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "now when I shave my head"
    } ]
  }, {
    "tStartMs": 2169160,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "cut all my hair really short"
    } ]
  }, {
    "tStartMs": 2172000,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "when I become bald"
    } ]
  }, {
    "tStartMs": 2173839,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "that head shape is pretty, you know?"
    } ]
  }, {
    "tStartMs": 2176600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The head shape isn't all bumpy or anything"
    } ]
  }, {
    "tStartMs": 2179320,
    "dDurationMs": 2079,
    "segs": [ {
      "utf8": "a smooth shape is usually in Korea"
    } ]
  }, {
    "tStartMs": 2181399,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "considered pretty, I think."
    } ]
  }, {
    "tStartMs": 2183320,
    "dDurationMs": 479,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2183799,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "When we say someone has a pretty head shape"
    } ]
  }, {
    "tStartMs": 2186000,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "shape"
    } ]
  }, {
    "tStartMs": 2186480,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Oh, how do I end this"
    } ]
  }, {
    "tStartMs": 2190200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "lovesickness"
    } ]
  }, {
    "tStartMs": 2191480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "there's a word called lovesickness"
    } ]
  }, {
    "tStartMs": 2194480,
    "dDurationMs": 2639,
    "segs": [ {
      "utf8": "I should tell you a difficult word"
    } ]
  }, {
    "tStartMs": 2197119,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "lovesickness, you know"
    } ]
  }, {
    "tStartMs": 2199760,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "we talk about it like this"
    } ]
  }, {
    "tStartMs": 2201519,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "when you miss something and want to see it"
    } ]
  }, {
    "tStartMs": 2204600,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "and it keeps flickering in your eyes"
    } ]
  }, {
    "tStartMs": 2207119,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "and you can't even eat"
    } ]
  }, {
    "tStartMs": 2210119,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "it's like a kind of depression, I think"
    } ]
  }, {
    "tStartMs": 2213079,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "that's what we call lovesickness."
    } ]
  }, {
    "tStartMs": 2215640,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "Oh, that's good."
    } ]
  }, {
    "tStartMs": 2216160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Oh this is really"
    } ]
  }, {
    "tStartMs": 2218000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "like a battle of geniuses"
    } ]
  }, {
    "tStartMs": 2221600,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "an explanation showdown"
    } ]
  }, {
    "tStartMs": 2222720,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "Yes, I will pay a sick visit for illness."
    } ]
  }, {
    "tStartMs": 2225679,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "Sick visit"
    } ]
  }, {
    "tStartMs": 2227040,
    "dDurationMs": 4239,
    "segs": [ {
      "utf8": "like, someone other than me gets sick"
    } ]
  }, {
    "tStartMs": 2231279,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and is admitted to the hospital"
    } ]
  }, {
    "tStartMs": 2232559,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "they eat and sleep at the hospital"
    } ]
  }, {
    "tStartMs": 2234760,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "at that time, for that person"
    } ]
  }, {
    "tStartMs": 2236880,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "you go to that hospital"
    } ]
  }, {
    "tStartMs": 2239079,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "greet them"
    } ]
  }, {
    "tStartMs": 2240799,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and ask how they're doing, if they're having a hard time"
    } ]
  }, {
    "tStartMs": 2243359,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "that thing"
    } ]
  }, {
    "tStartMs": 2246000,
    "dDurationMs": 2119,
    "segs": [ {
      "utf8": "is called a sick visit."
    } ]
  }, {
    "tStartMs": 2248119,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "That's nice, in Korea people usually bring"
    } ]
  }, {
    "tStartMs": 2250839,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "fruit juice or fruit"
    } ]
  }, {
    "tStartMs": 2252480,
    "dDurationMs": 879,
    "segs": [ {
      "utf8": "when going to pay a sick visit"
    } ]
  }, {
    "tStartMs": 2253359,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2254799,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "Massage"
    } ]
  }, {
    "tStartMs": 2259399,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "Do you all know what massage is?"
    } ]
  }, {
    "tStartMs": 2261040,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "asking for a massage"
    } ]
  }, {
    "tStartMs": 2262320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "we talk about it like this"
    } ]
  }, {
    "tStartMs": 2264320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "sports athletes"
    } ]
  }, {
    "tStartMs": 2266000,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "when they play soccer or things like that"
    } ]
  }, {
    "tStartMs": 2268320,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "sometimes they get cramps in their legs"
    } ]
  }, {
    "tStartMs": 2270920,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "like when you suddenly use muscles quickly"
    } ]
  }, {
    "tStartMs": 2273200,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "that area gets all bunched up"
    } ]
  }, {
    "tStartMs": 2274959,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and it hurts and is difficult"
    } ]
  }, {
    "tStartMs": 2277679,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "when that happens, people who help"
    } ]
  }, {
    "tStartMs": 2281239,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "go and rub the legs like this"
    } ]
  }, {
    "tStartMs": 2283760,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "those kinds of things are called massage."
    } ]
  }, {
    "tStartMs": 2286279,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Then I will get anesthesia."
    } ]
  }, {
    "tStartMs": 2288399,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Anesthesia"
    } ]
  }, {
    "tStartMs": 2290200,
    "dDurationMs": 3639,
    "segs": [ {
      "utf8": "Anesthesia is mainly used in hospitals"
    } ]
  }, {
    "tStartMs": 2293839,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "before doing something very painful to your body"
    } ]
  }, {
    "tStartMs": 2297679,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "using a certain medication"
    } ]
  }, {
    "tStartMs": 2300239,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "to make that area feel nothing at all"
    } ]
  }, {
    "tStartMs": 2303880,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "So when you go to the dentist"
    } ]
  }, {
    "tStartMs": 2305799,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "and have a tooth pulled"
    } ]
  }, {
    "tStartMs": 2306959,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "or get some treatment done"
    } ]
  }, {
    "tStartMs": 2308720,
    "dDurationMs": 2559,
    "segs": [ {
      "utf8": "if you just did it without anything, it would hurt too much"
    } ]
  }, {
    "tStartMs": 2311279,
    "dDurationMs": 4041,
    "segs": [ {
      "utf8": "so they inject anesthetic medicine with a syringe"
    } ]
  }, {
    "tStartMs": 2315320,
    "dDurationMs": 3159,
    "segs": [ {
      "utf8": "and even if you have painful surgery"
    } ]
  }, {
    "tStartMs": 2318479,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "they make it so you don't feel the pain"
    } ]
  }, {
    "tStartMs": 2320559,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "that's what we call anesthesia"
    } ]
  }, {
    "tStartMs": 2322880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Got it"
    } ]
  }, {
    "tStartMs": 2326000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Truth in drunkenness\""
    } ]
  }, {
    "tStartMs": 2328000,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "is a saying we have"
    } ]
  }, {
    "tStartMs": 2329599,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "That's a real word, isn't it?"
    } ]
  }, {
    "tStartMs": 2331880,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "Is it?"
    } ]
  }, {
    "tStartMs": 2332919,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's a real word, isn't it?"
    } ]
  }, {
    "tStartMs": 2334599,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "Or is it?"
    } ]
  }, {
    "tStartMs": 2335880,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "Is it just a song title or something?"
    } ]
  }, {
    "tStartMs": 2337919,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "Is it originally a real word?"
    } ]
  }, {
    "tStartMs": 2339960,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Don't you think it is?"
    } ]
  }, {
    "tStartMs": 2340760,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "\"Truth in drunkenness\" is"
    } ]
  }, {
    "tStartMs": 2342799,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Huh?"
    } ]
  }, {
    "tStartMs": 2344359,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "I mean, does it appear in the dictionary?"
    } ]
  }, {
    "tStartMs": 2346919,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "Does it appear?"
    } ]
  }, {
    "tStartMs": 2347679,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "Does it show up?"
    } ]
  }, {
    "tStartMs": 2349440,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I'm not really sure about that"
    } ]
  }, {
    "tStartMs": 2351840,
    "dDurationMs": 3319,
    "segs": [ {
      "utf8": "but let me explain it first"
    } ]
  }, {
    "tStartMs": 2355159,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "So this is when someone is drunk"
    } ]
  }, {
    "tStartMs": 2357479,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "when a person has had alcohol and is intoxicated"
    } ]
  }, {
    "tStartMs": 2361239,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "things they couldn't normally talk about"
    } ]
  }, {
    "tStartMs": 2363479,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "the feelings and thoughts inside their heart"
    } ]
  }, {
    "tStartMs": 2365880,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "they share truthfully and sincerely"
    } ]
  }, {
    "tStartMs": 2369520,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "they open up and talk about it"
    } ]
  }, {
    "tStartMs": 2371119,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "that's what we call \"truth in drunkenness\""
    } ]
  }, {
    "tStartMs": 2373320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "but the word doesn't exist?"
    } ]
  }, {
    "tStartMs": 2374960,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "It doesn't exist, does it?"
    } ]
  }, {
    "tStartMs": 2377440,
    "dDurationMs": 1719,
    "segs": [ {
      "utf8": "It's not an original word, is it?"
    } ]
  }, {
    "tStartMs": 2379159,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The word itself has existed"
    } ]
  }, {
    "tStartMs": 2381679,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "since 1976, apparently"
    } ]
  }, {
    "tStartMs": 2382760,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "This phrase"
    } ]
  }, {
    "tStartMs": 2383440,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Huh? Really?"
    } ]
  }, {
    "tStartMs": 2384840,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2385520,
    "dDurationMs": 2839,
    "segs": [ {
      "utf8": "Isn't that the AI lying?"
    } ]
  }, {
    "tStartMs": 2388359,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "No, it's not"
    } ]
  }, {
    "tStartMs": 2390039,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's recorded in Naver News"
    } ]
  }, {
    "tStartMs": 2392039,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "July 3rd, 1976 in the Kyunghyang Shinmun"
    } ]
  }, {
    "tStartMs": 2395559,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "Whoa whoa whoa?"
    } ]
  }, {
    "tStartMs": 2396760,
    "dDurationMs": 3279,
    "segs": [ {
      "utf8": "Ohhh okay, that's great"
    } ]
  }, {
    "tStartMs": 2400039,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "By the way, I really hate \"truth in drunkenness\""
    } ]
  }, {
    "tStartMs": 2404359,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "so please tell me things when you're sober"
    } ]
  }, {
    "tStartMs": 2405880,
    "dDurationMs": 839,
    "segs": [ {
      "utf8": "Right, when you're sober"
    } ]
  }, {
    "tStartMs": 2406719,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "things you can't say sober, don't say them"
    } ]
  }, {
    "tStartMs": 2408440,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Exactly. That's right."
    } ]
  }, {
    "tStartMs": 2410440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Oh, this isn't ending."
    } ]
  }, {
    "tStartMs": 2412740,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "It's intense."
    } ]
  }, {
    "tStartMs": 2413640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You have to hit the final word."
    } ]
  }, {
    "tStartMs": 2415640,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The final word is..."
    } ]
  }, {
    "tStartMs": 2417639,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "There aren't many, right?"
    } ]
  }, {
    "tStartMs": 2418440,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "There aren't many Korean words."
    } ]
  }, {
    "tStartMs": 2421340,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Like sodium—that's not a Korean word anyway."
    } ]
  }, {
    "tStartMs": 2424139,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "I know one."
    } ]
  }, {
    "tStartMs": 2425840,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Oh, really?"
    } ]
  }, {
    "tStartMs": 2426639,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "How do I guide you?"
    } ]
  }, {
    "tStartMs": 2428580,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "But sodium and things like that don't have Korean words originally."
    } ]
  }, {
    "tStartMs": 2432380,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Oh, sodium is..."
    } ]
  }, {
    "tStartMs": 2433880,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Right, sodium is sodium."
    } ]
  }, {
    "tStartMs": 2435380,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2436380,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Next, is there one that starts with \"dam\"?"
    } ]
  }, {
    "tStartMs": 2437880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh, \"dam,\" \"dam.\""
    } ]
  }, {
    "tStartMs": 2439380,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Courage."
    } ]
  }, {
    "tStartMs": 2440380,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Oh, okay."
    } ]
  }, {
    "tStartMs": 2441880,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "\"Courage is strong,\" \"courage is weak.\""
    } ]
  }, {
    "tStartMs": 2444880,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "We use it like this a lot."
    } ]
  }, {
    "tStartMs": 2446380,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Courage is the ability to endure scary things"
    } ]
  }, {
    "tStartMs": 2450380,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and not get startled."
    } ]
  }, {
    "tStartMs": 2453380,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "So because I have strong courage,"
    } ]
  }, {
    "tStartMs": 2456619,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I can play horror games well."
    } ]
  }, {
    "tStartMs": 2459619,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Because I have strong courage,"
    } ]
  }, {
    "tStartMs": 2461119,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I can ride scary roller coasters well."
    } ]
  }, {
    "tStartMs": 2464120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "People say it like this a lot."
    } ]
  }, {
    "tStartMs": 2466120,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "My courage is level 1."
    } ]
  }, {
    "tStartMs": 2468620,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Oh, yes."
    } ]
  }, {
    "tStartMs": 2471120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And here's another rule of the word chain game—"
    } ]
  }, {
    "tStartMs": 2473120,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You can change the final consonant to \"n\" and go backwards, right?"
    } ]
  }, {
    "tStartMs": 2476120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2477120,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Paradox, I'll go with paradox."
    } ]
  }, {
    "tStartMs": 2479620,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Paradox."
    } ]
  }, {
    "tStartMs": 2480620,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Oh, how did you know?"
    } ]
  }, {
    "tStartMs": 2482620,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "A paradox is, a paradox is..."
    } ]
  }, {
    "tStartMs": 2486620,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I just keep having English words in my head."
    } ]
  }, {
    "tStartMs": 2489620,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "How should I explain it?"
    } ]
  }, {
    "tStartMs": 2491120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Oh, this is a difficult word."
    } ]
  }, {
    "tStartMs": 2493620,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Explaining paradox is hard."
    } ]
  }, {
    "tStartMs": 2495620,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I can't do it."
    } ]
  }, {
    "tStartMs": 2500120,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Well, then this game is our victory."
    } ]
  }, {
    "tStartMs": 2505120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "How frustrating."
    } ]
  }, {
    "tStartMs": 2506620,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "How should I explain it?"
    } ]
  }, {
    "tStartMs": 2508120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I kept thinking about paradoxes."
    } ]
  }, {
    "tStartMs": 2510120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Paradoxes, yes."
    } ]
  }, {
    "tStartMs": 2511620,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "A paradox, how should I explain it?"
    } ]
  }, {
    "tStartMs": 2513620,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "A paradox is, first of all"
    } ]
  }, {
    "tStartMs": 2515860,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "something that doesn't make sense"
    } ]
  }, {
    "tStartMs": 2518860,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "in its structure?"
    } ]
  }, {
    "tStartMs": 2520360,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Is it?"
    } ]
  }, {
    "tStartMs": 2522360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I just searched for an example"
    } ]
  }, {
    "tStartMs": 2525860,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"I am lying.\""
    } ]
  }, {
    "tStartMs": 2528860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "There's a statement like that."
    } ]
  }, {
    "tStartMs": 2530860,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Huh?"
    } ]
  }, {
    "tStartMs": 2531860,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I, I am lying right now."
    } ]
  }, {
    "tStartMs": 2534360,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's a paradox?"
    } ]
  }, {
    "tStartMs": 2535860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "They say that's a paradox."
    } ]
  }, {
    "tStartMs": 2537360,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Why is that?"
    } ]
  }, {
    "tStartMs": 2538360,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I am lying right now."
    } ]
  }, {
    "tStartMs": 2539860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Huh? What do you mean by that?"
    } ]
  }, {
    "tStartMs": 2542100,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I'm telling you, I am lying right now."
    } ]
  }, {
    "tStartMs": 2545100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I got it."
    } ]
  }, {
    "tStartMs": 2547600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What should I say?"
    } ]
  }, {
    "tStartMs": 2548600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What is it?"
    } ]
  }, {
    "tStartMs": 2551100,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This doesn't make sense, actually."
    } ]
  }, {
    "tStartMs": 2554100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Huh?"
    } ]
  }, {
    "tStartMs": 2555100,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "So at first glance it sounds true"
    } ]
  }, {
    "tStartMs": 2559600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "but clearly"
    } ]
  }, {
    "tStartMs": 2561600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "there's something that doesn't make sense hidden in it"
    } ]
  }, {
    "tStartMs": 2565100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "and you discover it?"
    } ]
  }, {
    "tStartMs": 2566100,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I think that's what they call a paradox."
    } ]
  }, {
    "tStartMs": 2568339,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I'm bringing up something unnecessarily difficult"
    } ]
  }, {
    "tStartMs": 2571839,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "There's also a book like this."
    } ]
  }, {
    "tStartMs": 2573339,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "There's something called \"the paradox of love\""
    } ]
  }, {
    "tStartMs": 2576839,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Love is difficult."
    } ]
  }, {
    "tStartMs": 2578839,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But love is beautiful."
    } ]
  }, {
    "tStartMs": 2580839,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "These two opposite things"
    } ]
  }, {
    "tStartMs": 2583339,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "exist, but neither one can be proven"
    } ]
  }, {
    "tStartMs": 2587339,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I think it's like that."
    } ]
  }, {
    "tStartMs": 2588839,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Back in the day, General Yi Sun-sin"
    } ]
  }, {
    "tStartMs": 2592339,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "said, \"Those who wish to live will die.\""
    } ]
  }, {
    "tStartMs": 2595580,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2596580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Those who wish to live will die."
    } ]
  }, {
    "tStartMs": 2599580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Those who wish to die will live."
    } ]
  }, {
    "tStartMs": 2601580,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "He said it like that, didn't he?"
    } ]
  }, {
    "tStartMs": 2603580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Actually, that's paradoxical."
    } ]
  }, {
    "tStartMs": 2606580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Why would someone die if they want to live?"
    } ]
  }, {
    "tStartMs": 2609580,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Why would someone live if they want to die?"
    } ]
  }, {
    "tStartMs": 2612080,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "So."
    } ]
  }, {
    "tStartMs": 2613080,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Yes, it could be like that."
    } ]
  }, {
    "tStartMs": 2616580,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Like this, surprisingly"
    } ]
  }, {
    "tStartMs": 2618580,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "it's difficult for us to explain the exact meaning."
    } ]
  }, {
    "tStartMs": 2623820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "There's a really beautiful expression."
    } ]
  }, {
    "tStartMs": 2626320,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What is it?"
    } ]
  }, {
    "tStartMs": 2627820,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "In the poem \"The Silence of My Beloved\" by poet Han Yong-hun"
    } ]
  }, {
    "tStartMs": 2630320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "there's a line like this."
    } ]
  }, {
    "tStartMs": 2632820,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Ah"
    } ]
  }, {
    "tStartMs": 2635820,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I need to do \"ah.\""
    } ]
  }, {
    "tStartMs": 2639320,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Ah"
    } ]
  }, {
    "tStartMs": 2640320,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "My beloved has gone"
    } ]
  }, {
    "tStartMs": 2641820,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "but I did not send my beloved away."
    } ]
  }, {
    "tStartMs": 2643820,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It's so sad."
    } ]
  }, {
    "tStartMs": 2648320,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "It's so sad."
    } ]
  }, {
    "tStartMs": 2650059,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Someone the person loved left them,"
    } ]
  }, {
    "tStartMs": 2654059,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "so they disappeared,"
    } ]
  }, {
    "tStartMs": 2656559,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but I didn't let that person go."
    } ]
  }, {
    "tStartMs": 2660559,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "That's a paradoxical situation."
    } ]
  }, {
    "tStartMs": 2663059,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Paradox."
    } ]
  }, {
    "tStartMs": 2664559,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Right. Now when I look at Tae's logic,"
    } ]
  }, {
    "tStartMs": 2666059,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "wait, didn't they leave?"
    } ]
  }, {
    "tStartMs": 2668059,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "These are people who don't understand life."
    } ]
  }, {
    "tStartMs": 2670059,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Those people."
    } ]
  }, {
    "tStartMs": 2673059,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "They left, so if you say it like that, then"
    } ]
  }, {
    "tStartMs": 2675059,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "it becomes a paradox again."
    } ]
  }, {
    "tStartMs": 2676059,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2677299,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "That's interesting."
    } ]
  }, {
    "tStartMs": 2678299,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Anyway, that's my victory."
    } ]
  }, {
    "tStartMs": 2681799,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So now it's 1 to 2."
    } ]
  }, {
    "tStartMs": 2683299,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Tae-yong teacher has 2 points."
    } ]
  }, {
    "tStartMs": 2684799,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I have 1 point."
    } ]
  }, {
    "tStartMs": 2686799,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "In the next game,"
    } ]
  }, {
    "tStartMs": 2689799,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'll bring a game that's more favorable to me."
    } ]
  }, {
    "tStartMs": 2694799,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So now"
    } ]
  }, {
    "tStartMs": 2696799,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "let's end the game here"
    } ]
  }, {
    "tStartMs": 2698799,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and the next week's topic"
    } ]
  }, {
    "tStartMs": 2700799,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Tae-yong teacher chose for us."
    } ]
  }, {
    "tStartMs": 2702299,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "What should we talk about?"
    } ]
  }, {
    "tStartMs": 2703799,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Yes, next week's topic is"
    } ]
  }, {
    "tStartMs": 2705540,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "a word that"
    } ]
  }, {
    "tStartMs": 2706540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "came up while we were"
    } ]
  }, {
    "tStartMs": 2708540,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "playing word chain."
    } ]
  }, {
    "tStartMs": 2709540,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "It's"
    } ]
  }, {
    "tStartMs": 2710540,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "jangma."
    } ]
  }, {
    "tStartMs": 2712040,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Jangma."
    } ]
  }, {
    "tStartMs": 2713040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's the season when it rains a lot, right?"
    } ]
  }, {
    "tStartMs": 2715040,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2715540,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Right now it's exactly jangma season,"
    } ]
  }, {
    "tStartMs": 2718040,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "and in three weeks"
    } ]
  }, {
    "tStartMs": 2720040,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "what the situation will be like,"
    } ]
  }, {
    "tStartMs": 2721540,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "talking about things like that, we'll"
    } ]
  }, {
    "tStartMs": 2723540,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "discuss jangma from every angle."
    } ]
  }, {
    "tStartMs": 2726040,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Thank you so much"
    } ]
  }, {
    "tStartMs": 2727040,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "for the enjoyable conversation today, Tae-yong teacher."
    } ]
  }, {
    "tStartMs": 2730040,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "The pleasure is mine."
    } ]
  }, {
    "tStartMs": 2731540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I'll see you in three weeks."
    } ]
  }, {
    "tStartMs": 2733279,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This has been Didi and"
    } ]
  }, {
    "tStartMs": 2734779,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 2735779,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  } ]
}
