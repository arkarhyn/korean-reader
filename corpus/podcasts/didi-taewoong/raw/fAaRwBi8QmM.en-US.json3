  }, {
    "tStartMs": 1960399,
    "dDurationMs": 681,
    "segs": [ {
      "utf8": "Yeah, that's right"
    } ]
  }, {
    "tStartMs": 1961080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "In Korean, it's allowed"
    } ]
  }, {
    "tStartMs": 1963080,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "In the final syllable game"
    } ]
  }, {
    "tStartMs": 1964679,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So I'll try it with ro"
    } ]
  }, {
    "tStartMs": 1966759,
    "dDurationMs": 1241,
    "segs": [ {
      "utf8": "Immigration?"
    } ]
  }, {
