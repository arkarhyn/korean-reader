  }, {
    "tStartMs": 1951119,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "You can understand it that way"
    } ]
  }, {
    "tStartMs": 1953880,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "Good"
    } ]
  }, {
    "tStartMs": 1955639,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "Ah, it's a characteristic of the final syllable game"
    } ]
  }, {
    "tStartMs": 1956960,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Words that end in ri"
    } ]
  }, {
    "tStartMs": 1959080,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "Can also be done with ro"
