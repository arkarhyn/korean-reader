{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 10020,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "안녕하세요 디디입니다"
    } ]
  }, {
    "tStartMs": 12190,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "안녕하세요 정태웅입니다"
    } ]
  }, {
    "tStartMs": 14070,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "\u003c한국생활 요모조모\u003e는 한국에서 살아가는 두 사람이"
    } ]
  }, {
    "tStartMs": 17430,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "한국생활의 요모조모를 이야기하는 팟캐스트입니다"
    } ]
  }, {
    "tStartMs": 20800,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "2025년 마지막 요모조모 에피소드입니다"
    } ]
  }, {
    "tStartMs": 25880,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "오래 했어요 저희"
    } ]
  }, {
    "tStartMs": 27740,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "꽤... 우리가 언제 처음 했죠?"
    } ]
  }, {
    "tStartMs": 30250,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "우리가..."
    } ]
  }, {
    "tStartMs": 31090,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "그러게요 작년에 시작했나?"
    } ]
  }, {
    "tStartMs": 33350,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "올해 아니에요?"
    } ]
  }, {
    "tStartMs": 34710,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "올해 초였던 것 같아요"
    } ]
  }, {
    "tStartMs": 36270,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "봄쯤이었던 것 같은데"
    } ]
  }, {
    "tStartMs": 38310,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "거의 요모조모도 1년째 하고 있네요"
    } ]
  }, {
    "tStartMs": 41470,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "와... 그러면 처음 할 때는"
    } ]
  }, {
    "tStartMs": 43900,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "한 달에 한 번이 아니라 매주 했으니까"
    } ]
  }, {
    "tStartMs": 47430,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 48830,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그럼 12번 넘게 했단 말이네요"
    } ]
  }, {
    "tStartMs": 51000,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "오 맞아요 훨씬 넘었을걸요?"
    } ]
  }, {
    "tStartMs": 52980,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "와..."
    } ]
  }, {
    "tStartMs": 54760,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "그러면 1년 넘은 걸로 칩시다!"
    } ]
  }, {
    "tStartMs": 56990,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "와~ㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 58850,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "1년 축하드려요"
    } ]
  }, {
    "tStartMs": 61140,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "감사합니다"
    } ]
  }, {
    "tStartMs": 61720,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "열심히 해주셔서 감사하고"
    } ]
  }, {
    "tStartMs": 63650,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "태웅쌤은 요즘 잘 지내고 계신가요?"
    } ]
  }, {
    "tStartMs": 66390,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "굉장히 바빠 보이시던데"
    } ]
  }, {
    "tStartMs": 68860,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "굉장히 피곤하게 지내고 있습니다"
    } ]
  }, {
    "tStartMs": 71450,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "태웅쌤 근황 다들 궁금해하실 것 같아요"
    } ]
  }, {
    "tStartMs": 75330,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "근황은요..."
    } ]
  }, {
    "tStartMs": 77050,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "그렇게 간단하지 않아서..."
    } ]
  }, {
    "tStartMs": 80160,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "하나의 에피소드가 되나요?"
    } ]
  }, {
    "tStartMs": 82270,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "네 제 생각엔 크리스마스 이브에"
    } ]
  }, {
    "tStartMs": 86280,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "제 All Things Korean 팟캐스트를 다시 업로드 해보려고 하거든요"
    } ]
  }, {
    "tStartMs": 91820,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "오 드디어 네"
    } ]
  }, {
    "tStartMs": 93870,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "네 그 에피소드 할 때 좀 얘기해도 되겠습니까?"
    } ]
  }, {
    "tStartMs": 97320,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "디디님 초대해서?"
    } ]
  }, {
    "tStartMs": 98640,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "오 그래요 그래요"
    } ]
  }, {
    "tStartMs": 100490,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "아 태웅쌤 근황은 그러면 특별편으로"
    } ]
  }, {
    "tStartMs": 104340,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "태웅쌤 채널에서 이야기하는 걸로 기대해주세요"
    } ]
  }, {
    "tStartMs": 107360,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "꼭 해주세요 태웅쌤"
    } ]
  }, {
    "tStartMs": 108670,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "그쵸ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 111000,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "오늘 테마 어떤 거였는지 일단 소개해볼까요?"
    } ]
  }, {
    "tStartMs": 115560,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "오늘의 주제는"
    } ]
  }, {
    "tStartMs": 117350,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "취미입니다"
    } ]
  }, {
    "tStartMs": 118750,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "취미입니다 그쵸, 여러분들"
    } ]
  }, {
    "tStartMs": 120890,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "이거 듣고 계시는 분들도 취미... 다들 있지 않을까?"
    } ]
  }, {
    "tStartMs": 125410,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "아니 없을 수도 있고 한데"
    } ]
  }, {
    "tStartMs": 127120,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "오늘은 저희의 취미를 한번 이야기해볼 거고요"
    } ]
  }, {
    "tStartMs": 131410,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "이야기하기 전에 저번 퀴즈 있었죠?"
    } ]
  }, {
    "tStartMs": 134090,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "그래서 정답자 알려드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 137090,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "퀴즈 정답은 우선 시원한 맛의 음식이 아닌 거"
    } ]
  }, {
    "tStartMs": 141760,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "정답이 1번 떡볶이였습니다"
    } ]
  }, {
    "tStartMs": 145760,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "그래서 이번에도 많은 분들 맞춰주셨고요"
    } ]
  }, {
    "tStartMs": 165170,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "....까지 퀴즈 정답 축하드립니다"
    } ]
  }, {
    "tStartMs": 168930,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "퀴즈 마지막에 있으니까 다들 맞춰주시고요"
    } ]
  }, {
    "tStartMs": 172470,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "그러면 취미 이야기해보겠습니다"
    } ]
  }, {
    "tStartMs": 176540,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 177360,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "우선 태웅쌤이 생각하는 '취미'란 어떤 건가요?"
    } ]
  }, {
    "tStartMs": 181400,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "'취미'의 정의부터 이야기해보고 싶은데"
    } ]
  }, {
    "tStartMs": 186120,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "취미..."
    } ]
  }, {
    "tStartMs": 187740,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "말 그대로 재미로 하는 작은 일?"
    } ]
  }, {
    "tStartMs": 191770,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "재미로 하는 일?"
    } ]
  }, {
    "tStartMs": 193210,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "작은 일?"
    } ]
  }, {
    "tStartMs": 195530,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "작진 않을 수도 있겠네요"
    } ]
  }, {
    "tStartMs": 197180,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "사람에 따라"
    } ]
  }, {
    "tStartMs": 199170,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "그럼 포인트는 재미네요"
    } ]
  }, {
    "tStartMs": 201270,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 202680,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "제가 생각하는 취미는..."
    } ]
  }, {
    "tStartMs": 206460,
    "dDurationMs": 5230,
    "segs": [ {
      "utf8": "그쵸 재미가 맞고 하면서 즐거운 일이자"
    } ]
  }, {
    "tStartMs": 211690,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "일이 아닌 거?"
    } ]
  }, {
    "tStartMs": 214180,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "일로 하는 게 아닌 거인데"
    } ]
  }, {
    "tStartMs": 217310,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "사전에 정의를 찾아봤더니"
    } ]
  }, {
    "tStartMs": 221020,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "이렇게 적혀있었습니다"
    } ]
  }, {
    "tStartMs": 222320,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "'일이나 전문적으로 하는 것이 아니라"
    } ]
  }, {
    "tStartMs": 226310,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "좋아서 즐기기 위해 하는 것'이라고 나와있었어요"
    } ]
  }, {
    "tStartMs": 229950,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "저희가 이야기한 거랑 똑같죠?"
    } ]
  }, {
    "tStartMs": 232400,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "그렇네요"
    } ]
  }, {
    "tStartMs": 233890,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "그렇다면 태웅쌤은 지금 취미 있으신가요?"
    } ]
  }, {
    "tStartMs": 238110,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "지금요?"
    } ]
  }, {
    "tStartMs": 239000,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "지금 요즘"
    } ]
  }, {
    "tStartMs": 241850,
    "dDurationMs": 5770,
    "segs": [ {
      "utf8": "정말 안타까운 얘기지만 취미를 딱히 가질만한 시간이 제가 없어서"
    } ]
  }, {
    "tStartMs": 247620,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "취미를 누릴 시간이 없어요?"
    } ]
  }, {
    "tStartMs": 250080,
    "dDurationMs": 6690,
    "segs": [ {
      "utf8": "네, 하나 정도 생각해보면요"
    } ]
  }, {
    "tStartMs": 256770,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "제가 듀오링고? 일본어?"
    } ]
  }, {
    "tStartMs": 259540,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "오, 네"
    } ]
  }, {
    "tStartMs": 261500,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "듀오링고 일본어를 몇 달째 하고 있습니다"
    } ]
  }, {
    "tStartMs": 264740,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "듀오링고는 하루에 한 5분 정도 투자하면 되나요?"
    } ]
  }, {
    "tStartMs": 268550,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "5분도 안 걸릴 때도 있어요 한 번만 하면"
    } ]
  }, {
    "tStartMs": 272520,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "그 exercise 한 번만 하면"
    } ]
  }, {
    "tStartMs": 274820,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "거의 뭐 한 1분, 2분밖에 안 걸릴 때도 있어요"
    } ]
  }, {
    "tStartMs": 277860,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "오 딱 그 정도만 하시나요?"
    } ]
  }, {
    "tStartMs": 280710,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "네ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 283360,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "우와, 꾸준히 하기 어려운데 듀오링고\n- 딱 하나만..."
    } ]
  }, {
    "tStartMs": 286780,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "네, 그래서 아마 한 75일인가 오늘? 76일인가?"
    } ]
  }, {
    "tStartMs": 291490,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "오래 하셨네요"
    } ]
  }, {
    "tStartMs": 293430,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "네, 그렇습니다"
    } ]
  }, {
    "tStartMs": 294900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "듀오링고 하고 계시는구나"
    } ]
  }, {
    "tStartMs": 296800,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "네, 그냥 별 생각 없이"
    } ]
  }, {
    "tStartMs": 298590,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "진짜 막... '외국어 공부해야지'"
    } ]
  }, {
    "tStartMs": 303170,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "이렇게 생각해서 하는 게 아니라요"
    } ]
  }, {
    "tStartMs": 305050,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 306180,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "그냥 그 75일쯤 전에"
    } ]
  }, {
    "tStartMs": 309540,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "그 당시엔 제가 이렇게 바쁘지 않았어요"
    } ]
  }, {
    "tStartMs": 313060,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "할 게 너무 없는 거예요"
    } ]
  }, {
    "tStartMs": 314920,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "심심했구나"
    } ]
  }, {
    "tStartMs": 316450,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "네, 너무 심심했어요"
    } ]
  }, {
    "tStartMs": 318590,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "그래서 시작을 했거든요"
    } ]
  }, {
    "tStartMs": 322720,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "근데 이렇게 꾸준히 하고 있어요"
    } ]
  }, {
    "tStartMs": 326270,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "듀오링고가 확실히 스트라이크? 스트릭?"
    } ]
  }, {
    "tStartMs": 330590,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "스트릭, 네"
    } ]
  }, {
    "tStartMs": 331420,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "스트릭 때문에, 덕분에 그렇게 꾸준히 하고 계신 것 같아요?"
    } ]
  }, {
    "tStartMs": 335590,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "네 맞아요"
    } ]
  }, {
    "tStartMs": 338400,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "좀 기분 나쁘잖아요 그거 없어지면"
    } ]
  }, {
    "tStartMs": 339940,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "맞아요 그게 (기록이) 깨지잖아요"
    } ]
  }, {
    "tStartMs": 341340,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "그게 하루라도 건너뛰면"
    } ]
  }, {
    "tStartMs": 343350,
    "dDurationMs": 410,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 343760,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "아 그런 장치 때문에...."
    } ]
  }, {
    "tStartMs": 346340,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "어떡해 너무 바빠서..."
    } ]
  }, {
    "tStartMs": 349000,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "하 그렇죠"
    } ]
  }, {
    "tStartMs": 350270,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "지금 태웅쌤 인생에는 '재미'가 없나요?"
    } ]
  }, {
    "tStartMs": 354550,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "'재미'가 없어요 사실...ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 357230,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "재미, 또 뭐..."
    } ]
  }, {
    "tStartMs": 359660,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "가끔, 가끔이 아니라 자주 점심시간,"
    } ]
  }, {
    "tStartMs": 363500,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "잠깐 1시간 있는 점심시간에 점심 빨리 먹고"
    } ]
  }, {
    "tStartMs": 368710,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "집 앞에 한 10분 산책하는 거?"
    } ]
  }, {
    "tStartMs": 370510,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "아, 산책 ..."
    } ]
  }, {
    "tStartMs": 372130,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "ㅋㅋㅋ네, 한 10분"
    } ]
  }, {
    "tStartMs": 374570,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "아, 너무 작고 소중하네요"
    } ]
  }, {
    "tStartMs": 378540,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "어떡해, 고생이 많습니다"
    } ]
  }, {
    "tStartMs": 381570,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 382870,
    "dDurationMs": 5550,
    "segs": [ {
      "utf8": "지금 취미, 그러면 지금 취미 말고 좀 오래했다?"
    } ]
  }, {
    "tStartMs": 388420,
    "dDurationMs": 5110,
    "segs": [ {
      "utf8": "나의 취미로서 좀 오래 했다 할 만한 건 어떤 게 있을까요?"
    } ]
  }, {
    "tStartMs": 393530,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "오래 했다?"
    } ]
  }, {
    "tStartMs": 394410,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "좀 꾸준히 오래 한 거?"
    } ]
  }, {
    "tStartMs": 398690,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "비트메이킹? 음악?"
    } ]
  }, {
    "tStartMs": 400840,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 402560,
    "dDurationMs": 7650,
    "segs": [ {
      "utf8": "저 음악 노래 곡 만드는 거 그거에 관심이 정말 많았기 때문에"
    } ]
  }, {
    "tStartMs": 410210,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "그거를 몇 년간 꽤 오랫동안 했습니다"
    } ]
  }, {
    "tStartMs": 413860,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "공부도 하고 직접 만들기도 하고"
    } ]
  }, {
    "tStartMs": 416740,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "그쵸 그쵸"
    } ]
  }, {
    "tStartMs": 420800,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "그래서 제 유튜브에 나오는 모든 BGM들은 다 제가 만든 겁니다"
    } ]
  }, {
    "tStartMs": 424920,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "아 진짜요?"
    } ]
  }, {
    "tStartMs": 426560,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "네네"
    } ]
  }, {
    "tStartMs": 427510,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "그건 대박이다"
    } ]
  }, {
    "tStartMs": 428840,
    "dDurationMs": 650,
    "segs": [ {
      "utf8": "부럽다"
    } ]
  }, {
    "tStartMs": 429490,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "엔딩곡들 그런 거 다"
    } ]
  }, {
    "tStartMs": 431660,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "너무 유용한 취미인데요?"
    } ]
  }, {
    "tStartMs": 433890,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그쵸 재밌어요 엄청 재밌어요"
    } ]
  }, {
    "tStartMs": 435770,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "오 그러니까 할 수 있다면 너무 좋을 것 같은데"
    } ]
  }, {
    "tStartMs": 440510,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "추천합니다"
    } ]
  }, {
    "tStartMs": 442060,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "특별한 프로그램을 좀 배워야 되는 거죠 그거는?"
    } ]
  }, {
    "tStartMs": 445500,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "어..."
    } ]
  }, {
    "tStartMs": 446780,
    "dDurationMs": 6840,
    "segs": [ {
      "utf8": "그렇죠 뭔가 진짜 비트를 만들려면 프로그램으로 만들어야 되는데"
    } ]
  }, {
    "tStartMs": 453620,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "근데 뭐 음악이라는 게"
    } ]
  }, {
    "tStartMs": 456210,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "사실 그냥 사람의 목만 있어도 할 수 있는 거 아니겠어요"
    } ]
  }, {
    "tStartMs": 459730,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "그건 그렇죠 어렵지만"
    } ]
  }, {
    "tStartMs": 463270,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "잘하기가 어렵지만"
    } ]
  }, {
    "tStartMs": 465740,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "비트메이킹은 좀 작곡,"
    } ]
  }, {
    "tStartMs": 467750,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "곡을 만드는 거랑 똑같나요? 어떤가요?"
    } ]
  }, {
    "tStartMs": 472520,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "비슷한데 작곡은 더 넓은 개념인 것 같아요"
    } ]
  }, {
    "tStartMs": 479520,
    "dDurationMs": 5030,
    "segs": [ {
      "utf8": "진짜 말 그대로 곡, 노래를 만드는 거고"
    } ]
  }, {
    "tStartMs": 484550,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "비트 메이킹은 말 그대로"
    } ]
  }, {
    "tStartMs": 486810,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "그냥 비트 조금만 만들면..."
    } ]
  }, {
    "tStartMs": 490140,
    "dDurationMs": 7020,
    "segs": [ {
      "utf8": "🥁쿵치 탁치🥁 이런 비트만 만들면... 좀 뭐랄까"
    } ]
  }, {
    "tStartMs": 497160,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "그냥 그것도 비트 메이킹이라 할 수 있을 정도라고 할까요?"
    } ]
  }, {
    "tStartMs": 502100,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "정말로 비트만 있어도"
    } ]
  }, {
    "tStartMs": 504100,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "네네 좀 더 쉽죠"
    } ]
  }, {
    "tStartMs": 508160,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "비트메이킹은 어쩌다가 시작하게 됐어요?"
    } ]
  }, {
    "tStartMs": 511010,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "그냥 음악 듣는 걸 좋아해요 제가"
    } ]
  }, {
    "tStartMs": 514080,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "그런 비트가 있는 음악?"
    } ]
  }, {
    "tStartMs": 516100,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "어 네"
    } ]
  }, {
    "tStartMs": 517840,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "곡이 좋은 노래들"
    } ]
  }, {
    "tStartMs": 520380,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "곡이 좋은 노래?"
    } ]
  }, {
    "tStartMs": 521890,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "비트가 좋은... 막 그러니까 가사나"
    } ]
  }, {
    "tStartMs": 526800,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "노래 부르는 사람의 가창력이 막 뛰어난 게 아니더라도"
    } ]
  }, {
    "tStartMs": 532010,
    "dDurationMs": 6840,
    "segs": [ {
      "utf8": "그 뒤에 깔리는 악기들이 너무 듣기 좋은 것들이 있잖아요"
    } ]
  }, {
    "tStartMs": 538850,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 539840,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "근데 제가 그런 거에 되게 많이 끌리더라고요"
    } ]
  }, {
    "tStartMs": 544350,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "그래서 또 너무 좋아하다 보니까 내가 해보고 싶다"
    } ]
  }, {
    "tStartMs": 548630,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "그렇게 된 거죠"
    } ]
  }, {
    "tStartMs": 550300,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "요즘은 안 하세요? 비트메이킹?"
    } ]
  }, {
    "tStartMs": 552030,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "아 뭐 팟캐스트 할 때는 하시겠지만"
    } ]
  }, {
    "tStartMs": 556630,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "근데 꽤 오래된 것 같아요"
    } ]
  }, {
    "tStartMs": 558270,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 558880,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "한 1~2년 된 것 같은데 못한지"
    } ]
  }, {
    "tStartMs": 563490,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "물론 또 하면 합니다\n- 왜일까?"
    } ]
  }, {
    "tStartMs": 565660,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "그... 관심이 좀 줄어든 계기도 있어요?"
    } ]
  }, {
    "tStartMs": 570450,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "그건 아닌 것 같아요 그냥..."
    } ]
  }, {
    "tStartMs": 573300,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "아! 제가 좀 한번 하려면"
    } ]
  }, {
    "tStartMs": 577400,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "마음먹고 해야 되는 편이에요 뭐든지"
    } ]
  }, {
    "tStartMs": 581650,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "그냥 그냥 뭐 별 생각 없이"
    } ]
  }, {
    "tStartMs": 584900,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "노트북 아니면 컴퓨터 켜서 작업을 바로 하면"
    } ]
  }, {
    "tStartMs": 589050,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "뭐라도 만들다 말더라도 할 수 있는데"
    } ]
  }, {
    "tStartMs": 592020,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "마음의 준비를 계속 해야 되는 거예요"
    } ]
  }, {
    "tStartMs": 594730,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "딱 시간이 많아야 되고 집중할 수 있어야 되고"
    } ]
  }, {
    "tStartMs": 598890,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "다른 걱정이 없어야 되고"
    } ]
  }, {
    "tStartMs": 600210,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "그때 하겠어! 이렇게 하니까"
    } ]
  }, {
    "tStartMs": 603810,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "선뜻 못하게 되더라고요"
    } ]
  }, {
    "tStartMs": 606460,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "특히나 비트 메이킹이 그랬어요?"
    } ]
  }, {
    "tStartMs": 609120,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 610500,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "아이 뭐 많은 취미들이 다 그랬던 것 같기도 하고요 생각해보면"
    } ]
  }, {
    "tStartMs": 614080,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 615330,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 616770,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "근데 또 비트메이킹은 잘 모르지만"
    } ]
  }, {
    "tStartMs": 619960,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "그렇게 각 잡고 해야 되는 거 같아 보여요"
    } ]
  }, {
    "tStartMs": 625010,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "그러니까 막 그냥 영상 보기"
    } ]
  }, {
    "tStartMs": 626670,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "이런 거는 일상 속에 살 수 있잖아요 그런 취미들은"
    } ]
  }, {
    "tStartMs": 631740,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "그렇죠 그건 맞습니다"
    } ]
  }, {
    "tStartMs": 632880,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "시간과 노력이 많이 들어가야 되니까 그런 계기가 많이 없으셨네요"
    } ]
  }, {
    "tStartMs": 637570,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 638940,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "그렇군요"
    } ]
  }, {
    "tStartMs": 640360,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "제 거 하나 얘기했으니까 디디님 거는 어떤지 들어볼까요?"
    } ]
  }, {
    "tStartMs": 644030,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "제 취미? 뭐 어떤 거 궁금하세요?"
    } ]
  }, {
    "tStartMs": 647770,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "지금 취미 아니면 역대 취미?"
    } ]
  }, {
    "tStartMs": 653290,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "지금 취미부터 얘기해보죠"
    } ]
  }, {
    "tStartMs": 656050,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "지금 취미는 제가 이걸 많이 고민해봤어요"
    } ]
  }, {
    "tStartMs": 659760,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "사람이 저한테 취미가 뭐예요? 라고 물으면 뭐라고 얘기를 할지"
    } ]
  }, {
    "tStartMs": 664460,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "근데 아무리 생각해도 저는 영상 만들기,"
    } ]
  }, {
    "tStartMs": 668400,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "그리고 영상 보기, 영상을 보고 만드는 거가 취미예요"
    } ]
  }, {
    "tStartMs": 673750,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "이게 엄청 오랫동안 취미였고 지금은 일이 됐지만"
    } ]
  }, {
    "tStartMs": 678200,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "그래도 좋아서 하는 거라서"
    } ]
  }, {
    "tStartMs": 682610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "일이자 취미로 하고 있어요"
    } ]
  }, {
    "tStartMs": 684350,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "영상 보기는 뭐 영화 보고 애니메이션 보고 드라마 보고"
    } ]
  }, {
    "tStartMs": 688520,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "유튜브 보고 이럴 때 너무 재밌죠"
    } ]
  }, {
    "tStartMs": 693790,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "그렇게 이게 한국만 이런 건지 모르겠는데"
    } ]
  }, {
    "tStartMs": 697900,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "이게 한국이랑 다른 나라랑 문화 차이가 있는지 모르겠는데"
    } ]
  }, {
    "tStartMs": 701990,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "그렇게 딱 \"취미가 뭐예요?\" 이렇게 물어보면"
    } ]
  }, {
    "tStartMs": 705580,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "선뜻 좀 부담감이 느껴지는 부분이 있는 것 같지 않아요?"
    } ]
  }, {
    "tStartMs": 709910,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "맞아요 맞아요"
    } ]
  }, {
    "tStartMs": 711220,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "저도 그 얘기가 오늘 하고 싶었어요"
    } ]
  }, {
    "tStartMs": 714370,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "좀 한국은... 한국만 아닐 수도 있는데"
    } ]
  }, {
    "tStartMs": 719020,
    "dDurationMs": 6760,
    "segs": [ {
      "utf8": "\"취미가 뭐예요\"가 진짜 \"쉴 때 뭐해요?\"를 물어본다기 보다는"
    } ]
  }, {
    "tStartMs": 725780,
    "dDurationMs": 5710,
    "segs": [ {
      "utf8": "잘하는 거 뭐예요? 일 외에 잘하는 거 뭐예요? 라고 물어보는 것 같아요"
    } ]
  }, {
    "tStartMs": 731490,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "좀 그런 느낌?"
    } ]
  }, {
    "tStartMs": 733070,
    "dDurationMs": 6180,
    "segs": [ {
      "utf8": "그리고 \"그냥 영화 봐요\" 이러면 좀 재미없는 사람 되는 기분?"
    } ]
  }, {
    "tStartMs": 739250,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "맞아요 그런 것도 좀 있어요"
    } ]
  }, {
    "tStartMs": 740940,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "노잼! 이런 느낌"
    } ]
  }, {
    "tStartMs": 743810,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "그리고 뭔가 취미... 를 얘기할 때"
    } ]
  }, {
    "tStartMs": 749470,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "어떤 좀 생산적인 활동을 하기를 기대해요"
    } ]
  }, {
    "tStartMs": 753650,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "맞아요 쉴 때 하는 건데"
    } ]
  }, {
    "tStartMs": 755940,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 757660,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "그러니까 한국이 참 피곤한 사회입니다"
    } ]
  }, {
    "tStartMs": 762210,
    "dDurationMs": 6550,
    "segs": [ {
      "utf8": "취미도 만들어야 될 것 같은 그런 부담이 느껴지는..."
    } ]
  }, {
    "tStartMs": 768760,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "특히나 회사 가거나 이러면 진짜 취미 뭐냐고 많이 물어본대요"
    } ]
  }, {
    "tStartMs": 773440,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 774560,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "뭐 관심사를 물어보고 싶어 하는 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 779160,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "얼마나 열심히 사는 사람인지"
    } ]
  }, {
    "tStartMs": 780980,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "뭔가... 특이한 점이 있는 사람인지 없는지"
    } ]
  }, {
    "tStartMs": 784440,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "이런 거 알아내고 싶어 하는 것 같기도 하고"
    } ]
  }, {
    "tStartMs": 789710,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "그럴 때 할 만한 좀 재밌는 답변 같은 게 있을까요?"
    } ]
  }, {
    "tStartMs": 793430,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "좀 '이거 취미다' 하면 좀 있어 보이는 취미들"
    } ]
  }, {
    "tStartMs": 797560,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "몇 가지 있죠"
    } ]
  }, {
    "tStartMs": 798750,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "대표적인 게 뭐 독서?"
    } ]
  }, {
    "tStartMs": 800410,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "약간 \"책 읽어요😎\" 하는..."
    } ]
  }, {
    "tStartMs": 803680,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "어때요? (- 재밌지 않아요) 별로?"
    } ]
  }, {
    "tStartMs": 807840,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "아 근데 좀 있어 보이잖아요"
    } ]
  }, {
    "tStartMs": 810660,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "아니에요? (- 그런가?) 나는 그렇던데"
    } ]
  }, {
    "tStartMs": 814610,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "아 그런가?"
    } ]
  }, {
    "tStartMs": 816880,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "책을 많이 읽는 사람은 또 다른가?"
    } ]
  }, {
    "tStartMs": 819420,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "저는 좀 생각나는 게 하나 있거든요"
    } ]
  }, {
    "tStartMs": 823160,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "뭔데요?"
    } ]
  }, {
    "tStartMs": 824160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "저는 실제로 제가 가졌던 취미인데"
    } ]
  }, {
    "tStartMs": 826560,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "오오..."
    } ]
  }, {
    "tStartMs": 828830,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "들어볼게요"
    } ]
  }, {
    "tStartMs": 830030,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "지난 겨울에 가졌던 취미인데요"
    } ]
  }, {
    "tStartMs": 832190,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "네 네"
    } ]
  }, {
    "tStartMs": 833340,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "한 9시, 10시쯤 밤에 늦은 밤에"
    } ]
  }, {
    "tStartMs": 837970,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "바닷가 산책로에 나가서..."
    } ]
  }, {
    "tStartMs": 842830,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "ㅋㅋㅋ벌써 사기예요 바닷가가 어딨어 주변에"
    } ]
  }, {
    "tStartMs": 848020,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "네 바닷가"
    } ]
  }, {
    "tStartMs": 848760,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "바닷가 산책로에 나가서"
    } ]
  }, {
    "tStartMs": 850750,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "건물 빛들로부터 떨어진 곳까지 가서"
    } ]
  }, {
    "tStartMs": 856290,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "깜깜한 곳?"
    } ]
  }, {
    "tStartMs": 857540,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "네 깜깜한 곳에 가서"
    } ]
  }, {
    "tStartMs": 859740,
    "dDurationMs": 7010,
    "segs": [ {
      "utf8": "파도치는 밤바다 위에 뜬 별들을 감상하는 게 취미였습니다"
    } ]
  }, {
    "tStartMs": 868410,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "낭만 초과"
    } ]
  }, {
    "tStartMs": 870430,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "낭만 치사량 (- 초과 초과)"
    } ]
  }, {
    "tStartMs": 874080,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "그 산책로에 딱 이렇게 팔을 딱 대고요"
    } ]
  }, {
    "tStartMs": 878480,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "기대고 앉아서 이렇게 딱 하늘을 가만히 보고 있으면요"
    } ]
  }, {
    "tStartMs": 882900,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "가끔 이렇게 턱도 괴고 그러고 있으면"
    } ]
  }, {
    "tStartMs": 887650,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "딱 한 번에 별들이 다 보이지 않아요"
    } ]
  }, {
    "tStartMs": 890940,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "근데 그렇게 하늘을 가만히 보고 있으면"
    } ]
  }, {
    "tStartMs": 894150,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "점점 더 별들이 많이 보여요"
    } ]
  }, {
    "tStartMs": 896700,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "그렇죠 눈이 이제 익숙해지는 거죠"
    } ]
  }, {
    "tStartMs": 899550,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 901270,
    "dDurationMs": 7030,
    "segs": [ {
      "utf8": "그래서 그 별들을 보면서 파도 소리를 들으면서"
    } ]
  }, {
    "tStartMs": 908300,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "'나는 그저 우주의 먼지 하나일 뿐이구나'"
    } ]
  }, {
    "tStartMs": 912060,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "정말 감성 소년이시네요"
    } ]
  }, {
    "tStartMs": 914230,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 914980,
    "dDurationMs": 6010,
    "segs": [ {
      "utf8": "'이 세상에 쓸데없는 것들에 스트레스 받지 말자'"
    } ]
  }, {
    "tStartMs": 920990,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "'저 별들을 보자 우린 아무것도 아니야' 이렇게"
    } ]
  }, {
    "tStartMs": 926390,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "그게 저의 취미였습니다"
    } ]
  }, {
    "tStartMs": 927660,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "엄청난 취미다..."
    } ]
  }, {
    "tStartMs": 929510,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "상당히 멋있는데요?"
    } ]
  }, {
    "tStartMs": 931790,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "생각만으로 설레는 취미네요"
    } ]
  }, {
    "tStartMs": 934400,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "나도 하고 싶다"
    } ]
  }, {
    "tStartMs": 935690,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "다음에 누가 취미가 뭐냐고 물어보면 그렇게 대답해보세요"
    } ]
  }, {
    "tStartMs": 940570,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "바다가 없어요 주변에"
    } ]
  }, {
    "tStartMs": 942890,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "부산 사람만 가능한..."
    } ]
  }, {
    "tStartMs": 944510,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "아니 뭐... 그냥 높은 건물 옥상 올라가서 보는 게 취미에요"
    } ]
  }, {
    "tStartMs": 949760,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "별을 바라보는 게 취미에요?"
    } ]
  }, {
    "tStartMs": 952490,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 954140,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "장난 아닌데요?"
    } ]
  }, {
    "tStartMs": 955330,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "장난 아니죠"
    } ]
  }, {
    "tStartMs": 956620,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "와..."
    } ]
  }, {
    "tStartMs": 957790,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "그렇게 대답하면 어? 이 새끼 뭐지? 이렇게..."
    } ]
  }, {
    "tStartMs": 961870,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "뭐지 이 사람?ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 965090,
    "dDurationMs": 6470,
    "segs": [ {
      "utf8": "저는 그냥 보통 운동, 예술, 이쪽으로 생각을 했어요"
    } ]
  }, {
    "tStartMs": 971560,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "좀 심플하게"
    } ]
  }, {
    "tStartMs": 972700,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "클라이밍 이런 거?"
    } ]
  }, {
    "tStartMs": 974220,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "네ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 975740,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "많이 하는 거잖아요"
    } ]
  }, {
    "tStartMs": 977200,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "그렇죠 보법이 다르죠?"
    } ]
  }, {
    "tStartMs": 979080,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "뛰어넘네요"
    } ]
  }, {
    "tStartMs": 982470,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "보통이 아니네"
    } ]
  }, {
    "tStartMs": 983300,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "네, 그렇습니다"
    } ]
  }, {
    "tStartMs": 984930,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "재밌는데 또 있어요? 태웅 쌤 취미?"
    } ]
  }, {
    "tStartMs": 988130,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "또 있나? 생각해 보면 또 있을 거예요"
    } ]
  }, {
    "tStartMs": 990200,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "생각해 보면 또..."
    } ]
  }, {
    "tStartMs": 991270,
    "dDurationMs": 4430,
    "segs": [ {
      "utf8": "네 그쵸 근데 진짜 그런 것도 취미잖아요"
    } ]
  }, {
    "tStartMs": 995700,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "그냥 일 안 할 때"
    } ]
  }, {
    "tStartMs": 998660,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "조용히 혼자 이불 속에 가만히 누워있는다거나"
    } ]
  }, {
    "tStartMs": 1003680,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "그게 거기서 또 행복함을 느끼고 편안함을 느낀다면 취미가 될 수 있고"
    } ]
  }, {
    "tStartMs": 1009540,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "이불 속에서 그냥..."
    } ]
  }, {
    "tStartMs": 1011870,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "아 근데 어떻게 표현하는지 따라 좀 달라지는 것 같기도 하네요"
    } ]
  }, {
    "tStartMs": 1015840,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "태웅쌤도 그냥 간단하게 표현하면"
    } ]
  }, {
    "tStartMs": 1018980,
    "dDurationMs": 6220,
    "segs": [ {
      "utf8": "'바닷가에서 그냥 산책해요'라고 할 수도 있는 건데"
    } ]
  }, {
    "tStartMs": 1025200,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "스토리를 붙이는 것도 재밌네요"
    } ]
  }, {
    "tStartMs": 1027300,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 1029090,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "그럼 스토리를 한 번 붙여볼까요?"
    } ]
  }, {
    "tStartMs": 1030630,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "그냥 '취미가 난 딱히 없다'"
    } ]
  }, {
    "tStartMs": 1033410,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "그래서 그냥 이불 속에서 유튜브 보는 게 취미다 하는 사람이 있어요"
    } ]
  }, {
    "tStartMs": 1039810,
    "dDurationMs": 7160,
    "segs": [ {
      "utf8": "그분이 좀 낭만적으로 설명할 수 있는 방법이 있을까요?"
    } ]
  }, {
    "tStartMs": 1046970,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "어떤 유튜브? 어떤 유튜브 보는 거예요?"
    } ]
  }, {
    "tStartMs": 1049660,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "어떤 유튜브?"
    } ]
  }, {
    "tStartMs": 1050940,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1051580,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "침착맨?"
    } ]
  }, {
    "tStartMs": 1052750,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "침착맨? 침착맨 좋죠 최고죠"
    } ]
  }, {
    "tStartMs": 1055080,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "재밌는 거?"
    } ]
  }, {
    "tStartMs": 1056090,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "재밌는 거?"
    } ]
  }, {
    "tStartMs": 1056840,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "웃긴 영상들"
    } ]
  }, {
    "tStartMs": 1059830,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "아, 그건 좀 포장해 주기 어렵긴 한데ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 1063540,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "그런가? 그런가?"
    } ]
  }, {
    "tStartMs": 1066580,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "'추운 겨울날에...' 약간 이렇게 시작하는 거죠"
    } ]
  }, {
    "tStartMs": 1069640,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "추운 겨울에?"
    } ]
  }, {
    "tStartMs": 1070020,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "추운 겨울날에 집에서 보일러 틀어놓고"
    } ]
  }, {
    "tStartMs": 1074390,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "전기장판 틀어놓고"
    } ]
  }, {
    "tStartMs": 1075460,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "따뜻한 이불 속에 들어가서"
    } ]
  }, {
    "tStartMs": 1078690,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "약간 새로 올라온 영상들이나..."
    } ]
  }, {
    "tStartMs": 1083340,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "트렌드?"
    } ]
  }, {
    "tStartMs": 1085330,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "요즘 트렌드가 어떤 건지 확인하기 위해서..."
    } ]
  }, {
    "tStartMs": 1089410,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "오 저도 그 생각하고 있었습니다"
    } ]
  }, {
    "tStartMs": 1093930,
    "dDurationMs": 8500,
    "segs": [ {
      "utf8": "영상들 올라오는 거 보면서 웃고 그러는 게 취미다"
    } ]
  }, {
    "tStartMs": 1102430,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "'트렌드 캐칭' 하는 게 취미라고 하면 되겠네요"
    } ]
  }, {
    "tStartMs": 1106200,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "트렌드 캐칭..."
    } ]
  }, {
    "tStartMs": 1109610,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "발굴하는 거 뭐라고 하죠 발굴해내는 거"
    } ]
  }, {
    "tStartMs": 1112480,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "디깅(digging)"
    } ]
  }, {
    "tStartMs": 1113370,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "아 맞아 맞아 '트렌드 디깅'"
    } ]
  }, {
    "tStartMs": 1115590,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "트렌드 디깅"
    } ]
  }, {
    "tStartMs": 1118200,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "이렇게 포장할 수도 있다"
    } ]
  }, {
    "tStartMs": 1119650,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "그리고 인터넷 문화 평론 한다고 하면 되겠네요"
    } ]
  }, {
    "tStartMs": 1123300,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "ㅋㅋㅋ평론 그렇죠 그렇게 이야기하면 될 것 같고"
    } ]
  }, {
    "tStartMs": 1127580,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "그럼 태웅쌤은 지금까지 여러 가지 취미들"
    } ]
  }, {
    "tStartMs": 1131550,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "다양하게 있으셨을 것 같은데"
    } ]
  }, {
    "tStartMs": 1133620,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "좀 취미가 빨리빨리 바뀌는 편인 것 같아요?"
    } ]
  }, {
    "tStartMs": 1136120,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "아니면 하나를 좀 진득이 오래 하는 편인 것 같아요?"
    } ]
  }, {
    "tStartMs": 1141440,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "저는 빨리빨리 바뀌는 경우가 더 많았던 것 같아요"
    } ]
  }, {
    "tStartMs": 1149610,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "근데 그 이유는 글쎄요"
    } ]
  }, {
    "tStartMs": 1153600,
    "dDurationMs": 5570,
    "segs": [ {
      "utf8": "뭔가 배워야 할 수 있는 것들을"
    } ]
  }, {
    "tStartMs": 1159170,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "좀 취미로 가져보고 싶어 한 적이 많아서"
    } ]
  }, {
    "tStartMs": 1163380,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "근데 또 배우는 게 쉽지 않잖아요"
    } ]
  }, {
    "tStartMs": 1165710,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1166500,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "그럼 이제 빨리 포기하면 (- 배우는 거?)"
    } ]
  }, {
    "tStartMs": 1170420,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "취미가 바뀌는 거죠 뭐 예를 들면"
    } ]
  }, {
    "tStartMs": 1173530,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "피아노 연습이라던가"
    } ]
  }, {
    "tStartMs": 1176350,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "아니면 뭐 노래 연습이라던가"
    } ]
  }, {
    "tStartMs": 1180700,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "외국어 배우기라던가 그런 거?"
    } ]
  }, {
    "tStartMs": 1184580,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "태웅쌤은 그럼 보통 '저거 하면 멋있겠다'"
    } ]
  }, {
    "tStartMs": 1189290,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "아니면 '이거 멋있다' 하는 거를 좀 시도해 보는 편인가요?"
    } ]
  }, {
    "tStartMs": 1193380,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "취미 같은 거 할 때?"
    } ]
  }, {
    "tStartMs": 1195170,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "무조건"
    } ]
  }, {
    "tStartMs": 1196150,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "이거 딱 봤을 때?"
    } ]
  }, {
    "tStartMs": 1198290,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1199120,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "그러다 보니까 배우는 거네요"
    } ]
  }, {
    "tStartMs": 1201860,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "그렇죠 그렇죠"
    } ]
  }, {
    "tStartMs": 1204130,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "저는 좀 한 가지 오래 하는 스타일인 거 같아요"
    } ]
  }, {
    "tStartMs": 1208050,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "그동안 취미라고 했던 게 크게 변화가 없고"
    } ]
  }, {
    "tStartMs": 1213380,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "영상 만들고 하는 것도"
    } ]
  }, {
    "tStartMs": 1215150,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "거의 뭐 한 10년 정도 하고 있는 것 같고"
    } ]
  }, {
    "tStartMs": 1219290,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "학생 때는 저는 그림 그리는 거 좋아했었거든요"
    } ]
  }, {
    "tStartMs": 1222590,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "어떤 종류의 그림?"
    } ]
  }, {
    "tStartMs": 1224580,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "그냥 만화 같은 거 친구들이랑 그리고"
    } ]
  }, {
    "tStartMs": 1228510,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "뭐 다양한 거 그때 오일 페인팅?"
    } ]
  }, {
    "tStartMs": 1231120,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "오일 파스텔? 페인팅? 이런 것도 유행했어서 그런 것도 해보고"
    } ]
  }, {
    "tStartMs": 1236630,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "그때는 그림 그리는 거였는데 이제 그게 영상으로 넘어가고"
    } ]
  }, {
    "tStartMs": 1241030,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "외국어도 오래 하고 있고요"
    } ]
  }, {
    "tStartMs": 1242880,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "외국어 취미도"
    } ]
  }, {
    "tStartMs": 1246190,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "한 가지 좀 오래 하는 편인 거 같아요"
    } ]
  }, {
    "tStartMs": 1250030,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "부럽네요"
    } ]
  }, {
    "tStartMs": 1251460,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "그런가요?"
    } ]
  }, {
    "tStartMs": 1252580,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "그렇게 오래 한다는 거는 경험이 쌓여서 잘할 수 있다는 말이잖아요"
    } ]
  }, {
    "tStartMs": 1257300,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "아 그쵸 그쵸"
    } ]
  }, {
    "tStartMs": 1261940,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "뭐 하나를 이제 정해서"
    } ]
  }, {
    "tStartMs": 1264670,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "잘할 때까지 하는 거 같아요"
    } ]
  }, {
    "tStartMs": 1269180,
    "dDurationMs": 6620,
    "segs": [ {
      "utf8": "부럽다 저도 일본어를 취미로 좀 진득하게 꾸준히 했으면"
    } ]
  }, {
    "tStartMs": 1275800,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "지금쯤 잘하고 있을 텐데..."
    } ]
  }, {
    "tStartMs": 1279020,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "태웅쌤 너무 바쁘시잖아요 다른 거 하느라고"
    } ]
  }, {
    "tStartMs": 1281720,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "남은 게 없네요"
    } ]
  }, {
    "tStartMs": 1284220,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "무슨 소리예요ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 1286840,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "지금도 얼마나 열심히 하고 계신데"
    } ]
  }, {
    "tStartMs": 1291390,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "감사합니다"
    } ]
  }, {
    "tStartMs": 1292570,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "태웅쌤은 좀 아이디어가 많으셔서 빨리 빨리 바꾸는 것 같기도 해요"
    } ]
  }, {
    "tStartMs": 1298290,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "그럴 수도 있어요"
    } ]
  }, {
    "tStartMs": 1301180,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "그리고 또 멋있다고 생각하는 게 빨리 바뀌기도 해서"
    } ]
  }, {
    "tStartMs": 1305210,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "그럼 많은 걸 접하는 걸까요?"
    } ]
  }, {
    "tStartMs": 1307720,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "그렇죠 그렇다고 볼 수 있죠"
    } ]
  }, {
    "tStartMs": 1312490,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "어디서 그런 영감들이 생길까요?"
    } ]
  }, {
    "tStartMs": 1315760,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "사람들과의 대화? 미디어?"
    } ]
  }, {
    "tStartMs": 1319060,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "미디어가 많은 것 같아요"
    } ]
  }, {
    "tStartMs": 1323520,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "지금 하고 있는 일본어는?"
    } ]
  }, {
    "tStartMs": 1326180,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "일본어요?"
    } ]
  }, {
    "tStartMs": 1327620,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "영화나 그런 거 보고 생각하신 거예요?"
    } ]
  }, {
    "tStartMs": 1330760,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "그건 아니에요 일본어는 아니에요"
    } ]
  }, {
    "tStartMs": 1332670,
    "dDurationMs": 5890,
    "segs": [ {
      "utf8": "일본어는 왜 배우고 싶냐면"
    } ]
  }, {
    "tStartMs": 1338560,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "그게 한국이 사실상 섬나라잖아요"
    } ]
  }, {
    "tStartMs": 1343420,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "우리 대한민국 위에는 북한이 있기 때문에"
    } ]
  }, {
    "tStartMs": 1347230,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "비행기를 타고 가야 되죠"
    } ]
  }, {
    "tStartMs": 1349390,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "네 무조건 비행기를 타고 가야 되는데"
    } ]
  }, {
    "tStartMs": 1352100,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "근데 일본이 제일 가깝잖아요"
    } ]
  }, {
    "tStartMs": 1355010,
    "dDurationMs": 6860,
    "segs": [ {
      "utf8": "그러면 제일 가까운 나라의 언어를 잘 알면"
    } ]
  }, {
    "tStartMs": 1361870,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "제일 가기 쉬운 나라니까"
    } ]
  }, {
    "tStartMs": 1363140,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "더 많은 재미를 경험할 수 있고"
    } ]
  }, {
    "tStartMs": 1365930,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "더 많은 맛있는 것도 먹을 수 있고"
    } ]
  }, {
    "tStartMs": 1369720,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "편하게 더 깊이 즐길 수 있을 것 같아서"
    } ]
  }, {
    "tStartMs": 1374810,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "그래서 항상 배우고 싶다는 생각을 계속해요"
    } ]
  }, {
    "tStartMs": 1377980,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "맞아"
    } ]
  }, {
    "tStartMs": 1378920,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "또 배우면 더 많이 가게 되거든요"
    } ]
  }, {
    "tStartMs": 1383740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "그게 좋아요 저도"
    } ]
  }, {
    "tStartMs": 1385300,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "저도 일본어 배우는 계기 중에 하나가"
    } ]
  }, {
    "tStartMs": 1388400,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "자주 갈 수 있으니까"
    } ]
  }, {
    "tStartMs": 1390460,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "영어는 막 배워놨더니 쓸 데가 없는 거예요"
    } ]
  }, {
    "tStartMs": 1394840,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "쓸 데가 없어"
    } ]
  }, {
    "tStartMs": 1396960,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "쓸 사람도 없고 주변에 찾기 힘들고"
    } ]
  }, {
    "tStartMs": 1400150,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "일본은 워낙 많이 오시기도 하고"
    } ]
  }, {
    "tStartMs": 1402500,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "저도 많이 갈 수 있으니까"
    } ]
  }, {
    "tStartMs": 1404320,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "그쵸"
    } ]
  }, {
    "tStartMs": 1405370,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "써먹을 일이 많아서 좀 좋은 외국어인 것 같아요"
    } ]
  }, {
    "tStartMs": 1410640,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "한국인들한테 쉽기도 하고"
    } ]
  }, {
    "tStartMs": 1412450,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "배우실 생각은 없으세요? 진득하게?"
    } ]
  }, {
    "tStartMs": 1415290,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "아 뭐 듀오링고도 진득하게 하고 있고"
    } ]
  }, {
    "tStartMs": 1419930,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "하루에 1분ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 1421940,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "그리고 가끔... 일본어 팟캐스트도 들어요"
    } ]
  }, {
    "tStartMs": 1426660,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "어떤 거요?"
    } ]
  }, {
    "tStartMs": 1427340,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "팟캐스트는 안 듣고"
    } ]
  }, {
    "tStartMs": 1430360,
    "dDurationMs": 4930,
    "segs": [ {
      "utf8": "일본어 배우는 책에 나오는 MP3 파일 들어요"
    } ]
  }, {
    "tStartMs": 1435290,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "아 그렇구나"
    } ]
  }, {
    "tStartMs": 1437340,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "후지 아사리 선생님의 '일본어 무작정 따라하기'를"
    } ]
  }, {
    "tStartMs": 1442430,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "알아요"
    } ]
  }, {
    "tStartMs": 1444180,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "가끔씩 듣고 있습니다"
    } ]
  }, {
    "tStartMs": 1445680,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "그렇구나"
    } ]
  }, {
    "tStartMs": 1447380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "맞아 잘하고 계시네요"
    } ]
  }, {
    "tStartMs": 1449180,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "감사합니다"
    } ]
  }, {
    "tStartMs": 1451740,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "사실요 제가 가끔 이런 생각을 해요"
    } ]
  }, {
    "tStartMs": 1454830,
    "dDurationMs": 6220,
    "segs": [ {
      "utf8": "일본어랑 중국어를 또 같이 배우고 싶거든요"
    } ]
  }, {
    "tStartMs": 1461050,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "저도 중국어"
    } ]
  }, {
    "tStartMs": 1462960,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "한중일 언어를 다 배우고 배우는 거잖아요"
    } ]
  }, {
    "tStartMs": 1466590,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1467500,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "저는 그렇게 다 배워서..."
    } ]
  }, {
    "tStartMs": 1470060,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "나중에 스파이 하고 싶어요"
    } ]
  }, {
    "tStartMs": 1474320,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "누가 시켜준대요?"
    } ]
  }, {
    "tStartMs": 1478530,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "잘하면 할 수 있지 않을까요?"
    } ]
  }, {
    "tStartMs": 1480970,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "어떤 스파이?"
    } ]
  }, {
    "tStartMs": 1482270,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "그냥 몰라요 아무거나 ?"
    } ]
  }, {
    "tStartMs": 1486300,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "왜요? 또 무슨 영화 보셨어요?"
    } ]
  }, {
    "tStartMs": 1490370,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "이거는 스파이랑은 사실 상관없는데"
    } ]
  }, {
    "tStartMs": 1495500,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "바스터즈 거친 녀석들이라는 쿠엔틴 타란티노 감독님의 영화가 있는데"
    } ]
  }, {
    "tStartMs": 1502300,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "제가 그걸 진짜 좋아해서 여러 번 봤거든요"
    } ]
  }, {
    "tStartMs": 1504390,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "엄청 좋아하시잖아요"
    } ]
  }, {
    "tStartMs": 1506470,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "근데 거기서 제가 제일 좋아하는 캐릭터가"
    } ]
  }, {
    "tStartMs": 1510160,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "한스 란다라는 캐릭터인데"
    } ]
  }, {
    "tStartMs": 1512260,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "그 캐릭터는 여러 나라의 말을 할 수 있어요"
    } ]
  }, {
    "tStartMs": 1517220,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "독일어,"
    } ]
  }, {
    "tStartMs": 1518260,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "영어는 당연히 하고"
    } ]
  }, {
    "tStartMs": 1520530,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "이탈리아어... 막 그렇게 막 여러 나라의 말을 하거든요"
    } ]
  }, {
    "tStartMs": 1524720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "프랑스어도 하고"
    } ]
  }, {
    "tStartMs": 1527600,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "근데 그 2차 대전 World War2때"
    } ]
  }, {
    "tStartMs": 1531960,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "스파이들이 있고"
    } ]
  }, {
    "tStartMs": 1534130,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "나라를 숨기고 그런 사람들이 있는데"
    } ]
  }, {
    "tStartMs": 1538180,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "그 한스 란다가 그 언어를 이용해서"
    } ]
  }, {
    "tStartMs": 1542940,
    "dDurationMs": 5990,
    "segs": [ {
      "utf8": "저 사람은 스파이다, 저 사람은 거짓말을 하고 있다"
    } ]
  }, {
    "tStartMs": 1548930,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "막 이런 거를 되게 잘 알아내요"
    } ]
  }, {
    "tStartMs": 1552300,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "그래서 그 영화에서 되게 악당으로 나오는 나쁜 사람인데"
    } ]
  }, {
    "tStartMs": 1557960,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "근데 그 사람의 가장 무서운 능력이"
    } ]
  }, {
    "tStartMs": 1560910,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "그 언어 능력인 거예요"
    } ]
  }, {
    "tStartMs": 1564370,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "되게 초능력 같다"
    } ]
  }, {
    "tStartMs": 1566370,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "네네"
    } ]
  }, {
    "tStartMs": 1567970,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "그 언어와 그리고 문화를 잘 아는 능력이거든요"
    } ]
  }, {
    "tStartMs": 1573180,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1575030,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "근데 그 영화 자체가"
    } ]
  }, {
    "tStartMs": 1577050,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "그런 언어와 문화에 대한 영화예요 사실"
    } ]
  }, {
    "tStartMs": 1580000,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 1581210,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "그게 그냥 전쟁 영화가 아니라"
    } ]
  }, {
    "tStartMs": 1583420,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "봐야겠다"
    } ]
  }, {
    "tStartMs": 1584620,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "재밌어요 진짜 재밌어요"
    } ]
  }, {
    "tStartMs": 1585850,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "아직도 안 봤어ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 1588910,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "아무튼 근데 저 캐릭터를 볼 때마다"
    } ]
  }, {
    "tStartMs": 1592830,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "'와 저게 힘이구나'"
    } ]
  }, {
    "tStartMs": 1598570,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "저게 힘이다"
    } ]
  }, {
    "tStartMs": 1599300,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "너무 강하다"
    } ]
  }, {
    "tStartMs": 1600660,
    "dDurationMs": 6380,
    "segs": [ {
      "utf8": "그러면은 내 경우에는 나는 동양인 아시아인이니까"
    } ]
  }, {
    "tStartMs": 1607040,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "일본어랑 중국어를 좀 잘하면 어떻게 좀 헤어스타일"
    } ]
  }, {
    "tStartMs": 1611750,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "이렇게 좀 이케멘컷으로 하면..."
    } ]
  }, {
    "tStartMs": 1614980,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "일본인인척 좀 하고"
    } ]
  }, {
    "tStartMs": 1618870,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "또 막 중국 스타일도 하면"
    } ]
  }, {
    "tStartMs": 1620850,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "또 중국 문화에서 딱 하고 재밌을 것 같더라고요"
    } ]
  }, {
    "tStartMs": 1626110,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "힘을 가질 수 있겠다"
    } ]
  }, {
    "tStartMs": 1627940,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그쵸 그쵸"
    } ]
  }, {
    "tStartMs": 1628800,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "그쵸 그쵸"
    } ]
  }, {
    "tStartMs": 1629960,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "제가 이런 생각을 계속해요"
    } ]
  }, {
    "tStartMs": 1633980,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "파워 N이시네요"
    } ]
  }, {
    "tStartMs": 1635470,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "네 ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 1638190,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "그래 맞아 그러다 보니까 점점 취미들이 늘어나네요"
    } ]
  }, {
    "tStartMs": 1642450,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1643510,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "관심사만 늘어나"
    } ]
  }, {
    "tStartMs": 1644860,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "어떡해"
    } ]
  }, {
    "tStartMs": 1646820,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "빨리 일본어 하고 중국어도 하셔야죠"
    } ]
  }, {
    "tStartMs": 1649380,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "그래야 되겠다 빨리 일단 일본어 마무리하고"
    } ]
  }, {
    "tStartMs": 1653660,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "중국어도 해야 되겠다"
    } ]
  }, {
    "tStartMs": 1655140,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "근데 뭔가 이거는 취미랑 관련 없지만"
    } ]
  }, {
    "tStartMs": 1657440,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "그 영화 얘기를 들으니까 생각이 나는 게"
    } ]
  }, {
    "tStartMs": 1661020,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "언어가 초능력 같이 느껴질 때가 있어요"
    } ]
  }, {
    "tStartMs": 1666020,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "뭔가 만화 같은 거 볼 때도 초능력 딱 쓰잖아요 쓰는 타이밍이 있잖아요"
    } ]
  }, {
    "tStartMs": 1671530,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "항상 쓰는 게 아니라"
    } ]
  }, {
    "tStartMs": 1673140,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "'순간이동 지금 시작한다!' 이렇게 하잖아요"
    } ]
  }, {
    "tStartMs": 1676040,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "근데 외국어도 집중 안 하고 있으면 안 들릴 때 있잖아요"
    } ]
  }, {
    "tStartMs": 1681300,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1682150,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "근데 지금 내가 이제 '들어볼게' 하면 들리거든요"
    } ]
  }, {
    "tStartMs": 1687610,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "그게 좀 약간 초능력처럼 느껴질 때가 있어요"
    } ]
  }, {
    "tStartMs": 1690300,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "그 언어 모르는 친구들이랑 여행가서"
    } ]
  }, {
    "tStartMs": 1693250,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "이제 뒤에 사람이 하는 얘기 알고 싶어해"
    } ]
  }, {
    "tStartMs": 1696910,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "그러면 '잠깐만 내가 들어볼게' 해서 해석하는"
    } ]
  }, {
    "tStartMs": 1701080,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "그게 초능력처럼 느껴졌습니다"
    } ]
  }, {
    "tStartMs": 1703510,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "맞아요 맞아요 뭐 이거를 보고 계시는 구독자님들도"
    } ]
  }, {
    "tStartMs": 1707520,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "아마 대부분이 많은 분이 취미로 한국어를 배우고 계시지 않을까요?"
    } ]
  }, {
    "tStartMs": 1712360,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "맞아요 그러네요"
    } ]
  }, {
    "tStartMs": 1713920,
    "dDurationMs": 5150,
    "segs": [ {
      "utf8": "듣고 계시는 분들은 대부분 취미 뭐냐고 물어보면"
    } ]
  }, {
    "tStartMs": 1719070,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "한국어 공부라고 하실 것 같아요"
    } ]
  }, {
    "tStartMs": 1722520,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "팟캐스트 듣기 이런 거"
    } ]
  }, {
    "tStartMs": 1725200,
    "dDurationMs": 7170,
    "segs": [ {
      "utf8": "근데 취미로 한국어를 배워서 이 팟캐스트를 즐길 수 있다는 건"
    } ]
  }, {
    "tStartMs": 1732370,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "참 대단한 것 같습니다"
    } ]
  }, {
    "tStartMs": 1735470,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "그렇죠 시간도 진짜 많이 쓰셨다는 거고"
    } ]
  }, {
    "tStartMs": 1738630,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 1741400,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "새삼 대단하시네요"
    } ]
  }, {
    "tStartMs": 1742770,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "맞습니다"
    } ]
  }, {
    "tStartMs": 1744610,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "최근에 가졌다가 없어진 없어진 취미라던가"
    } ]
  }, {
    "tStartMs": 1748660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "취미라던가 있나요?"
    } ]
  }, {
    "tStartMs": 1750460,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "최근에 가졌다가 없어진 거"
    } ]
  }, {
    "tStartMs": 1752760,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1754170,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "하...라고 하니까"
    } ]
  }, {
    "tStartMs": 1755460,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "제일 최근 취미?"
    } ]
  }, {
    "tStartMs": 1759190,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "제가... 또 작아지는데"
    } ]
  }, {
    "tStartMs": 1762350,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "운동을 취미로 하는 게 평생 소원이에요"
    } ]
  }, {
    "tStartMs": 1766570,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "평생 숙제고"
    } ]
  }, {
    "tStartMs": 1767940,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "근데 일본 한 달 살기 가기 전에는 좀 열심히 했었어요"
    } ]
  }, {
    "tStartMs": 1772340,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "헬스장도 끊어놓고"
    } ]
  }, {
    "tStartMs": 1774400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "PT도 받으면서 했는데"
    } ]
  }, {
    "tStartMs": 1776860,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "또 텀이 생겨버렸어요 일본 다녀오면서"
    } ]
  }, {
    "tStartMs": 1780550,
    "dDurationMs": 6630,
    "segs": [ {
      "utf8": "이제 다시 등록해야 되는 상태입니다"
    } ]
  }, {
    "tStartMs": 1787180,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "저랑 사정이 비슷하네요"
    } ]
  }, {
    "tStartMs": 1790310,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "왜요? 왜요?"
    } ]
  }, {
    "tStartMs": 1791520,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "왜냐하면 오늘의 주제를 취미로 고른 이유가"
    } ]
  }, {
    "tStartMs": 1796420,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "제가 지난번 요모조모 녹화할 때"
    } ]
  }, {
    "tStartMs": 1799840,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "수영 다니고 있었잖아요"
    } ]
  }, {
    "tStartMs": 1802620,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "그래서 '수영 주제로 할까요?' 이러다가"
    } ]
  }, {
    "tStartMs": 1806420,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "'취미로 해요' 이렇게 된 거 있으니까\n- 맞아요 좀 더 넓게"
    } ]
  }, {
    "tStartMs": 1810180,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "그러네요 수영 어디 갔어요?"
    } ]
  }, {
    "tStartMs": 1812960,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "그 수영을... 아침 수영을 다니다가"
    } ]
  }, {
    "tStartMs": 1816980,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "제가 아침에 못 다니게 되는 상황이 되어버려서"
    } ]
  }, {
    "tStartMs": 1821740,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "바빠서?"
    } ]
  }, {
    "tStartMs": 1822580,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "네, 바빠서 아예 못 다니게 됐죠"
    } ]
  }, {
    "tStartMs": 1826290,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "그래서 한 두 달?"
    } ]
  }, {
    "tStartMs": 1827500,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "두 달도 못... 한 달 반 하고 끝났습니다"
    } ]
  }, {
    "tStartMs": 1830210,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "뭐 어떻게 저녁 수영이라도 시간이 없던가요?"
    } ]
  }, {
    "tStartMs": 1833870,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "저녁도 안 돼요"
    } ]
  }, {
    "tStartMs": 1838530,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "얼마나 바쁜 삶을 살고 계신 겁니까?"
    } ]
  }, {
    "tStartMs": 1841640,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "그러니까요 지금 이 팟캐스트도 겨우 짬 내서 하는 겁니다"
    } ]
  }, {
    "tStartMs": 1845580,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "정말 감사합니다...ㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 1849180,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "수영... 근데 또 겨울이라"
    } ]
  }, {
    "tStartMs": 1851730,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "추워서 되게 힘들 것 같은데? 겨울 수영?"
    } ]
  }, {
    "tStartMs": 1856030,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "아니에요"
    } ]
  }, {
    "tStartMs": 1857080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "물이 따뜻해요?"
    } ]
  }, {
    "tStartMs": 1858280,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "어... 물론 처음 들어갈 땐 좀 추운데"
    } ]
  }, {
    "tStartMs": 1862020,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "근데 따뜻한 물이 나오는 것 같아요"
    } ]
  }, {
    "tStartMs": 1866380,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "조금 그렇구나"
    } ]
  }, {
    "tStartMs": 1868360,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "네 엄연히 실내 스포츠입니다"
    } ]
  }, {
    "tStartMs": 1871040,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "겨울에 물에 들어가서 젖은 상태로 나와서"
    } ]
  }, {
    "tStartMs": 1875440,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "다시 밖을 걸어야 된다는 생각이 좀..."
    } ]
  }, {
    "tStartMs": 1879550,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "근데 수영장 안은 따뜻해요"
    } ]
  }, {
    "tStartMs": 1883820,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "그런가요?"
    } ]
  }, {
    "tStartMs": 1884670,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "네 전혀 춥지 않습니다"
    } ]
  }, {
    "tStartMs": 1886530,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "그럼 되게 좋아했던 취미인데 즐겁게 했던 취미인데"
    } ]
  }, {
    "tStartMs": 1890030,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "바빠서 못하게 되신 거예요?"
    } ]
  }, {
    "tStartMs": 1891870,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1892710,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "아 저런..."
    } ]
  }, {
    "tStartMs": 1894760,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "수영 참 제가 할 수 있는 얘기가 많은데"
    } ]
  }, {
    "tStartMs": 1898050,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "아무튼 짧게 얘기하자면"
    } ]
  }, {
    "tStartMs": 1901600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "제가 태어나서 처음 수영을 배워본 거예요"
    } ]
  }, {
    "tStartMs": 1904100,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 1905650,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "네네"
    } ]
  }, {
    "tStartMs": 1907040,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "그래서 처음 일주일 동안은"
    } ]
  }, {
    "tStartMs": 1912030,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "수영장에 가기 한 1시간 전부터 떨렸어요"
    } ]
  }, {
    "tStartMs": 1915080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "무서워서 물에 들어가는 게 무서워서"
    } ]
  }, {
    "tStartMs": 1917240,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "진짜? 긴장됐구나"
    } ]
  }, {
    "tStartMs": 1919280,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "네 그래서 처음에는"
    } ]
  }, {
    "tStartMs": 1922590,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "물 안에 얼굴을 넣는 것도"
    } ]
  }, {
    "tStartMs": 1925970,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "심장이 두근거리고"
    } ]
  }, {
    "tStartMs": 1929190,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "두근두근하고 무서웠는데"
    } ]
  }, {
    "tStartMs": 1932600,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "근데 재미를 붙여서"
    } ]
  }, {
    "tStartMs": 1936130,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "엄청 그래도 무섭지는 않게 됐거든요"
    } ]
  }, {
    "tStartMs": 1940320,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "오 이제 떨리진 않아요?"
    } ]
  }, {
    "tStartMs": 1942760,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "네, 안 떨리고 재밌고"
    } ]
  }, {
    "tStartMs": 1944430,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "네네네"
    } ]
  }, {
    "tStartMs": 1945610,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "근데 아쉽게도 그만하게 됐습니다"
    } ]
  }, {
    "tStartMs": 1950220,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "어디까지 배우셨어요?"
    } ]
  }, {
    "tStartMs": 1952040,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "그냥 자유형"
    } ]
  }, {
    "tStartMs": 1953380,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "자유형"
    } ]
  }, {
    "tStartMs": 1954840,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "자유형하고 그리고 누워서 하는 배영"
    } ]
  }, {
    "tStartMs": 1957710,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "배영까지?"
    } ]
  }, {
    "tStartMs": 1958900,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1960420,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "어떡해, 접영 평형 남았는데..."
    } ]
  }, {
    "tStartMs": 1963230,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 1964460,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "끝나고 바쁜 거 다 끝나면 바로 다시 하실 거예요?"
    } ]
  }, {
    "tStartMs": 1968260,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 1969010,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "아... 하면 돼요 하면 돼"
    } ]
  }, {
    "tStartMs": 1971760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "바로 다시 할 겁니다"
    } ]
  }, {
    "tStartMs": 1973200,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "운동이 제가 취미가 되지 못한 이유가"
    } ]
  }, {
    "tStartMs": 1977850,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "아까 취미가 재밌어야 된다고 했잖아요"
    } ]
  }, {
    "tStartMs": 1982110,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "재미가 없어요"
    } ]
  }, {
    "tStartMs": 1983290,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "그래서 취미가 될 수 없는 것 같아요"
    } ]
  }, {
    "tStartMs": 1986650,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 1987190,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "그게 참 어려운 것 같아요"
    } ]
  }, {
    "tStartMs": 1992570,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "재미를 느끼는 지점까지 가야 되는데"
    } ]
  }, {
    "tStartMs": 1997650,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "근데 그걸 재미를 못 느끼면 어쩔 수 없죠"
    } ]
  }, {
    "tStartMs": 2000630,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "그렇죠 그렇죠"
    } ]
  }, {
    "tStartMs": 2002140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "계속 숙제로 남아있고"
    } ]
  }, {
    "tStartMs": 2003940,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2005430,
    "dDurationMs": 5450,
    "segs": [ {
      "utf8": "그럼 이제 마지막으로 아까 잠깐 얘기했던 건데"
    } ]
  }, {
    "tStartMs": 2010880,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "한국 사회에서는 취미를 의무적으로 가지고 있는 느낌"
    } ]
  }, {
    "tStartMs": 2016160,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "아니면 사회에서 강요하는 느낌"
    } ]
  }, {
    "tStartMs": 2018630,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "\"너 취미 있어야 돼\" 하는 분위기가 있는 것 같다라는 얘기가 나왔었는데"
    } ]
  }, {
    "tStartMs": 2025030,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "그렇다면 이 취미라는 거는 꼭 있어야 되는가에 대해서"
    } ]
  }, {
    "tStartMs": 2029780,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "이야기를 해보고 싶어요"
    } ]
  }, {
    "tStartMs": 2031650,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "취미는 꼭 있어야 될까요?"
    } ]
  }, {
    "tStartMs": 2033300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "태웅쌤 생각은 어떠세요?"
    } ]
  }, {
    "tStartMs": 2036000,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "제 생각은..."
    } ]
  }, {
    "tStartMs": 2038090,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "어... 글쎄요..."
    } ]
  }, {
    "tStartMs": 2040400,
    "dDurationMs": 5390,
    "segs": [ {
      "utf8": "근데 그게..."
    } ]
  }, {
    "tStartMs": 2045790,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "뭐 제 생각이 정답은 아니지만"
    } ]
  }, {
    "tStartMs": 2050180,
    "dDurationMs": 8070,
    "segs": [ {
      "utf8": "문제가 그 질문이 약간은 좀 넌센스 같기도 해요"
    } ]
  }, {
    "tStartMs": 2058250,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "어떤 의미에서요?"
    } ]
  }, {
    "tStartMs": 2059680,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "취미가 없을 수는 없다,"
    } ]
  }, {
    "tStartMs": 2061990,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "그러니까 취미가 있어야 할까? 없어도 될까?"
    } ]
  }, {
    "tStartMs": 2066360,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "그 생각을 하기 전에 '취미는 누구에게나 일단 있다'"
    } ]
  }, {
    "tStartMs": 2071300,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "라고 생각하세요?"
    } ]
  }, {
    "tStartMs": 2072620,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "네네"
    } ]
  }, {
    "tStartMs": 2073470,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "저도 그렇게 생각해요"
    } ]
  }, {
    "tStartMs": 2075420,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "아 그래요?"
    } ]
  }, {
    "tStartMs": 2076510,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "네네네"
    } ]
  }, {
    "tStartMs": 2078800,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "그래서 우리가 같은 생각이니까"
    } ]
  }, {
    "tStartMs": 2082940,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "여기서 이 생각을 가지고 이 질문을 다시 한번 생각해보면"
    } ]
  }, {
    "tStartMs": 2088120,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "그러면 이 질문이 사실 얘기하는 건"
    } ]
  }, {
    "tStartMs": 2091500,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "뭔가 좀 특별한 취미, 멋있는"
    } ]
  }, {
    "tStartMs": 2096210,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "✌️취미✌️"
    } ]
  }, {
    "tStartMs": 2097580,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "✌️취미✌️가 있어야 할까?"
    } ]
  }, {
    "tStartMs": 2098930,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "네, 맞아요"
    } ]
  }, {
    "tStartMs": 2102570,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "그렇게 생각해볼까요? 질문을?"
    } ]
  }, {
    "tStartMs": 2105360,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "그럴까요?"
    } ]
  }, {
    "tStartMs": 2107810,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "그렇죠 그렇죠"
    } ]
  }, {
    "tStartMs": 2108720,
    "dDurationMs": 5570,
    "segs": [ {
      "utf8": "이제 취미를... \"취미가 뭐예요?\"에 쉽게 대답하지 못하는 이유가"
    } ]
  }, {
    "tStartMs": 2114290,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "가장 큰 게 그냥 일상이라서"
    } ]
  }, {
    "tStartMs": 2117080,
    "dDurationMs": 4330,
    "segs": [ {
      "utf8": "취미라고 생각하지 않으시는 것 같아요 많은 분들이"
    } ]
  }, {
    "tStartMs": 2121410,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "예를 들면 그냥 핸드폰 보는 거 누구는 취미라고 얘기할 수도 있지만"
    } ]
  }, {
    "tStartMs": 2126500,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "누구는 그냥 하루에 일과잖아요"
    } ]
  }, {
    "tStartMs": 2130430,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "근데 이제 뭐 남들한테 '저 이거 관심 있는 사람이에요'"
    } ]
  }, {
    "tStartMs": 2135010,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "할 만한 그런 취미가 있어야 되는지"
    } ]
  }, {
    "tStartMs": 2138590,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "있으면 좋은지 같은 거 다시 생각해볼까요"
    } ]
  }, {
    "tStartMs": 2143710,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "저는 없어도 되는 것 같아요"
    } ]
  }, {
    "tStartMs": 2146290,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "왜요?"
    } ]
  }, {
    "tStartMs": 2149280,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "꼭 있어야 할까요?"
    } ]
  }, {
    "tStartMs": 2152990,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "그러면... 그건 그래요 그건 맞아요 없어도 돼요"
    } ]
  }, {
    "tStartMs": 2157840,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "네... 저 취미 하나 또 있습니다!"
    } ]
  }, {
    "tStartMs": 2161100,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "뭔데요?"
    } ]
  }, {
    "tStartMs": 2162090,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "편의점 가서 과자 사먹기"
    } ]
  }, {
    "tStartMs": 2166020,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "취미에요 진짜로"
    } ]
  }, {
    "tStartMs": 2167870,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "종종 사먹고"
    } ]
  }, {
    "tStartMs": 2169700,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "즐겁고"
    } ]
  }, {
    "tStartMs": 2171190,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "모르는 과자 맛보기"
    } ]
  }, {
    "tStartMs": 2174610,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "새로 나온 과자 먹어보기 취미에요"
    } ]
  }, {
    "tStartMs": 2178490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "그러면 어떻게 생각해야 되지?"
    } ]
  }, {
    "tStartMs": 2180170,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "지금도 있습니다 여기..."
    } ]
  }, {
    "tStartMs": 2182400,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "최근에 맛있는 거 있어요?"
    } ]
  }, {
    "tStartMs": 2183710,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "빈츠 말차맛"
    } ]
  }, {
    "tStartMs": 2185180,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "말차 맛~ 봤어요 봤어요"
    } ]
  }, {
    "tStartMs": 2188820,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "또 뭐 신기한 거 있던데 빈츠"
    } ]
  }, {
    "tStartMs": 2192240,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "고구마 맛인가?"
    } ]
  }, {
    "tStartMs": 2193490,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "고구마 맛 있어요 맞아요"
    } ]
  }, {
    "tStartMs": 2194890,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "그쵸 그쵸"
    } ]
  }, {
    "tStartMs": 2196060,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "초점이 안 맞네"
    } ]
  }, {
    "tStartMs": 2197460,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "빈츠 말차 괜찮던가요?"
    } ]
  }, {
    "tStartMs": 2199210,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "맛있어요"
    } ]
  }, {
    "tStartMs": 2200550,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "말차 좋아하시는구나"
    } ]
  }, {
    "tStartMs": 2202690,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "그냥 나쁘진 않은데"
    } ]
  }, {
    "tStartMs": 2204510,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "빈츠..."
    } ]
  }, {
    "tStartMs": 2206500,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "제 취미라는 걸 제가 또 보여드리겠습니다"
    } ]
  }, {
    "tStartMs": 2210080,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2210700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "이 빈츠가요"
    } ]
  }, {
    "tStartMs": 2213220,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "그 이렇게 어떻게 생겼냐면"
    } ]
  }, {
    "tStartMs": 2216660,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "이 과자 비스킷 위에,"
    } ]
  }, {
    "tStartMs": 2219340,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "비스킷 위에 이렇게 초콜렛이 발라져 있거든요"
    } ]
  }, {
    "tStartMs": 2223900,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "이렇게 생겼습니다"
    } ]
  }, {
    "tStartMs": 2225860,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "살짝 고급스러워"
    } ]
  }, {
    "tStartMs": 2227280,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "어 살짝 고급스러워요"
    } ]
  }, {
    "tStartMs": 2229380,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "근데 이렇게 잘 자세히 보면은"
    } ]
  }, {
    "tStartMs": 2231720,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "이 비스킷보다 가에 초콜렛이 좀 더 넓게 발려져 있어요"
    } ]
  }, {
    "tStartMs": 2237040,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "그래서 저는 어떻게 빈츠를 재밌게 먹냐면"
    } ]
  }, {
    "tStartMs": 2241570,
    "dDurationMs": 7400,
    "segs": [ {
      "utf8": "이렇게 가에 초콜릿이 있는 부분을 이렇게 먹습니다"
    } ]
  }, {
    "tStartMs": 2248970,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "뭐 어떻게 먹는 건데요 그게?"
    } ]
  }, {
    "tStartMs": 2251870,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "아 튀어나온 부분을?"
    } ]
  }, {
    "tStartMs": 2254360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "약간 달고나 깨먹듯이?"
    } ]
  }, {
    "tStartMs": 2256520,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "그렇죠 그렇죠"
    } ]
  }, {
    "tStartMs": 2257150,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "가에 튀어나온 부분만 톡톡 떼먹어요"
    } ]
  }, {
    "tStartMs": 2261340,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "그러면 일단 처음에는 비스켓 없이 초콜릿만 먹는 거죠"
    } ]
  }, {
    "tStartMs": 2266010,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "오 초콜릿 먼저 즐기고?"
    } ]
  }, {
    "tStartMs": 2268100,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "네 이렇게 이렇게"
    } ]
  }, {
    "tStartMs": 2271310,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "아니 설명하시면서 지금 자연스럽게 과자..."
    } ]
  }, {
    "tStartMs": 2275960,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "당 떨어지신 거 아니에요?"
    } ]
  }, {
    "tStartMs": 2278110,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "아 좀 떨어져서...ㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 2281440,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "아무튼 이렇게 해서 가에 있는 초콜릿을"
    } ]
  }, {
    "tStartMs": 2284890,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "초콜릿 맛만 딱 즐기는 거예요"
    } ]
  }, {
    "tStartMs": 2287350,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2288860,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "굉장히 전문적인데요?"
    } ]
  }, {
    "tStartMs": 2290710,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "그쵸 이미 과자 두 개의 역할을 하는 거예요"
    } ]
  }, {
    "tStartMs": 2296990,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "그러니까"
    } ]
  }, {
    "tStartMs": 2297630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "네, 이렇게 가에(가장자리)를 다 먹고 나면"
    } ]
  }, {
    "tStartMs": 2299880,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "비스켓을 입에 한 입에 왕 넣어서 먹습니다"
    } ]
  }, {
    "tStartMs": 2303200,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "빈츠 맛있게 먹는 법을 연구해내셨네요"
    } ]
  }, {
    "tStartMs": 2306230,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "그러니까 이제 취미라고 할 수 있죠"
    } ]
  }, {
    "tStartMs": 2308030,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "그러니까 이게 와인 테이스팅이랑 뭐가 달라요"
    } ]
  }, {
    "tStartMs": 2310160,
    "dDurationMs": 3790,
    "segs": [ {
      "utf8": "맞아요! 그러니까"
    } ]
  }, {
    "tStartMs": 2313950,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "맛있네요"
    } ]
  }, {
    "tStartMs": 2316820,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "웃기다"
    } ]
  }, {
    "tStartMs": 2318980,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "있어 보이는 취미"
    } ]
  }, {
    "tStartMs": 2320420,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "그러니까 이거 다 생각하기 나름입니다"
    } ]
  }, {
    "tStartMs": 2322620,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "맞아요 맞아요 맞아요"
    } ]
  }, {
    "tStartMs": 2326050,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "신경 쓰지 말고 자기가 좋아하는 거 하면 되고"
    } ]
  }, {
    "tStartMs": 2328800,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "그리고 첫인상에서는 취미가..."
    } ]
  }, {
    "tStartMs": 2333250,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "좋은 인상을 줄 수 있는 도구인 것 같긴 해요"
    } ]
  }, {
    "tStartMs": 2339270,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "이 사람을 파악할 때"
    } ]
  }, {
    "tStartMs": 2341960,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "근데 이제 시간을 두고 보면 어차피 사람은 파악이 되니까"
    } ]
  }, {
    "tStartMs": 2347300,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "취미는 좀 첫인상에서 약간 킥?"
    } ]
  }, {
    "tStartMs": 2352700,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "약간 포인트?"
    } ]
  }, {
    "tStartMs": 2354460,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "뭐라고 하지?"
    } ]
  }, {
    "tStartMs": 2355760,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "스프링클? 같은 게 될 수 있다?"
    } ]
  }, {
    "tStartMs": 2358710,
    "dDurationMs": 530,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 2359240,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "예를 들어 소개팅... 또 계속 소개팅인데"
    } ]
  }, {
    "tStartMs": 2363040,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "소개팅에 나온 분께서 취미가 뭐냐라고 태웅 선생님이 물어봤을 때"
    } ]
  }, {
    "tStartMs": 2369110,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "좀 멋있는 취미, 예를 들면...."
    } ]
  }, {
    "tStartMs": 2373070,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "어떤 거요?"
    } ]
  }, {
    "tStartMs": 2374250,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "뭐가 있지?"
    } ]
  }, {
    "tStartMs": 2375290,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "승마?"
    } ]
  }, {
    "tStartMs": 2377010,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "뭐요 뭐요?"
    } ]
  }, {
    "tStartMs": 2377640,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "승마? 그래 맞아 승마 이런 거 한대요"
    } ]
  }, {
    "tStartMs": 2382020,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "그러면 좀 플러스 점수 되지 않겠어요?"
    } ]
  }, {
    "tStartMs": 2384770,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "그럴 수 있죠"
    } ]
  }, {
    "tStartMs": 2386940,
    "dDurationMs": 5450,
    "segs": [ {
      "utf8": "그거랑 '전 취미 그냥 누워서 유튜브 보는 거예요' 이거랑"
    } ]
  }, {
    "tStartMs": 2392390,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "그렇긴 하네요"
    } ]
  }, {
    "tStartMs": 2395140,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "근데 승마를 취미라고 얘기를 하려면"
    } ]
  }, {
    "tStartMs": 2400120,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "진짜 승마를 해야 돼요"
    } ]
  }, {
    "tStartMs": 2402420,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "그렇죠?"
    } ]
  }, {
    "tStartMs": 2403420,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "네 저는 가끔 그렇게 '독서가 취미입니다'"
    } ]
  }, {
    "tStartMs": 2407910,
    "dDurationMs": 5910,
    "segs": [ {
      "utf8": "라고 얘기하는 사람을 만나면 되게 저는 기대하거든요"
    } ]
  }, {
    "tStartMs": 2413820,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "얼마나...!"
    } ]
  }, {
    "tStartMs": 2414850,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "책 얘기할 수 있겠다! 좋아하는 책 뭐지?"
    } ]
  }, {
    "tStartMs": 2419270,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "요새 뭐 읽지?"
    } ]
  }, {
    "tStartMs": 2420920,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "근데 막상 알고 나면 책을 거의 안 읽어"
    } ]
  }, {
    "tStartMs": 2426920,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "깊이가 없어"
    } ]
  }, {
    "tStartMs": 2428610,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "그럼 좀 오히려 더 실망하게 되더라고요"
    } ]
  }, {
    "tStartMs": 2433510,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "여기서 또 좋은 핵심이 나왔네요"
    } ]
  }, {
    "tStartMs": 2436710,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "보여주기식 취미는 들통이 납니다"
    } ]
  }, {
    "tStartMs": 2441550,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "오히려 마이너스가 될 수 있어요"
    } ]
  }, {
    "tStartMs": 2446350,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "차라리 진짜 솔직하게 말하되"
    } ]
  }, {
    "tStartMs": 2451300,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "과자 맛있게 먹기 연구하기라던가"
    } ]
  }, {
    "tStartMs": 2454700,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "스토리를 붙이면..."
    } ]
  }, {
    "tStartMs": 2457550,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "붙이려고 하는 게 아니라 그냥 같이 얘기하다 보면"
    } ]
  }, {
    "tStartMs": 2462430,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "인정하게 돼요 취미구나"
    } ]
  }, {
    "tStartMs": 2465920,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "그렇게 위트가 필요합니다"
    } ]
  }, {
    "tStartMs": 2470480,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "인생은 위트다"
    } ]
  }, {
    "tStartMs": 2473700,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "좋은데요?"
    } ]
  }, {
    "tStartMs": 2474810,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "가에 초코를 다 먹었습니다"
    } ]
  }, {
    "tStartMs": 2477340,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "그 다음에는 어떻게 하나요?"
    } ]
  }, {
    "tStartMs": 2480360,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "아 한 입에~"
    } ]
  }, {
    "tStartMs": 2483390,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "맛있겠다 말차 빈츠"
    } ]
  }, {
    "tStartMs": 2486970,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "좋아 좋아 오늘 그러면 이렇게 취미 이야기 해봤고요"
    } ]
  }, {
    "tStartMs": 2490090,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "태웅쌤이 드시는 동안 저는 이번 주 퀴즈를 드리도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 2494490,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "이번 주 퀴즈는요"
    } ]
  }, {
    "tStartMs": 2496310,
    "dDurationMs": 6370,
    "segs": [ {
      "utf8": "저희들, 오늘 이야기한 저랑 태웅쌤의 취미로 언급이 되지 않은 거"
    } ]
  }, {
    "tStartMs": 2502680,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "골라주시면 되고요"
    } ]
  }, {
    "tStartMs": 2503660,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "옛날의 취미도 괜찮고 지금의 취미도 괜찮은데"
    } ]
  }, {
    "tStartMs": 2506760,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "저희 둘의 취미가 아니었던 거 골라주시면 됩니다"
    } ]
  }, {
    "tStartMs": 2510720,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "1번 수영"
    } ]
  }, {
    "tStartMs": 2513080,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "2번 그림 그리기"
    } ]
  }, {
    "tStartMs": 2515850,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "3번 승마"
    } ]
  }, {
    "tStartMs": 2518840,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "네 좋습니다"
    } ]
  }, {
    "tStartMs": 2519510,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "그러면 이제 저희는 다음 코너로 넘어가 보겠습니다"
    } ]
  }, {
    "tStartMs": 2534510,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "이제 말로 하는 미니게임 코너입니다"
    } ]
  }, {
    "tStartMs": 2537350,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "오늘 게임은 한 판 승부로 가져와봤어요"
    } ]
  }, {
    "tStartMs": 2540040,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "근데 좀 이야기할 거리가 있는 게임으로 가져와봤고요"
    } ]
  }, {
    "tStartMs": 2543990,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "어떤 게임이냐면 1위 맞추기 게임이에요 1위 맞추기"
    } ]
  }, {
    "tStartMs": 2549750,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "저희가 이제 구글에 '대한민국 사람들이 가장 많이 하는 취미'"
    } ]
  }, {
    "tStartMs": 2555260,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "뭐 이런 걸 쳐볼 건데"
    } ]
  }, {
    "tStartMs": 2556520,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "그 중에서 1위로 나오는 게 뭔지 맞춰보는 그런 게임이고요"
    } ]
  }, {
    "tStartMs": 2561760,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "저도 찾아보지 않았고요"
    } ]
  }, {
    "tStartMs": 2563130,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "태웅쌤도 오늘 들으셨습니다"
    } ]
  }, {
    "tStartMs": 2566520,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "어렵다..."
    } ]
  }, {
    "tStartMs": 2567460,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "한국에서 인기 있는 취미들 쭉 이야기해보다가"
    } ]
  }, {
    "tStartMs": 2570910,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "1위가 뭔지 각각 하나씩 맞춰봅시다"
    } ]
  }, {
    "tStartMs": 2575930,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "일단 1위로 생각하는 거 있습니까?"
    } ]
  }, {
    "tStartMs": 2578540,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "저는 우선..."
    } ]
  }, {
    "tStartMs": 2580890,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "근데 이게 성별에 따라 달라질 것 같아요"
    } ]
  }, {
    "tStartMs": 2585200,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 2587620,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "우선 남자라면 무조건 게임"
    } ]
  }, {
    "tStartMs": 2590460,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "아 게임이 있었네 맞네"
    } ]
  }, {
    "tStartMs": 2592960,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "...이 나오지 않을까?"
    } ]
  }, {
    "tStartMs": 2594240,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "PC방의 나라이기도 하고"
    } ]
  }, {
    "tStartMs": 2597460,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "게임 안 하시는 분들 거의 못 봤어요"
    } ]
  }, {
    "tStartMs": 2601210,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "남자분들 중에는"
    } ]
  }, {
    "tStartMs": 2605490,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "맞네 저 최근 취미로도 게임이 있었어요"
    } ]
  }, {
    "tStartMs": 2608540,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "아 게임 있으셨어요?"
    } ]
  }, {
    "tStartMs": 2610040,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "네네 최근에 재밌게 게임 시작했다가"
    } ]
  }, {
    "tStartMs": 2613330,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "한 일주일 정도밖에 못하고"
    } ]
  }, {
    "tStartMs": 2616990,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "지금은 못하게 됐습니다 바빠서"
    } ]
  }, {
    "tStartMs": 2619370,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "게임조차..."
    } ]
  }, {
    "tStartMs": 2621760,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "재미없어"
    } ]
  }, {
    "tStartMs": 2625150,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "재미가 진짜 없네"
    } ]
  }, {
    "tStartMs": 2626750,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "그러니까요 재미가 없는 삶을 살고 있습니다 지금"
    } ]
  }, {
    "tStartMs": 2630300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "게임 그쵸 태웅쌤도 좋아하시고"
    } ]
  }, {
    "tStartMs": 2632500,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "네 그쵸"
    } ]
  }, {
    "tStartMs": 2634520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "아무튼 게임?"
    } ]
  }, {
    "tStartMs": 2636500,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "근데 아... 여자분들은 많이 안 하시니까"
    } ]
  }, {
    "tStartMs": 2641340,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "그렇죠 여자분들이라고 하면은"
    } ]
  }, {
    "tStartMs": 2643620,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "아 근데 저는 이것도 얘기해보고 싶었는데"
    } ]
  }, {
    "tStartMs": 2646890,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "약간 네일아트 받고 이런 거 있잖아요"
    } ]
  }, {
    "tStartMs": 2649600,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "이런 것도 취미일까요?"
    } ]
  }, {
    "tStartMs": 2652450,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "뭔가 화장품 사기 이런 거"
    } ]
  }, {
    "tStartMs": 2654940,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "화장하기"
    } ]
  }, {
    "tStartMs": 2655900,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "저도 그게 헷갈리는 부분이에요"
    } ]
  }, {
    "tStartMs": 2658050,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "그렇죠 매일 하는 거라"
    } ]
  }, {
    "tStartMs": 2661200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "이걸 취미라고 해도 되나?"
    } ]
  }, {
    "tStartMs": 2663360,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "만약에 취미라면 저도 그런 게 취미인데"
    } ]
  }, {
    "tStartMs": 2667420,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "그렇게 볼 수 있지 않을까요?"
    } ]
  }, {
    "tStartMs": 2669920,
    "dDurationMs": 6750,
    "segs": [ {
      "utf8": "근데 보통 취미는 활동을 이야기하는 것 같아요"
    } ]
  }, {
    "tStartMs": 2676670,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "활동 액티비티"
    } ]
  }, {
    "tStartMs": 2678620,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "과자 사 먹기도 일단 먹는 활동을 하니까"
    } ]
  }, {
    "tStartMs": 2682240,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "행동이 있어야 돼"
    } ]
  }, {
    "tStartMs": 2684890,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "그래서 솔직히 네일 받고 머리 하고 이런 건 그냥 가만히 앉아서 받는 거니까"
    } ]
  }, {
    "tStartMs": 2689430,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2690240,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "취미라고 얘기 안 되는 거 같아요"
    } ]
  }, {
    "tStartMs": 2693190,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "그렇네요"
    } ]
  }, {
    "tStartMs": 2695700,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "그러면 뭐가 있을까?"
    } ]
  }, {
    "tStartMs": 2697570,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "저는 두 가지 당연히 높을 거라고 생각하는 게 있는데"
    } ]
  }, {
    "tStartMs": 2700990,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "어떤 거요?"
    } ]
  }, {
    "tStartMs": 2702400,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "영어 감상과 독서요"
    } ]
  }, {
    "tStartMs": 2705970,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "독서?"
    } ]
  }, {
    "tStartMs": 2707420,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "독서 많아요, 근데?"
    } ]
  }, {
    "tStartMs": 2708940,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "책 요즘 많이 읽나요, 사람들?"
    } ]
  }, {
    "tStartMs": 2710880,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "제 생각에는..."
    } ]
  }, {
    "tStartMs": 2713220,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "독서를 실제로 하는 사람들이 많은지는 모르겠는데"
    } ]
  }, {
    "tStartMs": 2716850,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2717700,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "취미라고 묻는 질문에 독서라고 대답하는 사람이 많을 것 같아요"
    } ]
  }, {
    "tStartMs": 2721430,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "아, 이렇게 설문지 체크 일단 하는 거죠?"
    } ]
  }, {
    "tStartMs": 2723940,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2724720,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "책 뭐 한 권이라도 최근에 읽었으면"
    } ]
  }, {
    "tStartMs": 2727870,
    "dDurationMs": 5570,
    "segs": [ {
      "utf8": "음... 영화랑 독서"
    } ]
  }, {
    "tStartMs": 2733440,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "네 근데 뭐 요즘은"
    } ]
  }, {
    "tStartMs": 2735650,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "요즘은 뭐 유튜브 감상?"
    } ]
  }, {
    "tStartMs": 2737810,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "유튜브 감상"
    } ]
  }, {
    "tStartMs": 2739010,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "이것도 취미라고 할 수 있다면"
    } ]
  }, {
    "tStartMs": 2741820,
    "dDurationMs": 7370,
    "segs": [ {
      "utf8": "그쵸 그러면... 드라마 이런 것도 다 영화 감상으로..."
    } ]
  }, {
    "tStartMs": 2749190,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "뭔가 보는 거... 그러네요"
    } ]
  }, {
    "tStartMs": 2752180,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "이게 제일 흔한 취미 같긴 하네요"
    } ]
  }, {
    "tStartMs": 2756260,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "그리고 한국인들이 특히 영화를 엄청 좋아하는 것 같아요"
    } ]
  }, {
    "tStartMs": 2761880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "그렇지 않아요?"
    } ]
  }, {
    "tStartMs": 2764520,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "옛날에는 그렇게 생각했거든요"
    } ]
  }, {
    "tStartMs": 2767260,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "특히 영화관을 많이 갔어요 한국인들이"
    } ]
  }, {
    "tStartMs": 2770880,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "그래서 영화관 이벤트 같은 거,"
    } ]
  }, {
    "tStartMs": 2774080,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "할리우드 배우들도 한국 꼭 거쳐가고 이랬잖아요"
    } ]
  }, {
    "tStartMs": 2777090,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "맞아요"
    } ]
  }, {
    "tStartMs": 2777970,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "근데 넷플릭스 나오면서는 전 세계적으로 많이 보는 것 같아요"
    } ]
  }, {
    "tStartMs": 2782690,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "아, 이제는?"
    } ]
  }, {
    "tStartMs": 2783900,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2784480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "아, 다른 나라들도 많이 보게 돼서?"
    } ]
  }, {
    "tStartMs": 2786760,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2787730,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "오, 일리있네요"
    } ]
  }, {
    "tStartMs": 2790080,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "한국인들이 많이 하는 거 하니까 또 생각난 게"
    } ]
  }, {
    "tStartMs": 2793010,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "여행"
    } ]
  }, {
    "tStartMs": 2794600,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "해외 여행"
    } ]
  }, {
    "tStartMs": 2796000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "그렇죠"
    } ]
  }, {
    "tStartMs": 2797600,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "많이 가는 것 같아요"
    } ]
  }, {
    "tStartMs": 2798980,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "어딜 가나 있죠"
    } ]
  }, {
    "tStartMs": 2802120,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "어딜 가나 있고"
    } ]
  }, {
    "tStartMs": 2804720,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "저는 좀 놀란 게 가까운 나라 일본에 갔을 때"
    } ]
  }, {
    "tStartMs": 2810240,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "또래 친구들 중에 여권이 없다라고 하는 친구들이 꽤 있었거든요"
    } ]
  }, {
    "tStartMs": 2814820,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "근데 한국에는 찾기 힘들잖아요"
    } ]
  }, {
    "tStartMs": 2818650,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "여권 없는 또래 친구..."
    } ]
  }, {
    "tStartMs": 2822400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "한번 크게 붐이 있었어요 여행 붐"
    } ]
  }, {
    "tStartMs": 2824860,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "맞아요 그 얘기하려고 했는데"
    } ]
  }, {
    "tStartMs": 2828910,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "한국은 유행의 나라입니다"
    } ]
  }, {
    "tStartMs": 2832590,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "이거 한다 하면 다 따라해요"
    } ]
  }, {
    "tStartMs": 2834920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 2837080,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "맞아 맞아"
    } ]
  }, {
    "tStartMs": 2838770,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "또 유행했던 거"
    } ]
  }, {
    "tStartMs": 2841110,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "또 그런 취미가 있나?"
    } ]
  }, {
    "tStartMs": 2843690,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "골프나 테니스?"
    } ]
  }, {
    "tStartMs": 2845210,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "이런 것도 최근에 좀 많이 하는 것 같아요"
    } ]
  }, {
    "tStartMs": 2849190,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 2849860,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "좀 유행하는 것 같더라고요"
    } ]
  }, {
    "tStartMs": 2853690,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "또 놓친 게 있나? 없는 것 같은데"
    } ]
  }, {
    "tStartMs": 2856060,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "이제 많이 할 만한 취미는 다 얘기한 것 같은데요"
    } ]
  }, {
    "tStartMs": 2860900,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "지금 이야기한 것 중에 운동이 많이 없었거든요"
    } ]
  }, {
    "tStartMs": 2865960,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "골프, 테니스는 그냥 최근에 유행한 거고"
    } ]
  }, {
    "tStartMs": 2869270,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "운동 중에... 헬스장 가기?"
    } ]
  }, {
    "tStartMs": 2871680,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "이런 거 취미로 많이 있을까요?"
    } ]
  }, {
    "tStartMs": 2874230,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "있죠, 있겠죠"
    } ]
  }, {
    "tStartMs": 2875580,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "있을 것 같아요? 헬스장? 네"
    } ]
  }, {
    "tStartMs": 2877280,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "헬스장 그리고 러닝"
    } ]
  }, {
    "tStartMs": 2879260,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "러닝 맞네"
    } ]
  }, {
    "tStartMs": 2881200,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "달리기"
    } ]
  }, {
    "tStartMs": 2881700,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "러닝 유행했었네요 러닝"
    } ]
  }, {
    "tStartMs": 2884180,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "요즘도 공원 같은 데 가면 날이 되게 추운데도"
    } ]
  }, {
    "tStartMs": 2887890,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "러닝 크루들 다 같이 뛰는 분들 많이 보여요"
    } ]
  }, {
    "tStartMs": 2892060,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2892800,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "그쵸 제일 인기 있는 거는 헬스장, 러닝 정도인 것 같네요"
    } ]
  }, {
    "tStartMs": 2898300,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 2899840,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "그럼 지금까지 나온 거"
    } ]
  }, {
    "tStartMs": 2901430,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "게임, 영화 감상, 독서,"
    } ]
  }, {
    "tStartMs": 2904120,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "유튜브 감상, 해외여행, 헬스장, 러닝 이렇게 있는데"
    } ]
  }, {
    "tStartMs": 2908770,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "태웅쌤은 어떤 거 고르시겠어요? 1위로?"
    } ]
  }, {
    "tStartMs": 2911490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "영화 감상"
    } ]
  }, {
    "tStartMs": 2913170,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "영화 감상?"
    } ]
  }, {
    "tStartMs": 2914310,
    "dDurationMs": 710,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2915020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "그럼 저 유튜브 감상 해도 돼요?"
    } ]
  }, {
    "tStartMs": 2917660,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "박빙인데?"
    } ]
  }, {
    "tStartMs": 2921950,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "핸드폰을 많이 하는 것 같아요"
    } ]
  }, {
    "tStartMs": 2924190,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "아 그렇죠 그렇죠 그렇죠"
    } ]
  }, {
    "tStartMs": 2926490,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "요즘은 그냥 폰"
    } ]
  }, {
    "tStartMs": 2928320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "쉴 때 폰 하기"
    } ]
  }, {
    "tStartMs": 2930060,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "아 맞다 그리고 그 질문에"
    } ]
  }, {
    "tStartMs": 2933970,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "그 근본 대답이 선택지가 하나 또 있는데 놓쳤네요"
    } ]
  }, {
    "tStartMs": 2937420,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "어떤 거요?"
    } ]
  }, {
    "tStartMs": 2938500,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "음악 감상"
    } ]
  }, {
    "tStartMs": 2940860,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "음악 감상"
    } ]
  }, {
    "tStartMs": 2943060,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "아 오 쟁쟁한데?"
    } ]
  }, {
    "tStartMs": 2944670,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "네, 음악 감상이 있다"
    } ]
  }, {
    "tStartMs": 2946810,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "음악 안 듣는 사람 찾기 힘들죠"
    } ]
  }, {
    "tStartMs": 2948910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "그쵸, 그쵸"
    } ]
  }, {
    "tStartMs": 2950560,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "맞네, 무조건 음악은 다 들으실 것 같은데?"
    } ]
  }, {
    "tStartMs": 2953380,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2954220,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "그럼 태웅쌤은 음악 감상으로?"
    } ]
  }, {
    "tStartMs": 2957690,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "영화 감상할게요"
    } ]
  }, {
    "tStartMs": 2960790,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "그러니까 음악도 취미로 얘기...를 못해 왜냐면 다 하니까"
    } ]
  }, {
    "tStartMs": 2964960,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "그러니까요"
    } ]
  }, {
    "tStartMs": 2966500,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "음악 듣는 분들 중에서도 되게 전문적으로 듣는 분들 있잖아요"
    } ]
  }, {
    "tStartMs": 2971750,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "음악에 좀 깊이 있게"
    } ]
  }, {
    "tStartMs": 2973440,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "매니아틱하게"
    } ]
  }, {
    "tStartMs": 2974920,
    "dDurationMs": 5650,
    "segs": [ {
      "utf8": "네 그런 분들도 좀 잘 이야기하기 어려울 것 같아요"
    } ]
  }, {
    "tStartMs": 2980570,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "그럼 영화 감상으로?"
    } ]
  }, {
    "tStartMs": 2982510,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "네"
    } ]
  }, {
    "tStartMs": 2985370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "저는 유튜브 감상으로 하겠습니다"
    } ]
  }, {
    "tStartMs": 2987080,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "ㅋㅋㅋ네"
    } ]
  }, {
    "tStartMs": 2989780,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "그러면 뭐 어떻게 구글에 한국인..."
    } ]
  }, {
    "tStartMs": 2994230,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "한국인 취미 순위? 이렇게 할까요?"
    } ]
  }, {
    "tStartMs": 2999140,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "'한국 갤럽' 여기 믿을만 할까요?"
    } ]
  }, {
    "tStartMs": 3001410,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "오 거기 조사하는 회사잖아요"
    } ]
  }, {
    "tStartMs": 3004500,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "그래요?"
    } ]
  }, {
    "tStartMs": 3005530,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "한국인들이 가장 많이 즐기는 취미는"
    } ]
  }, {
    "tStartMs": 3008160,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "게임!"
    } ]
  }, {
    "tStartMs": 3012290,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "9%의 응답률을 기록했습니다"
    } ]
  }, {
    "tStartMs": 3015020,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "5년 전 1위였던 등산은 공동 2위로 올라갔는데"
    } ]
  }, {
    "tStartMs": 3019170,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "등산?"
    } ]
  }, {
    "tStartMs": 3020040,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "공동 2위가 등산, 운동, 헬스래요"
    } ]
  }, {
    "tStartMs": 3024030,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "잘못된 것 같은데요?"
    } ]
  }, {
    "tStartMs": 3026970,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "아 근데 이 밖에 영상 시청, 걷기, 음악 감상, 독서,"
    } ]
  }, {
    "tStartMs": 3032090,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "골프, 낚시, 여행 이런 것들이 있긴 한데"
    } ]
  }, {
    "tStartMs": 3036830,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "1위는 게임을 고르셨대요"
    } ]
  }, {
    "tStartMs": 3040330,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "2024년 기준"
    } ]
  }, {
    "tStartMs": 3041540,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "아 근데 제가 봤을 때 이거 나이대가 좀 높은 것 같아요"
    } ]
  }, {
    "tStartMs": 3044910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "네 그럴 것 같아요"
    } ]
  }, {
    "tStartMs": 3046560,
    "dDurationMs": 6580,
    "segs": [ {
      "utf8": "왜냐면 지난 1위들이 다 등산이고 등산하는 나이대가 다 어르신들이잖아요?"
    } ]
  }, {
    "tStartMs": 3053140,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "네네"
    } ]
  }, {
    "tStartMs": 3053880,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "'근데 게임이 다른 취미를 제치고 1위를 차지한 건"
    } ]
  }, {
    "tStartMs": 3057060,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "남자들의 영향이 매우 컸습니다'"
    } ]
  }, {
    "tStartMs": 3059220,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "취미가 게임이라는 남성 응답자 비율이 15%"
    } ]
  }, {
    "tStartMs": 3062960,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "여성은 3%였대요"
    } ]
  }, {
    "tStartMs": 3066770,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "그래서 남성 1위는 게임이었고요"
    } ]
  }, {
    "tStartMs": 3069540,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "여성 1위는 영상 시청이었대요"
    } ]
  }, {
    "tStartMs": 3073140,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "근데 남성이 게임을 많이 골라서"
    } ]
  }, {
    "tStartMs": 3076900,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "종합적으로는 게임 1위가 됐다고 합니다"
    } ]
  }, {
    "tStartMs": 3081380,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "남자들이 게임에 다 몰표를 줘서"
    } ]
  }, {
    "tStartMs": 3084290,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "이거는 뭐 나이와 상관없이 게임 고르신 것 같아요"
    } ]
  }, {
    "tStartMs": 3090650,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "좋습니다 그럼 무승부로 하시죠"
    } ]
  }, {
    "tStartMs": 3093070,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "뭐야..."
    } ]
  }, {
    "tStartMs": 3094370,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "그런데 승자가 없었지만 유익했습니다"
    } ]
  }, {
    "tStartMs": 3098720,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 3099780,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "한국에서 인기 있는 취미들 많이 알아가셨을 것 같고요"
    } ]
  }, {
    "tStartMs": 3103900,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "이거 듣고 계시는 분들 중에서도 취미,"
    } ]
  }, {
    "tStartMs": 3106850,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "한국어 공부가 취미이신 분들이 많을 것 같긴 한데"
    } ]
  }, {
    "tStartMs": 3110430,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "그 외에 또 좋아하시는 취미 있으면"
    } ]
  }, {
    "tStartMs": 3112970,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "댓글로 많이 남겨주시면 감사하겠습니다"
    } ]
  }, {
    "tStartMs": 3116770,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "그러면 저희는 이제 다음 주제 예고하고 가볼 건데"
    } ]
  }, {
    "tStartMs": 3120940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "다음 주제는 어떤 게 좋을까요?"
    } ]
  }, {
    "tStartMs": 3123070,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "1월 에피소드입니다"
    } ]
  }, {
    "tStartMs": 3127430,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "1월의 요모조모 에피소드의 주제는 바로바로"
    } ]
  }, {
    "tStartMs": 3131650,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "중고시장입니다"
    } ]
  }, {
    "tStartMs": 3133650,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "중고시장"
    } ]
  }, {
    "tStartMs": 3136830,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "썼던 물건 다시 파는 거"
    } ]
  }, {
    "tStartMs": 3139230,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "당근마켓"
    } ]
  }, {
    "tStartMs": 3140460,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "당근마켓이나 여러가지 있죠"
    } ]
  }, {
    "tStartMs": 3143710,
    "dDurationMs": 5750,
    "segs": [ {
      "utf8": "네 그쵸 2026년 새 출발할 때는 방정리도 다들 하실거고"
    } ]
  }, {
    "tStartMs": 3149460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "많이들 하실거고"
    } ]
  }, {
    "tStartMs": 3151260,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "그러다보면 안쓰는 물건도 나오고"
    } ]
  }, {
    "tStartMs": 3153740,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "그런 물건들을 어떻게 처리하는지 얘기하면서"
    } ]
  }, {
    "tStartMs": 3156400,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "중고 얘기도 좀 더 해볼 수 있을 것 같아요"
    } ]
  }, {
    "tStartMs": 3159460,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "그렇습니다"
    } ]
  }, {
    "tStartMs": 3160320,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "좋아요 좋아요"
    } ]
  }, {
    "tStartMs": 3161310,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "그러면 태웅쌤 2025년 마무리 잘 하시고요"
    } ]
  }, {
    "tStartMs": 3166050,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "저희는 2026년에 이야기해보도록 하겠습니다"
    } ]
  }, {
    "tStartMs": 3170280,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "요모조모에서는 그렇게 할 거고요"
    } ]
  }, {
    "tStartMs": 3174460,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "그리고 제 팟캐스트에는 조만간 나와주실 것 같습니다"
    } ]
  }, {
    "tStartMs": 3179180,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "크리스마스 이브에 목표를 하고 있거든요"
    } ]
  }, {
    "tStartMs": 3181610,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "업로드 목표를"
    } ]
  }, {
    "tStartMs": 3182820,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "아 그런가요? 언제든지 불러주세요"
    } ]
  }, {
    "tStartMs": 3186230,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "아하 그러면 제 채널에서 한번 다시 뵙겠습니다"
    } ]
  }, {
    "tStartMs": 3189470,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "좋습니다"
    } ]
  }, {
    "tStartMs": 3190280,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "태웅쌤 All Things Korean 채널도 구독해두고"
    } ]
  }, {
    "tStartMs": 3194380,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "여러분 지켜봐주세요 저 나갈 거니까"
    } ]
  }, {
    "tStartMs": 3197610,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "그러면 여기까지 디디와"
    } ]
  }, {
    "tStartMs": 3200620,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "정태웅이었습니다"
    } ]
  }, {
    "tStartMs": 3201600,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "감사합니다"
    } ]
  } ]
}
