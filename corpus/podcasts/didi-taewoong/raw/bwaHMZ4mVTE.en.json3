  }, {
    "tStartMs": 2440220,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Oh, you know, INFP, right?"
    } ]
  }, {
    "tStartMs": 2443580,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "Teacher Tae-woong is ENTJ."
    } ]
  }, {
    "tStartMs": 2449200,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I'll count that as correct."
    } ]
  }, {
    "tStartMs": 2451420,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Yay, why, why, why are you counting it?"
