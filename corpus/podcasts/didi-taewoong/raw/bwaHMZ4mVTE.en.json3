  }, {
    "tStartMs": 2711110,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "What is it?"
    } ]
  }, {
    "tStartMs": 2711430,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "I'm also buying a house"
