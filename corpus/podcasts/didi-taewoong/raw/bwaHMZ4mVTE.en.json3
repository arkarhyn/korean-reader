  }, {
    "tStartMs": 2675710,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Buy a studio?"
    } ]
  }, {
    "tStartMs": 2679490,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "That's wasteful? I'm going to buy a house."
