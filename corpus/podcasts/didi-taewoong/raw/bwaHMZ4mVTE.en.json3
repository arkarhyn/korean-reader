  }, {
    "tStartMs": 2637790,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Ah... no, that's not it."
    } ]
  }, {
    "tStartMs": 2641310,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "I bought a swimsuit because I want to start going swimming now."
    } ]
  }, {
    "tStartMs": 2646690,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "One last one!"
    } ]
  }, {
    "tStartMs": 2649240,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "If you won first prize in the lottery, what would you do first?"
