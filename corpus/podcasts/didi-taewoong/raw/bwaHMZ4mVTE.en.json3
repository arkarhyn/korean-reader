  }, {
    "tStartMs": 2416610,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "You might be a bit fuzzy on it anyway."
    } ]
  }, {
    "tStartMs": 2419050,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Matcha shaved ice?"
    } ]
  }, {
    "tStartMs": 2422050,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Not at all."
    } ]
  }, {
    "tStartMs": 2423570,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "It's raw beef, octopus, and tangtangi."
    } ]
  }, {
    "tStartMs": 2424930,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "How would you guess that?"
    } ]
  }, {
    "tStartMs": 2428740,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "I've always talked about this pretty often on my live streams and things like that."
    } ]
  }, {
    "tStartMs": 2434010,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 2435740,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Okay, moving on to the next question."
