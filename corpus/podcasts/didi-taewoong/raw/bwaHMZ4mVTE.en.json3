  }, {
    "tStartMs": 2588800,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "Like, something you'd say \"I bought this,\" not food or anything like that."
    } ]
  }, {
    "tStartMs": 2594830,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Does that include things that haven't been delivered yet?"
