  }, {
    "tStartMs": 2596950,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "What do you mean?"
    } ]
  }, {
    "tStartMs": 2598180,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Oh, you, Teacher Tae-woong?"
    } ]
  }, {
    "tStartMs": 2599710,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2600640,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Oh, things that haven't been delivered yet?"
