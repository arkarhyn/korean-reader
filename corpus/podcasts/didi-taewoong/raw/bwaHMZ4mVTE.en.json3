  }, {
    "tStartMs": 2614980,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "A t-shirt."
    } ]
  }, {
    "tStartMs": 2618140,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "I bought a t-shirt I wanted."
