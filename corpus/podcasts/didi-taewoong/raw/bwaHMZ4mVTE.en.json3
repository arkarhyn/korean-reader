  }, {
    "tStartMs": 2456420,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "But it's the same?"
    } ]
  }, {
    "tStartMs": 2457350,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "I don't know."
    } ]
  }, {
    "tStartMs": 2458590,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Oh, back then it was ENTJ?"
    } ]
  }, {
    "tStartMs": 2461920,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "I don't know now."
    } ]
  }, {
    "tStartMs": 2463360,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "I think it's probably right from what I've seen."
    } ]
  }, {
    "tStartMs": 2467110,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Okay, ah, this one is easy, number 4."
