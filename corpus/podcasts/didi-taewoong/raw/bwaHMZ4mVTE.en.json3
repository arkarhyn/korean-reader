{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 450,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Yomojomo of Korean Life with Didi and Jeong Tae-woong"
    } ]
  }, {
    "tStartMs": 9760,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "Hello, this is Didi."
    } ]
  }, {
    "tStartMs": 11870,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Hello, this is Jeong Tae-woong."
    } ]
  }, {
    "tStartMs": 13750,
    "dDurationMs": 6470,
    "segs": [ {
      "utf8": "\u003cYomojomo of Korean Life\u003e is a podcast where two people living in Korea talk about the various aspects of Korean life."
    } ]
  }, {
    "tStartMs": 20220,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Last week... or rather, last month, right?"
    } ]
  }, {
    "tStartMs": 21780,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "How have you been doing, Teacher Tae-woong?"
    } ]
  }, {
    "tStartMs": 23570,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "I've been doing well."
    } ]
  }, {
    "tStartMs": 24670,
    "dDurationMs": 4450,
    "segs": [ {
      "utf8": "There are a lot of flowers blooming these days—did you get a chance to go see the cherry blossoms?"
    } ]
  }, {
    "tStartMs": 29120,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "There are a lot blooming in our neighborhood, so I've just been taking a lot of walks."
    } ]
  }, {
    "tStartMs": 33040,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "You didn't go anywhere else, right? Yes."
    } ]
  }, {
    "tStartMs": 37380,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "It was nice, with the cherry blossoms blooming."
    } ]
  }, {
    "tStartMs": 40060,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "They're so pretty, aren't they?"
    } ]
  }, {
    "tStartMs": 41030,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 42230,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "But I think they bloomed earlier than expected this year."
    } ]
  }, {
    "tStartMs": 45060,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 45640,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Isn't it?"
    } ]
  }, {
    "tStartMs": 46870,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 49000,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "Today we're going to talk about another interesting topic."
    } ]
  }, {
    "tStartMs": 53650,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "But before we talk about it, let me first announce the winners of last month's quiz."
    } ]
  }, {
    "tStartMs": 57120,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "I'll show the winners on screen."
    } ]
  }, {
    "tStartMs": 58890,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Once I announce the answer,"
    } ]
  }, {
    "tStartMs": 61990,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Last month's quiz was this:"
    } ]
  }, {
    "tStartMs": 63630,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "Which facility did Didi and Teacher Tae-woong not use at the airport?"
    } ]
  }, {
    "tStartMs": 65120,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "The answer was number 3, the pharmacy."
    } ]
  }, {
    "tStartMs": 71000,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "We didn't mention going to the pharmacy."
    } ]
  }, {
    "tStartMs": 74770,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "So thank you and congratulations to everyone who got the quiz answer right."
    } ]
  }, {
    "tStartMs": 78030,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "There's another quiz at the end of this episode too,"
    } ]
  }, {
    "tStartMs": 84320,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "so please leave lots of comments."
    } ]
  }, {
    "tStartMs": 87250,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "So, what's today's topic?"
    } ]
  }, {
    "tStartMs": 89430,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Today's topic is none other than friends."
    } ]
  }, {
    "tStartMs": 93310,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "It's surprising that we haven't talked about this topic until now,"
    } ]
  }, {
    "tStartMs": 97600,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "because it's quite a big and significant subject."
    } ]
  }, {
    "tStartMs": 101770,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 105470,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "Before we talk about friends,"
    } ]
  }, {
    "tStartMs": 106980,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "I looked up the definition of friend in the dictionary."
    } ]
  }, {
    "tStartMs": 110080,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "A friend is defined as \"a person with whom you have spent a long time together and have deep affection.\""
    } ]
  }, {
    "tStartMs": 113860,
    "dDurationMs": 7450,
    "segs": [ {
      "utf8": "That's difficult, isn't it?"
    } ]
  }, {
    "tStartMs": 121310,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "The dictionary always seems to define things in a complicated way."
    } ]
  }, {
    "tStartMs": 122210,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "That's true."
    } ]
  }, {
    "tStartMs": 126020,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "It seems like it means someone you've spent a long time with"
    } ]
  }, {
    "tStartMs": 126940,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "and have various memories with."
    } ]
  }, {
    "tStartMs": 129630,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Teacher Tae-woong, do you have a lot of friends? How is it for you?"
    } ]
  }, {
    "tStartMs": 134170,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "I think, from my perspective,"
    } ]
  }, {
    "tStartMs": 139310,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "I don't have that many."
    } ]
  }, {
    "tStartMs": 142460,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "But... that's a difficult question."
    } ]
  }, {
    "tStartMs": 145600,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Do you have a lot of friends, why?"
    } ]
  }, {
    "tStartMs": 148690,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "What's difficult about it?"
    } ]
  }, {
    "tStartMs": 150400,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "When you try to think about whether you have many or few friends,"
    } ]
  }, {
    "tStartMs": 151790,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "you end up thinking, \"What is a friend anyway?\""
    } ]
  }, {
    "tStartMs": 155000,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 160100,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "Then I feel like I know quite a lot of people,"
    } ]
  }, {
    "tStartMs": 161470,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "but how close do you have to be to be considered a friend?"
    } ]
  }, {
    "tStartMs": 166980,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "Or like... is someone you meet at work also a friend?"
    } ]
  }, {
    "tStartMs": 169450,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "Those kinds of thoughts come up too."
    } ]
  }, {
    "tStartMs": 173910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "That's right, so it seems like we need to come up with a definition of friendship."
    } ]
  }, {
    "tStartMs": 175230,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Good point."
    } ]
  }, {
    "tStartMs": 179010,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "So what do you think a friend is, Teacher Tae-woong?"
    } ]
  }, {
    "tStartMs": 180000,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "In my opinion, a friend is..."
    } ]
  }, {
    "tStartMs": 184720,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "someone you can contact without any particular reason?"
    } ]
  }, {
    "tStartMs": 187870,
    "dDurationMs": 8700,
    "segs": [ {
      "utf8": "someone you can reach out to without any particular business?"
    } ]
  }, {
    "tStartMs": 198430,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Is that the most important part?"
    } ]
  }, {
    "tStartMs": 200970,
    "dDurationMs": 7570,
    "segs": [ {
      "utf8": "Just acquaintances and coworkers?"
    } ]
  }, {
    "tStartMs": 208540,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "I was thinking about what makes this 'friend' different from those kinds of people"
    } ]
  }, {
    "tStartMs": 214020,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "And I just thought of one thing"
    } ]
  }, {
    "tStartMs": 217310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But I can't really divide it based on just that, right?"
    } ]
  }, {
    "tStartMs": 219440,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "That's an interesting criterion"
    } ]
  }, {
    "tStartMs": 220990,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "Right, with that criterion"
    } ]
  }, {
    "tStartMs": 222960,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "You and I aren't friends"
    } ]
  }, {
    "tStartMs": 225170,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "I'm going to talk about this, I'm going to talk about it"
    } ]
  }, {
    "tStartMs": 228710,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "I'm going to talk about it, and I'll share my thoughts soon too"
    } ]
  }, {
    "tStartMs": 232750,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "When I think about what a friend is, here's how I think about it"
    } ]
  }, {
    "tStartMs": 236150,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "First, you need to make a lot of memories together"
    } ]
  }, {
    "tStartMs": 240950,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "Like going places together or having lots of conversations"
    } ]
  }, {
    "tStartMs": 246690,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "You need to have quite a few memories like that"
    } ]
  }, {
    "tStartMs": 250180,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "And if you know a lot about each other"
    } ]
  }, {
    "tStartMs": 253310,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "Then I think you can call them a friend"
    } ]
  }, {
    "tStartMs": 255940,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Well, if I'm being detailed about it"
    } ]
  }, {
    "tStartMs": 257830,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "People who are roughly similar in age?"
    } ]
  }, {
    "tStartMs": 261200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Age?"
    } ]
  }, {
    "tStartMs": 262400,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "That's how I see it"
    } ]
  }, {
    "tStartMs": 263330,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "When I think about what the people I call 'friends' have in common"
    } ]
  }, {
    "tStartMs": 266540,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "Those are the kinds of people that come to mind"
    } ]
  }, {
    "tStartMs": 272420,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "So even if we haven't seen each other for a long time"
    } ]
  }, {
    "tStartMs": 275910,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "I still say things like 'I have a friend'"
    } ]
  }, {
    "tStartMs": 278880,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Oh, that can happen"
    } ]
  }, {
    "tStartMs": 280380,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "The dictionary says you need to have spent a long time together"
    } ]
  }, {
    "tStartMs": 284100,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "But I think it's okay even if it's not exactly like that"
    } ]
  }, {
    "tStartMs": 290200,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Do you think time isn't important, Teacher Tae-woong?"
    } ]
  }, {
    "tStartMs": 294370,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "It seems like that"
    } ]
  }, {
    "tStartMs": 296840,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Well, even if you met yesterday, you could become a friend"
    } ]
  }, {
    "tStartMs": 300600,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "You could call them a friend"
    } ]
  }, {
    "tStartMs": 303060,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "Like 'They're my friend'?"
    } ]
  }, {
    "tStartMs": 305090,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "Or not...?"
    } ]
  }, {
    "tStartMs": 306100,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Like 'They're my friend'?"
    } ]
  }, {
    "tStartMs": 308140,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Or not?"
    } ]
  }, {
    "tStartMs": 309280,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "How could someone you met yesterday become a friend right away?"
    } ]
  }, {
    "tStartMs": 313190,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "I feel like there would be too much emotional distance"
    } ]
  }, {
    "tStartMs": 318430,
    "dDurationMs": 7270,
    "segs": [ {
      "utf8": "But... what if I were really"
    } ]
  }, {
    "tStartMs": 325700,
    "dDurationMs": 5690,
    "segs": [ {
      "utf8": "For example, I'm a sci-fi anime fanatic, a maniac"
    } ]
  }, {
    "tStartMs": 331390,
    "dDurationMs": 5950,
    "segs": [ {
      "utf8": "A huge maniac, but there's no one around me who enjoys that"
    } ]
  }, {
    "tStartMs": 337340,
    "dDurationMs": 6770,
    "segs": [ {
      "utf8": "But then I went to some kind of expo or convention, or like a Comic-Con"
    } ]
  }, {
    "tStartMs": 344110,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "And I found someone whose taste matched mine so well"
    } ]
  }, {
    "tStartMs": 347780,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Then couldn't you say 'From today on, you and I are friends'?"
    } ]
  }, {
    "tStartMs": 351260,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "Oh, so for you, shared interests are also a big part of friendship?"
    } ]
  }, {
    "tStartMs": 357220,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Or not? Could it be like that?"
    } ]
  }, {
    "tStartMs": 359230,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Yeah, that could be the case"
    } ]
  }, {
    "tStartMs": 360830,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Uh-huh..."
    } ]
  }, {
    "tStartMs": 362950,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "Well, you could have that light kind of friend, buddy feeling"
    } ]
  }, {
    "tStartMs": 367040,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "But for it to become a real friend, I think I need some amount of time"
    } ]
  }, {
    "tStartMs": 373200,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Oh, but that makes sense"
    } ]
  }, {
    "tStartMs": 377820,
    "dDurationMs": 9220,
    "segs": [ {
      "utf8": "When I think about the friends I consider real friends"
    } ]
  }, {
    "tStartMs": 387040,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "Most of them either spent a lot of time together or spent a long time together"
    } ]
  }, {
    "tStartMs": 392350,
    "dDurationMs": 5410,
    "segs": [ {
      "utf8": "Or they shared a lot of experiences in a short period"
    } ]
  }, {
    "tStartMs": 397760,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "It seems like most of my friends are like that"
    } ]
  }, {
    "tStartMs": 401060,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "I see, so then about the question that just came up earlier"
    } ]
  }, {
    "tStartMs": 404570,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "'Are Didi and Tae-woong friends or not'"
    } ]
  }, {
    "tStartMs": 409550,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "You said no"
    } ]
  }, {
    "tStartMs": 411780,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I was going to count one, two, three and talk about it"
    } ]
  }, {
    "tStartMs": 414480,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Are we friends or not"
    } ]
  }, {
    "tStartMs": 416750,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "Why are you asking such a difficult question..."
    } ]
  }, {
    "tStartMs": 421160,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "Do you still have the same opinion, Teacher Tae-woong?"
    } ]
  }, {
    "tStartMs": 426050,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "I think I need to think about it once more."
    } ]
  }, {
    "tStartMs": 428940,
    "dDurationMs": 7320,
    "segs": [ {
      "utf8": "But... doesn't it feel more like we're business partners?"
    } ]
  }, {
    "tStartMs": 436260,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "I was also going to say we're not friends."
    } ]
  }, {
    "tStartMs": 439600,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "That's right, that's true actually."
    } ]
  }, {
    "tStartMs": 442550,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It puts my mind at ease."
    } ]
  }, {
    "tStartMs": 443750,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Because I'm not the only one who thinks that way."
    } ]
  }, {
    "tStartMs": 447130,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Just kidding, but yes, the important thing here is"
    } ]
  }, {
    "tStartMs": 452010,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "There seems to be 'friends' and there's 'colleagues'."
    } ]
  }, {
    "tStartMs": 455630,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "And in my opinion, just because you call someone a friend doesn't mean they're closer or more precious,"
    } ]
  }, {
    "tStartMs": 461110,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "it's not necessarily like that, and depending on time or circumstances,"
    } ]
  }, {
    "tStartMs": 465700,
    "dDurationMs": 5510,
    "segs": [ {
      "utf8": "I've found that colleagues often become more important to me."
    } ]
  }, {
    "tStartMs": 471210,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Now that I've become an adult,"
    } ]
  }, {
    "tStartMs": 473150,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Ah, there are many cases like that."
    } ]
  }, {
    "tStartMs": 475460,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Business, what did you call it?"
    } ]
  }, {
    "tStartMs": 477450,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Business partner."
    } ]
  }, {
    "tStartMs": 479650,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "When you say it that way, colleagues feel very distant."
    } ]
  }, {
    "tStartMs": 483420,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "Ah, colleagues!"
    } ]
  }, {
    "tStartMs": 484360,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Colleagues, colleagues!"
    } ]
  }, {
    "tStartMs": 485570,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "When you become an adult, it becomes hard to meet friends often, doesn't it?"
    } ]
  }, {
    "tStartMs": 490850,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "And it becomes difficult to make new people you'd call friends."
    } ]
  }, {
    "tStartMs": 495320,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 496920,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So what I've been thinking about lately is"
    } ]
  }, {
    "tStartMs": 500580,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "For example, if something big happens to me,"
    } ]
  }, {
    "tStartMs": 502770,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "like a wedding or a funeral, what we call life events in Korea,"
    } ]
  }, {
    "tStartMs": 508670,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "when I think about who I would invite,"
    } ]
  }, {
    "tStartMs": 512990,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "I would invite the closest people to me, right?"
    } ]
  }, {
    "tStartMs": 516430,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "At that moment, I think I might invite more colleagues than friends right now."
    } ]
  }, {
    "tStartMs": 523790,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So even though I don't have many friends,"
    } ]
  }, {
    "tStartMs": 526130,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "I think I'm building up colleagues in a way."
    } ]
  }, {
    "tStartMs": 530820,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Ah, I think that's the case."
    } ]
  }, {
    "tStartMs": 532910,
    "dDurationMs": 5450,
    "segs": [ {
      "utf8": "When I heard that story, something occurred to me,"
    } ]
  }, {
    "tStartMs": 538360,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "which is that since I became an adult,"
    } ]
  }, {
    "tStartMs": 541700,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "I'm suddenly wondering if I've ever made a new 'friend'."
    } ]
  }, {
    "tStartMs": 547780,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "So..."
    } ]
  }, {
    "tStartMs": 549140,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "You didn't go to Bangladesh after becoming an adult?"
    } ]
  }, {
    "tStartMs": 551900,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 552560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "What about the people you met there?"
    } ]
  }, {
    "tStartMs": 554600,
    "dDurationMs": 9030,
    "segs": [ {
      "utf8": "They're friends, but... I think that was only possible because it was such a special environment."
    } ]
  }, {
    "tStartMs": 563630,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "The friends people usually think of"
    } ]
  }, {
    "tStartMs": 568310,
    "dDurationMs": 6190,
    "segs": [ {
      "utf8": "usually form a lot during school in that person's life, right?"
    } ]
  }, {
    "tStartMs": 574500,
    "dDurationMs": 5980,
    "segs": [ {
      "utf8": "So regardless of my will, I have to keep going to school,"
    } ]
  }, {
    "tStartMs": 580480,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "and the friends who are there with me,"
    } ]
  }, {
    "tStartMs": 583460,
    "dDurationMs": 9430,
    "segs": [ {
      "utf8": "but I don't need them for something I have to do, you know?"
    } ]
  }, {
    "tStartMs": 592890,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "They have their own path,"
    } ]
  }, {
    "tStartMs": 596530,
    "dDurationMs": 6670,
    "segs": [ {
      "utf8": "and I have my own path, but since we're just next to each other, we get along?"
    } ]
  }, {
    "tStartMs": 603200,
    "dDurationMs": 6770,
    "segs": [ {
      "utf8": "But most of the people I've met since becoming an adult"
    } ]
  }, {
    "tStartMs": 609970,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "are mostly people I spent time with for some purpose."
    } ]
  }, {
    "tStartMs": 614340,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "So didn't it feel more like colleagues than friends?"
    } ]
  }, {
    "tStartMs": 619290,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Oh, for some purpose?"
    } ]
  }, {
    "tStartMs": 622020,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Yes, for example, like us right now..."
    } ]
  }, {
    "tStartMs": 624860,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "Um, to film?"
    } ]
  }, {
    "tStartMs": 627390,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 628540,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "So Teacher Tae-woong, you sometimes teach classes too,"
    } ]
  }, {
    "tStartMs": 631830,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and you can meet subscribers and things like that, right?"
    } ]
  }, {
    "tStartMs": 634470,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 635140,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Do you think of those people as... is it okay to talk about this?"
    } ]
  }, {
    "tStartMs": 637930,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Friends?"
    } ]
  }, {
    "tStartMs": 639520,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "No. (firmly)"
    } ]
  }, {
    "tStartMs": 640580,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Then what?"
    } ]
  }, {
    "tStartMs": 643020,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Well, they're not friends."
    } ]
  }, {
    "tStartMs": 645580,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Then what are they? What's that relationship?"
    } ]
  }, {
    "tStartMs": 648850,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "I feel like you must be really hurt right now."
    } ]
  }, {
    "tStartMs": 651980,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "My..."
    } ]
  }, {
    "tStartMs": 655300,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "Everything?"
    } ]
  }, {
    "tStartMs": 658180,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 661530,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "No, there are certain people I've gotten closer to."
    } ]
  }, {
    "tStartMs": 665530,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "Are there?"
    } ]
  }, {
    "tStartMs": 666840,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "You don't have anyone in particular?"
    } ]
  }, {
    "tStartMs": 668320,
    "dDurationMs": 5910,
    "segs": [ {
      "utf8": "It doesn't seem like it? It seems like there's almost no one."
    } ]
  }, {
    "tStartMs": 674230,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "There are some."
    } ]
  }, {
    "tStartMs": 674670,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "People you'd call friends?"
    } ]
  }, {
    "tStartMs": 676400,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 678590,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "It seems like there was some purpose with that person?"
    } ]
  }, {
    "tStartMs": 683100,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Wouldn't you naturally say there was?"
    } ]
  }, {
    "tStartMs": 687030,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "For example?"
    } ]
  }, {
    "tStartMs": 688000,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "That person probably had a purpose with me."
    } ]
  }, {
    "tStartMs": 692640,
    "dDurationMs": 5590,
    "segs": [ {
      "utf8": "Since they got close to me after seeing my content."
    } ]
  }, {
    "tStartMs": 698230,
    "dDurationMs": 6850,
    "segs": [ {
      "utf8": "So they were interested in the way I teach Korean."
    } ]
  }, {
    "tStartMs": 705080,
    "dDurationMs": 8300,
    "segs": [ {
      "utf8": "Or they wanted to listen and learn more about that."
    } ]
  }, {
    "tStartMs": 713380,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Ah, this is complicated."
    } ]
  }, {
    "tStartMs": 715320,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "Right, but that purpose thing is actually..."
    } ]
  }, {
    "tStartMs": 717890,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Even when I was in school, if I look for it, there is one."
    } ]
  }, {
    "tStartMs": 720710,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "For example, it could be the purpose of not wanting to be alone... isn't it?"
    } ]
  }, {
    "tStartMs": 725340,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "I kind of found a phrase that a friend said that resonated with me."
    } ]
  }, {
    "tStartMs": 730120,
    "dDurationMs": 6590,
    "segs": [ {
      "utf8": "I heard them say that people gather in the same playground."
    } ]
  }, {
    "tStartMs": 736710,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So school is just an area where I'm active."
    } ]
  }, {
    "tStartMs": 740190,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Like my own playground."
    } ]
  }, {
    "tStartMs": 741670,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "And people who are just there together."
    } ]
  }, {
    "tStartMs": 745370,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "And I meet a lot of friends there."
    } ]
  }, {
    "tStartMs": 747780,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "And now as an adult, I'm mostly active in language learning or YouTube."
    } ]
  }, {
    "tStartMs": 751410,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "In these kinds of areas."
    } ]
  }, {
    "tStartMs": 755060,
    "dDurationMs": 7340,
    "segs": [ {
      "utf8": "So the people who gather there become friends too, and that's how I think about it."
    } ]
  }, {
    "tStartMs": 762400,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "So do you think of your students as friends, Didi?"
    } ]
  }, {
    "tStartMs": 766520,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "There are people who became friends."
    } ]
  }, {
    "tStartMs": 770060,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "I think almost all of them became friends."
    } ]
  }, {
    "tStartMs": 775900,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Then is the tuition fee a friend fee?"
    } ]
  }, {
    "tStartMs": 780060,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "So that's a bit difficult."
    } ]
  }, {
    "tStartMs": 781650,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "I struggle with it all the time too."
    } ]
  }, {
    "tStartMs": 785800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "If students become friends."
    } ]
  }, {
    "tStartMs": 788800,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "Then it's a more realistic question."
    } ]
  }, {
    "tStartMs": 791090,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Do I feel sorry about receiving tuition anymore?"
    } ]
  }, {
    "tStartMs": 795490,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 796460,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "Yes, that's the dilemma."
    } ]
  }, {
    "tStartMs": 800710,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Friend fee."
    } ]
  }, {
    "tStartMs": 801510,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Exactly."
    } ]
  }, {
    "tStartMs": 804930,
    "dDurationMs": 8930,
    "segs": [ {
      "utf8": "I think I got that kind of question when I interviewed for a Korean teacher position."
    } ]
  }, {
    "tStartMs": 813860,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "What kind?"
    } ]
  }, {
    "tStartMs": 815330,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "So when I was getting my Korean teacher certification."
    } ]
  }, {
    "tStartMs": 820170,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "I took the exam and passed the interview."
    } ]
  }, {
    "tStartMs": 822910,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "And they asked Korean grammar questions."
    } ]
  }, {
    "tStartMs": 826140,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "And they asked what I would do as a teacher in situations like this."
    } ]
  }, {
    "tStartMs": 830260,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "If students try to get too close."
    } ]
  }, {
    "tStartMs": 833760,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "And want to do activities together outside the classroom, what would you do?"
    } ]
  }, {
    "tStartMs": 838660,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "I think they asked that kind of question."
    } ]
  }, {
    "tStartMs": 842840,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "How did you answer?"
    } ]
  }, {
    "tStartMs": 845370,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "I answered firmly."
    } ]
  }, {
    "tStartMs": 847010,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "\"A teacher is a teacher and a student is a student."
    } ]
  }, {
    "tStartMs": 852970,
    "dDurationMs": 5780,
    "segs": [ {
      "utf8": "So I will only teach in the classroom.\" That's what I remember saying."
    } ]
  }, {
    "tStartMs": 858750,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Is that how it has to be?"
    } ]
  }, {
    "tStartMs": 860800,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "No, it's not."
    } ]
  }, {
    "tStartMs": 861320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Is that not the case?"
    } ]
  }, {
    "tStartMs": 862840,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "This is just my answer, and I don't know what the correct answer is."
    } ]
  }, {
    "tStartMs": 867140,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "Because most of the teachers I've met have said it that way."
    } ]
  }, {
    "tStartMs": 871970,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "How many could there be?"
    } ]
  }, {
    "tStartMs": 873250,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Students who want to become closer friends separately, who want that,"
    } ]
  }, {
    "tStartMs": 877750,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "I can't make time for all of those people,"
    } ]
  }, {
    "tStartMs": 881440,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "so almost everyone says they just don't meet separately at all."
    } ]
  }, {
    "tStartMs": 887140,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "There's no way around it."
    } ]
  }, {
    "tStartMs": 889600,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "But how can it be like that..."
    } ]
  }, {
    "tStartMs": 893570,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Right, it's not easy, is it?"
    } ]
  }, {
    "tStartMs": 895640,
    "dDurationMs": 5750,
    "segs": [ {
      "utf8": "So I try to separate things a lot."
    } ]
  }, {
    "tStartMs": 901390,
    "dDurationMs": 7540,
    "segs": [ {
      "utf8": "Even when I do Comprehensible Input Korean live,"
    } ]
  }, {
    "tStartMs": 908930,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "I've said things like that before."
    } ]
  }, {
    "tStartMs": 912700,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "'Teacher Tae-woong, if you go to Korea, if you go to Busan, I'll buy you something delicious,"
    } ]
  }, {
    "tStartMs": 917490,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "let's eat together' when I say things like that,"
    } ]
  }, {
    "tStartMs": 919900,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "everyone, I'm just a person inside the monitor."
    } ]
  }, {
    "tStartMs": 923850,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "Oh, really?"
    } ]
  }, {
    "tStartMs": 925180,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 926730,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "That's good, that's a good strategy, isn't it?"
    } ]
  }, {
    "tStartMs": 929140,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "You say that while laughing."
    } ]
  }, {
    "tStartMs": 932860,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "Ah right, this is a worry that you can have because you're a YouTuber."
    } ]
  }, {
    "tStartMs": 936770,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "Yes, so to talk about things like 'it's hard to make friends as an adult,'"
    } ]
  }, {
    "tStartMs": 942120,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "there are plenty of opportunities to meet people around you anyway."
    } ]
  }, {
    "tStartMs": 946070,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "But I can't do all of that,"
    } ]
  }, {
    "tStartMs": 948610,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "Right, and that's"
    } ]
  }, {
    "tStartMs": 951260,
    "dDurationMs": 5930,
    "segs": [ {
      "utf8": "a bit different from becoming friends in general."
    } ]
  }, {
    "tStartMs": 957190,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Because we're meeting as a YouTuber and subscriber,"
    } ]
  }, {
    "tStartMs": 961180,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "no matter how much I try to think of it the same way, there's an unavoidable difference."
    } ]
  }, {
    "tStartMs": 966050,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 967170,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Among trendy words these days, parallel(?),"
    } ]
  }, {
    "tStartMs": 971110,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "parasocial relationship, should I say?"
    } ]
  }, {
    "tStartMs": 974360,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Yes, have you heard of that?"
    } ]
  }, {
    "tStartMs": 976450,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "I've heard of it."
    } ]
  }, {
    "tStartMs": 977670,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "In Korean, that's called 'pseudo-social relationship,'"
    } ]
  }, {
    "tStartMs": 981500,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "and as SNS and YouTube and things like that have developed,"
    } ]
  }, {
    "tStartMs": 985980,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "I've talked about my information so much,"
    } ]
  }, {
    "tStartMs": 989110,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "so when I meet someone who heard that, it's a somewhat unusual relationship."
    } ]
  }, {
    "tStartMs": 994250,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "It's a relationship created in modern times."
    } ]
  }, {
    "tStartMs": 997570,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 998820,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I don't know this person,"
    } ]
  }, {
    "tStartMs": 1001370,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1002190,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "but this person is so familiar to me and I know so much about them,"
    } ]
  }, {
    "tStartMs": 1006490,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "and they're nervous."
    } ]
  }, {
    "tStartMs": 1009510,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1010400,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "But it felt really awkward to me."
    } ]
  }, {
    "tStartMs": 1013170,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "I see."
    } ]
  }, {
    "tStartMs": 1015520,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "Let's go back to Korean friends again."
    } ]
  }, {
    "tStartMs": 1019130,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Should we go back?"
    } ]
  }, {
    "tStartMs": 1020350,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Yes, that's good."
    } ]
  }, {
    "tStartMs": 1021530,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "So we were talking about what kind of relationship a friend is,"
    } ]
  }, {
    "tStartMs": 1026130,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "where the boundaries of friendship are,"
    } ]
  }, {
    "tStartMs": 1028360,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "that kind of thing."
    } ]
  }, {
    "tStartMs": 1030080,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1030990,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "So for Teacher Tae-woong, are friends precious beings?"
    } ]
  }, {
    "tStartMs": 1035750,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "Of course."
    } ]
  }, {
    "tStartMs": 1037000,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "How precious are they?"
    } ]
  }, {
    "tStartMs": 1038910,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Well... they're as precious as I would say they're precious."
    } ]
  }, {
    "tStartMs": 1042060,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Friends are precious?"
    } ]
  }, {
    "tStartMs": 1044150,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "No, I mean, I just think of it as 'they're precious' to that degree."
    } ]
  }, {
    "tStartMs": 1049770,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "Ah, I feel the same way."
    } ]
  }, {
    "tStartMs": 1054780,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Yeah, like when something difficult happens,"
    } ]
  }, {
    "tStartMs": 1056980,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "you rush over right away to comfort them,"
    } ]
  }, {
    "tStartMs": 1060070,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "and when they need money, you lend it to them without hesitation,"
    } ]
  }, {
    "tStartMs": 1064080,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "I don't think it's quite at that level."
    } ]
  }, {
    "tStartMs": 1067460,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "The reason I'm bringing this up is that as I became an adult,"
    } ]
  }, {
    "tStartMs": 1070440,
    "dDurationMs": 4970,
    "segs": [ {
      "utf8": "I thought a lot about the question \"What is a friend?\""
    } ]
  }, {
    "tStartMs": 1075410,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "I think it's because of my personality,"
    } ]
  }, {
    "tStartMs": 1078440,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "when I'm going through something difficult or have worries,"
    } ]
  }, {
    "tStartMs": 1081220,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "I don't really talk about it and tend to solve things on my own."
    } ]
  }, {
    "tStartMs": 1086090,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "So I haven't had many deep conversations with my friends,"
    } ]
  }, {
    "tStartMs": 1090820,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "and I've wondered if there's really someone I could call a true friend."
    } ]
  }, {
    "tStartMs": 1094680,
    "dDurationMs": 5810,
    "segs": [ {
      "utf8": "I've had that thought before."
    } ]
  }, {
    "tStartMs": 1100490,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "So whenever I meet friends, I always feel happy,"
    } ]
  }, {
    "tStartMs": 1104540,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "and I think I should treat them well and feel truly grateful for them,"
    } ]
  }, {
    "tStartMs": 1110360,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "but in my real life, friends have never really become such a high priority,"
    } ]
  }, {
    "tStartMs": 1115740,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "or I don't constantly think about my friends or anything like that—"
    } ]
  }, {
    "tStartMs": 1120750,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "I don't think that's been much a part of my life."
    } ]
  }, {
    "tStartMs": 1126720,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I've always had friends,"
    } ]
  }, {
    "tStartMs": 1128700,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "but I think I'm like that too."
    } ]
  }, {
    "tStartMs": 1132610,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "Do you think everyone is like that?"
    } ]
  }, {
    "tStartMs": 1134760,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "But I'm not sure if this is just a difference in personality,"
    } ]
  }, {
    "tStartMs": 1140160,
    "dDurationMs": 6550,
    "segs": [ {
      "utf8": "but then again, while there are people like you and me,"
    } ]
  }, {
    "tStartMs": 1146710,
    "dDurationMs": 6630,
    "segs": [ {
      "utf8": "there are also friends around me who always have a group they hang out with,"
    } ]
  }, {
    "tStartMs": 1153340,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1154590,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "You see them always going out together somewhere,"
    } ]
  }, {
    "tStartMs": 1157790,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "messages coming in the group chat all the time, that kind of thing,"
    } ]
  }, {
    "tStartMs": 1161820,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "It seems like there are friends who have that kind of community."
    } ]
  }, {
    "tStartMs": 1165460,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Exactly."
    } ]
  }, {
    "tStartMs": 1167040,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "And for those friends, that would probably feel natural, right?"
    } ]
  }, {
    "tStartMs": 1171730,
    "dDurationMs": 7340,
    "segs": [ {
      "utf8": "But I don't really know, so I'm more curious—"
    } ]
  }, {
    "tStartMs": 1179070,
    "dDurationMs": 8630,
    "segs": [ {
      "utf8": "what do those friends think about the friend group they see so often?"
    } ]
  }, {
    "tStartMs": 1187700,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I'm curious how big or heavy that feeling is for them."
    } ]
  }, {
    "tStartMs": 1192700,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "I'm curious about that too."
    } ]
  }, {
    "tStartMs": 1193790,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Like... how should I put it,"
    } ]
  }, {
    "tStartMs": 1196340,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "for people who have a community they meet regularly and periodically,"
    } ]
  }, {
    "tStartMs": 1202580,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "how much do they feel their friends are precious?"
    } ]
  }, {
    "tStartMs": 1209020,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "When I was in Bangladesh, I had that kind of group,"
    } ]
  }, {
    "tStartMs": 1212580,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1213470,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "But after becoming an adult,"
    } ]
  }, {
    "tStartMs": 1217650,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "everyone has their own things to do and their own paths, I'm not sure if that's why,"
    } ]
  }, {
    "tStartMs": 1226890,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "but there was always some kind of line, you know?"
    } ]
  }, {
    "tStartMs": 1231960,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "We were really close and got along well,"
    } ]
  }, {
    "tStartMs": 1234370,
    "dDurationMs": 7750,
    "segs": [ {
      "utf8": "but there was still some kind of distance, I guess?"
    } ]
  }, {
    "tStartMs": 1242120,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "I think I just saw the good parts back then."
    } ]
  }, {
    "tStartMs": 1245570,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "Mm, I see."
    } ]
  }, {
    "tStartMs": 1248220,
    "dDurationMs": 7810,
    "segs": [ {
      "utf8": "Yeah, it was just really nice to have people to spend good times with."
    } ]
  }, {
    "tStartMs": 1256030,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Really nice."
    } ]
  }, {
    "tStartMs": 1258850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But you know, like for example,"
    } ]
  }, {
    "tStartMs": 1260950,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "if someone bullies one of us, we won't just sit back,"
    } ]
  }, {
    "tStartMs": 1266150,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "that kind of weight to it,"
    } ]
  }, {
    "tStartMs": 1270760,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "or like \"if you need help, just say anything,\""
    } ]
  }, {
    "tStartMs": 1273060,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "\"we'll take care of it all\"—it wasn't that kind of thing,"
    } ]
  }, {
    "tStartMs": 1277470,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "everyone was just fighting their own battles,"
    } ]
  }, {
    "tStartMs": 1281150,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "but we'd just get together and have fun sharing stories?"
    } ]
  }, {
    "tStartMs": 1284740,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Right, so that's like a space?"
    } ]
  }, {
    "tStartMs": 1288140,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "Just being together in that space like that seemed really important."
    } ]
  }, {
    "tStartMs": 1292330,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "That seems to be it."
    } ]
  }, {
    "tStartMs": 1294210,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "You asked if friends are precious,"
    } ]
  }, {
    "tStartMs": 1297570,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1298490,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "But usually when we talk like this,"
    } ]
  }, {
    "tStartMs": 1303560,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "we talk about friendship as if it's precious and necessary,"
    } ]
  }, {
    "tStartMs": 1308150,
    "dDurationMs": 6250,
    "segs": [ {
      "utf8": "but when you actually see how people treat their friends, it's really..."
    } ]
  }, {
    "tStartMs": 1314400,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "it seems like there are a lot of cases where they treat them carelessly."
    } ]
  }, {
    "tStartMs": 1318540,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "So rather than treating them really badly, they think it's totally comfortable,"
    } ]
  }, {
    "tStartMs": 1323080,
    "dDurationMs": 7480,
    "segs": [ {
      "utf8": "and it seems like basic manners and consideration can sometimes be lacking."
    } ]
  }, {
    "tStartMs": 1330560,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "And it also seems like they feel that's what closeness is."
    } ]
  }, {
    "tStartMs": 1333180,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "There are people like that."
    } ]
  }, {
    "tStartMs": 1335090,
    "dDurationMs": 5450,
    "segs": [ {
      "utf8": "For example, when you go to a friend's house and without asking, you take out something"
    } ]
  }, {
    "tStartMs": 1340540,
    "dDurationMs": 6330,
    "segs": [ {
      "utf8": "and eat what's there—you know those kinds of people? When you're really close,"
    } ]
  }, {
    "tStartMs": 1346870,
    "dDurationMs": 8550,
    "segs": [ {
      "utf8": "you can rationalize that kind of thing under the name of friendship."
    } ]
  }, {
    "tStartMs": 1355420,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1356920,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "But I don't think that's good..."
    } ]
  }, {
    "tStartMs": 1360860,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "I think there needs to be some kind of line, doesn't there?"
    } ]
  }, {
    "tStartMs": 1363700,
    "dDurationMs": 8040,
    "segs": [ {
      "utf8": "I think the closer the friend, the more basic human decency should apply."
    } ]
  }, {
    "tStartMs": 1371740,
    "dDurationMs": 5650,
    "segs": [ {
      "utf8": "So like, not being late to appointments,"
    } ]
  }, {
    "tStartMs": 1377390,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "expressing gratitude for small things when you should be thankful,"
    } ]
  }, {
    "tStartMs": 1383420,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "and for example, when a friend has a car"
    } ]
  }, {
    "tStartMs": 1389280,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "and comes to pick you up or gives you a ride,"
    } ]
  }, {
    "tStartMs": 1393910,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "using the car carefully,"
    } ]
  }, {
    "tStartMs": 1396290,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "or saying thank you for the ride,"
    } ]
  }, {
    "tStartMs": 1400510,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "and going a bit further,"
    } ]
  }, {
    "tStartMs": 1403830,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "when paying for parking or something, asking \"should I pay?\" just as a matter of courtesy,"
    } ]
  }, {
    "tStartMs": 1408150,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "or expressing gratitude even if you just throw it out there casually?"
    } ]
  }, {
    "tStartMs": 1413490,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "I think that kind of thing is necessary,"
    } ]
  }, {
    "tStartMs": 1416170,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Right, the closer the friend, the more you shouldn't treat them carelessly,"
    } ]
  }, {
    "tStartMs": 1419850,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "or the relationship becomes hard to maintain for long."
    } ]
  }, {
    "tStartMs": 1422940,
    "dDurationMs": 5830,
    "segs": [ {
      "utf8": "But that's also really a matter of what's right, isn't it?"
    } ]
  }, {
    "tStartMs": 1428770,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "That's right, that's right."
    } ]
  }, {
    "tStartMs": 1430800,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "Well, it would be like that with any human relationship,"
    } ]
  }, {
    "tStartMs": 1434990,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "for example, being late."
    } ]
  }, {
    "tStartMs": 1436660,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1437750,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "It seems like my friends are always late,"
    } ]
  }, {
    "tStartMs": 1441960,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "like I'm late once, they're late,"
    } ]
  }, {
    "tStartMs": 1445260,
    "dDurationMs": 4930,
    "segs": [ {
      "utf8": "we've almost never met on time—most of my friends."
    } ]
  }, {
    "tStartMs": 1450190,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "But I'm not bothered by being late at all."
    } ]
  }, {
    "tStartMs": 1455530,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Actually, I like it."
    } ]
  }, {
    "tStartMs": 1456170,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "I can answer YouTube comments I'm behind on during that time,"
    } ]
  }, {
    "tStartMs": 1462210,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "so I can just use the time for myself."
    } ]
  }, {
    "tStartMs": 1465500,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "But I've seen a friend who really can't stand that,"
    } ]
  }, {
    "tStartMs": 1470630,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "getting really angry and being in a completely bad mood,"
    } ]
  }, {
    "tStartMs": 1473880,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and there are friends who grew distant because of that—not me though,"
    } ]
  }, {
    "tStartMs": 1477040,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "but I've seen it happen."
    } ]
  }, {
    "tStartMs": 1481710,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It's hard to be a good match."
    } ]
  }, {
    "tStartMs": 1484410,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "So the best thing would be"
    } ]
  }, {
    "tStartMs": 1486080,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "\"I won't be late, but I'll understand when my friend is late,\" right?"
    } ]
  }, {
    "tStartMs": 1492880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1495440,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "But of course, if you're going to tell a friend \"don't be late,\""
    } ]
  }, {
    "tStartMs": 1498770,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "you shouldn't be late either, but well, if both of you are okay with it,"
    } ]
  }, {
    "tStartMs": 1502660,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "then of course it doesn't matter."
    } ]
  }, {
    "tStartMs": 1504160,
    "dDurationMs": 7220,
    "segs": [ {
      "utf8": "But besides that, like making jokes that hurt feelings,"
    } ]
  }, {
    "tStartMs": 1511380,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Right, that kind of thing hurts your feelings."
    } ]
  }, {
    "tStartMs": 1513560,
    "dDurationMs": 6990,
    "segs": [ {
      "utf8": "Yeah, but some people are like \"only if we do this are we really comfortable friends,\""
    } ]
  }, {
    "tStartMs": 1520550,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "you know?"
    } ]
  }, {
    "tStartMs": 1522880,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "But well, people are diverse,"
    } ]
  }, {
    "tStartMs": 1526530,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "so Tae-woong, what kind of people do you find it easy to become friends with?"
    } ]
  }, {
    "tStartMs": 1532190,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Is there a characteristic like that? Like what you mentioned earlier,"
    } ]
  }, {
    "tStartMs": 1534980,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "people who match well with basic courtesy?"
    } ]
  }, {
    "tStartMs": 1538140,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "I'm not sure."
    } ]
  }, {
    "tStartMs": 1540040,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Let me think about it once—I..."
    } ]
  }, {
    "tStartMs": 1542210,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Someone who's easy to talk to?"
    } ]
  }, {
    "tStartMs": 1545630,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "That's obvious, of course."
    } ]
  }, {
    "tStartMs": 1547520,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "Yes, talking... someone who has good back-and-forth, a good give-and-take."
    } ]
  }, {
    "tStartMs": 1552510,
    "dDurationMs": 6340,
    "segs": [ {
      "utf8": "But isn't that really all there is to it?"
    } ]
  }, {
    "tStartMs": 1558850,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Talking?"
    } ]
  }, {
    "tStartMs": 1559550,
    "dDurationMs": 6790,
    "segs": [ {
      "utf8": "The reason I said I wasn't sure earlier is because I think the same way, but"
    } ]
  }, {
    "tStartMs": 1566340,
    "dDurationMs": 7400,
    "segs": [ {
      "utf8": "when I think about what kind of person makes conversation flow well, I'm not sure."
    } ]
  }, {
    "tStartMs": 1573740,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But other than that, what else could be a reason?"
    } ]
  }, {
    "tStartMs": 1578740,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "Good-looking people? Appearance?"
    } ]
  }, {
    "tStartMs": 1581250,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Like looking for a romantic partner? (- Rich people? People with good educational backgrounds?)"
    } ]
  }, {
    "tStartMs": 1585450,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "There could be some of that, sure."
    } ]
  }, {
    "tStartMs": 1586810,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "People who grew up in a similar economic environment?"
    } ]
  }, {
    "tStartMs": 1589790,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "Don't you think there are people who use those kinds of criteria?"
    } ]
  }, {
    "tStartMs": 1593380,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "I don't think I could be friends with people like that."
    } ]
  }, {
    "tStartMs": 1599410,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "I like people who are a bit more open-minded."
    } ]
  }, {
    "tStartMs": 1602400,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Ah, yes, um..."
    } ]
  }, {
    "tStartMs": 1606140,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Ah!"
    } ]
  }, {
    "tStartMs": 1608910,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "That aspect seems pretty important to me, actually."
    } ]
  }, {
    "tStartMs": 1612130,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "People without fixed ideas or prejudices."
    } ]
  }, {
    "tStartMs": 1616570,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "So to put it plainly,"
    } ]
  }, {
    "tStartMs": 1620480,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "I'm not sure about these days, but when I was in my early twenties,"
    } ]
  }, {
    "tStartMs": 1624770,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "the people I met in society were people my age,"
    } ]
  }, {
    "tStartMs": 1629640,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "and most of them would ask me when we first met, \"What university do you go to?\""
    } ]
  }, {
    "tStartMs": 1635430,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "A lot of people asked me that."
    } ]
  }, {
    "tStartMs": 1638450,
    "dDurationMs": 9020,
    "segs": [ {
      "utf8": "But I didn't go to a typical campus university,"
    } ]
  }, {
    "tStartMs": 1647470,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "so I felt a bit intimidated."
    } ]
  }, {
    "tStartMs": 1650920,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "And there are also a lot of people who don't go to university,"
    } ]
  }, {
    "tStartMs": 1654400,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "and in the world, you know,"
    } ]
  }, {
    "tStartMs": 1656450,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "but now if you're my age, people just assume you obviously go to university,"
    } ]
  }, {
    "tStartMs": 1661820,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "that's how they talk about it."
    } ]
  }, {
    "tStartMs": 1664510,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1666400,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "That kind of thing... or whatever,"
    } ]
  }, {
    "tStartMs": 1669890,
    "dDurationMs": 7530,
    "segs": [ {
      "utf8": "or another time I did public service instead of military,"
    } ]
  }, {
    "tStartMs": 1677420,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "and when people ask which military unit I came from,"
    } ]
  }, {
    "tStartMs": 1679870,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "if I say I did public service,"
    } ]
  }, {
    "tStartMs": 1683110,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "some people looked at it a bit strangely."
    } ]
  }, {
    "tStartMs": 1688590,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "\"Oh, public service?\" like that."
    } ]
  }, {
    "tStartMs": 1689970,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Yes, there was really just one person."
    } ]
  }, {
    "tStartMs": 1692910,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "But now when it's that kind of way..."
    } ]
  }, {
    "tStartMs": 1696990,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "rather than me as a person,"
    } ]
  }, {
    "tStartMs": 1701370,
    "dDurationMs": 11430,
    "segs": [ {
      "utf8": "people who look at my background, my circumstances first and try to understand me through that?"
    } ]
  }, {
    "tStartMs": 1712800,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "I couldn't be friends with people like that."
    } ]
  }, {
    "tStartMs": 1716900,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Right, they don't see you as a human being,"
    } ]
  }, {
    "tStartMs": 1721020,
    "dDurationMs": 7490,
    "segs": [ {
      "utf8": "they look at those conditions or circumstances and think differently or something?"
    } ]
  }, {
    "tStartMs": 1728510,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I just wouldn't want to talk anymore after that."
    } ]
  }, {
    "tStartMs": 1731510,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1733420,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "Not anymore."
    } ]
  }, {
    "tStartMs": 1734240,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1735260,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So there's that."
    } ]
  }, {
    "tStartMs": 1737150,
    "dDurationMs": 6370,
    "segs": [ {
      "utf8": "I find it hard to get close to people who keep saying negative things."
    } ]
  }, {
    "tStartMs": 1743520,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "People who are always grumbling and complaining."
    } ]
  }, {
    "tStartMs": 1747130,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Have you met people like that?"
    } ]
  }, {
    "tStartMs": 1749020,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "Yes, like for example,"
    } ]
  }, {
    "tStartMs": 1752070,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "when you go to an amusement park, you have to stand in line and wait, and that's hard, right?"
    } ]
  }, {
    "tStartMs": 1757340,
    "dDurationMs": 5030,
    "segs": [ {
      "utf8": "When that happens, they grumble and complain,"
    } ]
  }, {
    "tStartMs": 1762370,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "but... it's obviously a difficult process,"
    } ]
  }, {
    "tStartMs": 1766590,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "but let's try to spend it in a fun, positive way,"
    } ]
  }, {
    "tStartMs": 1770040,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "I like people who have that kind of energy."
    } ]
  }, {
    "tStartMs": 1773210,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1776000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Grumpy Smurfs..."
    } ]
  }, {
    "tStartMs": 1778800,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "Grumble, grumble."
    } ]
  }, {
    "tStartMs": 1782110,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "It's not easy, is it?"
    } ]
  }, {
    "tStartMs": 1784380,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1784780,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Yeah, I have a couple of people like that around me too."
    } ]
  }, {
    "tStartMs": 1787840,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1788770,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "But after we were already close, that's when I found out."
    } ]
  }, {
    "tStartMs": 1793970,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "Well, people aren't perfect anyway."
    } ]
  }, {
    "tStartMs": 1797220,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "That's right, so we embrace them."
    } ]
  }, {
    "tStartMs": 1799640,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "That's right, that's right, okay okay."
    } ]
  }, {
    "tStartMs": 1801390,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Yeah, I embrace everyone."
    } ]
  }, {
    "tStartMs": 1804610,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Now that I think about it, that's how it is."
    } ]
  }, {
    "tStartMs": 1805950,
    "dDurationMs": 6370,
    "segs": [ {
      "utf8": "But when it's at a first meeting, or when we haven't known each other long, then... it doesn't look very good."
    } ]
  }, {
    "tStartMs": 1812320,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Then it doesn't look good, of course."
    } ]
  }, {
    "tStartMs": 1814090,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Yeah, you don't want to meet them again."
    } ]
  }, {
    "tStartMs": 1817330,
    "dDurationMs": 6390,
    "segs": [ {
      "utf8": "Oh, and when I open up about my worries,"
    } ]
  }, {
    "tStartMs": 1823720,
    "dDurationMs": 7830,
    "segs": [ {
      "utf8": "there are people who think of it kind of as a meme, you know, those T-type people who give advice,"
    } ]
  }, {
    "tStartMs": 1831550,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "and I don't get much comfort from that."
    } ]
  }, {
    "tStartMs": 1834240,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "I feel kind of like, \"What is this?\""
    } ]
  }, {
    "tStartMs": 1839040,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "When I've shared my story with such difficulty,"
    } ]
  }, {
    "tStartMs": 1841350,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "I have a tendency to want empathy from my friends."
    } ]
  }, {
    "tStartMs": 1846870,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "I often want to hear them say, \"You're right, aren't you?\""
    } ]
  }, {
    "tStartMs": 1851680,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "So when I think about my friends now, the ones I've thought were really close,"
    } ]
  }, {
    "tStartMs": 1857120,
    "dDurationMs": 5290,
    "segs": [ {
      "utf8": "they're completely on my side! They always took my side."
    } ]
  }, {
    "tStartMs": 1862410,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "I get really moved by that."
    } ]
  }, {
    "tStartMs": 1866020,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "I see... I'm not sure about myself."
    } ]
  }, {
    "tStartMs": 1870860,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "It seems like there are people like that around me too, but I'm not sure."
    } ]
  }, {
    "tStartMs": 1876480,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Maybe it's because I don't open up about my worries that much?"
    } ]
  }, {
    "tStartMs": 1879160,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "Really? When I've said something, Tae-woong, you've always been really gentle"
    } ]
  }, {
    "tStartMs": 1884800,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "in the way you talk."
    } ]
  }, {
    "tStartMs": 1887460,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "I was trained that way."
    } ]
  }, {
    "tStartMs": 1890960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 1893600,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "Yeah, it's trained kindness."
    } ]
  }, {
    "tStartMs": 1896850,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Who trained you that way?"
    } ]
  }, {
    "tStartMs": 1898650,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "ChatGPT."
    } ]
  }, {
    "tStartMs": 1901140,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "How?"
    } ]
  }, {
    "tStartMs": 1902220,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "Oh, that's how ChatGPT responds?"
    } ]
  }, {
    "tStartMs": 1905570,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1907100,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "\"I totally understand that.\""
    } ]
  }, {
    "tStartMs": 1908640,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1910460,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "Exactly, \"When you give warm empathy rather than cold analysis,"
    } ]
  }, {
    "tStartMs": 1918560,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "the positive response rate is a few percent higher.\""
    } ]
  }, {
    "tStartMs": 1922650,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "That's what it told me."
    } ]
  }, {
    "tStartMs": 1925260,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "I took it to heart."
    } ]
  }, {
    "tStartMs": 1926680,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1928130,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Me too."
    } ]
  }, {
    "tStartMs": 1930190,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "How about you, Tae-woong? When you talk about your worries with friends,"
    } ]
  }, {
    "tStartMs": 1933950,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "do you usually ask a lot because you want a solution?"
    } ]
  }, {
    "tStartMs": 1939710,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Actually, it's really hard to answer, because"
    } ]
  }, {
    "tStartMs": 1943460,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "it's been ages since I've opened up about my worries to my friends."
    } ]
  }, {
    "tStartMs": 1950100,
    "dDurationMs": 7820,
    "segs": [ {
      "utf8": "Because I don't think my friends will give me a better solution"
    } ]
  }, {
    "tStartMs": 1957920,
    "dDurationMs": 5950,
    "segs": [ {
      "utf8": "than the decision I would make myself."
    } ]
  }, {
    "tStartMs": 1963870,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "\"These... falling things.\""
    } ]
  }, {
    "tStartMs": 1968820,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "No, that's the thing—no matter how detailed I explain,"
    } ]
  }, {
    "tStartMs": 1973480,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "they can't worry about it exactly like I do,"
    } ]
  }, {
    "tStartMs": 1976610,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "Yeah yeah, and they've never actually been in my situation, so how would they know?"
    } ]
  }, {
    "tStartMs": 1982330,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 1983780,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So you don't really do worry counseling."
    } ]
  }, {
    "tStartMs": 1986120,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "Yeah yeah, and for the same reason,"
    } ]
  }, {
    "tStartMs": 1989970,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "when I receive worry counseling,"
    } ]
  }, {
    "tStartMs": 1993220,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so \"how should I solve this?\""
    } ]
  }, {
    "tStartMs": 1995650,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I don't usually say things like 'I like this'"
    } ]
  }, {
    "tStartMs": 1998440,
    "dDurationMs": 5350,
    "segs": [ {
      "utf8": "'You probably know that best of all'"
    } ]
  }, {
    "tStartMs": 2003790,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "But now I try to say it as gently as possible"
    } ]
  }, {
    "tStartMs": 2009410,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "For example, I had a consultation like this"
    } ]
  }, {
    "tStartMs": 2012540,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "'My boyfriend and I aren't getting along very well"
    } ]
  }, {
    "tStartMs": 2015740,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and right now I'm wondering whether to break up or not"
    } ]
  }, {
    "tStartMs": 2018110,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "This bothers me and that bothers me too"
    } ]
  }, {
    "tStartMs": 2020520,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Should I break up or not?' I had a consultation like that"
    } ]
  }, {
    "tStartMs": 2023310,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "With you?"
    } ]
  }, {
    "tStartMs": 2024360,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2024940,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Was it a female friend?"
    } ]
  }, {
    "tStartMs": 2026990,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Whether it's a female or male friend, 'my partner doesn't appeal to me"
    } ]
  }, {
    "tStartMs": 2030150,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "and they do these things so I'm wondering whether to break up or not'"
    } ]
  }, {
    "tStartMs": 2035100,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "When a girl asks me that kind of question"
    } ]
  }, {
    "tStartMs": 2039260,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "then she's done for"
    } ]
  }, {
    "tStartMs": 2043020,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "The scholar has appeared"
    } ]
  }, {
    "tStartMs": 2046040,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "The scholar has made an entrance"
    } ]
  }, {
    "tStartMs": 2047410,
    "dDurationMs": 6760,
    "segs": [ {
      "utf8": "And I wish she hadn't dragged me into that mess"
    } ]
  }, {
    "tStartMs": 2057410,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "I want to act like I don't know anything"
    } ]
  }, {
    "tStartMs": 2062420,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "And if it's a guy..."
    } ]
  }, {
    "tStartMs": 2066970,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "who asks that kind of question, who opens up about that kind of worry"
    } ]
  }, {
    "tStartMs": 2070800,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "then wow that would be fun, then (?)"
    } ]
  }, {
    "tStartMs": 2074940,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Yes, I like that kind of talk"
    } ]
  }, {
    "tStartMs": 2076840,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "But I don't have friends around me who open up about worries like that"
    } ]
  }, {
    "tStartMs": 2082260,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "But usually guys don't really talk about that stuff, relationship talk"
    } ]
  }, {
    "tStartMs": 2086090,
    "dDurationMs": 430,
    "segs": [ {
      "utf8": "They don't"
    } ]
  }, {
    "tStartMs": 2086520,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "Their own relationship stuff"
    } ]
  }, {
    "tStartMs": 2087330,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Yes, they don't"
    } ]
  }, {
    "tStartMs": 2090180,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "I absolutely"
    } ]
  }, {
    "tStartMs": 2091420,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "\"Are you crazy? Why is that guy like that, break up with him right now\""
    } ]
  }, {
    "tStartMs": 2095030,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "\"You can meet someone better\""
    } ]
  }, {
    "tStartMs": 2098720,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "They'll judge for themselves but I say things like \"You're the best\","
    } ]
  }, {
    "tStartMs": 2101910,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "\"He's weird\" that kind of thing"
    } ]
  }, {
    "tStartMs": 2105630,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Don't all female friends do that with each other?"
    } ]
  }, {
    "tStartMs": 2109930,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Is it kind of a female community thing?"
    } ]
  }, {
    "tStartMs": 2112160,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "It seems like it"
    } ]
  }, {
    "tStartMs": 2115470,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "I guess so"
    } ]
  }, {
    "tStartMs": 2117380,
    "dDurationMs": 5910,
    "segs": [ {
      "utf8": "But guys..."
    } ]
  }, {
    "tStartMs": 2123290,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "when friends ask me things like that..."
    } ]
  }, {
    "tStartMs": 2127370,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "That's a difficult question"
    } ]
  }, {
    "tStartMs": 2129510,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "But unlike you, Didi, I don't think I'd just"
    } ]
  }, {
    "tStartMs": 2133180,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "\"Hey, break up with him right now\" like that"
    } ]
  }, {
    "tStartMs": 2136370,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "Listen first?"
    } ]
  }, {
    "tStartMs": 2136980,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Yes yes, listen first"
    } ]
  }, {
    "tStartMs": 2139680,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "And make my own judgment..."
    } ]
  }, {
    "tStartMs": 2143780,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "But I'd probably say something like \"In the end you're going to do what you want anyway\""
    } ]
  }, {
    "tStartMs": 2148170,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "like that"
    } ]
  }, {
    "tStartMs": 2150380,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "That's right, as a joke"
    } ]
  }, {
    "tStartMs": 2153590,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "I take their side too"
    } ]
  }, {
    "tStartMs": 2154830,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "\"But you're going to get back together, right?\" I'd probably say something like that"
    } ]
  }, {
    "tStartMs": 2157970,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "I'm definitely the type to take their side"
    } ]
  }, {
    "tStartMs": 2162030,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Good good"
    } ]
  }, {
    "tStartMs": 2162960,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "But there's a lot more to talk about regarding friends"
    } ]
  }, {
    "tStartMs": 2166360,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "and the minigame seems like it's getting a bit long so should we wrap up soon?"
    } ]
  }, {
    "tStartMs": 2170640,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "About friends?"
    } ]
  }, {
    "tStartMs": 2171890,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "Friends... it's a shame to end the friends topic so short"
    } ]
  }, {
    "tStartMs": 2178170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but I hope we can talk more about it if we get the chance next time"
    } ]
  }, {
    "tStartMs": 2180000,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "We can talk about it again in Friends 2"
    } ]
  }, {
    "tStartMs": 2183140,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "Sounds good"
    } ]
  }, {
    "tStartMs": 2183580,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "So I should give you this week's quiz too"
    } ]
  }, {
    "tStartMs": 2187030,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So this week, then, without a quiz,"
    } ]
  }, {
    "tStartMs": 2190470,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "I'd like you all to write in the comments"
    } ]
  }, {
    "tStartMs": 2193890,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "what you think a friend is."
    } ]
  }, {
    "tStartMs": 2197240,
    "dDurationMs": 5410,
    "segs": [ {
      "utf8": "What kind of... people do you think friends are?"
    } ]
  }, {
    "tStartMs": 2202650,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "What points I think are important in a friend,"
    } ]
  }, {
    "tStartMs": 2206420,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "whether you related more to Tae-woong or to Didi,"
    } ]
  }, {
    "tStartMs": 2208930,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "please feel free to leave those kinds of comments, and I'd appreciate it."
    } ]
  }, {
    "tStartMs": 2212280,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "If we think of more topics to talk about regarding friends,"
    } ]
  }, {
    "tStartMs": 2215960,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "we'll talk about it again on Yomojomo."
    } ]
  }, {
    "tStartMs": 2220420,
    "dDurationMs": 6340,
    "segs": [ {
      "utf8": "A word-based mini game."
    } ]
  }, {
    "tStartMs": 2230820,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "Yes, so now we're going to move on to the word-based mini game segment,"
    } ]
  }, {
    "tStartMs": 2235670,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "and what I brought today is"
    } ]
  }, {
    "tStartMs": 2238210,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "a friendship test!"
    } ]
  }, {
    "tStartMs": 2240790,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "I searched for 10 quiz questions."
    } ]
  }, {
    "tStartMs": 2244380,
    "dDurationMs": 5230,
    "segs": [ {
      "utf8": "Yes, so I'm going to ask Tae-woong 10 questions... oh, is 10 questions too many?"
    } ]
  }, {
    "tStartMs": 2249610,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "I'm going to ask about 5,"
    } ]
  }, {
    "tStartMs": 2252460,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "and see how many you get right."
    } ]
  }, {
    "tStartMs": 2255480,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Sounds good."
    } ]
  }, {
    "tStartMs": 2256350,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Yes, that's what we're doing."
    } ]
  }, {
    "tStartMs": 2259140,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Are you ready?"
    } ]
  }, {
    "tStartMs": 2260320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Do we answer right away?"
    } ]
  }, {
    "tStartMs": 2262360,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2264050,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Should we try solving them together? Together?"
    } ]
  }, {
    "tStartMs": 2266140,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "I'll go through five questions."
    } ]
  }, {
    "tStartMs": 2267280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "I've never done this before, so I'm not sure what it is."
    } ]
  }, {
    "tStartMs": 2269600,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Yes, so the first question:"
    } ]
  }, {
    "tStartMs": 2273180,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "When is my birthday?"
    } ]
  }, {
    "tStartMs": 2275200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "How would I know that?"
    } ]
  }, {
    "tStartMs": 2278200,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "You don't know?"
    } ]
  }, {
    "tStartMs": 2279320,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "Should we just try to guess which month?"
    } ]
  }, {
    "tStartMs": 2284060,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Yes! Do you know?"
    } ]
  }, {
    "tStartMs": 2285890,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I still don't know."
    } ]
  }, {
    "tStartMs": 2287300,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "I don't know either."
    } ]
  }, {
    "tStartMs": 2290430,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "When is it?"
    } ]
  }, {
    "tStartMs": 2292270,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Let's find out—when is it?"
    } ]
  }, {
    "tStartMs": 2293610,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Isn't this supposed to be something we guess?"
    } ]
  }, {
    "tStartMs": 2295020,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Right, so it's a test to see how much you know about each other."
    } ]
  }, {
    "tStartMs": 2299840,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "So like, what's your favorite season, when's your birthday,"
    } ]
  }, {
    "tStartMs": 2303470,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "what snack do you like best, things like that—"
    } ]
  }, {
    "tStartMs": 2306550,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "and we see how many we can get right,"
    } ]
  }, {
    "tStartMs": 2308040,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "and whoever gets more right wins."
    } ]
  }, {
    "tStartMs": 2310550,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 2311570,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "So the first question is birthday,"
    } ]
  }, {
    "tStartMs": 2312830,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and we both don't know."
    } ]
  }, {
    "tStartMs": 2314690,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Oh, so we can't just guess, then."
    } ]
  }, {
    "tStartMs": 2318030,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "Right, we don't know."
    } ]
  }, {
    "tStartMs": 2319120,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Oh, I see. Okay, then mine is October."
    } ]
  }, {
    "tStartMs": 2323420,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Oh, your birthday is in October?"
    } ]
  }, {
    "tStartMs": 2325790,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2326510,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "My birthday is in June."
    } ]
  }, {
    "tStartMs": 2328540,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "So you were born in the fall."
    } ]
  }, {
    "tStartMs": 2329820,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2331010,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I was born in early summer."
    } ]
  }, {
    "tStartMs": 2332930,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Yes, October 14th."
    } ]
  }, {
    "tStartMs": 2335300,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "October 14th—that's an angel (1004), right?"
    } ]
  }, {
    "tStartMs": 2338220,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "No, it's 1014?"
    } ]
  }, {
    "tStartMs": 2339970,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 2342560,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Oh, it's getting hard to remember."
    } ]
  }, {
    "tStartMs": 2344810,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "1014."
    } ]
  }, {
    "tStartMs": 2345280,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "But did you know that?"
    } ]
  }, {
    "tStartMs": 2346580,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "Did you know that the 14th of every month has many small commemorative days?"
    } ]
  }, {
    "tStartMs": 2351590,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Oh, for example, White Day."
    } ]
  }, {
    "tStartMs": 2353630,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "Yes, Valentine's Day."
    } ]
  }, {
    "tStartMs": 2355740,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "But apparently October 14th is Wine Day."
    } ]
  }, {
    "tStartMs": 2360380,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "It's called both 'Wine Day' and 'Jeong Tae-woong Day'."
    } ]
  }, {
    "tStartMs": 2362550,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2363620,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Mine is June 23rd."
    } ]
  }, {
    "tStartMs": 2365270,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "How you can remember it is"
    } ]
  }, {
    "tStartMs": 2366860,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "'2 times 3 is 6', that's how you remember it."
    } ]
  }, {
    "tStartMs": 2370660,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Oh, because it's June 23rd."
    } ]
  }, {
    "tStartMs": 2372320,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Yes, yes, 2 times 3 is 6, right?"
    } ]
  }, {
    "tStartMs": 2375090,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It's easy to remember."
    } ]
  }, {
    "tStartMs": 2376350,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "Yes, I've drilled this into my friends a lot."
    } ]
  }, {
    "tStartMs": 2379490,
    "dDurationMs": 790,
    "segs": [ {
      "utf8": "2, 3 is 6~"
    } ]
  }, {
    "tStartMs": 2380280,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "If you just remember this melody, that's all you need."
    } ]
  }, {
    "tStartMs": 2382090,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "Okay, okay."
    } ]
  }, {
    "tStartMs": 2384000,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "The next question is, what's my favorite food?"
    } ]
  }, {
    "tStartMs": 2388750,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Oh, you've mentioned this before."
    } ]
  }, {
    "tStartMs": 2392350,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "That's not fair."
    } ]
  }, {
    "tStartMs": 2392950,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "Did I mention it? Oh! I did mention it!"
    } ]
  }, {
    "tStartMs": 2395460,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That's not fair, is it?"
    } ]
  }, {
    "tStartMs": 2397380,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "That's why you should ask me more questions."
    } ]
  }, {
    "tStartMs": 2401020,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "I'm really disappointed."
    } ]
  }, {
    "tStartMs": 2402990,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Teacher Tae-woong's favorite food is braised pork with kimchi."
    } ]
  }, {
    "tStartMs": 2406140,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "That's correct."
    } ]
  }, {
    "tStartMs": 2409600,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "Correct answer!"
    } ]
  }, {
    "tStartMs": 2411950,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But you said I can't guess, right?"
    } ]
  }, {
    "tStartMs": 2414190,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Try guessing anyway, you might get it right."
