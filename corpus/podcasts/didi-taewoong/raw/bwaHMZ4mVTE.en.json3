  }, {
    "tStartMs": 2481570,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2483420,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "But actually fifty-fifty is the correct answer."
