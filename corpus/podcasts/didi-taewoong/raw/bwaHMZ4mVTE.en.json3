  }, {
    "tStartMs": 2474390,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "I'm the type to be shy around strangers."
    } ]
  }, {
    "tStartMs": 2476300,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Teacher Tae-woong said it's fifty-fifty..."
