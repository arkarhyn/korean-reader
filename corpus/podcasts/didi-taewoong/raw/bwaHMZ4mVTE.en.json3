  }, {
    "tStartMs": 2603300,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "Well, I do have something, yes."
    } ]
  }, {
    "tStartMs": 2606110,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Teacher Tae-woong, you bought some audio equipment, right?"
    } ]
  }, {
    "tStartMs": 2609440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "No."
