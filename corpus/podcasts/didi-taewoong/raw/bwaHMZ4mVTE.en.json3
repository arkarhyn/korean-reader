  }, {
    "tStartMs": 2684000,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "What about me?"
    } ]
  }, {
    "tStartMs": 2685060,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Ah, it's difficult"
    } ]
  }, {
    "tStartMs": 2688510,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "Ah, I think it would be really long too"
