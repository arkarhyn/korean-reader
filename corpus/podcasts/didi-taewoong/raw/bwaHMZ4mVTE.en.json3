  }, {
    "tStartMs": 2486470,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "It should count as correct."
    } ]
  }, {
    "tStartMs": 2488200,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "It's 3 to 2, and next."
