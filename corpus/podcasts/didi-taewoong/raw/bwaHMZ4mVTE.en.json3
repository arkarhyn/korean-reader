  }, {
    "tStartMs": 2664790,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "When all the money comes in?"
    } ]
  }, {
    "tStartMs": 2668880,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "Ah, first I need to think about what I would do"
