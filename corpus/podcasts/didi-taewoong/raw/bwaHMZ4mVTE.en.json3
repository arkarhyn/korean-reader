  }, {
    "tStartMs": 2671290,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "Oh right"
    } ]
  }, {
    "tStartMs": 2672900,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "Ah, I've been thinking about something lately"
