  }, {
    "tStartMs": 2490230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "My favorite season"
    } ]
  }, {
    "tStartMs": 2492120,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "And what's the reason for that?"
    } ]
  }, {
    "tStartMs": 2493790,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "That's hard to explain the reason, so what's your favorite season?"
    } ]
  }, {
    "tStartMs": 2497380,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Winter."
    } ]
  }, {
    "tStartMs": 2500830,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I like autumn?"
    } ]
  }, {
    "tStartMs": 2503920,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 2505250,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "I like summer."
    } ]
  }, {
    "tStartMs": 2506490,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 2507460,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "You're complete opposites then."
    } ]
  }, {
    "tStartMs": 2512290,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Why did you choose winter?"
    } ]
  }, {
    "tStartMs": 2515810,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "I thought you'd hate sweating."
    } ]
  }, {
    "tStartMs": 2518590,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "No, I want to sweat."
    } ]
  }, {
    "tStartMs": 2520430,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And there are no mosquitoes."
    } ]
  }, {
    "tStartMs": 2523100,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "I like summer."
    } ]
  }, {
    "tStartMs": 2523670,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "I really hate the cold."
    } ]
  }, {
    "tStartMs": 2525850,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "I think we've talked about this before."
