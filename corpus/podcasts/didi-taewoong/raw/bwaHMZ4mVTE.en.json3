  }, {
    "tStartMs": 2622060,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "No, it's a bit different."
    } ]
  }, {
    "tStartMs": 2624550,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "What about me?"
    } ]
  }, {
    "tStartMs": 2627040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Since you won't know anyway, just..."
    } ]
  }, {
    "tStartMs": 2629440,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Wait a moment."
    } ]
  }, {
    "tStartMs": 2633700,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "What are you thinking so hard about?"
