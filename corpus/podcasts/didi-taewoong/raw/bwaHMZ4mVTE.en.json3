  }, {
    "tStartMs": 2697330,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "I'll save it in that account by myself"
    } ]
  }, {
    "tStartMs": 2699790,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "For some kind of business..."
    } ]
  }, {
    "tStartMs": 2702660,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "I'll use it at a certain time, at a certain point\" something like that, I think"
    } ]
  }, {
    "tStartMs": 2705680,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "Ah, no"
    } ]
  }, {
    "tStartMs": 2706990,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "I'll save it first"
    } ]
  }, {
    "tStartMs": 2710220,
    "dDurationMs": 890,
    "segs": [ {
      "utf8": "That's wrong"
