  }, {
    "tStartMs": 2724320,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "That's good"
    } ]
  }, {
    "tStartMs": 2725230,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I really hope you get that"
    } ]
  }, {
    "tStartMs": 2727270,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Then I got more correct"
    } ]
  }, {
    "tStartMs": 2729340,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "I got 5 correct and Teacher Tae-woong got 3 correct"
