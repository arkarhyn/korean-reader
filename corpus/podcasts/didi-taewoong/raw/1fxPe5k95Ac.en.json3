  }, {
    "tStartMs": 2804680,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 2805410,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "Like, \"Oh, I don't want to be on Jeong Tae-woong's team...\" or something."
    } ]
  }, {
    "tStartMs": 2809940,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "\"Oh, I don't like Teacher Tae-woong!!!\""
    } ]
  }, {
    "tStartMs": 2812490,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Yeah..."
    } ]
  }, {
    "tStartMs": 2813780,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "We shouldn't do it that way."
    } ]
  }, {
    "tStartMs": 2814830,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "That's a bit scary suddenly."
    } ]
  }, {
    "tStartMs": 2817240,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So we really need to do this, like a summer MT kind of vibe."
    } ]
  }, {
    "tStartMs": 2820720,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "That would be fun."
    } ]
  }, {
    "tStartMs": 2821220,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Right!!!"
    } ]
  }, {
    "tStartMs": 2823220,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "Make and eat hwachae!"
    } ]
  }, {
    "tStartMs": 2825570,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "At a place like a hanok (- Exactly!!) and all play a big Yut Nori game together."
    } ]
  }, {
    "tStartMs": 2830820,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "What do I do, there are so many ideas like this."
    } ]
  }, {
    "tStartMs": 2834530,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "And play one round of chicken fight too. ㅋㅋㅋㅋ"
    } ]
  }, {
    "tStartMs": 2838030,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "You said Teacher Tae-woong is good at chicken fight, right?"
