  }, {
    "tStartMs": 2297090,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "What's the theme?"
    } ]
  }, {
    "tStartMs": 2298110,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "The theme is,"
    } ]
  }, {
    "tStartMs": 2299510,
    "dDurationMs": 4990,
    "segs": [ {
      "utf8": "Movies with titles that are five characters or longer, whether Korean or foreign."
