  }, {
    "tStartMs": 2275180,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "It's really really difficult?"
    } ]
  }, {
    "tStartMs": 2276600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "What else could there be for fantasy?"
