  }, {
    "tStartMs": 2194250,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "No that's Harry Potter, that one"
    } ]
  }, {
    "tStartMs": 2195970,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "It's not!"
    } ]
  }, {
    "tStartMs": 2197040,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Oh it's not?"
    } ]
  }, {
    "tStartMs": 2198180,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Yes it's a completely different movie, has 5 seconds passed?"
    } ]
  }, {
    "tStartMs": 2200520,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "It took exactly 5 seconds"
    } ]
  }, {
    "tStartMs": 2202170,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Oh Fantastic Beasts"
    } ]
  }, {
    "tStartMs": 2204810,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Fantasy? Ah IC then I'll say \u003cThe Hobbit\u003e"
