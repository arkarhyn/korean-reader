  }, {
    "tStartMs": 1925300,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "But there was a movie I wanted to see recently."
    } ]
  }, {
    "tStartMs": 1930420,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "But it came down from the theaters."
    } ]
  }, {
    "tStartMs": 1932770,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "Oh, you were too busy to see it? What was it?"
    } ]
  }, {
    "tStartMs": 1935480,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Yes, I was too busy to see it,"
    } ]
  }, {
    "tStartMs": 1936650,
    "dDurationMs": 4730,
    "segs": [ {
