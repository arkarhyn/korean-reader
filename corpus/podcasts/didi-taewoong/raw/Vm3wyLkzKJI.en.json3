  }, {
    "tStartMs": 2265920,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "Oh there isn't"
    } ]
  }, {
    "tStartMs": 2270770,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "So it's 1 win 1 win, 1 win"
