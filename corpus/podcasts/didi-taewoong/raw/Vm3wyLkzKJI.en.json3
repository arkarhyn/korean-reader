  }, {
    "tStartMs": 1891180,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "Natural acting."
    } ]
  }, {
    "tStartMs": 1892990,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1893820,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "That kind of acting where it's \"not acting.\""
