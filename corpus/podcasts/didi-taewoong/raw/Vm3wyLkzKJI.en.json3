  }, {
    "tStartMs": 1994130,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Demon Slayer, well, I'm not sure."
    } ]
  }, {
    "tStartMs": 1996050,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "If I had watched Demon Slayer even once in a theater,"
    } ]
  }, {
    "tStartMs": 2000220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "would my thoughts be different now?"
    } ]
  }, {
    "tStartMs": 2002500,
    "dDurationMs": 8090,
    "segs": [ {
      "utf8": "So if you watched it in 4D, you might have discovered a whole new world too."
    } ]
  }, {
    "tStartMs": 2010590,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Everyone listening right now, if you've watched any movies recently that were fun,"
    } ]
  }, {
    "tStartMs": 2015170,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "please leave them in the comments and I'd appreciate it."
    } ]
  }, {
    "tStartMs": 2017950,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "If you all recommend something to me,"
    } ]
  }, {
    "tStartMs": 2020310,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "I watch pretty much everything."
    } ]
  }, {
    "tStartMs": 2022040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Oh that's right."
    } ]
  }, {
    "tStartMs": 2023800,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "I've actually watched almost everything you recommended, Didi."
    } ]
  }, {
    "tStartMs": 2027680,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "So please give lots of recommendations this time too."
    } ]
  }, {
    "tStartMs": 2030040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Oh movie recommendations, really,"
    } ]
  }, {
    "tStartMs": 2032380,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "if there's something updated that you watched recently and found fun,"
    } ]
  }, {
    "tStartMs": 2035620,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "please let me know."
    } ]
  }, {
    "tStartMs": 2038090,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "Thank you, then let's move on to the next segment."
    } ]
  }, {
    "tStartMs": 2043900,
    "dDurationMs": 8480,
    "segs": [ {
      "utf8": "\u003cVerbal Mini Game\u003e"
    } ]
  }, {
    "tStartMs": 2052380,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "This segment is a verbal mini game segment,"
    } ]
  }, {
    "tStartMs": 2056080,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "and I've brought a new game today."
    } ]
  }, {
    "tStartMs": 2058460,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "This mini game will go at a faster pace."
    } ]
  }, {
    "tStartMs": 2062300,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "We won't talk for a long time and will move through it quickly,"
    } ]
  }, {
    "tStartMs": 2066560,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "How should I put it..."
    } ]
  }, {
    "tStartMs": 2067600,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "We'll do a \"Who Says It Faster\" game."
    } ]
  }, {
    "tStartMs": 2071030,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "We talked about movies today, right?"
    } ]
  }, {
    "tStartMs": 2073700,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "So it's about who can say movie titles faster,"
    } ]
  }, {
    "tStartMs": 2079300,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and we'll give each other prompts."
    } ]
  }, {
    "tStartMs": 2081860,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "For example, horror movies, five Korean horror movies,"
    } ]
  }, {
    "tStartMs": 2085890,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "like that, and we talk about those five,"
    } ]
  }, {
    "tStartMs": 2088640,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "and we measure how much time it takes, and whoever is faster wins."
    } ]
  }, {
    "tStartMs": 2094880,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "But how do we decide on the theme?"
    } ]
  }, {
    "tStartMs": 2098660,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "Or without searching,"
    } ]
  }, {
    "tStartMs": 2101590,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you can't search, you have to do it like this."
    } ]
  }, {
    "tStartMs": 2103990,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Take turns answering until someone can't answer?"
    } ]
  }, {
    "tStartMs": 2107550,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "Oh, so we pick one genre altogether?"
    } ]
  }, {
    "tStartMs": 2110140,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 2110910,
    "dDurationMs": 5550,
    "segs": [ {
      "utf8": "Because the theme difficulty might not match between us, you know?"
    } ]
  }, {
    "tStartMs": 2116460,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Oh really? Then let's do that."
    } ]
  }, {
    "tStartMs": 2118950,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Yes, like that."
    } ]
  }, {
    "tStartMs": 2119980,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Let's call it the \"Who Says More\" game."
    } ]
  }, {
    "tStartMs": 2123400,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Who says more."
    } ]
  }, {
    "tStartMs": 2124560,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "But we should set a time limit, right?"
    } ]
  }, {
    "tStartMs": 2126980,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "How?"
    } ]
  }, {
    "tStartMs": 2127940,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Within a few seconds..."
    } ]
  }, {
    "tStartMs": 2129340,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "I don't understand."
    } ]
  }, {
    "tStartMs": 2130220,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So when I say one thing,"
    } ]
  }, {
    "tStartMs": 2132440,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "you have to say yours within 5 seconds,"
    } ]
  }, {
    "tStartMs": 2135030,
    "dDurationMs": 3850,
    "segs": [ {
      "utf8": "Oh okay, like that? I got it."
    } ]
  }, {
    "tStartMs": 2138880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "How many seconds should we do?"
    } ]
  }, {
    "tStartMs": 2140320,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Let's do 5 seconds."
    } ]
  }, {
    "tStartMs": 2142090,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Can't go over 5 seconds - no searching allowed."
    } ]
  }, {
    "tStartMs": 2145850,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "You can't search,"
    } ]
  }, {
    "tStartMs": 2148200,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Korean movies, foreign movies, doesn't matter."
    } ]
  }, {
    "tStartMs": 2151220,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "Then shall we do round 3?"
    } ]
  }, {
    "tStartMs": 2152410,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Three genres each? Three themes each?"
    } ]
  }, {
    "tStartMs": 2154910,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Yes, sounds good - okay okay"
    } ]
  }, {
    "tStartMs": 2156850,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Should I go first with the theme?"
    } ]
  }, {
    "tStartMs": 2158310,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2158940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I'll start with an easy one"
    } ]
  }, {
    "tStartMs": 2161070,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "'Fantasy movies'"
    } ]
  }, {
    "tStartMs": 2163260,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "You count the numbers for the other person"
    } ]
  }, {
    "tStartMs": 2165150,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "And seasons 1, 2, 3 don't count"
    } ]
  }, {
    "tStartMs": 2167940,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "I know I know I know"
    } ]
  }, {
    "tStartMs": 2169090,
    "dDurationMs": 770,
    "segs": [ {
      "utf8": "Start!"
    } ]
  }, {
    "tStartMs": 2169860,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "Harry Potter - Harry P... oh wait a second"
    } ]
  }, {
    "tStartMs": 2173890,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Oh Didi, you go first, you go first? Okay okay"
