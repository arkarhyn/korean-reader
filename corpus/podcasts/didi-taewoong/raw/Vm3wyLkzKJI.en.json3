  }, {
    "tStartMs": 1824970,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "I can't remember what the last one was."
    } ]
  }, {
    "tStartMs": 1828700,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "And because the names are so similar, I can't remember that either."
    } ]
  }, {
    "tStartMs": 1833120,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "What's that movie about playing baduk?"
    } ]
  }, {
    "tStartMs": 1836730,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Was it \u003cShowdown\u003e? \u003cShowdown\u003e?"
