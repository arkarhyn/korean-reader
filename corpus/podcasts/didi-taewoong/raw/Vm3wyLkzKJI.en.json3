  }, {
    "tStartMs": 1852320,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Ah, I really enjoyed watching it."
    } ]
  }, {
    "tStartMs": 1853780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "\u003cEscape\u003e—there are two of them like this."
