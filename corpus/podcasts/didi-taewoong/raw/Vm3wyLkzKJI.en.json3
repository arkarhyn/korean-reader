  }, {
    "tStartMs": 1961500,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "I should have done that!"
    } ]
  }, {
    "tStartMs": 1962930,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Exactly, it's such a shame."
    } ]
  }, {
    "tStartMs": 1964130,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "That's the kind of movie you really need to see in a theater."
    } ]
  }, {
    "tStartMs": 1966480,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Of course."
    } ]
  }, {
    "tStartMs": 1967510,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "So I'm that kind of person living that kind of life."
    } ]
  }, {
    "tStartMs": 1971710,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "Oh no..."
    } ]
  }, {
    "tStartMs": 1972840,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "So that's... sad, isn't it?"
    } ]
  }, {
    "tStartMs": 1975940,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "It makes you reflect on yourself."
    } ]
  }, {
    "tStartMs": 1977760,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Watch it again when it comes to Netflix."
    } ]
  }, {
    "tStartMs": 1979750,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "It probably won't come out until next year or so?"
    } ]
  }, {
    "tStartMs": 1982060,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "Next year? I don't think it'll come out next year either?"
