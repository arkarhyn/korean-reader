  }, {
    "tStartMs": 2175880,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Oh I lost Harry Potter..."
    } ]
  }, {
    "tStartMs": 2178300,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "No you go ahead, with Harry Potter"
    } ]
  }, {
    "tStartMs": 2179890,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Oh that's fine, you go ahead, you go ahead"
    } ]
  }, {
    "tStartMs": 2181830,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "That's fine? \u003cHarry Potter\u003e"
    } ]
  }, {
    "tStartMs": 2183710,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Okay"
    } ]
  }, {
