  }, {
    "tStartMs": 1941380,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "I really love that series,"
    } ]
  }, {
    "tStartMs": 1946080,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "But it passed by, and when I came to my senses, it was already over."
