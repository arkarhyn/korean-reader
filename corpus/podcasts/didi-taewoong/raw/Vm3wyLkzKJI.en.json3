  }, {
    "tStartMs": 1818790,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Yeah, that's true."
    } ]
  }, {
    "tStartMs": 1820390,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Didi, the last Korean movie you saw in a theater..."
