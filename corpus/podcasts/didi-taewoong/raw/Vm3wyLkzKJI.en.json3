  }, {
    "tStartMs": 1855460,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1856080,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "I think I enjoyed \u003cEscape\u003e a lot."
    } ]
  }, {
    "tStartMs": 1857910,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "Ah, I also really enjoyed \u003cEscape\u003e."
    } ]
  }, {
    "tStartMs": 1860060,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Right? That was good—I watched it without expecting much,"
    } ]
  }, {
    "tStartMs": 1864860,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Ah yes, the movie just keeps pounding away without letting up,"
    } ]
  }, {
    "tStartMs": 1869060,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "All the way to the end."
    } ]
  }, {
    "tStartMs": 1870210,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1871440,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "I really enjoyed watching it."
    } ]
  }, {
    "tStartMs": 1872830,
    "dDurationMs": 6620,
    "segs": [ {
      "utf8": "I really love actor Koo Kyo-hwan who appears in \u003cEscape\u003e,"
    } ]
  }, {
    "tStartMs": 1879450,
    "dDurationMs": 7020,
    "segs": [ {
      "utf8": "So whenever a work like that comes out, I make sure to watch it, and I really enjoyed it."
