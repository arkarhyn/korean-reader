  }, {
    "tStartMs": 1900580,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Right, right, because you get immersed."
    } ]
  }, {
    "tStartMs": 1903610,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "An actor should act well,"
    } ]
  }, {
    "tStartMs": 1906430,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "A musician should play music well,"
    } ]
  }, {
    "tStartMs": 1908600,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "And especially with actors, when you don't feel like they're acting,"
    } ]
  }, {
    "tStartMs": 1912840,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "That's when you feel like they're really doing it well."
    } ]
  }, {
    "tStartMs": 1915260,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 1916680,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "Are there any other movies you want to see? As a final question,"
    } ]
  }, {
    "tStartMs": 1920210,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Any movies you're looking forward to?"
