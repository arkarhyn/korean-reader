  }, {
    "tStartMs": 2256310,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Huh?"
    } ]
  }, {
    "tStartMs": 2257430,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "Isn't there a Gollum movie?"
    } ]
  }, {
    "tStartMs": 2258820,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "There's a movie for that?"
    } ]
  }, {
    "tStartMs": 2260580,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "There should be?"
    } ]
  }, {
    "tStartMs": 2261400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Is there really? What is it?"
