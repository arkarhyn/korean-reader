  }, {
    "tStartMs": 1954520,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Oh, that's what it was! That's what it was!"
    } ]
  }, {
    "tStartMs": 1958660,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "If you're that busy, during the time you eat,"
