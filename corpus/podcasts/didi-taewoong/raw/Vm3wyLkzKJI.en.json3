  }, {
    "tStartMs": 2714260,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Five songs each... or not?"
    } ]
  }, {
    "tStartMs": 2716630,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "Let's prepare three songs each and come back."
    } ]
  }, {
    "tStartMs": 2720220,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Yes, sounds good."
    } ]
  }, {
    "tStartMs": 2721800,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "Today we talked about movies in all sorts of ways,"
    } ]
  }, {
    "tStartMs": 2724390,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and next week we'll pick three songs"
    } ]
  }, {
    "tStartMs": 2728070,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "and talk about them in all sorts of ways."
    } ]
  }, {
    "tStartMs": 2730560,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "This has been Didi and Jeong Tae-woong."
