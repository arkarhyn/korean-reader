  }, {
    "tStartMs": 2870540,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "bring something like a thin cardigan"
    } ]
  }, {
    "tStartMs": 2872700,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "with you,"
    } ]
  }, {
    "tStartMs": 2874220,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and yes, and also,"
    } ]
  }, {
    "tStartMs": 2875540,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "uh,"
    } ]
  }, {
    "tStartMs": 2876540,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "if you're a foreigner"
    } ]
  }, {
    "tStartMs": 2878899,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "sitting on the Korean subway"
    } ]
  }, {
    "tStartMs": 2882619,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "reading a book,"
    } ]
  }, {
    "tStartMs": 2885059,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "it could double your coolness."
    } ]
  }, {
    "tStartMs": 2886660,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "[laughs]"
    } ]
  }, {
    "tStartMs": 2890459,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "Those of you who want to take note, please do."
    } ]
  }, {
    "tStartMs": 2892820,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "Yes, I actually"
    } ]
  }, {
    "tStartMs": 2895619,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "once"
    } ]
  }, {
    "tStartMs": 2897859,
    "dDurationMs": 641,
    "segs": [ {
      "utf8": "uh,"
    } ]
  }, {
    "tStartMs": 2898500,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "sat on the subway"
    } ]
  }, {
    "tStartMs": 2900540,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "reading a book"
    } ]
  }, {
    "tStartMs": 2902500,
    "dDurationMs": 2359,
    "segs": [ {
      "utf8": "on the way to Seo-myeon,"
    } ]
  }, {
    "tStartMs": 2904859,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "and next to me, some"
    } ]
  }, {
    "tStartMs": 2907540,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "woman was sitting,"
    } ]
  }, {
    "tStartMs": 2909380,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "and"
    } ]
  }, {
    "tStartMs": 2911100,
    "dDurationMs": 639,
    "segs": [ {
      "utf8": "uh,"
    } ]
  }, {
    "tStartMs": 2911739,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "everyone on that subway"
    } ]
  }, {
    "tStartMs": 2913219,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "was looking at their phones"
    } ]
  }, {
    "tStartMs": 2915020,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "and talking and all that,"
    } ]
  }, {
    "tStartMs": 2917219,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "but I was the only one reading a book."
    } ]
  }, {
    "tStartMs": 2919299,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "Oh, I see."
    } ]
  }, {
    "tStartMs": 2919900,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "So I was"
    } ]
  }, {
    "tStartMs": 2921140,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "quite taken with my own image like that,"
    } ]
  }, {
    "tStartMs": 2923580,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "mm-hmm,"
    } ]
  }, {
    "tStartMs": 2924140,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "but the woman sitting next to me"
    } ]
  }, {
    "tStartMs": 2926940,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "mm-hmm,"
    } ]
  }, {
    "tStartMs": 2929260,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "from the eco-bag on her shoulder"
    } ]
  }, {
    "tStartMs": 2931700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "suddenly pulled out a book"
    } ]
  }, {
    "tStartMs": 2933700,
    "dDurationMs": 359,
    "segs": [ {
      "utf8": "oh,"
    } ]
  }, {
    "tStartMs": 2934059,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "and started reading a book right next to me."
    } ]
  }, {
    "tStartMs": 2936820,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 2937859,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's just the two of us in a library."
    } ]
  }, {
    "tStartMs": 2939059,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Yeah, right?"
    } ]
  }, {
    "tStartMs": 2939659,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "Isn't that so romantic?"
    } ]
  }, {
    "tStartMs": 2942340,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "So that woman and"
    } ]
  }, {
    "tStartMs": 2944179,
    "dDurationMs": 761,
    "segs": [ {
      "utf8": "Ah"
    } ]
  }, {
    "tStartMs": 2944940,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "But"
    } ]
  }, {
    "tStartMs": 2945979,
    "dDurationMs": 841,
    "segs": [ {
      "utf8": "Yeah"
    } ]
  }, {
    "tStartMs": 2946820,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "But somehow it happened that"
    } ]
  }, {
    "tStartMs": 2948780,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "That person's"
    } ]
  }, {
    "tStartMs": 2950020,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "book"
    } ]
  }, {
    "tStartMs": 2951059,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "I got to see a page of it"
    } ]
  }, {
    "tStartMs": 2952659,
    "dDurationMs": 681,
    "segs": [ {
      "utf8": "Yeah"
    } ]
  }, {
    "tStartMs": 2953340,
    "dDurationMs": 719,
    "segs": [ {
      "utf8": "And"
    } ]
  }, {
    "tStartMs": 2954059,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "it was in Chinese"
    } ]
  }, {
    "tStartMs": 2956500,
    "dDurationMs": 719,
    "segs": [ {
      "utf8": "Mm"
    } ]
  }, {
    "tStartMs": 2957219,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "Yes"
    } ]
  }, {
    "tStartMs": 2957820,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "So she was a foreigner"
    } ]
  }, {
    "tStartMs": 2959700,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Ah yes"
    } ]
  }, {
    "tStartMs": 2961020,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 2962140,
    "dDurationMs": 3039,
    "segs": [ {
      "utf8": "that person's coolness surpassed my coolness"
    } ]
  }, {
    "tStartMs": 2965179,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "Hahaha"
    } ]
  }, {
    "tStartMs": 2966700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I lost"
    } ]
  }, {
    "tStartMs": 2968500,
    "dDurationMs": 1119,
    "segs": [ {
      "utf8": "Oh"
    } ]
  }, {
    "tStartMs": 2969619,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "At that time I lost"
    } ]
  }, {
    "tStartMs": 2970900,
    "dDurationMs": 1519,
    "segs": [ {
      "utf8": "That woman won"
    } ]
  }, {
    "tStartMs": 2972419,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "Haha"
    } ]
  }, {
    "tStartMs": 2973500,
    "dDurationMs": 1239,
    "segs": [ {
      "utf8": "She was cooler"
    } ]
  }, {
    "tStartMs": 2974739,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "That's right"
    } ]
  }, {
    "tStartMs": 2976659,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Mm"
    } ]
  }, {
    "tStartMs": 2978179,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "That's correct"
    } ]
  }, {
    "tStartMs": 2978859,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "I thought that moment was"
    } ]
  }, {
    "tStartMs": 2981500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "that"
    } ]
  }, {
    "tStartMs": 2982500,
    "dDurationMs": 1119,
    "segs": [ {
      "utf8": "that brief"
    } ]
  }, {
    "tStartMs": 2983619,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "that time was so romantic"
    } ]
  }, {
    "tStartMs": 2985900,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Haha"
    } ]
  }, {
    "tStartMs": 2986940,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "It really left an impression on me, honestly"
    } ]
  }, {
    "tStartMs": 2988500,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Oh really?"
    } ]
  }, {
    "tStartMs": 2989299,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "Yes haha"
    } ]
  }, {
    "tStartMs": 2991500,
    "dDurationMs": 1239,
    "segs": [ {
      "utf8": "You two made a movie together"
    } ]
  }, {
    "tStartMs": 2992739,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "Haha"
    } ]
  }, {
    "tStartMs": 2995140,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Mm"
    } ]
  }, {
    "tStartMs": 2996979,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Oh my"
    } ]
  }, {
    "tStartMs": 2997780,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "She also got off at Seomyeon"
    } ]
  }, {
    "tStartMs": 3000000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Really? Why couldn't you take it one step further?"
    } ]
  }, {
    "tStartMs": 3003000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You could have gotten along well."
    } ]
  }, {
    "tStartMs": 3005000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What a shame!"
    } ]
  }, {
    "tStartMs": 3009000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Since Teacher Tae-woong likes this method so much"
    } ]
  }, {
    "tStartMs": 3013000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "everyone should bring a book with you"
    } ]
  }, {
    "tStartMs": 3017000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Try it once"
    } ]
  }, {
    "tStartMs": 3018000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I recommend it"
    } ]
  }, {
    "tStartMs": 3020000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Oh and I just remembered something from the food smell earlier"
    } ]
  }, {
    "tStartMs": 3025000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Sometimes I notice that some foreigners spray perfume really heavily"
    } ]
  }, {
    "tStartMs": 3031000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I felt this when I was taking the Airport Railroad"
    } ]
  }, {
    "tStartMs": 3034000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "The Airport Railroad has a lot of foreigners so I sometimes sit next to foreign people"
    } ]
  }, {
    "tStartMs": 3041000,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "Most of the time it's fine, but there was one time when someone had such a strong perfume smell"
    } ]
  }, {
    "tStartMs": 3050000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "I had to go for an hour and it was a bit difficult. I got a headache"
    } ]
  }, {
    "tStartMs": 3057000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "But in Korea, people don't seem to spray perfume that heavily"
    } ]
  }, {
    "tStartMs": 3063000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It doesn't seem like there are many people who do it. You don't see it often"
    } ]
  }, {
    "tStartMs": 3066000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "There really aren't many"
    } ]
  }, {
    "tStartMs": 3067000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I think people prefer a subtle scent"
    } ]
  }, {
    "tStartMs": 3072000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "If you're going to use public transportation a lot, spraying perfume moderately"
    } ]
  }, {
    "tStartMs": 3079000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "could be considered good etiquette"
    } ]
  }, {
    "tStartMs": 3081000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Good point. That's right."
    } ]
  }, {
    "tStartMs": 3085000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Yes, so today we've talked about public transportation from every angle, Yomojomo."
    } ]
  }, {
    "tStartMs": 3091000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tae-woong has come up with the next topic."
    } ]
  }, {
    "tStartMs": 3094000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What is the next topic?"
    } ]
  }, {
    "tStartMs": 3096000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The next topic is board games."
    } ]
  }, {
    "tStartMs": 3100000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Tae-woong, you're really a board game enthusiast, aren't you?"
    } ]
  }, {
    "tStartMs": 3106000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I'm not really an enthusiast, to be honest."
    } ]
  }, {
    "tStartMs": 3109000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "You play them often, and I'd like this to be a time where we can learn about Tae-woong's board game stories"
    } ]
  }, {
    "tStartMs": 3115000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and understand the fun of board games a bit better."
    } ]
  }, {
    "tStartMs": 3119000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Sounds good."
    } ]
  }, {
    "tStartMs": 3121000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yes, so next week we'll talk about board games again"
    } ]
  }, {
    "tStartMs": 3124000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "from every angle, Yomojomo."
    } ]
  }, {
    "tStartMs": 3126000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This has been Didi."
    } ]
  }, {
    "tStartMs": 3128000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "This has been Jeong Tae-woong."
    } ]
  } ]
}
