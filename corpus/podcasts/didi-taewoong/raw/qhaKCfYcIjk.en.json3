  }, {
    "tStartMs": 2642179,
    "dDurationMs": 681,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 2642860,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "He was cursing and cursing at people behind us and all that."
