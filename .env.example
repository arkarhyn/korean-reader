# Copy to .env (gitignored) and fill in.

# 한국어기초사전 open API key (krdict.korean.go.kr -> 오픈 API)
KRDICT_API_KEY=

# Where the server listens on the desktop
SERVER_HOST=0.0.0.0
SERVER_PORT=8443

# Base URL clients use (tailnet hostname preferred; see DECISIONS O1)
PUBLIC_BASE_URL=https://<desktop>.<tailnet>.ts.net:8443

# TLS -- paths OUTSIDE the repo (DECISIONS O1: tailscale cert). The Windows
# service sets these itself (server/scripts/install_service.ps1); leave them
# empty here for plain-HTTP local dev.
# TLS_CERT_PATH=C:\ProgramData\korean-reader\certs\server.crt
# TLS_KEY_PATH=C:\ProgramData\korean-reader\certs\server.key
TLS_CERT_PATH=
TLS_KEY_PATH=

# SQLite file; relative paths resolve against server/ (data/ is gitignored)
DATABASE_PATH=./data/korean_reader.db
